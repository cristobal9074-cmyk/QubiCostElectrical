<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>Qubi Cost</Company>
    <Authors>Qubi Cost</Authors>
    <Product>Qubi Cost Electrical</Product>
    <Copyright>© Qubi Cost 2026. Todos los derechos reservados.</Copyright>
    <Description>Software profesional de presupuestos eléctricos con cubicación, APU, cotizaciones y ofertas comerciales.</Description>
    <DatabaseSchemaVersion>28</DatabaseSchemaVersion>
    <ProjectFormatVersion>6</ProjectFormatVersion>
    <CalculationEngineVersion>2</CalculationEngineVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);xUnit2013;xUnit2012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DatabaseSchemaVersion" Value="$(DatabaseSchemaVersion)" />
    <AssemblyMetadata Include="ProjectFormatVersion" Value="$(ProjectFormatVersion)" />
    <AssemblyMetadata Include="CalculationEngineVersion" Value="$(CalculationEngineVersion)" />
  </ItemGroup>
</Project>
