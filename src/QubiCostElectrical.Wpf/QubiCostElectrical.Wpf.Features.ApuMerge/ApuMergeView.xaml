<UserControl x:Class="QubiCostElectrical.Wpf.Features.ApuMerge.ApuMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">

      <TextBlock Text="Fusión de versiones APU" FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,4" />
      <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,4">
        <Run Text="Comparación entre la versión local del APU " />
        <Run Text="{Binding Code, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
        <Run Text=" y la versión de catálogo. Resuelva los conflictos antes de crear la versión de fusión." />
      </TextBlock>
      <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                 TextWrapping="Wrap" Margin="0,0,0,16" />

      <!-- Conflictos -->
      <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Conflictos" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,10" />

          <DataGrid ItemsSource="{Binding Conflicts}" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Dimensión" Binding="{Binding Dimension}" IsReadOnly="True" Width="140" />
              <DataGridTextColumn Header="Local" Binding="{Binding LocalValue}" IsReadOnly="True" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Catálogo" Binding="{Binding CatalogValue}" IsReadOnly="True" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Base" Binding="{Binding BaseValue}" IsReadOnly="True" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Resolución" Binding="{Binding Resolution}" IsReadOnly="True" Width="120">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Navy}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="Acciones" Width="260">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Mantener local" Margin="0,0,4,0" Padding="8,4" FontSize="11" Cursor="Hand"
                              Background="Transparent" BorderBrush="#C9D4E3" BorderThickness="1"
                              Foreground="{DynamicResource Brush.Blue}"
                              Command="{Binding DataContext.ResolveKeepLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Aceptar catálogo" Margin="0,0,4,0" Padding="8,4" FontSize="11" Cursor="Hand"
                              Background="Transparent" BorderBrush="#C9D4E3" BorderThickness="1"
                              Foreground="{DynamicResource Brush.Blue}"
                              Command="{Binding DataContext.ResolveAcceptCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Mantener base" Padding="8,4" FontSize="11" Cursor="Hand"
                              Background="Transparent" BorderBrush="#C9D4E3" BorderThickness="1"
                              Foreground="{DynamicResource Brush.Blue}"
                              Command="{Binding DataContext.ResolveKeepBaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Diferencias -->
      <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Diferencias de costo" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,10" />

          <DataGrid ItemsSource="{Binding Diffs}" AutoGenerateColumns="False" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Dimensión" Binding="{Binding Dimension}" IsReadOnly="True" Width="160" />
              <DataGridTextColumn Header="Local" Binding="{Binding LocalValue}" IsReadOnly="True" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Catálogo" Binding="{Binding CatalogValue}" IsReadOnly="True" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Impacto" Binding="{Binding Impact}" IsReadOnly="True" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Acciones -->
      <Border Padding="16" CornerRadius="10" Background="{DynamicResource Brush.Navy}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="APU" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
            <TextBlock Text="{Binding ApuId}" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource Font.Mono}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                    Padding="14,8" FontWeight="SemiBold" Cursor="Hand"
                    Background="Transparent" BorderBrush="#64748B" BorderThickness="1" Foreground="White" />
            <Button Content="Crear versión de fusión" Command="{Binding CreateMergeVersionCommand}"
                    Padding="16,8" FontWeight="SemiBold" Cursor="Hand"
                    Background="{DynamicResource Brush.Blue}" Foreground="White" BorderThickness="0" />
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
