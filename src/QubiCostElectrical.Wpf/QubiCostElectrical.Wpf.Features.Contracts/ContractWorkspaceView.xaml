<UserControl x:Class="QubiCostElectrical.Wpf.Features.Contracts.ContractWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">

  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Contratos" FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,4" />
      <TextBlock Text="Ciclo de vida de contratos: creación, aprobación, versiones y auditoría."
                 FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource Form.TextBox}" Width="320" HorizontalAlignment="Left"
                 Tag="Buscar contrato..." />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Actualizar" Command="{Binding RefreshCommand}"
                  Padding="12,7" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                  Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                  BorderBrush="#C9D4E3" BorderThickness="1" Cursor="Hand" />
          <Button Content="+ Nuevo contrato" Command="{Binding CreateCommand}"
                  Padding="12,7" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                  Background="{DynamicResource Brush.Navy}" Foreground="White" BorderThickness="0" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
      <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C0392B" TextWrapping="Wrap" />
    </StackPanel>

    <Border Style="{StaticResource Card.Section}" Padding="0">
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding Id.Value}" Width="140" />
          <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
          <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120" />
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110" />
          <DataGridTemplateColumn Header="" Width="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Editar" Margin="0,0,6,0" Padding="8,4" FontSize="11" Cursor="Hand"
                          Background="Transparent" BorderThickness="1" BorderBrush="#C9D4E3"
                          Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Versiones" Padding="8,4" FontSize="11" Cursor="Hand"
                          Background="Transparent" BorderThickness="1" BorderBrush="#C9D4E3"
                          Command="{Binding DataContext.VersionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </DockPanel>
</UserControl>
