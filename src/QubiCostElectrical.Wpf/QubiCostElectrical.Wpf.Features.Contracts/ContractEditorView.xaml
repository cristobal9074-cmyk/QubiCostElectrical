<UserControl x:Class="QubiCostElectrical.Wpf.Features.Contracts.ContractEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">

      <TextBlock Text="Editor de contrato" FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,4" />
      <TextBlock Text="{Binding Contract.Id.Value, StringFormat='Contrato: {0}'}"
                 FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,16" />

      <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="TÍTULO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
              <TextBox Text="{Binding Contract.Title, UpdateSourceTrigger=LostFocus}"
                       Style="{StaticResource Form.TextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="TIPO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
              <TextBox Text="{Binding Contract.Type, UpdateSourceTrigger=LostFocus}"
                       Style="{StaticResource Form.TextBox}" />
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="DESCRIPCIÓN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
            <TextBox Text="{Binding Contract.Description, UpdateSourceTrigger=LostFocus}"
                     Style="{StaticResource Form.TextBox}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
          </StackPanel>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="CLIENTE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
              <TextBox Text="{Binding Contract.ClientName, UpdateSourceTrigger=LostFocus}"
                       Style="{StaticResource Form.TextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="CONTRATISTA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
              <TextBox Text="{Binding Contract.ContractorName, UpdateSourceTrigger=LostFocus}"
                       Style="{StaticResource Form.TextBox}" />
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="MONTO ORIGINAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
              <TextBox Text="{Binding Contract.OriginalAmount, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                       Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="IMPUESTO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
              <TextBox Text="{Binding Contract.TaxAmount, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                       Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,12" />

      <StackPanel Orientation="Horizontal">
        <Button Content="Guardar" Command="{Binding SaveCommand}"
                Padding="16,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"
                Background="{DynamicResource Brush.Navy}" Foreground="White" BorderThickness="0" />
        <Button Content="Cancelar" Command="{Binding CancelCommand}"
                Padding="16,8" FontWeight="SemiBold" Cursor="Hand"
                Background="Transparent" BorderThickness="1" BorderBrush="#C9D4E3" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
