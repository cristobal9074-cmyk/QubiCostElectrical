<UserControl x:Class="QubiCostElectrical.Wpf.Controls.DataGridSearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             SnapsToDevicePixels="True">
  <Border CornerRadius="8"
          BorderThickness="1"
          BorderBrush="{DynamicResource Brush.Line}"
          Background="{DynamicResource Brush.Surface}"
          Padding="8,5"
          MinWidth="340"
          MaxWidth="420">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270"
                        Color="{DynamicResource Color.Shadow}" Opacity="0.22" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Icono de búsqueda -->
      <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="4,0,6,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink3}" />

      <!-- Input de búsqueda -->
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{DynamicResource Brush.Ink}"
                 CaretBrush="{DynamicResource Brush.Ink}"
                 FontSize="12"
                 Padding="0,2"
                 PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                 TextChanged="OnSearchBoxTextChanged" />
        <TextBlock x:Name="SearchPlaceholder"
                   Text="Buscar en tabla..."
                   FontSize="12"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource Brush.Ink4}"
                   VerticalAlignment="Center"
                   Margin="2,0,0,0"
                   Visibility="Visible" />
      </Grid>

      <!-- Badge de contador de coincidencias -->
      <Border x:Name="MatchBadge" Grid.Column="2" CornerRadius="4"
              Background="{DynamicResource Brush.ChipBg}"
              Padding="6,2" Margin="6,0,4,0" VerticalAlignment="Center">
        <TextBlock x:Name="MatchCountText" Text="0 / 0" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" />
      </Border>

      <!-- Botón Anterior (Shift+Enter / Shift+F3) -->
      <Button x:Name="PrevButton" Grid.Column="3" Content="▲" Style="{DynamicResource Button.Ghost}"
              Width="24" Height="24" Padding="0" Margin="1,0" FontSize="10"
              ToolTip="Anterior coincidencia (Shift+Enter / Shift+F3)"
              Click="OnPrevClick" />

      <!-- Botón Siguiente (Enter / F3) -->
      <Button x:Name="NextButton" Grid.Column="4" Content="▼" Style="{DynamicResource Button.Ghost}"
              Width="24" Height="24" Padding="0" Margin="1,0" FontSize="10"
              ToolTip="Siguiente coincidencia (Enter / F3)"
              Click="OnNextClick" />

      <!-- Botón Cerrar (Esc) -->
      <Button x:Name="CloseButton" Grid.Column="5" Content="✕" Style="{DynamicResource Button.Ghost}"
              Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="10"
              ToolTip="Cerrar búsqueda (Esc)"
              Click="OnCloseClick" />
    </Grid>
  </Border>
</UserControl>
