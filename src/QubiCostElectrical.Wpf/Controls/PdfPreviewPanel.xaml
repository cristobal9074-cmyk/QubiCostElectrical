<UserControl x:Class="QubiCostElectrical.Wpf.Controls.PdfPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- macOS Preview HUD button style -->
    <Style x:Key="Button.MacHud" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Sm}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header opcional (docked) -->
      <DockPanel Grid.Row="0" Margin="10,8"
                 Visibility="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="&#x2212;" Style="{StaticResource Button.Ghost}" Padding="8,4"
                  Command="{Binding ZoomOutCommand}" ToolTip="Alejar" />
          <TextBlock VerticalAlignment="Center" Margin="2,0"
                     Text="{Binding ZoomPercentText}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Ink2}" />
          <Button Content="+" Style="{StaticResource Button.Ghost}" Padding="8,4"
                  Command="{Binding ZoomInCommand}" ToolTip="Acercar" />
          <Button Content="100%" Style="{StaticResource Button.Ghost}" Padding="8,4" FontSize="11"
                  Command="{Binding Zoom100Command}" ToolTip="Zoom real 100%"
                  Margin="2,0,4,0" />
          <Button Content="Ajustar" Style="{StaticResource Button.Ghost}" Padding="8,4" FontSize="11"
                  Command="{Binding FitPageCommand}" ToolTip="Ajustar página a la ventana"
                  Margin="0,0,4,0" />
          <Button Content="{Binding TwoPageButtonLabel}" Style="{StaticResource Button.Ghost}" Padding="8,4" FontSize="11"
                  Command="{Binding ToggleTwoPageCommand}" ToolTip="Alternar vista de 2 páginas"
                  Margin="0,0,8,0" />
          <Border Width="1" Background="{DynamicResource Brush.Line}" Margin="0,3,8,3" />
          <Button Content="&#x25C0;" Style="{StaticResource Button.Ghost}" Padding="8,4"
                  Command="{Binding PreviousPageCommand}" />
          <TextBlock VerticalAlignment="Center" Margin="6,0"
                     Text="{Binding PageIndicator}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
          <Button Content="&#x25B6;" Style="{StaticResource Button.Ghost}" Padding="8,4"
                  Command="{Binding NextPageCommand}" />
        </StackPanel>
        <TextBlock Text="Vista previa PDF" Style="{StaticResource Text.SectionLabel}" />
      </DockPanel>

      <!-- Viewport & Floating macOS Preview Toolbar -->
      <Grid Grid.Row="1">
        <Border Background="{DynamicResource Brush.Surface2}" Padding="10,8">
          <ScrollViewer x:Name="PART_Scroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        Background="{DynamicResource Brush.Surface2}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Two-page / Single-page container -->
              <StackPanel x:Name="PART_PagesContainer"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}">
                <!-- Page 1 -->
                <Border x:Name="PART_Page" Background="White" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="1" Margin="10">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.18" ShadowDepth="4" Direction="270" />
                  </Border.Effect>
                  <Image x:Name="PART_Image" Source="{Binding CurrentPageImage}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Page 2 (Two-page mode) -->
                <Border x:Name="PART_Page2" Background="White" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="1" Margin="10"
                        Visibility="{Binding HasSecondPage, Converter={StaticResource BoolToVisibility}}">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.18" ShadowDepth="4" Direction="270" />
                  </Border.Effect>
                  <Image x:Name="PART_Image2" Source="{Binding SecondPageImage}" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </StackPanel>

              <!-- Empty state placeholder -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,50"
                          Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                  <Path Data="{StaticResource Geo.FileText}" Style="{StaticResource Icon.Vector.Lg}" Stroke="{DynamicResource Brush.Ink3}" />
                </Border>
                <TextBlock Text="Vista previa del documento" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" />
                <TextBlock Text="Pulse 'Actualizar' o navegue para previsualizar el PDF oficial."
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>

        <!-- Floating Zoom & Page HUD Toolbar (macOS Preview style) -->
        <Border x:Name="FloatingHudBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,18"
                Background="#E60F172A"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,3"
                Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" Color="#000000" Opacity="0.45" ShadowDepth="5" Direction="270" />
          </Border.Effect>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Navigation -->
            <Button Content="&#x25C0;" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding PreviousPageCommand}" ToolTip="Página anterior" />
            <TextBlock Text="{Binding PageIndicator}"
                       Foreground="#F1F5F9"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="4,0" />
            <Button Content="&#x25B6;" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding NextPageCommand}" ToolTip="Página siguiente" />

            <Border Width="1" Background="#33FFFFFF" Margin="6,4" />

            <!-- Zoom controls -->
            <Button Content="&#x2212;" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding ZoomOutCommand}" ToolTip="Alejar (Zoom -)" />
            <TextBlock Text="{Binding ZoomPercentText}"
                       Foreground="#94A3B8"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Width="38"
                       TextAlignment="Center" />
            <Button Content="+" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding ZoomInCommand}" ToolTip="Acercar (Zoom +)" />

            <Border Width="1" Background="#33FFFFFF" Margin="6,4" />

            <!-- Presets: 100%, Ajustar página, 2 páginas -->
            <Button Content="100%" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding Zoom100Command}" ToolTip="Zoom real 100%" />
            <Button Content="Ajustar página" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding FitPageCommand}" ToolTip="Ajustar página a la pantalla" />
            <Button Content="{Binding TwoPageButtonLabel}" Style="{StaticResource Button.MacHud}" Padding="8,4"
                    Command="{Binding ToggleTwoPageCommand}" ToolTip="Alternar 1 página / 2 páginas" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Status Bar -->
      <TextBlock Grid.Row="2" Margin="10,8" Text="{Binding StatusText}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
    </Grid>
  </Border>
</UserControl>
