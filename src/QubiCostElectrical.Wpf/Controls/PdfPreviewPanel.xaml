<UserControl x:Class="QubiCostElectrical.Wpf.Controls.PdfPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Sm}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="10,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="◀" Style="{StaticResource Button.Ghost}" Padding="8,4" Command="{Binding PreviousPageCommand}" />
          <TextBlock VerticalAlignment="Center" Margin="8,0"
                     Text="{Binding PageIndicator}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
          <Button Content="▶" Style="{StaticResource Button.Ghost}" Padding="8,4" Command="{Binding NextPageCommand}" />
        </StackPanel>
        <TextBlock Text="Vista previa PDF" Style="{StaticResource Text.SectionLabel}" />
      </DockPanel>

      <Border Grid.Row="1" Background="{DynamicResource Brush.Surface2}" Padding="16,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Surface2}">
          <Border Background="White" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border.Effect>
              <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.12" ShadowDepth="3" Direction="270" />
            </Border.Effect>
            <Image Source="{Binding CurrentPageImage}" Stretch="Uniform" MaxWidth="780" HorizontalAlignment="Center" />
          </Border>
        </ScrollViewer>
      </Border>

      <TextBlock Grid.Row="2" Margin="10,8" Text="{Binding StatusText}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Muted}" FontSize="11" />
    </Grid>
  </Border>
</UserControl>
