<UserControl x:Class="QubiCostElectrical.Wpf.Controls.WorkspacePageChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls">
  <Grid>
    <ContentPresenter Content="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Visibility="{Binding ShowEmptyState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

    <ctrl:EmptyStateControl Title="{Binding EmptyTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Description="{Binding EmptyDescription, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            IconText="{Binding EmptyIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding ShowEmptyState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
      <ctrl:EmptyStateControl.Actions>
        <ContentPresenter Content="{Binding EmptyActions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20"
                                   Message="{Binding LoadingMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
