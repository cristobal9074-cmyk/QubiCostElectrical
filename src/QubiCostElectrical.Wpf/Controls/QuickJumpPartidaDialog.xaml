<Window x:Class="QubiCostElectrical.Wpf.Controls.QuickJumpPartidaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Ir a partida / tablero / circuito (Ctrl+J · Ctrl+G)"
        Width="750" Height="520" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <Border Style="{StaticResource Dialog.Chrome}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="Ctrl+J / Ctrl+G" FontWeight="Bold" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Accent}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Quick Jump Inteligente" Style="{StaticResource Dialog.HeaderTitle}" Margin="0,0,0,2" />
          <TextBlock x:Name="SubtitleText" Text="Salta directamente a cualquier partida, capítulo, tablero SC o circuito en 1 clic."
                     FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" />
        </StackPanel>
      </DockPanel>

      <!-- Input de búsqueda -->
      <Border Grid.Row="1" Margin="0,0,0,10">
        <TextBox x:Name="SearchBox"
                 Style="{StaticResource Form.SearchBox}"
                 FontSize="{StaticResource Font.Size.base}"
                 Padding="8,8"
                 Tag="Buscar partida (ej. 1.2.3), capítulo, tablero (ej. TDA) o circuito…"
                 TextChanged="OnSearchBoxTextChanged"
                 PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
      </Border>

      <!-- Lista de resultados -->
      <Border Grid.Row="2" Style="{StaticResource Card.Surface}" Padding="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
        <ListBox x:Name="ResultsList"
                 ItemsSource="{Binding FilteredItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="OnResultsListMouseDoubleClick"
                 SelectionChanged="OnResultsListSelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Partida}">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,1" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                  <Setter Property="IsEnabled" Value="False" />
                  <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                  <Setter Property="Padding" Value="10,6" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type ctrl:QuickJumpPartidaItem}">
              <Grid Margin="2,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Badge de Categoría (PARTIDA, CAPÍTULO, TABLERO SC, CIRCUITO) -->
                <Border Grid.Column="0" Margin="0,0,8,0"
                        Background="{Binding CategoryBadgeBackground}"
                        BorderBrush="{Binding CategoryBadgeForeground}" BorderThickness="1"
                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                        MinWidth="64" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding CategoryBadgeText}"
                             FontFamily="Consolas, Segoe UI Mono, monospace"
                             FontWeight="Bold"
                             FontSize="{StaticResource Font.Size.xs}"
                             Foreground="{Binding CategoryBadgeForeground}"
                             HorizontalAlignment="Center" />
                </Border>

                <!-- Código en pill/badge monospace si existe -->
                <Border Grid.Column="1" Margin="0,0,10,0"
                        Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                        MinWidth="48" HorizontalAlignment="Left"
                        Visibility="{Binding Codigo, Converter={StaticResource StringNotEmptyToVisibility}}">
                  <TextBlock Text="{Binding Codigo}"
                             FontFamily="Consolas, Segoe UI Mono, monospace"
                             FontWeight="Bold"
                             FontSize="{StaticResource Font.Size.sm}"
                             Foreground="{DynamicResource Brush.Accent}"
                             HorizontalAlignment="Center" />
                </Border>

                <!-- Descripción y Capítulo -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Descripcion}"
                             FontSize="{StaticResource Font.Size.base}"
                             FontWeight="{Binding EsTitulo, Converter={StaticResource BoolToFontWeight}}"
                             Foreground="{DynamicResource Brush.Ink}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Capitulo}"
                             FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,2,0,0"
                             Visibility="{Binding HasCapitulo, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Cantidad / Badge -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="{Binding CantidadUnidadText}"
                             FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}"
                             VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding CantidadUnidadText, Converter={StaticResource StringNotEmptyToVisibility}}" />

                  <Border Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                          Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BadgeText}"
                               FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink2}" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Footer con atajos de navegación -->
      <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
            <TextBlock Text="Enter" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" />
          </Border>
          <TextBlock Text="Saltar a elemento" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />

          <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
            <TextBlock Text="↑ ↓" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" />
          </Border>
          <TextBlock Text="Navegar" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />

          <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
            <TextBlock Text="Esc" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" />
          </Border>
          <TextBlock Text="Cerrar" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                   VerticalAlignment="Center" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
