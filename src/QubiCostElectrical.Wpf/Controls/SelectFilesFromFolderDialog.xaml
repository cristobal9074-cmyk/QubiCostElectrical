<Window x:Class="QubiCostElectrical.Wpf.Controls.SelectFilesFromFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="TitleBlock" Style="{StaticResource Text.ViewTitle}" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" Text="Marque los archivos que desea agregar."
               Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,10" />

    <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
      <ComboBox DockPanel.Dock="Left" x:Name="ExtensionFilterBox" Style="{StaticResource Form.ComboBox}"
                MinWidth="180" SelectionChanged="OnExtensionFilterChanged" />
      <CheckBox DockPanel.Dock="Left" x:Name="IncludeSubfoldersBox" Content="Incluir subcarpetas"
                VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnIncludeSubfoldersChanged" Unchecked="OnIncludeSubfoldersChanged" />
    </DockPanel>

    <Border Grid.Row="3" Style="{StaticResource Card.Section}" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="FilesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,7">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="4" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="Seleccionar todo" Style="{StaticResource Button.Secondary}" Click="OnSelectAll" />
      <Button DockPanel.Dock="Right" Content="Agregar seleccionados" Style="{StaticResource Button.Primary}" Width="170" Margin="8,0,0,0" Click="OnAccept" />
      <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Button.Secondary}" IsCancel="True" Width="90" />
    </DockPanel>
  </Grid>
</Window>
