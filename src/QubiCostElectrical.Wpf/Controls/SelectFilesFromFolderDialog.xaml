<Window x:Class="QubiCostElectrical.Wpf.Controls.SelectFilesFromFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Width="920" Height="640"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header con título y ruta -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock x:Name="TitleBlock" Style="{StaticResource Text.ViewTitle}" Margin="0,0,0,2" />
      <TextBlock x:Name="FolderPathBlock" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Ink3}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Barra de Filtros y contador -->
    <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <ComboBox x:Name="ExtensionFilterBox" Style="{StaticResource Form.ComboBox}"
                  MinWidth="180" Height="30" SelectionChanged="OnExtensionFilterChanged" />
        <CheckBox x:Name="IncludeSubfoldersBox" Content="Incluir subcarpetas"
                  VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnIncludeSubfoldersChanged" Unchecked="OnIncludeSubfoldersChanged" />
      </StackPanel>
      <TextBlock x:Name="SelectionCountBlock" DockPanel.Dock="Right" VerticalAlignment="Center"
                 Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
    </DockPanel>

    <!-- Contenido principal: Lista de archivos a la izquierda + Previsualización en vivo a la derecha -->
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <!-- Panel Izquierdo: Lista de archivos con CheckBox, Badge, Nombre y Tamaño -->
      <Border Grid.Column="0" Style="{StaticResource Card.Section}" Padding="0" Margin="0,0,12,0">
        <ListBox x:Name="FilesList" BorderThickness="0" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectedFileChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="10,6" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line2}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" Click="OnItemCheckboxClicked" />
                <Border Grid.Column="1" Background="{DynamicResource Brush.Line2}" CornerRadius="4" Padding="5,2" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ExtensionBadge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Ink}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                  <TextBlock Text="{Binding SizeText}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Panel Derecho: Previsualizador del Archivo de la Carpeta -->
      <Border Grid.Column="1" Style="{StaticResource Card.Section}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Título del archivo previsualizado -->
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="PREVISUALIZACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,2" />
            <TextBlock x:Name="PreviewNameBlock" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" Text="Seleccione un archivo" />
            <TextBlock x:Name="PreviewMetaBlock" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,2,0,0" Text="Para ver su contenido" />
          </StackPanel>

          <!-- Visor de imagen / PDF -->
          <Border Grid.Row="1" Background="{DynamicResource Brush.Line2}" CornerRadius="6" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Image x:Name="PreviewImageCtrl" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📐" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock x:Name="PlaceholderTitle" Text="Previsualización no disponible" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" />
                <TextBlock x:Name="PlaceholderSubtitle" Text="para este formato de archivo" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Controles de navegación multipágina -->
          <StackPanel Grid.Row="2" x:Name="PageControlsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
            <Button Content="◀" x:Name="PrevPageBtn" Width="28" Height="24" Padding="0" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}" Click="OnPrevPage" />
            <TextBlock x:Name="PageIndicatorBlock" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,8,0" Text="1 / 1" />
            <Button Content="▶" x:Name="NextPageBtn" Width="28" Height="24" Padding="0" Style="{StaticResource Button.Secondary}" Click="OnNextPage" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer con acciones -->
    <DockPanel Grid.Row="3" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="Seleccionar todo" Style="{StaticResource Button.Secondary}" Height="30" Padding="12,0" Margin="0,0,8,0" Click="OnSelectAll" />
        <Button Content="Deseleccionar todo" Style="{StaticResource Button.Secondary}" Height="30" Padding="12,0" Click="OnDeselectAll" />
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Agregar seleccionados" Style="{StaticResource Button.Primary}" Height="32" Width="180" Margin="8,0,0,0" Click="OnAccept" />
      <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Button.Secondary}" IsCancel="True" Height="32" Width="90" />
    </DockPanel>
  </Grid>
</Window>
