<Window x:Class="QubiCostElectrical.Wpf.Controls.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        SizeToContent="Height"
        Width="440"
        MinWidth="360"
        MaxWidth="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText"
               Grid.Row="0"
               Text="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
               Style="{StaticResource Text.SectionLabel}"
               Margin="0,0,0,8" />

    <TextBlock x:Name="MessageText"
               Grid.Row="1"
               Text="{Binding DialogMessage, RelativeSource={RelativeSource AncestorType=Window}}"
               Style="{StaticResource Text.Body}"
               TextWrapping="Wrap" />

    <Border x:Name="WarningBanner"
            Grid.Row="2"
            Style="{StaticResource Dialog.Banner.Warning}"
            Visibility="Collapsed">
      <TextBlock x:Name="WarningBannerText"
                 Style="{StaticResource Dialog.Banner.Text}"
                 Foreground="{DynamicResource Brush.Amber}" />
    </Border>

    <Border x:Name="ErrorBanner"
            Grid.Row="2"
            Style="{StaticResource Dialog.Banner.Error}"
            Visibility="Collapsed">
      <TextBlock x:Name="ErrorBannerText"
                 Style="{StaticResource Dialog.Banner.Text}"
                 Foreground="{DynamicResource Brush.DangerDark}" />
    </Border>

    <DockPanel Grid.Row="3" Style="{StaticResource Dialog.Footer}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton"
                Content="Cancelar"
                Style="{StaticResource Button.Secondary}"
                Width="96"
                Margin="0,0,8,0"
                IsCancel="True"
                Click="OnCancelClick" />
        <Button x:Name="SecondaryButton"
                Content="No"
                Style="{StaticResource Button.Secondary}"
                Width="96"
                Margin="0,0,8,0"
                Click="OnSecondaryClick" />
        <Button x:Name="PrimaryButton"
                Content="Aceptar"
                Style="{StaticResource Button.Primary}"
                Width="96"
                IsDefault="True"
                Click="OnPrimaryClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
