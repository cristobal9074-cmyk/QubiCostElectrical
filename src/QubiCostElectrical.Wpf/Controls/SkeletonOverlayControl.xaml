<UserControl x:Class="QubiCostElectrical.Wpf.Controls.SkeletonOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Skeleton.Bar" TargetType="Border">
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Style.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard Storyboard="{StaticResource Anim.Shimmer}" />
        </EventTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Border Background="{DynamicResource Brush.Surface}" Opacity="0.94">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
      <Border Style="{StaticResource Skeleton.Bar}" Width="220" HorizontalAlignment="Left" />
      <Border Style="{StaticResource Skeleton.Bar}" Width="280" />
      <Border Style="{StaticResource Skeleton.Bar}" Width="240" HorizontalAlignment="Left" />
      <Border Style="{StaticResource Skeleton.Bar}" Width="180" HorizontalAlignment="Left" Margin="0,6,0,0" />
      <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Style="{StaticResource Form.ProgressBar}" />
      <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Style="{StaticResource Text.Caption}"
                 HorizontalAlignment="Center"
                 Margin="0,10,0,0" />
    </StackPanel>
  </Border>
</UserControl>
