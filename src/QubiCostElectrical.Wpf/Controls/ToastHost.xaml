<UserControl x:Class="QubiCostElectrical.Wpf.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <ItemsControl x:Name="ToastItems" IsHitTestVisible="True">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemContainerStyle>
      <Style TargetType="ContentPresenter">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform">
          <Setter.Value>
            <TranslateTransform X="30" />
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource Anim.SlideInRight}" />
          </EventTrigger>
        </Style.Triggers>
      </Style>
    </ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type infra:ToastMessage}">
        <Border x:Name="ToastCard"
                MinWidth="300" MaxWidth="440" Margin="0,0,0,10" Padding="14,12"
                CornerRadius="8" BorderThickness="3.5,1,1,1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                MouseEnter="OnToastMouseEnter"
                MouseLeave="OnToastMouseLeave">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                              Color="{DynamicResource Color.Shadow}" Opacity="0.16" />
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon Badge -->
            <Border x:Name="BadgeBorder" Width="28" Height="28" CornerRadius="14" Margin="0,1,12,0"
                    BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Center">
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path x:Name="BadgeIcon" Style="{StaticResource Icon.Vector.Sm}" />
                <TextBlock x:Name="BadgeGlyph" Text="{Binding IconGlyph}" FontWeight="Bold" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                         Foreground="{DynamicResource Brush.Ink}" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0"
                         FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" LineHeight="16" />
              <Button Content="{Binding ActionLabel}"
                      Style="{StaticResource Button.Secondary}"
                      Padding="10,2"
                      MinHeight="26"
                      FontSize="11"
                      HorizontalAlignment="Left"
                      Margin="0,8,0,0"
                      Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Click="OnToastActionClick"
                      Tag="{Binding}" />
            </StackPanel>

            <!-- Dismiss Button -->
            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}"
                    Width="24" Height="24" Padding="0" Margin="8,0,0,0"
                    VerticalAlignment="Top" Click="OnDismissToastClick" Tag="{Binding}"
                    ToolTip="Cerrar notificación">
              <Path Data="{StaticResource Geo.Close}" Style="{StaticResource Icon.Vector.Sm}"
                    Stroke="{DynamicResource Brush.Muted}" />
            </Button>
          </Grid>
        </Border>

        <DataTemplate.Triggers>
          <!-- Level: Success -->
          <DataTrigger Binding="{Binding Level}" Value="Success">
            <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Geo.Check}" />
            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{DynamicResource Brush.Green}" />
          </DataTrigger>

          <!-- Level: Warning -->
          <DataTrigger Binding="{Binding Level}" Value="Warning">
            <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Geo.AlertTriangle}" />
            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{DynamicResource Brush.AmberRisk}" />
          </DataTrigger>

          <!-- Level: Error -->
          <DataTrigger Binding="{Binding Level}" Value="Error">
            <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource Brush.DangerBg}" />
            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Geo.Close}" />
            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{DynamicResource Brush.Danger}" />
          </DataTrigger>

          <!-- Level: Info -->
          <DataTrigger Binding="{Binding Level}" Value="Info">
            <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Geo.Info}" />
            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
          </DataTrigger>

          <!-- Custom Glyph Fallback -->
          <DataTrigger Binding="{Binding HasCustomGlyph}" Value="True">
            <Setter TargetName="BadgeIcon" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="BadgeGlyph" Property="Visibility" Value="Visible" />
          </DataTrigger>

          <!-- Undo Custom Glyph -->
          <DataTrigger Binding="{Binding IsUndo}" Value="True">
            <Setter TargetName="BadgeGlyph" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="BadgeIcon" Property="Visibility" Value="Visible" />
            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Geo.Undo}" />
            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
          </DataTrigger>

          <!-- Redo Custom Glyph -->
          <DataTrigger Binding="{Binding IsRedo}" Value="True">
            <Setter TargetName="BadgeGlyph" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="BadgeIcon" Property="Visibility" Value="Visible" />
            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource Geo.Redo}" />
            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
