<UserControl x:Class="QubiCostElectrical.Wpf.Controls.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="32"
          HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360" MaxWidth="560">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"
                 Foreground="{DynamicResource Brush.Muted}"
                 Visibility="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringNotEmptyToVisibility}}" />
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Style="{StaticResource Text.ViewTitle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
      <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" />
      <ContentPresenter Content="{Binding Actions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
