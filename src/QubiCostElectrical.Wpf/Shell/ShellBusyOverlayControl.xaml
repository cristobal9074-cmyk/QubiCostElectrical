<UserControl x:Class="QubiCostElectrical.Wpf.Shell.ShellBusyOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource Brush.Canvas}"
          IsHitTestVisible="True">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsBusy}" Value="True">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="52" Height="52" CornerRadius="12"
              Background="{DynamicResource Brush.BlueFaint}"
              HorizontalAlignment="Center" Margin="0,0,0,14">
        <Path Data="{StaticResource Geo.Spinner}" Style="{StaticResource Icon.Vector.Xl}"
              Stroke="{DynamicResource Brush.Blue}"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform Angle="0" />
          </Path.RenderTransform>
          <Path.Triggers>
            <EventTrigger RoutedEvent="Path.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                   From="0" To="360" Duration="0:0:1.2" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
      </Border>
      <TextBlock Text="{Binding BusyMessage, FallbackValue='Procesando…'}"
                 FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Ink2}"
                 HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Text="Por favor espere un momento"
                 FontSize="11"
                 Foreground="{DynamicResource Brush.Muted}"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
