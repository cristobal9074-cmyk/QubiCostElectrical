<Window x:Class="QubiCostElectrical.Wpf.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:QubiCostElectrical.Wpf.Shell"
        xmlns:nav="clr-namespace:QubiCostElectrical.Wpf.Navigation"
        xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
        Title="{Binding WindowTitleText, Mode=OneWay, FallbackValue='QUBI COST Electrical'}"
        Icon="pack://application:,,,/Assets/QubiCostElectrical.ico"
        MinWidth="{StaticResource Layout.MinWindowWidth}"
        MinHeight="{StaticResource Layout.MinWindowHeight}"
        Width="1280"
        Height="800"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Canvas}"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        Loaded="OnLoaded"
        PreviewKeyDown="OnWindowKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1"
                  NonClientFrameEdges="None"
                  ResizeBorderThickness="4"
                  CaptionHeight="58"
                  CornerRadius="0" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Brush.HeaderBackground}"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
            Visibility="{Binding IsLandingScreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <StackPanel>
        <DockPanel Height="{StaticResource Layout.TopBarHeight}" Margin="20,0,8,0" LastChildFill="False">
          <!-- 1. Controles de ventana (Minimizar, Maximizar/Restaurar, Cerrar) - SIEMPRE fijados a la extrema derecha -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Width="34" Height="34"
                    Background="Transparent" BorderThickness="0"
                    Click="OnMinimizeClick" ToolTip="Minimizar"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderControl}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White25}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
            </Button>
            <Button x:Name="MaxRestoreButton" Width="34" Height="34"
                    Background="Transparent" BorderThickness="0"
                    Click="OnMaxRestoreClick" ToolTip="Maximizar"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderControl}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White25}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <TextBlock x:Name="MaxRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
            </Button>
            <Button x:Name="CloseButton" Width="34" Height="34"
                    Background="Transparent" BorderThickness="0"
                    Click="OnCloseClick" ToolTip="Cerrar"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderControl}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
            </Button>
          </StackPanel>

          <!-- 2. Acciones principales y Usuario - anclados a la derecha antes de los controles de ventana -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- Píldora reactiva de Guardado y Sincronización -->
            <Border Margin="0,0,10,0" Padding="8,3" CornerRadius="11" VerticalAlignment="Center"
                    Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource Brush.White8}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.White18}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                      <Setter Property="Background" Value="#33F59E0B" />
                      <Setter Property="BorderBrush" Value="#80F59E0B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                      <Setter Property="Background" Value="#333B82F6" />
                      <Setter Property="BorderBrush" Value="#803B82F6" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                  <!-- Guardado: punto verde suave -->
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.SuccessBright}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <!-- Sin guardar: punto ámbar -->
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.AmberRisk}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <!-- Solo lectura: candado Lucide -->
                  <Path Data="{StaticResource Geo.Lock}"
                        Stroke="{DynamicResource Brush.HeaderControl}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path.Style>
                      <Style TargetType="Path" BasedOn="{StaticResource Icon.Vector.Sm}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                </Grid>
                <TextBlock Text="{Binding SaveStateText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderStatus}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.BrandStroke2}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border>
            <Button x:Name="UndoButton" Style="{StaticResource Button.HeaderIcon}" Margin="0,0,2,0"
                    ToolTip="{Binding UndoToolTip, Mode=OneWay}" Click="OnUndoClick"
                    IsEnabled="{Binding CanUndo, Mode=OneWay}"
                    AutomationProperties.Name="Deshacer">
              <Path Data="{StaticResource Geo.Undo}" Style="{StaticResource Icon.Vector}" Width="13" Height="13" Stroke="{DynamicResource Brush.HeaderControl}" />
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource Button.HeaderIcon}" Margin="0,0,8,0"
                    ToolTip="{Binding RedoToolTip, Mode=OneWay}" Click="OnRedoClick"
                    IsEnabled="{Binding CanRedo, Mode=OneWay}"
                    AutomationProperties.Name="Rehacer">
              <Path Data="{StaticResource Geo.Redo}" Style="{StaticResource Icon.Vector}" Width="13" Height="13" Stroke="{DynamicResource Brush.HeaderControl}" />
            </Button>
            <Button Content="Guardar" Margin="0,0,6,0"
                    Click="OnSaveClick"
                    IsEnabled="{Binding CanSaveProject, Mode=OneWay}"
                    ToolTip="Guardar el proyecto (Ctrl+S). Deshabilitado en solo lectura (Visor o bloqueo)."
                    AutomationProperties.Name="Guardar"
                    AutomationProperties.HelpText="Disponible solo con proyecto abierto y modo edición">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                  <Setter Property="Background" Value="{DynamicResource Brush.White12}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.White18}" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.White25}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                      <Setter Property="Background" Value="#332563EB" />
                      <Setter Property="BorderBrush" Value="#803B82F6" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource Button.Primary}" Margin="0,0,6,0" Click="OnReviewClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cerrar oferta" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        MinWidth="16"
                        Height="16"
                        Margin="8,0,0,0"
                        Padding="3,0"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.DangerDark}"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding AlertCount, Mode=OneWay}"
                             FontSize="10"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.White}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Border x:Name="UserAvatar" Width="30" Height="30" CornerRadius="{StaticResource Radius.Sm}" Background="{DynamicResource Brush.AvatarBg}" Cursor="Hand" ToolTip="{Binding UserDisplayName, Mode=OneWay}" MouseDown="OnUserAvatarClick">
              <TextBlock Text="{Binding UserInitials, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="UserMenuPopup"
                   PlacementTarget="{Binding ElementName=UserAvatar}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   Closed="OnUserMenuPopupClosed">
              <Border Width="200"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="6"
                      SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Color="{DynamicResource Color.Shadow}" Opacity="0.28" />
                </Border.Effect>
                <StackPanel>
                  <TextBlock Text="{Binding UserDisplayName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="10,8,10,2" />
                  <TextBlock Text="{Binding UserEmail, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource Brush.HeaderDim}" Margin="10,0,10,8" />
                  <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="4,0" />
                  <Button Click="OnAboutMenuClick"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10,7"
                          Margin="0,4,0,0"
                          Cursor="Hand"
                          HorizontalContentAlignment="Stretch"
                          ToolTip="Ver información de versión, licencia corporativa y novedades">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="ℹ️" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Acerca de Qubi Cost" FontSize="10.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding LogoutCommand}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10,7"
                          Margin="0,2,0,0"
                          Cursor="Hand"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="{StaticResource Geo.LogOut}" Style="{StaticResource Icon.Vector.Sm}" Stroke="{DynamicResource Brush.Slate}" Margin="0,0,8,0" />
                      <TextBlock Text="Cerrar sesión" FontSize="10.5" Foreground="{DynamicResource Brush.Slate}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Popup>
          </StackPanel>

          <!-- 3. Logo y Marca (Clic para Acerca de) -->
          <Button x:Name="BrandAboutButton"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  DockPanel.Dock="Left"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="0"
                  Cursor="Hand"
                  Click="OnBrandAboutClick"
                  ToolTip="Acerca de Qubi Cost Electrical (Versión, Licencia y Novedades)">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4,2">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White12}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="34" Height="34" Background="Transparent" Margin="0,0,9,0">
                <Image Source="pack://application:,,,/Assets/brand_logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ApplicationName, Mode=OneWay}" Style="{StaticResource Text.HeaderBrand}" FontSize="13" />
                <TextBlock Text="{Binding ApplicationSub, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.HeaderMuted}" />
              </StackPanel>
            </StackPanel>
          </Button>

          <!-- 4. Selector de proyectos con ancho acotado y elipsis para nombres largos -->
          <Button x:Name="ProjectPickerButton" WindowChrome.IsHitTestVisibleInChrome="True" DockPanel.Dock="Left" Margin="14,0,0,0" Height="36" MinWidth="180" MaxWidth="300" Cursor="Hand" Background="{DynamicResource Brush.White8}" BorderBrush="{DynamicResource Brush.White18}" BorderThickness="1" Padding="11,0" Click="OnProjectPickerClick" AutomationProperties.Name="Selector de proyectos" AutomationProperties.HelpText="{Binding ActiveProjectLabel, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
              <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.HeaderIconBlue}" Margin="0,0,8,0">
                <Viewbox Width="14" Height="14">
                  <Canvas Width="28" Height="28">
                    <Polygon Points="14,1 27,7.5 27,20.5 14,27 1,20.5 1,7.5" Fill="{DynamicResource Brush.BrandDark}" Stroke="{DynamicResource Brush.BrandStroke2}" StrokeThickness="1.3"/>
                    <Path Data="M16 5 L11 14 L14 14 L12 23 L19 12 L16 12 Z" Fill="White"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <StackPanel VerticalAlignment="Center" MaxWidth="210">
                <TextBlock Text="PROYECTO ACTIVO" FontSize="10" Foreground="{DynamicResource Brush.HeaderLabel}" />
                <TextBlock Text="{Binding ActiveProjectLabel, Mode=OneWay}" 
                           FontSize="10" 
                           Foreground="{DynamicResource Brush.White}" 
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ActiveProjectLabel, Mode=OneWay}" />
              </StackPanel>
              <Path Data="{StaticResource Geo.ChevronDown}" Style="{StaticResource Icon.Vector.Sm}" Width="8" Height="8" Stroke="{DynamicResource Brush.HeaderNav}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- 5. Barra de búsqueda en la cabecera (Siempre visible y de alto contraste) -->
          <Border x:Name="SearchShell"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  DockPanel.Dock="Left"
                  Margin="14,0,0,0"
                  Height="36"
                  Width="260"
                  MaxWidth="340"
                  Background="{DynamicResource Brush.NavyDeep}"
                  BorderBrush="{DynamicResource Brush.NavyBorder}"
                  BorderThickness="1"
                  CornerRadius="11"
                  VerticalAlignment="Center">
            <Border.Resources>
              <Style x:Key="HeaderSearchBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.BrandStroke2}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Blue2}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                      <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <TextBlock x:Name="Watermark"
                                   Text="{TemplateBinding Tag}"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.HeaderMuted}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Visibility="Collapsed" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <MultiTrigger>
                          <MultiTrigger.Conditions>
                            <Condition Property="Text" Value="" />
                            <Condition Property="IsKeyboardFocused" Value="False" />
                          </MultiTrigger.Conditions>
                          <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Border.Resources>
            <DockPanel Margin="10,0">
              <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Icon.Vector}" Width="13" Height="13" Stroke="{DynamicResource Brush.BrandStroke2}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Brush.NavyBorder2}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.NavyDeep2}">
                <TextBlock Text="Ctrl+P / Ctrl+K" FontSize="9" Foreground="{DynamicResource Brush.Slate3}" FontWeight="SemiBold" />
              </Border>
              <TextBox x:Name="TopSearchBox"
                       Style="{StaticResource HeaderSearchBox}"
                       Tag="Buscar en todo el proyecto…"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       GotKeyboardFocus="OnSearchBoxGotKeyboardFocus"
                       PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
            </DockPanel>
          </Border>

          <Popup x:Name="QuickSearchPopup"
                 PlacementTarget="{Binding ElementName=SearchShell}"
                 Placement="Bottom"
                 HorizontalOffset="-100"
                 VerticalOffset="8"
                 AllowsTransparency="True"
                 PopupAnimation="Fade"
                 StaysOpen="False"
                 Opened="OnPopupSlideInOpened"
                 Closed="OnQuickSearchPopupClosed">
            <Popup.Resources>
              <Style x:Key="SpotlightSearchBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Blue}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Brush.BlueSoft}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                      <Grid VerticalAlignment="Center">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Padding="{TemplateBinding Padding}" />
                        <TextBlock x:Name="Watermark"
                                   Text="{TemplateBinding Tag}"
                                   Padding="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource Brush.Ink4}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                          <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Null}">
                          <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                          <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>

              <Style x:Key="SpotlightItemButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="Stretch"
                              SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>

              <Style x:Key="SpotlightFilterChip" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="6"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.BlueDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Popup.Resources>
            <Border Width="720"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="16"
                    SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="{DynamicResource Color.Shadow}" Opacity="0.25" />
              </Border.Effect>
              <StackPanel>
                <!-- 1. BARRA DE BÚSQUEDA INTEGRADA EN EL MODAL -->
                <Border Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10"
                        CornerRadius="16,16,0,0">
                  <DockPanel>
                    <!-- Ícono de Lupa Azul de la App -->
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.BlueSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                      <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Icon.Vector.Md}" Stroke="{DynamicResource Brush.Blue}" />
                    </Border>

                    <!-- Botón Limpiar [✕] -->
                    <Button DockPanel.Dock="Right"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            Margin="6,0,0,0"
                            Cursor="Hand"
                            ToolTip="Borrar texto (Esc)">
                      <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10" Width="22" Height="22">
                        <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Button>

                    <!-- Contador de Resultados / Badge Atajo -->
                    <Border DockPanel.Dock="Right"
                            Background="{DynamicResource Brush.BlueFaint}"
                            BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding ResultCountLabel, FallbackValue='0 resultados'}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.BlueDark}" />
                    </Border>

                    <!-- Campo de Texto Principal (Grande, Nítido, Alto Contraste) -->
                    <TextBox x:Name="PopupSearchBox"
                             Style="{StaticResource SpotlightSearchBoxStyle}"
                             Tag="Escribe para buscar partidas, cubicación, APU, insumos o comandos…"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             GotKeyboardFocus="OnSearchBoxGotKeyboardFocus"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
                  </DockPanel>
                </Border>

                <!-- 2. SELECTOR DE CATEGORÍAS SEGMENTADO (ESTILO CHIP DE LA APP) -->
                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line2}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                  <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="Tab para alternar filtro" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Todos" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="All">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="All">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="📋 Partidas" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="Partidas">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="Partidas">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="📐 Cubicación" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="Cubicacion">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="Cubicacion">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="📊 APU" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="Apu">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="Apu">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="🏛️ Banco Precios" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="Materiales">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="Materiales">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="⚡ Tableros SC" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="TablerosSc">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="TablerosSc">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="🧭 Módulos" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="Navigation">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="Navigation">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="⚙️ Acciones" Command="{Binding SetPaletteCategoryCommand}" CommandParameter="Actions">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SpotlightFilterChip}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPaletteCategory}" Value="Actions">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </Border>

                <!-- 3. LISTA DE RESULTADOS / ESTADO VACÍO -->
                <Grid MinHeight="160" MaxHeight="380">
                  <!-- Estado Vacío cuando no hay resultados -->
                  <StackPanel Visibility="{Binding HasQuickSearchResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="24">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                      <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Icon.Vector.Lg}" Stroke="{DynamicResource Brush.Ink4}" />
                    </Border>
                    <TextBlock Text="No se encontraron coincidencias" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Center" />
                    <TextBlock Text="Prueba con otro término o selecciona 'Todos' para buscar en todo el proyecto" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                  </StackPanel>

                  <!-- Lista con resultados -->
                  <ListBox ItemsSource="{Binding QuickSearchResults}"
                           SelectedItem="{Binding SelectedQuickSearchItem, Mode=TwoWay}"
                           x:Name="QuickSearchList"
                           Background="Transparent"
                           BorderThickness="0"
                           HorizontalContentAlignment="Stretch"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           SelectionChanged="OnQuickSearchSelectionChanged"
                           Padding="8,6"
                           Visibility="{Binding HasQuickSearchResults, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="ItemBorder"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="0"
                                      SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                  <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
                                  <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SpotlightItemButtonStyle}"
                                Click="OnQuickSearchItemClick">
                          <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                              <!-- Col 0: Ancho fijo para badges para que todos los títulos inicien alineados -->
                              <ColumnDefinition Width="116" />
                              <!-- Col 1: Título y subtítulo expandiéndose -->
                              <ColumnDefinition Width="*" />
                              <!-- Col 2: Atajo anclado al extremo derecho -->
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Badge e Icono de Categoría (Pill alineado a la izquierda) -->
                            <Border Grid.Column="0"
                                    Background="{Binding CategoryBadgeBrush}"
                                    BorderBrush="{Binding CategoryBadgeForeground}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10.5"
                                           Foreground="{Binding CategoryBadgeForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="{Binding CategoryLabel}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="{Binding CategoryBadgeForeground}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>

                            <!-- Textos Principales: Título y Subtítulo -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="12.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}"
                                         Margin="0,2,0,0"
                                         FontSize="10.5"
                                         Foreground="{DynamicResource Brush.Ink3}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Atajo o Ubicación (Pill anclado a la derecha) -->
                            <Border Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    CornerRadius="5"
                                    Background="{DynamicResource Brush.Surface2}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1">
                              <TextBlock Text="{Binding Shortcut}"
                                         FontSize="9.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink3}" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <!-- 4. FOOTER CON GUÍA DE ERGONOMÍA -->
                <Border Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0"
                        Padding="14,9"
                        CornerRadius="0,0,16,16">
                  <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <!-- Tecla Enter -->
                      <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,5,0">
                        <TextBlock Text="↵ Enter" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                      </Border>
                      <TextBlock Text="Ejecutar / Ir" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="0,0,14,0" />

                      <!-- Teclas ↑ ↓ -->
                      <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,5,0">
                        <TextBlock Text="↑ ↓" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                      </Border>
                      <TextBlock Text="Navegar" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="0,0,14,0" />

                      <!-- Tecla Tab -->
                      <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,5,0">
                        <TextBlock Text="Tab" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                      </Border>
                      <TextBlock Text="Alternar categoría" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="0,0,14,0" />

                      <!-- Tecla Esc -->
                      <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,5,0">
                        <TextBlock Text="Esc" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                      </Border>
                      <TextBlock Text="Cerrar" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Identidad de Marca -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="⚡ Qubi Cost Spotlight" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </Popup>

          <!-- ═══ POPUP SELECTOR DE PROYECTOS ═══ -->
          <Popup x:Name="ProjectPickerPopup"
                 PlacementTarget="{Binding ElementName=ProjectPickerButton}"
                 Placement="Bottom"
                 HorizontalOffset="0"
                 VerticalOffset="8"
                 AllowsTransparency="True"
                 PopupAnimation="None"
                 StaysOpen="False"
                 Opened="OnProjectPickerPopupOpened"
                 Closed="OnProjectPickerPopupClosed">
            <Border x:Name="ProjectPickerRoot"
                    Width="420"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="16"
                    SnapsToDevicePixels="True"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    PreviewKeyDown="OnProjectPickerKeyDown"
                    Focusable="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="{DynamicResource Color.Shadow}" Opacity="0.30" />
              </Border.Effect>
              <StackPanel Margin="14,12">

                <!-- Header -->
                <TextBlock Text="PROYECTO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink5}" Margin="4,0,0,10" />

                <!-- Acciones principales -->
                <Button x:Name="NewProjectBtn"
                        Height="38" Margin="0,0,0,4"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Click="OnNewProjectClick"
                        IsEnabled="{Binding CanExecuteActions}"
                        AutomationProperties.Name="Nuevo proyecto"
                        AutomationProperties.HelpText="Crear un nuevo presupuesto">
                  <Border CornerRadius="10" Padding="12,0" Height="38">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.BlueHover}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nuevo proyecto" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBlock Text="Crear un nuevo presupuesto" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+N" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink6}" />
                      </Border>
                    </DockPanel>
                  </Border>
                </Button>

                <Button x:Name="OpenProjectBtn" Height="38" Margin="0,0,0,4"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Click="OnOpenProjectFromPickerClick"
                        IsEnabled="{Binding CanExecuteActions}"
                        AutomationProperties.Name="Abrir archivo"
                        AutomationProperties.HelpText="Abrir un presupuesto existente">
                  <Border CornerRadius="10" Padding="12,0" Height="38">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.SuccessBg}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource Geo.FolderOpen}" Style="{StaticResource Icon.Vector.Md}" Stroke="{DynamicResource Brush.SuccessBright}" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Abrir archivo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBlock Text="Abrir un presupuesto existente" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+O" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink6}" />
                      </Border>
                    </DockPanel>
                  </Border>
                </Button>

                <Button Height="38" Margin="0,0,0,4"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Click="OnSaveAsClick"
                        Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding CanSaveProjectAs}"
                        AutomationProperties.Name="Guardar como"
                        AutomationProperties.HelpText="Guardar una copia con nuevo nombre">
                  <Border CornerRadius="10" Padding="12,0" Height="38">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.BlueFaint}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource Geo.SaveAs}" Style="{StaticResource Icon.Vector.Md}" Stroke="{DynamicResource Brush.Blue2}" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Guardar como…" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBlock Text="Guardar una copia con nuevo nombre" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+⇧+S" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink6}" />
                      </Border>
                    </DockPanel>
                  </Border>
                </Button>

                <!-- Cerrar proyecto (solo si hay proyecto abierto) -->
                <Button x:Name="CloseProjectBtn" Height="38" Margin="0,0,0,0"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        Click="OnCloseProjectFromPickerClick"
                        Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding CanExecuteActions}"
                        AutomationProperties.Name="Cerrar proyecto"
                        AutomationProperties.HelpText="{Binding ActiveProjectLabel, Mode=OneWay}">
                  <Border CornerRadius="10" Padding="12,0" Height="38">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.DangerBg}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource Geo.Close}" Style="{StaticResource Icon.Vector.Sm}" Stroke="{DynamicResource Brush.Danger2}" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cerrar proyecto" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBlock Text="{Binding ActiveProjectLabel, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                      </StackPanel>
                      <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,2" CornerRadius="5" Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+W" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink6}" />
                      </Border>
                    </DockPanel>
                  </Border>
                </Button>

                <!-- Separador -->
                <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="4,10,4,10" />

                <!-- Sección Recientes -->
                <Grid Margin="4,0,4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="RECIENTES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink5}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding RecentProjects.Count, Mode=OneWay, StringFormat='{}{0}/8'}"
                             FontSize="9" Foreground="{DynamicResource Brush.HeaderMuted}" VerticalAlignment="Center" />
                </Grid>

                <!-- Estado vacío -->
                <TextBlock Text="No hay proyectos recientes"
                           FontSize="10" Foreground="{DynamicResource Brush.HeaderMuted}" HorizontalAlignment="Center" Margin="0,8,0,8"
                           Visibility="{Binding RecentProjects.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Empty}" />

                <!-- Lista de recientes -->
                <ItemsControl ItemsSource="{Binding RecentProjects}" MaxHeight="280"
                              Focusable="False">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="RecentItemBorder"
                              CornerRadius="10"
                              Margin="0,0,0,3"
                              Padding="2">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- Botón abrir (solo si no falta) -->
                          <Button Grid.Column="0"
                                  Background="Transparent" BorderThickness="0" Padding="10,6"
                                  HorizontalContentAlignment="Left"
                                  Cursor="Hand"
                                  Tag="{Binding Path}"
                                  Click="OnOpenRecentClick"
                                  IsEnabled="{Binding CanExecuteActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                  AutomationProperties.Name="{Binding Name}"
                                  AutomationProperties.HelpText="{Binding Path}"
                                  ToolTip="{Binding Path}">
                            <StackPanel>
                              <DockPanel>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Blue2}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                              <TextBlock Text="{Binding Path}" FontSize="9" Foreground="{DynamicResource Brush.HeaderDate}" Margin="14,2,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding DisplayDate}" FontSize="9" Foreground="{DynamicResource Brush.HeaderDate}" Margin="14,1,0,0" />
                            </StackPanel>
                          </Button>

                          <!-- Área de no disponible (solo si falta) -->
                          <StackPanel Grid.Column="0" Margin="10,6,4,6"
                                      Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}"
                                      Opacity="0.55">
                            <DockPanel>
                              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Slate3}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Slate}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Path}" FontSize="9" Foreground="{DynamicResource Brush.Slate2}" Margin="14,2,0,0" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="14,2,0,0">
                              <Border CornerRadius="4" Padding="4,1" Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1">
                                <TextBlock Text="No encontrado" FontSize="10" Foreground="{DynamicResource Brush.Danger2}" FontWeight="SemiBold" />
                              </Border>
                            </StackPanel>
                          </StackPanel>

                          <!-- Botón quitar -->
                          <Button Grid.Column="1"
                                  Width="26" Height="26"
                                  Background="Transparent" BorderThickness="0"
                                  Margin="4,0,6,0"
                                  Cursor="Hand"
                                  ToolTip="Quitar de recientes"
                                  Tag="{Binding Path}"
                                  Click="OnRemoveRecentClick"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Quitar de recientes">
                            <Button.Style>
                              <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                  </DataTrigger>
                                  <!-- siempre visible en entradas faltantes -->
                                  <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Opacity" Value="0.7" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.Canvas}">
                              <Path Data="{StaticResource Geo.Close}" Style="{StaticResource Icon.Vector.Sm}" Stroke="{DynamicResource Brush.Slate}" />
                            </Border>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </Popup>
        </DockPanel>

        <Border Height="1" Background="{DynamicResource Brush.White12}" />

        <DockPanel x:Name="MainNavPanel" Height="{StaticResource Layout.NavBarHeight}" Margin="20,0" LastChildFill="False">
          <!-- Historial de Navegación Atrás / Adelante -->
          <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <Button Command="{Binding NavigateBackCommand}"
                    ToolTip="Volver a la vista anterior (Alt+←)"
                    Style="{StaticResource Button.HeaderIcon}"
                    Width="28" Height="28" Margin="0,0,3,0"
                    AutomationProperties.Name="Atrás"
                    AutomationProperties.HelpText="Navegar a la vista anterior (Alt+←)">
              <Path Data="{StaticResource Geo.ChevronLeft}" Style="{StaticResource Icon.Vector.Sm}" />
            </Button>
            <Button Command="{Binding NavigateForwardCommand}"
                    ToolTip="Avanzar a la vista siguiente (Alt+→)"
                    Style="{StaticResource Button.HeaderIcon}"
                    Width="28" Height="28"
                    AutomationProperties.Name="Adelante"
                    AutomationProperties.HelpText="Navegar a la vista siguiente (Alt+→)">
              <Path Data="{StaticResource Geo.ChevronRight}" Style="{StaticResource Icon.Vector.Sm}" />
            </Button>
          </StackPanel>

          <!-- Breadcrumb de Orientación Activa en Cabecera -->
          <Border DockPanel.Dock="Right"
                  Background="{DynamicResource Brush.White8}"
                  BorderBrush="{DynamicResource Brush.White18}"
                  BorderThickness="1" CornerRadius="12" Padding="12,4"
                  VerticalAlignment="Center" Margin="10,0,0,0"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding BreadcrumbGroup}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.HeaderNav}" VerticalAlignment="Center" />
              <Path Data="{StaticResource Geo.ChevronRight}" Style="{StaticResource Icon.Vector.Sm}" Width="6" Height="6"
                    Stroke="{DynamicResource Brush.HeaderDim}" Margin="6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PageTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.White}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Selector de ciclo de vida: Presupuesto | Planificación | Ejecución -->
          <Border Margin="0,0,8,0" Padding="2" CornerRadius="8" Background="{DynamicResource Brush.White8}" BorderBrush="{DynamicResource Brush.White12}" BorderThickness="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PhasePresupuestoButton"
                      Style="{StaticResource Button.PhasePill}"
                      Click="OnPhasePresupuestoClick"
                      ToolTip="Fase 1: Estudio, Cubicación y Cierre de Oferta">
                <TextBlock Text="Presupuesto" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Button>
              <Button x:Name="PhasePlanificacionButton"
                      Style="{StaticResource Button.PhasePill}"
                      Click="OnPhasePlanificacionClick"
                      Margin="2,0,0,0"
                      ToolTip="Fase 2: Abastecimiento, Sectorización y Línea Base">
                <TextBlock Text="Planificación" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Button>
              <Button x:Name="PhaseEjecucionButton"
                      Style="{StaticResource Button.PhasePill}"
                      Click="OnPhaseEjecucionClick"
                      Margin="2,0,0,0"
                      ToolTip="Fase 3: Control en Terreno, Adicionales y Cambios">
                <TextBlock Text="Ejecución" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Border>

          <Border Width="1" Height="20" Background="{DynamicResource Brush.White18}" Margin="0,0,8,0" VerticalAlignment="Center" />

          <!-- Botón Resumen (Dashboard) universal -->
          <Button x:Name="DashboardButton" Style="{StaticResource Button.NavHome}" Content="Resumen" Click="OnDashboardClick" />

          <!-- Sub-pestañas según fase activa -->
          <StackPanel x:Name="PhasePresupuestoPanel" Orientation="Horizontal" Margin="2,0,0,0">
            <shell:NavDropdownGroup x:Name="NavProjectGroup" GroupTitle="Proyecto" SectionLabel="Preparación del proyecto" Margin="2,0,0,0" />
            <StackPanel x:Name="BudgetNavTabs" Orientation="Horizontal">
              <Button x:Name="NavItemizadoTab" Style="{StaticResource Button.NavHome}" Content="Itemizado"
                      Tag="{x:Static nav:ShellRoute.Itemized}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
              <shell:NavDropdownGroup x:Name="NavCubicacionGroup" GroupTitle="Cubicación" SectionLabel="Toma de cantidades y APU" Margin="2,0,0,0" />
            </StackPanel>
            <shell:NavDropdownGroup x:Name="NavPricesGroup" GroupTitle="Precios" SectionLabel="Costos y abastecimiento" Margin="2,0,0,0" />
            <shell:NavDropdownGroup x:Name="NavCloseGroup" GroupTitle="Cierre y Costos" SectionLabel="Costos, control y oferta" Margin="2,0,0,0" />
          </StackPanel>

          <StackPanel x:Name="PhasePlanificacionPanel" Orientation="Horizontal" Margin="2,0,0,0" Visibility="Collapsed">
            <Button x:Name="NavPurchasesTab" Style="{StaticResource Button.NavHome}" Content="Lista de compra"
                    Tag="{x:Static nav:ShellRoute.Purchases}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
            <Button x:Name="NavFloorSummaryTab" Style="{StaticResource Button.NavHome}" Content="Sectorización pisos"
                    Tag="{x:Static nav:ShellRoute.FloorSummary}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
            <Button x:Name="NavPlanosTab" Style="{StaticResource Button.NavHome}" Content="Planos y antecedentes"
                    Tag="{x:Static nav:ShellRoute.Documents}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
          </StackPanel>

          <StackPanel x:Name="PhaseEjecucionPanel" Orientation="Horizontal" Margin="2,0,0,0" Visibility="Collapsed">
            <Button x:Name="NavQuotesTab" Style="{StaticResource Button.NavHome}" Content="Cotizaciones"
                    Tag="{x:Static nav:ShellRoute.Quotes}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
            <Button x:Name="NavAdicionalesTab" Style="{StaticResource Button.NavHome}" Content="Adicionales de obra"
                    Tag="{x:Static nav:ShellRoute.ChangeOrders}" Click="OnBudgetTabClick" Margin="2,0,0,0"
                    ToolTip="Adicionales y aumentos de obra: cálculo de partidas adicionales con precios unitarios congelados y partidas extraordinarias." />
            <Button x:Name="NavChangeOrdersTab" Style="{StaticResource Button.NavHome}" Content="Cambio de versión"
                    Tag="{x:Static nav:ShellRoute.Versions}" Click="OnBudgetTabClick" Margin="2,0,0,0"
                    ToolTip="Cambio de versión del presupuesto: comparar revisiones, ítems modificados y guardar nueva versión." />
            <Button x:Name="NavSolicitudesTab" Style="{StaticResource Button.NavHome}" Content="Solicitudes faena"
                    Tag="{x:Static nav:ShellRoute.Solicitudes}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
            <Button x:Name="NavMaterialControlTab" Style="{StaticResource Button.NavHome}" Content="Control de materiales"
                    Tag="{x:Static nav:ShellRoute.MaterialControl}" Click="OnBudgetTabClick" Margin="2,0,0,0"
                    ToolTip="Control de materiales en obra: saldo pendiente vs cubicación y alertas de sobrepedido." />
            <Button x:Name="NavCostosExecTab" Style="{StaticResource Button.NavHome}" Content="Control de costos"
                    Tag="{x:Static nav:ShellRoute.Costo}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
            <Button x:Name="NavEstadosPagosTab" Style="{StaticResource Button.NavHome}" Content="Estados de pago"
                    Tag="{x:Static nav:ShellRoute.EstadosPagos}" Click="OnBudgetTabClick" Margin="2,0,0,0" />
          </StackPanel>

          <!-- Herramientas auxiliares universales -->
          <shell:NavDropdownGroup x:Name="NavMoreGroup" GroupTitle="Más" SectionLabel="Herramientas auxiliares" Margin="3,0,0,0" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Barra de stepper de flujo de trabajo retirada a petición del usuario -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="0,0,0,1"
            Padding="{StaticResource Padding.WorkflowStepper}"
            Visibility="Collapsed">
      <!-- shell:ShellWorkflowStepper ShowWorkflowStepper retirado -->
    </Border>

    <Border Grid.Row="2"
            Background="{DynamicResource Brush.AmberSoft}"
            BorderBrush="{DynamicResource Brush.Amber2}"
            BorderThickness="0,0,0,1"
            MaxHeight="40"
            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
      <Grid Margin="{StaticResource Padding.ReadOnlyBanner}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Solo lectura" Style="{StaticResource Text.SectionLabel}" Foreground="{DynamicResource Brush.Amber}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ReadOnlyBannerText, Mode=OneWay}" Style="{StaticResource Text.Helper}" Foreground="{DynamicResource Brush.Amber}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource Padding.Page}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLandingScreen}" Value="True">
                <Setter Property="Padding" Value="0" />
              </DataTrigger>
              <DataTrigger Binding="{Binding UseCompactPagePadding}" Value="True">
                <Setter Property="Padding" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ContentControl x:Name="PageContent" Content="{Binding CurrentView, Mode=OneWay, NotifyOnTargetUpdated=True}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Style.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                  <BeginStoryboard Storyboard="{StaticResource Anim.FadeIn}" />
                </EventTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </Border>

      <!-- Overlay de carga: cubre el contenido mientras IsBusy=true para evitar
           el flash de layout incompleto al abrir/cerrar proyectos. -->
      <Border x:Name="BusyOverlay"
              Background="{DynamicResource Brush.Canvas}"
              Panel.ZIndex="10"
              IsHitTestVisible="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="12"
                  Background="{DynamicResource Brush.BlueFaint}"
                  HorizontalAlignment="Center" Margin="0,0,0,14">
            <Path Data="{StaticResource Geo.Spinner}" Style="{StaticResource Icon.Vector.Xl}"
                  Stroke="{DynamicResource Brush.Blue}"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform x:Name="BusySpinnerTransform" Angle="0" />
              </Path.RenderTransform>
              <Path.Triggers>
                <EventTrigger RoutedEvent="Path.Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Path.Triggers>
            </Path>
          </Border>
          <TextBlock Text="{Binding BusyMessage, FallbackValue='Procesando…'}"
                     FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Ink2}"
                     HorizontalAlignment="Center" Margin="0,0,0,4" />
          <TextBlock Text="Por favor espere un momento"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.Muted}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Shell.StatusBar}"
            Visibility="{Binding IsLandingScreen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <DockPanel LastChildFill="True">
        <!-- SECCIÓN DERECHA: Métricas vivas y Estado del Sistema -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

          <!-- 1. Estructura del Proyecto (Partidas, Capítulos, Tableros) -->
          <Border Style="{StaticResource Shell.StatusBarItem}"
                  ToolTip="{Binding ProjectStructureToolTip, Mode=OneWay}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="{StaticResource Geo.FileText}" Style="{StaticResource Icon.Vector.Sm}"
                    Stroke="{DynamicResource Brush.Ink3}" Margin="0,0,5,0" />
              <TextBlock Style="{StaticResource Shell.StatusBarText}"
                         Text="{Binding ProjectStructureSummary, Mode=OneWay}"
                         Foreground="{DynamicResource Brush.Ink2}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Shell.StatusBarDivider}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}" />

          <!-- 2. Costo Directo Total en Vivo -->
          <Border Style="{StaticResource Shell.StatusBarItem}"
                  ToolTip="{Binding DirectCostToolTip, Mode=OneWay}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                <TextBlock Text="CD" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                           Foreground="{DynamicResource Brush.Blue}" />
              </Border>
              <TextBlock Style="{StaticResource Shell.StatusBarText}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}"
                         FontFamily="{StaticResource Font.Mono}"
                         Text="{Binding TickerCostoDirecto, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Shell.StatusBarDivider}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}" />

          <!-- 3. Modo Colaborativo (Editor Exclusivo / Solo Lectura) -->
          <Border Style="{StaticResource Shell.StatusBarItem}"
                  ToolTip="{Binding ReadOnlyBannerText, Mode=OneWay}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Punto de estado dinámico -->
              <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock FontWeight="SemiBold"
                         Text="{Binding CollaborationModeLabel, Mode=OneWay}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Shell.StatusBarText}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.BlueDark}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Shell.StatusBarDivider}" />

          <!-- 4. Banco de Precios -->
          <Border Style="{StaticResource Shell.StatusBarItem}"
                  ToolTip="{Binding PriceBankToolTip, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="{StaticResource Geo.FolderOpen}" Style="{StaticResource Icon.Vector.Sm}"
                    Stroke="{DynamicResource Brush.Muted}" Margin="0,0,5,0" />
              <TextBlock Style="{StaticResource Shell.StatusBarText}"
                         Text="{Binding PriceBankSyncLabel, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Shell.StatusBarDivider}" />

          <!-- 5. Usuario y Rol Activo -->
          <Border Style="{StaticResource Shell.StatusBarItem}"
                  ToolTip="{Binding UserEmail, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                         Foreground="{DynamicResource Brush.Muted}" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Style="{StaticResource Shell.StatusBarText}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource Brush.Ink2}"
                         Text="{Binding UserStatusLabel, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <!-- 6. Estado de Guardado / Sincronización -->
          <Border Style="{StaticResource Shell.StatusBarDivider}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}" />

          <Border Style="{StaticResource Shell.StatusBarItem}"
                  ToolTip="{Binding SaveStateToolTip, Mode=OneWay}"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource Brush.AmberRisk}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock FontSize="11" FontWeight="SemiBold"
                         Text="{Binding SaveStateText, Mode=OneWay}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Shell.StatusBarText}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- SECCIÓN IZQUIERDA: Estado contextual / Atajos de teclado del módulo -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource Brush.BlueSoft}"
                  VerticalAlignment="Center" Margin="0,0,6,0">
            <Path Data="{StaticResource Geo.Info}" Style="{StaticResource Icon.Vector.Sm}"
                  Stroke="{DynamicResource Brush.Blue}" Width="9" Height="9" />
          </Border>
          <TextBlock Style="{StaticResource Shell.StatusBarText}"
                     Text="{Binding StatusBarHint, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    </Grid>

    <!-- Barra superior y controles de ventana en Landing Screen -->
    <Border VerticalAlignment="Top" Height="42" Background="Transparent"
            MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
            Visibility="{Binding IsLandingScreen, Converter={StaticResource BoolToVisibility}}"
            Panel.ZIndex="500">
      <DockPanel LastChildFill="False" Margin="0,4,14,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="LandingMinimizeBtn" Width="34" Height="34"
                  Background="Transparent" BorderThickness="0"
                  Click="OnMinimizeClick" ToolTip="Minimizar"
                  Cursor="Hand">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
          </Button>
          <Button x:Name="LandingMaxRestoreBtn" Width="34" Height="34"
                  Background="Transparent" BorderThickness="0"
                  Click="OnMaxRestoreClick" ToolTip="Maximizar"
                  Cursor="Hand">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <TextBlock x:Name="LandingMaxRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
          </Button>
          <Button x:Name="LandingCloseBtn" Width="34" Height="34"
                  Background="Transparent" BorderThickness="0"
                  Click="OnCloseClick" ToolTip="Cerrar"
                  Cursor="Hand">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Ink3}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <ctrl:ToastHost Panel.ZIndex="1000" VerticalAlignment="Bottom" HorizontalAlignment="Right" />

    <!-- HUD flotante de Undo/Redo (Pill no invasivo con reversión en 1 clic) -->
    <ctrl:UndoRedoHudHost Panel.ZIndex="2500" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32" />

    <!-- Overlay visual de Drag and Drop -->
    <Border x:Name="DragDropOverlay" Panel.ZIndex="3000"
            Background="#D90B132B"
            Visibility="Collapsed"
            IsHitTestVisible="False">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Blue}"
              BorderThickness="2"
              CornerRadius="16" Padding="48,36" MaxWidth="540">
        <StackPanel HorizontalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="14"
                  Background="{DynamicResource Brush.BlueFaint}"
                  HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Soltar archivo aquí"
                     FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Ink}"
                     HorizontalAlignment="Center" Margin="0,0,0,6" />
          <TextBlock Text="Suelte un archivo .qce para abrir el presupuesto, o una planilla .xlsx para importar datos."
                     FontSize="13" Foreground="{DynamicResource Brush.Muted}"
                     TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
