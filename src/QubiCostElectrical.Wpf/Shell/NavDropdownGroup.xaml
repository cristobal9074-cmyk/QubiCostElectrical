<UserControl x:Class="QubiCostElectrical.Wpf.Shell.NavDropdownGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <ToggleButton x:Name="Trigger"
                  Style="{StaticResource Menu.NavGroupTrigger}"
                  Content="{Binding GroupTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Click="OnTriggerClick" />
    <Popup x:Name="Popup"
           PlacementTarget="{Binding ElementName=Trigger}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">
      <Border Style="{StaticResource Menu.DropdownPanel}">
        <StackPanel>
          <TextBlock Style="{StaticResource Menu.DropdownLabel}" Text="{Binding SectionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <ItemsControl x:Name="ItemsHost">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <!-- Separador visual: línea horizontal cuando IsSeparator = true -->
                  <Rectangle Height="1" Margin="8,4" Fill="{DynamicResource Brush.Line}"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Rectangle.Style>
                      <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Rectangle.Style>
                  </Rectangle>
                  <!-- Ítem de navegación normal -->
                  <Button Tag="{Binding Route}"
                          Click="OnItemClick">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Menu.DropdownItem}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding Badge, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                      </Border>
                      <TextBlock Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink7}" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
