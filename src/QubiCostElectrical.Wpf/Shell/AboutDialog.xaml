<Window x:Class="QubiCostElectrical.Wpf.Shell.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:QubiCostElectrical.Wpf.Shell"
        Title="Acerca de Qubi Cost Electrical"
        Width="680" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource Dialog.Window}">
  <Border Style="{StaticResource Dialog.Chrome}" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <!-- 0: Hero Header Corporativo -->
        <RowDefinition Height="Auto" />
        <!-- 1: Barra de Pestañas Segmentada -->
        <RowDefinition Height="Auto" />
        <!-- 2: Contenido Principal según Pestaña -->
        <RowDefinition Height="*" />
        <!-- 3: Barra de Cierre / Footer -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── 0. HERO HEADER CORPORATIVO ── -->
      <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
              Padding="24,18">
        <DockPanel LastChildFill="True">
          <!-- Isotipo Hexagonal 3D con Rayo Central -->
          <Border DockPanel.Dock="Left" Width="60" Height="60" Background="Transparent" Margin="0,0,18,0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/brand_logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>

          <!-- Títulos y Versión -->
          <StackPanel VerticalAlignment="Center">
            <DockPanel LastChildFill="False" Margin="0,0,0,2">
              <TextBlock Text="{Binding ProductName}"
                         FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
              <!-- Badge de Versión Actual -->
              <Border Background="{DynamicResource Brush.BlueSoft}"
                      BorderBrush="{DynamicResource Brush.Blue3}"
                      BorderThickness="1" CornerRadius="8"
                      Padding="8,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionLabel}"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
            </DockPanel>

            <TextBlock Text="{Binding ProductSubtitle}"
                       FontSize="12" Foreground="{DynamicResource Brush.Ink3}"
                       Margin="0,0,0,3" />

            <TextBlock Text="{Binding CopyrightText}"
                       FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ── 1. BARRA DE PESTAÑAS SEGMENTADA (ESTILO CHIPS SAAS) ── -->
      <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
              Padding="24,10">
        <StackPanel Orientation="Horizontal">
          <!-- Pestaña 0: General y Licencia -->
          <Button Click="OnTabGeneralClick" Margin="0,0,8,0">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📋  General y Licencia" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Pestaña 1: Novedades (Changelog) -->
          <Button Click="OnTabChangelogClick" Margin="0,0,8,0">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🚀  Novedades (Changelog)" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Pestaña 2: Créditos y Legal -->
          <Button Click="OnTabLegalClick">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueDark}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚖️  Créditos y Legal" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- ── 2. CONTENIDO SEGÚN PESTAÑA SELECCIONADA ── -->
      <Grid Grid.Row="2" Margin="24,16">

        <!-- ═══ VISTA 0: GENERAL Y LICENCIA ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <StackPanel>
            <!-- Tarjeta de Licencia de Software -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                  <Border DockPanel.Dock="Right"
                          Background="{Binding LicenseStatusBadgeBackground}"
                          BorderThickness="0" CornerRadius="6" Padding="10,3">
                    <TextBlock Text="{Binding LicenseStatusBadge}"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{Binding LicenseStatusBadgeForeground}" />
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LICENCIA DE USO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                    <TextBlock Text="{Binding LicenseeCompany}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,0,0,12" />

                <!-- Grilla de datos de licencia -->
                <UniformGrid Columns="2" Margin="0,0,0,12">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Identificador / RUT" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
                    <TextBlock Text="{Binding LicenseeRut}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink2}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Vigencia / Vencimiento" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
                    <TextBlock Text="{Binding LicenseExpirationText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink2}" Margin="0,2,0,0" />
                  </StackPanel>
                </UniformGrid>

                <!-- Botón de Cargar Licencia -->
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Right"
                          Style="{StaticResource Button.Secondary}"
                          Command="{Binding ActivateLicenseFileCommand}"
                          Content="Cargar licencia (.qclic)..."
                          Height="28" Padding="12,0" FontSize="10.5"
                          ToolTip="Activar o renovar la licencia mediante un archivo de firma digital .qclic" />

                  <!-- Mensaje reactivo de activación -->
                  <TextBlock Text="{Binding LicenseMessage}"
                             FontSize="11" FontWeight="SemiBold"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLicenseMessageError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Tarjeta de Especificaciones Técnicas y Arquitectura -->
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
              <StackPanel>
                <TextBlock Text="ESPECIFICACIONES TÉCNICAS Y ARQUITECTURA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- Formato de Proyecto -->
                  <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Brush.Surface2}" CornerRadius="8" Padding="12,8" Margin="0,0,6,8">
                    <StackPanel>
                      <TextBlock Text="Formato de Proyecto" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Text="{Binding ProjectFormatLabel, StringFormat='Base de datos {0} (SQLite)'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Motor de Costos -->
                  <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Brush.Surface2}" CornerRadius="8" Padding="12,8" Margin="6,0,0,8">
                    <StackPanel>
                      <TextBlock Text="Motor de Costos &amp; APU" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Text="{Binding CalculationEngineLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Esquema BD -->
                  <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Brush.Surface2}" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                    <StackPanel>
                      <TextBlock Text="Esquema Transaccional" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Text="{Binding DatabaseSchemaLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Runtime -->
                  <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Surface2}" CornerRadius="8" Padding="12,8" Margin="6,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Plataforma de Ejecución" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Text="{Binding RuntimeLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ═══ VISTA 1: NOVEDADES Y CHANGELOG ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <ItemsControl ItemsSource="{Binding Changelog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="16,14" Margin="0,0,0,12">
                  <StackPanel>
                    <!-- Encabezado de Versión -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                      <Border DockPanel.Dock="Right" Padding="8,2" CornerRadius="6" VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue3}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Date}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,6,0" />
                          <TextBlock Text="ACTUAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}"
                                     Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </Border>

                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Tagline}" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>

                    <Separator Style="{StaticResource Separator.Subtle}" Margin="0,4,0,8" />

                    <!-- Bullets de Mejoras -->
                    <ItemsControl ItemsSource="{Binding Highlights}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,3">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,1,8,0" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" TextWrapping="Wrap" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- ═══ VISTA 2: CRÉDITOS Y LEGAL ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <StackPanel>
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="COMPONENTES DE TERCEROS Y LICENCIAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,10" />

                <!-- SQLite -->
                <DockPanel Margin="0,4">
                  <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="Public Domain" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="SQLite" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Motor relacional SQL embebido, transaccional y libre de configuración." FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" />
                  </StackPanel>
                </DockPanel>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,8" />

                <!-- QuestPDF -->
                <DockPanel Margin="0,4">
                  <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="Community License" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="QuestPDF" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Motor de composición tipográfica fluida para generación de cartas de oferta y reportes ejecutivos." FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" />
                  </StackPanel>
                </DockPanel>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,8" />

                <!-- ClosedXML -->
                <DockPanel Margin="0,4">
                  <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="MIT License" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="ClosedXML / OpenXml" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Lectura e importación de planillas de itemizado y exportación de listas de compra en Microsoft Excel." FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" />
                  </StackPanel>
                </DockPanel>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,8" />

                <!-- CommunityToolkit.Mvvm -->
                <DockPanel Margin="0,4">
                  <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="MIT License" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="Microsoft Community Toolkit MVVM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Arquitectura desacoplada, observables y enlace reactivo de datos en WPF." FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Declaración de Propiedad Intelectual -->
            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="10" Padding="14,10">
              <TextBlock Text="Qubi Cost Electrical es una marca registrada de Qubi Cost SpA. Diseñado para empresas y profesionales del sector de instalaciones, proyectos y montaje eléctrico."
                         FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ── 3. BARRA DE CIERRE / FOOTER BAR ── -->
      <Border Grid.Row="3" Background="{DynamicResource Brush.Surface2}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
              Padding="24,12">
        <DockPanel LastChildFill="False">
          <TextBlock Text="Qubi Cost Electrical — Ingeniería de Presupuestos"
                     FontSize="11" Foreground="{DynamicResource Brush.Ink4}"
                     VerticalAlignment="Center" />

          <Button DockPanel.Dock="Right"
                  Style="{StaticResource Button.Secondary}"
                  Content="Cerrar"
                  IsCancel="True"
                  Width="84" Height="30"
                  FontSize="11"
                  Click="OnCloseClick" />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
