<UserControl x:Class="QubiCostElectrical.Wpf.Shell.ShellWorkflowStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:QubiCostElectrical.Wpf.Shell">
  <ItemsControl ItemsSource="{Binding WorkflowSteps}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type shell:ShellWorkflowStepVm}">
        <Button Command="{Binding NavigateCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="0,0,4,0"
                Cursor="Hand"
                Focusable="False">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Padding="8,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                      <StackPanel Orientation="Horizontal">
                        <Border x:Name="Badge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                          <TextBlock x:Name="BadgeText"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="9"
                                     FontWeight="Bold" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Ink2}" />
                          <TextBlock Text="{Binding Detail}"
                                     FontSize="9"
                                     Foreground="{DynamicResource Brush.Muted}"
                                     Margin="0,1,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Blue}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="✓" />
                        <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsComplete}" Value="False" />
                          <Condition Binding="{Binding IsActive}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        <Setter TargetName="Badge" Property="BorderThickness" Value="2" />
                        <Setter TargetName="BadgeText" Property="Text" Value="▶" />
                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsComplete}" Value="False" />
                          <Condition Binding="{Binding IsActive}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        <Setter TargetName="BadgeText" Property="Text" Value="{Binding StepNumber}" />
                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                      </MultiDataTrigger>
                      <DataTrigger Binding="{Binding IsAuxiliary}" Value="True">
                        <Setter TargetName="Badge" Property="Width" Value="18" />
                        <Setter TargetName="Badge" Property="Height" Value="18" />
                        <Setter TargetName="Badge" Property="CornerRadius" Value="4" />
                        <Setter TargetName="Root" Property="Padding" Value="6,6" />
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsAuxiliary}" Value="True" />
                          <Condition Binding="{Binding IsComplete}" Value="False" />
                          <Condition Binding="{Binding IsActive}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="BadgeText" Property="Text" Value="SC" />
                        <Setter TargetName="BadgeText" Property="FontSize" Value="7" />
                      </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Button.Style>
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
