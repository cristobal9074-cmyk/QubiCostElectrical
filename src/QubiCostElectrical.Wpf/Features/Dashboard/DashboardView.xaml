<UserControl x:Class="QubiCostElectrical.Wpf.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Dashboard"
             mc:Ignorable="d"
              d:DesignWidth="1280"
              d:DesignHeight="720"
              FontFamily="{StaticResource Font.Ui}">
  <UserControl.Resources>
    <Style x:Key="Dashboard.CompactCard" TargetType="Border" BasedOn="{StaticResource Card.Section}">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="Dashboard.CompactMetric" TargetType="Border" BasedOn="{StaticResource Card.Kpi}">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <local:ReadinessToStrokeDashArrayConverter x:Key="ReadinessDashConverter" />
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="16,12,16,12" MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="360" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. CABECERA EJECUTIVA COMPACTA -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,10">
          <DockPanel LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
              <Button Content="Ver proyecto" Command="{Binding GoToProjectCommand}" Style="{StaticResource Button.Secondary}" Height="28" Padding="12,0" FontSize="11" Margin="0,0,6,0" />
              <Button Content="{Binding PrimaryCtaLabel, StringFormat={}{0} →}" Command="{Binding PrimaryCtaCommand}" Style="{StaticResource Button.Primary}" Height="28" Padding="14,0" FontSize="11" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="{Binding GreetingText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Brush.GreenSoft}" BorderBrush="{DynamicResource Brush.Green}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Proyecto Activo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding SubtitleText}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 2. FRANJA HORIZONTAL ÚNICA DE KPIS CLAVE -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding KpiCards}" Margin="0,0,0,10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Dashboard.CompactMetric}">
                <Grid>
                  <Border Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{Binding AccentBrush}" CornerRadius="0,6,6,0" Margin="0,-9,-12,-9" />
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Bold" Foreground="{Binding AccentBrush}" Margin="0,3,0,2" />
                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource Brush.Ink3}" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3. CUERPO PRINCIPAL EN 3 COLUMNAS PROPORCIONALES (LLENA EL ESPACIO VERTICAL) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.2*" />
            <ColumnDefinition Width="4.8*" />
            <ColumnDefinition Width="3.5*" />
          </Grid.ColumnDefinitions>

          <!-- COLUMNA 1: COMPOSICIÓN DE COSTOS & SIMULADOR -->
          <Border Grid.Column="0" Style="{StaticResource Dashboard.CompactCard}" Margin="0,0,5,0">
            <DockPanel LastChildFill="True">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CostDirect}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                <TextBlock Text="Composición de Costos" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
              </DockPanel>

              <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right" Text="Margen directo" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
                    <TextBlock Text="Simulador de cierre" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                  </DockPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gastos Generales (GG)" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GastosGeneralesSimulatedPct, StringFormat={}{0:F1}%}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Brush.Blue}" />
                    <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="2" Value="{Binding GastosGeneralesSimulatedPct}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,0" Height="16" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Margen de Utilidad" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UtilidadSimulatedPct, StringFormat={}{0:F1}%}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Brush.Blue}" />
                    <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="25" SmallChange="0.5" LargeChange="2" Value="{Binding UtilidadSimulatedPct}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,0" Height="16" />
                  </Grid>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding CostShares}" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Grid.Column="1" Style="{StaticResource Form.ProgressBar}" Value="{Binding PercentageValue, Mode=OneWay}" Maximum="100" Foreground="{Binding AccentBrush}" Height="6" Margin="6,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding PercentageLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <!-- COLUMNA 2: TOP PARTIDAS CRÍTICAS (PARETO) -->
          <Border Grid.Column="1" Style="{StaticResource Dashboard.CompactCard}" Margin="5,0,5,0">
            <DockPanel LastChildFill="True">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Ver itemizado →" Command="{Binding GoToItemizadoCommand}" FontSize="11" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Partidas Críticas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                  <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                    <TextBlock Text="Pareto" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                  </Border>
                </StackPanel>
              </DockPanel>

              <TextBlock DockPanel.Dock="Bottom" Text="💡 Estas partidas concentran la mayor incidencia en el presupuesto." FontSize="10" Foreground="{DynamicResource Brush.Ink3}" Margin="0,6,0,0" />

              <DataGrid ItemsSource="{Binding FilteredTopPartidas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        Style="{StaticResource DataGrid.Workspace}" CanUserAddRows="False" SelectionMode="Single" VerticalAlignment="Stretch">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Ítem" Binding="{Binding Item}" Width="45" />
                  <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="*" />
                  <DataGridTextColumn Header="Costo CLP" Binding="{Binding TotalClpLabel}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Costo UF" Binding="{Binding TotalUfLabel}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="%" Binding="{Binding PercentLabel}" Width="45">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <!-- COLUMNA 3: ESTADO DE ENTREGA & CHECKLIST -->
          <Border Grid.Column="2" Style="{StaticResource Dashboard.CompactCard}" Margin="5,0,0,0">
            <DockPanel LastChildFill="True">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PartidasReadyLabel}" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Estado de Entrega" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                  <Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.AmberRisk}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                    <TextBlock Text="Cierre" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.AmberRisk}" />
                  </Border>
                </StackPanel>
              </DockPanel>

              <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Secondary}" Content="Ir a revisión de cierre (F8) →" Command="{Binding GoToReviewCommand}" Height="28" FontSize="11" HorizontalAlignment="Stretch" Margin="0,8,0,0" />

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                <StackPanel>
                  <!-- Items de Preparación de Oferta -->
                  <ItemsControl ItemsSource="{Binding OfferReadinessItems}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,3" Padding="8,4" CornerRadius="6" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="14" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Alertas Prioritarias si existen -->
                  <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,3" Padding="8,4" CornerRadius="6" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="14" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.AmberRisk}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" Style="{StaticResource Badge.Warn}" Padding="3,1">
                              <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource Text.Badge}" FontSize="8.5" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- 4. FOOTER DISCRETO FIJADO AL FONDO -->
        <Border Grid.Row="3" Style="{StaticResource Card.Surface}" Padding="10,6">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="Atajos: Ctrl+K Buscar · F8 Revisión · Alt+O Oferta" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
            <TextBlock Text="Sincronización correcta · Base SQLite v21 · Auditoría activa" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
