<UserControl x:Class="QubiCostElectrical.Wpf.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Dashboard"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             FontFamily="{StaticResource Font.Ui}">

  <Grid Background="{DynamicResource Brush.Canvas}">
    <!-- EMPTY: sin proyecto abierto -->
    <ScrollViewer infra:SmoothScroll.Enable="True"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
      <Grid Margin="24,20" MinHeight="520">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" MinWidth="320" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="1.4*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="8" Padding="28,26"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Resumen del proyecto" Style="{StaticResource Text.ViewTitle}" Margin="0,0,0,6" />
            <TextBlock Text="Abra un presupuesto para ver el precio, el margen y las partidas que mueven el costo."
                       Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto"
                      Command="{Binding OpenProjectCommand}" MinWidth="140" Margin="0,0,8,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Nuevo proyecto"
                      Command="{Binding NewProjectCommand}" MinWidth="140" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="8" Padding="18,16">
          <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Recientes" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="11"
                         Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Sin proyectos recientes en este equipo."
                       Foreground="{DynamicResource Brush.Muted}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

            <ItemsControl ItemsSource="{Binding RecentProjects}"
                          Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                          Background="{DynamicResource Brush.Canvas}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Cursor="Hand">
                    <Border.InputBindings>
                      <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                    </Border.InputBindings>
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,10,0" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DisplayDate}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusCaption}" FontSize="10.5"
                                   Foreground="{Binding StatusForeground}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- PROYECTO ABIERTO -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <ScrollViewer infra:SmoothScroll.Enable="True"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,28">

          <!-- Cabecera del resumen -->
          <DockPanel Margin="2,0,2,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Style="{StaticResource Button.Secondary}" Content="Recalcular" Padding="12,6" Margin="0,0,8,0"
                      Command="{Binding RecalculateDashboardCommand}" />
              <Button Style="{StaticResource Button.Primary}" Content="Oferta y cierre" Padding="14,6"
                      Command="{Binding GoToOfferDocumentsCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ProjectTitle}" FontSize="19" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,2,0,0" FontSize="12.5" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding ProjectClient, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding ProjectLocationLabel, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding ProjectStatusLabel, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding ProjectCurrencyDisplay, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>

          <!-- Cifras clave y veredicto -->
          <local:DashboardKeyFiguresSection />

          <!-- Cascada de precio y composición -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.42*" MinWidth="0" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="0.95*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <local:DashboardPriceWaterfallSection Grid.Column="0" />
            <local:DashboardCompositionSection Grid.Column="2" />
          </Grid>

          <!-- Pareto y sensibilidad -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.42*" MinWidth="0" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="0.95*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <local:DashboardParetoSection Grid.Column="0" />
            <local:DashboardSensitivitySection Grid.Column="2" />
          </Grid>

          <!-- Partidas críticas -->
          <local:DashboardCriticalItemsSection />

          <!-- Alertas, flujo y actividad -->
          <local:DashboardFooterCardsSection />

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
