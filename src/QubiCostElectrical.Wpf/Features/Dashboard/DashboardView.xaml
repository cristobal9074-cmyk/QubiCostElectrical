<UserControl x:Class="QubiCostElectrical.Wpf.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Dashboard"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             FontFamily="{StaticResource Font.Ui}">
  <UserControl.Resources>
    <Style x:Key="Dashboard.CompactCard" TargetType="Border" BasedOn="{StaticResource Card.Section}">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <local:ReadinessToStrokeDashArrayConverter x:Key="ReadinessRing" />
    <local:ParetoBarLeftConverter x:Key="ParetoBarLeft" />
    <local:ParetoBarHeightConverter x:Key="ParetoBarHeight" />
    <local:ParetoPointXConverter x:Key="ParetoPointX" />
    <local:ParetoPointYConverter x:Key="ParetoPointY" />
    <local:ParetoCumPointsConverter x:Key="ParetoCumPoints" />
    <local:ParetoAxisLabelConverter x:Key="ParetoAxisLabel" />
    <local:ParetoAccumLabelConverter x:Key="ParetoAccumLabel" />
    <local:ParetoAccumYConverter x:Key="ParetoAccumY" />
    <local:ParetoAccumXConverter x:Key="ParetoAccumX" />
    <local:SensitivityChartConverter x:Key="SensChart" />
    <local:SensitivityAxisLabelConverter x:Key="SensAxisLabel" />
    <local:SensitivityPointYConverter x:Key="SensPointY" />
    <local:SensitivityPointXConverter x:Key="SensPointX" />
    <local:SensitivityXLabelConverter x:Key="SensXLabel" />
    <local:SensitivityItemXConverter x:Key="SensItemX" />

    <!-- Card base del rediseño "Resumen ejecutivo" -->
    <Style x:Key="Dashboard.Card" TargetType="Border" BasedOn="{StaticResource Card.Section}">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Dashboard.CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style x:Key="Dashboard.CardSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- Pills de cabecera -->
    <Style x:Key="Dashboard.Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Chip de KPI (up / warn / danger / mute) -->
    <Style x:Key="Dashboard.Chip" TargetType="Border" BasedOn="{StaticResource Dashboard.Pill}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ChipKind}" Value="up">
          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ChipKind}" Value="warn">
          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ChipKind}" Value="danger">
          <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DangerDark}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Fila de KPI -->
    <Style x:Key="Dashboard.KpiCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="ClipToBounds" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Muted}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Íconos de KPI por IconKind -->
    <Style x:Key="Dashboard.KpiIcon.Total" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="total">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.KpiIcon.Listas" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M4,12 L9.5,17.5 L20,7" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="listas">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.KpiIcon.M2" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M3,9 V3 H9 M15,3 H21 V9 M21,15 V21 H15 M9,21 H3 V15" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="m2">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.KpiIcon.Riesgo" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M12,2 L20,5 V11 C20,16.5 16.5,20.5 12,22 C7.5,20.5 4,16.5 4,11 V5 Z M12,8 V12.5 M12,16 V16.01" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="riesgo">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.KpiIcon.Margen" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M4,20 L20,4 M6.5,6.5 A2.5,2.5 0 1 1 6.49,6.5 M17.5,17.5 A2.5,2.5 0 1 1 17.49,17.5" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="margen">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.KpiIcon.Concentracion" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M3,21 V13 M8.5,21 V8 M14,21 V15.5 M19.5,21 V4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="concentracion">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Sparklines decorativos por IconKind -->
    <Style x:Key="Dashboard.Spark.Up" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M2,20 L12.3,17.5 L22.6,18.5 L32.9,14.5 L43.1,13.5 L53.4,10 L63.7,7.5 L74,4" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.Blue}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="total">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.Spark.Flat" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M2,17 L12.3,16.5 L22.6,16.8 L32.9,15.8 L43.1,15.6 L53.4,15 L63.7,14.4 L74,13.2" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.Blue}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="m2">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.Spark.Down" TargetType="Path">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Data" Value="M2,5.5 L12.3,7 L22.6,8.5 L32.9,8.2 L43.1,11.5 L53.4,13.5 L63.7,16.5 L74,19.5" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.DangerDark}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IconKind}" Value="riesgo">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- ítem de leyenda de composición -->
    <Style x:Key="Dashboard.CompItem" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- ítem checklist de readiness -->
    <Style x:Key="Dashboard.CheckItem" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,9" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ítem de alerta con severidad -->
    <Style x:Key="Dashboard.AlertItem" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="3,1,1,1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Bloqueante">
          <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Crítico">
          <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Mayor">
          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Info">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.AlertSev" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Bloqueante">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Crítico">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SeverityLabel}" Value="Mayor">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- ítem de actividad reciente -->
    <Style x:Key="Dashboard.FeedItem" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.FeedIcon" TargetType="Border">
      <Setter Property="Width" Value="31" />
      <Setter Property="Height" Value="31" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Blue}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ActionCategory}" Value="Guardado">
          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ActionCategory}" Value="Ajuste">
          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Badge de readiness -->
    <Style x:Key="Dashboard.ReadinessBadge" TargetType="Border" BasedOn="{StaticResource Dashboard.Pill}">
      <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
      <Setter Property="Margin" Value="0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOfferReady}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Etapa del flujo de cierre -->
    <Style x:Key="Dashboard.StepDot" TargetType="Border">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsComplete}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.GreenSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Surface}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Dashboard.StepTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsComplete}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Canvas}">
    <!-- EMPTY: sin proyecto abierto -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
      <Grid Margin="24,20" MinHeight="520">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" MinWidth="320" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="1.4*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}" Padding="28,26"
                VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Resumen ejecutivo" Style="{StaticResource Text.ViewTitle}" Margin="0,0,0,6" />
            <TextBlock Text="Abra un presupuesto .qce para ver venta, margen, partidas críticas y readiness de oferta en un solo cockpit."
                       Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto"
                      Command="{Binding OpenProjectCommand}" MinWidth="140" Margin="0,0,8,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Nuevo proyecto"
                      Command="{Binding NewProjectCommand}" MinWidth="140" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}" Padding="18,16">
          <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="Recientes" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="11"
                         Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Sin proyectos recientes en este equipo."
                       Foreground="{DynamicResource Brush.Muted}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

            <ItemsControl ItemsSource="{Binding RecentProjects}"
                          Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                          Background="{DynamicResource Brush.Canvas}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Cursor="Hand">
                    <Border.InputBindings>
                      <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                    </Border.InputBindings>
                    <DockPanel LastChildFill="True">
                      <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,10,0" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DisplayDate}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusCaption}" FontSize="10.5"
                                   Foreground="{Binding StatusForeground}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <!-- COCKPIT: rediseño "Resumen ejecutivo" (mockup aprobado) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <StackPanel Margin="20,14,20,16">

        <!-- 1. Cabecera de página -->
        <DockPanel Margin="0,0,0,16" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Style="{StaticResource Button.Secondary}" Content="Exportar" Padding="16,8"
                    Command="{Binding GoToOfferDocumentsCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource Button.Primary}" Content="{Binding PrimaryCtaLabel}"
                    Command="{Binding PrimaryCtaCommand}" Padding="18,8" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
              <Border Style="{StaticResource Dashboard.Pill}"
                      Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}"
                      TextElement.Foreground="{DynamicResource Brush.Blue}">
                <TextBlock Text="{Binding ClosingPolicyLabel}" FontSize="10.5" FontWeight="Bold" />
              </Border>
              <Border Style="{StaticResource Dashboard.Pill}"
                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                      TextElement.Foreground="{DynamicResource Brush.Ink3}">
                <TextBlock Text="{Binding VersionLabel}" FontSize="10.5" FontWeight="Bold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding ProjectTitle}" FontSize="23" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ProjectClient}" FontSize="12.5" Foreground="{DynamicResource Brush.Muted}"
                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>

        <!-- 2. Veredicto: una línea, derivada del contrato único de preparación -->
        <Border Margin="0,0,0,16" CornerRadius="10" Padding="16,13" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsVerdictOk}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsVerdictWarn}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsVerdictBad}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Border Style="{StaticResource Dashboard.Pill}" Margin="0,0,8,0"
                      Background="{DynamicResource Brush.RedSoft}" BorderBrush="{DynamicResource Brush.DangerDark}"
                      TextElement.Foreground="{DynamicResource Brush.DangerDark}"
                      Visibility="{Binding HasBlockingAlerts, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding BlockingAlertLabel}" FontSize="10.5" FontWeight="Bold" />
              </Border>
              <Button Style="{StaticResource Button.Secondary}" Content="{Binding VerdictActionLabel}"
                      Padding="12,6" Command="{Binding GoToReviewCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Ver desglose de costos"
                      Padding="12,6" Command="{Binding GoToProjectCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding VerdictTitle}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding VerdictReason}" FontSize="12" Margin="0,3,0,0"
                         Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- 3. Tira de KPIs: seis lecturas en dos filas de tres, sin UniformGrid fijo de cuatro -->
        <ItemsControl ItemsSource="{Binding KpiCards}" Margin="0,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Dashboard.KpiCard}">
                <StackPanel>
                  <Border Height="3" Background="{Binding AccentBrush}" />
                  <StackPanel Margin="18,14,18,15">
                    <DockPanel Margin="0,0,0,11" LastChildFill="False">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{Binding AccentSoftBrush}">
                          <Grid>
                            <Path Style="{StaticResource Dashboard.KpiIcon.Total}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Style="{StaticResource Dashboard.KpiIcon.Listas}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Style="{StaticResource Dashboard.KpiIcon.M2}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Style="{StaticResource Dashboard.KpiIcon.Riesgo}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Style="{StaticResource Dashboard.KpiIcon.Margen}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Path Style="{StaticResource Dashboard.KpiIcon.Concentracion}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="18" Height="18"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Grid>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" FontSize="10.5"
                              Padding="4,2" Margin="10,0,0,0" VerticalAlignment="Center"
                              ToolTip="Obtiene la UF vigente en Chile y la aplica al proyecto"
                              Visibility="{Binding ShowUfUpdateButton, Converter={StaticResource BoolToVisibility}}"
                              IsEnabled="{Binding DataContext.PuedeActualizarUf, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Command="{Binding DataContext.ActualizarUfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock Text="{Binding DataContext.UfUpdateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      </Button>
                    </DockPanel>
                    <TextBlock Text="{Binding Value}" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                    <Grid Margin="0,13,0,0" MinHeight="26" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Style="{StaticResource Dashboard.Chip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChipLabel}" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                      <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="118" Height="6" Margin="10,0,0,0">
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IconKind}" Value="listas">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding GaugeFillWidth}" />
                          <ColumnDefinition Width="{Binding GaugeRemainWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3" Background="{DynamicResource Brush.Blue}" />
                        <Border Grid.Column="1" CornerRadius="3" Background="{DynamicResource Brush.Line2}" />
                      </Grid>
                      <Path Grid.Column="1" Style="{StaticResource Dashboard.Spark.Up}" StrokeThickness="1.75"
                            Stretch="Fill" Width="76" Height="26" Margin="10,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      <Path Grid.Column="1" Style="{StaticResource Dashboard.Spark.Flat}" StrokeThickness="1.75"
                            Stretch="Fill" Width="76" Height="26" Margin="10,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      <Path Grid.Column="1" Style="{StaticResource Dashboard.Spark.Down}" StrokeThickness="1.75"
                            Stretch="Fill" Width="76" Height="26" Margin="10,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3. Cascada de precio: del costo directo a la venta neta, cada paso auditable -->
        <Border Style="{StaticResource Dashboard.Card}">
          <StackPanel>
            <DockPanel Margin="18,15,18,0">
              <Border DockPanel.Dock="Right" Style="{StaticResource Dashboard.Pill}"
                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                      TextElement.Foreground="{DynamicResource Brush.Ink3}">
                <TextBlock Text="{Binding ClosingPolicyLabel}" FontSize="10.5" FontWeight="Bold" />
              </Border>
              <StackPanel>
                <TextBlock Text="Cascada de precio" Style="{StaticResource Dashboard.CardTitle}" />
                <TextBlock Text="Del costo directo de ejecución a la venta neta, paso a paso"
                           Style="{StaticResource Dashboard.CardSub}" />
              </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Waterfall.Rows}" Margin="18,16,18,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="210" />
                      <ColumnDefinition Width="*" MinWidth="60" />
                      <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                               Foreground="{DynamicResource Brush.Ink2}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Grid Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                      <Border CornerRadius="5" Background="{DynamicResource Brush.Line2}" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding BarOffset}" />
                          <ColumnDefinition Width="{Binding BarLength}" />
                          <ColumnDefinition Width="{Binding BarRemainder}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" CornerRadius="5" Background="{Binding BarBrush}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Opacity" Value="1" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                  <Setter Property="Opacity" Value="0.42" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                      </Grid>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding SignedAmountLabel}" FontSize="12.5"
                               FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGrandTotal}" Value="True">
                              <Setter Property="FontWeight" Value="Bold" />
                              <Setter Property="FontSize" Value="13.5" />
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="18,12,18,0" />

            <DockPanel Margin="18,14,18,0">
              <TextBlock DockPanel.Dock="Right" Text="Composición del precio" FontSize="11"
                         Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              <TextBlock Text="Base de costo directo y reparto por naturaleza" FontSize="11.5"
                         FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}"
                         VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Margin="18,10,18,18">
              <Border CornerRadius="6" ClipToBounds="True" Height="13"
                      Background="{DynamicResource Brush.Line2}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding MaterialShareWidth}" />
                    <ColumnDefinition Width="{Binding LaborShareWidth}" />
                    <ColumnDefinition Width="{Binding GoShareWidth}" />
                    <ColumnDefinition Width="{Binding MarginShareWidth}" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource Brush.Blue}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="0,0,2,0" />
                  <Border Grid.Column="1" Background="{DynamicResource Brush.BlueDark}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="0,0,2,0" />
                  <Border Grid.Column="2" Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="0,0,2,0" />
                  <Border Grid.Column="3" Background="{DynamicResource Brush.Green}" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding CostShares}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Dashboard.CompItem}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9" CornerRadius="5"
                                Background="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Label}" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.Muted}" />
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding AmountLabel}" FontSize="13.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                                   FontFamily="{StaticResource Font.Mono}" Margin="0,1,0,0" />
                        <TextBlock Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Text="{Binding PercentageLabel}"
                                   FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                                   FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 4. Grid principal: detalle + lateral -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" MinWidth="300" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">

            <!-- Pareto -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Ver itemizado →"
                          Command="{Binding GoToItemizadoCommand}" FontSize="12.5" />
                  <StackPanel>
                    <TextBlock Text="Concentración de costo — Pareto" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="{Binding ParetoSummary.SummaryHint}" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>

                <TextBlock Text="Sin partidas valorizadas. Complete cubicación y precios."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                           Margin="24,18,24,22" HorizontalAlignment="Center"
                           Visibility="{Binding HasTopPartidas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

                <StackPanel Margin="10,8,10,18"
                            Visibility="{Binding HasTopPartidas, Converter={StaticResource BoolToVisibility}}">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Canvas Width="760" Height="300">
                      <!-- Ejes y gridlines -->
                      <TextBlock Canvas.Left="45" Canvas.Top="4" Text="Participación %" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Canvas.Left="625" Canvas.Top="4" Width="100" TextAlignment="Right"
                                 Text="Acumulado %" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                      <Line X1="45" Y1="50" X2="725" Y2="50" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="45" Y1="90" X2="725" Y2="90" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="45" Y1="130" X2="725" Y2="130" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="45" Y1="170" X2="725" Y2="170" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="45" Y1="210" X2="725" Y2="210" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="45" Y1="250" X2="725" Y2="250" Stroke="{DynamicResource Brush.Line}" StrokeThickness="1" />

                      <TextBlock Canvas.Left="0" Canvas.Top="43" Width="36" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding ParetoAxisMaxPct, Converter={StaticResource ParetoAxisLabel}, ConverterParameter=5}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="83" Width="36" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding ParetoAxisMaxPct, Converter={StaticResource ParetoAxisLabel}, ConverterParameter=4}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="123" Width="36" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding ParetoAxisMaxPct, Converter={StaticResource ParetoAxisLabel}, ConverterParameter=3}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="163" Width="36" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding ParetoAxisMaxPct, Converter={StaticResource ParetoAxisLabel}, ConverterParameter=2}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="203" Width="36" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding ParetoAxisMaxPct, Converter={StaticResource ParetoAxisLabel}, ConverterParameter=1}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="243" Width="36" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding ParetoAxisMaxPct, Converter={StaticResource ParetoAxisLabel}, ConverterParameter=0}" />

                      <TextBlock Canvas.Left="735" Canvas.Top="43" Text="100" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Canvas.Left="735" Canvas.Top="83" Text="80" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Canvas.Left="735" Canvas.Top="123" Text="60" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Canvas.Left="735" Canvas.Top="163" Text="40" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Canvas.Left="735" Canvas.Top="203" Text="20" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Canvas.Left="735" Canvas.Top="243" Text="0" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />

                      <!-- Barras por clase ABC -->
                      <ItemsControl ItemsSource="{Binding TopPartidas}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Rank, Converter={StaticResource ParetoBarLeft}}" />
                            <Setter Property="Canvas.Top" Value="50" />
                            <Setter Property="Width" Value="44" />
                            <Setter Property="Height" Value="200" />
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border CornerRadius="3" VerticalAlignment="Bottom">
                              <Border.Height>
                                <MultiBinding Converter="{StaticResource ParetoBarHeight}">
                                  <Binding Path="SharePct" />
                                  <Binding Path="DataContext.ParetoAxisMaxPct"
                                           RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                              </Border.Height>
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                                      <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                      <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ParetoClass}" Value="C">
                                      <Setter Property="Background" Value="{DynamicResource Brush.Muted}" />
                                      <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Etiquetas de ítem rotadas -->
                      <ItemsControl ItemsSource="{Binding TopPartidas}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Rank, Converter={StaticResource ParetoBarLeft}}" />
                            <Setter Property="Canvas.Top" Value="256" />
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Item}" Width="80" Margin="-18,0,0,0" FontSize="10"
                                       Foreground="{DynamicResource Brush.Muted}" TextAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                              <TextBlock.RenderTransform>
                                <RotateTransform Angle="-35" />
                              </TextBlock.RenderTransform>
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Curva acumulada -->
                      <Polyline Points="{Binding TopPartidas, Converter={StaticResource ParetoCumPoints}}"
                                Stroke="{DynamicResource Brush.Green}" StrokeThickness="2" />
                      <ItemsControl ItemsSource="{Binding TopPartidas}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding ., Converter={StaticResource ParetoPointX}}" />
                            <Setter Property="Canvas.Top" Value="{Binding ., Converter={StaticResource ParetoPointY}}" />
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Green}"
                                     RenderTransformOrigin="0.5,0.5">
                              <Ellipse.RenderTransform>
                                <TranslateTransform X="-3" Y="-3" />
                              </Ellipse.RenderTransform>
                            </Ellipse>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Rótulo flotante de acumulado -->
                      <TextBlock FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Green}"
                                 Canvas.Left="{Binding TopPartidas, Converter={StaticResource ParetoAccumX}}"
                                 Canvas.Top="{Binding ParetoSummary, Converter={StaticResource ParetoAccumY}}"
                                 Text="{Binding ParetoSummary, Converter={StaticResource ParetoAccumLabel}}" />

                      <!-- Leyenda -->
                      <StackPanel Orientation="Horizontal" Canvas.Left="45" Canvas.Top="284">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}">
                            <Run Text="Clase A · " /><Run Text="{Binding ParetoSummary.CountA}" /><Run Text=" · " />
                            <Run Text="{Binding ParetoSummary.PctA, StringFormat={}{0:N1}%}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Blue}" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}">
                            <Run Text="Clase B · " /><Run Text="{Binding ParetoSummary.CountB}" /><Run Text=" · " />
                            <Run Text="{Binding ParetoSummary.PctB, StringFormat={}{0:N1}%}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Muted}" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}">
                            <Run Text="Clase C · " /><Run Text="{Binding ParetoSummary.CountC}" /><Run Text=" · " />
                            <Run Text="{Binding ParetoSummary.PctC, StringFormat={}{0:N1}%}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Green}" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <TextBlock Text="Acumulado" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" />
                        </StackPanel>
                      </StackPanel>
                    </Canvas>
                  </Viewbox>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Partidas críticas -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                              Visibility="{Binding ParetoSummary.HasData, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="9" Padding="3">
                      <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="{x:Null}"
                                ToolTip="Mostrar todas las partidas críticas"
                                Style="{StaticResource Button.Ghost}" Padding="4,1" Margin="0,0,3,0">
                          <Border CornerRadius="6" Padding="9,3">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsParetoFilterAll}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="Todas" FontSize="11.5" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsParetoFilterAll}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </Button>
                        <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="A"
                                ToolTip="Filtrar partidas Tipo A (80% del valor total)"
                                Style="{StaticResource Button.Ghost}" Padding="4,1" Margin="0,0,3,0">
                          <Border CornerRadius="6" Padding="9,3">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsParetoFilterA}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ParetoSummary.BadgeA}" FontSize="11.5" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsParetoFilterA}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </Button>
                        <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="B"
                                ToolTip="Filtrar partidas Tipo B (siguiente 15% del valor total)"
                                Style="{StaticResource Button.Ghost}" Padding="4,1" Margin="0,0,3,0">
                          <Border CornerRadius="6" Padding="9,3">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsParetoFilterB}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ParetoSummary.BadgeB}" FontSize="11.5" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsParetoFilterB}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </Button>
                        <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="C"
                                ToolTip="Filtrar partidas Tipo C (último 5% del valor total)"
                                Style="{StaticResource Button.Ghost}" Padding="4,1">
                          <Border CornerRadius="6" Padding="9,3">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsParetoFilterC}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ParetoSummary.BadgeC}" FontSize="11.5" FontWeight="SemiBold">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsParetoFilterC}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </Button>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Partidas críticas" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="Ordenadas por participación en costo" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>

                <TextBlock Text="Sin partidas valorizadas. Complete cubicación y precios."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                           Margin="24,18,24,22" HorizontalAlignment="Center"
                           Visibility="{Binding HasTopPartidas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

                <StackPanel Margin="14,12,14,0"
                            Visibility="{Binding HasTopPartidas, Converter={StaticResource BoolToVisibility}}">
                  <DataGrid ItemsSource="{Binding FilteredTopPartidas}" AutoGenerateColumns="False" IsReadOnly="True"
                            HeadersVisibility="Column" Style="{StaticResource DataGrid.Workspace}"
                            CanUserAddRows="False" SelectionMode="Single" VerticalAlignment="Stretch"
                            MouseDoubleClick="OnTopPartidaDoubleClick">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Ítem" Binding="{Binding Item}" Width="52">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="MONTO" Binding="{Binding TotalLabel}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTemplateColumn Header="%" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding PercentLabel}" HorizontalAlignment="Right"
                                         FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}"
                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                              <Border Grid.Column="1" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Line2}"
                                      VerticalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding FillWidth}" />
                                    <ColumnDefinition Width="{Binding RemainderWidth}" />
                                  </Grid.ColumnDefinitions>
                                  <Border Grid.Column="0" CornerRadius="2">
                                    <Border.Style>
                                      <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding ParetoClass}" Value="A">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AmberRisk}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding ParetoClass}" Value="C">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Muted}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                  </Border>
                                </Grid>
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Clase" Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border HorizontalAlignment="Center" CornerRadius="3" Padding="6,2">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ParetoClass}" Value="A">
                                      <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding ParetoClass}" FontSize="10" FontWeight="Bold" TextAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding ParetoClass}" Value="A">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Acción" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Button Style="{StaticResource Button.Ghost}" ToolTip="Ir a la partida en Itemizado"
                                      Command="{Binding DataContext.GoToPartidaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Padding="4,1" Margin="0,0,3,0" Cursor="Hand">
                                <TextBlock Text="Ir →" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                              </Button>
                              <Button Style="{StaticResource Button.Ghost}" ToolTip="Abrir APU de esta partida"
                                      Command="{Binding DataContext.GoToApuPartidaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Padding="4,1" Cursor="Hand">
                                <TextBlock Text="📦" FontSize="10" />
                              </Button>
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock HorizontalAlignment="Center" Margin="0,12,0,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasTopPartidas}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    <Button Style="{StaticResource Button.Link}" Content="Ver todas las partidas →"
                            Command="{Binding GoToItemizadoCommand}" FontSize="12.5" />
                  </TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Sensibilidad -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <StackPanel>
                    <TextBlock Text="Sensibilidad de la oferta" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="Variación del costo de materiales vs total venta" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Margin="10,8,10,8">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Canvas Width="760" Height="280">
                      <!-- gridlines -->
                      <Line X1="60" Y1="20" X2="730" Y2="20" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="60" Y1="63" X2="730" Y2="63" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="60" Y1="106" X2="730" Y2="106" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="60" Y1="149" X2="730" Y2="149" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="60" Y1="192" X2="730" Y2="192" Stroke="{DynamicResource Brush.Line2}" StrokeThickness="1" />
                      <Line X1="60" Y1="235" X2="730" Y2="235" Stroke="{DynamicResource Brush.Line}" StrokeThickness="1" />

                      <!-- eje Y (UF) -->
                      <TextBlock Canvas.Left="0" Canvas.Top="13" Width="52" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding SensitivityCurve, Converter={StaticResource SensAxisLabel}, ConverterParameter=0}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="56" Width="52" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding SensitivityCurve, Converter={StaticResource SensAxisLabel}, ConverterParameter=1}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="99" Width="52" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding SensitivityCurve, Converter={StaticResource SensAxisLabel}, ConverterParameter=2}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="142" Width="52" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding SensitivityCurve, Converter={StaticResource SensAxisLabel}, ConverterParameter=3}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="185" Width="52" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding SensitivityCurve, Converter={StaticResource SensAxisLabel}, ConverterParameter=4}" />
                      <TextBlock Canvas.Left="0" Canvas.Top="228" Width="52" TextAlignment="Right" FontSize="10"
                                 Foreground="{DynamicResource Brush.Muted}"
                                 Text="{Binding SensitivityCurve, Converter={StaticResource SensAxisLabel}, ConverterParameter=5}" />

                      <!-- línea base (escenario 0%) -->
                      <Line X1="60" X2="730"
                            Y1="{Binding SensitivityCurve, Converter={StaticResource SensPointY}, ConverterParameter=0}"
                            Y2="{Binding SensitivityCurve, Converter={StaticResource SensPointY}, ConverterParameter=0}"
                            Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.5" StrokeDashArray="4 4" />
                      <TextBlock Canvas.Left="660" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                                 Text="Total venta base" Margin="0,-17,0,0"
                                 Canvas.Top="{Binding SensitivityCurve, Converter={StaticResource SensPointY}, ConverterParameter=0}" />

                      <!-- curva -->
                      <Path Data="{Binding SensitivityCurve, Converter={StaticResource SensChart}, ConverterParameter=area}"
                            Fill="{DynamicResource Brush.Blue}" Opacity="0.08" />
                      <Path Data="{Binding SensitivityCurve, Converter={StaticResource SensChart}, ConverterParameter=line}"
                            Stroke="{DynamicResource Brush.Blue}" StrokeThickness="2.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      <Path Data="{Binding SensitivityCurve, Converter={StaticResource SensChart}, ConverterParameter=markers}"
                            Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Blue}" StrokeThickness="2" />

                      <!-- anotación de impacto +10% -->
                      <Line X1="{Binding SensitivityCurve, Converter={StaticResource SensPointX}, ConverterParameter=10}"
                            Y1="{Binding SensitivityCurve, Converter={StaticResource SensPointY}, ConverterParameter=10}"
                            X2="530" Y2="54" Stroke="{DynamicResource Brush.DangerDark}" StrokeThickness="1.5" />
                      <Border Canvas.Left="524" Canvas.Top="24" Background="{DynamicResource Brush.RedSoft}"
                              BorderBrush="{DynamicResource Brush.DangerDark}" BorderThickness="1"
                              CornerRadius="6" Padding="9,5">
                        <TextBlock Text="{Binding MaterialImpact10PctLabel}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.DangerDark}" />
                      </Border>

                      <!-- eje X (variación de materiales) -->
                      <ItemsControl ItemsSource="{Binding SensitivityCurve}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top" Value="243" />
                            <Setter Property="Canvas.Left">
                              <Setter.Value>
                                <MultiBinding Converter="{StaticResource SensItemX}">
                                  <Binding Path="." />
                                  <Binding Path="DataContext.SensitivityCurve"
                                           RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Width="70" TextAlignment="Center" FontSize="10"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Text="{Binding Converter={StaticResource SensXLabel}}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- leyenda -->
                      <StackPanel Orientation="Horizontal" Canvas.Left="60" Canvas.Top="264">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <TextBlock Text="Total venta proyectada" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <TextBlock Text="Total venta base" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" />
                        </StackPanel>
                      </StackPanel>
                    </Canvas>
                  </Viewbox>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>

          <!-- Lateral -->
          <StackPanel Grid.Column="2">

            <!-- Listo para ofertar -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <Border DockPanel.Dock="Right" Style="{StaticResource Dashboard.ReadinessBadge}">
                    <TextBlock Text="{Binding ReadinessBadgeLabel}" FontSize="10.5" FontWeight="Bold" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="Listo para ofertar" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="Estado de preparación de la oferta" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Margin="18,14,18,16">
                  <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,4,0,16">
                    <Ellipse Width="120" Height="120" StrokeThickness="10" Fill="Transparent"
                             Stroke="{DynamicResource Brush.Line2}" />
                    <Ellipse Width="120" Height="120" StrokeThickness="10" Fill="Transparent"
                             StrokeDashArray="{Binding OfferReadinessRingPercent, Converter={StaticResource ReadinessRing}}"
                             StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Stroke" Value="{DynamicResource Brush.Green}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOfferReady}" Value="False">
                              <Setter Property="Stroke" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                      <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}"
                                 Text="{Binding OfferReadinessRingPercent, StringFormat={}{0:N0}%}" />
                      <TextBlock Text="{Binding PartidasReadyLabel}" FontSize="11"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding OfferReadinessItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Dashboard.CheckItem}" Cursor="Hand">
                          <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" />
                          </Border.InputBindings>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Background="{DynamicResource Brush.AmberSoft}">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                         FontSize="12" FontWeight="Bold" Text="!"
                                         Foreground="{DynamicResource Brush.Amber}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Text" Value="✔" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Flujo de cierre -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <StackPanel>
                    <TextBlock Text="Flujo de cierre" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="6 etapas hasta emitir la oferta" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding WorkflowSteps}" Margin="18,12,18,16">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Cursor="Hand">
                        <Grid.InputBindings>
                          <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                          <Border Style="{StaticResource Dashboard.StepDot}">
                            <Grid>
                              <TextBlock Text="{Binding Index}" FontSize="12" FontWeight="Bold"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="✔" FontSize="12" FontWeight="Bold"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Grid>
                          </Border>
                          <Border Width="2" HorizontalAlignment="Left" Margin="17,36,0,-4"
                                  Background="{DynamicResource Brush.Line2}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                          </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="0,4,0,12">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Dashboard.StepTitle}" />
                          <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}"
                                     Margin="0,1,0,0" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Alertas -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Style="{StaticResource Dashboard.Pill}"
                            Background="{DynamicResource Brush.RedSoft}" BorderBrush="{DynamicResource Brush.DangerDark}"
                            TextElement.Foreground="{DynamicResource Brush.DangerDark}"
                            Visibility="{Binding HasBlockingAlerts, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding BlockingAlertLabel}" FontSize="10.5" FontWeight="Bold" />
                    </Border>
                    <Border Style="{StaticResource Dashboard.Pill}"
                            Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.AmberRisk}"
                            TextElement.Foreground="{DynamicResource Brush.Amber}"
                            Visibility="{Binding HasMajorAlerts, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock FontSize="10.5" FontWeight="Bold">
                        <Run Text="{Binding MajorAlertCount, Mode=OneWay}" /><Run Text=" mayores" />
                      </TextBlock>
                    </Border>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Alertas" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="Puntos que frenan la emisión" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Margin="18,14,18,16">
                  <TextBlock Text="Ninguna abierta." FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                             Margin="0,0,0,8"
                             Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                  <ItemsControl ItemsSource="{Binding Alerts}"
                                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Dashboard.AlertItem}" ToolTip="{Binding Detail}">
                          <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" />
                          </Border.InputBindings>
                          <StackPanel>
                            <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource Dashboard.AlertSev}" />
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource Button.Link}" Content="Ver revisión completa →"
                          Command="{Binding GoToReviewCommand}" FontSize="12.5" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Actividad reciente -->
            <Border Style="{StaticResource Dashboard.Card}">
              <StackPanel>
                <DockPanel Margin="18,15,18,0">
                  <StackPanel>
                    <TextBlock Text="Actividad reciente" Style="{StaticResource Dashboard.CardTitle}" />
                    <TextBlock Text="Últimos cambios en el proyecto" Style="{StaticResource Dashboard.CardSub}" />
                  </StackPanel>
                </DockPanel>
                <StackPanel Margin="14,12,14,16">
                  <TextBlock Text="Sin actividad registrada." FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                             Margin="4,0,0,4"
                             Visibility="{Binding HasRecentAudit, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                  <ItemsControl ItemsSource="{Binding RecentAuditEntries}"
                                Visibility="{Binding HasRecentAudit, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Dashboard.FeedItem}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Dashboard.FeedIcon}" Margin="0,0,11,0">
                              <Grid>
                                <Path Data="M19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H16 L21,8 V19 A2,2 0 0 1 19,21 Z M17,21 V13 H7 V21 M7,3 V8 H12"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=(TextElement.Foreground)}"
                                      StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Action}" FontSize="12.5" FontWeight="Medium"
                                         Foreground="{DynamicResource Brush.Ink2}" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding OccurredAtLabel}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock Text="{Binding UserDisplayName}" FontSize="11"
                                           Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </Grid>

        <!-- 5. Barra de estado -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1" CornerRadius="9" Padding="15,9">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Border CornerRadius="5" Padding="3" Background="{DynamicResource Brush.GreenSoft}" Margin="0,0,8,0">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Green}" />
              </Border>
              <TextBlock Text="{Binding SyncFooterLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
