<UserControl x:Class="QubiCostElectrical.Wpf.Features.Dashboard.DashboardCriticalItemsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Dashboard"
             mc:Ignorable="d">
  <!-- Partidas críticas -->
  <Border Style="{StaticResource Dashboard.Card}">
    <StackPanel>
      <DockPanel Margin="16,13,16,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Secondary}" Content="Ordenar por impacto" Padding="11,5"
                  FontSize="11.5" Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Secondary}" Content="Excel" Padding="11,5" FontSize="11.5" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Partidas críticas" Style="{StaticResource Dashboard.CardTitle}" />
          <TextBlock Text="Ordenadas por impacto en el costo directo · la clase A se negocia primero"
                     Style="{StaticResource Dashboard.CardSub}" />
        </StackPanel>
      </DockPanel>

      <!-- Barra de herramientas -->
      <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="0,1,0,0" Padding="16,9">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding FilteredCockpitPartidasCountLabel}" FontSize="11.5"
                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <!-- Buscador -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="7" Padding="8,3" Width="230" Margin="0,0,10,0">
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="2"
                        Command="{Binding ClearTopPartidasSearchCommand}"
                        Visibility="{Binding HasTopPartidasSearchText, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </Button>
                <TextBox Text="{Binding TopPartidasSearchText, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                         FontSize="11.5" Foreground="{DynamicResource Brush.Ink}" />
              </DockPanel>
            </Border>

            <!-- Filtro por clase -->
            <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
              <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="{x:Null}"
                        ToolTip="Mostrar todas las partidas críticas"
                        Style="{StaticResource Button.Ghost}" Padding="4,1" Margin="0,0,2,0">
                  <Border CornerRadius="6" Padding="9,3">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsParetoFilterAll}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="Todas" FontSize="11.5" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParetoFilterAll}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Button>
                <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="A"
                        ToolTip="Clase A: partidas que concentran el 80% del costo"
                        Style="{StaticResource Button.Ghost}" Padding="4,1" Margin="0,0,2,0">
                  <Border CornerRadius="6" Padding="9,3">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsParetoFilterA}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ParetoSummary.BadgeA}" FontSize="11.5" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParetoFilterA}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Button>
                <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="B"
                        ToolTip="Clase B: siguiente tramo del costo"
                        Style="{StaticResource Button.Ghost}" Padding="4,1" Margin="0,0,2,0">
                  <Border CornerRadius="6" Padding="9,3">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsParetoFilterB}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ParetoSummary.BadgeB}" FontSize="11.5" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParetoFilterB}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Button>
                <Button Command="{Binding SetParetoFilterCommand}" CommandParameter="C"
                        ToolTip="Clase C: cola larga del costo"
                        Style="{StaticResource Button.Ghost}" Padding="4,1">
                  <Border CornerRadius="6" Padding="9,3">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsParetoFilterC}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ParetoSummary.BadgeC}" FontSize="11.5" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParetoFilterC}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="Sin partidas valorizadas. Complete cubicación y precios."
                 FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                 Margin="24,18,24,22" HorizontalAlignment="Center"
                 Visibility="{Binding HasTopPartidas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

      <StackPanel Margin="0"
                  Visibility="{Binding HasTopPartidas, Converter={StaticResource BoolToVisibility}}">
        <DataGrid ItemsSource="{Binding FilteredCockpitPartidas}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Style="{StaticResource DataGrid.Workspace}"
                  CanUserAddRows="False" SelectionMode="Single" VerticalAlignment="Stretch"
                  MaxHeight="420" MouseDoubleClick="OnTopPartidaDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="36">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Código" Binding="{Binding Item}" Width="84">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="108">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Monto" Binding="{Binding TotalShortLabel}" Width="140">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="Participación" Width="128">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Line2}"
                            ClipToBounds="True">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding FillWidth}" />
                          <ColumnDefinition Width="{Binding RemainderWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource Brush.AmberRisk}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ParetoClass}" Value="C">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Muted}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="%" Binding="{Binding PercentLabel}" Width="52">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="Clase" Width="52">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5" Padding="7,1" MinWidth="24">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ParetoClass}" Value="A">
                            <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                            <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ParetoClass}" FontSize="10.5" FontWeight="Bold" TextAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ParetoClass}" Value="A">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ParetoClass}" Value="B">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="76">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" ToolTip="Ir a la partida en Itemizado"
                            Command="{Binding DataContext.GoToPartidaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"
                            Padding="4,1" Margin="0,0,3,0" Cursor="Hand">
                      <TextBlock Text="Ir →" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" ToolTip="Abrir APU de esta partida"
                            Command="{Binding DataContext.GoToApuPartidaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"
                            Padding="4,1" Cursor="Hand">
                      <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Blue}" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Pie -->
        <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,1,0,0" Padding="16,9">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Button.Link}" Content="Ver todas las partidas →"
                      Command="{Binding GoToItemizadoCommand}" FontSize="11.5" Padding="4,2" />
            </StackPanel>
            <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center">
              <Run Text="{Binding ParetoSummary.SummaryHint, Mode=OneWay}" />
            </TextBlock>
          </DockPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
