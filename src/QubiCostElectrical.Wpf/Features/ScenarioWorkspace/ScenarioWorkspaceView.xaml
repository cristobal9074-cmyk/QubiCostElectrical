<UserControl x:Class="QubiCostElectrical.Wpf.Features.ScenarioWorkspace.ScenarioWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="{DynamicResource Brush.Canvas}">

  <ctrl:WorkspacePageChrome ShowEmptyState="{Binding ShowEmptyState}"
                            IsLoading="{Binding IsLoading}"
                            EmptyTitle="Sin proyecto abierto"
                            EmptyDescription="Abra un proyecto para crear y comparar escenarios económicos."
                            LoadingMessage="Calculando escenarios…">
    <ctrl:WorkspacePageChrome.Body>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">

          <TextBlock Text="Escenarios" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
          <TextBlock Text="Compare alternativas económicas sobre el presupuesto abierto y aplique un escenario a la base."
                     Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,16" />

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
              <Button Content="Agregar" Command="{Binding CreateCommand}"
                      Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
              <Button Content="Duplicar" Command="{Binding DuplicateCommand}" CommandParameter="{Binding SelectedScenario}"
                      Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
              <Button Content="Quitar" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedScenario}"
                      Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
              <Button Content="Calcular" Command="{Binding CalculateCommand}"
                      Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
              <Button Content="Aplicar a base" Command="{Binding ApplyToBaseCommand}"
                      Style="{StaticResource Button.Secondary}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Escenarios del proyecto" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
              <DataGrid ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}"
                        AutoGenerateColumns="False" CanUserAddRows="False"
                        Style="{StaticResource DataGrid.Workspace}"
                        infra:DataGridExcelNavigation.Enable="True"
                        IsReadOnly="{Binding IsReadOnly}"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Nombre" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" />
                  <DataGridTextColumn Header="Tipo" Binding="{Binding ScenarioType, UpdateSourceTrigger=LostFocus}" Width="110" />
                  <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                  <DataGridTextColumn Header="Costo directo" Binding="{Binding DirectCost, StringFormat='{}{0:N0}'}" IsReadOnly="True" Width="110">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Precio unitario" Binding="{Binding UnitPrice, StringFormat='{}{0:N0}'}" IsReadOnly="True" Width="120">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0}'}" IsReadOnly="True" Width="110">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Variación %" Binding="{Binding VariationPct, StringFormat='{}{0:N1}'}" IsReadOnly="True" Width="90">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Comparar" Style="{StaticResource Button.Ghost}" Padding="8,4"
                                Command="{Binding DataContext.CompareWithBaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Helper}" TextWrapping="Wrap" />

        </StackPanel>
      </ScrollViewer>
    </ctrl:WorkspacePageChrome.Body>
  </ctrl:WorkspacePageChrome>
</UserControl>
