<UserControl x:Class="QubiCostElectrical.Wpf.Features.ScenarioWorkspace.ScenarioWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.ScenarioWorkspace">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Escenarios" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Command="{Binding CalculateCommand}" Content="Recalcular" Style="{StaticResource Button.Primary}" Margin="16,0,0,0" />
        <Button Command="{Binding CreateCommand}" Content="+ Nuevo" Style="{StaticResource Button.Secondary}" Margin="16,0,0,0" />
        <Button Command="{Binding DuplicateCommand}" CommandParameter="{Binding SelectedScenario}" Content="Duplicar" Style="{StaticResource Button.Secondary}" />
        <Button Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedScenario}" Content="Eliminar" Style="{StaticResource Button.Secondary}" />
        <Button Command="{Binding ApplyToBaseCommand}" Content="Aplicar a versión" Style="{StaticResource Button.Secondary}" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}"
              AutoGenerateColumns="False" Background="{DynamicResource Brush.Surface}" Margin="12,0"
              AlternatingRowBackground="{DynamicResource Brush.AltRow}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="180" />
        <DataGridTextColumn Header="Tipo" Binding="{Binding ScenarioType}" Width="120" />
        <DataGridTextColumn Header="Costo Directo" Binding="{Binding DirectCost, StringFormat=N0}" Width="130" />
        <DataGridTextColumn Header="Indirectos" Binding="{Binding IndirectCost, StringFormat=N0}" Width="120" />
        <DataGridTextColumn Header="Utilidad" Binding="{Binding Utility, StringFormat=N0}" Width="110" />
        <DataGridTextColumn Header="Impuestos" Binding="{Binding Taxes, StringFormat=N0}" Width="110" />
        <DataGridTextColumn Header="Precio Unitario" Binding="{Binding UnitPrice, StringFormat=N0}" Width="130" />
        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N0}" Width="130" />
        <DataGridTextColumn Header="Variación" Binding="{Binding VariationPct, StringFormat=N1}" Width="90" />
        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="70" />
        <DataGridCheckBoxColumn Header="Calculado" Binding="{Binding IsCalculated}" IsReadOnly="True" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
