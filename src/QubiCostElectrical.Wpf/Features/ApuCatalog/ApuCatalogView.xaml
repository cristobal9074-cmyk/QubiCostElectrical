<UserControl x:Class="QubiCostElectrical.Wpf.Features.ApuCatalog.ApuCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.ApuCatalog">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Catálogo APU" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="250"
                 VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Command="{Binding SearchCommand}" Content="Buscar" Style="{StaticResource Button.Primary}" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
              AutoGenerateColumns="False" Background="{DynamicResource Brush.Surface}" Margin="12,0"
              AlternatingRowBackground="{DynamicResource Brush.AltRow}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="120" />
        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="250" />
        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" />
        <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="70" />
        <DataGridTextColumn Header="Versiones" Binding="{Binding VersionCount}" Width="80" />
        <DataGridTextColumn Header="Versión Activa" Binding="{Binding ActiveVersionNumber}" Width="100" />
        <DataGridTextColumn Header="Estado" Binding="{Binding ActiveVersionStatus}" Width="100" />
        <DataGridTextColumn Header="Último Precio" Binding="{Binding LastPrice, StringFormat=N0}" Width="120" />
        <DataGridTextColumn Header="Propietario" Binding="{Binding Owner}" Width="130" />
        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" IsReadOnly="True" Width="70" />
        <DataGridTemplateColumn Header="Acción" Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Comparar" Command="{Binding DataContext.CompareCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                      CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <Button Command="{Binding PreviousPageCommand}" Content="← Anterior" Style="{StaticResource Button.Secondary}" />
        <TextBlock Text="{Binding CurrentPage, StringFormat='Página {0}'}" VerticalAlignment="Center" Margin="8,0" />
        <Button Command="{Binding NextPageCommand}" Content="Siguiente →" Style="{StaticResource Button.Secondary}" />
        <TextBlock Text="{Binding TotalCount, StringFormat='Total: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
