<UserControl x:Class="QubiCostElectrical.Wpf.Features.ApuCatalog.ApuCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="{DynamicResource Brush.Canvas}">

  <ctrl:WorkspacePageChrome ShowEmptyState="{Binding ShowEmptyState}"
                            IsLoading="{Binding IsLoading}"
                            EmptyTitle="Sin proyecto abierto"
                            EmptyDescription="Abra un proyecto para buscar y comparar APU del catálogo."
                            LoadingMessage="Buscando en el catálogo…">
    <ctrl:WorkspacePageChrome.Body>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1200" HorizontalAlignment="Left">

          <TextBlock Text="Catálogo de APU" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
          <TextBlock Text="Busca, filtra y compara los análisis de precios unitarios registrados en el catálogo."
                     Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,16" />

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="BUSCAR" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,5" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="CATEGORÍA" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,5" />
                <TextBox Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" />
              </StackPanel>

              <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <Button Content="Buscar" Command="{Binding SearchCommand}"
                        Style="{StaticResource Button.Primary}" Padding="16,8" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="RESULTADOS" Style="{StaticResource Text.KpiLabel}" />
                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource Text.KpiInline}"
                           FontFamily="{StaticResource Font.Mono}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,24,0">
                <TextBlock Text="PÁGINA" Style="{StaticResource Text.KpiLabel}" />
                <TextBlock Style="{StaticResource Text.KpiInline}" FontFamily="{StaticResource Font.Mono}">
                  <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>

              <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Style="{StaticResource Text.Helper}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"
                         TextWrapping="Wrap" MaxWidth="360" />
            </Grid>
          </Border>

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="APU encontrados" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button Content="‹ Anterior" Command="{Binding PreviousPageCommand}"
                          Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                  <Button Content="Siguiente ›" Command="{Binding NextPageCommand}"
                          Style="{StaticResource Button.Secondary}" />
                </StackPanel>
              </Grid>

              <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                        AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                        Style="{StaticResource DataGrid.Workspace}"
                        infra:DataGridExcelNavigation.Enable="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90" />
                  <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="130" />
                  <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="70" />
                  <DataGridTextColumn Header="Versiones" Binding="{Binding VersionCount}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="V. activa" Binding="{Binding ActiveVersionNumber}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Estado" Binding="{Binding ActiveVersionStatus}" Width="90" />
                  <DataGridTextColumn Header="Último precio" Binding="{Binding LastPrice, StringFormat='{}{0:N0}'}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="60" />
                  <DataGridTextColumn Header="Responsable" Binding="{Binding Owner}" Width="120" />
                  <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Comparar" Style="{StaticResource Button.Ghost}" Padding="8,4"
                                Command="{Binding DataContext.CompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </ctrl:WorkspacePageChrome.Body>
  </ctrl:WorkspacePageChrome>
</UserControl>
