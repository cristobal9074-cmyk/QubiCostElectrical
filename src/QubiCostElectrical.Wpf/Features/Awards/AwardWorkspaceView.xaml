<UserControl x:Class="QubiCostElectrical.Wpf.Features.Awards.AwardWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Adjudicación" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Confirmar recomendación, total/parcial y aprobar con segregación de funciones." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Crear desde recomendación" Command="{Binding CreateFromRecCommand}" Margin="0,0,6,6" Padding="10,6" Background="#2563EB" Foreground="White"/>
      <Button Content="Enviar" Command="{Binding SubmitCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Aprobar" Command="{Binding ApproveCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Rechazar" Command="{Binding RejectCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <TextBox Text="{Binding Reason}" Width="220" Margin="8,0,0,6"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Comparisons}" SelectedItem="{Binding SelectedComparison}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="RFQ" Binding="{Binding RfqId.Value}" Width="*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Moneda" Binding="{Binding BaseCurrency}" Width="Auto"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Column="1" ItemsSource="{Binding Awards}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Impacto" Binding="{Binding BudgetImpactBase}" Width="*"/>
          <DataGridTextColumn Header="Ítems" Binding="{Binding Items.Count}" Width="Auto"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
