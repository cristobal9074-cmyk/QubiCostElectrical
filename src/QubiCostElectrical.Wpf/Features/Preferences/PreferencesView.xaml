<UserControl x:Class="QubiCostElectrical.Wpf.Features.Preferences.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:ds="clr-namespace:QubiCostElectrical.Wpf.DesignSystem"
             PreviewKeyDown="OnPreviewKeyDown"
             Background="{DynamicResource Brush.Canvas}">
  <Grid>
    <Grid Margin="{StaticResource Padding.Page}"
          Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="8" Margin="0,0,16,0" VerticalAlignment="Stretch">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Preferencias" Style="{StaticResource Text.PageTitle}"
                   Margin="8,4,8,12" />
        <ListBox ItemsSource="{Binding NavSections}"
                 SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="10" Padding="10,8">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding ShortcutCue, StringFormat='Atajo: {0}'}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Helper}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" Padding="5,1.5"
                        CornerRadius="4" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        Visibility="{Binding ShortcutCue, Converter={StaticResource StringNotEmptyToVisibility}}">
                  <TextBlock Text="{Binding ShortcutCue}" FontSize="9.5" FontFamily="{StaticResource Font.Mono}"
                             Foreground="{DynamicResource Brush.Muted}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="780">
      <!-- ─── Identidad y membrete ─────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsIdentitySection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="IDENTIDAD Y MEMBRETE" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2"/>
          <TextBlock Text="Datos globales aplicados a PDF, DOCX y Excel de cualquier proyecto." Style="{StaticResource Text.Caption}" Margin="0,0,0,16"/>

          <!-- ── Empresa ── -->
          <TextBlock Text="EMPRESA" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Razón social" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="140"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RUT" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding Rut, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="30"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Dirección" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="180"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Teléfono" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="80"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Correo" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="110"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Sitio web" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="110"/>
          </Grid>

          <!-- Logo -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Logo PNG/JPG" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="500"
                     ToolTip="Ruta del archivo de logo. Formatos: PNG, JPG. Máximo 5 MB."/>
            <Button Grid.Column="3" Content="Examinar…" Height="34" Padding="10,0" Style="{StaticResource Button.Secondary}"
                    Click="OnBrowseLogoClick"/>
            <Button Grid.Column="5" Content="Quitar" Height="34" Padding="8,0" Style="{StaticResource Button.Secondary}"
                    Click="OnClearLogoClick"/>
          </Grid>
          <TextBlock Text="PNG o JPG, fondo blanco o transparente, máximo 5 MB. Recomendado: horizontal."
                     Style="{StaticResource Text.Caption}" Margin="180,0,0,12"/>

          <!-- ── Profesional firmante ── -->
          <Separator Style="{StaticResource Separator.Section}" />
          <TextBlock Text="PROFESIONAL FIRMANTE" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,10"/>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Nombre" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding ProfessionalName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="140"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RUT" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding ProfessionalRut, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="30"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Cargo" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding ProfessionalRole, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="100"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="N° Registro SEC" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding ProfessionalRegistroSec, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="60"/>
          </Grid>

          <!-- Firma -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Imagen firma PNG/JPG" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBox Grid.Column="1" Text="{Binding ProfessionalSignatureImagePath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Height="34" MaxLength="500"
                     ToolTip="Ruta de la imagen de firma escaneada. Formatos: PNG, JPG."/>
            <Button Grid.Column="3" Content="Examinar…" Height="34" Padding="10,0" Style="{StaticResource Button.Secondary}"
                    Click="OnBrowseSignatureClick"/>
            <Button Grid.Column="5" Content="Quitar" Height="34" Padding="8,0" Style="{StaticResource Button.Secondary}"
                    Click="OnClearSignatureClick"/>
          </Grid>
          <TextBlock Text="Firma escaneada PNG o JPG. Solo se aplica en PDF cuando el proyecto no tiene una propia."
                     Style="{StaticResource Text.Caption}" Margin="180,0,0,8"/>

          <!-- Dimensiones de firma -->
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Dimensiones firma (mm)" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <Grid Grid.Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Ancho" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ProfessionalSignatureWidthMm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" Height="34" MaxLength="5"
                         ds:FieldAdornment.Suffix="mm"
                         ToolTip="Ancho de la imagen de la firma en los PDF (predeterminado 46 mm)."/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Alto" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ProfessionalSignatureHeightMm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" Height="34" MaxLength="5"
                         ds:FieldAdornment.Suffix="mm"
                         ToolTip="Alto de la imagen de la firma en los PDF (predeterminado 16 mm)."/>
              </StackPanel>
            </Grid>
          </Grid>
          <TextBlock Text="Tamaño predeterminado de la firma en PDF para todos los proyectos (ej. 46 x 16 mm)."
                     Style="{StaticResource Text.Caption}" Margin="180,4,0,0"/>

        </StackPanel>
      </Border>

      <!-- ─── Vista previa del membrete oficial (Miniatura en tiempo real) ── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsIdentitySection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,2">
            <Border DockPanel.Dock="Right" Background="#0F172A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
              <TextBlock Text="MINIATURA PDF OFICIAL" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
            </Border>
            <TextBlock Text="PREVISUALIZACIÓN DEL MEMBRETE OFICIAL" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Miniatura en tiempo real del encabezado oficial según se emite en presupuestos y documentos PDF."
                     Style="{StaticResource Text.Caption}" Margin="0,0,0,12"/>

          <!-- Hoja miniatura estilo carta PDF con sombra y diseño oficial -->
          <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,0,0,6">
            <Border.Effect>
              <DropShadowEffect BlurRadius="14" Color="#000000" Opacity="0.10" ShadowDepth="3" Direction="270" />
            </Border.Effect>
            <StackPanel>
              <!-- Fila superior: Logo y datos de empresa a la izquierda, bloque oficial cliente/oferta a la derecha -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Logo + Empresa + Contacto -->
                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Logo con contenedor idéntico a PDF -->
                  <Border Grid.Column="0" Width="110" Height="52" Margin="0,0,12,0"
                          Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3"
                          VerticalAlignment="Top"
                          Visibility="{Binding LogoImageSource, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                    <Image Source="{Binding LogoImageSource}" Stretch="Uniform" Margin="4" />
                  </Border>
                  <!-- Placeholder cuando no hay logo -->
                  <Border Grid.Column="0" Width="110" Height="52" Margin="0,0,12,0"
                          Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3"
                          VerticalAlignment="Top"
                          Visibility="{Binding LogoImageSource, Converter={StaticResource NullToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="SIN LOGO" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                      <TextBlock Text="Horizontal recom." FontSize="7.5" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Textos de empresa -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CompanyName}" FontSize="12" FontWeight="Bold" Foreground="#0B2442"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="8" Foreground="#475569" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Rut, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
                      <Run Text="RUT: " FontWeight="SemiBold" Foreground="#0B2442" /><Run Text="{Binding Rut}" />
                    </TextBlock>
                    <TextBlock FontSize="8" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Address, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}"
                               Text="{Binding Address}" />
                    <TextBlock FontSize="8" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                      <Run Text="FONO: " FontWeight="SemiBold" /><Run Text="{Binding Phone}" /><Run Text="  |  " /><Run Text="{Binding Email}" />
                    </TextBlock>
                    <TextBlock FontSize="7.5" Foreground="#0284C7" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Website, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}"
                               Text="{Binding Website}" />
                  </StackPanel>
                </Grid>

                <!-- Columna Derecha: Tarjeta de datos oficiales PDF -->
                <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="0.8" CornerRadius="2" Background="#FAFAFA" VerticalAlignment="Top">
                  <StackPanel>
                    <Border Background="#0B2442" Padding="6,3">
                      <TextBlock Text="DATOS OFERTA / DOCUMENTO" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="8,5">
                      <TextBlock FontSize="7.5" Foreground="#334155" Margin="0,1">
                        <Run Text="Folio / Carta: " FontWeight="Bold" Foreground="#0B2442" /><Run Text="OFT-001-2026" FontWeight="SemiBold" />
                      </TextBlock>
                      <TextBlock FontSize="7.5" Foreground="#334155" Margin="0,1">
                        <Run Text="Mandante: " FontWeight="Bold" /><Run Text="Constructora del Sur SpA" />
                      </TextBlock>
                      <TextBlock FontSize="7.5" Foreground="#334155" Margin="0,1">
                        <Run Text="Proyecto: " FontWeight="Bold" /><Run Text="Instalación Eléctrica General" />
                      </TextBlock>
                      <TextBlock FontSize="7.5" Foreground="#64748B" Margin="0,1">
                        <Run Text="Fecha emisión: " FontWeight="Bold" /><Run Text="30/10/2026" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Línea divisoria elegante corporativa -->
              <Grid Margin="0,12,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="2" Background="#0B2442" />
                <Border Grid.Column="1" Height="1" Background="#E2E8F0" VerticalAlignment="Center" />
              </Grid>

              <!-- Fila inferior: Profesional responsable y vista previa de firma escaneada -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Datos del profesional -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Border Background="#EBF2FB" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                      <TextBlock Text="RESPONSABLE TÉCNICO" FontSize="7.5" FontWeight="Bold" Foreground="#0B2442" />
                    </Border>
                    <TextBlock Text="{Binding ProfessionalName}" FontSize="9" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProfessionalRole}" FontSize="8.5" Foreground="#475569" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock FontSize="8" Foreground="#64748B"
                               Visibility="{Binding ProfessionalRut, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
                      <Run Text="RUT: " FontWeight="SemiBold" /><Run Text="{Binding ProfessionalRut}" />
                    </TextBlock>
                    <TextBlock FontSize="8" Foreground="#64748B" Margin="8,0,0,0"
                               Visibility="{Binding ProfessionalRegistroSec, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
                      <Run Text="Clase / Reg. SEC: " FontWeight="SemiBold" Foreground="#0B2442" /><Run Text="{Binding ProfessionalRegistroSec}" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>

                <!-- Firma escaneada en miniatura -->
                <Border Grid.Column="1" MinWidth="90" Height="38" Padding="4,2"
                        Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3"
                        VerticalAlignment="Center">
                  <Grid>
                    <Image Source="{Binding SignatureImageSource}" Stretch="Uniform"
                           Visibility="{Binding SignatureImageSource, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SignatureImageSource, Converter={StaticResource NullToVisibility}}">
                      <TextBlock Text="[ FIRMA OFICIAL ]" FontSize="7.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding ProfessionalName}" FontSize="7" Foreground="#CBD5E1" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Aplica automáticamente a: Portadas PDF, Carta de Oferta, Resumen Ejecutivo, Estado de Pago, Cuadros de Cargas y Planillas Excel oficiales."
                     Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- ─── General ──────────────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsGeneralSection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="GENERAL" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,16"/>

          <StackPanel Margin="0,0,0,0">
            <TextBlock Text="Carpeta predeterminada de proyectos" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding DefaultProjectFolder, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource Form.TextBox}" Height="36"
                       ToolTip="Carpeta inicial al abrir o guardar proyectos. Vacío = Documentos del usuario."/>
              <Button Grid.Column="2" Content="Examinar…" Height="36" Padding="12,0" Style="{StaticResource Button.Secondary}"
                      Click="OnBrowseProjectFolderClick"/>
              <Button Grid.Column="4" Content="Limpiar" Height="36" Padding="10,0" Style="{StaticResource Button.Secondary}"
                      Click="OnClearProjectFolderClick"/>
            </Grid>
            <TextBlock Text="Si la carpeta es un share SMB/UNC, solo un usuario edita el .qce a la vez; los demás abren en solo lectura."
                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Margin="0,16,0,0">
            <CheckBox IsChecked="{Binding AutosaveEnabled}" Content="Autoguardar el proyecto mientras trabajo" FontSize="12"/>
            <TextBlock Text="Desactivado, Guardar escribe el archivo. Si la aplicación se cierra de golpe, al volver a abrirlo se ofrece recuperar la copia .bak."
                       Style="{StaticResource Text.Caption}" Margin="22,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="Archivo del banco de precios" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding PriceBankDatabasePath, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource Form.TextBox}" Height="36"
                       ToolTip="Ruta absoluta del SQLite corporativo. Ej.: \\servidor\Presupuestos\banco_precios.db. Vacío = carpeta local del usuario."/>
              <Button Grid.Column="2" Content="Examinar…" Height="36" Padding="12,0" Style="{StaticResource Button.Secondary}"
                      Click="OnBrowsePriceBankDatabaseClick"/>
              <Button Grid.Column="4" Content="Limpiar" Height="36" Padding="10,0" Style="{StaticResource Button.Secondary}"
                      Click="OnClearPriceBankDatabaseClick"/>
            </Grid>
            <TextBlock Text="Requiere reiniciar la aplicación. Use una ruta UNC para compartir el catálogo en red (un editor de escritura a la vez)."
                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PriceBankPathWarning}"
                       Visibility="{Binding PriceBankPathWarning, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}"
                       Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Parámetros y márgenes predeterminados para proyectos -->
          <StackPanel Margin="0,20,0,0">
            <TextBlock Text="PARÁMETROS Y MÁRGENES PREDETERMINADOS PARA NUEVOS PROYECTOS" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4"/>
            <TextBlock Text="Valores corporativos por defecto que precargarán automáticamente cada nuevo presupuesto creado (pueden ajustarse luego en cada proyecto)."
                       Style="{StaticResource Text.Caption}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Gastos Generales predeterminados (GG)" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DefaultGastosGeneralesPctText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" Height="36"
                         ds:FieldAdornment.Suffix="%"
                         ToolTip="Porcentaje de GG inicial para cada nuevo proyecto (ej. 14,0)."/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Margen de Utilidad predeterminado" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DefaultUtilidadPctText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" Height="36"
                         ds:FieldAdornment.Suffix="%"
                         ToolTip="Porcentaje de Utilidad inicial para cada nuevo proyecto (ej. 18,0)."/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Mermas globales (%)" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DefaultMermasPctText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" Height="36"
                         ds:FieldAdornment.Suffix="%"
                         ToolTip="Porcentaje de merma sobre materiales inicial para nuevos proyectos."/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Herramientas (%)" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DefaultHerramientasPctText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Form.TextBox}" Height="36"
                         ds:FieldAdornment.Suffix="%"
                         ToolTip="Porcentaje de herramientas menores sobre mano de obra para nuevos proyectos."/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Moneda preferida" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AvailableCurrencies}" SelectedItem="{Binding DefaultMoneda, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource Form.ComboBox}" Height="36"
                          ToolTip="Moneda inicial por defecto al crear nuevos presupuestos."/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Modo de cubicación predeterminado" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
                <ComboBox SelectedValue="{Binding DefaultCubicacionMode, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag"
                          Style="{StaticResource Form.ComboBox}" Height="36"
                          ToolTip="Determina cómo se abre la cubicación: Zona Libre (cantidad directa en cada fila) o Por Zonas (desglose de pisos y sectores).">
                  <ComboBoxItem Content="🌐 Zona Libre (Cubicación directa en la columna de cantidad)" Tag="Libre" />
                  <ComboBoxItem Content="🏢 Por Zonas (Matriz de pisos, subterráneos y sectores)" Tag="Zonas" />
                </ComboBox>
                <TextBlock Text="Aplica al crear presupuestos nuevos o abrir la cubicación (también puedes alternarlo en cualquier momento con 1 clic en la barra superior de cubicación)."
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- ─── Tema ─────────────────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsThemeSection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="TEMA" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2"/>
          <TextBlock Text="Alterna entre modo claro y oscuro." Style="{StaticResource Text.Helper}" Margin="0,0,0,16"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Modo oscuro" Style="{StaticResource Text.Helper}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"/>
              <TextBlock Text="Aplica fondo oscuro a toda la interfaz. Se guarda automáticamente." Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" IsChecked="{Binding IsDarkMode}" Height="26" Width="48"
                          AutomationProperties.Name="Alternar modo oscuro">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Width="48" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Slate3}">
                          <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="2" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Blue2}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ─── Actualizaciones ─────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsUpdatesSection, Converter={StaticResource BoolToVisibility}}"
              DataContext="{Binding Updates}">
        <StackPanel>
          <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2"/>
          <TextBlock Text="Comprueba si hay una versión nueva de Qubi Cost Electrical disponible." Style="{StaticResource Text.Helper}" Margin="0,0,0,16"/>

          <!-- Versión instalada y canal -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Versión instalada" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.BlueDark}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Canal" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding Channel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          </Grid>

          <!-- Mensaje de estado -->
          <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                  Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Helper}"
                       TextWrapping="Wrap"/>
          </Border>

          <!-- Versión disponible -->
          <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.BrandStroke3}" BorderThickness="1" CornerRadius="6"
                  Padding="12,8" Margin="0,0,0,10"
                  Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Nueva versión: " Style="{StaticResource Text.Helper}" Foreground="{DynamicResource Brush.BlueDark}"/>
              <TextBlock Text="{Binding AvailableVersion}" Style="{StaticResource Text.Helper}" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}"/>
            </StackPanel>
          </Border>

          <!-- Progreso de descarga -->
          <Grid Margin="0,0,0,10"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="4"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" Style="{StaticResource Text.Helper}"/>
            <ProgressBar Grid.Row="2" Value="{Binding DownloadProgress, Mode=OneWay}" Minimum="0" Maximum="100"
                         Height="6" AutomationProperties.Name="Progreso de descarga"/>
          </Grid>

          <!-- Error -->
          <Border Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="6"
                  Padding="12,8" Margin="0,0,0,10"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Helper}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
          </Border>

          <!-- Última comprobación -->
          <Grid Margin="0,0,0,12"
                Visibility="{Binding LastCheckedAt, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Última comprobación" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding LastCheckedAt, StringFormat=dd/MM/yyyy HH:mm}"
                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
          </Grid>

          <!-- Botones -->
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding CheckForUpdatesCommand}" Height="34" Padding="14,0" Style="{StaticResource Button.Secondary}"
                    AutomationProperties.Name="Buscar actualizaciones">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Buscar actualizaciones"
                           Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                <TextBlock Text="Verificando…"
                           Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}"/>
              </StackPanel>
            </Button>
            <Button Margin="8,0,0,0" Height="34" Padding="14,0" Style="{StaticResource Button.Primary}"
                    Command="{Binding DownloadUpdateCommand}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Descargar actualización">
              Descargar
            </Button>
            <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Height="34" Padding="14,0"
                    Command="{Binding InstallAndRestartCommand}"
                    Visibility="{Binding CanInstallVisible, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Instalar y reiniciar">
              Instalar y reiniciar
            </Button>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- ─── Diagnóstico ──────────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsDiagnosticsSection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,16"/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Versión de la aplicación" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.BlueDark}" VerticalAlignment="Center"/>
          </Grid>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Carpeta de logs" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding LogsFolderPath}" Style="{StaticResource Text.Caption}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LogsFolderPath}"/>
            <Button Grid.Column="2" Content="Abrir carpeta" Height="30" Padding="10,0" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                    Click="OnOpenLogsFolderClick"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Carpeta de recuperación" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding RecoveryFolderPath}" Style="{StaticResource Text.Caption}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RecoveryFolderPath}"/>
            <Button Grid.Column="2" Content="Abrir carpeta" Height="30" Padding="10,0" Margin="8,0,0,0" Style="{StaticResource Button.Secondary}"
                    Click="OnOpenRecoveryFolderClick"/>
          </Grid>

        </StackPanel>
      </Border>

      <!-- ─── Usuarios y permisos ─────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}"
              Visibility="{Binding IsUsersSection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="USUARIOS Y PERMISOS" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2"/>
          <TextBlock Text="Cuentas locales (Admin, Estimador, Visor). Roles ≠ co-edición: un .qce en SMB/UNC admite 1 editor; el resto consulta en solo lectura." Style="{StaticResource Text.Helper}" Margin="0,0,0,16"/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" Height="34" ToolTip="Nombre"/>
            <TextBox Grid.Column="2" Text="{Binding NewUserEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" Height="34" ToolTip="Correo"/>
            <TextBox Grid.Column="4" Text="{Binding NewUserPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" Height="34" MaxLength="6" ToolTip="PIN 4-6 dígitos"/>
            <ComboBox Grid.Column="6" ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewUserRole}" Style="{StaticResource Form.ComboBox}" Height="34"/>
            <Button Grid.Column="8" Content="Crear usuario" Height="34" Padding="12,0" Style="{StaticResource Button.Primary}" Click="OnCreateUserClick"/>
          </Grid>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" Height="34" ToolTip="Buscar por nombre o correo (Ctrl+F)"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding UserRoleFilters}" SelectedItem="{Binding SelectedUserRoleFilter}" Style="{StaticResource Form.ComboBox}" Height="34"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding UserActiveFilters}" SelectedItem="{Binding SelectedUserActiveFilter}" Style="{StaticResource Form.ComboBox}" Height="34"/>
          </Grid>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="PIN mínimo" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding PinMinLength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" Height="34"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="PIN máximo" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding PinMaxLength, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" Height="34"/>
            </StackPanel>
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
              <TextBlock Text="Bloquear secuencias" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
              <ToggleButton IsChecked="{Binding PinBlockSequences}" Height="24" Width="44" HorizontalAlignment="Left"
                            AutomationProperties.Name="Bloquear secuencias de PIN">
                <ToggleButton.Style>
                  <Style TargetType="ToggleButton">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Bg" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Slate3}">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Blue2}" />
                              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ToggleButton.Style>
              </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="6" VerticalAlignment="Center">
              <TextBlock Text="Bloquear repeticiones" Style="{StaticResource Form.Label}" Margin="0,0,0,4"/>
              <ToggleButton IsChecked="{Binding PinBlockRepeats}" Height="24" Width="44" HorizontalAlignment="Left"
                            AutomationProperties.Name="Bloquear repeticiones de PIN">
                <ToggleButton.Style>
                  <Style TargetType="ToggleButton">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Bg" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Slate3}">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Blue2}" />
                              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ToggleButton.Style>
              </ToggleButton>
            </StackPanel>
          </Grid>

          <DataGrid x:Name="UsersGrid" Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                    AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    HeadersVisibility="Column" MinHeight="180" PreviewKeyDown="OnUsersGridPreviewKeyDown">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Activar/Desactivar" Click="OnContextToggleUserClick"/>
                <MenuItem Header="Cambiar rol" Click="OnContextRotateRoleClick"/>
                <MenuItem Header="Reset PIN" Click="OnContextResetPinClick"/>
                <Separator/>
                <MenuItem Header="Desbloquear cuenta" Click="OnContextUnlockUserClick"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="2*"/>
              <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="2*"/>
              <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="*"/>
              <DataGridTextColumn Header="Activo" Binding="{Binding IsActive}" Width="*"/>
              <DataGridTextColumn Header="Último acceso" Binding="{Binding LastLoginAt, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
              <DataGridTemplateColumn Header="Acciones" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Activar/Desactivar" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}"
                              Click="OnToggleUserActiveClick"
                              CommandParameter="{Binding}"/>
                      <Button Content="Cambiar rol" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}"
                              Click="OnRotateUserRoleClick"
                              CommandParameter="{Binding}"/>
                      <Button Content="Reset PIN" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}"
                              Click="OnResetUserPinClick"
                              CommandParameter="{Binding}"/>
                      <Button Content="Desbloquear" Style="{StaticResource Button.Secondary}"
                              Click="OnUnlockUserClick"
                              CommandParameter="{Binding}"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Atajos: F2 cambiar rol · Ctrl+U desbloquear · clic derecho para más acciones"
                     Style="{StaticResource Text.Helper}" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding UserAdminStatus}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>

          <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Auditoría persistente (SQLite)" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding UserAuditEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ─── Atajos de teclado por módulo / pestaña ──────────────────────── -->
      <Border Style="{StaticResource Card.FormSection}" Margin="0,0,0,16"
              Visibility="{Binding IsShortcutsSection, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="ATAJOS DE TECLADO POR PESTAÑA Y MÓDULO" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,2"/>
          <TextBlock Text="Explore y configure los atajos de teclado organizados por cada pantalla de la aplicación. Seleccione una pestaña o utilice el buscador en tiempo real."
                     Style="{StaticResource Text.Helper}" Margin="0,0,0,14" TextWrapping="Wrap"/>

          <!-- Barra de Búsqueda Rápida y Acciones de Restauración -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding ShortcutSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.SearchBox}"
                     Tag="Buscar atajo por acción, tecla o descripción (ej: Ctrl+M, Excel, Tablero, Partida)..."
                     Height="32" Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Restaurar pestaña actual" Padding="10,4" Margin="0,0,8,0" Style="{StaticResource Button.Secondary}"
                      Click="OnResetCurrentCategoryShortcutsClick" ToolTip="Restaura los atajos de la pestaña seleccionada a sus valores predeterminados."/>
              <Button Content="Restaurar todos" Padding="10,4" Style="{StaticResource Button.Secondary}"
                      Click="OnResetAllShortcutsClick" ToolTip="Restaura todos los atajos de teclado de la aplicación a los valores de fábrica."/>
            </StackPanel>
          </Grid>

          <!-- Selector de Sub-Pestañas / Módulos (Pill Tabs) -->
          <ItemsControl ItemsSource="{Binding ShortcutCategories}" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Button.Secondary}"
                        Margin="0,0,8,8"
                        Padding="12,5"
                        Height="32"
                        Tag="{Binding}"
                        Click="OnSelectShortcutCategoryClick">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                          <Border CornerRadius="99" Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center"
                                  Background="{DynamicResource Brush.Surface2}">
                            <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}"/>
                          </Border>
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}"/>
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Banner de captura activa -->
          <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1"
                  CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                  Visibility="{Binding IsShortcutCaptureActive, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="⌨️" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ShortcutCaptureMessage}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.BlueDark}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Grilla de Atajos Filtrados -->
          <DataGrid ItemsSource="{Binding FilteredShortcuts}"
                    Style="{StaticResource DataGrid.Workspace}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    GridLinesVisibility="Horizontal"
                    MinHeight="250"
                    MaxHeight="480"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <!-- Módulo -->
              <DataGridTemplateColumn Header="Módulo" Width="145">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ScopeIcon}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ScopeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Acción -->
              <DataGridTemplateColumn Header="Acción" Width="210">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Ink}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Atajo Keycap -->
              <DataGridTemplateColumn Header="Atajo de teclado" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.InputBorder}"
                            BorderThickness="1" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Text="{Binding GestureDisplay}" FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Descripción -->
              <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" MinWidth="180" />

              <!-- Tipo / Estado -->
              <DataGridTemplateColumn Header="Tipo" Width="105">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsConfigurable}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Acciones -->
              <DataGridTemplateColumn Header="" Width="175">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Cambiar" Padding="8,2" Margin="0,0,6,0" Style="{StaticResource Button.Secondary}"
                              Tag="{Binding}" Click="OnChangeShortcutClick"
                              Visibility="{Binding IsConfigurable, Converter={StaticResource BoolToVisibility}}" />
                      <Button Content="Restaurar" Padding="8,2" Style="{StaticResource Button.Secondary}"
                              Tag="{Binding}" Click="OnResetShortcutClick"
                              IsEnabled="{Binding IsCustomized}"
                              Visibility="{Binding IsConfigurable, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Text="Nativo del sistema" FontSize="11" Foreground="{DynamicResource Brush.Muted}" FontStyle="Italic"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsConfigurable}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- ─── Error de validación ──────────────────────────────────────────── -->
      <Border Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="8"
              Padding="12,8" Margin="0,0,0,12"
              Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
        <TextBlock Text="{Binding ValidationError}" Style="{StaticResource Text.Helper}" Foreground="{DynamicResource Brush.Danger}"/>
      </Border>

      <!-- ─── Mensaje de éxito ─────────────────────────────────────────────── -->
      <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}" BorderThickness="1" CornerRadius="8"
              Padding="12,8" Margin="0,0,0,12"
              Visibility="{Binding SaveStatus, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Text.Helper}" Foreground="{DynamicResource Brush.SuccessDark}"/>
      </Border>

      <!-- ─── Acciones ─────────────────────────────────────────────────────── -->
      <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
        <Button Style="{StaticResource Button.Primary}" Content="Guardar (Ctrl+S)"
                IsEnabled="{Binding HasPendingChanges}" Click="OnSaveClick"
                ToolTip="Guardar las preferencias globales en el equipo (Ctrl+S)"/>
        <Button Style="{StaticResource Button.Secondary}" Content="Aplicar (Ctrl+Enter)" Margin="8,0,0,0"
                IsEnabled="{Binding HasPendingChanges}" Click="OnApplyClick"
                ToolTip="Aplicar cambios de inmediato sin cerrar (Ctrl+Enter)"/>
        <Button Style="{StaticResource Button.Secondary}" Content="Cancelar (Esc)" Margin="8,0,0,0"
                IsEnabled="{Binding HasPendingChanges}" Click="OnCancelClick"
                ToolTip="Descartar cambios no guardados (Esc)"/>
        <Button Style="{StaticResource Button.Secondary}" Content="Restaurar predeterminados" Margin="24,0,0,0"
                Click="OnRestoreDefaultsClick"
                ToolTip="Restablecer todas las preferencias a sus valores originales de fábrica"/>
      </StackPanel>

    </StackPanel>
    </ScrollViewer>
  </Grid>

