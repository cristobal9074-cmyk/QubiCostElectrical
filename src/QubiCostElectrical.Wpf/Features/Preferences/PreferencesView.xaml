                            Description="Las preferencias son globales; no requieren un proyecto abierto."
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />
    <ctrl:SkeletonOverlayControl Panel.ZIndex="20"
                                   Message="Cargando preferencias…"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
