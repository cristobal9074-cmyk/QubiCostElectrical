                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource Brush.White}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="Totales coinciden con el presupuesto" FontSize="13"
                                         FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                                         Margin="9,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <!-- Totales: bloqueantes -->
                          <Border Padding="4,9">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasBlockers}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Style="{StaticResource WarnCircle}">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource Brush.Amber}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Hay bloqueantes por resolver" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Amber}" />
                                <TextBlock Text="Resuélvelos en Revisión final antes de exportar."
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <!-- Firma: presente -->
                          <Border Padding="4,9">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Style="{StaticResource OkCircle}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource Brush.White}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="Firma autorizada agregada" FontSize="13" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                          </Border>

                          <!-- Firma: ausente -->
                          <Border Padding="4,9">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Style="{StaticResource WarnCircle}">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource Brush.Amber}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Firma autorizada no agregada" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Amber}" />
                                <TextBlock Text="Opcional — puedes exportar sin firma."
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>

                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                </StackPanel>

                <!-- ═══════════ PASO 3 · EXPORTAR ═══════════ -->
                <StackPanel Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}">

                  <!-- Resumen -->
                  <UniformGrid Columns="5" Margin="0,0,0,10">
                    <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="Proyecto" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="Cliente" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="Estado" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                      <StackPanel>
                        <TextBlock Text="Revisión" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card.StatPill}" ToolTip="{Binding TotalOfertaSecondaryTooltip}">
                      <StackPanel>
                        <TextBlock Text="Total oferta (neto)" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding TotalOfertaDisplay}" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <!-- A · Alcance de exportación -->
                  <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
                    <StackPanel>
                      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectNum}">
                              <TextBlock Text="A" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                                         Foreground="{DynamicResource Brush.Blue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Alcance de exportación" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="Qué parte del presupuesto incluyen los documentos."
                                     FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
                        </StackPanel>
                      </Border>

                      <Border Padding="10,7">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,12,0">
                              <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegBtn}" Content="Completo"
                                             IsChecked="{Binding SelectedScopeMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Completo}" />
                                <RadioButton Style="{StaticResource SegBtn}" Content="Partida" Margin="3,0,0,0"
                                             IsChecked="{Binding SelectedScopeMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Partida}" />
                                <RadioButton Style="{StaticResource SegBtn}" Content="Área" Margin="3,0,0,0"
                                             IsChecked="{Binding SelectedScopeMode, Mode=TwoWay, Converter={StaticResource StringEquals}, ConverterParameter=Área}" />
                              </StackPanel>
                            </Border>

                            <ComboBox IsEnabled="False" MinWidth="230">
                              <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource Form.ComboBox}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPartidaScope}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAreaScope}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ComboBox.Style>
                              <ComboBoxItem>
                                <TextBlock>
                                  <Run Text="Todas las partidas (" />
                                  <Run Text="{Binding PartidaOptions.Count, Mode=OneWay}" />
                                  <Run Text=")" />
                                </TextBlock>
                              </ComboBoxItem>
                            </ComboBox>

                            <ComboBox Style="{StaticResource Form.ComboBox}" MinWidth="260"
                                      ItemsSource="{Binding PartidaOptions}"
                                      SelectedItem="{Binding SelectedPartida, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Visibility="{Binding IsPartidaScope, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Style="{StaticResource Form.ComboBox}" MinWidth="260"
                                      ItemsSource="{Binding AreaOptions}"
                                      SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                                      Visibility="{Binding IsAreaScope, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                          <TextBlock Text="{Binding ExportScopeSummaryText}" Margin="0,10,0,0"
                                     FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- B · Paquetes de entrega -->
                  <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
                    <StackPanel>
                      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <StackPanel Orientation="Horizontal">
                              <Border Style="{StaticResource SectNum}">
                                <TextBlock Text="B" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Blue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="Paquetes de entrega" FontSize="13" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Genera documentos individuales o el paquete completo."
                                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" Style="{StaticResource Button.Link}" Command="{Binding DeliverPackageCommand}"
                                  Padding="0" FontSize="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Exportar los " />
                              <TextBlock Text="{Binding DocumentsSelectionText}" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>

                      <Border Padding="10,7">
                        <ItemsControl ItemsSource="{Binding Actions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource PkgCard}" Margin="0,0,10,10">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top"
                                          Background="{Binding IconBackground}">
                                    <TextBlock Text="{Binding IconText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="11" Foreground="{Binding IconForeground}" />
                                  </Border>
                                  <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                                               TextWrapping="Wrap" />
                                    <Button Content="{Binding ButtonText}" Command="{Binding Command}"
                                            HorizontalAlignment="Left" Margin="0,9,0,0" Padding="12,6" FontSize="12">
                                      <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding Primary}" Value="True">
                                              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                              <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton}" />
                                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Primary}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton}" />
                                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Button.Style>
                                    </Button>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- Resultado -->
                  <Border Margin="0,0,0,10" Padding="16,11"
                          Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                          BorderThickness="1" CornerRadius="10"
                          Visibility="{Binding ExportResult.HasResults, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.GreenSoft}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource Brush.Green}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding ExportResult.SummaryText}" FontWeight="SemiBold"
                                 TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ExportResult.HasErrors}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Button Grid.Column="2" Style="{StaticResource Button.Secondary}"
                              Content="Abrir carpeta de destino"
                              Command="{Binding OpenPreviewFolderCommand}"
                              Margin="12,0,0,0" Padding="12,6" FontSize="11.5" VerticalAlignment="Center"
                              ToolTip="Abrir la carpeta con los archivos exportados en el Explorador de Windows" />
                    </Grid>
                  </Border>

                  <!-- Errores -->
                  <Border Margin="0,0,0,10" Padding="16,11"
                          Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}"
                          BorderThickness="1" CornerRadius="10">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DocumentErrors.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.White}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Errores de documentos" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.DangerDark}" />
                        <ItemsControl ItemsSource="{Binding DocumentErrors}" Margin="0,4,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3"
                                         Foreground="{DynamicResource Brush.Danger}" FontSize="12" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Border>

                </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <!-- Pie por paso -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="12,7">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="34" Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Los cambios se guardan en el proyecto al pulsar Guardar (Ctrl+S)."
                           FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource Button.Ghost}" Content="Guardar (Ctrl+S)"
                          Command="{Binding SaveOfferSettingsCommand}" Padding="10,6" FontSize="12" Margin="0,0,9,0"
                          ToolTip="Guardar configuración de oferta en el archivo del proyecto (Ctrl+S)" />
                  <Button Style="{StaticResource Button.Primary}" Content="Continuar a vista previa →"
                          Command="{Binding GoToPreviewStepCommand}" Padding="12,6" FontSize="12"
                          ToolTip="Continuar al Paso 2: Vista previa (Ctrl+2)" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Height="34" Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center">
                  <Run Text="Edite condiciones, alcance, planos y marcas en el paso " />
                  <Run Text="Configurar" FontWeight="Bold" />
                  <Run Text="." />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource Button.Ghost}" Content="← Volver (Ctrl+1)"
                          Command="{Binding GoToConfigureStepCommand}" Padding="10,6" FontSize="12" Margin="0,0,9,0"
                          ToolTip="Volver al Paso 1: Configurar (Ctrl+1)" />
                  <Button Style="{StaticResource Button.Primary}" Content="Continuar a exportar →"
                          Command="{Binding GoToExportStepCommand}" Padding="12,6" FontSize="12"
                          ToolTip="Continuar al Paso 3: Exportar paquete (Ctrl+3)" />
                </StackPanel>
              </Grid>

              <!-- Total + acciones (paso 3) -->
              <Grid Grid.Row="2" Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AmberSoft}"
                          VerticalAlignment="Top" Margin="0,0,11,0">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Brush.Amber}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock Text="{Binding FreezeBannerTitle}" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FreezeBannerDetail}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                            ToolTip="{Binding TotalOfertaSecondaryTooltip}">
                  <TextBlock Text="TOTAL OFERTA (NETO)" FontSize="9.5" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding TotalOfertaDisplay}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                             HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource Button.Ghost}" Content="Exportar seleccionados"
                          Command="{Binding DeliverPackageCommand}" Padding="10,6" FontSize="12" Margin="0,0,9,0"
                          ToolTip="Exportar los documentos seleccionados (Ctrl+E)" />
                  <Button Style="{StaticResource Button.Primary}" Content="Generar oferta → (Ctrl+E)"
                          Command="{Binding DeliverPackageCommand}" Padding="16,7" FontSize="12"
                          ToolTip="Generar oferta comercial y entregables (Ctrl+E)"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
              </Grid>
              </Grid>
            </Border>
          </Grid>
        </Border>

      </Grid>

      <!-- Rail derecho: vista previa a altura completa -->
      <Border Grid.RowSpan="4" Grid.Column="1" Style="{StaticResource Card.Section}" Padding="0" Margin="14,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,7,10,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Previsualización PDF" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.BlueSoft}" Margin="9,0,0,0"
                          Visibility="{Binding IsLivePreviewUpdating, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBlock Text="En vivo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding PreviewStatusText}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}"
                           Margin="0,1,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Actualizar"
                      Command="{Binding PreviewOfferCommand}" Padding="11,6" FontSize="12" VerticalAlignment="Top"
                      ToolTip="Actualizar vista previa en vivo (F5)" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource Brush.Canvas}" Padding="10,8">
              <ctrl:PdfPreviewPanel DataContext="{Binding PdfPreview}" ShowHeader="False" />
            </Border>

            <Grid Grid.Row="2" Margin="14,8,14,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0">
                <Run Text="{Binding PreviewFileText, Converter={StaticResource PathFileName}, Mode=OneWay}" />
              </TextBlock>
              <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.Surface2}">
                <TextBlock Text="{Binding PdfPreview.PageIndicator}" FontSize="10.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink2}" />
              </Border>
            </Grid>
          </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
