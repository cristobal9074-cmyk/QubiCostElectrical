                                  <DataTrigger Binding="{Binding PreviewSwitch.SelectedId}" Value="OfferLetter">
                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
