<UserControl x:Class="QubiCostElectrical.Wpf.Features.Export.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Export"
             Focusable="True"
             KeyDown="OnUserControlKeyDown">
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToConfigureStepCommand}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoToPreviewStepCommand}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoToExportStepCommand}" />
    <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding GoToConfigureStepCommand}" />
    <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding GoToPreviewStepCommand}" />
    <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding GoToExportStepCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding DeliverPackageCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveOfferSettingsCommand}" />
  </UserControl.InputBindings>

  <Grid Background="{DynamicResource Brush.Canvas}"
        HorizontalAlignment="Stretch">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para configurar la oferta comercial, revisar la vista previa y exportar documentos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando oferta…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    <ctrl:SkeletonOverlayControl Panel.ZIndex="21" Message="Generando documentos…"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="720" MinWidth="600" />
      </Grid.ColumnDefinitions>

      <!-- ══ Cabecera de página ═══════════════════════════════════ -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="Oferta y exportación" FontSize="19" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Ink}" LineHeight="22" />

          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding ProjectTitle}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding ClientName}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding TotalOfertaDisplay}" FontSize="12" FontFamily="{StaticResource Font.Mono}"
                       Foreground="{DynamicResource Brush.Muted}" ToolTip="{Binding TotalOfertaSecondaryTooltip}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}" Margin="0,0,10,0"
                  ToolTip="Actualizar oferta y vista previa (F5)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Actualizar (F5)" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding GoToFinalReviewCommand}"
                  ToolTip="Ir al módulo de Revisión y Control de Calidad">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Ir a Revisión" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ══ Banner de bloqueantes ═══════════════════════════════════════ -->
      <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,6"
              Background="{DynamicResource Brush.RedSoft}" BorderBrush="{DynamicResource Brush.DangerBorder}"
              BorderThickness="1" CornerRadius="10"
              Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource Brush.White}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource Brush.Danger}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Hay bloqueantes que impiden exportar" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.DangerDark}" />
            <TextBlock Text="{Binding Blockers, StringFormat={}{0} problema(s) pendiente(s) en Revisión final.}"
                       FontSize="11" Foreground="{DynamicResource Brush.Danger}" Margin="0,1,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Ir a Revisión"
                  Command="{Binding GoToFinalReviewCommand}" Padding="9,4" FontSize="11"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ══ Stepper compacto ═══════════════════════════════════ -->
      <local:ExportStepperControl Grid.Row="2" Margin="0,0,0,8" />

      <!-- ══ Contenido principal: columna izquierda ═══════════════ -->
      <Grid Grid.Row="3">

        <!-- ══ Columna izquierda ═════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado por paso -->
            <Grid Grid.Row="0" Margin="10,7,10,6" Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Configurar la oferta" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Elige un preset, ajusta el contenido del documento y el membrete."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Guardar"
                      Command="{Binding SaveOfferSettingsCommand}" Padding="10,6" FontSize="12" />
            </Grid>

            <Grid Grid.Row="0" Margin="10,7,10,6" Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Vista previa" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Revisa cómo quedará cada documento antes de exportar."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.GreenSoft}">
                <TextBlock Text="Actualizada" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
              </Border>
            </Grid>

            <Grid Grid.Row="0" Margin="10,7,10,6" Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Exportar" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Define el alcance, elige los paquetes y genera los documentos finales."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.AmberSoft}" Margin="0,0,6,0">
                  <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
                </Border>
                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Surface2}"
                        Visibility="{Binding VersionText, Converter={StaticResource StringNotEmptyToVisibility}}">
                  <TextBlock Text="{Binding VersionText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" />
                </Border>
              </StackPanel>
            </Grid>

            <!-- Cuerpo scrolleable -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="10,0,10,2">
                <!-- ═══════════ PASO 1 · CONFIGURAR ═══════════ -->
                <local:ExportConfigureStepControl Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}" />

                <!-- ═══════════ PASO 2 · VISTA PREVIA ═══════════ -->
                <local:ExportPreviewStepControl Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}" />

                <!-- ═══════════ PASO 3 · EXPORTAR ═══════════ -->
                <local:ExportDeliverStepControl Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </ScrollViewer>

            <!-- Pie por paso -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="12,7">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="34" Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Los cambios se guardan en el proyecto al pulsar Guardar (Ctrl+S)."
                             FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Content="Guardar (Ctrl+S)"
                            Command="{Binding SaveOfferSettingsCommand}" Padding="10,6" FontSize="12" Margin="0,0,9,0"
                            ToolTip="Guardar configuración de oferta en el archivo del proyecto (Ctrl+S)" />
                    <Button Style="{StaticResource Button.Primary}" Content="Continuar a vista previa →"
                            Command="{Binding GoToPreviewStepCommand}" Padding="12,6" FontSize="12"
                            ToolTip="Continuar al Paso 2: Vista previa (Ctrl+2)" />
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Height="34" Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center">
                    <Run Text="Edite condiciones, alcance, planos y marcas en el paso " />
                    <Run Text="Configurar" FontWeight="Bold" />
                    <Run Text="." />
                  </TextBlock>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Content="← Volver (Ctrl+1)"
                            Command="{Binding GoToConfigureStepCommand}" Padding="10,6" FontSize="12" Margin="0,0,9,0"
                            ToolTip="Volver al Paso 1: Configurar (Ctrl+1)" />
                    <Button Style="{StaticResource Button.Primary}" Content="Continuar a exportar →"
                            Command="{Binding GoToExportStepCommand}" Padding="12,6" FontSize="12"
                            ToolTip="Continuar al Paso 3: Exportar paquete (Ctrl+3)" />
                  </StackPanel>
                </Grid>

                <!-- Total + acciones (paso 3) -->
                <Grid Grid.Row="2" Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AmberSoft}"
                            VerticalAlignment="Top" Margin="0,0,11,0">
                      <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                 Foreground="{DynamicResource Brush.Amber}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="360">
                      <TextBlock Text="{Binding FreezeBannerTitle}" FontSize="12" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding FreezeBannerDetail}" FontSize="11.5"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                              ToolTip="{Binding TotalOfertaSecondaryTooltip}">
                    <TextBlock Text="TOTAL OFERTA (NETO)" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalOfertaDisplay}" FontFamily="{StaticResource Font.Mono}"
                               FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                               HorizontalAlignment="Right" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Content="Exportar seleccionados"
                            Command="{Binding DeliverPackageCommand}" Padding="10,6" FontSize="12" Margin="0,0,9,0"
                            ToolTip="Exportar los documentos seleccionados (Ctrl+E)" />
                    <Button Style="{StaticResource Button.Primary}" Content="Generar oferta → (Ctrl+E)"
                            Command="{Binding DeliverPackageCommand}" Padding="16,7" FontSize="12"
                            ToolTip="Generar oferta comercial y entregables (Ctrl+E)"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Border>

      </Grid>

      <!-- Rail derecho: vista previa a altura completa -->
      <Border Grid.RowSpan="4" Grid.Column="1" Style="{StaticResource Card.Section}" Padding="0" Margin="14,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="10,7,10,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Previsualización PDF" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.BlueSoft}" Margin="9,0,0,0"
                        Visibility="{Binding IsLivePreviewUpdating, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="En vivo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding PreviewStatusText}" FontSize="11.5" Foreground="{DynamicResource Brush.Muted}"
                         Margin="0,1,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Actualizar"
                    Command="{Binding PreviewOfferCommand}" Padding="11,6" FontSize="12" VerticalAlignment="Top"
                    ToolTip="Actualizar vista previa en vivo (F5)" />
          </Grid>

          <Border Grid.Row="1" Background="{DynamicResource Brush.Canvas}" Padding="10,8">
            <ctrl:PdfPreviewPanel DataContext="{Binding PdfPreview}" ShowHeader="False" />
          </Border>

          <Grid Grid.Row="2" Margin="14,8,14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0">
              <Run Text="{Binding PreviewFileText, Converter={StaticResource PathFileName}, Mode=OneWay}" />
            </TextBlock>
            <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.Surface2}">
              <TextBlock Text="{Binding PdfPreview.PageIndicator}" FontSize="10.5" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink2}" />
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
