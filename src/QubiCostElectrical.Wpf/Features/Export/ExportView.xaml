<UserControl x:Class="QubiCostElectrical.Wpf.Features.Export.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:delivery="clr-namespace:QubiCostElectrical.Wpf.Features.Delivery">
  <UserControl.Resources>
    <Style x:Key="WizardStepConnector" TargetType="Border">
      <Setter Property="Height" Value="2" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style x:Key="WizardStepBadge" TargetType="Border">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="WizardStepButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Canvas}"
        HorizontalAlignment="Stretch">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para configurar la oferta comercial, revisar la vista previa y exportar documentos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando oferta…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    <ctrl:SkeletonOverlayControl Panel.ZIndex="21" Message="Generando documentos…"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="640" />
      <ColumnDefinition Width="420" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Oferta y exportación" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,14" />
        <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="14" Margin="0,0,0,14">
          <TextBlock Text="Valida el presupuesto, configura el alcance y exporta PDF, Excel o Word con vista previa."
                     Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
        </Border>
        <DockPanel Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource Brush.AmberSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource Brush.Amber}" />
            </Border>
            <Button Style="{StaticResource Button.Secondary}" Content="Actualizar" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </DockPanel>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Command="{Binding GoToReviewStepCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource WizardStepButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource WizardStepBadge}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="1" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                          <Setter Property="Text" Value="✓" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBlock Text="1. Validar oferta" FontWeight="SemiBold" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>

          <Border Grid.Column="1" Width="16">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource WizardStepConnector}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <Button Grid.Column="2" Command="{Binding GoToConfigureStepCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource WizardStepButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource WizardStepBadge}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="2" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                          <Setter Property="Text" Value="✓" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBlock Text="2. Configurar" FontWeight="SemiBold" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>

          <Border Grid.Column="3" Width="16">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource WizardStepConnector}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <Button Grid.Column="4" Command="{Binding GoToPreviewStepCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource WizardStepButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource WizardStepBadge}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="3" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                          <Setter Property="Text" Value="✓" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBlock Text="3. Vista previa" FontWeight="SemiBold" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>

          <Border Grid.Column="5" Width="16">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource WizardStepConnector}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep3Completed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <Button Grid.Column="6" Command="{Binding GoToExportStepCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource WizardStepButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource WizardStepBadge}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBlock Text="4. Exportar" FontWeight="SemiBold" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
          <TextBlock Text="Cierre previo a exportar" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
          <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="12">
            <StackPanel>
              <TextBlock Text="{Binding ExportReadinessText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConfidencePct, StringFormat=Confianza: {0:N0}%}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding Blockers, StringFormat=Bloqueantes: {0}}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.DangerDark}" />
              <TextBlock Text="{Binding Warnings, StringFormat=Advertencias: {0}}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Amber}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
          <TextBlock Text="Documentos de entrega y configuración" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Mandante" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0"
                    Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Mandante"
                    ToolTip="Oferta PDF + carta DOCX" />
            <Button Content="Interno" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0"
                    Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Interno"
                    ToolTip="Todos los documentos seleccionados" />
            <Button Content="Banco" Style="{StaticResource Button.Secondary}"
                    Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Banco"
                    ToolTip="Oferta PDF + Excel de control" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding DocumentSelector.Documents}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <delivery:OfferSettingsEditorPanel DataContext="{Binding OfferSettings}"
                                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Margin="0,0,0,10" />

          <TextBlock Text="{Binding DeliverySummaryText}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Guardar configuración" Command="{Binding SaveOfferSettingsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
            <Button Content="Seleccionar logo" Command="{Binding PickLogoCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
            <Button Content="Seleccionar firma" Command="{Binding PickSignatureCommand}" Style="{StaticResource Button.Secondary}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
          <TextBlock Text="Previsualización comercial" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
          <TextBlock Text="Edite condiciones, alcance y notas en el paso Configurar. El PDF del panel derecho se actualiza automáticamente."
                     Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Text="{Binding PreviewStatusText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PreviewFileText}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}">
          <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="10" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Proyecto" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Cliente" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Estado" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Revisión" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Total UF" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding TotalUf, StringFormat={}{0:N3}}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="5" Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
          </Border>

        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Sm}" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Alcance de exportación" Style="{StaticResource Text.Caption}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <StackPanel Width="220">
                <ComboBox Style="{StaticResource Form.ComboBox}"
                          ItemsSource="{Binding ScopeModes}"
                          SelectedItem="{Binding SelectedScopeMode, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Width="16" />
              <StackPanel Width="260" Visibility="{Binding IsPartidaScope, Converter={StaticResource BoolToVisibility}}">
                <ComboBox Style="{StaticResource Form.ComboBox}"
                          ItemsSource="{Binding PartidaOptions}"
                          SelectedItem="{Binding SelectedPartida, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
              </StackPanel>
              <StackPanel Width="16" />
              <StackPanel Width="260" Visibility="{Binding IsAreaScope, Converter={StaticResource BoolToVisibility}}">
                <ComboBox Style="{StaticResource Form.ComboBox}"
                          ItemsSource="{Binding AreaOptions}"
                          SelectedItem="{Binding SelectedArea, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding ExportScopeSummaryText}"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock Text="Paquetes de entrega" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,10" />
        <ItemsControl ItemsSource="{Binding Actions}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="390" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Sm}" Padding="14,12" Margin="0,0,8,8" MinHeight="156">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,10,0"
                            Background="{Binding IconBackground}">
                      <TextBlock Text="{Binding IconText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontWeight="Bold" FontSize="11" Foreground="{Binding IconForeground}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </DockPanel>
                  <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}"
                               FontSize="11" />
                  </StackPanel>
                  <Button Grid.Row="2" Content="{Binding ButtonText}" Command="{Binding Command}"
                          HorizontalAlignment="Stretch" Margin="0,12,0,0"
                          Style="{StaticResource Button.Secondary}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Exportar documentos seleccionados" Command="{Binding DeliverPackageCommand}"
                Style="{StaticResource Button.Secondary}" Margin="0,12,0,0" HorizontalAlignment="Left" />

        <Border Margin="0,12,0,0" Padding="12,10"
                Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}"
                Visibility="{Binding ExportResult.HasResults, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding ExportResult.SummaryText}" TextWrapping="Wrap" FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ExportResult.HasErrors}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>

        <Border Margin="0,10,0,0" Padding="12,10"
                Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DocumentErrors.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="Errores de documentos" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Danger}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding DocumentErrors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"
                             Foreground="{DynamicResource Brush.Danger}" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- Banner de precios congelados + total oferta (prototipo) -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Md}" Padding="20,16" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding FreezeBannerTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
              <TextBlock Text="{Binding FreezeBannerDetail}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                         TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0">
              <TextBlock Text="TOTAL OFERTA (NETO)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding TotalOfertaDisplay}" FontFamily="{StaticResource Font.Mono}" FontSize="22" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Generar oferta →"
                    Command="{Binding DeliverPackageCommand}" VerticalAlignment="Center" Padding="20,10"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card.Section}" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right"
                  Content="Actualizar ahora"
                  Command="{Binding PreviewOfferCommand}"
                  Style="{StaticResource Button.Secondary}"
                  VerticalAlignment="Top"
                  Margin="12,0,0,0" />
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                      Visibility="{Binding IsLivePreviewUpdating, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Actualizando…" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
              </Border>
              <TextBlock Text="Previsualización PDF" Style="{StaticResource Text.SectionLabel}" />
            </DockPanel>
            <TextBlock Text="{Binding PreviewStatusText}" Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <ctrl:PdfPreviewPanel Grid.Row="1" DataContext="{Binding PdfPreview}" />

        <TextBlock Grid.Row="2" Text="{Binding PreviewFileText}" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" />
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
