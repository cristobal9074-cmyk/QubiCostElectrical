                                           Visibility="{Binding OfferSettings.ClientLogoPath, Converter={StaticResource StringEmptyToVisibility}}" />
                              </StackPanel>
                            </Grid>
                          </Button>

                          <!-- Firma autorizada -->
                          <Button Style="{StaticResource Tile}" Command="{Binding PickSignatureCommand}">
