<UserControl x:Class="QubiCostElectrical.Wpf.Features.Export.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:delivery="clr-namespace:QubiCostElectrical.Wpf.Features.Delivery"
             Focusable="True"
             KeyDown="OnUserControlKeyDown">
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToConfigureStepCommand}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoToPreviewStepCommand}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoToExportStepCommand}" />
    <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding GoToConfigureStepCommand}" />
    <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding GoToPreviewStepCommand}" />
    <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding GoToExportStepCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding DeliverPackageCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveOfferSettingsCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="10,3.5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Sect" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="SectNum" TargetType="Border">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FmtBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding FormatHint}" Value="XLSX">
          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding FormatHint}" Value="DOCX">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FmtText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding FormatHint}" Value="XLSX">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding FormatHint}" Value="DOCX">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DocRow" TargetType="Border">
      <Setter Property="Padding" Value="4,7" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F8FAFD" />
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="False">
          <Setter Property="Opacity" Value="0.62" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PresetCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PreviewDocRow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="9,11" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RowBd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="#C5D0DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F8FBFF" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegBtn" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="18,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Blue}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StepButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F7FAFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StepConnector" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
      <Setter Property="Margin" Value="0,9" />
    </Style>

    <Style x:Key="PkgCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,12" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#C5D0DD" />
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Color="#101A26" Opacity="0.10" />
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="OkCircle" TargetType="Border">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WarnCircle" TargetType="Border">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Canvas}"
        HorizontalAlignment="Stretch">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para configurar la oferta comercial, revisar la vista previa y exportar documentos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando oferta…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    <ctrl:SkeletonOverlayControl Panel.ZIndex="21" Message="Generando documentos…"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="720" MinWidth="600" />
      </Grid.ColumnDefinitions>

      <!-- ══ Cabecera de página ═══════════════════════════════════ -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>

          <TextBlock Text="Oferta y exportación" FontSize="19" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Ink}" LineHeight="22" />

          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding ProjectTitle}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding ClientName}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding TotalOfertaDisplay}" FontSize="12" FontFamily="{StaticResource Font.Mono}"
                       Foreground="{DynamicResource Brush.Muted}" ToolTip="{Binding TotalOfertaSecondaryTooltip}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}" Margin="0,0,10,0"
                  ToolTip="Actualizar oferta y vista previa (F5)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Actualizar (F5)" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding GoToFinalReviewCommand}"
                  ToolTip="Ir al módulo de Revisión y Control de Calidad">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Ir a Revisión" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ══ Banner de bloqueantes ═══════════════════════════════════════ -->
      <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,6"
              Background="{DynamicResource Brush.RedSoft}" BorderBrush="{DynamicResource Brush.DangerBorder}"
              BorderThickness="1" CornerRadius="10"
              Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource Brush.White}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource Brush.Danger}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Hay bloqueantes que impiden exportar" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.DangerDark}" />
            <TextBlock Text="{Binding Blockers, StringFormat={}{0} problema(s) pendiente(s) en Revisión final.}"
                       FontSize="11" Foreground="{DynamicResource Brush.Danger}" Margin="0,1,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Ir a Revisión"
                  Command="{Binding GoToFinalReviewCommand}" Padding="9,4" FontSize="11"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ══ Stepper compacto ═══════════════════════════════════ -->
      <Border Grid.Row="2" Style="{StaticResource Card.Surface}" Padding="0" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Paso 1 -->
          <Button Grid.Column="0" Style="{StaticResource StepButton}" Command="{Binding GoToConfigureStepCommand}"
                  ToolTip="1. Configurar oferta y membrete (Ctrl+1)">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="26" Height="26" VerticalAlignment="Top">
                <Border CornerRadius="13" Background="{DynamicResource Brush.BlueSoft}"
                        Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="1.5" Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                            <Setter Property="FontSize" Value="10" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                  <TextBlock Text="Configurar" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Blue}"
                          BorderBrush="{DynamicResource Brush.Blue}" Padding="6,2" Margin="7,0,0,0"
                          Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Actual" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                  </Border>
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.GreenSoft}" Padding="6,2" Margin="7,0,0,0"
                          Visibility="{Binding IsStep1Completed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Listo" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Documentos, contenido y membrete" FontSize="10.5"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Button>

          <Border Grid.Column="1">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource StepConnector}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep1Completed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <!-- Paso 2 -->
          <Button Grid.Column="2" Style="{StaticResource StepButton}" Command="{Binding GoToPreviewStepCommand}"
                  ToolTip="2. Vista previa en vivo del documento (Ctrl+2)">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="26" Height="26" VerticalAlignment="Top">
                <Border CornerRadius="13" Background="{DynamicResource Brush.BlueSoft}"
                        Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="1.5" Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="2" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                            <Setter Property="FontSize" Value="10" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                  <TextBlock Text="Vista previa" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Blue}"
                          BorderBrush="{DynamicResource Brush.Blue}" Padding="6,2" Margin="7,0,0,0"
                          Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Actual" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                  </Border>
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.GreenSoft}" Padding="6,2" Margin="7,0,0,0"
                          Visibility="{Binding IsStep2Completed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Listo" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Revisa la carta y la oferta antes de exportar" FontSize="10.5"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Button>

          <Border Grid.Column="3">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource StepConnector}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsStep2Completed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <!-- Paso 3 -->
          <Button Grid.Column="4" Style="{StaticResource StepButton}" Command="{Binding GoToExportStepCommand}"
                  ToolTip="3. Exportación y cierre comercial (Ctrl+3)">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="26" Height="26" VerticalAlignment="Top">
                <Border CornerRadius="13" Background="{DynamicResource Brush.BlueSoft}"
                        Visibility="{Binding IsStep3Active, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="1.5" Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                  <TextBlock Text="Exportar" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Blue}"
                          BorderBrush="{DynamicResource Brush.Blue}" Padding="6,2" Margin="7,0,0,0"
                          Visibility="{Binding IsStep3Active, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Actual" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Alcance, paquetes y generación final" FontSize="10.5"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Button>

          <!-- Totales del stepper -->
          <Border Grid.Column="5" Background="{DynamicResource Brush.Surface2}"
                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0"
                  CornerRadius="0,14,14,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="TOTAL OFERTA" FontSize="8.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding TotalOfertaPillText}" FontSize="14.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right"
                           ToolTip="{Binding TotalOfertaSecondaryTooltip}" />
                <TextBlock Text="neto" FontSize="9.5" Foreground="{DynamicResource Brush.Ink2}"
                           HorizontalAlignment="Right" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DOCUMENTOS" FontSize="8.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DocumentsSelectionShortText}" FontSize="14.5" FontWeight="Bold"
                           FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}"
                           HorizontalAlignment="Right" />
                <TextBlock Text="seleccionados" FontSize="9.5" Foreground="{DynamicResource Brush.Ink2}"
                           HorizontalAlignment="Right" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ══ Contenido principal: columna izquierda ═══════════════ -->
      <Grid Grid.Row="3">

        <!-- ══ Columna izquierda ═════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado por paso -->
            <Grid Grid.Row="0" Margin="10,7,10,6" Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Configurar la oferta" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Elige un preset, ajusta el contenido del documento y el membrete."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Guardar"
                      Command="{Binding SaveOfferSettingsCommand}" Padding="10,6" FontSize="12" />
            </Grid>

            <Grid Grid.Row="0" Margin="10,7,10,6" Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Vista previa" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Revisa cómo quedará cada documento antes de exportar."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.GreenSoft}">
                <TextBlock Text="Actualizada" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
              </Border>
            </Grid>

            <Grid Grid.Row="0" Margin="10,7,10,6" Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Exportar" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Define el alcance, elige los paquetes y genera los documentos finales."
                           FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.AmberSoft}" Margin="0,0,6,0">
                  <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
                </Border>
                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.Surface2}"
                        Visibility="{Binding VersionText, Converter={StaticResource StringNotEmptyToVisibility}}">
                  <TextBlock Text="{Binding VersionText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" />
                </Border>
              </StackPanel>
            </Grid>

            <!-- Cuerpo scrolleable -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="10,0,10,2">

                <!-- ═══════════ PASO 1 · CONFIGURAR ═══════════ -->
                <StackPanel Visibility="{Binding IsConfigureStep, Converter={StaticResource BoolToVisibility}}">

                  <!-- 1 · Paquete sugerido -->
                  <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
                    <StackPanel>
                      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectNum}">
                              <TextBlock Text="1" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                                         Foreground="{DynamicResource Brush.Blue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Paquete sugerido" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="Aplica una combinación de documentos al instante."
                                     FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
                        </StackPanel>
                      </Border>

                      <Border Padding="10,7">
                        <UniformGrid Columns="4">
                          <!-- Dossier Ejecutivo -->
                          <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Dossier" Margin="0,0,8,0">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Dossier">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter Property="Effect">
                                      <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                                      </Setter.Value>
                                    </Setter>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.BlueSoft}">
                                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                             Foreground="{DynamicResource Brush.Blue}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Dossier Ejecutivo" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Blue}"
                                        Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Dossier}">
                                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                             Foreground="{DynamicResource Brush.White}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                              <TextBlock Text="Portada dual, carta de oferta, resumen ejecutivo con gráfico de costos e itemizado valorizado."
                                         FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                                         TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                          </Button>

                          <!-- Mandante -->
                          <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Mandante" Margin="0,0,8,0"
                                  ToolTip="Oferta PDF + carta DOCX">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Mandante">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter Property="Effect">
                                      <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                                      </Setter.Value>
                                    </Setter>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.BlueSoft}">
                                  <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                             Foreground="{DynamicResource Brush.Blue}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Mandante" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Blue}"
                                        Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Mandante}">
                                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                             Foreground="{DynamicResource Brush.White}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                              <TextBlock Text="Oferta PDF + carta de presentación DOCX para el cliente."
                                         FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                                         TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                          </Button>

                          <!-- Interno -->
                          <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Interno" Margin="0,0,8,0"
                                  ToolTip="Todos los documentos seleccionados">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Interno">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter Property="Effect">
                                      <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                                      </Setter.Value>
                                    </Setter>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.BlueSoft}">
                                  <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                             Foreground="{DynamicResource Brush.Blue}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Interno" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Blue}"
                                        Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Interno}">
                                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                             Foreground="{DynamicResource Brush.White}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                              <TextBlock Text="Todos los documentos seleccionados, para control interno."
                                         FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                                         TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                          </Button>

                          <!-- Banco -->
                          <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Banco"
                                  ToolTip="Oferta PDF + Excel de control">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Banco">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter Property="Effect">
                                      <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                                      </Setter.Value>
                                    </Setter>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.BlueSoft}">
                                  <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                             Foreground="{DynamicResource Brush.Blue}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Banco" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Blue}"
                                        Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Banco}">
                                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                             Foreground="{DynamicResource Brush.White}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                              <TextBlock Text="Oferta PDF + Excel de control para financiamiento."
                                         FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                                         TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                          </Button>
                        </UniformGrid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- 2 · Documentos del paquete -->
                  <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
                    <StackPanel>
                      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <StackPanel Orientation="Horizontal">
                              <Border Style="{StaticResource SectNum}">
                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Blue}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="Documentos del paquete" FontSize="13" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Marca los documentos que se incluirán en la entrega."
                                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.BlueSoft}" Margin="0,0,10,0">
                              <TextBlock Text="{Binding DocumentsSelectionText}" FontSize="11.5" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Blue}" />
                            </Border>
                            <Button Style="{StaticResource Button.Link}" Content="Seleccionar todos"
                                    Command="{Binding SelectAllDocumentsCommand}" Padding="0" FontSize="12" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Border Padding="12,2,12,4">
                        <StackPanel>
                          <!-- Sección 1: Entrega Principal -->
                          <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="6" Padding="8,4" Margin="0,4,0,6">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                         Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <TextBlock Text="DOCUMENTOS PRINCIPALES DE ENTREGA" FontSize="10.5" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                              <TextBlock Text="· Por defecto para el mandante" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                                         VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                          </Border>

                          <ItemsControl ItemsSource="{Binding DocumentSelector.PrimaryDocuments}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Style="{StaticResource DocRow}">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,0"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource Brush.Ink}" />
                                      <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                                                 TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource FmtBadge}" Margin="10,0,0,0">
                                      <TextBlock Text="{Binding FormatHint}" Style="{StaticResource FmtText}" />
                                    </Border>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- Sección 2: Documentos Opcionales -->
                          <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="6" Padding="8,4" Margin="0,12,0,6">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                         Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <TextBlock Text="DOCUMENTOS ADICIONALES Y TÉCNICOS" FontSize="10.5" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                              <TextBlock Text="· Opcionales según necesidad" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                                         VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                          </Border>

                          <ItemsControl ItemsSource="{Binding DocumentSelector.OptionalDocuments}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Style="{StaticResource DocRow}">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,0"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource Brush.Ink}" />
                                      <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                                                 TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource FmtBadge}" Margin="10,0,0,0">
                                      <TextBlock Text="{Binding FormatHint}" Style="{StaticResource FmtText}" />
                                    </Border>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <TextBlock Text="{Binding DeliverySummaryText}" FontSize="11.5"
                                     Foreground="{DynamicResource Brush.Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- 3 · Contenido del documento (pestañas) -->
                  <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
                    <StackPanel>
                      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectNum}">
                              <TextBlock Text="3" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                                         Foreground="{DynamicResource Brush.Blue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Contenido del documento" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="Texto y antecedentes que aparecen en la oferta y la carta."
                                     FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
                        </StackPanel>
                      </Border>
                      <Border Padding="10,7">
                        <delivery:OfferSettingsEditorPanel DataContext="{Binding OfferSettings}"
