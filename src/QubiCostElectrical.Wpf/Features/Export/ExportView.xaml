                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Oferta comercial PDF" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink}" />
                                <TextBlock Text="Portada, alcance, totales y condiciones"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="1" Style="{StaticResource FmtBadge}" Margin="10,0,0,0">
                                <TextBlock Text="PDF" Style="{StaticResource FmtText}" />
                              </Border>
                              <Border Grid.Column="2" Margin="8,0,0,0">
                                <Border.Style>
                                  <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
