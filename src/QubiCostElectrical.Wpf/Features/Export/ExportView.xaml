                                  <Run Text="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource PathFileName}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Hacer clic para agregar" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                           Visibility="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource StringEmptyToVisibility}}" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </UniformGrid>
                      </Border>
                    </StackPanel>
                  </Border>

                </StackPanel>

                <!-- ═══════════ PASO 2 · VISTA PREVIA ═══════════ -->
                <StackPanel Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVisibility}}">

                  <!-- Banner lista -->
                  <Border Margin="0,0,0,10" Padding="16,11"
                          Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                          BorderThickness="1" CornerRadius="10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.GreenSoft}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource Brush.Green}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PreviewStatusText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" />
