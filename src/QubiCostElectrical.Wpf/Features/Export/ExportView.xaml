                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock Text="Viendo" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                              </Border>
                            </Grid>
                          </Button>

                          <Button Command="{Binding PreviewSwitch.SelectCommand}" CommandParameter="OfferPdf">
