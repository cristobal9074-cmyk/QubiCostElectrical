                                <Grid>
                                  <TextBlock Text="FIRMA" FontFamily="{StaticResource Font.Mono}" FontSize="9" FontWeight="Bold"
                                             Foreground="{DynamicResource Brush.White}"
                                             Visibility="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource StringNotEmptyToVisibility}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <TextBlock Text="+" FontSize="14" Foreground="{DynamicResource Brush.Ink3}"
                                             Visibility="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource StringEmptyToVisibility}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                              </Border>
