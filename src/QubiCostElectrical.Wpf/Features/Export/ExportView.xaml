                            <TextBlock Text="Documentos previsualizables" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="Haz clic en un documento para mostrarlo en el panel derecho; se actualiza solo al editar."
