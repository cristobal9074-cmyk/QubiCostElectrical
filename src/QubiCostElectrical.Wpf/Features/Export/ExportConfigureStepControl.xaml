<UserControl x:Class="QubiCostElectrical.Wpf.Features.Export.ExportConfigureStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:delivery="clr-namespace:QubiCostElectrical.Wpf.Features.Delivery">
  <StackPanel>

    <!-- 1 · Paquete sugerido -->
    <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
      <StackPanel>
        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource SectNum}">
                <TextBlock Text="1" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                           Foreground="{DynamicResource Brush.Blue}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Paquete sugerido" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Aplica una combinación de documentos al instante."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
          </StackPanel>
        </Border>

        <Border Padding="10,7">
          <UniformGrid Columns="4">
            <!-- Dossier Ejecutivo -->
            <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Dossier" Margin="0,0,8,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Dossier">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                      <Setter Property="Effect">
                        <Setter.Value>
                          <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                          Background="{DynamicResource Brush.BlueSoft}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource Brush.Blue}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Dossier Ejecutivo" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                  <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.Blue}"
                          Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Dossier}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource Brush.White}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock Text="Portada dual, carta de oferta, resumen ejecutivo con gráfico de costos e itemizado valorizado."
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" LineHeight="14" />
              </StackPanel>
            </Button>

            <!-- Mandante -->
            <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Mandante" Margin="0,0,8,0"
                    ToolTip="Oferta PDF + carta DOCX">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Mandante">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                      <Setter Property="Effect">
                        <Setter.Value>
                          <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                          Background="{DynamicResource Brush.BlueSoft}">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource Brush.Blue}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Mandante" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.Blue}"
                          Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Mandante}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource Brush.White}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock Text="Oferta PDF + carta de presentación DOCX para el cliente."
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" LineHeight="14" />
              </StackPanel>
            </Button>

            <!-- Interno -->
            <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Interno" Margin="0,0,8,0"
                    ToolTip="Todos los documentos seleccionados">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Interno">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                      <Setter Property="Effect">
                        <Setter.Value>
                          <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                          Background="{DynamicResource Brush.BlueSoft}">
                    <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource Brush.Blue}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Interno" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.Blue}"
                          Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Interno}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource Brush.White}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock Text="Todos los documentos seleccionados, para control interno."
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" LineHeight="14" />
              </StackPanel>
            </Button>

            <!-- Banco -->
            <Button Command="{Binding ApplyOfferPresetCommand}" CommandParameter="Banco"
                    ToolTip="Oferta PDF + Excel de control">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PresetCard}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedOfferPreset}" Value="Banco">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                      <Setter Property="Effect">
                        <Setter.Value>
                          <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270" Color="#2563B0" Opacity="0.35" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="7" VerticalAlignment="Center"
                          Background="{DynamicResource Brush.BlueSoft}">
                    <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource Brush.Blue}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Banco" FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.Blue}"
                          Visibility="{Binding SelectedOfferPreset, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=Banco}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource Brush.White}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock Text="Oferta PDF + Excel de control para financiamiento."
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" LineHeight="14" />
              </StackPanel>
            </Button>
          </UniformGrid>
        </Border>
      </StackPanel>
    </Border>

    <!-- 2 · Documentos del paquete -->
    <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
      <StackPanel>
        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SectNum}">
                  <TextBlock Text="2" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                             Foreground="{DynamicResource Brush.Blue}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Documentos del paquete" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Marca los documentos que se incluirán en la entrega."
                         FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.BlueSoft}" Margin="0,0,10,0">
                <TextBlock Text="{Binding DocumentsSelectionText}" FontSize="11.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Blue}" />
              </Border>
              <Button Style="{StaticResource Button.Link}" Content="Seleccionar todos"
                      Command="{Binding SelectAllDocumentsCommand}" Padding="0" FontSize="12" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Padding="12,2,12,4">
          <StackPanel>
            <!-- Sección 1: Entrega Principal -->
            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="6" Padding="8,4" Margin="0,4,0,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="DOCUMENTOS PRINCIPALES DE ENTREGA" FontSize="10.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                <TextBlock Text="· Por defecto para el mandante" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding DocumentSelector.PrimaryDocuments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource DocRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Style="{StaticResource FmtBadge}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding FormatHint}" Style="{StaticResource FmtText}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sección 2: Documentos Opcionales -->
            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="6" Padding="8,4" Margin="0,12,0,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="DOCUMENTOS ADICIONALES Y TÉCNICOS" FontSize="10.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                <TextBlock Text="· Opcionales según necesidad" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding DocumentSelector.OptionalDocuments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource DocRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Style="{StaticResource FmtBadge}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding FormatHint}" Style="{StaticResource FmtText}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding DeliverySummaryText}" FontSize="11.5"
                       Foreground="{DynamicResource Brush.Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- 3 · Contenido del documento (pestañas) -->
    <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
      <StackPanel>
        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource SectNum}">
                <TextBlock Text="3" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                           Foreground="{DynamicResource Brush.Blue}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Contenido del documento" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Texto y antecedentes que aparecen en la oferta y la carta."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
          </StackPanel>
        </Border>
        <Border Padding="10,7">
          <delivery:OfferSettingsEditorPanel DataContext="{Binding OfferSettings}"
                                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>
      </StackPanel>
    </Border>

    <!-- 4 · Membretes y firmas -->
    <Border Style="{StaticResource Sect}" Margin="0,0,0,6">
      <StackPanel>
        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SectNum}">
                  <TextBlock Text="4" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                             Foreground="{DynamicResource Brush.Blue}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Membretes y firmas" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" Margin="9,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Imágenes que encabezan y firman los documentos."
                         FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="29,1,0,0" />
              <TextBlock Text="{Binding OfferSettings.DefaultsHint}" FontSize="10.5"
                         Foreground="{DynamicResource Brush.Green}" Margin="29,3,0,0"
                         Visibility="{Binding OfferSettings.DefaultsHint, Converter={StaticResource StringNotEmptyToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" FontSize="11.5" Padding="10,6"
                    VerticalAlignment="Top" Margin="10,0,0,0"
                    Content="Guardar para todos los proyectos"
                    ToolTip="Copia el membrete, logos y firma de este proyecto a las preferencias globales; los proyectos futuros sin estos datos los usarán automáticamente."
                    Command="{Binding OfferSettings.SaveAsDefaultsCommand}" />
          </Grid>
        </Border>

        <Border Padding="10,7">
          <UniformGrid Columns="3">
            <!-- Logo contratista -->
            <Button Style="{StaticResource Tile}" Command="{Binding PickLogoCommand}" Margin="0,0,8,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="32" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,11,0"
                        Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OfferSettings.LogoPath}" Value="">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OfferSettings.LogoPath}" Value="{x:Null}">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <TextBlock Text="LOGO" FontFamily="{StaticResource Font.Mono}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.White}"
                               Visibility="{Binding OfferSettings.LogoPath, Converter={StaticResource StringNotEmptyToVisibility}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="+" FontSize="14" Foreground="{DynamicResource Brush.Ink3}"
                               Visibility="{Binding OfferSettings.LogoPath, Converter={StaticResource StringEmptyToVisibility}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Logo contratista" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                             TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding OfferSettings.LogoPath}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding OfferSettings.LogoPath}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding OfferSettings.LogoPath, Converter={StaticResource PathFileName}, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="Hacer clic para agregar" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                             Visibility="{Binding OfferSettings.LogoPath, Converter={StaticResource StringEmptyToVisibility}}" />
                </StackPanel>
              </Grid>
            </Button>

            <!-- Logo mandante -->
            <Button Style="{StaticResource Tile}" Command="{Binding PickClientLogoCommand}" Margin="0,0,8,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="32" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,11,0"
                        Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OfferSettings.ClientLogoPath}" Value="">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OfferSettings.ClientLogoPath}" Value="{x:Null}">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <TextBlock Text="LOGO" FontFamily="{StaticResource Font.Mono}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.White}"
                               Visibility="{Binding OfferSettings.ClientLogoPath, Converter={StaticResource StringNotEmptyToVisibility}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="+" FontSize="14" Foreground="{DynamicResource Brush.Ink3}"
                               Visibility="{Binding OfferSettings.ClientLogoPath, Converter={StaticResource StringEmptyToVisibility}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Logo mandante" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                             TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding OfferSettings.ClientLogoPath}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding OfferSettings.ClientLogoPath}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding OfferSettings.ClientLogoPath, Converter={StaticResource PathFileName}, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="Opcional — hacer clic para agregar" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                             Visibility="{Binding OfferSettings.ClientLogoPath, Converter={StaticResource StringEmptyToVisibility}}" />
                </StackPanel>
              </Grid>
            </Button>

            <!-- Firma autorizada -->
            <Button Style="{StaticResource Tile}" Command="{Binding PickSignatureCommand}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="32" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,11,0"
                        Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="{x:Null}">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <TextBlock Text="FIRMA" FontFamily="{StaticResource Font.Mono}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.White}"
                               Visibility="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource StringNotEmptyToVisibility}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="+" FontSize="14" Foreground="{DynamicResource Brush.Ink3}"
                               Visibility="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource StringEmptyToVisibility}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Firma autorizada" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0"
                             TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding OfferSettings.SignatureImagePath}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource PathFileName}, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="Hacer clic para agregar" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                             Visibility="{Binding OfferSettings.SignatureImagePath, Converter={StaticResource StringEmptyToVisibility}}" />
                </StackPanel>
              </Grid>
            </Button>
          </UniformGrid>
        </Border>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
