<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectCommercialDataControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel><TextBlock Text="Condiciones comerciales" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold"/><TextBlock Text="Parámetros que mueven el total de venta y la ficha." FontSize="{StaticResource Font.Size.base}" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16"/><UniformGrid Columns="3" Margin="0,0,0,14"><Border Style="{StaticResource Card.Kpi}"><StackPanel><TextBlock Text="GASTOS GENERALES" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,6"/><TextBlock Text="{Binding GastosGeneralesKpi}" Style="{StaticResource Text.KpiValue}" Foreground="{DynamicResource Brush.Blue}"/></StackPanel></Border><Border Style="{StaticResource Card.Kpi}"><StackPanel><TextBlock Text="UTILIDAD" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,6"/><TextBlock Text="{Binding UtilidadKpi}" Style="{StaticResource Text.KpiValue}" Foreground="{DynamicResource Brush.Blue}"/></StackPanel></Border><Border Style="{StaticResource Card.Kpi}"><StackPanel><TextBlock Text="IVA" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,6"/><TextBlock Text="{Binding IvaKpi}" Style="{StaticResource Text.KpiValue}" Foreground="{DynamicResource Brush.Blue}"/></StackPanel></Border></UniformGrid>
   <Border Style="{StaticResource ProjectCard}"><StackPanel><TextBlock Text="MONEDA E INDICADORES" Style="{StaticResource ProjectCardTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MONEDA BASE" Style="{StaticResource Form.Label}"/><ComboBox SelectedValue="{Binding MonedaPresupuesto}" SelectedValuePath="Content" Style="{StaticResource Form.ComboBox}"><ComboBoxItem Content="UF"/><ComboBoxItem Content="CLP"/><ComboBoxItem Content="USD"/><ComboBoxItem Content="EUR"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="VALOR UF (CLP)" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding ValorUfClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="TIPO CAMBIO USD" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding TipoCambioUsdText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="TIPO CAMBIO EUR" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding TipoCambioEurText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/></StackPanel></Grid></StackPanel></Border>
   <Border Style="{StaticResource ProjectCard}"><StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="MÁRGENES Y SUPERFICIE" Style="{StaticResource ProjectCardTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0"/><Button DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding ApplyPreferencesDefaultsCommand}" Style="{StaticResource Button.Secondary}" Padding="6,2" FontSize="11" Height="24" ToolTip="Restaura los porcentajes de GG y Utilidad según los valores predeterminados guardados en Preferencias" Content="&#x21BA; Usar Preferencias"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GASTOS GENERALES %" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding GastosGeneralesText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/><TextBlock Text="IVA %" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding IvaPctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/><TextBlock Text="SUPERFICIE TOTAL (M²)" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding MetrosCuadradosText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="UTILIDAD %" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding UtilidadText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/><TextBlock Text="VALIDEZ OFERTA (DÍAS)" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding ValidityDaysText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}"/></StackPanel></Grid><CheckBox Content="Ocultar Gastos Generales y Utilidad en el resumen (mostrar precios enteros en partidas)" IsChecked="{Binding OcultarGgYUtilidadEnResumen}" Margin="0,10,0,0"/></StackPanel></Border>
 </StackPanel>
</UserControl>
