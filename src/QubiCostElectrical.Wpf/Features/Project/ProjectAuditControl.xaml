<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectAuditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Actividad del archivo" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold" Margin="0,0,0,4" />
    <TextBlock Text="Quién abrió, guardó o editó este .qce."
               FontSize="{StaticResource Font.Size.base}" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />
    <Border Style="{StaticResource ProjectCard}">
      <StackPanel>
        <TextBlock Text="HISTORIAL RECIENTE" Style="{StaticResource ProjectCardTitle}" />
        <ItemsControl ItemsSource="{Binding AuditEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,0" MinHeight="56">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Línea vertical continua de timeline (estilo Linear / GitHub) -->
                <Rectangle Grid.Column="0" Width="2" Fill="{DynamicResource Brush.Line}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- Avatar con Iniciales del Usuario -->
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                      <Setter Property="BorderThickness" Value="1.5" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApertura}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGuardado}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding UserInitials}" FontSize="9.5" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsApertura}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsGuardado}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>

                <!-- Contenido del Evento -->
                <StackPanel Grid.Column="1" Margin="10,2,14,14">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <!-- Badge Tipo de Acción -->
                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsApertura}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGuardado}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding ActionCategory}" FontSize="9" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsApertura}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsGuardado}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding Action}" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                  </StackPanel>

                  <TextBlock FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Ink4}">
                    <Run Text="{Binding UserDisplayName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                    <Run Text=" · " />
                    <Run Text="{Binding MachineName, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Ink3}"
                             TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Fecha / Hora -->
                <TextBlock Grid.Column="2" Text="{Binding OccurredAtLabel}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Top" Margin="0,5,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
