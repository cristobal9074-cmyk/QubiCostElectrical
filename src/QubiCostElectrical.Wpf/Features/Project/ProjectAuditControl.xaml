<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectAuditControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><TextBlock Text="Actividad del archivo" FontSize="18" FontWeight="Bold"/><TextBlock Text="Quién abrió, guardó o editó este proyecto." FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16"/><Border Style="{StaticResource ProjectCard}"><StackPanel><TextBlock Text="HISTORIAL RECIENTE" Style="{StaticResource ProjectCardTitle}"/><ItemsControl ItemsSource="{Binding AuditEntries}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Blue}" Margin="0,4,0,0"/><StackPanel Grid.Column="1" Margin="12,0,12,0"><TextBlock Text="{Binding Action}" FontSize="13" FontWeight="SemiBold"/><TextBlock FontSize="12" Foreground="{DynamicResource Brush.Ink3}"><Run Text="{Binding UserDisplayName}"/><Run Text=" · "/><Run Text="{Binding MachineName}"/></TextBlock><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding OccurredAtLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink4}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></UserControl>
