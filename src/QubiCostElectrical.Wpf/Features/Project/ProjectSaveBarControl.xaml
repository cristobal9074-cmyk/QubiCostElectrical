<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectSaveBarControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Margin="20,0,20,14" CornerRadius="10" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Padding="14,10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button AutomationProperties.Name="Descartar" Style="{StaticResource Button.Secondary}" Content="Descartar" Command="{Binding CancelCommand}" Height="30" Padding="12,0" Margin="0,0,6,0"/><Button AutomationProperties.Name="Aplicar cambios" Style="{StaticResource Button.Primary}" Content="Aplicar cambios" Command="{Binding SaveCommand}" Height="30" Padding="14,0"/></StackPanel><TextBlock Text="Cambios pendientes de aplicar al proyecto" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border></UserControl>
