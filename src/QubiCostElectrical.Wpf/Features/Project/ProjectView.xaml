<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Project"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <!-- Estilo Inspector Label: alineacion fija de etiquetas estilo AutoCAD / Xcode -->
    <Style x:Key="Inspector.Label" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- Overlay de carga / Estado vacío -->
    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando proyecto…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            d:Visibility="Collapsed"
                            IconData="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para editar datos generales, parámetros comerciales y alcance.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <!-- Interfaz de Proyecto Activo -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
          Background="{DynamicResource Brush.Canvas}">
      <Grid.RowDefinitions>
        <!-- Fila 0: Header Ejecutivo Superior -->
        <RowDefinition Height="Auto" />
        <!-- Fila 1: Cuerpo con Sidebar a la Izquierda y Workspace a la Derecha -->
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- HEADER EJECUTIVO (Compacto, Prolijo, Nivel Enterprise)           -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <local:ProjectHeaderControl Grid.Row="0" />

      <!-- ══════════════════════════════════════════════════════════════════ -->
      <!-- CUERPO PRINCIPAL: SIDEBAR IZQUIERDO + WORKSPACE                  -->
      <!-- ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="1" Background="{DynamicResource Brush.Canvas}">
        <Grid.ColumnDefinitions>
          <!-- Columna 0: Menú Lateral (Sidebar de Secciones Pro) -->
          <ColumnDefinition Width="220" />
          <!-- Columna 1: Contenido de la Sección Seleccionada -->
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── SIDEBAR LATERAL IZQUIERDO (Estilo Linear / macOS) ──────────── -->
        <local:ProjectNavigationRailControl Grid.Column="0" />

        <!-- ── WORKSPACE DE CONTENIDO (Scrollable, Aireado, Alta Densidad) ── -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,32">
          <StackPanel HorizontalAlignment="Stretch">

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- SECCIÓN 1: PROYECTO & FINANZAS                                 -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <StackPanel Visibility="{Binding IsSectionProyectoFinanzas, Converter={StaticResource BoolToVisibility}}">

              <!-- COCKPIT FINANCIERO EJECUTIVO (4 Columnas Balanceadas, Sin Emojis) -->
              <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.15*" />
                  </Grid.ColumnDefinitions>

                  <!-- KPI 1: Factor Markup -->
                  <StackPanel Grid.Column="0" Margin="4,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                      <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"
                                 Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                      <TextBlock Text="FACTOR MARKUP" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding MarkupRatioText}" FontSize="18" FontWeight="Bold"
                                FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Blue}" />
                    <TextBlock Text="{Binding MarkupSubtext}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,1,0,0" />
                  </StackPanel>

                  <Rectangle Grid.Column="1" Fill="{DynamicResource Brush.Line}" Margin="0,2" />

                  <!-- KPI 2: Valor Referencial UF -->
                  <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                      <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"
                                 Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <TextBlock Text="PARIDAD UF OFICIAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ValorUfClpDisplay}" FontSize="18" FontWeight="Bold"
                                FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Banco de Precios activo" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,1,0,0" />
                  </StackPanel>

                  <Rectangle Grid.Column="3" Fill="{DynamicResource Brush.Line}" Margin="0,2" />

                  <!-- KPI 3: Superficie Construida (Sin Texto Cortado) -->
                  <StackPanel Grid.Column="4" Margin="12,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                      <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"
                                 Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <TextBlock Text="SUPERFICIE TOTAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SuperficieM2Formatted}" FontSize="18" FontWeight="Bold"
                                FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Área construida para ratios" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,1,0,0" />
                  </StackPanel>

                  <Rectangle Grid.Column="5" Fill="{DynamicResource Brush.Line}" Margin="0,2" />

                  <!-- KPI 4: Selector Rápido de Estado -->
                  <StackPanel Grid.Column="6" Margin="12,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"
                                 Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <TextBlock Text="ESTADO DEL PRESUPUESTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="2">
                      <UniformGrid Columns="3">
                        <Button Content="Borrador" Command="{Binding SetEstadoCommand}" CommandParameter="Borrador" Margin="1">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstadoBorrador}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                  <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="En revisión" Command="{Binding SetEstadoCommand}" CommandParameter="En revisión" Margin="1">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstadoEnRevision}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                  <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button Content="Aprobado" Command="{Binding SetEstadoCommand}" CommandParameter="Aprobado" Margin="1">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEstadoAprobado}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                  <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </UniformGrid>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- GRID PRINCIPAL DE 2 COLUMNAS (OBRA & MANDANTE vs MOTOR MONETARIO) -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── COLUMNA 1: OBRA Y MANDANTE ── -->
                <Border Grid.Column="0" Style="{StaticResource ProCard}">
                  <StackPanel>
                    <!-- Cabecera de Tarjeta -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.Surface2}"
                              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,8,0">
                        <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="DATOS DE LA OBRA &amp; MANDANTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Inspector Layout: Filas con etiqueta alineada a 120px -->
                    <!-- 1. Nombre de la Obra / Proyecto -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Nombre proyecto" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="100" />
                    </Grid>

                    <!-- 2. Mandante / Cliente -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Mandante / Cliente" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="80" />
                    </Grid>

                    <!-- 2. Tipo de Instalacion SEC -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Instalaci&#243;n SEC" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding TipoProyecto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="60" />
                    </Grid>

                    <!-- 3. Direccion o Ubicacion Geografica -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Ubicaci&#243;n obra" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="120" />
                    </Grid>

                    <!-- 4. Superficie Construida (m2) -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Superficie (m&#178;)" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding SuperficieM2Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                    </Grid>

                    <!-- 5. Validez de la Oferta (dias) -->
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Validez (d&#237;as)" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding ValidezOfertaDiasText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                    </Grid>

                    <!-- Footer Metadatos Inline y Limpio -->
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="ID / CÓDIGO INTERNO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                          <TextBlock Text="{Binding CodigoPresupuestoDisplay, FallbackValue='PEL-AUTO'}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink2}" Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                          <TextBlock Text="ÚLTIMA MODIFICACIÓN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding FechaModificacionLabel}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,1,0,0" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- ── COLUMNA 2: MOTOR MONETARIO Y MÁRGENES ── -->
                <Border Grid.Column="2" Style="{StaticResource ProCard}">
                  <StackPanel>
                    <!-- Cabecera de Tarjeta -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.BlueSoft}"
                              BorderBrush="{DynamicResource Brush.BlueIconBg2}" BorderThickness="1" Margin="0,0,8,0">
                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="MOTOR FINANCIERO, MONEDA &amp; MÁRGENES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Selector de Moneda Base -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Moneda base" Style="{StaticResource Inspector.Label}" />
                      <Border Grid.Column="1" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <UniformGrid Columns="4">
                          <Button Content="CLP ($)" Command="{Binding SelectMonedaCommand}" CommandParameter="CLP" Margin="1">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMonedaClp}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Content="UF" Command="{Binding SelectMonedaCommand}" CommandParameter="UF" Margin="1">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMonedaUf}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Content="USD (US$)" Command="{Binding SelectMonedaCommand}" CommandParameter="USD" Margin="1">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMonedaUsd}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button Content="EUR (&#8364;)" Command="{Binding SelectMonedaCommand}" CommandParameter="EUR" Margin="1">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource ProSegBtn}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMonedaEur}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </UniformGrid>
                      </Border>
                    </Grid>

                    <!-- Paridad UF -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Valor UF ($)" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding ValorUfText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                    </Grid>

                    <!-- Paridades Dolar y Euro -->
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="D&#243;lar ($)" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="1" Text="{Binding ValorDolarText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                      <TextBlock Grid.Column="3" Text="Euro ($)" Style="{StaticResource Inspector.Label}" />
                      <TextBox Grid.Column="4" Text="{Binding ValorEuroText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                    </Grid>

                    <!-- Margenes Operacionales -->
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                      <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                          <TextBlock Text="M&#193;RGENES OPERACIONALES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                          <TextBlock DockPanel.Dock="Right" Text="{Binding MarkupRatioText, StringFormat='{}Markup Multiplicador: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- Gastos Generales -->
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="Gastos Generales" Style="{StaticResource Inspector.Label}" />
                          <TextBox Grid.Column="1" Text="{Binding PorcentajeGastosGeneralesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Utilidad Neta -->
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="Utilidad Neta" Style="{StaticResource Inspector.Label}" />
                          <TextBox Grid.Column="1" Text="{Binding PorcentajeUtilidadText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
                        </Grid>

                        <!-- IVA, Riesgo, Descuento -->
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="IVA (%)" Style="{StaticResource Inspector.Label}" />
                          <TextBox Grid.Column="1" Text="{Binding PorcentajeIvaText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                          <TextBlock Grid.Column="3" Text="Riesgo" Style="{StaticResource Inspector.Label}" />
                          <TextBox Grid.Column="4" Text="{Binding PorcentajeRiesgoText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                          <TextBlock Grid.Column="6" Text="Desc. %" Style="{StaticResource Inspector.Label}" />
                          <TextBox Grid.Column="7" Text="{Binding PorcentajeDescuentoText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" />
                        </Grid>

                        <!-- Live Formula Chip -->
                        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="F&#243;rmula: Precio Venta = Costo Directo &#215; (1 + GG%) &#215; (1 + Util%)"
                                       FontSize="10" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <CheckBox Style="{StaticResource Form.CheckBox}"
                              Content="Desglosar GG y Utilidad en cuadro resumen de oferta"
                              IsChecked="{Binding MostrarDetalleGgUtilidad, Mode=TwoWay}"
                              ToolTip="Si se desmarca, el resumen de oferta agrupa el margen en una sola línea de Venta Neta" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- PARÁMETROS AVANZADOS DE COSTEO (COLAPSABLE / EXPANDER ELEGANTE) -->
              <Expander IsExpanded="True" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Margin="0,0,0,12">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                    <TextBlock Text="PARÁMETROS AVANZADOS DEL MOTOR DE COSTEO &amp; MODELO COMERCIAL" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                  </StackPanel>
                </Expander.Header>
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="16,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Origen y Modelo de Precios -->
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="MODELO DE CÁLCULO DE COSTO DIRECTO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,8" />

                      <UniformGrid Columns="1">
                        <!-- Opción 1: Lista de Materiales / Cubicación Directa -->
                        <RadioButton GroupName="PricingModelGroup" IsChecked="{Binding IsPricingModelDirect, Mode=TwoWay}" Margin="0,0,0,6">
                          <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                              <Border x:Name="OptBorder" CornerRadius="8" BorderThickness="1" Padding="12,10"
                                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" Cursor="Hand">
                                <DockPanel LastChildFill="True">
                                  <RadioButton IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                  <StackPanel>
                                    <TextBlock Text="Cubicación Directa + Banco de Precios (Recomendado)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                                    <TextBlock Text="Calcula costos según cantidades medidas de materiales y rendimiento de mano de obra." FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="OptBorder" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                  <Setter TargetName="OptBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </RadioButton.Template>
                        </RadioButton>

                        <!-- Opción 2: Catálogo APU Obligatorio -->
                        <RadioButton GroupName="PricingModelGroup" IsChecked="{Binding IsPricingModelApu, Mode=TwoWay}" Margin="0,0,0,6">
                          <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                              <Border x:Name="OptBorder" CornerRadius="8" BorderThickness="1" Padding="12,10"
                                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" Cursor="Hand">
                                <DockPanel LastChildFill="True">
                                  <RadioButton IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                  <StackPanel>
                                    <TextBlock Text="Análisis de Precios Unitarios (APU) Riguroso" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                                    <TextBlock Text="Exige desglose de cada partida en Mano de Obra, Materiales, Equipos y Subcontratos." FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="OptBorder" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                  <Setter TargetName="OptBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </RadioButton.Template>
                        </RadioButton>

                        <!-- Opción 3: Híbrido / Mixto -->
                        <RadioButton GroupName="PricingModelGroup" IsChecked="{Binding IsPricingModelHybrid, Mode=TwoWay}">
                          <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                              <Border x:Name="OptBorder" CornerRadius="8" BorderThickness="1" Padding="12,10"
                                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" Cursor="Hand">
                                <DockPanel LastChildFill="True">
                                  <RadioButton IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                  <StackPanel>
                                    <TextBlock Text="Modo Mixto / Híbrido" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                                    <TextBlock Text="Permite partidas con APU y partidas por cubicación de lista de materiales simultáneamente." FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="OptBorder" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                  <Setter TargetName="OptBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </RadioButton.Template>
                        </RadioButton>
                      </UniformGrid>
                    </StackPanel>

                    <!-- Modelo Comercial -->
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="POLÍTICA DE CIERRE &amp; REDONDEO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,8" />
                      <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                          <CheckBox Style="{StaticResource Form.CheckBox}"
                                    Content="Redondear totales en UF a 2 decimales en el reporte final"
                                    IsChecked="{Binding RedondearTotalesUf, Mode=TwoWay}"
                                    Margin="0,0,0,8" />
                          <CheckBox Style="{StaticResource Form.CheckBox}"
                                    Content="Ajustar centavos en pesos chilenos al entero más cercano"
                                    IsChecked="{Binding AjustarEnterosClp, Mode=TwoWay}"
                                    Margin="0,0,0,8" />
                          <CheckBox Style="{StaticResource Form.CheckBox}"
                                    Content="Congelar factores de mano de obra ante variaciones de UF"
                                    IsChecked="{Binding CongelarFactoresMo, Mode=TwoWay}"
                                    Margin="0,0,0,8" />
                          <CheckBox Style="{StaticResource Form.CheckBox}"
                                    Content="Exigir validación SEC previa a la emisión de dossier"
                                    IsChecked="{Binding ExigirValidacionSec, Mode=TwoWay}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </Expander>

            </StackPanel>

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- SECCIÓN 2: RESPONSABLE                                         -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <local:ProjectTeamControl />

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- SECCIÓN 3: ALCANCE & EXCLUSIONES                               -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <local:ProjectScopeControl />

            <!-- ───────────────────────────────────────────────────────────── -->
            <!-- SECCIÓN 4: ACTIVIDAD & AUDITORÍA                               -->
            <!-- ───────────────────────────────────────────────────────────── -->
            <local:ProjectAuditControl />

            <!-- Resumen de Validación si aplica -->
            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Danger}" FontSize="11" FontWeight="SemiBold"
                       Visibility="{Binding ValidationSummary, Converter={StaticResource StringNotEmptyToVisibility}}" />
          </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- FLOATING SAVE BAR (Compacta, Elevada, Estilo Linear / Raycast)    -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <local:ProjectSaveBarControl Grid.Column="1" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
