<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1180">
  <UserControl.Resources>
    <Style x:Key="ProjectRailItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line2}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProjectRailItemActive" TargetType="Button" BasedOn="{StaticResource ProjectRailItem}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{DynamicResource Brush.BlueSoft}"
                    BorderBrush="{DynamicResource Brush.Blue}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="Transparent" />
              </Border.Effect>
              <Grid>
                <Border Width="3" HorizontalAlignment="Left" Margin="-10,0,0,0"
                        Background="{DynamicResource Brush.Blue}" CornerRadius="2" />
                <ContentPresenter />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProjectPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="ProjectCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="ProjectCardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="EstadoSegBtn" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            d:Visibility="Collapsed"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para editar datos generales, parámetros comerciales y alcance.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
          d:Visibility="Visible">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Page header — fiel al HTML proyecto-datos-20b -->
      <Border Grid.Row="0"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="0,0,0,1"
              Padding="22,18,22,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="DATOS DEL PROYECTO"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Ink3}"
                       Margin="0,0,0,6" />

            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="20" FontWeight="Bold"
                     BorderThickness="0,0,0,2"
                     Background="Transparent"
                     Padding="0,2"
                     MaxLength="120"
                     CaretBrush="{DynamicResource Brush.Blue}"
                     ToolTip="Nombre del proyecto">
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="BorderBrush" Value="Transparent" />
                  <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Border CornerRadius="999" Padding="10,5" Margin="0,0,8,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEstadoEnRevision}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsEstadoAprobado}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Ink3}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEstadoEnRevision}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Amber}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsEstadoAprobado}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding EstadoPresupuesto}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEstadoEnRevision}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsEstadoAprobado}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>

              <Border CornerRadius="999" Padding="10,5" Margin="0,0,8,0"
                      Background="{DynamicResource Brush.BlueSoft}">
                <TextBlock Text="{Binding MonedaChip}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
              </Border>

              <Border CornerRadius="999" Padding="10,5" Margin="0,0,8,0"
                      Background="{DynamicResource Brush.Line2}">
                <TextBlock Text="{Binding ClienteChip}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
              </Border>

              <Border CornerRadius="999" Padding="10,5">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Amber}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Sin cambios pendientes" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                            <Setter Property="Text" Value="Cambios sin aplicar" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
              <TextBlock Text="ARCHIVO QCE · " Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{Binding ArchivoProyectoShortLabel, Mode=OneWay}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
              <TextBlock Text="  ·  Última modificación: " Style="{StaticResource Text.Caption}" Margin="12,0,0,0" />
              <TextBlock Text="{Binding FechaModificacionLabel, Mode=OneWay}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource Button.Secondary}" Content="Generar ficha PDF"
                    Command="{Binding GenerateFichaPdfCommand}"
                    Height="36" Padding="13,0" Margin="0,0,8,0" FontSize="12.5" />
            <Button Content="Aplicar cambios" Command="{Binding SaveCommand}"
                    Height="36" Padding="16,0" FontSize="12.5" FontWeight="SemiBold"
                    Foreground="White" BorderThickness="0" Background="#1B6EF3">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                          Padding="{TemplateBinding Padding}">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="#1B6EF3" />
                    </Border.Effect>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="White" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#1559D1" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Body: rail + panel -->
      <Grid Grid.Row="1" Background="{DynamicResource Brush.Canvas}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,1,0"
                Padding="10,14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="SECCIONES"
                       FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink4}"
                       Margin="10,4,10,10" />
            <TextBlock DockPanel.Dock="Bottom"
                       Text="Lo esencial primero. Comercial y auditoría no compiten con el nombre del proyecto."
                       FontSize="11" Foreground="{DynamicResource Brush.Ink4}"
                       TextWrapping="Wrap" Margin="10,16,10,4"
                       Padding="0,12,0,0" />

            <StackPanel>
              <!-- Identidad -->
              <Button Command="{Binding SelectSectionCommand}" CommandParameter="identidad" Padding="10,9" Margin="0,2">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ProjectRailItem}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSectionIdentidad}" Value="True">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}"
                                      BorderThickness="1" CornerRadius="10" Padding="10,9">
                                <Grid>
                                  <Border Width="3" HorizontalAlignment="Left" Margin="-10,-9,0,-9" Background="{DynamicResource Brush.Blue}" />
                                  <ContentPresenter />
                                </Grid>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.Line2}">
                    <TextBlock Text="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Identidad" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                    <TextBlock Text="Nombre, cliente, obra" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Comercial -->
              <Button Command="{Binding SelectSectionCommand}" CommandParameter="comercial" Padding="10,9" Margin="0,2">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ProjectRailItem}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSectionComercial}" Value="True">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}"
                                      BorderThickness="1" CornerRadius="10" Padding="10,9">
                                <Grid>
                                  <Border Width="3" HorizontalAlignment="Left" Margin="-10,-9,0,-9" Background="{DynamicResource Brush.Blue}" />
                                  <ContentPresenter />
                                </Grid>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.Line2}">
                    <TextBlock Text="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Comercial" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                    <TextBlock Text="Moneda, GG, utilidad" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Equipo -->
              <Button Command="{Binding SelectSectionCommand}" CommandParameter="equipo" Padding="10,9" Margin="0,2">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ProjectRailItem}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSectionEquipo}" Value="True">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}"
                                      BorderThickness="1" CornerRadius="10" Padding="10,9">
                                <Grid>
                                  <Border Width="3" HorizontalAlignment="Left" Margin="-10,-9,0,-9" Background="{DynamicResource Brush.Blue}" />
                                  <ContentPresenter />
                                </Grid>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.Line2}">
                    <TextBlock Text="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Responsable" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                    <TextBlock Text="Estimador y rol" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Alcance -->
              <Button Command="{Binding SelectSectionCommand}" CommandParameter="alcance" Padding="10,9" Margin="0,2">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ProjectRailItem}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSectionAlcance}" Value="True">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}"
                                      BorderThickness="1" CornerRadius="10" Padding="10,9">
                                <Grid>
                                  <Border Width="3" HorizontalAlignment="Left" Margin="-10,-9,0,-9" Background="{DynamicResource Brush.Blue}" />
                                  <ContentPresenter />
                                </Grid>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.Line2}">
                    <TextBlock Text="4" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Alcance" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                    <TextBlock Text="Incluye / excluye" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Auditoría -->
              <Button Command="{Binding SelectSectionCommand}" CommandParameter="auditoria" Padding="10,9" Margin="0,2">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ProjectRailItem}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSectionAuditoria}" Value="True">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}"
                                      BorderThickness="1" CornerRadius="10" Padding="10,9">
                                <Grid>
                                  <Border Width="3" HorizontalAlignment="Left" Margin="-10,-9,0,-9" Background="{DynamicResource Brush.Blue}" />
                                  <ContentPresenter />
                                </Grid>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.Line2}">
                    <TextBlock Text="◎" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink3}" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Actividad" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                    <TextBlock Text="Auditoría del archivo" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
                  </StackPanel>
                </Grid>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Panel -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,88">
          <StackPanel>

            <!-- IDENTIDAD -->
            <StackPanel Visibility="{Binding IsSectionIdentidad, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Identidad" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="Lo que aparece en portadas, cartas y ficha PDF."
                         FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />

              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="OBRA Y MANDANTE" Style="{StaticResource ProjectCardTitle}" />
                  <TextBlock Text="NOMBRE DEL PROYECTO" Style="{StaticResource Form.Label}" />
                  <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="120" Margin="0,0,0,12" />
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="CLIENTE / MANDANTE" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="120" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="TIPO DE PROYECTO" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding TipoProyecto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="80" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="UBICACIÓN DE LA OBRA" Style="{StaticResource Form.Label}" />
                  <TextBox Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="200" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="ESTADO DEL PRESUPUESTO" Style="{StaticResource ProjectCardTitle}" />
                  <Border Background="{DynamicResource Brush.Line2}" CornerRadius="10" Padding="3">
                    <UniformGrid Columns="3">
                      <Button Content="Borrador" Command="{Binding SetEstadoCommand}" CommandParameter="Borrador" Margin="2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource EstadoSegBtn}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEstadoBorrador}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button Content="En revisión" Command="{Binding SetEstadoCommand}" CommandParameter="En revisión" Margin="2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource EstadoSegBtn}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEstadoEnRevision}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button Content="Aprobado" Command="{Binding SetEstadoCommand}" CommandParameter="Aprobado" Margin="2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource EstadoSegBtn}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEstadoAprobado}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </UniformGrid>
                  </Border>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="FECHA CREACIÓN" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding FechaCreacionLabel, Mode=OneWay}" Style="{StaticResource Form.TextBox}" IsReadOnly="True"
                               Background="{DynamicResource Brush.Surface2}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="ÚLTIMA MODIFICACIÓN" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding FechaModificacionLabel, Mode=OneWay}" Style="{StaticResource Form.TextBox}" IsReadOnly="True"
                               Background="{DynamicResource Brush.Surface2}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="ARCHIVO LOCAL" Style="{StaticResource Form.Label}" Margin="0,12,0,0" />
                  <TextBox Text="{Binding ArchivoProyectoLabel, Mode=OneWay}" Style="{StaticResource Form.TextBox}" IsReadOnly="True"
                           Background="{DynamicResource Brush.Surface2}" TextWrapping="NoWrap"
                           ToolTip="{Binding ArchivoProyectoLabel}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- COMERCIAL -->
            <StackPanel Visibility="{Binding IsSectionComercial, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Condiciones comerciales" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="Parámetros que mueven el total de venta y la ficha."
                         FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />

              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="MODELO COMERCIAL DEL PROYECTO" Style="{StaticResource ProjectCardTitle}" />
                  <TextBlock Text="Estándar para partidas nuevas. Las partidas ya valorizadas conservan su cálculo; las excepciones se gestionan por partida."
                             Foreground="{DynamicResource Brush.Ink3}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                  <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding SetCommercialModelCommand}" CommandParameter="ApuDirectCostWithCommercialFactors" Content="APU / costo directo" Margin="0,0,5,0" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding SetCommercialModelCommand}" CommandParameter="UnitPrice" Content="Precio unitario" Margin="2,0" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding SetCommercialModelCommand}" CommandParameter="LumpSum" Content="Precio global" Margin="2,0" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding SetCommercialModelCommand}" CommandParameter="TimeAndMaterials" Content="Time &amp; Materials" Margin="5,0,0,0" />
                  </UniformGrid>
                  <TextBlock Text="{Binding CommercialModelName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                  <WrapPanel Margin="0,8,0,8">
                    <TextBlock Text="PERFIL SUGERIDO" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Link}" Content="Constructora estándar" Command="{Binding ApplyCommercialProfileCommand}" CommandParameter="StandardConstructor" />
                    <Button Style="{StaticResource Button.Link}" Content="Subcontrato eléctrico" Command="{Binding ApplyCommercialProfileCommand}" CommandParameter="ElectricalSubcontract" Margin="8,0,0,0" />
                    <Button Style="{StaticResource Button.Link}" Content="Cliente privado" Command="{Binding ApplyCommercialProfileCommand}" CommandParameter="PrivateClient" Margin="8,0,0,0" />
                    <Button Style="{StaticResource Button.Link}" Content="Preliminar" Command="{Binding ApplyCommercialProfileCommand}" CommandParameter="PreliminaryBudget" Margin="8,0,0,0" />
                    <Button Style="{StaticResource Button.Link}" Content="Competitiva" Command="{Binding ApplyCommercialProfileCommand}" CommandParameter="CompetitiveOffer" Margin="8,0,0,0" />
                  </WrapPanel>
                  <CheckBox Content="Permitir excepciones de modelo por partida" IsChecked="{Binding AllowPartidaCommercialOverrides}" Foreground="{DynamicResource Brush.Ink2}" />
                  <TextBlock Text="El modelo es interno y no aparece en la oferta al cliente. Aplique cambios para dejarlo pendiente de guardar." FontSize="11" Foreground="{DynamicResource Brush.Ink3}" Margin="0,5,0,0" />
                </StackPanel>
              </Border>

              <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="Gastos generales" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                    <TextBlock Text="{Binding GastosGeneralesKpi}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Blue}" Margin="0,4,0,0" />
                    <TextBlock Text="Sobre costo directo" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="3,0">
                  <StackPanel>
                    <TextBlock Text="Utilidad" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                    <TextBlock Text="{Binding UtilidadKpi}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Blue}" Margin="0,4,0,0" />
                    <TextBlock Text="Margen objetivo" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="IVA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                    <TextBlock Text="{Binding IvaKpi}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Blue}" Margin="0,4,0,0" />
                    <TextBlock Text="Impuesto oferta" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="MONEDA E INDICADORES" Style="{StaticResource ProjectCardTitle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="MONEDA BASE" Style="{StaticResource Form.Label}" />
                      <ComboBox SelectedValue="{Binding MonedaPresupuesto}" SelectedValuePath="Content"
                                Style="{StaticResource Form.ComboBox}">
                        <ComboBoxItem Content="UF" />
                        <ComboBoxItem Content="CLP" />
                        <ComboBoxItem Content="USD" />
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="VALOR UF (CLP)" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding ValorUfClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="TIPO CAMBIO USD" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding TipoCambioUsdText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="MÁRGENES Y SUPERFICIE" Style="{StaticResource ProjectCardTitle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="GASTOS GENERALES %" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding GastosGeneralesText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Margin="0,0,0,12" />
                      <TextBlock Text="IVA %" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding IvaPctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Margin="0,0,0,12" />
                      <TextBlock Text="RIESGO %" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding RiesgoText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Margin="0,0,0,12" />
                      <TextBlock Text="SUPERFICIE TOTAL (M²)" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding MetrosCuadradosText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="UTILIDAD %" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding UtilidadText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Margin="0,0,0,12" />
                      <TextBlock Text="DESCUENTO %" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding DescuentoText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Margin="0,0,0,12" />
                      <TextBlock Text="VALIDEZ OFERTA (DÍAS)" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding ValidityDaysText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- EQUIPO -->
            <StackPanel Visibility="{Binding IsSectionEquipo, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Responsable" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="Quien firma el presupuesto y aparece en auditoría."
                         FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />
              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="ESTIMADOR" Style="{StaticResource ProjectCardTitle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="NOMBRE" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding UsuarioNombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="80" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="ROL / CARGO" Style="{StaticResource Form.Label}" />
                      <TextBox Text="{Binding UsuarioRol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="40" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ALCANCE -->
            <StackPanel Visibility="{Binding IsSectionAlcance, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Alcance y exclusiones" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="Texto que viaja a la carta y a la oferta."
                         FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />
              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="ALCANCE RESUMIDO" Style="{StaticResource ProjectCardTitle}" />
                  <TextBlock Text="INCLUYE" Style="{StaticResource Form.Label}" />
                  <TextBox Text="{Binding ScopeText, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Form.TextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="100" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="EXCLUSIONES CLAVE" Style="{StaticResource ProjectCardTitle}" />
                  <TextBlock Text="NO INCLUYE" Style="{StaticResource Form.Label}" />
                  <TextBox Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource Form.TextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="88" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- AUDITORÍA -->
            <StackPanel Visibility="{Binding IsSectionAuditoria, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Actividad del archivo" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="Quién abrió, guardó o editó este .qce."
                         FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />
              <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                  <TextBlock Text="HISTORIAL RECIENTE" Style="{StaticResource ProjectCardTitle}" />
                  <ItemsControl ItemsSource="{Binding AuditEntries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="0,12">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="18" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Blue}"
                                     VerticalAlignment="Top" Margin="0,4,0,0"
                                     StrokeThickness="3" Stroke="{DynamicResource Brush.BlueSoft}" />
                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                              <TextBlock Text="{Binding Action}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                              <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap">
                                <Run Text="{Binding UserDisplayName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding MachineName, Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}"
                                         TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding OccurredAtLabel}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                       Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Top" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Ink3}" FontSize="12"
                       Visibility="{Binding ValidationSummary, Converter={StaticResource StringNotEmptyToVisibility}}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Save bar -->
      <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="24,0,24,20" CornerRadius="12"
              Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Stretch" MaxWidth="920"
              Panel.ZIndex="100" Padding="16,12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#0B1F33" />
        </Border.Effect>
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Secondary}" Content="Descartar" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Primary}" Content="Aplicar cambios" Command="{Binding SaveCommand}" MinWidth="140" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Amber}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="Cambios pendientes de aplicar al proyecto" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
