<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectNavigationRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary Source="ProjectView.Resources.xaml" />
  </UserControl.Resources>
  <Border Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line}"
          BorderThickness="0,0,1,0"
          Padding="10,14">
    <StackPanel>
      <TextBlock Text="SECCIONES" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.Ink4}" Margin="10,4,10,10" />
      <Button AutomationProperties.Name="Sección Identidad" Content="1  Identidad"
              Command="{Binding SelectSectionCommand}" CommandParameter="identidad"
              Style="{StaticResource ProjectRailItem}" />
      <Button AutomationProperties.Name="Sección Comercial" Content="2  Comercial"
              Command="{Binding SelectSectionCommand}" CommandParameter="comercial"
              Style="{StaticResource ProjectRailItem}" />
      <Button AutomationProperties.Name="Sección Responsable" Content="3  Responsable"
              Command="{Binding SelectSectionCommand}" CommandParameter="equipo"
              Style="{StaticResource ProjectRailItem}" />
      <Button AutomationProperties.Name="Sección Alcance" Content="4  Alcance"
              Command="{Binding SelectSectionCommand}" CommandParameter="alcance"
              Style="{StaticResource ProjectRailItem}" />
      <Button AutomationProperties.Name="Sección Auditoría" Content="5  Auditoría"
              Command="{Binding SelectSectionCommand}" CommandParameter="auditoria"
              Style="{StaticResource ProjectRailItem}" />
    </StackPanel>
  </Border>
</UserControl>
