<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectNavigationRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <!-- ── SIDEBAR LATERAL IZQUIERDO (Estilo Linear / macOS) ──────────── -->
  <Border Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line}"
          BorderThickness="0,0,1,0"
          Padding="10,12">
    <DockPanel LastChildFill="True">
      <!-- Título de Sección Menú -->
      <TextBlock DockPanel.Dock="Top" Text="SECCIONES"
                 FontSize="9.5" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.Ink4}"
                 Margin="10,4,10,10" />

      <!-- Pie de Sidebar: Estado Técnico del Archivo -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface2}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="8" Padding="10,8" Margin="2,10,2,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                       Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
            <TextBlock Text="Archivo .qce" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Bloqueo exclusivo" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
        </StackPanel>
      </Border>

      <!-- Lista Vertical de Navegación -->
      <StackPanel DockPanel.Dock="Top">
        <!-- Item 1: Proyecto & Finanzas -->
        <Button Command="{Binding SelectSectionCommand}" CommandParameter="proyectofinanzas">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ProjectSidebarItem}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionProyectoFinanzas}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Brush.BlueSoft}"
                                BorderBrush="{DynamicResource Brush.BlueIconBg2}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                          <Grid>
                            <Border Width="3" Height="18" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                    Background="{DynamicResource Brush.Blue}" CornerRadius="1.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionProyectoFinanzas}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="Proyecto &amp; Finanzas" FontSize="11.5" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionProyectoFinanzas}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Button>

        <!-- Item 2: Responsable -->
        <Button Command="{Binding SelectSectionCommand}" CommandParameter="equipo">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ProjectSidebarItem}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionEquipo}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Brush.BlueSoft}"
                                BorderBrush="{DynamicResource Brush.BlueIconBg2}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                          <Grid>
                            <Border Width="3" Height="18" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                    Background="{DynamicResource Brush.Blue}" CornerRadius="1.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionEquipo}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="Responsable" FontSize="11.5" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionEquipo}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Button>

        <!-- Item 3: Alcance & Exclusiones -->
        <Button Command="{Binding SelectSectionCommand}" CommandParameter="alcance">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ProjectSidebarItem}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionAlcance}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Brush.BlueSoft}"
                                BorderBrush="{DynamicResource Brush.BlueIconBg2}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                          <Grid>
                            <Border Width="3" Height="18" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                    Background="{DynamicResource Brush.Blue}" CornerRadius="1.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionAlcance}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="Alcance &amp; Exclusiones" FontSize="11.5" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionAlcance}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Button>

        <!-- Item 4: Actividad & Auditoría -->
        <Button Command="{Binding SelectSectionCommand}" CommandParameter="auditoria">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ProjectSidebarItem}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSectionAuditoria}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Brush.BlueSoft}"
                                BorderBrush="{DynamicResource Brush.BlueIconBg2}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                          <Grid>
                            <Border Width="3" Height="18" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                    Background="{DynamicResource Brush.Blue}" CornerRadius="1.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                       VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionAuditoria}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="Actividad &amp; Auditoría" FontSize="11.5" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionAuditoria}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Button>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
