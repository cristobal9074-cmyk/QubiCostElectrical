<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectIdentityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Identidad" FontSize="18" FontWeight="Bold" />
    <TextBlock Text="Lo que aparece en portadas, cartas y ficha PDF." FontSize="13" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16" />
    <Border Style="{StaticResource ProjectCard}">
      <StackPanel>
        <TextBlock Text="OBRA Y MANDANTE" Style="{StaticResource ProjectCardTitle}" />
        <TextBlock Text="NOMBRE DEL PROYECTO" Style="{StaticResource Form.Label}" />
        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="120" />
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="CLIENTE / MANDANTE" Style="{StaticResource Form.Label}" /><TextBox Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="TIPO DE PROYECTO" Style="{StaticResource Form.Label}" /><TextBox Text="{Binding TipoProyecto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" /></StackPanel>
        </Grid>
        <TextBlock Text="UBICACIÓN DE LA OBRA" Style="{StaticResource Form.Label}" Margin="0,12,0,0" />
        <TextBox Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource ProjectCard}">
      <StackPanel>
        <TextBlock Text="ESTADO DEL PRESUPUESTO" Style="{StaticResource ProjectCardTitle}" />
        <UniformGrid Columns="3"><Button AutomationProperties.Name="Borrador" Content="Borrador" Command="{Binding SetEstadoCommand}" CommandParameter="Borrador" Style="{StaticResource EstadoSegBtn}" /><Button AutomationProperties.Name="En revisión" Content="En revisión" Command="{Binding SetEstadoCommand}" CommandParameter="En revisión" Style="{StaticResource EstadoSegBtn}" /><Button AutomationProperties.Name="Aprobado" Content="Aprobado" Command="{Binding SetEstadoCommand}" CommandParameter="Aprobado" Style="{StaticResource EstadoSegBtn}" /></UniformGrid>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="FECHA CREACIÓN" Style="{StaticResource Form.Label}" /><TextBox Text="{Binding FechaCreacionLabel, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Form.TextBox}" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="ÚLTIMA MODIFICACIÓN" Style="{StaticResource Form.Label}" /><TextBox Text="{Binding FechaModificacionLabel, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Form.TextBox}" /></StackPanel>
        </Grid>
        <TextBlock Text="ARCHIVO LOCAL" Style="{StaticResource Form.Label}" Margin="0,12,0,0" />
        <TextBox Text="{Binding ArchivoProyectoLabel, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Form.TextBox}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
