<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectTeamControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><TextBlock Text="Responsable" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold"/><TextBlock Text="Quién firma el presupuesto y aparece en auditoría." FontSize="{StaticResource Font.Size.base}" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,16"/><Border Style="{StaticResource ProjectCard}"><StackPanel><TextBlock Text="ESTIMADOR" Style="{StaticResource ProjectCardTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NOMBRE" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding UsuarioNombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ROL / CARGO" Style="{StaticResource Form.Label}"/><TextBox Text="{Binding UsuarioRol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"/></StackPanel></Grid></StackPanel></Border></StackPanel></UserControl>
