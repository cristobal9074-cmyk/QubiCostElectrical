<UserControl x:Class="QubiCostElectrical.Wpf.Features.Project.ProjectTeamControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <!-- ───────────────────────────────────────────────────────────── -->
  <!-- SECCIÓN 2: RESPONSABLE                                         -->
  <!-- ───────────────────────────────────────────────────────────── -->
  <StackPanel Visibility="{Binding IsSectionEquipo, Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource ProCard}">
      <StackPanel>
        <DockPanel LastChildFill="True" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,8,0">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                         Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="RESPONSABLE DEL PRESUPUESTO &amp; CREDENCIALES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
          </StackPanel>
          <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                  Command="{Binding SetCurrentUserAsEstimatorCommand}"
                  Style="{StaticResource Button.Secondary}" Height="26" Padding="10,0" FontSize="11"
                  ToolTip="Asigna automáticamente el usuario de la sesión de Windows como estimador del proyecto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Blue}" />
              <TextBlock Text="Usar mi usuario de Windows" />
            </StackPanel>
          </Button>
        </DockPanel>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="NOMBRE DEL ESTIMADOR" Style="{StaticResource Form.Label}" />
            <TextBox Text="{Binding UsuarioNombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="80" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ROL / CARGO" Style="{StaticResource Form.Label}" />
            <TextBox Text="{Binding UsuarioRol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" MaxLength="40" />
          </StackPanel>
        </Grid>

        <!-- Chips de Selección Rápida de Rol -->
        <WrapPanel Margin="0,0,0,12">
          <TextBlock Text="ROLES FRECUENTES:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,6" />
          <Button Style="{StaticResource ProTemplateChip}" Content="Estimador Eléctrico" Command="{Binding SetUserRoleCommand}" CommandParameter="Estimador Eléctrico" />
          <Button Style="{StaticResource ProTemplateChip}" Content="Jefe de Proyectos Eléctricos" Command="{Binding SetUserRoleCommand}" CommandParameter="Jefe de Proyectos Eléctricos" />
          <Button Style="{StaticResource ProTemplateChip}" Content="Ingeniero de Propuestas SEC" Command="{Binding SetUserRoleCommand}" CommandParameter="Ingeniero de Propuestas SEC" />
          <Button Style="{StaticResource ProTemplateChip}" Content="Gerente Técnico" Command="{Binding SetUserRoleCommand}" CommandParameter="Gerente Técnico" />
        </WrapPanel>

        <!-- Preview de Credencial Oficial -->
        <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.BlueSoft}"
                    BorderBrush="{DynamicResource Brush.BlueIconBg2}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
              <TextBlock Text="REPRESENTACIÓN EN CARÁTULA Y EXPEDIENTE TÉCNICO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
              <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}">
                <Run Text="{Binding UsuarioNombre, FallbackValue='Estimador No Asignado'}" />
                <Run Text=" · " Foreground="{DynamicResource Brush.Ink4}" />
                <Run Text="{Binding UsuarioRol, FallbackValue='Sin cargo asignado'}" Foreground="{DynamicResource Brush.Ink2}" />
              </TextBlock>
              <TextBlock Text="Aparece en carátulas de dossier PDF, firmas contractuales y registros de auditoría de este archivo .qce."
                         FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
