<Window x:Class="QubiCostElectrical.Wpf.Features.Project.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Nuevo proyecto"
        Width="520" Height="680"
        ShowInTaskbar="False">
  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
      <Border Style="{StaticResource Dialog.HeaderIconContainer}" DockPanel.Dock="Left">
        <Path Data="M 4 20 h 16 a 2 2 0 0 0 2 -2 V 8 a 2 2 0 0 0 -2 -2 h -7.93 a 2 2 0 0 1 -1.66 -.9 l -.82 -1.2 A 2 2 0 0 0 7.93 3 H 4 a 2 2 0 0 0 -2 2 v 13 a 2 2 0 0 0 2 2 Z M 12 10 v 6 M 9 13 h 6"
              Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Crear nuevo proyecto" Style="{StaticResource Dialog.HeaderTitle}" />
        <TextBlock Text="Defina nombre, cliente, plantilla SEC y carpeta destino del archivo .qce."
                   Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0" />
        <TextBlock x:Name="ValidationErrorBlock"
                   Text="{Binding ValidationError, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="{DynamicResource Brush.DangerDark}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="Collapsed" />
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Nombre del proyecto" Style="{StaticResource Form.Label}" />
        <TextBox x:Name="NameBox" Style="{StaticResource Form.TextBox}" Text="Proyecto nuevo" Margin="0,0,0,10" />

        <TextBlock Text="Cliente" Style="{StaticResource Form.Label}" />
        <Grid Margin="0,0,0,10">
          <TextBox x:Name="ClientBox" Style="{StaticResource Form.TextBox}" />
          <TextBlock Text="Nombre del cliente (opcional)" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Muted}"
                     VerticalAlignment="Center" Margin="8,0,0,0" FontSize="{StaticResource Font.Size.md}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ClientBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <TextBlock Text="Ubicación" Style="{StaticResource Form.Label}" />
        <Grid Margin="0,0,0,10">
          <TextBox x:Name="LocationBox" Style="{StaticResource Form.TextBox}" />
          <TextBlock Text="Ciudad o dirección de la obra (opcional)" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Muted}"
                     VerticalAlignment="Center" Margin="8,0,0,0" FontSize="{StaticResource Font.Size.md}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=LocationBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <TextBlock Text="Moneda del presupuesto" Style="{StaticResource Form.Label}" />
        <ComboBox x:Name="CurrencyBox" Style="{StaticResource Form.ComboBox}" SelectedIndex="0" Margin="0,0,0,10">
          <ComboBoxItem Content="UF" />
          <ComboBoxItem Content="CLP" />
          <ComboBoxItem Content="USD" />
        </ComboBox>

        <TextBlock Text="Plantilla de obra típica (Norma SEC / RIC)" Style="{StaticResource Form.Label}" />
        <ComboBox x:Name="TemplateBox" Style="{StaticResource Form.ComboBox}" Margin="0,0,0,6"
                  SelectionChanged="OnTemplateChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icono}" Margin="0,0,8,0" FontSize="{StaticResource Font.Size.base}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Nombre}" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Border x:Name="TemplateInfoBorder" Margin="0,0,0,10" Padding="10,8" CornerRadius="6"
                Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
          <StackPanel>
            <DockPanel LastChildFill="True">
              <TextBlock x:Name="TemplateNormaBadge" DockPanel.Dock="Right" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
              <TextBlock x:Name="TemplateSubtitleBlock" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.md}"
                         Foreground="{DynamicResource Brush.Ink}" />
            </DockPanel>
            <TextBlock x:Name="TemplateDescriptionBlock" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Carpeta destino" Style="{StaticResource Form.Label}" />
        <DockPanel Margin="0,0,0,10">
          <Button x:Name="BrowseFolderBtn" DockPanel.Dock="Right" Content="…"
                  Style="{StaticResource Button.Secondary}" Width="32" Padding="0" Margin="6,0,0,0" Click="OnBrowseFolder" />
          <TextBox x:Name="FolderBox" Style="{StaticResource Form.TextBox}" IsReadOnly="True" />
        </DockPanel>

        <TextBlock Text="Nombre del archivo" Style="{StaticResource Form.Label}" />
        <TextBox x:Name="FileNameBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" />

        <TextBlock Text="Modelo comercial" Style="{StaticResource Form.Label}" Margin="0,6,0,2" />
        <TextBlock Text="Cómo se convierte el costo del presupuesto en el precio de venta final. Se puede cambiar después en Costo."
                   Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.md}" Margin="0,0,0,8" />

        <StackPanel x:Name="PolicyCards">
          <RadioButton x:Name="PolicyCostPlusMarkup" GroupName="ClosingPolicy" IsChecked="True" Margin="0,0,0,6" Checked="OnPolicyChanged">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Costo + Markup (motor)" FontWeight="SemiBold" />
              <TextBlock Text="Úsala cuando: el precio sale del costo con GG y utilidad configurados. Es el modelo por defecto."
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="PolicyTargetPrice" GroupName="ClosingPolicy" Margin="0,0,0,6" Checked="OnPolicyChanged">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Precio Objetivo" FontWeight="SemiBold" />
              <TextBlock Text="Úsala cuando: el mandante fija un precio tope o hay un benchmark de mercado; GG y utilidad quedan como residual."
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="PolicyLumpSumEpc" GroupName="ClosingPolicy" Margin="0,0,0,6" Checked="OnPolicyChanged">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Suma Alzada / EPC" FontWeight="SemiBold" />
              <TextBlock Text="Úsala cuando: precio cerrado e inamovible con todo el riesgo del contratista; se fuerza una contingencia mínima."
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="PolicyCostPlusFee" GroupName="ClosingPolicy" Margin="0,0,0,6" Checked="OnPolicyChanged">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Costo + Fee" FontWeight="SemiBold" />
              <TextBlock Text="Úsala cuando: se traspasa el costo real 1:1 más un fee pactado, sin GG cargados sobre el costo."
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="PolicyUnitPricePure" GroupName="ClosingPolicy" Margin="0,0,0,6" Checked="OnPolicyChanged">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Precio Unitario Puro" FontWeight="SemiBold" />
              <TextBlock Text="Úsala cuando: la venta es la suma de precios unitarios contractuales por partida, con el margen embebido."
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="PolicyGainsharePainshare" GroupName="ClosingPolicy" Margin="0,0,0,6" Checked="OnPolicyChanged">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Text="Gainshare / Painshare" FontWeight="SemiBold" />
              <TextBlock Text="Úsala cuando: hay un costo objetivo pactado y el ahorro o sobrecosto se reparte con el mandante."
                         Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel x:Name="PolicyParamPanel" Visibility="Collapsed" Margin="0,4,0,10">
          <TextBlock x:Name="PolicyParamLabel" Style="{StaticResource Form.Label}" />
          <TextBox x:Name="PolicyParamBox" Style="{StaticResource Form.TextBox}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}">
      <Button DockPanel.Dock="Right" Content="Crear proyecto" IsDefault="True" Style="{StaticResource Button.Primary}"
              MinWidth="130" Height="34" Click="OnCreate" />
      <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" Style="{StaticResource Button.Secondary}"
              MinWidth="90" Height="34" Margin="0,0,10,0" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
