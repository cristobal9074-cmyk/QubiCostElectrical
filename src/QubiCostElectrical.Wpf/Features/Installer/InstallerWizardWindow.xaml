<Window x:Class="QubiCostElectrical.Wpf.Features.Installer.InstallerWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qubi Cost® Electrical — Asistente de Instalación y Configuración"
        Width="940" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        BorderBrush="#334155"
        BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Barra de Título Corporativa -->
        <Border Grid.Row="0" Background="#101C30" MouseLeftButtonDown="OnTitlebarMouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <!-- Botones de ventana fijados a la derecha -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Height="34" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Content="&#x2014;" FontSize="11" Click="OnMinimizeClick" Cursor="Hand" />
                    <Button Width="46" Height="34" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Content="&#x25A1;" FontSize="12" Click="OnMaximizeClick" Cursor="Hand" />
                    <Button x:Name="BtnCloseTitle" Width="46" Height="34" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Content="&#x2715;" FontSize="11" Click="OnCloseClick" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Icono y Título a la izquierda -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="/Assets/app_logo.png" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Qubi Cost® Electrical — Asistente de Instalación y Configuración"
                               Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Cabecera Blanca con Logo Oficial y Breadcrumb -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14,24,12">
            <DockPanel LastChildFill="True">
                <!-- Logo Oficial en la derecha -->
                <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="12,6,16,6" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/app_logo.png" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="QUBI COST" FontWeight="ExtraBold" FontSize="15" Foreground="#101C30" LineHeight="16" />
                            <TextBlock Text="Electrical" FontWeight="SemiBold" FontSize="11.5" Foreground="#2563B0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Título y Breadcrumb a la izquierda -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="QUBI COST® " FontSize="25" FontWeight="Light" Foreground="#0F172A" />
                        <TextBlock Text="ELECTRICAL " FontSize="25" FontWeight="ExtraBold" Foreground="#2563B0" />
                        <TextBlock x:Name="TxtHeaderVersion" Text="v1.1.6" FontSize="25" FontWeight="ExtraBold" Foreground="#0EA5E9" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Instalación" FontSize="12" Foreground="#64748B" FontWeight="Medium" />
                        <TextBlock Text="  &gt;  " FontSize="11" Foreground="#CBD5E1" />
                        <TextBlock Text="Configurar directorios y componentes del sistema" FontSize="12" Foreground="#0F172A" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Escenario Central Dividido -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="510" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cinta Vertical "CONFIGURACIÓN" -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2563B0" Offset="0" />
                        <GradientStop Color="#101C30" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="CONFIGURACIÓN" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>

            <!-- Columna de Componentes -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="18,14,16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Componente 1: Qubi Cost Electrical Core -->
                        <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✔" Foreground="#16A34A" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Qubi Cost® Electrical" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="TxtComponentVersion" Text="v1.1.6" FontSize="10" FontWeight="Bold" Foreground="#2563B0" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Motor de cubicación para Servicios Comunes (Doble Tubería), APU dinámicos, ofertas y presupuestos eléctricos profesionales en .NET 10 x64."
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                                    
                                    <!-- Opciones de acceso directo -->
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="ChkDesktopShortcut" IsChecked="True" Content="Crear acceso directo en el Escritorio" FontSize="11" Margin="0,2" />
                                        <CheckBox x:Name="ChkAssociateQce" IsChecked="True" Content="Asociar extensión de presupuesto (.qce)" FontSize="11" Margin="0,2" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Componente 2: Banco Canónico de Precios -->
                        <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✔" Foreground="#16A34A" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Banco Canónico de Precios™" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <TextBlock Text="Catálogo integral con canalizaciones PVC/PVCLH, líneas de artefactos Magic/Matix, conductores EVA/H07Z1-K y rendimientos canónicos de mano de obra."
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Barra Divisoria Metálica Técnica -->
                        <Border CornerRadius="2" Padding="10,4" Margin="0,2,0,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F1F5F9" Offset="0" />
                                    <GradientStop Color="#E2E8F0" Offset="0.4" />
                                    <GradientStop Color="#CBD5E1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="Almacenamiento de proyectos y seguridad" FontWeight="Bold" FontSize="12" Foreground="#0F172A" />
                        </Border>

                        <!-- Componente 3: Módulo SQLite .QCE y Red SMB -->
                        <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✔" Foreground="#16A34A" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Módulo de Proyectos SQLite (.QCE)" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <TextBlock Text="Almacén local y soporte multiusuario para carpetas de red compartidas (SMB/UNC) con control de bloqueos exclusivos y auditoría de cambios."
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Componente 4: Certificado Authenticode -->
                        <Border Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✔" Foreground="#16A34A" FontWeight="Bold" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <CheckBox Grid.Column="1" x:Name="ChkCertTrust" IsChecked="True" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Certificado Digital Authenticode (Editor Verificado)" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <TextBlock Text="Registra la clave de firma digital en Windows (TrustedPublisher) para eliminar advertencias de SmartScreen y permitir auto-actualizaciones seguras."
                                               FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Lado Derecho: Plano CAD Eléctrico Defuminado -->
            <Grid Grid.Column="2" Background="#FFFFFF" ClipToBounds="True">
                <!-- Imagen CAD con Fusión Suave -->
                <Image Source="/Assets/cad_electrical_bim.jpg" Stretch="UniformToFill" HorizontalAlignment="Right"
                       Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#44000000" Offset="0.2" />
                            <GradientStop Color="#FF000000" Offset="0.6" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <!-- Sello Técnico de Ingeniería en la esquina inferior derecha -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14"
                        Background="#EEFFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="QUBI COST® ELECTRICAL SUITE" FontWeight="Bold" FontSize="11" Foreground="#2563B0" />
                        <TextBlock x:Name="TxtStampVersion" Text="Edición Oficial de Despliegue v1.1.6" FontSize="10" Foreground="#1E293B" Margin="0,2,0,0" />
                        <TextBlock Text="Arquitectura x64 · SQLite 3 Canónico" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Consola Inferior (Rutas y Acciones) -->
        <Border Grid.Row="3" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="24,12,24,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F8FAFC" Offset="0" />
                    <GradientStop Color="#E2E8F0" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <!-- Fila 1: Ruta de instalación -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ruta de instalación:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#334155" />
                    <TextBox Grid.Column="1" x:Name="TxtAppPath" Height="28" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" BorderBrush="#94A3B8" />
                    <Button Grid.Column="2" Content="Examinar..." Height="28" Margin="8,0,0,0" Click="OnBrowseAppPathClick" Background="#FFFFFF" BorderBrush="#94A3B8" FontWeight="Medium" />
                </Grid>

                <!-- Fila 2: Carpeta de proyectos -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Carpeta de proyectos:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#334155" />
                    <TextBox Grid.Column="1" x:Name="TxtProjectPath" Height="28" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" BorderBrush="#94A3B8" />
                    <Button Grid.Column="2" Content="Examinar..." Height="28" Margin="8,0,0,0" Click="OnBrowseProjectPathClick" Background="#FFFFFF" BorderBrush="#94A3B8" FontWeight="Medium" />
                </Grid>

                <!-- Fila 3: Espacio en disco y Botonera -->
                <DockPanel LastChildFill="False" Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtDiskSpace" Text="Espacio en disco: 245 MB necesarios / calculando..."
                               FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />

                    <!-- Botones de Acción -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Atrás" Width="85" Height="30" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#94A3B8"
                                FontWeight="SemiBold" Click="OnBackClick" />
                        <Button Content="Instalar" Width="95" Height="30" Margin="0,0,8,0" Click="OnInstallClick"
                                Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="1" BorderBrush="#1D4ED8" Cursor="Hand">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#2563B0" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancelar" Width="85" Height="30" Background="#FFFFFF" BorderBrush="#94A3B8"
                                FontWeight="SemiBold" Click="OnCloseClick" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 5. Capa de Progreso en Vivo (Superpuesta durante la instalación) -->
        <Grid x:Name="ProgressOverlay" Grid.Row="1" Grid.RowSpan="3" Background="#F8FAFC" Visibility="Collapsed">
            <Border Width="580" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                    Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.12" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/app_logo.png" Width="48" Height="48" Margin="0,0,0,12" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="TxtProgressTitle" Text="Instalando Qubi Cost® Electrical v1.1.6"
                               FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock x:Name="TxtProgressStatus" Text="Iniciando copia de archivos binarios y librerías x64..."
                               FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,16" />

                    <!-- Barra de progreso moderna -->
                    <ProgressBar x:Name="InstallProgressBar" Width="500" Height="18" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#2563B0" Background="#E2E8F0" BorderBrush="#94A3B8" />

                    <DockPanel Width="500" Margin="0,6,0,0">
                        <TextBlock x:Name="TxtProgressPercent" DockPanel.Dock="Left" Text="0%" FontSize="11" Foreground="#64748B" />
                        <TextBlock x:Name="TxtProgressDetail" DockPanel.Dock="Right" Text="Preparando..." FontSize="11" Foreground="#64748B" />
                    </DockPanel>

                    <!-- Panel de finalización -->
                    <StackPanel x:Name="PanelFinished" Visibility="Collapsed" Margin="0,20,0,0">
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="✔ Instalación completada con éxito" FontWeight="Bold" FontSize="12.5" Foreground="#065F46" />
                                <TextBlock x:Name="TxtSummaryProj" Text="• Directorio de presupuestos configurado." FontSize="11.5" Foreground="#065F46" Margin="0,3,0,0" />
                                <TextBlock Text="• Certificado Authenticode verificado en TrustedPublisher." FontSize="11.5" Foreground="#065F46" />
                            </StackPanel>
                        </Border>

                        <Button Content="Finalizar e Iniciar Qubi Cost Electrical" Height="36" Click="OnFinishAndLaunchClick"
                                Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" BorderThickness="1" BorderBrush="#1D4ED8" Cursor="Hand">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#2563B0" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
