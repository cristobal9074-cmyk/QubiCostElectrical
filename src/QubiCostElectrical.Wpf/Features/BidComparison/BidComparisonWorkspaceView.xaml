<UserControl x:Class="QubiCostElectrical.Wpf.Features.BidComparison.BidComparisonWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Comparativo de ofertas" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Matriz comercial/técnica. La recomendación es determinista y requiere confirmación." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <TextBlock Text="Moneda base" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Text="{Binding BaseCurrency}" Width="60" Margin="0,0,8,0"/>
        <TextBlock Text="Tasa" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Text="{Binding ExchangeRate}" Width="80" Margin="0,0,8,0"/>
        <Button Content="Comparar" Command="{Binding CompareCommand}" Padding="12,6" Background="#2563EB" Foreground="White"/>
      </StackPanel>
      <ComboBox ItemsSource="{Binding Rfqs}" SelectedItem="{Binding SelectedRfq}" DisplayMemberPath="Number" Width="220"/>
    </DockPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="*"/>
        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2*"/>
        <DataGridTemplateColumn Header="Celdas (precio / TAC / plazo / técnico / riesgo / score / marca)" Width="3*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="6" Margin="0,0,6,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Supplier, StringFormat=Prov: {0}}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UnitPriceBase, StringFormat=PU base: {0}}"/>
                        <TextBlock Text="{Binding TotalAcquisition, StringFormat=TAC: {0}}"/>
                        <TextBlock Text="{Binding LeadDays, StringFormat=Plazo días: {0}}"/>
                        <TextBlock Text="{Binding Technical, StringFormat=Técnico: {0}}"/>
                        <TextBlock Text="{Binding Risk, StringFormat=Riesgo: {0}}"/>
                        <TextBlock Text="{Binding Score, StringFormat=Score: {0}}"/>
                        <TextBlock Text="{Binding RecommendedLabel}" FontWeight="Bold"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding Recommendation}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
