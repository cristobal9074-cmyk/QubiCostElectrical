<UserControl x:Class="QubiCostElectrical.Wpf.Features.WbsPlanning.WbsPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.WbsPlanning">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Estructura de Desglose de Trabajo (WBS)" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
        <Button Command="{Binding RefreshCommand}" Content="⟳" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" />
        <Button Command="{Binding AddNodeCommand}" Content="Agregar Nodo" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
        <Button Command="{Binding DeleteNodeCommand}" Content="Eliminar" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
              AutoGenerateColumns="False" Background="{DynamicResource Brush.Surface}" Margin="12,0"
              AlternatingRowBackground="{DynamicResource Brush.AltRow}" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding WbsCode}" Width="100" />
        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Tipo" Binding="{Binding NodeType}" Width="100" />
        <DataGridTextColumn Header="Nivel" Binding="{Binding Level}" Width="60" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90" />
        <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="120" />
        <DataGridTextColumn Header="Orden" Binding="{Binding SortOrder}" Width="60" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Nuevo Nodo" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding NewNodeCode, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
        <TextBox Grid.Column="2" Text="{Binding NewNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
        <ComboBox Grid.Column="3" SelectedItem="{Binding NewNodeType}" ItemsSource="{x:Static local:WbsPlanningViewModel.NodeTypeValues}" Margin="4,0" />
        <Button Grid.Column="4" Command="{Binding AddNodeCommand}" Content="Agregar" Style="{StaticResource Button.Primary}" Margin="4,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
