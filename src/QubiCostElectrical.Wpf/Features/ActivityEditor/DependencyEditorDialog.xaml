<Window x:Class="QubiCostElectrical.Wpf.Features.ActivityEditor.DependencyEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Dependencias" Height="400" Width="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Canvas}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Lista de Dependencias Existentes -->
            <GroupBox Header="Dependencias Activas" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding ActiveDependencies}" AutoGenerateColumns="False" 
                          SelectedItem="{Binding SelectedDependency}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Predecesora" Binding="{Binding PredecessorCodeName}" Width="*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="80" />
                        <DataGridTextColumn Header="Lag" Binding="{Binding LagDescription}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Formulario de Edición/Creación -->
            <GroupBox Header="Nueva Dependencia" Grid.Column="1">
                <StackPanel Margin="6">
                    <TextBlock Text="Actividad Predecesora" Style="{StaticResource Text.Caption}" />
                    <ComboBox ItemsSource="{Binding AvailablePredecessors}" SelectedItem="{Binding NewPredecessor}" 
                              DisplayMemberPath="CodeName" Margin="0,2,0,8" />

                    <TextBlock Text="Tipo de Relación" Style="{StaticResource Text.Caption}" />
                    <ComboBox SelectedItem="{Binding NewType}" ItemsSource="{Binding DependencyTypes}" Margin="0,2,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Lag/Lead" Style="{StaticResource Text.Caption}" />
                            <TextBox Text="{Binding NewLagValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Unidad" Style="{StaticResource Text.Caption}" />
                            <ComboBox SelectedItem="{Binding NewLagUnit}" ItemsSource="{Binding DurationUnits}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding IsLead}" Content="¿Es Lead (desfase negativo)?" Margin="0,0,0,12" />

                    <Button Command="{Binding AddDependencyCommand}" Content="Agregar Dependencia" Style="{StaticResource Button.Primary}" />
                    <Button Command="{Binding DeleteDependencyCommand}" Content="Eliminar Seleccionada" Style="{StaticResource Button.Secondary}" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Botones de Acción principal -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Command="{Binding SaveCommand}" Content="Cerrar y Guardar" Style="{StaticResource Button.Primary}" Width="150" />
        </StackPanel>
    </Grid>
</Window>
