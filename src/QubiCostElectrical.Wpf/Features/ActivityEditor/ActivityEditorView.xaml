<UserControl x:Class="QubiCostElectrical.Wpf.Features.ActivityEditor.ActivityEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.ActivityEditor">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Editor de Actividades" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
          <Button Command="{Binding RefreshCommand}" Content="⟳" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" />
          <Button Command="{Binding NewActivityCommand}" Content="Nueva Actividad" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
          <Button Command="{Binding DeleteActivityCommand}" Content="Eliminar" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="12,0,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>

      <DataGrid Grid.Column="0" ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}"
                AutoGenerateColumns="False" Background="{DynamicResource Brush.Surface}"
                AlternatingRowBackground="{DynamicResource Brush.AltRow}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80" />
          <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="80" />
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90" />
          <DataGridTextColumn Header="Duración" Binding="{Binding PlannedDuration.Value}" Width="70" />
          <DataGridTextColumn Header="Unidad" Binding="{Binding PlannedDuration.Unit}" Width="70" />
          <DataGridTextColumn Header="Inicio" Binding="{Binding PlannedStart, StringFormat=\{0:dd/MM\}}" Width="80" />
          <DataGridTextColumn Header="Fin" Binding="{Binding PlannedFinish, StringFormat=\{0:dd/MM\}}" Width="80" />
          <DataGridTextColumn Header="Avance" Binding="{Binding PlannedProgressPct, StringFormat=P0}" Width="70" />
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Line}" Margin="4,0" />

      <ScrollViewer Grid.Column="2" IsEnabled="{Binding IsEditing}">
        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}" Padding="14">
          <StackPanel>
            <TextBlock Text="Editor de Actividad" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,12" />

            <TextBlock Text="Código" Style="{StaticResource Text.Body}" />
            <TextBox Text="{Binding ActivityCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

            <TextBlock Text="Nombre" Style="{StaticResource Text.Body}" />
            <TextBox Text="{Binding ActivityName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

            <TextBlock Text="Tipo" Style="{StaticResource Text.Body}" />
            <ComboBox SelectedItem="{Binding ActivityType}" ItemsSource="{x:Static local:ActivityEditorViewModel.ActivityTypeValues}" Margin="0,2,0,8" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Duración" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding DurationValue, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="4,0" />
              <ComboBox Grid.Column="2" SelectedItem="{Binding DurationUnit}" ItemsSource="{x:Static local:ActivityEditorViewModel.DurationUnitValues}" Margin="4,0,0,0" />
            </Grid>

            <TextBlock Text="Estado" Style="{StaticResource Text.Body}" Margin="0,8,0,2" />
            <ComboBox SelectedItem="{Binding Status}" ItemsSource="{x:Static local:ActivityEditorViewModel.ActivityStatusValues}" Margin="0,0,0,8" />

            <TextBlock Text="Calendario" Style="{StaticResource Text.Body}" />
            <ComboBox ItemsSource="{Binding Calendars}" SelectedValue="{Binding SelectedCalendarId}"
                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2,0,8" />

            <TextBlock Text="Responsable" Style="{StaticResource Text.Body}" />
            <TextBox Text="{Binding ResponsibleId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />

            <Button Command="{Binding EditDependenciesCommand}" Content="Dependencias..." Style="{StaticResource Button.Secondary}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,8" />

            <Button Command="{Binding SaveActivityCommand}" Content="Guardar Actividad" Style="{StaticResource Button.Primary}"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
