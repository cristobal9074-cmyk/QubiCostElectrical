<UserControl x:Class="QubiCostElectrical.Wpf.Features.ApuMerge.ApuMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.ApuMerge">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Merge APU" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Code, StringFormat='APU: {0}'}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Command="{Binding CreateMergeVersionCommand}" Content="Crear Versión Merge" Style="{StaticResource Button.Primary}" Margin="16,0,0,0" />
        <Button Command="{Binding CancelCommand}" Content="Cancelar" Style="{StaticResource Button.Secondary}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}" Padding="14">
        <StackPanel>
          <TextBlock Text="Conflictos" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
          <DataGrid ItemsSource="{Binding Conflicts}" AutoGenerateColumns="False"
                    Background="Transparent" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Dimensión" Binding="{Binding Dimension}" Width="100" />
              <DataGridTextColumn Header="Local" Binding="{Binding LocalValue}" Width="100" />
              <DataGridTextColumn Header="Catálogo" Binding="{Binding CatalogValue}" Width="100" />
              <DataGridTextColumn Header="Base" Binding="{Binding BaseValue}" Width="100" />
              <DataGridTemplateColumn Header="Resolver" Width="200">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Local" Command="{Binding DataContext.ResolveKeepLocalCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                              CommandParameter="{Binding}" Margin="0,0,4,0" Style="{StaticResource Button.Secondary}" />
                      <Button Content="Catálogo" Command="{Binding DataContext.ResolveAcceptCatalogCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                              CommandParameter="{Binding}" Margin="0,0,4,0" Style="{StaticResource Button.Secondary}" />
                      <Button Content="Base" Command="{Binding DataContext.ResolveKeepBaseCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                              CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}" Padding="14">
        <StackPanel>
          <TextBlock Text="Diferencias de Impacto" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
          <DataGrid ItemsSource="{Binding Diffs}" AutoGenerateColumns="False"
                    Background="Transparent" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Dimensión" Binding="{Binding Dimension}" Width="120" />
              <DataGridTextColumn Header="Local" Binding="{Binding LocalValue}" Width="110" />
              <DataGridTextColumn Header="Catálogo" Binding="{Binding CatalogValue}" Width="110" />
              <DataGridTextColumn Header="Impacto" Binding="{Binding Impact}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
