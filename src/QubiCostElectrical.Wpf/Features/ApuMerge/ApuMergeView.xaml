<UserControl x:Class="QubiCostElectrical.Wpf.Features.ApuMerge.ApuMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="{DynamicResource Brush.Canvas}">

  <ctrl:WorkspacePageChrome ShowEmptyState="{Binding ShowEmptyState}"
                            IsLoading="{Binding IsLoading}"
                            EmptyTitle="Sin proyecto abierto"
                            EmptyDescription="Abra un proyecto para fusionar versiones de APU."
                            LoadingMessage="Preparando fusión de versiones…">
    <ctrl:WorkspacePageChrome.Body>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">

          <TextBlock Text="Fusión de versiones APU" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,4">
            <Run Text="Comparación entre la versión local del APU " />
            <Run Text="{Binding Code, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
            <Run Text=" y la versión de catálogo. Resuelva los conflictos antes de crear la versión de fusión." />
          </TextBlock>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Helper}"
                     TextWrapping="Wrap" Margin="0,0,0,16" />

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Conflictos" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />

              <DataGrid ItemsSource="{Binding Conflicts}" AutoGenerateColumns="False" CanUserAddRows="False"
                        Style="{StaticResource DataGrid.Workspace}"
                        infra:DataGridExcelNavigation.Enable="True"
                        IsReadOnly="{Binding IsReadOnly}"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Dimensión" Binding="{Binding Dimension}" IsReadOnly="True" Width="140" />
                  <DataGridTextColumn Header="Local" Binding="{Binding LocalValue}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Catálogo" Binding="{Binding CatalogValue}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Base" Binding="{Binding BaseValue}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Resolución" Binding="{Binding Resolution}" IsReadOnly="True" Width="120">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Navy}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="Acciones" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Mantener local" Margin="0,0,4,0" Style="{StaticResource Button.Ghost}" Padding="8,4"
                                  Command="{Binding DataContext.ResolveKeepLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Aceptar catálogo" Margin="0,0,4,0" Style="{StaticResource Button.Ghost}" Padding="8,4"
                                  Command="{Binding DataContext.ResolveAcceptCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Mantener base" Style="{StaticResource Button.Ghost}" Padding="8,4"
                                  Command="{Binding DataContext.ResolveKeepBaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Diferencias de costo" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />

              <DataGrid ItemsSource="{Binding Diffs}" AutoGenerateColumns="False" CanUserAddRows="False"
                        Style="{StaticResource DataGrid.Workspace}"
                        infra:DataGridExcelNavigation.Enable="True"
                        IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Dimensión" Binding="{Binding Dimension}" Width="160" />
                  <DataGridTextColumn Header="Local" Binding="{Binding LocalValue}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Catálogo" Binding="{Binding CatalogValue}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Impacto" Binding="{Binding Impact}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextAlignment" Value="Right" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <Border Padding="16" CornerRadius="10" Background="{DynamicResource Brush.HeroPanel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="APU" Style="{StaticResource Text.KpiLabel}" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding ApuId}" Style="{StaticResource Text.KpiInline}"
                           Foreground="{DynamicResource Brush.White}" FontFamily="{StaticResource Font.Mono}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Style="{StaticResource Button.Secondary}" />
                <Button Content="Crear versión de fusión" Command="{Binding CreateMergeVersionCommand}"
                        Style="{StaticResource Button.Primary}" />
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </ctrl:WorkspacePageChrome.Body>
  </ctrl:WorkspacePageChrome>
</UserControl>
