<UserControl x:Class="QubiCostElectrical.Wpf.Features.Delivery.OfferSettingsEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="OfferTabStrip" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" HorizontalAlignment="Left"
                      Background="{DynamicResource Brush.Surface2}"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      CornerRadius="8" Padding="3">
                <TabPanel IsItemsHost="True" Background="Transparent" />
              </Border>
              <ContentPresenter Grid.Row="1" Margin="0,14,0,0" ContentSource="SelectedContent" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OfferTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBg" Background="Transparent" CornerRadius="6" Padding="12,6" Margin="1">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBg" Property="Background" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBg" Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="TabBg" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.10" ShadowDepth="1" Direction="270" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <TabControl Style="{StaticResource OfferTabStrip}"
              ItemContainerStyle="{StaticResource OfferTabItem}"
              SelectedIndex="0">

    <!-- ══ Pestaña 1 · Empresa y firma ══════════════════════════ -->
    <TabItem Header="Empresa y firma">
      <StackPanel>
        <TextBlock Text="Oferta" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <TextBlock Text="Título de la oferta" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding OfferTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
            <TextBlock Text="Número de oferta" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding OfferNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
            <TextBlock Text="Revisión" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding RevisionTag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
            <TextBlock Text="Fecha de oferta" Style="{StaticResource Text.Caption}" />
            <DatePicker SelectedDate="{Binding OfferDate, Mode=TwoWay}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Validez (días)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding ValidityDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Duración del proyecto" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding ProjectDuration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Destinatario y referencias" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,8" />
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Destinatario" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Empresa destinatario (Mandante)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding RecipientCompany, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Logo Mandante / Cliente (Ruta imagen)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding ClientLogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Logo Contratista / Empresa (Ruta imagen)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Referencia" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
        </StackPanel>
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Oferta por montaje de" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding MontajeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
        </StackPanel>

        <TextBlock Text="Carta" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,8" />
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Título de la carta" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding PresentationLetterTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
        </StackPanel>

        <TextBlock Text="Empresa" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,8" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Empresa" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="RUT empresa" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding CompanyRut, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="Dirección" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
        </StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Teléfono empresa" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Email empresa" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Sitio web" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding CompanyWebsite, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
        </StackPanel>

        <TextBlock Text="Firma autorizada" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,8" />
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Firma — nombre" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Cargo" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureRole, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Teléfono firmante" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignaturePhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Email firmante" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="N° Licencia / Registro SEC" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureRegistroSec, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Clase Licencia SEC (A, B, C, D)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureSecClass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Ancho de firma (mm)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureWidthMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                     ToolTip="Ancho de la imagen de la firma en los PDF, en milímetros (predeterminado 46)." />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Alto de firma (mm)" Style="{StaticResource Text.Caption}" />
            <TextBox Text="{Binding SignatureHeightMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                     ToolTip="Alto de la imagen de la firma en los PDF, en milímetros (predeterminado 16)." />
          </StackPanel>
        </Grid>

        <TextBlock Text="Textos de la oferta" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,8" />
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="Condiciones comerciales" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding CommercialConditionsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="Alcance" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding ScopeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="Exclusiones" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Observaciones" Style="{StaticResource Text.Caption}" />
          <TextBox Text="{Binding ObservationsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <TextBlock Text="Opciones" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,8" />
        <CheckBox Content="Incluir nota de IVA" IsChecked="{Binding IncludeIvaNote}" Margin="0,0,0,6" />
        <CheckBox Content="Mostrar desglose de Precios Unitarios en Itemizado (desmarcar para Suma Alzada / Llave en mano)" IsChecked="{Binding ShowUnitPricesInItemizado}" Margin="0,0,0,6" />
        <CheckBox Content="Mostrar gráfico de distribución de costos (Materiales vs MO vs Equipos) en Resumen Ejecutivo" IsChecked="{Binding ShowCostComponentDistribution}" Margin="0,0,0,4" />
      </StackPanel>
    </TabItem>

    <!-- ══ Pestaña 2 · Carta de presentación ════════════════════ -->
    <TabItem Header="Carta de presentación">
      <StackPanel>
        <CheckBox Content="Incluir carta de presentación" IsChecked="{Binding IncludePresentationLetter}" Margin="0,0,0,10" />
        <TextBlock Text="Texto de la carta" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
        <TextBox Text="{Binding PresentationLetterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="Se adjunta al paquete de exportación cuando está activada."
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </TabItem>

    <!-- ══ Pestaña 3 · Planos del proyecto ══════════════════════ -->
    <TabItem Header="Antecedentes">
      <StackPanel>
        <TextBlock Text="{Binding PlanosHint}"
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <CheckBox Content="Incluir listado de planos / antecedentes en la carta" IsChecked="{Binding IncludeDrawingList}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="Traer planos subidos" Command="{Binding ImportUploadedPlanosCommand}"
                  Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,6,0" />
          <Button Content="Agregar plano" Command="{Binding AddPlanoCommand}"
                  Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,6,0" />
          <Button Content="Quitar" Command="{Binding RemovePlanoCommand}"
                  Style="{StaticResource Button.Secondary}" Padding="10,4" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Planos}"
                  SelectedItem="{Binding SelectedPlano, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="28"
                  MaxHeight="260"
                  Style="{StaticResource DataGrid.Workspace}"
                  Margin="0,0,0,4">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                Width="130" />
            <DataGridTextColumn Header="Rev." Binding="{Binding Revision, UpdateSourceTrigger=PropertyChanged}"
                                Width="55" />
            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                Width="*" />
            <DataGridTextColumn Header="Disciplina" Binding="{Binding Disciplina, UpdateSourceTrigger=PropertyChanged}"
                                Width="120" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Disciplina: Electricidad, Corrientes débiles o Telecomunicaciones. Cada una sale como sección propia. Si no hay planos de esa especialidad, no se imprime."
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </TabItem>

    <!-- ══ Pestaña 4 · Marcas de equipos ════════════════════════ -->
    <TabItem Header="Marcas de equipos">
      <StackPanel>
        <CheckBox Content="Incluir marcas de equipos en la carta" IsChecked="{Binding IncludeEquipmentBrands}" Margin="0,0,0,8" />
        <TextBlock Text="Tabla de marcas por categoría. Aparece como observación en la carta de oferta."
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="Agregar marca" Command="{Binding AddMarcaCommand}"
                  Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,6,0" />
          <Button Content="Eliminar seleccionado" Command="{Binding RemoveMarcaCommand}"
                  Style="{StaticResource Button.Secondary}" Padding="10,4" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Marcas}"
                  SelectedItem="{Binding SelectedMarca, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="28"
                  MaxHeight="240"
                  Style="{StaticResource DataGrid.Workspace}"
                  Margin="0,0,0,4">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}" Width="150" />
            <DataGridTextColumn Header="Marca" Binding="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" Width="180" />
            <DataGridTextColumn Header="Especificación" Binding="{Binding Especificacion, UpdateSourceTrigger=PropertyChanged}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Texto libre alternativo (una línea por marca, formato «Categoría : Marca»). Se usa si la tabla está vacía."
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" Margin="0,2,0,4" />
        <TextBox Text="{Binding EquipmentBrandsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </TabItem>

    <!-- ══ Pestaña 5 · Supuestos SEC / RIC ═════════════════════ -->
    <TabItem Header="Supuestos SEC / RIC">
      <StackPanel>
        <TextBlock Text="Marco normativo, pliegos RIC, ensayos y tramitación TE1" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
        <TextBox Text="{Binding NormativeAssumptionsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </TabItem>

  </TabControl>
</UserControl>
