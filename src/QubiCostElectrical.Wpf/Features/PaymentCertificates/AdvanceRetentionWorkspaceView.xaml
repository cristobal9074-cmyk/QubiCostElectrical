<UserControl x:Class="QubiCostElectrical.Wpf.Features.PaymentCertificates.AdvanceRetentionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Anticipos y Retenciones" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
          <Button Command="{Binding BackCommand}" Content="← Volver" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" />
          <Button Command="{Binding AddAdvanceCommand}" Content="Nuevo Anticipo" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- Advances -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12,0,12,6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Anticipos" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,8" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Advances}" SelectedItem="{Binding SelectedAdvance}"
                  AutoGenerateColumns="False" Background="Transparent"
                  AlternatingRowBackground="{DynamicResource Brush.AltRow}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Número" Binding="{Binding VisibleNumber}" Width="80" />
            <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat=\{0:N0\}}" Width="90" />
            <DataGridTextColumn Header="Saldo Actual" Binding="{Binding CurrentBalance, StringFormat=\{0:N0\}}" Width="90" />
            <DataGridTextColumn Header="Total Amortizado" Binding="{Binding TotalAmortized, StringFormat=\{0:N0\}}" Width="100" />
            <DataGridTextColumn Header="% Amortización" Binding="{Binding AmortizationPercentage, StringFormat=\{0:P2\}}" Width="90" />
            <DataGridTextColumn Header="Tipo" Binding="{Binding AdvanceType}" Width="80" />
            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=\{0:d\}}" Width="80" />
            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="80" />
            <DataGridTextColumn Header="Documento" Binding="{Binding DocumentReference}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- Retentions -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12,6,12,6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Retenciones" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,8" />
          <Button Command="{Binding ReleaseRetentionCommand}" Content="Liberar Retención" Style="{StaticResource Button.Secondary}" Margin="12,0,0,8" />
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Retentions}" SelectedItem="{Binding SelectedRetention}"
                  AutoGenerateColumns="False" Background="Transparent"
                  AlternatingRowBackground="{DynamicResource Brush.AltRow}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tipo" Binding="{Binding RetentionType}" Width="80" />
            <DataGridTextColumn Header="Base" Binding="{Binding BaseType}" Width="70" />
            <DataGridTextColumn Header="%" Binding="{Binding Percentage, StringFormat=\{0:P2\}}" Width="60" />
            <DataGridTextColumn Header="Monto Fijo" Binding="{Binding FixedAmount, StringFormat=\{0:N0\}}" Width="80" />
            <DataGridTextColumn Header="Límite" Binding="{Binding LimitAmount, StringFormat=\{0:N0\}}" Width="80" />
            <DataGridTextColumn Header="Vencimiento" Binding="{Binding ExpiryDate, StringFormat=\{0:d\}}" Width="80" />
            <DataGridTextColumn Header="Condición de Liberación" Binding="{Binding ReleaseCondition}" Width="120" />
            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="80" />
            <DataGridTextColumn Header="Observación" Binding="{Binding Observation}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
