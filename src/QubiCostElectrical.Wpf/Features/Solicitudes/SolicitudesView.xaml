<UserControl x:Class="QubiCostElectrical.Wpf.Features.Solicitudes.SolicitudesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Solicitudes"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M22 2 11 13 M22 2l-7 20-4-9-9-4 20-7z"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para gestionar solicitudes de materiales y EPP.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <!-- App Shell Workspace Frame -->
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="20,20,24,20"
            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- View Title & Top Actions -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Modern Document ID badge -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="8" Padding="8,5" Margin="0,0,12,0" VerticalAlignment="Center"
                    ToolTip="Código correlativo de la solicitud actual">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CodigoSolicitud}" FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.BlueFocus}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="📦 LOGÍSTICA &amp; BODEGA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" /></Border>
                <TextBlock Text="Solicitudes de Faena" Style="{StaticResource Text.ViewTitle}" VerticalAlignment="Center" />
                <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="{StaticResource Radius.Chip}"
                        Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Blue}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Requerimiento de insumos críticos, canalización y herramientas para cuadrilla de terreno"
                         FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Secondary}" Content="Enviar" Command="{Binding SendSolicitudCommand}" Margin="0,0,6,0" ToolTip="Enviar solicitud por correo a adquisiciones" />
            <Button Style="{StaticResource Button.Secondary}" Content="Importar" Command="{Binding ImportPacketCommand}" Margin="0,0,6,0" Visibility="{Binding CanImportSolicitud, Converter={StaticResource BoolToVisibility}}" ToolTip="Importar paquete de pedido .qce-req" />
            <Button Style="{StaticResource Button.Secondary}" Content="Exportar paquete" Command="{Binding ExportPacketCommand}" Margin="0,0,6,0" ToolTip="Exportar como paquete portátil .qce-req" />
            <Button Style="{StaticResource Button.Secondary}" Content="Guardar" Command="{Binding SaveCommand}" Margin="0,0,6,0" MinWidth="85" />
            <Button Style="{StaticResource Button.Secondary}" Content="📊 Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,6,0" MinWidth="85" />
            <Button Style="{StaticResource Button.Primary}" Content="🖨️ PDF / Imprimir" Click="OnPrintClick" MinWidth="130" FontWeight="SemiBold" />
          </StackPanel>
        </DockPanel>

        <!-- Main Split Workspace Layout -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="295" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Sidebar (Left Pane) -->
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card.FormSection}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="12" Padding="18">
              <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,16">
                  <TextBlock DockPanel.Dock="Left" Text="Ficha de Pedido" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                  <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                  </Border>
                </DockPanel>

                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="CÓDIGO SOLICITUD" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,5" />
                  <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <TextBlock Text="{Binding CodigoSolicitud, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Blue}" />
                  </Border>
                </StackPanel>
                
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="OBRA / PROYECTO" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,5" />
                  <TextBox Style="{StaticResource Form.TextBox}" Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="SOLICITADO POR" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,5" />
                  <TextBox Style="{StaticResource Form.TextBox}" Text="{Binding RequestedBy, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="FECHA SOLICITUD" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,5" />
                  <TextBox Style="{StaticResource Form.TextBox}" Text="{Binding RequestDate, Mode=TwoWay}" IsEnabled="False" />
                </StackPanel>
                
                <StackPanel Margin="0,0,0,16">
                  <TextBlock Text="TIPO DE DOCUMENTO" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,5" />
                  <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="Planilla de Pedido Interno" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" FontSize="12" />
                      <TextBlock Text="Abastecimiento de bodega y cuadrilla" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Approve Request Button (Only for Admin/Jefatura) -->
                <Button Style="{StaticResource Button.Primary}" 
                        Content="✓ Aprobar y Emitir a Compras" 
                        Command="{Binding ApproveSolicitudCommand}" 
                        Height="38"
                        FontWeight="Bold"
                        FontSize="12.5"
                        Background="#10B981"
                        BorderBrush="#059669"
                        Visibility="{Binding CanApproveSolicitud, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Tabs Work Area (Right Pane) -->
          <TabControl Grid.Column="2" Style="{StaticResource Form.TabControl}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            
            <!-- TAB 1: MATERIALS & TOOLS -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="📦 Materiales y herramientas" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Materiales.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card.Header}" Background="{DynamicResource Brush.Surface}" CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" Padding="14,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Listado de Insumos y Herramientas" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Brush.Ink}" />
                      <TextBlock Text="Materiales para reposición y cuadrilla de trabajo" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource Button.Secondary}" Content="🔍 Buscar en lista de compra…" Command="{Binding OpenMaterialPickerCommand}" Margin="0,0,8,0" Padding="10,6" />
                      <Button Style="{StaticResource Button.Primary}" Content="+ Agregar material" Command="{Binding AddMaterialCommand}" Padding="12,6" FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card.Surface}" CornerRadius="0" Padding="0" BorderThickness="1">
                  <DataGrid x:Name="MaterialesGrid"
                            ItemsSource="{Binding Materiales}"
                            Style="{StaticResource DataGrid.Workspace.Excel}"
                            infra:DataGridExcelNavigation.Enable="True"
                            infra:DataGridExcelNavigation.HandleDeleteByHost="True"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            HeadersVisibility="Column"
                            BorderThickness="0"
                            RowHeight="30"
                            PreparingCellForEdit="OnGridPreparingCellForEdit"
                            CellEditEnding="OnGridCellEditEnding"
                            PreviewTextInput="OnGridPreviewTextInput"
                            PreviewKeyDown="OnGridPreviewKeyDown"
                            SelectionChanged="OnGridSelectionChanged"
                            CurrentCellChanged="OnGridCurrentCellChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn x:Name="CodigoColumn" Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGrid.CellEditTransparent}" Width="130" />
                      <DataGridTextColumn x:Name="DescripcionColumn" Header="Descripción Material / Insumo" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGrid.CellEditTransparent}" Width="*" MinWidth="220" />
                      <DataGridTextColumn x:Name="UnidadColumn" Header="U.M." Binding="{Binding Unidad, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGrid.CellEditTransparent}" Width="70" HeaderStyle="{StaticResource DataGridColumnHeader.Center}" ElementStyle="{StaticResource Text.Center}" />
                      <DataGridTextColumn x:Name="CantidadColumn" Header="Cantidad" Binding="{Binding Cantidad, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}" EditingElementStyle="{StaticResource DataGrid.CellEditTransparent}" Width="90" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
                      <DataGridTemplateColumn Header="Enlace / Link" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Padding="4,2" />
                              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Abrir ↗" 
                                      Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                      CommandParameter="{Binding Link}"
                                      ToolTip="Abrir enlace en el navegador" 
                                      Height="22" Padding="6,0" FontSize="10.5" Margin="2,0,4,0"
                                      Visibility="{Binding Link, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}" />
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn x:Name="ObservacionesColumn" Header="Observaciones" Binding="{Binding Observaciones, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGrid.CellEditTransparent}" Width="220" />
                      <DataGridTemplateColumn x:Name="QuitarColumn" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Button Content="✕" 
                                    Command="{Binding DataContext.DeleteMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" FontSize="12" FontWeight="Bold" ToolTip="Quitar fila"
                                    Width="24" Height="22" Padding="0" HorizontalAlignment="Center">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                  <Setter Property="Opacity" Value="0.25" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                  <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter Property="Opacity" Value="1.0" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>

                <!-- Modern Table Summary Bar -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="14,8">
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Ghost}" Content="+ Agregar nueva línea de insumo" Command="{Binding AddMaterialCommand}" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Padding="4,2" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="Ítems: " FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Text="{Binding Materiales.Count}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,16,0" />
                      <TextBlock Text="Estado: " FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Grid>
            </TabItem>

            <!-- TAB 2: EPP (SAFETY) -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🛡️ EPP y seguridad" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Epps.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card.Header}" Background="{DynamicResource Brush.Surface}" CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" Padding="14,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Listado de EPP Requeridos" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Brush.Ink}" />
                      <TextBlock Text="Elementos de protección personal para dotación de faena" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="+ Agregar EPP" Command="{Binding AddEppCommand}" Padding="12,6" FontWeight="SemiBold" />
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card.Surface}" CornerRadius="0" Padding="0" BorderThickness="1">
                  <DataGrid ItemsSource="{Binding Epps}"
                            Style="{StaticResource DataGrid.Workspace}"
                            infra:DataGridExcelNavigation.Enable="True"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            HeadersVisibility="Column"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            BorderThickness="0"
                            RowHeight="30">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                      <DataGridTemplateColumn Header="Descripción Elemento EPP" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Padding="4,2" />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="U.M." Binding="{Binding Unidad, UpdateSourceTrigger=PropertyChanged}" Width="70" HeaderStyle="{StaticResource DataGridColumnHeader.Center}" ElementStyle="{StaticResource Text.Center}" />
                      <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="90" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
                      <DataGridTemplateColumn Header="Enlace / Link" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Padding="4,2" />
                              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Abrir ↗" 
                                      Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                      CommandParameter="{Binding Link}"
                                      ToolTip="Abrir enlace en el navegador" 
                                      Height="22" Padding="6,0" FontSize="10.5" Margin="2,0,4,0"
                                      Visibility="{Binding Link, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}" />
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" Width="250" />
                      <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Button Content="✕" 
                                    Command="{Binding DataContext.DeleteEppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" FontSize="12" FontWeight="Bold" ToolTip="Quitar fila"
                                    Width="24" Height="22" Padding="0" HorizontalAlignment="Center">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                  <Setter Property="Opacity" Value="0.25" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                  <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter Property="Opacity" Value="1.0" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>

                <!-- Modern Table Summary Bar -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="14,8">
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Ghost}" Content="+ Agregar elemento EPP" Command="{Binding AddEppCommand}" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Padding="4,2" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="Total EPP: " FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" />
                      <TextBlock Text="{Binding Epps.Count}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Grid>
            </TabItem>

            <!-- TAB 3: HISTORIAL DE SOLICITUDES -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🕒 Historial de solicitudes" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HistorialSolicitudes.Count}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card.Header}" Background="{DynamicResource Brush.Surface}" CornerRadius="10,10,0,0" BorderThickness="1,1,1,0" Padding="14,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Historial de Solicitudes Emitidas del Proyecto" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Brush.Ink}" />
                      <TextBlock Text="Registro permanente de pedidos emitidos y aprobados en la obra" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Auditoría de pedidos" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" />
                  </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card.Surface}" CornerRadius="0,0,10,10" Padding="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna Izquierda: Lista de solicitudes pasadas -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="8">
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="SOLICITUDES REGISTRADAS" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="6,4,6,8" />
                        <ListBox ItemsSource="{Binding HistorialSolicitudes}"
                                 SelectedItem="{Binding SelectedHistorialSolicitud, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="Margin" Value="0,0,0,6" />
                              <Setter Property="Background" Value="Transparent" />
                            </Style>
                          </ListBox.ItemContainerStyle>
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="10,8">
                                <StackPanel>
                                  <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Codigo}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Blue}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                      <Border.Style>
                                        <Style TargetType="Border">
                                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsAprobado}" Value="True">
                                              <Setter Property="Background" Value="#2210B981" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Border.Style>
                                      <TextBlock Text="{Binding Estado}" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding EsAprobado}" Value="True">
                                                <Setter Property="Foreground" Value="#10B981" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                    </Border>
                                  </DockPanel>

                                  <TextBlock Text="{Binding SolicitadoPor, StringFormat={}👤 {0}}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,2" />
                                  <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Fecha, StringFormat={}📅 {0}}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemsSummaryText, StringFormat={}📦 {0}}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                                  </DockPanel>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </DockPanel>
                    </Border>

                    <!-- Columna Derecha: Detalle de la Solicitud Seleccionada -->
                    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="14">
                      <Grid>
                        <!-- Estado vacío si no hay selección -->
                        <Border Visibility="{Binding HasSelectedHistorial, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                          <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Seleccione una solicitud del historial" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" />
                            <TextBlock Text="Haga clic en la lista de la izquierda para ver su detalle de materiales y EPP." Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                          </StackPanel>
                        </Border>

                        <!-- Panel de detalle con grilla -->
                        <Grid Visibility="{Binding HasSelectedHistorial, Converter={StaticResource BoolToVisibility}}">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>

                          <!-- Encabezado del Detalle -->
                          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedHistorialSolicitud.Codigo, StringFormat={}Detalle Solicitud: {0}}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.Ink}" />
                                <Border Background="#2210B981" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedHistorialSolicitud.EsAprobado, Converter={StaticResource BoolToVisibility}}">
                                  <TextBlock Text="✓ APROBADO" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding SelectedHistorialSolicitud.SolicitadoPor, StringFormat={}Solicitado por {0}}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Style="{StaticResource Button.Secondary}" Content="📄 Ver PDF"
                                      Command="{Binding ExportarHistorialPdfCommand}"
                                      CommandParameter="{Binding SelectedHistorialSolicitud}"
                                      Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                              <Button Style="{StaticResource Button.Secondary}" Content="📊 Excel"
                                      Command="{Binding ExportarHistorialExcelCommand}"
                                      CommandParameter="{Binding SelectedHistorialSolicitud}"
                                      Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                              <Button Style="{StaticResource Button.Primary}" Content="📋 Reutilizar como borrador"
                                      Command="{Binding ReutilizarSolicitudCommand}"
                                      CommandParameter="{Binding SelectedHistorialSolicitud}"
                                      Padding="10,4" FontSize="11" />
                            </StackPanel>
                          </DockPanel>

                          <!-- Grilla de Ítems de la Solicitud Seleccionada -->
                          <DataGrid Grid.Row="1"
                                    ItemsSource="{Binding SelectedHistorialSolicitud.Items}"
                                    Style="{StaticResource DataGrid.Workspace}"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    IsReadOnly="True"
                                    HeadersVisibility="Column"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow">
                            <DataGrid.Columns>
                              <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70" />
                              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" FontWeight="SemiBold" />
                              <DataGridTextColumn Header="Descripción Material / Insumo" Binding="{Binding Descripcion}" Width="*" MinWidth="180" />
                              <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="50" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
                              <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:N0}}" Width="80" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
                              <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="180" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Grid>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Grid>
    </Border>

    <!-- Popup autocompletado en celdas de Código y Descripción -->
    <Popup x:Name="AutocompletePopup" StaysOpen="True"
           IsOpen="{Binding AutocompleteVisible}"
           Placement="Bottom"
           AllowsTransparency="True"
           Focusable="False">
      <Border Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="6" MaxHeight="320" MinWidth="520" Width="520"
              SnapsToDevicePixels="True"
              Focusable="False">
        <Grid Focusable="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ListBox x:Name="AutocompleteList" Grid.Row="0"
                   ItemsSource="{Binding AutocompleteResults}"
                   BorderThickness="0" Background="Transparent"
                   Focusable="False"
                   PreviewMouseLeftButtonDown="OnAutocompleteMouseLeftButtonDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4"
                              Padding="{TemplateBinding Padding}"
                              SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:SolicitudAutocompleteSuggestionVm}">
                <Grid Margin="0" MinHeight="42">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>

                  <!-- Sector identificación: código + material -->
                  <Border Grid.Column="0" Padding="10,5,8,5"
                          BorderBrush="{DynamicResource Brush.Line}"
                          BorderThickness="0,0,1,0"
                          Background="Transparent">
                    <StackPanel VerticalAlignment="Center">
                      <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Unidad}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                        </Border>
                        <TextBlock Text="{Binding Codigo}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}"
                                   TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Text="{Binding Descripcion}" FontSize="11"
                                 Foreground="{DynamicResource Brush.Ink2}"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <!-- Sector cubicación / disponibilidad -->
                  <Border Grid.Column="1" Padding="8,4,8,4"
                          Background="{DynamicResource Brush.Surface2}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <!-- Cubicado -->
                      <DockPanel Grid.Row="0">
                        <TextBlock Text="CUB" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Width="32" />
                        <TextBlock Text="{Binding CantidadCubicadaDisplay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}" />
                      </DockPanel>

                      <!-- Disponible -->
                      <DockPanel Grid.Row="1" Margin="0,2,0,0">
                        <TextBlock Text="DISP" FontSize="10" FontWeight="Bold" Width="32">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDisponible}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAgotado}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CantidadDisponibleDisplay}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDisponible}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAgotado}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DockPanel>
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Barra inferior con atajos de teclado para la selección -->
          <Border Grid.Row="1" Background="{DynamicResource Brush.Surface2}"
                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                  Padding="10,6" Focusable="False">
            <DockPanel LastChildFill="True" Focusable="False">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                  <TextBlock Text="▲ ▼" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                </Border>
                <TextBlock Text="Navegar" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />

                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                  <TextBlock Text="↵ Enter" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                </Border>
                <TextBlock Text="Seleccionar" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />

                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                  <TextBlock Text="Esc" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                </Border>
                <TextBlock Text="Cerrar" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Text="Lista de compra" Style="{StaticResource Text.Caption}"
                         Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
