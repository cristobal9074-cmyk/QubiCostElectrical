<Window x:Class="QubiCostElectrical.Wpf.Features.Solicitudes.SolicitudMaterialPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Solicitudes"
        Style="{StaticResource Dialog.Window}"
        Title="Seleccionar Materiales desde Lista de Compra / Cubicación"
        Width="960" Height="680" MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">

  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
    <Grid Background="{DynamicResource Brush.Canvas}">
      <Grid.RowDefinitions>
        <!-- Header -->
        <RowDefinition Height="Auto" />
        <!-- Search & Filters -->
        <RowDefinition Height="Auto" />
        <!-- Table -->
        <RowDefinition Height="*" />
        <!-- Footer -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header Section -->
      <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="20,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Materiales Cubicados del Proyecto" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Seleccione los insumos de la lista de compra para agregarlos a la solicitud con su código y unidad oficiales."
                       FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
          </StackPanel>

          <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Blue}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="LISTA DE COMPRA / CUBICACIÓN" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Search & Filters Bar -->
      <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" x:Name="TxtSearch"
                   Style="{StaticResource Form.SearchBox}"
                   Tag="Buscar por código o descripción del material…"
                   TextChanged="OnSearchTextChanged" />

          <ComboBox Grid.Column="2" x:Name="CmbCategory"
                    Style="{StaticResource Form.ComboBox}"
                    SelectionChanged="OnCategorySelectionChanged" />

          <TextBlock Grid.Column="4" x:Name="TxtCount"
                     VerticalAlignment="Center"
                     Style="{StaticResource Text.Caption}"
                     Foreground="{DynamicResource Brush.Muted}" />
        </Grid>
      </Border>

      <!-- Table Section -->
      <Border Grid.Row="2" Background="{DynamicResource Brush.Canvas}" Padding="20,12">
        <DataGrid x:Name="DgMaterials"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OnGridDoubleClick"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Line}">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding TieneSobrepedido}" Value="True">
                  <Setter Property="Background" Value="#15EF4444" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <!-- Checkbox Column -->
            <DataGridTemplateColumn Width="40">
              <DataGridTemplateColumn.Header>
                <CheckBox x:Name="ChkSelectAll" Click="OnSelectAllClick" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" FontWeight="SemiBold" IsReadOnly="True" />
            <DataGridTextColumn Header="Descripción Material / Insumo" Binding="{Binding Descripcion}" Width="*" MinWidth="220" IsReadOnly="True" />
            <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="50" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" IsReadOnly="True" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100" IsReadOnly="True" />
            <DataGridTextColumn Header="Cubicado" Binding="{Binding CantidadCubicada, StringFormat={}{0:N0}}" Width="90"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" IsReadOnly="True" />
            <DataGridTextColumn Header="Ya Pedido" Binding="{Binding CantidadSolicitada, StringFormat={}{0:N0}}" Width="90"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" IsReadOnly="True" />
            <DataGridTextColumn Header="Disponible" Binding="{Binding CantidadDisponible, StringFormat={}{0:N0}}" Width="95"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TieneSobrepedido}" Value="True">
                      <Setter Property="Foreground" Value="#EF4444" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TieneSobrepedido}" Value="False">
                      <Setter Property="Foreground" Value="#10B981" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Footer Action Buttons -->
      <Border Grid.Row="3" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0" Padding="20,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="💡 Consejo: Puedes hacer doble clic en una fila para agregarla directamente."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" Click="OnCancelClick" Margin="0,0,10,0" MinWidth="100" />
            <Button Style="{StaticResource Button.Primary}" Content="+ Agregar seleccionados a la solicitud" Click="OnAddClick" MinWidth="240" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
