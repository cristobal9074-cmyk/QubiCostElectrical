<Window x:Class="QubiCostElectrical.Wpf.Features.Solicitudes.SolicitudPdfPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
        Style="{StaticResource Dialog.Window}"
        Title="Previsualización de Solicitud de Pedido"
        Width="920" Height="820" MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
  
  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <!-- Premium Top Bar Banner -->
      <RowDefinition Height="Auto" />
      <!-- Content Panel -->
      <RowDefinition Height="*" />
      <!-- Action Footer -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header Section (Slate Card Header Style) -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Vista Previa de Solicitud de Pedido" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Text="Revisa la diagramación, firma y los ítems de materiales/EPP del reporte antes de guardarlo o imprimirlo."
                     FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Brand Icon / Accent indicator -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Blue}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="PLANILLA DE PEDIDO" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- PDF Viewer Panel -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Canvas}" Padding="24,16">
      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1" CornerRadius="8" Padding="1" Background="{DynamicResource Brush.Surface}">
        <ctrl:PdfPreviewPanel DataContext="{Binding PreviewVm}" />
      </Border>
    </Border>

    <!-- Footer Action Buttons (Bottom Bar) -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <!-- Left: Status/File path indicator -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Text="Estado:" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}" TextTrimming="CharacterEllipsis" MaxWidth="450" />
        </StackPanel>

        <!-- Right Actions -->
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Secondary}" Content="Cerrar" IsCancel="True" Click="OnCloseClick" MinWidth="90" Height="34" Margin="0,0,10,0" />
          <Button Style="{StaticResource Button.Secondary}" Content="Guardar como…" Click="OnSaveClick" Margin="0,0,10,0" MinWidth="130" Height="34" />
          <Button Style="{StaticResource Button.Primary}" Content="Imprimir reporte" Click="OnPrintClick" MinWidth="140" Height="34" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
