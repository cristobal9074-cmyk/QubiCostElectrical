<Window x:Class="QubiCostElectrical.Wpf.Features.Solicitudes.SolicitudExcelPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Previsualización de Documento Excel"
        Width="960" Height="680" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">

  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <!-- Header Banner -->
      <RowDefinition Height="Auto" />
      <!-- Tabs and Grids Content -->
      <RowDefinition Height="*" />
      <!-- Footer Actions -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header Section (Slate Card Header Style) -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Vista Previa de Archivo Excel (.xlsx)" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Text="Previsualiza la distribución de columnas, hojas y metadatos del libro de cálculo que se exportará."
                     FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Accent indicator -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Green}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="HOJA DE CÁLCULO EXCEL" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- TabControl Content (Emulating Excel Sheets) -->
    <TabControl Grid.Row="1" Margin="24,16" Background="Transparent" BorderThickness="0">
      
      <!-- Sheet 1: Materiales e Insumos -->
      <TabItem Header="Materiales e Insumos">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Sheet Metadata Box -->
          <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Obra / Proyecto:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Obra}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
              
              <TextBlock Grid.Column="2" Text="Solicitado por:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="24,0,8,0" />
              <TextBlock Grid.Column="3" Text="{Binding SolicitadoPor}" Foreground="{DynamicResource Brush.Ink}" />
            </Grid>
          </Border>

          <!-- Excel styled DataGrid -->
          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" CornerRadius="8" Padding="0">
            <DataGrid ItemsSource="{Binding Materiales}"
                      Style="{StaticResource DataGrid.Workspace}"
                      infra:DataGridExcelNavigation.Enable="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                <DataGridTextColumn Header="Descripción Material / Insumo" Binding="{Binding Descripcion}" Width="*" />
                <DataGridTextColumn Header="U.M." Binding="{Binding Unidad}" Width="80" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:N0}}" Width="100" />
                <DataGridTextColumn Header="Enlace / Link" Binding="{Binding Link}" Width="180" />
                <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="200" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <!-- Sheet 2: EPP -->
      <TabItem Header="EPP (Elementos de Protección Personal)">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Sheet Metadata Box -->
          <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Obra / Proyecto:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Obra}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
              
              <TextBlock Grid.Column="2" Text="Solicitado por:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="24,0,8,0" />
              <TextBlock Grid.Column="3" Text="{Binding SolicitadoPor}" Foreground="{DynamicResource Brush.Ink}" />
            </Grid>
          </Border>

          <!-- Excel styled DataGrid -->
          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" CornerRadius="8" Padding="0">
            <DataGrid ItemsSource="{Binding Epps}"
                      Style="{StaticResource DataGrid.Workspace}"
                      infra:DataGridExcelNavigation.Enable="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                <DataGridTextColumn Header="Descripción Elemento EPP" Binding="{Binding Descripcion}" Width="*" />
                <DataGridTextColumn Header="U.M." Binding="{Binding Unidad}" Width="80" />
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:N0}}" Width="100" />
                <DataGridTextColumn Header="Enlace / Link" Binding="{Binding Link}" Width="180" />
                <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="200" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Footer Action Buttons (Bottom Bar) -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Text="Pestañas de salida:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" />
          <TextBlock Text="[Materiales e Insumos]  |  [EPP]" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" FontSize="11" />
        </StackPanel>

        <!-- Right Actions -->
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Primary}" Content="Exportar y guardar Excel…" Click="OnSaveClick" Margin="0,0,8,0" MinWidth="180" Height="32" />
          <Button Style="{StaticResource Button.Secondary}" Content="Cerrar" IsCancel="True" Click="OnCloseClick" MinWidth="90" Height="32" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
