<UserControl x:Class="QubiCostElectrical.Wpf.Features.EconomicEditor.EconomicEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.EconomicEditor">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Editor Económico" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Command="{Binding CalculateCommand}" Content="Recalcular" Style="{StaticResource Button.Primary}" Margin="16,0,0,0" />
        <Button Command="{Binding AddConceptCommand}" Content="+ Añadir concepto" Style="{StaticResource Button.Secondary}" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Concepts}" AutoGenerateColumns="False"
              Background="{DynamicResource Brush.Surface}" Margin="12,0"
              AlternatingRowBackground="{DynamicResource Brush.AltRow}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Código" Binding="{Binding ConceptCode}" Width="100" />
        <DataGridTextColumn Header="Concepto" Binding="{Binding ConceptName}" Width="200" />
        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" />
        <DataGridTextColumn Header="Tipo" Binding="{Binding ConceptType}" Width="100" />
        <DataGridTextColumn Header="Base" Binding="{Binding BaseType}" Width="130" />
        <DataGridTextColumn Header="Tasa/Importe" Binding="{Binding RateOrAmount}" Width="110" />
        <DataGridTextColumn Header="Orden" Binding="{Binding SortOrder}" Width="60" />
        <DataGridTextColumn Header="V. Calculado" Binding="{Binding CalculatedValue}" Width="110" />
        <DataGridTextColumn Header="Subtotal A." Binding="{Binding SubtotalBefore}" Width="110" />
        <DataGridTextColumn Header="Subtotal D." Binding="{Binding SubtotalAfter}" Width="110" />
        <DataGridCheckBoxColumn Header="Informativo" Binding="{Binding IsInformative}" Width="80" />
        <DataGridCheckBoxColumn Header="En Total" Binding="{Binding IncludedInTotal}" Width="80" />
        <DataGridTemplateColumn Header="Acción" Width="70">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Eliminar" Command="{Binding DataContext.RemoveConceptCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                      CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <StackPanel Orientation="Horizontal">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Costo Directo:" Style="{StaticResource Text.Strong}" />
          <TextBlock Text="{Binding DirectCost, StringFormat=N0}" Style="{StaticResource Text.Body}" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Costo Total:" Style="{StaticResource Text.Strong}" />
          <TextBlock Text="{Binding TotalCost, StringFormat=N0}" Style="{StaticResource Text.Body}" Margin="4,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
