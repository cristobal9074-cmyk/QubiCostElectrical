<UserControl x:Class="QubiCostElectrical.Wpf.Features.EarnedValueWorkspace.EarnedValueWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
      <Grid>
        <StackPanel>
          <TextBlock Text="Valor ganado (EVM) — PMI" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
          <TextBlock Text="PV · EV · AC · BAC · EAC · ETC · VAC · SV · CV · SPI · CPI · TCPI. Solo lectura de plan/baseline/avance; sin recalcular CPM."
                     FontSize="12" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="BAC opcional:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Text="{Binding BacInput, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0"/>
        <Button Content="Calcular" Command="{Binding CalculateCommand}" Margin="0,0,8,0" Padding="12,6" Background="#1D4ED8" Foreground="White"/>
        <Button Content="Snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,8,0" Padding="12,6"/>
        <Button Content="Comparar" Command="{Binding CompareCommand}" Margin="0,0,8,0" Padding="12,6"/>
        <Button Content="Exportar CSV" Command="{Binding ExportCommand}" Margin="0,0,8,0" Padding="12,6"/>
        <Button Content="Actualizar" Command="{Binding RefreshCommand}" Padding="12,6"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8">
        <DataGrid ItemsSource="{Binding Indicators}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Indicador" Binding="{Binding Name}" Width="120"/>
            <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="100"/>
            <DataGridTextColumn Header="Semáforo" Binding="{Binding Light}" Width="80"/>
            <DataGridTextColumn Header="Interpretación" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
        <StackPanel>
          <TextBlock Text="Explicación" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="Comparación de snapshots" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshotA}" DisplayMemberPath="Version" Margin="0,0,0,6"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshotB}" DisplayMemberPath="Version" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding ComparisonText}" TextWrapping="Wrap" Foreground="#312E81"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8">
      <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Fecha estado" Binding="{Binding StatusDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
          <DataGridTextColumn Header="PV" Binding="{Binding Pv}" Width="80"/>
          <DataGridTextColumn Header="EV" Binding="{Binding Ev}" Width="80"/>
          <DataGridTextColumn Header="AC" Binding="{Binding Ac}" Width="80"/>
          <DataGridTextColumn Header="SPI" Binding="{Binding Spi}" Width="70"/>
          <DataGridTextColumn Header="CPI" Binding="{Binding Cpi}" Width="70"/>
          <DataGridTextColumn Header="EAC" Binding="{Binding Eac}" Width="90"/>
          <DataGridTextColumn Header="Usuario" Binding="{Binding RecordedBy}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="#374151"/>
  </Grid>
</UserControl>
