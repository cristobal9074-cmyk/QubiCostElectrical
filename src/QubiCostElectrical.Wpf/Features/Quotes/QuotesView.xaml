<UserControl x:Class="QubiCostElectrical.Wpf.Features.Quotes.QuotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             KeyDown="OnUserControlKeyDown">
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportQuoteCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <Style x:Key="QuotesNumericCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </UserControl.Resources>
  <DockPanel Background="{DynamicResource Brush.Canvas}" Margin="20,14,20,14">
    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando cotizaciones…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

    <!-- View header Siempre Visible -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left">
        <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.BlueFocus}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,3" HorizontalAlignment="Left"><TextBlock Text="GESTIÓN DE PROVEEDORES &amp; COTIZACIONES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" /></Border>
        <TextBlock Text="Cotizaciones de Proveedores" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
        <TextBlock Text="Comparativa de ofertas por material, análisis de ahorro comercial y aplicación de mejores precios." FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource Button.Primary}" Content="Aplicar selección al banco"
                Command="{Binding ApplySelectionToBankCommand}" Margin="0,0,6,0"
                ToolTip="Aplica la cotización del proveedor seleccionado al catálogo central del banco de precios" />
        <Button Style="{StaticResource Button.Secondary}" Content="Aplicar mejores precios al proyecto"
                Command="{Binding ApplyAllBestPricesCommand}" Margin="0,0,6,0"
                ToolTip="Aplica automáticamente los mejores precios comparados al proyecto activo" />
        <Button Style="{StaticResource Button.Secondary}" Content="Importar cotización (Ctrl+I)" Margin="0,0,6,0" Command="{Binding ImportQuoteCommand}"
                ToolTip="Importar cotización de proveedor desde archivo Excel o CSV (Ctrl+I)" />
      </StackPanel>
    </DockPanel>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <!-- Empty state con dropzone interactiva de 2px punteada -->
      <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}"
                Padding="32">
          <StackPanel HorizontalAlignment="Center">
            <Grid x:Name="EmptyDropZonePanel"
                  AllowDrop="True"
                  Cursor="Hand"
                  ToolTip="Arrastra archivos de cotización Excel (.xlsx, .xls, .csv) o PDF (.pdf) aquí, o haz clic para examinar"
                  DragEnter="OnDropZoneDragEnter"
                  DragOver="OnDropZoneDragOver"
                  DragLeave="OnDropZoneDragLeave"
                  Drop="OnDropZoneDrop"
                  MouseLeftButtonUp="OnDropZoneClick"
                  Width="480" Height="220">
              <Rectangle x:Name="EmptyDropZoneBorder"
                         Stroke="{DynamicResource Brush.Blue}"
                         StrokeThickness="2"
                         StrokeDashArray="3 2"
                         RadiusX="10" RadiusY="10"
                         Fill="{DynamicResource Brush.Canvas}" />
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False">
                <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="24" Width="48" Height="48" Margin="0,0,0,12" HorizontalAlignment="Center">
                  <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M12 18v-6 M9 15l3-3 3 3"
                        Style="{StaticResource Icon.Vector}"
                        Stroke="{DynamicResource Brush.Blue}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Arrastra cotizaciones de proveedores aquí"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Compatible con planillas Excel (.xlsx, .xls, .csv) y documentos PDF (.pdf)"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,16" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="Examinar archivos (Ctrl+I)"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        Padding="18,6" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Border>

      <!-- Main 2-col layout: proveedores | detalle -->
      <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="240" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" MinWidth="520" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card.Section}" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <Grid>
              <TextBox x:Name="SearchBox"
                       Style="{StaticResource Form.SearchBox}"
                       Tag="Buscar proveedor o material… (Ctrl+F)"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Padding="26,4,24,4" />
              <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Icon.Vector.Sm}" Stroke="{DynamicResource Brush.Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
              <Button Style="{StaticResource Button.Ghost}"
                      Content=""
                      Padding="0"
                      Width="18" Height="18"
                      FontSize="10"
                      FontWeight="Bold"
                      Foreground="{DynamicResource Brush.Muted}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0"
                      Command="{Binding ClearSearchCommand}"
                      Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Limpiar búsqueda (Esc)" />
            </Grid>
            <ComboBox Style="{StaticResource Form.ComboBox}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Margin="0,8,0,0"
                      ToolTip="Filtrar por categoría" />
          </StackPanel>
        </Border>

        <!-- Zona Drag & Drop interactiva con borde punteado de 2px -->
        <Border Grid.Row="1" Margin="0,0,0,8" CornerRadius="{StaticResource Radius.Md}">
          <Grid x:Name="DropZonePanel"
                AllowDrop="True"
                Cursor="Hand"
                ToolTip="Arrastra archivos de cotización Excel (.xlsx, .xls, .csv) o PDF (.pdf) aquí, o haz clic para examinar"
                DragEnter="OnDropZoneDragEnter"
                DragOver="OnDropZoneDragOver"
                DragLeave="OnDropZoneDragLeave"
                Drop="OnDropZoneDrop"
                MouseLeftButtonUp="OnDropZoneClick"
                MinHeight="68">
            <Rectangle x:Name="DropZoneBorder"
                       Stroke="{DynamicResource Brush.Line}"
                       StrokeThickness="2"
                       StrokeDashArray="3 2"
                       RadiusX="6" RadiusY="6"
                       Fill="{DynamicResource Brush.Canvas}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,8" IsHitTestVisible="False">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path x:Name="DropZoneIcon"
                      Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M12 18v-6 M9 15l3-3 3 3"
                      Style="{StaticResource Icon.Vector.Sm}"
                      Stroke="{DynamicResource Brush.Blue}"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0" />
                <TextBlock x:Name="DropZoneTitle"
                           Text="Arrastrar cotización aquí"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Ink}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Excel (.xlsx, .xls) o PDF (.pdf)"
                         FontSize="9.5"
                         Foreground="{DynamicResource Brush.Muted}"
                         HorizontalAlignment="Center"
                         Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card.Section}" Padding="0">
          <DataGrid ItemsSource="{Binding FilteredProviderSummaries}"
                    SelectedItem="{Binding SelectedProvider}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    EnableRowVirtualization="True"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    Style="{StaticResource DataGrid.Workspace}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*" />
              <DataGridTextColumn Header="Mat." Binding="{Binding Materiales}" Width="58" />
              <DataGridTextColumn Header="Cat." Binding="{Binding Categorias}" Width="58" />
              <DataGridTextColumn Header="Prom." Binding="{Binding PrecioPromedioUf, StringFormat={}{0:N3}}" Width="80"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                  ElementStyle="{StaticResource QuotesNumericCell}" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource Button.Secondary}" Content="Aplicar mejor precio"
                    Command="{Binding ApplyPriceCommand}"
                    CommandParameter="{Binding SelectedComparisonRow}"
                    Margin="0,0,6,0"
                    ToolTip="Aplicar el mejor precio de la fila de comparación seleccionada al proyecto" />
            <Button Style="{StaticResource Button.Secondary}" Content="Actualizar (F5)" Command="{Binding RefreshCommand}" Margin="0,0,6,0"
                    ToolTip="Recargar cotizaciones y comparaciones (F5)" />
            <Button Style="{StaticResource Button.Ghost}" Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}"
                    ToolTip="Restablecer búsqueda y filtro de categoría (Esc)" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding SelectedProvider.Proveedor, TargetNullValue='Cotizaciones de proveedores'}" Style="{StaticResource Text.ViewTitle}" />
            <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Card.Section}" Padding="0">
            <Grid>
              <!-- Empty state cuando no hay proveedor seleccionado -->
              <ctrl:EmptyStateControl Visibility="{Binding SelectedProvider, Converter={StaticResource NullToVisibility}}"
                                      IconData="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"
                                      Title="Selecciona un proveedor"
                                      Description="Elige un proveedor del listado para inspeccionar sus materiales y el análisis comparativo de precios." />
              <DataGrid ItemsSource="{Binding ProviderEntries}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        EnableRowVirtualization="True"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        Style="{StaticResource DataGrid.Workspace}"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                  <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="260" />
                  <DataGridTextColumn Header="Cat." Binding="{Binding Categoria}" Width="100" />
                  <DataGridTextColumn Header="Precio CLP" Binding="{Binding PrecioClp, StringFormat={}$ {0:N0}}" Width="95"
                                      HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                      ElementStyle="{StaticResource QuotesNumericCell}" />
                  <DataGridTextColumn x:Name="PrecioUfColumn" Header="Precio UF" Binding="{Binding PrecioUf, StringFormat={}{0:N4}}" Width="85"
                                      HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                      ElementStyle="{StaticResource QuotesNumericCell}" />
                  <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="130" />
                  <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="110" />
                  <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPrecio, StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Card.Section}" Padding="0">
            <DataGrid ItemsSource="{Binding ComparisonRows}"
                      SelectedItem="{Binding SelectedComparisonRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      Style="{StaticResource DataGrid.Workspace}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" />
                <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorSeleccionado}" Width="130" />
                <DataGridTextColumn x:Name="SelectedUfColumn" Header="Precio UF" Binding="{Binding PrecioSeleccionado, StringFormat={}{0:N3}}" Width="82"
                                    HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                    ElementStyle="{StaticResource QuotesNumericCell}" />
                <DataGridTextColumn Header="Precio CLP" Binding="{Binding PrecioSeleccionadoClp, StringFormat={}$ {0:N0}}" Width="90"
                                    HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                    ElementStyle="{StaticResource QuotesNumericCell}" />
                <DataGridTextColumn Header="Mejor" Binding="{Binding ProveedorMejor}" Width="130" />
                <DataGridTextColumn x:Name="BestUfColumn" Header="Mejor UF" Binding="{Binding PrecioMejor, StringFormat={}{0:N3}}" Width="82"
                                    HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                    ElementStyle="{StaticResource QuotesNumericCell}" />
                <DataGridTextColumn Header="Mejor CLP" Binding="{Binding PrecioMejorClp, StringFormat={}$ {0:N0}}" Width="90"
                                    HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                    ElementStyle="{StaticResource QuotesNumericCell}" />
                <DataGridTextColumn x:Name="DeltaUfColumn" Header="Delta UF" Binding="{Binding DeltaUf, StringFormat={}{0:N3}}" Width="82"
                                    HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                    ElementStyle="{StaticResource QuotesNumericCell}" />
                <DataGridTextColumn Header="% Delta" Binding="{Binding DeltaPct, StringFormat={}{0:N1}%}" Width="72"
                                    HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"
                                    ElementStyle="{StaticResource QuotesNumericCell}" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    </Grid>
    </Grid>
  </DockPanel>
</UserControl>
