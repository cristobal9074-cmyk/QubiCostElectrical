<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScResumenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Resumen de Cubicación de Circuitos"
        Width="960" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="SegBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ResumenTab" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Padding" Value="12,10,12,8" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LineaFila" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsGrupo}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
          <Setter Property="Padding" Value="10,11,10,6" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
        </Trigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding EsGrupo}" Value="True" />
            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="LineaRow">
      <Border Style="{StaticResource LineaFila}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Nombre" Text="{Binding Nombre}" VerticalAlignment="Center"
                     FontSize="{StaticResource Font.Size.base}" Foreground="{DynamicResource Brush.Ink}" />
          <StackPanel x:Name="Cantidad" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Cantidad}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                       FontSize="{StaticResource Font.Size.base}" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="{Binding Unidad}" Margin="6,0,0,0" VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding EsGrupo}" Value="True">
          <Setter TargetName="Nombre" Property="FontSize" Value="11" />
          <Setter TargetName="Nombre" Property="FontWeight" Value="Bold" />
          <Setter TargetName="Nombre" Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
          <Setter TargetName="Cantidad" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding EsSubtotal}" Value="True">
          <Setter TargetName="Nombre" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="CorteTemplate">
      <StackPanel Margin="0,0,0,16">
        <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="14,12">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.lg}" Foreground="{DynamicResource Brush.Ink}" />
              <TextBlock Text="{Binding Detalle}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.sm}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}">
                <Run Text="{Binding Tuberia, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" /><Run Text=" ML tub." />
              </TextBlock>
              <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}">
                <Run Text="{Binding Conductor, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" /><Run Text=" ML cond." />
              </TextBlock>
              <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}">
                <Run Text="{Binding Cajas, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" /><Run Text=" cajas" />
              </TextBlock>
              <TextBlock Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}">
                <Run Text="{Binding Artefactos, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" /><Run Text=" art." />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
          <ItemsControl ItemsSource="{Binding Lineas}" ItemTemplate="{StaticResource LineaRow}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ZonaRow">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.base}" />
        <TextBlock Grid.Column="1" Text="{Binding Categoria}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Cantidad}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.base}" />
          <TextBlock Text="{Binding Unidad}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ZonaTemplate">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="10,0,0,8" />
        <ItemsControl ItemsSource="{Binding Filas}" ItemTemplate="{StaticResource ZonaRow}" />
        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="10,8,0,0">
          <DockPanel>
            <TextBlock Text="Subtotal" FontWeight="SemiBold" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="{Binding Subtotal}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
              <TextBlock Text="UN" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
        <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button Content="Generales" Click="OnSelectGeneralesClick">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPerspectiveGenerales}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Border Width="1" Background="{DynamicResource Brush.Line}" />
            <Button Content="Departamentos" Click="OnSelectDeptosClick">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPerspectiveDeptos}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Border>

        <StackPanel>
          <TextBlock Text="{Binding Eyebrow}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Text="{Binding ViewTitle}" FontSize="{StaticResource Font.Size.xl}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding PerspectiveSubtitle}" Foreground="{DynamicResource Brush.Ink2}" FontSize="{StaticResource Font.Size.sm}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
        <Button Content="Total" Click="OnTabTotalClick">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ResumenTab}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabTotal}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Por tablero" Click="OnTabTableroClick">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ResumenTab}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabTablero}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Por piso" Click="OnTabPisoClick">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ResumenTab}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabPiso}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="Artefactos por piso" Click="OnTabArtefactosClick">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource ResumenTab}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabArtefactos}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </StackPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" IsHitTestVisible="False" />

      <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0">
        <UniformGrid Columns="4">
          <StackPanel Margin="16,12">
            <TextBlock Text="TUBERÍA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.2xl}" FontWeight="SemiBold">
              <Run Text="{Binding Total.TuberiaMl, StringFormat={}{0:#,##0.##}, Mode=OneWay}" /><Run Text=" ML" FontFamily="{StaticResource Font.Ui}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            </TextBlock>
          </StackPanel>
          <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0">
            <StackPanel Margin="16,12">
              <TextBlock Text="CONDUCTOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.2xl}" FontWeight="SemiBold">
                <Run Text="{Binding Total.ConductorMl, StringFormat={}{0:#,##0.##}, Mode=OneWay}" /><Run Text=" ML" FontFamily="{StaticResource Font.Ui}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0">
            <StackPanel Margin="16,12">
              <TextBlock Text="CAJAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.2xl}" FontWeight="SemiBold">
                <Run Text="{Binding Total.Cajas, Mode=OneWay}" /><Run Text=" UN" FontFamily="{StaticResource Font.Ui}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
              </TextBlock>
            </StackPanel>
          </Border>
          <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0">
            <StackPanel Margin="16,12">
              <TextBlock Text="ARTEFACTOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.2xl}" FontWeight="SemiBold">
                <Run Text="{Binding Total.Artefactos, Mode=OneWay}" /><Run Text=" UN" FontFamily="{StaticResource Font.Ui}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Border>

      <DockPanel Grid.Row="3" Margin="0,14,0,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.sm}" />
          <Border Width="240" HorizontalAlignment="Left" CornerRadius="8"
                  Background="{DynamicResource Brush.Surface2}"
                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
            <TextBox x:Name="FiltroBox" Style="{StaticResource Form.SearchBox}" Tag="Filtrar material"
                     Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" />
          </Border>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel Visibility="{Binding IsTabTotal, Converter={StaticResource BoolToVisibility}}">
              <Grid Margin="10,0,10,6">
                <TextBlock Text="MATERIAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Text="CANTIDAD" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding LineasTotal}" ItemTemplate="{StaticResource LineaRow}" />
              <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource Brush.Muted}"
                         Visibility="{Binding TotalSinFilas, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding TotalVacioTexto}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsTabTablero, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl ItemsSource="{Binding CortesTablero}" ItemTemplate="{StaticResource CorteTemplate}" />
              <TextBlock Margin="0,8,0,12" Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.sm}"
                         Visibility="{Binding TableroSinFilas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                         Text="El detalle de materiales es el mismo del total. Aquí solo cambia el corte." />
              <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                         Foreground="{DynamicResource Brush.Muted}"
                         Visibility="{Binding TableroSinFilas, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding TotalVacioTexto}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsTabPiso, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl ItemsSource="{Binding CortesPiso}" ItemTemplate="{StaticResource CorteTemplate}" />
              <TextBlock Margin="0,8,0,12" Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.sm}" TextWrapping="Wrap"
                         Visibility="{Binding PisoSinFilas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                         Text="La tubería y el conductor se reparten por piso. Cajas y artefactos siguen al circuito." />
              <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Muted}"
                         Visibility="{Binding PisoSinFilas, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding PisoVacioTexto}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsTabArtefactos, Converter={StaticResource BoolToVisibility}}">
              <Grid Margin="10,0,10,8" Visibility="{Binding ArtefactosSinFilas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MATERIAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Column="1" Text="CATEGORÍA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Column="2" Text="CANTIDAD" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ZonasArtefactos}" ItemTemplate="{StaticResource ZonaTemplate}" />
              <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Brush.Muted}"
                         Visibility="{Binding ArtefactosSinFilas, Converter={StaticResource BoolToVisibility}}"
                         Text="{Binding ArtefactosVacioTexto}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>

      <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Cerrar" MinWidth="110" IsCancel="True" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.sm}"
                   Text="Esc cierra · 1–4 pestañas · G / D perspectiva" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
