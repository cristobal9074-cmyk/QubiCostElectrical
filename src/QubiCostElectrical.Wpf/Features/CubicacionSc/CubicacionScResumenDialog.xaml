<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScResumenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.CubicacionSc"
        Style="{StaticResource Dialog.Window}"
        Title="Resumen C.SC"
        Width="820" Height="720" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
  <Window.Resources>
    <!-- Convertidor para el color de los indicadores -->
    <local:MaterialNameToBrushConverter x:Key="MaterialNameToBrush" />

    <!-- Fila de material (nombre / cantidad / unidad) estilo premium -->
    <DataTemplate x:Key="MaterialRow">
      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          
          <StackPanel Orientation="Horizontal" Grid.Column="0">
            <!-- Bullet indicator dot -->
            <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse.Fill>
                <Binding Path="Nombre" Converter="{StaticResource MaterialNameToBrush}" />
              </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="{Binding Nombre}" FontSize="12" FontFamily="{StaticResource Font.Ui}" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
          </StackPanel>
          
          <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="10,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Cantidad, StringFormat={}{0:#,##0.##}}" FontSize="12" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
              <TextBlock Text="{Binding Unidad}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="6,0,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Grupo (tablero o piso): cabecera + 4 subtotales + detalle de materiales -->
    <DataTemplate x:Key="GrupoTemplate">
      <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16" Padding="0">
        <StackPanel>
          <!-- Cabecera de la Tarjeta con fondo suave -->
          <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              
              <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <Border Width="36" Height="36" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" SnapsToDevicePixels="True">
                  <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M3,3 H21 V21 H3 Z M9,3 V21" Stroke="{DynamicResource Brush.Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                  <Border Background="{DynamicResource Brush.Ink}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Detalle}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                  </Border>
                </StackPanel>
              </StackPanel>
              
              <!-- Subtotales por categoría en formato premium chips -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tuberia -->
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                  <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TuberiaMl, StringFormat={}{0:#,##0.##}}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#059669" HorizontalAlignment="Right" />
                    <TextBlock Text="TUBERÍA (ML)" FontSize="8" FontWeight="SemiBold" Foreground="#059669" Opacity="0.8" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>
                <!-- Conductor -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                  <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ConductorMl, StringFormat={}{0:#,##0.##}}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#2563EB" HorizontalAlignment="Right" />
                    <TextBlock Text="CONDUCTOR (ML)" FontSize="8" FontWeight="SemiBold" Foreground="#2563EB" Opacity="0.8" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>
                <!-- Cajas -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                  <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Cajas}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#475569" HorizontalAlignment="Right" />
                    <TextBlock Text="CAJAS" FontSize="8" FontWeight="SemiBold" Foreground="#475569" Opacity="0.8" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>
                <!-- Artefactos -->
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,6">
                  <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Artefactos}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#D97706" HorizontalAlignment="Right" />
                    <TextBlock Text="ARTEFACTOS" FontSize="8" FontWeight="SemiBold" Foreground="#D97706" Opacity="0.8" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>
          <!-- Detalle -->
          <ItemsControl ItemsSource="{Binding Materiales}" ItemTemplate="{StaticResource MaterialRow}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado de la Vista -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Resumen · Cubicación Servicios Comunes" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Ui}" Foreground="{DynamicResource Brush.Ink}" />
      <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                 Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                 Text="Cantidad total de materiales del proyecto. Solo cuantifica (sin precio); el costeo va por APU." />
    </StackPanel>

    <!-- Pestañas de Navegación -->
    <TabControl Grid.Row="1" Style="{StaticResource Form.TabControl}">
      <!-- 1 · TOTAL -->
      <TabItem Header="Total resumen">
        <DockPanel Margin="0,10,0,0">
          <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <!-- Tuberia -->
            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Padding="16,12">
              <StackPanel>
                <TextBlock Text="{Binding Total.TuberiaMl, StringFormat={}{0:#,##0.##}}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#059669" />
                <TextBlock Text="Metros tubería" FontSize="11" FontWeight="Medium" Foreground="#059669" Opacity="0.8" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <!-- Conductor -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Padding="16,12">
              <StackPanel>
                <TextBlock Text="{Binding Total.ConductorMl, StringFormat={}{0:#,##0.##}}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#2563EB" />
                <TextBlock Text="Metros conductor" FontSize="11" FontWeight="Medium" Foreground="#2563EB" Opacity="0.8" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <!-- Cajas -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Padding="16,12">
              <StackPanel>
                <TextBlock Text="{Binding Total.Cajas}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#475569" />
                <TextBlock Text="Cajas" FontSize="11" FontWeight="Medium" Foreground="#475569" Opacity="0.8" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <!-- Artefactos -->
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="16,12">
              <StackPanel>
                <TextBlock Text="{Binding Total.Artefactos}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#D97706" />
                <TextBlock Text="Artefactos" FontSize="11" FontWeight="Medium" Foreground="#D97706" Opacity="0.8" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
          
          <Border Style="{StaticResource Card.Surface}" Padding="0">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Total.Materiales}" ItemTemplate="{StaticResource MaterialRow}" />
              </ScrollViewer>
              <TextBlock Visibility="{Binding TotalVacio, Converter={StaticResource BoolToVisibility}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                         Foreground="{DynamicResource Brush.Muted}" Text="Sin materiales cargados." />
            </Grid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- 2 · POR TABLERO -->
      <TabItem Header="Por tablero">
        <Grid Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PorTablero}" ItemTemplate="{StaticResource GrupoTemplate}" />
          </ScrollViewer>
          <TextBlock Visibility="{Binding TableroVacio, Converter={StaticResource BoolToVisibility}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Muted}" Text="Sin materiales cargados." />
        </Grid>
      </TabItem>

      <!-- 3 · POR PISO -->
      <TabItem Header="Por piso">
        <Grid Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PorPiso}" ItemTemplate="{StaticResource GrupoTemplate}" />
          </ScrollViewer>
          <TextBlock Visibility="{Binding PisoVacio, Converter={StaticResource BoolToVisibility}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" TextAlignment="Center"
                     Foreground="{DynamicResource Brush.Muted}"
                     Text="Sin materiales por piso.&#x0a;Asigna un piso a los circuitos en la columna «Ubicación / Pisos»." />
        </Grid>
      </TabItem>

      <!-- 4 · ARTEFACTOS POR PISO -->
      <TabItem Header="Artefactos por piso">
        <Grid Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ArtefactosPorPiso}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card.Surface}" Margin="0,0,0,16" Padding="0">
                    <StackPanel>
                      <!-- Cabecera de Piso con degradado o fondo suave -->
                      <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          
                          <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" SnapsToDevicePixels="True">
                              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M3,12h18M12,3v18" Stroke="{DynamicResource Brush.Ink2}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                              </Viewbox>
                            </Border>
                            <TextBlock Text="{Binding ZonaNombre}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                          </StackPanel>
                          
                          <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Total, StringFormat={}{0:#,##0.##}}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#D97706" />
                              <TextBlock Text=" UN" FontSize="8" FontWeight="SemiBold" Foreground="#D97706" Opacity="0.8" VerticalAlignment="Bottom" Margin="4,0,0,0" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Border>
                      
                      <!-- Detalle de Artefactos -->
                      <ItemsControl ItemsSource="{Binding Artefactos}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="16,10">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                  <Ellipse Width="8" Height="8" Fill="#D97706" Margin="0,0,12,0" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Nombre}" FontSize="12" FontFamily="{StaticResource Font.Ui}" FontWeight="Medium" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                                  <Border Background="{DynamicResource Brush.Canvas}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Categoria}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                                  </Border>
                                </StackPanel>
                                
                                <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Cantidad, StringFormat={}{0:#,##0.##}}" FontSize="12" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                                    <TextBlock Text="UN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="6,0,0,0" VerticalAlignment="Bottom" />
                                  </StackPanel>
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Visibility="{Binding ArtefactosVacio, Converter={StaticResource BoolToVisibility}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource Brush.Muted}" Text="Aún no hay artefactos cargados." />
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Botonera de Cierre -->
    <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}" LastChildFill="False" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Cerrar"
              MinWidth="110" IsDefault="True" IsCancel="True" />
    </DockPanel>
  </Grid>
</Window>

