<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.ResumenScTomarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Tomar de cubicación SC"
        Width="980" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock Text="Tomar material de servicios comunes" Style="{StaticResource Dialog.HeaderTitle}" />
      <TextBlock Text="Seleccione un material y ajuste cantidades por zona antes de tomarlo a la fila activa."
                 Style="{StaticResource Dialog.HeaderSubtitle}" />
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="12" Margin="0,0,12,0">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Style="{StaticResource Form.SearchBox}" Margin="0,0,0,10"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar material…" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SidebarFooterText}" FontSize="10"
                   Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Categorias}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8" Cursor="Hand"
                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      PreviewMouseDown="OnSidebarCategoriaClick">
                <DockPanel>
                  <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Brush.Muted}" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card.Surface}" Padding="0">
      <DataGrid x:Name="MaterialGrid"
                Style="{StaticResource DataGrid.Workspace.Excel}"
                infra:DataGridExcelNavigation.Enable="True"
                PreviewTextInput="MaterialGrid_PreviewTextInput"
                ItemsSource="{Binding FlatRows}"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                SelectionMode="Single"
                SelectionUnit="FullRow" />
    </Border>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Dialog.Footer}" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="{Binding MaterialCountText}" VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Muted}" />
      <Button x:Name="TomarButton" DockPanel.Dock="Right" Content="Tomar seleccionado"
              Style="{StaticResource Button.Primary}" MinWidth="140" Margin="8,0,0,0"
              Click="OnFooterTomarClick" />
      <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Button.Secondary}"
              MinWidth="100" IsCancel="True" Command="{Binding CerrarCommand}" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
