<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.ResumenScTomarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Tomar Materiales de Servicios Comunes (Alt+L)"
        Width="1060" Height="700" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=MaterialGrid}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <Window.Resources>
    <Style x:Key="KbdBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    </Style>

    <!-- Template para botón Tomar en cada fila -->
    <DataTemplate x:Key="TomarButtonTemplate">
      <Button Visibility="{Binding IsMaterial, Converter={StaticResource BoolToVisibility}}"
              Style="{StaticResource Button.Ghost}"
              Content="⬇ Tomar"
              Click="OnTomarClick"
              Padding="10,3"
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="{DynamicResource Brush.BlueDark}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
    </DataTemplate>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── CABECERA EJECUTIVA COCKPIT ──────────────────────────────────── -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
        <!-- Métricas ejecutivas a la derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Tarjeta 1: Total Materiales -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="MATERIALES SC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding TotalMaterialesCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <!-- Tarjeta 2: Categorías -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="CATEGORÍAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding CategoriasCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <!-- Tarjeta 3: Zonas Activas -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="ZONAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding ZonasCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Título y subtítulo con icono a la izquierda -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Dialog.HeaderIconContainer}" Margin="0,0,12,0">
            <Path Data="M13 2 3 14h9l-1 8 10-12h-9l1-8z"
                  Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="16" Height="16"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Tomar Materiales de Servicios Comunes" Style="{StaticResource Dialog.HeaderTitle}" FontSize="16" />
              <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Alt + L" FontFamily="Consolas, Segoe UI Mono, monospace" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Seleccione materiales cubicados en servicios comunes y transfiera cantidades desglosadas por zona a la partida."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- ── BUSCADOR SPOTLIGHT Y CHIPS DE CATEGORÍA ────────────────────── -->
      <StackPanel Grid.Row="1" Margin="0,0,0,12">
        <!-- Input de búsqueda moderno tipo Command Palette -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                <TextBlock Text="Ctrl+B buscar" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
              <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="5,2">
                <TextBlock Text="ESC limpiar" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
              </Border>
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="12.5"
                     Foreground="{DynamicResource Brush.Ink}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar material por nombre o categoría… (Ctrl+B)"
                     PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
          </DockPanel>
        </Border>

        <!-- Chips de Categoría Estilo Segmented Control -->
        <ItemsControl ItemsSource="{Binding Categorias}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,8,0" Padding="12,5" CornerRadius="14" Cursor="Hand"
                      MouseLeftButtonDown="OnSidebarCategoriaClick">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="BorderBrush" Value="#0F172A" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Nombre}" FontSize="11" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border CornerRadius="8" Padding="5,1" Margin="6,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#334155" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Count}" FontSize="9.5" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Foreground" Value="#E2E8F0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- ── GRILLA DE MATERIALES SC ────────────────────────────────────── -->
      <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="8" Padding="0">
        <DataGrid x:Name="MaterialGrid"
                  Style="{StaticResource DataGrid.Workspace.Excel}"
                  infra:DataGridExcelNavigation.Enable="True"
                  PreviewTextInput="MaterialGrid_PreviewTextInput"
                  ItemsSource="{Binding FlatRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F1F5F9"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MinRowHeight="34"
                  MouseDoubleClick="OnRowDoubleClick">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
              <Setter Property="MinHeight" Value="34" />
              <Setter Property="Background" Value="Transparent" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                  <Setter Property="Background" Value="#F1F5F9" />
                  <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#EFF6FF" />
                  <Setter Property="BorderBrush" Value="#BFDBFE" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
        </DataGrid>
      </Border>

      <!-- ── FOOTER RAYCAST / LINEAR COMMAND BAR ───────────────────────── -->
      <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
        <!-- Atajos de teclado en badges KBD -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↵ Enter" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Tomar material" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl+B" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Buscar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↑" Style="{StaticResource KbdText}" /></Border>
          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↓" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Navegar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Esc" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Cancelar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />

          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" FontSize="11"
                     Text="{Binding MaterialCountText}" />
        </StackPanel>

        <!-- Botones a la derecha -->
        <Button x:Name="TomarButton" DockPanel.Dock="Right" Content="Tomar seleccionado"
                Style="{StaticResource Button.Primary}" MinWidth="150" Height="34"
                Click="OnFooterTomarClick" />
        <Button DockPanel.Dock="Right" Content="Cancelar (Esc)" Style="{StaticResource Button.Secondary}"
                MinWidth="100" Height="34" Margin="0,0,10,0" IsCancel="True" Command="{Binding CerrarCommand}" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
