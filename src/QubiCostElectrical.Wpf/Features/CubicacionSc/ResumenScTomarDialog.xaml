<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.ResumenScTomarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.CubicacionSc"
        Style="{StaticResource Dialog.Window}"
        Title="Resumen SC · Tomar Material"
        Width="1220" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">

  <Window.Resources>
    <SolidColorBrush x:Key="BlueGlow" Color="#303B82F6"/>

    <Style x:Key="ZoneColumnHeaderStyle" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}"/>
      <Setter Property="Background" Value="#0f1117"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,9"/>
    </Style>

    <Style x:Key="ZoneInputStyle" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="4,0,6,0"/>
      <Setter Property="Background" Value="#08FFFFFF"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
      <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Glow" Background="Transparent" CornerRadius="5" Opacity="0"/>
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B82F6"/>
                <Setter TargetName="Bd" Property="Background" Value="#0F3B82F6"/>
                <Setter TargetName="Glow" Property="Background" Value="{StaticResource BlueGlow}"/>
                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                <Setter TargetName="Glow" Property="Margin" Value="-3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GridTomarButton" TargetType="Button"
           BasedOn="{StaticResource Button.Primary}">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="0,0,0,0"
                    Padding="0" Margin="0" Cursor="Hand">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="#111318">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ HEADER ═══ -->
    <Border Grid.Row="0"
            BorderBrush="#0AFFFFFF" BorderThickness="0,0,0,1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="#1C1F26"/>
          <GradientStop Offset="1" Color="#14161C"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="False" Margin="24,14,24,12">
        <DockPanel DockPanel.Dock="Left">
          <Border Width="38" Height="38"
                  Background="{DynamicResource Brush.PrimaryButton}"
                  CornerRadius="10" Margin="0,0,14,0"
                  VerticalAlignment="Top">
            <Border.OpacityMask>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFF"/>
                <GradientStop Offset="1" Color="#80FFFFFF"/>
              </LinearGradientBrush>
            </Border.OpacityMask>
            <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                  Data="M14,2L20,8 20,22 4,22 4,2 14,2z M13,3L5,3 5,21 19,21 19,9 13,9 13,3z M12,11L8,16.2 9.4,17.4 12,14.4 14.6,17.4 16,16.2 12,11z"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <DockPanel>
              <TextBlock Text="Resumen SC · Tomar Material"
                         FontSize="16" FontWeight="SemiBold"
                         FontFamily="{StaticResource Font.Ui}"
                         Foreground="{DynamicResource Brush.Ink}"/>
              <Border Margin="8,0,0,0" VerticalAlignment="Center"
                      Background="#1E2D4A" BorderBrush="#3B82F6"
                      BorderThickness="1" CornerRadius="4"
                      Padding="5,1,5,2">
                <TextBlock Text="v2" FontSize="8" FontWeight="Bold"
                           Foreground="#60A5FA"/>
              </Border>
            </DockPanel>
            <TextBlock Text="Selecciona un material del resumen de servicios comunes para aplicarlo a la cubicación activa"
                       FontSize="11" Foreground="#6B7078" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#252830" BorderBrush="#2D3038"
                  BorderThickness="1" CornerRadius="8"
                  Padding="9,5,10,5" Margin="0,0,10,0">
            <DockPanel>
              <Ellipse Width="7" Height="7" Fill="#4ADE80"
                       Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock Text="SC activo" FontSize="10"
                         FontWeight="Medium" Foreground="#8B8F96"/>
            </DockPanel>
          </Border>
          <Button Content="✕" Width="32" Height="32"
                  Background="#252830" BorderBrush="#2D3038"
                  BorderThickness="1" Foreground="#6B7078"
                  FontSize="13" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ═══ TOOLBAR ═══ -->
    <Border Grid.Row="1" Background="#14161C"
            BorderBrush="#0AFFFFFF" BorderThickness="0,0,0,1"
            Padding="24,0,24,0" Height="48">
      <DockPanel LastChildFill="False" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <ItemsControl ItemsSource="{Binding Categorias}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:CategoriaChipVm">
                <Border Padding="8,5,8,5" Margin="0,0,4,0"
                        CornerRadius="6" Cursor="Hand" BorderThickness="1"
                        PreviewMouseDown="OnCategoriaChipClick"
                        Tag="{Binding}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#252830"/>
                      <Setter Property="BorderBrush" Value="Transparent"/>
                      <Setter Property="TextElement.Foreground" Value="#6B7078"/>
                      <Setter Property="TextElement.FontSize" Value="11"/>
                      <Setter Property="TextElement.FontWeight" Value="Medium"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="#1E2D4A"/>
                          <Setter Property="BorderBrush" Value="#3B82F6"/>
                          <Setter Property="TextElement.Foreground" Value="#3B82F6"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#1C2D45"/>
                          <Setter Property="TextElement.Foreground" Value="#E1E4E8"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Nombre}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <DockPanel DockPanel.Dock="Right" VerticalAlignment="Center">
           <TextBlock Text="{Binding MaterialCountText, Mode=OneWay}"
                     FontSize="11" Foreground="#5A5E66"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Border Width="1" Height="18" Background="#2D3038" Margin="0,0,10,0"/>
          <Grid Width="200">
            <Path Width="13" Height="13" Stretch="Uniform" Margin="10,0,0,0"
                  Fill="#5A5E66" HorizontalAlignment="Left"
                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="28" FontSize="11"
                     Background="#1C1F26" BorderBrush="#2D3038"
                     BorderThickness="1" Foreground="#BCC0C6"
                     Padding="28,0,8,0" VerticalContentAlignment="Center"/>
          </Grid>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- ═══ BODY: SIDEBAR + DATAGRID ═══ -->
    <Grid Grid.Row="2" Background="#111318">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- SIDEBAR -->
      <Border Grid.Column="0"
              BorderBrush="#0AFFFFFF" BorderThickness="0,0,1,0"
              Background="#111318">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="16,14,16,8">
            <TextBlock Text="CATEGORÍAS" FontSize="9" FontWeight="Bold"
                       Foreground="#334155"/>
            <TextBlock Text="{Binding Categorias.Count, Mode=OneWay}"
                       FontSize="10" Foreground="#475569"
                       FontWeight="Medium" DockPanel.Dock="Right"/>
          </DockPanel>

          <ListBox Grid.Row="1" ItemsSource="{Binding Categorias}"
                   Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource SidebarItemStyle}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="local:CategoriaChipVm">
                <Border Padding="16,9,16,9" Cursor="Hand"
                        PreviewMouseDown="OnSidebarCategoriaClick"
                        BorderThickness="0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="#1E2D4A"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="{Binding DotBrush}"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Nombre}" FontSize="12"
                               FontWeight="Medium" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#64748b"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Foreground" Value="#E1E4E8"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Border DockPanel.Dock="Right"
                            Background="#0FFFFFFF"
                            CornerRadius="8" MinWidth="22"
                            Padding="4,1,4,1" Margin="0,0,0,0">
                      <TextBlock Text="{Binding Count}" FontSize="10"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="#3B82F6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2"
                  BorderBrush="#0AFFFFFF" BorderThickness="0,1,0,0"
                  Padding="16,10" Background="#111318">
            <TextBlock Text="{Binding SidebarFooterText, Mode=OneWay}"
                       FontSize="10" Foreground="#334155" TextAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <!-- DATAGRID -->
      <Border Grid.Column="1" Background="#111318" Padding="0">
        <DataGrid x:Name="MaterialGrid"
                  ItemsSource="{Binding FlatRows}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#0AFFFFFF"
                  BorderThickness="0"
                  Background="#111318"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  RowHeaderWidth="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreparingCellForEdit="OnPreparingCellForEdit"
                  SelectedItem="{Binding SelectedRow, Mode=OneWayToSource, FallbackValue={x:Null}}"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  RowHeight="30"
                  FontFamily="{StaticResource Font.Ui}"
                  FontSize="12"
                  Foreground="#BCC0C6"
                  FocusVisualStyle="{x:Null}">
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="6,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Background" Value="Transparent"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#1E2D4A"/>
                  <Setter Property="Foreground" Value="#E1E4E8"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="MinHeight" Value="0"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                  <Setter Property="Background" Value="#0AFFFFFF"/>
                  <Setter Property="Height" Value="26"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="False">
                  <Setter Property="Height" Value="30"/>
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsGroupHeader}" Value="False"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Background" Value="#0F3B82F6"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
              <Setter Property="Background" Value="#0f1117"/>
              <Setter Property="Foreground" Value="#475569"/>
              <Setter Property="FontSize" Value="9"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Padding" Value="10,7"/>
              <Setter Property="BorderThickness" Value="0,0,0,1"/>
              <Setter Property="BorderBrush" Value="#0AFFFFFF"/>
            </Style>
          </DataGrid.ColumnHeaderStyle>
        </DataGrid>
      </Border>
    </Grid>

    <!-- ═══ FOOTER ═══ -->
    <Border Grid.Row="3"
            BorderBrush="#0AFFFFFF" BorderThickness="0,1,0,0"
            Background="#0f1117"
            Padding="24,14,24,14">
      <DockPanel LastChildFill="False">
        <DockPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="#4ADE80"
                   Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="Listo para tomar · selecciona un material y ajusta cantidades por zona"
                     FontSize="11" Foreground="#5A5E66"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Cancelar"
                  Style="{StaticResource Button.Secondary}"
                  MinWidth="100" Height="34"
                  Margin="0,0,8,0"
                  IsCancel="True"/>
          <Button x:Name="TomarButton"
                  Content="Tomar material seleccionado"
                  Style="{StaticResource Button.Primary}"
                  MinWidth="180" Height="34"
                  Click="OnFooterTomarClick"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
