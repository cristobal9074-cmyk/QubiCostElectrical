<UserControl x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScCatalogoDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.CubicacionSc"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="#FFFFFF"
             BorderBrush="{DynamicResource Brush.Line}"
             BorderThickness="1,0,0,0"
             Focusable="True" FocusVisualStyle="{x:Null}"
             IsTabStop="True"
             KeyboardNavigation.DirectionalNavigation="None"
             PreviewKeyDown="OnControlPreviewKeyDown">

    <UserControl.Resources>
        <!-- Estilo de botón píldora para categorías: sobrio, profesional, tipo ingeniería/Figma/VS Code -->
        <Style x:Key="CategoryTabStyle" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F172A" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de fila tabular de alta densidad (Ingeniería seria, nada de cards redondeadas AI) -->
        <Style x:Key="TableRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#0F172A" />
                    <Setter Property="BorderThickness" Value="2.5,0,0,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo botón papelera minimalista -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="4">
                            <Path x:Name="trashPath"
                                  Data="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                  Stroke="#94A3B8" StrokeThickness="1.4" Stretch="Uniform" Width="11.5" Height="11.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FFE4E6" />
                                <Setter TargetName="trashPath" Property="Stroke" Value="#E11D48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Panel lateral 100% de alto y ancho fijo resizable -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Ejecutivo y Buscador -->
            <RowDefinition Height="Auto" />
            <!-- 1: Píldoras Segmentadas de Categorías -->
            <RowDefinition Height="Auto" />
            <!-- 2: Subheader de Categoría y Cabecera de Columnas -->
            <RowDefinition Height="Auto" />
            <!-- 3: Lista de Datos Tabular de Alta Densidad (100% Espacio Vertical) -->
            <RowDefinition Height="*" />
            <!-- 4: Dock Inferior de Creación Rápida y Atajos -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Resize handle en el borde izquierdo para arrastrar libremente el ancho -->
        <Thumb Grid.RowSpan="5" Cursor="SizeWE" Width="5" HorizontalAlignment="Left" DragDelta="OnLeftThumbDragDelta" Panel.ZIndex="50">
            <Thumb.Template>
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- 0: HEADER: IDENTIDAD EJECUTIVA Y FILTRADO RÁPIDO -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10,14,10">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <!-- Botón cerrar (Esc) -->
                    <Button DockPanel.Dock="Right" Command="{Binding CloseDrawerCommand}" ToolTip="Cerrar catálogo (Esc)"
                            Style="{StaticResource Button.Ghost}" Width="26" Height="26" Padding="0" VerticalAlignment="Center" Cursor="Hand">
                        <Path Data="M18 6L6 18M6 6l12 12" Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform" />
                    </Button>

                    <!-- Atajo Alt+C -->
                    <Border DockPanel.Dock="Right" Margin="0,0,6,0" Padding="5,1.5" CornerRadius="4" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Alt+C" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#475569" />
                    </Border>

                    <!-- Identidad de la Biblioteca Maestra -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CATÁLOGO DEL PROYECTO" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Especificaciones maestras de materiales y artefactos" FontSize="10" Foreground="#64748B" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Barra de búsqueda rápida -->
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DataGrid.CellEditTextBox}"
                             FontSize="11.5" Padding="24,5,8,5"
                             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                             KeyDown="OnSearchBoxKeyDown" />

                    <!-- Icono lupa a la izquierda -->
                    <Path IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                          Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                          Stroke="#94A3B8" StrokeThickness="1.5" Stretch="Uniform" Width="10.5" Height="10.5" />

                    <!-- Placeholder -->
                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="26,0,0,0"
                               Text="Filtrar por código, tag o nombre..."
                               FontSize="11" Foreground="#94A3B8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 1: SELECTOR DE CATEGORÍAS (SEGMENTED TABS SIN EMOJIS) -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,5">
            <ScrollViewer x:Name="CategoriesScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="CategoriesStackPanel" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsArtefactosSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Artefactos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Artefactos" />
                            <TextBlock Text="{Binding CountArtefactos, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsAlimSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Alim">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alimentación" />
                            <TextBlock Text="{Binding CountAlim, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsConductoresSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Conductores">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Conductores" />
                            <TextBlock Text="{Binding CountConductores, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsSeccionesSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Secciones">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Secciones" />
                            <TextBlock Text="{Binding CountSecciones, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsTuberiasSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="TiposTuberia">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tuberías" />
                            <TextBlock Text="{Binding CountTuberias, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsDiametrosSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Diametros">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Diámetros" />
                            <TextBlock Text="{Binding CountDiametros, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsSistemasSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Sistemas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sistemas" />
                            <TextBlock Text="{Binding CountSistemas, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsBandejasSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Bandejas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bandejas" />
                            <TextBlock Text="{Binding CountBandejas, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsCajasSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Cajas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cajas" />
                            <TextBlock Text="{Binding CountCajas, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryTabStyle}"
                                 IsChecked="{Binding IsFlexiblesSelected, Mode=OneWay}"
                                 Command="{Binding SelectCategoryCommand}" CommandParameter="Flexibles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Flexibles" />
                            <TextBlock Text="{Binding CountFlexibles, StringFormat='{} {0}'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Opacity="0.7" Margin="3,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 2: SUBHEADER Y CABECERA DE TABLA -->
        <Border Grid.Row="2" Background="#FFFFFF" Padding="14,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- 1. En otras categorias: contador simple de elementos -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding FilteredItems.Count, StringFormat='{} {0} elementos'}"
                           FontSize="10" FontFamily="{StaticResource Font.Mono}" Foreground="#64748B" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArtefactosSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 2. En categoria Artefactos: Edicion rapida de alturas por lote (Interruptores y Enchufes) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArtefactosSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Mini-control INT -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="4,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INT" FontSize="9.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" Margin="2,0,4,0" ToolTip="Altura predeterminada para todos los Interruptores" />
                            <TextBox Text="{Binding BulkAlturaInterruptorText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="36" Height="20" Padding="1,0" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}"
                                     TextAlignment="Center" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1"
                                     KeyDown="OnBulkAlturaInterruptorKeyDown" ToolTip="Ingresa altura (m) para Interruptores y presiona Enter o clic en âœ“" />
                            <TextBlock Text="m" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,3,0" />
                            <Button Command="{Binding ApplyBulkAlturaInterruptoresCommand}"
                                    ToolTip="Aplicar a todos los interruptores (Enter)"
                                    Width="18" Height="20" Padding="0" Cursor="Hand" Background="#2563EB" BorderThickness="0" Margin="1,0,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="2"/>
                                    </Style>
                                </Button.Resources>
                                <Path Data="M5 13l4 4L19 7" Stroke="#FFFFFF" StrokeThickness="1.8" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Mini-control ENCH -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="4,1.5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ENCH" FontSize="9.5" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" Margin="2,0,4,0" ToolTip="Altura predeterminada para todos los Enchufes" />
                            <TextBox Text="{Binding BulkAlturaEnchufeText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="36" Height="20" Padding="1,0" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}"
                                     TextAlignment="Center" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1"
                                     KeyDown="OnBulkAlturaEnchufeKeyDown" ToolTip="Ingresa altura (m) para Enchufes y presiona Enter o clic en âœ“" />
                            <TextBlock Text="m" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,3,0" />
                            <Button Command="{Binding ApplyBulkAlturaEnchufesCommand}"
                                    ToolTip="Aplicar a todos los enchufes (Enter)"
                                    Width="18" Height="20" Padding="0" Cursor="Hand" Background="#059669" BorderThickness="0" Margin="1,0,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="2"/>
                                    </Style>
                                </Button.Resources>
                                <Path Data="M5 13l4 4L19 7" Stroke="#FFFFFF" StrokeThickness="1.8" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Titulo de Categoria a la izquierda -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CategoryTitle}" FontSize="10.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                    <TextBlock Text=" - Doble clic para editar" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="3,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArtefactosSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 3: TABLA DE DATOS DE ALTA DENSIDAD (100% ESPACIO VERTICAL) -->
        <ScrollViewer x:Name="CardsScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FFFFFF">
            <ItemsControl x:Name="CardsItemsControl" ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TableRowStyle}"
                                MouseLeftButtonDown="OnCardMouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 0: Tag / Código -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- 1: Nombre / Especificación -->
                                    <ColumnDefinition Width="*" />
                                    <!-- 2: Merma (si aplica) -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- 3: Uso en circuitos -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- 4: Eliminar -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 0: TAG / CÓDIGO (Monospace sobrio, nada de colores estridentes) -->
                                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,9,0"
                                        Visibility="{Binding ShowTagBadge, Converter={StaticResource BoolToVisibility}}"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2"
                                        Cursor="Hand" ToolTip="Clic para editar Tag"
                                        MouseLeftButtonDown="OnTagBadgeMouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTag}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text=" ✎" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 1: Nombre y especificación -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border Cursor="Hand" ToolTip="Clic para renombrar este elemento"
                                            MouseLeftButtonDown="OnNameMouseLeftButtonDown" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="✎" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- 2: Factor Merma (para Alimentación / Fases) -->
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding HasMerma, Converter={StaticResource BoolToVisibility}}"
                                        Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2"
                                        Cursor="Hand" ToolTip="Clic para editar porcentaje de merma (%)"
                                        MouseLeftButtonDown="OnMermaBadgeMouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MermaText}" FontSize="10.5" FontWeight="Bold" Foreground="#78350F" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text=" ✎" FontSize="8" Foreground="#B45309" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 2b: Altura de Bajada (para Artefactos: Enchufes, Interruptores, etc.) -->
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding HasAlturaBajada, Converter={StaticResource BoolToVisibility}}"
                                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2"
                                        Cursor="Hand" ToolTip="Clic para editar altura de bajada (m)"
                                        MouseLeftButtonDown="OnAlturaBadgeMouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↓ " FontSize="9" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AlturaBajadaText}" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text=" ✎" FontSize="8" Foreground="#3B82F6" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 2b: Altura de Bajada (para Artefactos: Enchufes, Interruptores, etc.) -->
                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding HasAlturaBajada, Converter={StaticResource BoolToVisibility}}"
                                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2"
                                        Cursor="Hand" ToolTip="Clic para editar altura de bajada (m)"
                                        MouseLeftButtonDown="OnAlturaBadgeMouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↓ " FontSize="9" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AlturaBajadaText}" FontSize="10.5" FontWeight="Bold" Foreground="#1E40AF" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                                        <TextBlock Text=" ✎" FontSize="8" Foreground="#3B82F6" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 3: Uso en circuitos -->
                                <Border Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Visibility="{Binding UsedCount, Converter={StaticResource BoolToVisibility}}"
                                        Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                        CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="{Binding UsedCount, StringFormat='{}{0} ctos'}" FontSize="9" FontWeight="Bold" Foreground="#047857" FontFamily="{StaticResource Font.Mono}" />
                                </Border>

                                <!-- 4: Eliminar -->
                                <Button Grid.Column="4" Style="{StaticResource DeleteButtonStyle}"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Eliminar este elemento del catálogo" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4: DOCK INFERIOR DE CREACIÓN INTEGRADA -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,5">
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl + +" FontSize="9" FontFamily="{StaticResource Font.Mono}" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock Text="NUEVO ELEMENTO" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Formulario en 1 fila: Tag + Descripción + Altura + Botón -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <!-- Tag -->
                        <ColumnDefinition Width="70" />
                        <!-- Descripción -->
                        <ColumnDefinition Width="*" />
                        <!-- Altura (m) -->
                        <ColumnDefinition Width="58" />
                        <!-- Botón -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Tag -->
                    <TextBox x:Name="NewItemTagBox" Text="{Binding NewItemTag, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DataGrid.CellEditTextBox}"
                             FontSize="11" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                             Padding="6,4" CharacterCasing="Upper"
                             Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                             KeyDown="OnNewItemKeyDown"
                             ToolTip="Tag abreviado (ej: MDL, 9/12)"
                             Margin="0,0,4,0" />

                    <!-- Placeholder Tag -->
                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="7,0,0,0"
                               Text="TAG" FontSize="10" Foreground="#94A3B8" FontFamily="{StaticResource Font.Mono}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewItemTagBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Input Nombre / Descripción -->
                    <Grid Grid.Column="1" Margin="0,0,4,0">
                        <TextBox x:Name="NewItemBox" Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DataGrid.CellEditTextBox}"
                                 FontSize="11" Padding="7,4"
                                 Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                 KeyDown="OnNewItemKeyDown"
                                 ToolTip="Descripción o especificación" />

                        <!-- Placeholder Nombre -->
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="Descripción..." FontSize="10.5" Foreground="#94A3B8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewItemBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Input Altura de Bajada (m) -->
                    <Grid Grid.Column="2" Margin="0,0,4,0">
                        <TextBox Text="{Binding NewItemAltura, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DataGrid.CellEditTextBox}"
                                 FontSize="11" FontFamily="{StaticResource Font.Mono}" Padding="6,4"
                                 Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                 KeyDown="OnNewItemKeyDown"
                                 ToolTip="Altura / bajada en metros (ej: 2.20)" />

                        <!-- Placeholder Altura -->
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Text="ALT (m)" FontSize="9.5" Foreground="#94A3B8" FontFamily="{StaticResource Font.Mono}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewItemAltura}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="3" Style="{StaticResource Button.Primary}" Content="+ Crear"
                            Command="{Binding AddItemCommand}"
                            Padding="12,4" FontSize="11" FontWeight="Bold" />
                </Grid>

                <!-- Atajos sobrios -->
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="Alt+C / Esc Cerrar" FontSize="9" FontFamily="{StaticResource Font.Mono}" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↑↓ Navegar" FontSize="9" FontFamily="{StaticResource Font.Mono}" Foreground="#64748B" Margin="0,0,7,0" />
                        <TextBlock Text="←→ Pestañas" FontSize="9" FontFamily="{StaticResource Font.Mono}" Foreground="#64748B" Margin="0,0,7,0" />
                        <TextBlock Text="↵ Editar" FontSize="9" FontFamily="{StaticResource Font.Mono}" Foreground="#64748B" Margin="0,0,7,0" />
                        <TextBlock Text="Supr Borrar" FontSize="9" FontFamily="{StaticResource Font.Mono}" Foreground="#64748B" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
