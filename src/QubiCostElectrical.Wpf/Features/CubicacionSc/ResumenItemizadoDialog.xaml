<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.ResumenItemizadoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Navegador de Partidas (Alt+S)"
        Width="980" Height="680" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=PartidaGrid}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <Window.Resources>
    <Style x:Key="KbdBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── CABECERA EJECUTIVA COCKPIT ──────────────────────────────────── -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
        <!-- Métricas ejecutivas a la derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Tarjeta 1: Partidas -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="PARTIDAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding TotalPartidasCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <!-- Tarjeta 2: Avance Cubicación -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="AVANCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" />
                <TextBlock Text="{Binding AvancePorcentajeText}" FontSize="13" FontWeight="Bold" Foreground="#047857" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Tarjeta 3: Total Costo Directo -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="TOTAL DIRECTO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding TotalCostoDirectoText}" FontFamily="Consolas, Segoe UI Mono, monospace" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Título y subtítulo con icono a la izquierda -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Dialog.HeaderIconContainer}" Margin="0,0,12,0">
            <Path Data="M3 3h18v18H3z M3 9h18 M3 15h18 M9 3v18"
                  Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="16" Height="16"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Navegador de Partidas del Itemizado" Style="{StaticResource Dialog.HeaderTitle}" FontSize="16" />
              <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Alt + S" FontFamily="Consolas, Segoe UI Mono, monospace" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Selección instantánea, edición rápida y trazabilidad de cubicación en tiempo real."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- ── BUSCADOR SPOTLIGHT Y SEGMENTOS DE FILTRO CON ACCIONES RÁPIDAS ─ -->
      <StackPanel Grid.Row="1" Margin="0,0,0,12">
        <!-- Input de búsqueda moderno tipo Command Palette -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                <TextBlock Text="Ctrl+B buscar" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
              <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="5,2">
                <TextBlock Text="ESC cerrar" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
              </Border>
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="12.5"
                     Foreground="{DynamicResource Brush.Ink}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar por código WBS (ej. 01.1), descripción o material… (Ctrl+B)"
                     PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
          </DockPanel>
        </Border>

        <!-- Barra de Filtros y Botones de Acción Rápida -->
        <DockPanel LastChildFill="True">
          <!-- Botones de Acción Rápida a la derecha -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button Content="+ Partida (Ctrl++)" Style="{StaticResource Button.Primary}" Margin="0,0,6,0" Padding="10,4"
                    Command="{Binding AddPartidaCommand}" ToolTip="Agregar nueva partida bajo la selección (Ctrl++)" />
            <Button Content="− Eliminar (Ctrl+-)" Style="{StaticResource Button.Secondary}" Padding="10,4"
                    Command="{Binding DeletePartidaCommand}" ToolTip="Eliminar partida seleccionada (Ctrl+-)" />
          </StackPanel>

          <!-- Chips de Filtro Estilo Segmented Control -->
          <ItemsControl ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,0" Padding="12,5" CornerRadius="14" Cursor="Hand"
                        MouseLeftButtonDown="OnFilterChipClick">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="#0F172A" />
                          <Setter Property="BorderBrush" Value="#0F172A" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Nombre}" FontSize="11" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Foreground" Value="#FFFFFF" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Border CornerRadius="8" Padding="5,1" Margin="6,0,0,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Background" Value="#1E293B" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="#94A3B8" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </StackPanel>

      <!-- ── TABLA ENTERPRISE DE PARTIDAS ──────────────────────────────── -->
      <Border Grid.Row="2" CornerRadius="8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Background="{DynamicResource Brush.Surface}" Padding="0">
        <DataGrid x:Name="PartidaGrid"
                  Style="{StaticResource DataGrid.Workspace}"
                  ItemsSource="{Binding FlatRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F1F5F9"
                  RowHeight="34"
                  MouseDoubleClick="OnRowDoubleClick"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.CacheLength="5,5"
                  VirtualizingPanel.CacheLengthUnit="Item">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1.5" />
              <Setter Property="Margin" Value="0,1" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <DataTrigger Binding="{Binding EsSeccion}" Value="True">
                  <Setter Property="Background" Value="#F8FAFC" />
                  <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>

                <!-- ── AURA AZUL: PARTIDA ACTUAL EN CUBICACIÓN ── -->
                <DataTrigger Binding="{Binding IsCurrentPartida}" Value="True">
                  <Setter Property="Background" Value="#EFF6FF" />
                  <Setter Property="BorderBrush" Value="#3B82F6" />
                  <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>

                <!-- Selección normal -->
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#EFF6FF" />
                  <Setter Property="BorderBrush" Value="#BFDBFE" />
                </Trigger>

                <!-- Partida actual seleccionada (Aura Azul Intensa) -->
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrentPartida}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Background" Value="#DBEAFE" />
                  <Setter Property="BorderBrush" Value="#1D4ED8" />
                  <Setter Property="BorderThickness" Value="2" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Prototype}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Setter Property="BorderBrush" Value="#F1F5F9" />
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#EFF6FF" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns>
            <!-- Columna WBS con Aura Azul -->
            <DataGridTemplateColumn Header="CÓDIGO" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <!-- Badge AURA AZUL de Partida Actual -->
                    <Border Visibility="{Binding IsCurrentPartida, Converter={StaticResource BoolToVisibility}}"
                            Background="#2563EB" CornerRadius="4" Padding="5,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                      <TextBlock Text="📍 ACTUAL" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                    <Border Visibility="{Binding EsSeccion, Converter={StaticResource BoolToVisibility}}"
                            Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding ItemCode}" FontFamily="Consolas, Segoe UI Mono, monospace"
                                 FontSize="11" FontWeight="Bold" Foreground="#0F172A" />
                    </Border>
                    <TextBlock Visibility="{Binding EsSeccion, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                               Text="{Binding ItemCode}" FontFamily="Consolas, Segoe UI Mono, monospace"
                               FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Descripción -->
            <DataGridTemplateColumn Header="DESCRIPCIÓN" Width="*" MinWidth="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11.5" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EsSeccion}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#0F172A" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Estado / Trazabilidad -->
            <DataGridTemplateColumn Header="ESTADO" Width="105">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding EstadoBadgeBackground}"
                          BorderBrush="{Binding EstadoBadgeBorder}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="7,2"
                          Margin="2,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="5.5" Height="5.5" Fill="{Binding EstadoBadgeDot}" Margin="0,0,5,0" />
                      <TextBlock Text="{Binding EstadoBadgeText}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding EstadoBadgeForeground}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Unidad -->
            <DataGridTextColumn Header="UD" Binding="{Binding Unidad}" Width="50">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Cantidad -->
            <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadDisplay}" Width="75">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Material -->
            <DataGridTextColumn Header="MATERIAL" Binding="{Binding MaterialDisplay}" Width="100">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Mano de Obra -->
            <DataGridTextColumn Header="M. OBRA" Binding="{Binding ManoObraDisplay}" Width="100">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Costo Directo -->
            <DataGridTextColumn Header="COSTO DIRECTO" Binding="{Binding CostoDirectoDisplay}" Width="115">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- ── BARRA DE EDICIÓN RÁPIDA ──────────────────────────────────── -->
      <Border Grid.Row="3" Margin="0,10,0,0"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="#3B82F6" BorderThickness="1.5"
              CornerRadius="8" Padding="12,8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding SelectedRow.EsSeccion}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Código de la partida editable con botón para sugerir/recomendar -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Width="105">
            <StackPanel Orientation="Horizontal" Margin="1,0,0,2">
              <TextBlock Text="✏️ CÓDIGO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <Button Style="{StaticResource Button.Ghost}"
                      Padding="3,0" Margin="4,0,0,0" Height="16"
                      ToolTip="Sugerir siguiente código correlativo automáticamente"
                      Command="{Binding RecomendarCodigoCommand}"
                      Cursor="Hand">
                <TextBlock Text="🪄 Sugerir" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueDark}" />
              </Button>
            </StackPanel>
            <TextBox x:Name="EditCodeBox"
                     Text="{Binding SelectedRow.ItemCode, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11.5"
                     FontFamily="Consolas, monospace"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.BlueDark}"
                     TextAlignment="Center"
                     Padding="4,4"
                     PreviewKeyDown="OnQuickEditPreviewKeyDown" />
          </StackPanel>

          <!-- Descripción -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="DESCRIPCIÓN DE LA PARTIDA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="1,0,0,2" />
            <TextBox x:Name="EditDescBox"
                     Text="{Binding SelectedRow.Descripcion, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11.5"
                     Padding="6,4"
                     PreviewKeyDown="OnQuickEditPreviewKeyDown" />
          </StackPanel>

          <!-- Unidad -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Width="70">
            <TextBlock Text="UNIDAD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="1,0,0,2" />
            <TextBox x:Name="EditUnidadBox"
                     Text="{Binding SelectedRow.Unidad, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11.5"
                     FontFamily="Consolas, monospace"
                     TextAlignment="Center"
                     Padding="4,4"
                     PreviewKeyDown="OnQuickEditPreviewKeyDown" />
          </StackPanel>

          <!-- Cantidad -->
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Width="90">
            <TextBlock Text="CANTIDAD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="1,0,0,2" />
            <TextBox x:Name="EditCantBox"
                     Text="{Binding SelectedRow.CantidadEditString, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="11.5"
                     FontFamily="Consolas, monospace"
                     TextAlignment="Right"
                     Padding="4,4"
                     PreviewKeyDown="OnQuickEditPreviewKeyDown" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── FOOTER RAYCAST / LINEAR COMMAND BAR ───────────────────────── -->
      <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
        <!-- Atajos de teclado en badges KBD -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↵ Enter" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Ir a partida" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl++" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="+ Partida" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl+-" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Eliminar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="F2" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Editar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl+B" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Buscar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↑" Style="{StaticResource KbdText}" /></Border>
          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↓" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Navegar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl+Shift+N" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="+ Recurso" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
        </StackPanel>

        <!-- Botones de acción a la derecha -->
        <Button DockPanel.Dock="Right" Content="↵ Ir a partida" Style="{StaticResource Button.Primary}"
                MinWidth="120" Height="34" Click="OnIrAPartidaClick" />
        <Button DockPanel.Dock="Right" Content="Cerrar (Esc)" Style="{StaticResource Button.Secondary}"
                MinWidth="100" Height="34" IsCancel="True" Command="{Binding CerrarCommand}" Margin="0,0,10,0" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
