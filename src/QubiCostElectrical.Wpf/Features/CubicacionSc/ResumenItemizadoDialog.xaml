<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.ResumenItemizadoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.CubicacionSc"
        mc:Ignorable="d"
        Title="Resumen Itemizado"
        Height="680" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        d:DataContext="{d:DesignInstance local:ResumenItemizadoViewModel}">

    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="6" Background="#111318">
        <Grid Background="#111318">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────── -->
            <Border Grid.Row="0" Background="#15171C" Padding="20,14,20,14"
                    BorderBrush="#25282E" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36"
                            Background="#2D1B69" CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="∑" FontSize="16" FontWeight="Bold"
                                   Foreground="#C084FC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Resumen Itemizado"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#E8EAED" />
                        <TextBlock Text="Todas las partidas del proyecto con sus costos"
                                   FontSize="11" Foreground="#9AA0A6"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#25282E" CornerRadius="4" Padding="6,3"
                                Margin="0,0,4,0" ToolTip="Abrir resumen">
                            <TextBlock Text="Alt+I" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9AA0A6" FontFamily="Consolas" />
                        </Border>
                         <Border Background="#25282E" CornerRadius="4" Padding="6,3"
                                Margin="0,0,4,0" ToolTip="Agregar recurso">
                            <TextBlock Text="Ctrl+Shift+A" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9AA0A6" FontFamily="Consolas" />
                        </Border>
                        <Border Background="#25282E" CornerRadius="4" Padding="6,3"
                                ToolTip="Limpiar cubicación">
                            <TextBlock Text="Ctrl+Shift+D" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9AA0A6" FontFamily="Consolas" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Toolbar ────────────────────────────────────────── -->
            <Border Grid.Row="1" Background="#13151A"
                    Padding="16,10" BorderBrush="#1E2026"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Filter chips -->
                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding Filters}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:FilterChipVm">
                                <Border Padding="10,4,10,4" Margin="0,0,6,0"
                                        CornerRadius="12"
                                        Background="#1E2026"
                                        BorderBrush="#2D2F36"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnFilterChipClick"
                                        ToolTip="{Binding Nombre}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#2D1B69" />
                                                    <Setter Property="BorderBrush" Value="#7C3AED" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Display}"
                                               FontSize="11" Foreground="#9AA0A6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#C084FC" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Search -->
                    <Border Grid.Column="2" Background="#1A1C22"
                            BorderBrush="#25282E" BorderThickness="1"
                            CornerRadius="6" Padding="8,4"
                            Width="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11"
                                       Foreground="#5F6368"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
        Background="#111318"
                                     BorderThickness="0"
                                     Foreground="#E8EAED"
                                     FontSize="11"
                                     CaretBrush="#7C3AED"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── DataGrid ───────────────────────────────────────── -->
            <DataGrid Grid.Row="2"
                      x:Name="PartidaGrid"
                      ItemsSource="{Binding FlatRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      RowHeight="32"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      EnableRowVirtualization="True"
                      MouseDoubleClick="OnRowDoubleClick"
                      FontFamily="Segoe UI"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D1B69" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8EAED" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B1F8A" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#13151A" />
                        <Setter Property="Foreground" Value="#9AA0A6" />
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="BorderBrush" Value="#1E2026" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="8,0" />
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#E8EAED" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="BorderBrush" Value="#1A1C22" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="MinHeight" Value="32" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EsSeccion}" Value="True">
                                <Setter Property="Background" Value="#181A20" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#C084FC" />
                                <Setter Property="FontSize" Value="11" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2026" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- # / Item code -->
                    <DataGridTemplateColumn Header="#" Width="80" SortMemberPath="ItemCode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ItemCode}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#5F6368"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Descripcion -->
                    <DataGridTemplateColumn Header="Descripción" Width="*" MinWidth="200"
                                            SortMemberPath="Descripcion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Descripcion}"
                                               FontSize="11"
                                               Foreground="#E8EAED"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ItemCode, StringFormat='#{0}'}"
                                               FontSize="9"
                                               Foreground="#5F6368">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsSeccion}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unidad -->
                    <DataGridTextColumn Header="UD" Width="44"
                                        Binding="{Binding Unidad, Mode=OneWay}" SortMemberPath="Unidad">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#5F6368" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Cantidad -->
                    <DataGridTextColumn Header="Cantidad" Width="80"
                                        Binding="{Binding CantidadDisplay, Mode=OneWay}" SortMemberPath="Cantidad">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="#E8EAED" />
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Materiales -->
                    <DataGridTextColumn Header="Materiales ($)" Width="120"
                                        Binding="{Binding MaterialDisplay, Mode=OneWay}" SortMemberPath="MaterialTotal">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="#E8EAED" />
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Mano de Obra -->
                    <DataGridTextColumn Header="Mano de Obra ($)" Width="120"
                                        Binding="{Binding ManoObraDisplay, Mode=OneWay}" SortMemberPath="ManoObraTotal">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="#E8EAED" />
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Costo Directo -->
                    <DataGridTextColumn Header="Costo Directo ($)" Width="140"
                                        Binding="{Binding CostoDirectoDisplay, Mode=OneWay}" SortMemberPath="CostoDirecto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#E8EAED" />
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Navigation icon -->
                    <DataGridTemplateColumn Header="" Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="→" FontSize="14"
                                           Foreground="Transparent"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Cursor="Hand">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsSeccion}" Value="False">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Duration="0:0:0.15"
                                                                                Storyboard.TargetProperty="Foreground.Color"
                                                                                To="#7C3AED" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Duration="0:0:0.15"
                                                                                Storyboard.TargetProperty="Foreground.Color"
                                                                                To="Transparent" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Footer ─────────────────────────────────────────── -->
            <Border Grid.Row="3" Background="#15171C"
                    Padding="16,10,16,12"
                    BorderBrush="#25282E" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SummaryText}"
                               FontSize="11" Foreground="#9AA0A6"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="⬆⬇ Navegar · Enter Ir · Ctrl+Shift+A Agregar · Ctrl+Shift+D Limpiar"
                                   FontSize="10" Foreground="#5F6368"
                                   VerticalAlignment="Center" />
                    <Border Background="#25282E" CornerRadius="4"
                            Cursor="Hand" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2F36" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Cerrar" FontSize="11" Foreground="#E8EAED"
                                   Padding="14,5" VerticalAlignment="Center"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding CerrarCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
