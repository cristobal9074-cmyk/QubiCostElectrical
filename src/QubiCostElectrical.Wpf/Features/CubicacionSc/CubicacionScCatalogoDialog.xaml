<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScCatalogoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Catálogo C.SC"
        Width="1080" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}"
        KeyDown="OnWindowKeyDown">
  <Window.Resources>
    <!-- Rail item: ícono + nombre + contador -->
    <Style x:Key="CatalogRailItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,9"
                    SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line2}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CatalogRailIcon" TargetType="Border">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CatalogRailIconText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Font.Size.md}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CatalogCount" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="CatalogChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style x:Key="CatalogChipBlue" TargetType="Border" BasedOn="{StaticResource CatalogChip}">
      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
    </Style>

    <Style x:Key="CatalogDataGrid" TargetType="DataGrid" BasedOn="{StaticResource DataGrid.Workspace}">
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserDeleteRows" Value="True" />
      <Setter Property="SelectionMode" Value="Extended" />
      <Setter Property="RowHeight" Value="44" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.base}" />
    </Style>

    <Style x:Key="CatalogHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    </Style>

    <Style x:Key="BtnDangerSoft" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
      <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
          <Border Style="{StaticResource CatalogChip}" Margin="0,0,8,0">
            <TextBlock FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}">
              <Run Text="Proyecto · " /><Run x:Name="ProyectoNombreRun" FontFamily="{StaticResource Font.Mono}" Text="—" />
            </TextBlock>
          </Border>
          <Border Style="{StaticResource CatalogChipBlue}">
            <TextBlock FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}">
              <Run x:Name="TotalItemsRun" FontFamily="{StaticResource Font.Mono}" Text="0" /><Run Text=" ítems" />
            </TextBlock>
          </Border>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Biblioteca del proyecto" Style="{StaticResource Dialog.HeaderTitle}" />
          <TextBlock Text="Define conductores, ductos, bandejas y artefactos que alimentan Cubicación SC. Un catálogo limpio = menos errores en la planilla."
                     Style="{StaticResource Dialog.HeaderSubtitle}" MaxWidth="560" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Rail -->
      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="0,0,1,0"
              Padding="12,14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="CATEGORÍAS"
                     FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Ink4}"
                     Margin="10,4,10,10" />
          <ListBox x:Name="CategoriaList"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="OnCategoriaChanged"
                   ItemContainerStyle="{StaticResource CatalogRailItem}">
            <ListBoxItem Tag="Conductores">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="C" />
                </Border>
                <TextBlock Grid.Column="2" Text="Conductores" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountConductores" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Secciones">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="⌀" />
                </Border>
                <TextBlock Grid.Column="2" Text="Secciones" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountSecciones" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="TiposTuberia">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="▭" />
                </Border>
                <TextBlock Grid.Column="2" Text="Tipos de tubería" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountTiposTuberia" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Diametros">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="◎" />
                </Border>
                <TextBlock Grid.Column="2" Text="Diámetros" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountDiametros" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Bandejas">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="⊞" />
                </Border>
                <TextBlock Grid.Column="2" Text="Bandejas" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountBandejas" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Cajas">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="▣" />
                </Border>
                <TextBlock Grid.Column="2" Text="Cajas" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountCajas" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="SistemasCircuito">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="S" />
                </Border>
                <TextBlock Grid.Column="2" Text="Sistemas (SIST)" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountSistemasCircuito" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Sistemas">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="M" />
                </Border>
                <TextBlock Grid.Column="2" Text="Alimentación (ALIM)" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountSistemas" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Flexibles">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="∿" />
                </Border>
                <TextBlock Grid.Column="2" Text="Terminales flex." FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountFlexibles" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
            <ListBoxItem Tag="Artefactos">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CatalogRailIcon}">
                  <TextBlock Style="{StaticResource CatalogRailIconText}" Text="◇" />
                </Border>
                <TextBlock Grid.Column="2" Text="Artefactos" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" />
                <TextBlock x:Name="CountArtefactos" Grid.Column="3" Style="{StaticResource CatalogCount}" Text="0" />
              </Grid>
            </ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Panel derecho -->
      <Grid Grid.Column="1" Margin="18,16,18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Panel top -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Ghost}" Content="Duplicar"
                    Click="OnDuplicarClick" Margin="0,0,6,0" Padding="10,6" />
            <Button Style="{StaticResource BtnDangerSoft}" Content="Quitar"
                    Click="OnQuitarClick" Margin="0,0,6,0" Padding="10,6" />
            <Button Style="{StaticResource Button.Primary}" Content="+ Agregar fila"
                    Click="OnAgregarFilaClick" Padding="12,6" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="CategoriaTitulo" Text="Conductores"
                       FontSize="{StaticResource Font.Size.kpi}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock x:Name="CategoriaSubtitulo"
                       Text="Tipos de cable disponibles en la planilla de circuitos"
                       FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink3}" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>

        <!-- Search toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                  Content="Importar…" IsEnabled="False" ToolTip="Próximamente"
                  Margin="8,0,0,0" Padding="12,6" />
          <Border Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="10" Padding="12,0" Height="38">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="{StaticResource Font.Size.lg}"
                         Foreground="{DynamicResource Brush.Ink4}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Line2}"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      CornerRadius="5" Padding="6,3" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="/" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.xs}"
                           Foreground="{DynamicResource Brush.Ink3}" />
              </Border>
              <TextBox x:Name="SearchBox"
                       BorderThickness="0" Background="Transparent"
                       VerticalContentAlignment="Center"
                       FontSize="{StaticResource Font.Size.base}"
                       TextChanged="OnSearchTextChanged"
                       ToolTip="Buscar en esta categoría (/)" />
            </DockPanel>
          </Border>
        </DockPanel>

        <!-- Table card -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1" CornerRadius="14"
                Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0"
                    Padding="14,12">
              <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Vacío al final · Enter agrega · Delete quita la fila seleccionada"
                           FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink4}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                        Content="Agregar al final →" Click="OnAgregarFilaClick" Padding="8,4" />
              </DockPanel>
            </Border>

            <Grid Margin="0">
              <!-- Grilla simple -->
              <DataGrid x:Name="SimpleGrid"
                        Style="{StaticResource CatalogDataGrid}"
                        ColumnHeaderStyle="{StaticResource CatalogHeader}"
                        infra:DataGridExcelNavigation.Enable="True"
                        PreviewTextInput="SimpleGrid_PreviewTextInput"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        Visibility="Visible">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="NOMBRE" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel Margin="10,0">
                          <Border DockPanel.Dock="Left"
                                  Background="{DynamicResource Brush.Navy}"
                                  CornerRadius="6" Padding="8,4" Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Value}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.SlateLight}"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis" />
                          </Border>
                          <TextBlock Text="{Binding Value}"
                                     FontSize="{StaticResource Font.Size.base}" FontWeight="Medium"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.Ink}" />
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="8,4" Padding="6,4" FontSize="{StaticResource Font.Size.base}"
                                 VerticalContentAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>

              <!-- Sistemas de circuito (SIST: A, E, CL, CO, etc.) -->
              <DataGrid x:Name="SistemasCircuitoGrid"
                        Style="{StaticResource CatalogDataGrid}"
                        ColumnHeaderStyle="{StaticResource CatalogHeader}"
                        infra:DataGridExcelNavigation.Enable="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        Visibility="Collapsed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="CÓDIGO (SIST)" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" Width="150" />
                  <DataGridTextColumn Header="DESCRIPCIÓN / SISTEMA" Binding="{Binding Nombre, UpdateSourceTrigger=LostFocus}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- Alimentación (ALIM: M, T, EM) -->
              <DataGrid x:Name="SistemasGrid"
                        Style="{StaticResource CatalogDataGrid}"
                        ColumnHeaderStyle="{StaticResource CatalogHeader}"
                        infra:DataGridExcelNavigation.Enable="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        Visibility="Collapsed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="CÓDIGO (M/T/EM)" Binding="{Binding Nombre, UpdateSourceTrigger=LostFocus}" Width="160" />
                  <DataGridTextColumn Header="N° CONDUCTORES" Binding="{Binding NumConductores, UpdateSourceTrigger=LostFocus}" Width="140" />
                  <DataGridTextColumn Header="MERMA %" Binding="{Binding MermaPct, UpdateSourceTrigger=LostFocus}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- Flexibles -->
              <DataGrid x:Name="FlexiblesGrid"
                        Style="{StaticResource CatalogDataGrid}"
                        ColumnHeaderStyle="{StaticResource CatalogHeader}"
                        infra:DataGridExcelNavigation.Enable="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        Visibility="Collapsed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="DIÁMETRO DUCTO" Binding="{Binding Diametro, UpdateSourceTrigger=LostFocus}" Width="160" />
                  <DataGridTextColumn Header="TERMINAL FLEXIBLE" Binding="{Binding TipoFlexible, UpdateSourceTrigger=LostFocus}" Width="*" />
                  <DataGridTextColumn Header="METROS POR CAJA" Binding="{Binding MetrosPorCaja, UpdateSourceTrigger=LostFocus}" Width="150" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- Artefactos -->
              <DataGrid x:Name="ArtefactosGrid"
                        Style="{StaticResource CatalogDataGrid}"
                        ColumnHeaderStyle="{StaticResource CatalogHeader}"
                        infra:DataGridExcelNavigation.Enable="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        Visibility="Collapsed">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre, UpdateSourceTrigger=LostFocus}" Width="*" />
                  <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria, UpdateSourceTrigger=LostFocus}" Width="200" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="0,1,0,0"
            Padding="18,12">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,14,0">
            <Run FontFamily="{StaticResource Font.Mono}" Background="{DynamicResource Brush.Line2}"> Del </Run>
            <Run Text=" quitar fila" />
          </TextBlock>
          <TextBlock FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,14,0">
            <Run FontFamily="{StaticResource Font.Mono}">Ctrl</Run><Run Text="+"/>
            <Run FontFamily="{StaticResource Font.Mono}">S</Run>
            <Run Text=" guardar" />
          </TextBlock>
          <TextBlock FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink3}">
            <Run FontFamily="{StaticResource Font.Mono}">Esc</Run>
            <Run Text=" cancelar" />
          </TextBlock>
        </StackPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Guardar catálogo"
                MinWidth="150" Height="34" IsDefault="True" Click="OnAcceptClick" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
                MinWidth="100" Height="34" Margin="0,0,10,0" IsCancel="True" />
      </DockPanel>
    </Border>
  </Grid>
  </Border>
</Window>
