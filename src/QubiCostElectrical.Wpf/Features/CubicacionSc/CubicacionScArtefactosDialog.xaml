<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScArtefactosDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Elementos y accesorios"
        Width="860" Height="560" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="ZonaChip" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14" Padding="{TemplateBinding Padding}">
              <TextBlock Text="{Binding Etiqueta}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink2}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PickItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="20,16,20,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="Titulo" Style="{StaticResource Dialog.HeaderTitle}" Margin="0" />
          <TextBlock x:Name="Subtitulo" Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0,2,0,0" />
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Top" Padding="7,3" CornerRadius="6"
                Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <TextBlock Text="Esc guarda" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
        </Border>
      </Grid>

      <Border x:Name="FloorsHost" Grid.Row="1" Padding="20,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
              Background="{DynamicResource Brush.SurfaceAlt}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="PISOS" VerticalAlignment="Center" Margin="0,0,10,0"
                     FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
          <ListBox x:Name="ZonasList" BorderThickness="0" Background="Transparent"
                   ItemsSource="{Binding Zonas}"
                   ItemContainerStyle="{StaticResource ZonaChip}"
                   SelectionChanged="OnZonaChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*" />
          <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="12,8,8,8">
          <TextBlock DockPanel.Dock="Top" Text="AGREGAR" Margin="8,4,8,6"
                     FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
          <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="8,0,8,4"
                   FontSize="{StaticResource Font.Size.lg}" Padding="10,8"
                   BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="2"
                   TextChanged="OnSearchChanged" />
          <Border x:Name="QtyPanel" DockPanel.Dock="Top" Margin="8,0,8,4" Padding="12" CornerRadius="10"
                  Visibility="Collapsed"
                  Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock x:Name="QtyNombre" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock x:Name="QtyCategoria" DockPanel.Dock="Right" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="QtyPregunta" Margin="0,0,0,8" FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink2}" TextWrapping="Wrap" />
              <TextBox x:Name="QtyBox" FontSize="28" FontWeight="SemiBold" Padding="8,4"
                       HorizontalContentAlignment="Center" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="2" />
              <TextBlock Margin="0,8,0,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}"
                         Text="Enter confirma · Esc guarda y cierra · 13+5+6 también vale" />
            </StackPanel>
          </Border>
          <ListBox x:Name="SugerenciasList" BorderThickness="0" Background="Transparent"
                   ItemsSource="{Binding Sugerencias}"
                   ItemContainerStyle="{StaticResource PickItem}"
                   Focusable="False"
                   MouseLeftButtonUp="OnSugerenciaClick"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock Text="{Binding Detalle}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1,0,0,0" Background="{DynamicResource Brush.SurfaceAlt}">
          <DockPanel Margin="8,8,8,8">
            <TextBlock x:Name="LoadedTitle" DockPanel.Dock="Top" Margin="8,4,8,6"
                       FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock x:Name="VacioMsg" DockPanel.Dock="Top" Margin="8,12,8,0"
                       Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.md}" TextWrapping="Wrap"
                       Text="Todavía no hay artefactos en este piso." />
            <ListBox x:Name="VisiblesList" BorderThickness="0" Background="Transparent"
                     ItemsSource="{Binding Visibles}"
                     ItemContainerStyle="{StaticResource PickItem}"
                     Focusable="False"
                     MouseLeftButtonUp="OnCargadoClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Cantidad}" MinWidth="28" TextAlignment="Right"
                               FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                      <TextBlock Text="{Binding Categoria}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource Dialog.FooterBar}" Margin="0">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="↑↓ elegir" Margin="0,0,12,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
            <TextBlock Text="Enter cantidad" Margin="0,0,12,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
            <TextBlock Text="Ctrl+←/→ piso" Margin="0,0,12,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
            <TextBlock Text="Supr quita" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Listo"
                  MinWidth="110" IsDefault="False" Click="OnAcceptClick" />
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
                  MinWidth="100" Margin="0,0,8,0" IsCancel="False" Click="OnCancelClick" />
          <TextBlock x:Name="TotalCircuito" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center"
                     FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Ink2}" />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
