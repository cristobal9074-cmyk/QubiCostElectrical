<Window x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScArtefactosDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Artefactos por zona"
        Width="620" Height="640" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
  <Window.Resources>
    <!-- Chip de pestaña de zona -->
    <Style x:Key="ZonaChip" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <TextBlock Text="{Binding Etiqueta}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Botón cuadrado de cantidad (− / +) -->
    <Style x:Key="StepBtn" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- header -->
      <RowDefinition Height="Auto" />   <!-- zonas -->
      <RowDefinition Height="Auto" />   <!-- buscador -->
      <RowDefinition Height="Auto" />   <!-- frecuentes -->
      <RowDefinition Height="*" />      <!-- lista -->
      <RowDefinition Height="Auto" />   <!-- footer -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock x:Name="Titulo" Style="{StaticResource Dialog.HeaderTitle}" />
      <TextBlock x:Name="Subtitulo" Style="{StaticResource Dialog.HeaderSubtitle}" />
    </StackPanel>

    <!-- Zonas del proyecto -->
    <ListBox x:Name="ZonasList" Grid.Row="1" Margin="0,0,0,10"
             BorderThickness="0" Background="Transparent"
             ItemsSource="{Binding Zonas}"
             ItemContainerStyle="{StaticResource ZonaChip}"
             SelectionChanged="OnZonaChanged"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <!-- Buscador -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" FontSize="14" Padding="10,8"
               BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="2"
               TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"
               Tag="＋ Buscar o escribir tipo · «6 foco» agrega 6 · Enter" />
      <TextBlock Text="{Binding Tag, ElementName=SearchBox}" IsHitTestVisible="False"
                 Margin="12,0,0,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Muted}" FontSize="13">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Popup x:Name="SugerenciasPopup" PlacementTarget="{Binding ElementName=SearchBox}"
             Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
             Width="{Binding ActualWidth, ElementName=SearchBox}">
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="0,0,8,8" Padding="4">
          <ListBox x:Name="SugerenciasList" ItemsSource="{Binding Sugerencias}"
                   BorderThickness="0" Background="Transparent" MaxHeight="240"
                   KeyDown="OnSugerenciaKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="Transparent" Padding="8,6" MouseLeftButtonUp="OnSugerenciaClick">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detalle}" FontSize="10"
                               Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Nombre}" FontSize="12" Foreground="{DynamicResource Brush.Ink}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>
    </Grid>

    <!-- Frecuentes (F1–F6) -->
    <ItemsControl Grid.Row="3" ItemsSource="{Binding Frecuentes}" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                  Padding="10,4" FontSize="11" Click="OnFrecuenteClick"
                  Content="{Binding Nombre}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Lista de artefactos de la zona activa -->
    <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
          <ItemsControl ItemsSource="{Binding Visibles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,5" Margin="2,1" CornerRadius="6">
                  <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource StepBtn}" Content="−" Click="OnMenosClick" />
                      <TextBlock Text="{Binding Cantidad}" MinWidth="32" TextAlignment="Center"
                                 FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
                      <Button Style="{StaticResource StepBtn}" Content="＋" Click="OnMasClick" />
                      <Button Content="✕" Width="24" Height="24" Margin="8,0,0,0" Padding="0"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              Foreground="{DynamicResource Brush.Muted}" Click="OnQuitarClick" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Nombre}" FontSize="13" Foreground="{DynamicResource Brush.Ink}" />
                      <TextBlock Text="{Binding Categoria}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="VacioMsg" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Muted}" FontSize="12" TextAlignment="Center"
                   Text="Sin artefactos en esta zona.&#x0a;Escribe arriba o usa los frecuentes (F1–F6)." />
      </Grid>
    </Border>

    <!-- Footer -->
    <DockPanel Grid.Row="5" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Total circuito: " FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
        <TextBlock x:Name="TotalCircuito" Text="0" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
        <TextBlock Text=" unidades" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
      </StackPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Listo"
              MinWidth="120" IsDefault="False" Click="OnAcceptClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
              MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
