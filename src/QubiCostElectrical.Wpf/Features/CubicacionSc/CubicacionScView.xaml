<UserControl x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCircuitoCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- Chip de estado de circuito (verde=activo, ámbar=reserva) -->
        <Style x:Key="EstadoChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Activo">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva">
                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva equipada">
                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstadoChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Activo">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva equipada">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Chip de sistema (tipo de uso del circuito) -->
        <Style x:Key="SistemaChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,1.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tipo}" Value="A">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="E">
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="CL">
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="C">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="CO">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="F">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SistemaChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tipo}" Value="A">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="E">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="CL">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="C">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="CO">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="F">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chip de Fase/Alimentación con código trifásico R-S-T normativo -->
        <Style x:Key="FaseChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,1.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fase}" Value="M">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="T">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="R">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="S">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="EM">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FaseChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fase}" Value="M">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="T">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="R">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="S">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="EM">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonoRightCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Estado vacío cuando no hay proyecto abierto.
             En el diseñador se oculta (d:Visibility) para poder editar el layout sin solapes. -->
        <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            d:Visibility="Collapsed"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para editar tableros y circuitos de servicios comunes (C.SC).">
            <ctrl:EmptyStateControl.Actions>
                <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
            </ctrl:EmptyStateControl.Actions>
        </ctrl:EmptyStateControl>

        <!-- Contenido principal cuando hay proyecto -->
        <DockPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                   d:Visibility="Visible"
                   Margin="20,14,20,14">

            <!-- ── Unified Modern Executive Top Bar ──────────────────────── -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card.Surface}" Padding="10,6" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                    <!-- Right side: Actions -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Botón principal destacado: circuito -->
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Circuito" Command="{Binding AddCircuitoCommand}"
                                ToolTip="Agregar nuevo circuito repitiendo parámetros (Ctrl+)" Height="28" Padding="10,0" Margin="0,0,5,0" />

                        <!-- Acciones de tablero -->
                        <Button Style="{StaticResource Button.Toolbar}" Content="+ Tablero" Command="{Binding AddCuadroCommand}"
                                ToolTip="Crear nuevo tablero" Height="28" Padding="9,0" Margin="0,0,5,0" />

                        <!-- Menú desplegable consolidado de Acciones -->
                        <Button x:Name="ScActionsButton" Style="{StaticResource Button.Toolbar}" Height="28" Padding="9,0" VerticalAlignment="Center" Click="OnMoreActionsClick" Margin="0,0,6,0"
                                ToolTip="Operaciones de edición de circuitos, tableros y materiales SC">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Acciones" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copiar circuito" Command="{Binding CopyCircuitoCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Pegar circuito" Command="{Binding PasteCircuitoCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📥" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Duplicar circuito (Ctrl+D)" Command="{Binding DuplicateCircuitoCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📑" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Eliminar circuito (Ctrl-)" Command="{Binding RemoveCircuitoCommand}"
                                              Foreground="{DynamicResource Brush.Danger}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🗑️" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Mover tablero a otra vista (Generales / Deptos)" Command="{Binding MoveCuadroPerspectiveCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🔁" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Eliminar tablero activo" Command="{Binding RemoveCuadroCommand}"
                                              Foreground="{DynamicResource Brush.Danger}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🗑️" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Resumen de materiales SC" Command="{Binding OpenResumenCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📊" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Catálogo de artefactos y canalizaciones" Command="{Binding OpenCatalogoCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Border}" Margin="2,0,8,0" VerticalAlignment="Center" />

                        <Button Style="{StaticResource Button.Toolbar}" Content="Exportar PDF"
                                Command="{Binding ExportPdfCommand}" ToolTip="Exportar planilla y cuadro de cargas a PDF"
                                Height="28" Padding="10,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Left side: Selector de perspectiva (CTOS GENERALES / DEPTOS) + Búsqueda integrada y herramientas -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Switch segmentado de perspectivas: CTOS GENERALES y DEPTOS -->
                        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2"
                                Height="28"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CTOS GENERALES"
                                        Command="{Binding SelectPerspectiveCommand}"
                                        CommandParameter="Generales"
                                        Cursor="Hand"
                                        Height="22"
                                        Padding="10,0"
                                        FontSize="11"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPerspectiveGenerales}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="DEPTOS"
                                        Command="{Binding SelectPerspectiveCommand}"
                                        CommandParameter="Deptos"
                                        Cursor="Hand"
                                        Height="22"
                                        Padding="10,0"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPerspectiveDeptos}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Border}" Margin="0,0,10,0" VerticalAlignment="Center" />

                        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="6,2" Height="28" Width="220" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Buscar tablero o circuito…" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                    <TextBox BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             FontSize="11" Foreground="{DynamicResource Brush.Ink}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filtra tableros y circuitos. En la grilla, Ctrl+F abre el buscador." />
                                </Grid>
                                <Button Grid.Column="2" Content="✕"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource Button.Ghost}"
                                        FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"
                                        Padding="2,0" Margin="3,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip="Limpiar búsqueda (Esc)" />
                            </Grid>
                        </Border>

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Border}" Margin="2,0,8,0" VerticalAlignment="Center" />

                        <!-- Herramientas -->
                        <Button Style="{StaticResource Button.Toolbar}" Content="Resumen" Command="{Binding OpenResumenCommand}" Height="28" Padding="9,0" Margin="0,0,4,0" />
                        <Button Style="{StaticResource Button.Toolbar}" Content="Catálogo" Command="{Binding OpenCatalogoCommand}" Height="28" Padding="9,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Barra de estado inferior ──────────────────────────────── -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                 Margin="0,8,0,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" />

            <!-- ── Cuerpo: sidebar + planilla ────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TablerosColumn" Width="170" MinWidth="46" MaxWidth="300" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── 1 · Tableros SC (Sidebar) ──────────────────────────── -->
                <Grid Grid.Column="0">
                    <Border x:Name="TablerosSidebarBorder"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="6,8" Margin="0,0,0,0">
                        <DockPanel>
                            <!-- Header en Modo Expandido -->
                            <DockPanel x:Name="TablerosHeaderExpanded" DockPanel.Dock="Top" Margin="2,0,4,8" LastChildFill="False">
                                <TextBlock Text="{Binding SidebarHeaderTitle, FallbackValue='TABLEROS'}"
                                           FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Canvas}" CornerRadius="10" Padding="5,1" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding CuadrosFiltradosCount, Mode=OneWay, StringFormat='{}{0}'}"
                                                   FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink3}" />
                                    </Border>
                                    <Button Content="+"
                                            ToolTip="Crear nuevo tablero"
                                            Command="{Binding AddCuadroCommand}"
                                            Style="{StaticResource Button.Ghost}"
                                            FontSize="{StaticResource Font.Size.sm}" FontWeight="Bold"
                                            Padding="4,0" Height="20" MinWidth="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Header en Modo Colapsado -->
                            <Border x:Name="TablerosHeaderCollapsed" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8"
                                    HorizontalAlignment="Center" ToolTip="{Binding SidebarHeaderTitle, FallbackValue='Tableros'}">
                                <TextBlock Text="TAB" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                            </Border>

                            <!-- ListBox en Modo Expandido -->
                            <ListBox x:Name="TablerosListExpanded"
                                     ItemsSource="{Binding CuadrosFiltrados}"
                                     SelectedItem="{Binding SelectedCuadro, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <!-- Doble clic sobre un tablero permite renombrarlo inline. -->
                                        <EventSetter Event="MouseDoubleClick" Handler="TableroItem_DoubleClick" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Mover a otra vista (Generales / Deptos)"
                                                                          Command="{Binding DataContext.MoveCuadroPerspectiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Eliminar tablero"
                                                                          Command="{Binding DataContext.RemoveCuadroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.HighlightBorder}" />
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True" />
                                                                <Condition Property="IsSelected" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nombre en modo lectura -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Nombre}"
                                                       FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Ink}"
                                                       ToolTip="Doble clic para renombrar"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />

                                            <!-- Nombre en modo edición -->
                                            <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                     Text="{Binding Nombre, UpdateSourceTrigger=LostFocus}"
                                                     FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                                     Padding="4,2" MaxLength="60"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                     IsVisibleChanged="TableroNombre_VisibleChanged"
                                                     LostFocus="TableroNombre_LostFocus"
                                                     KeyDown="TableroNombre_KeyDown" />

                                            <!-- Botones de acción del tablero: renombrar ✏ y eliminar 🗑 -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏"
                                                        FontSize="{StaticResource Font.Size.xs}"
                                                        Padding="3,1" Margin="2,0,1,0"
                                                        ToolTip="Renombrar tablero"
                                                        Click="TableroEdit_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🗑"
                                                        FontSize="{StaticResource Font.Size.xs}"
                                                        Foreground="{DynamicResource Brush.Danger}"
                                                        Padding="3,1" Margin="1,0,0,0"
                                                        ToolTip="Eliminar este tablero"
                                                        Command="{Binding DataContext.RemoveCuadroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <!-- Subtítulo / Métricas de circuitos -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       FontSize="{StaticResource Font.Size.xs}"
                                                       Foreground="{DynamicResource Brush.Muted}"
                                                       Margin="0,3,0,0">
                                                <Run Text="{Binding CircuitosActivos, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding CircuitosProyectados, Mode=OneWay}" /><Run Text=" circ" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- ListBox en Modo Colapsado (Chips pequeños con ToolTip completo) -->
                            <ListBox x:Name="TablerosListCollapsed"
                                     Visibility="Collapsed"
                                     ItemsSource="{Binding CuadrosFiltrados}"
                                     SelectedItem="{Binding SelectedCuadro, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <EventSetter Event="MouseDoubleClick" Handler="TablerosListCollapsed_MouseDoubleClick" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CompactBorder"
                                                            Width="34" Height="28"
                                                            Background="{DynamicResource Brush.Canvas}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            ToolTip="{Binding NombreCompletoTooltip}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CompactBorder" Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
                                                            <Setter TargetName="CompactBorder" Property="BorderBrush" Value="{DynamicResource Brush.HighlightBorder}" />
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True" />
                                                                <Condition Property="IsSelected" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="CompactBorder" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NombreCorto}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- ── Mueca / Pestaña handle en el borde lateral derecho ── -->
                    <Border x:Name="SidebarMuecaContainer"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,-10,0"
                            Panel.ZIndex="50"
                            Width="18" Height="30"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="0,6,6,0">
                        <Button x:Name="SidebarMuecaButton"
                                Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SidebarToggle_Click"
                                ToolTip="Colapsar panel de tableros">
                            <TextBlock x:Name="SidebarMuecaIcon" Text="◂" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Button>
                    </Border>
                </Grid>

                <!-- GridSplitter para redimensionar el ancho de la lista de tableros -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Focusable="False"
                              Background="Transparent" Cursor="SizeWE" Margin="1,0,1,0" />



                <!-- ── Planilla de Circuitos ──────────────────────────── -->

                <Border Grid.Column="2"

                        Background="{DynamicResource Brush.Surface}"

                        BorderBrush="{DynamicResource Brush.Border}"

                        BorderThickness="1" CornerRadius="8" Padding="10,12">

                    <Grid>

                        <!-- Estado vacío cuando no hay tablero seleccionado -->

                        <ctrl:EmptyStateControl

                            Visibility="{Binding HasSelectedCuadro, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"

                            HorizontalAlignment="Center" VerticalAlignment="Center"

                            Title="Sin tablero seleccionado"

                            Description="Seleccione un tablero en la lista lateral o agregue uno nuevo para configurar circuitos, protecciones y canalizaciones.">

                            <ctrl:EmptyStateControl.Actions>

                                <Button Style="{StaticResource Button.Primary}" Content="+ Agregar tablero" Command="{Binding AddCuadroCommand}" MinWidth="160" />

                            </ctrl:EmptyStateControl.Actions>

                        </ctrl:EmptyStateControl>



                        <DockPanel Visibility="{Binding HasSelectedCuadro, Converter={StaticResource BoolToVisibility}}">



                        <!-- Cabecera de la planilla (Diseño ejecutivo y limpio) -->

                        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">

                            <DockPanel LastChildFill="True">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding PlanillaTitle, FallbackValue='CUBICACIÓN DE CIRCUITOS'}"

                                               FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"

                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding SelectedCuadro.Nombre, FallbackValue='—'}"

                                               FontSize="{StaticResource Font.Size.md}" FontWeight="Bold"

                                               Foreground="{DynamicResource Brush.Ink}" Margin="0,0,12,0" VerticalAlignment="Center" />

                                    <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">

                                        <TextBlock FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}">

                                            <Run Text="{Binding SelectedCuadro.CircuitosActivos, Mode=OneWay}" /><Run Text=" circuitos activos" />

                                        </TextBlock>

                                    </Border>

                                </StackPanel>

                            </DockPanel>

                        </Border>



                        <!-- Banda de categorías sobre la cabecera de columnas: sincronizada con ScrollViewer -->

                        <ScrollViewer x:Name="BandScrollViewer"

                                      DockPanel.Dock="Top"

                                      HorizontalScrollBarVisibility="Hidden"

                                      VerticalScrollBarVisibility="Disabled"

                                      Focusable="False">

                            <Grid x:Name="BandGrid">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BandColNumero" Width="Auto" MinWidth="0" />
                                    <!-- 0: N° -->
                                    <ColumnDefinition x:Name="BandColSist" Width="Auto" MinWidth="0" />
                                    <!-- 1: Sist. -->
                                    <ColumnDefinition x:Name="BandColAlim" Width="Auto" MinWidth="0" />
                                    <!-- 2: Alim. -->
                                    <ColumnDefinition x:Name="BandColUbicacion" Width="Auto" MinWidth="0" />
                                    <!-- 3: Ubicación / Pisos -->
                                    <ColumnDefinition x:Name="BandColMedidasEntrada" Width="Auto" MinWidth="0" />
                                    <!-- 4: Medidas entrada (50+50) -->
                                    <ColumnDefinition x:Name="BandColTramoBandeja" Width="Auto" MinWidth="0" />
                                    <!-- 5: Tramo bandeja (80+70+58) -->
                                    <ColumnDefinition x:Name="BandColTramoPvc" Width="Auto" MinWidth="0" />
                                    <!-- 6: Tramo PVC (60+54+78+66+58) -->
                                    <ColumnDefinition x:Name="BandColMontaje" Width="Auto" MinWidth="0" />
                                    <!-- 7: Montaje (54) -->
                                    <ColumnDefinition x:Name="BandColCajas" Width="Auto" MinWidth="0" />
                                    <!-- 8: Cajas (42+42+42) -->
                                    <ColumnDefinition x:Name="BandColTmf" Width="Auto" MinWidth="0" />
                                    <!-- 9: Terminal flexible (40+50) -->
                                    <ColumnDefinition x:Name="BandColArtefactos" Width="Auto" MinWidth="0" />
                                    <!-- 10: Artefactos (105) -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.Resources>

                                    <Style x:Key="GroupBandCell" TargetType="Border">

                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />

                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />

                                        <Setter Property="BorderThickness" Value="0,1,1,0" />

                                    </Style>

                                    <Style x:Key="GroupBandLabel" TargetType="TextBlock">

                                        <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />

                                        <Setter Property="FontWeight" Value="Bold" />

                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />

                                        <Setter Property="HorizontalAlignment" Value="Center" />

                                        <Setter Property="VerticalAlignment" Value="Center" />

                                        <Setter Property="Margin" Value="2,3,2,2" />

                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />

                                    </Style>

                                </Grid.Resources>



                                <!-- Columnas sin categoría general (N°, Sist., Alim., Ubicación) -->

                                <Border Grid.Column="0" Style="{StaticResource GroupBandCell}" />

                                <Border Grid.Column="1" Style="{StaticResource GroupBandCell}" />

                                <Border Grid.Column="2" Style="{StaticResource GroupBandCell}" />

                                <Border x:Name="BandBorderUbicacion" Grid.Column="3" Style="{StaticResource GroupBandCell}" />



                                <Border x:Name="BandBorderMedidasEntrada" Grid.Column="4" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="3" Fill="{DynamicResource Brush.Blue}" />

                                        <TextBlock x:Name="BandLabelMedidasEntrada" Text="MEDIDAS ENTRADA" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border x:Name="BandBorderTramoBandeja" Grid.Column="5" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Pink}" />

                                        <TextBlock Text="TRAMO BANDEJA" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border Grid.Column="6" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Success}" />

                                        <TextBlock Text="TRAMO PVC (CONDUIT)" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border Grid.Column="7" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Slate}" />

                                        <TextBlock Text="MONTAJE" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border Grid.Column="8" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Cyan}" />

                                        <TextBlock Text="CAJAS" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border x:Name="BandBorderTmf" Grid.Column="9" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Amber}" />

                                        <TextBlock Text="TERM. FLEXIBLE" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border Grid.Column="10" Style="{StaticResource GroupBandCell}">

                                    <DockPanel>

                                        <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Blue}" />

                                        <TextBlock Text="ARTEFACTOS" Style="{StaticResource GroupBandLabel}" />

                                    </DockPanel>

                                </Border>

                                <Border Grid.Column="11" Style="{StaticResource GroupBandCell}" />

                            </Grid>

                        </ScrollViewer>


                        <!-- DataGrid de circuitos — SelectionUnit=Cell (estilo Excel): solo se marcan las
                 celdas elegidas, no la fila entera al escribir. SelectedCircuito se sincroniza
                 desde CurrentCell (code-behind), sin SelectedItem: ese binding + CellOrRowHeader
                 pintaba toda la fila de azul al editar REC/conductor. Clic en N° selecciona la
                 fila completa para Ctrl+C de circuito. -->
                        <Grid>
                        <DataGrid x:Name="CircuitosGrid"
                      ItemsSource="{Binding CircuitosFiltrados}"
                      Style="{StaticResource DataGrid.Workspace.Excel}"
                      infra:DataGridExcelNavigation.Enable="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="{Binding IsGridReadOnly}"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      RowHeight="27"
                      FontSize="{StaticResource Font.Size.xs}"
                      CurrentCellChanged="CircuitosGrid_CurrentCellChanged"
                      PreviewMouseLeftButtonDown="CircuitosGrid_PreviewMouseLeftButtonDown"
                      PreviewKeyDown="CircuitosGrid_PreviewKeyDown"
                      PreviewTextInput="CircuitosGrid_PreviewTextInput"
                      EnableRowVirtualization="False"
                      VirtualizingPanel.IsVirtualizing="False"
                      VirtualizingPanel.VirtualizationMode="Standard"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                                    <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="2,4" />
                                <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>

                                <!-- N°: clic = seleccionar todo el circuito (para Ctrl+C de fila completa) -->
                                <DataGridTextColumn x:Name="NumeroColumn" Header="N°" Binding="{Binding Numero}" Width="34*" MinWidth="34" CanUserResize="False" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="Clic: seleccionar circuito · Ctrl+C copia todo" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- SIST (Chip coloreado) -->
                                <DataGridTemplateColumn x:Name="ColSist" Header="SIST" Width="38*" MinWidth="38" CanUserResize="False"
                                                        ClipboardContentBinding="{Binding Tipo}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SistemaChipBorder}" HorizontalAlignment="Center"
                                                    ToolTip="{Binding TipoNombre, Mode=OneWay, StringFormat='{}{0} (SIST)'}">
                                                <TextBlock Text="{Binding Tipo}" Style="{StaticResource SistemaChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Tipo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Style="{StaticResource DataGrid.CellEditTextBox}"
                               FontSize="{StaticResource Font.Size.xs}" HorizontalContentAlignment="Center"
                               LostFocus="TipoEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ALIM (Chip coloreado) -->
                                <DataGridTemplateColumn x:Name="ColAlim" Header="ALIM" Width="38*" MinWidth="38" CanUserResize="False"
                                                        ClipboardContentBinding="{Binding Fase}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FaseChipBorder}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Fase}" Style="{StaticResource FaseChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Fase, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               Style="{StaticResource DataGrid.CellEditTextBox}"
                               FontSize="{StaticResource Font.Size.xs}" HorizontalContentAlignment="Center"
                               LostFocus="FaseEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ubicación / Pisos -->
                                <DataGridTemplateColumn x:Name="ColUbicacion" Header="UBICACIÓN" Width="90*" MinWidth="64" CanUserResize="False"
                                                        ClipboardContentBinding="{Binding Ubicacion}"
                                                        Visibility="{Binding DataContext.ShowColUbicacion, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="UbicCellRoot">
                                                <Border x:Name="UbicHost" Background="Transparent" CornerRadius="5" Margin="1">
                                                    <TextBlock Text="{Binding Ubicacion}"
                                                               FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}"
                                                               TextAlignment="Left" VerticalAlignment="Center"
                                                               Padding="4,0,16,0" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Button x:Name="PisosBtn" Padding="0" Focusable="False" IsTabStop="False"
                                Width="10" Height="16"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource Brush.Muted}"
                                ToolTip="Varios pisos (Alt+P · Esc para cerrar)"
                                Click="PisosBtn_Click" Opacity="0"
                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                IsHitTestVisible="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid>
                                                                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                                                                            <Path Width="9" Height="9" Stretch="Uniform"
                                                                                  Fill="{TemplateBinding Foreground}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Data="M2,14 V6 L8,2 L14,6 V14 H2 M5,14 V9 H11 V14 M6,7.5 H7 M9,7.5 H10 M6,11.5 H7 M9,11.5 H10" />
                                                                            <Ellipse x:Name="Dot" Width="5" Height="5" Fill="{DynamicResource Brush.Amber}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                                               Visibility="Collapsed" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding TienePisos}" Value="True">
                                                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Popup x:Name="PisosPopup" PlacementTarget="{Binding ElementName=PisosBtn}"
                               Placement="Bottom" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True"
                               PopupAnimation="None"
                               IsOpen="{Binding PisosPopupOpen, Mode=TwoWay}"
                               Opened="PisosPopup_Opened" Closed="PisosPopup_Closed">
                                                    <Border Width="288" Background="{DynamicResource Brush.Surface}"
                                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                  CornerRadius="10" Padding="0"
                                  LostKeyboardFocus="PisosFlyout_LostKeyboardFocus"
                                  PreviewKeyDown="PisosFlyout_PreviewKeyDown">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#1A2338" Opacity="0.16" BlurRadius="20" ShadowDepth="6" Direction="270" />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <!-- Header: icono + circuito + hint de atajos -->
                                                            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="10,10,0,0"
                                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="12,10,12,9">
                                                                <StackPanel>
                                                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                                        <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="5"
                                            Background="{DynamicResource Brush.BlueSoft}" Margin="0,0,7,0">
                                                                            <Path Width="11" Height="11" Stretch="Uniform"
                                                                                  Fill="{DynamicResource Brush.Blue}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Data="M2,14 V6 L8,2 L14,6 V14 H2 M5,14 V9 H11 V14 M6,7.5 H7 M9,7.5 H10 M6,11.5 H7 M9,11.5 H10" />
                                                                        </Border>
                                                                        <TextBlock DockPanel.Dock="Left" Text="Varios pisos" FontSize="{StaticResource Font.Size.md}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                                               VerticalAlignment="Center" />
                                                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.xs}"
                                               Foreground="{DynamicResource Brush.Muted}">
                                      <Run Text="circuito " /><Run Text="{Binding Numero, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </DockPanel>
                                                                    <TextBlock FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.Muted}"
                                             TextWrapping="Wrap" Margin="27,0,0,0" LineHeight="14">
                                    <Run Text="↑ ↓" FontWeight="Bold" /><Run Text=" cambia de zona · " />
                                    <Run Text="← →" FontWeight="Bold" /><Run Text=" cambia de columna · " />
                                    <Run Text="Tab" FontWeight="Bold" /><Run Text=" recorre todo" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Encabezado de columnas -->
                                                            <Grid Margin="16,8,16,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="62" />
                                                                    <ColumnDefinition Width="62" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="ZONA" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}" />
                                                                <TextBlock Grid.Column="1" Text="L. BAND" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
                                                                <TextBlock Grid.Column="2" Text="L. PVC" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="6,0,0,0" />
                                                            </Grid>

                                                            <!-- Lista de zonas -->
                                                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="8,2,8,8">
                                                                <ItemsControl ItemsSource="{Binding ZonaPisos}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border CornerRadius="7" Padding="4,3" Margin="0,1">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="Transparent" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="62" />
                                                                                        <ColumnDefinition Width="62" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <DockPanel Grid.Column="0" LastChildFill="True">
                                                                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="2,0,7,0" VerticalAlignment="Center">
                                                                                            <Ellipse.Style>
                                                                                                <Style TargetType="Ellipse">
                                                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Line}" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Blue}" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Ellipse.Style>
                                                                                        </Ellipse>
                                                                                        <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Font.Size.sm}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </DockPanel>

                                                                                    <TextBox x:Name="BandBox" Grid.Column="1" Margin="4,1,0,1"
                                                   Text="{Binding BandText, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="{StaticResource Font.Size.sm}" Padding="6,5" TextAlignment="Right" BorderThickness="1"
                                                   Background="{DynamicResource Brush.Surface2}"
                                                   BorderBrush="{DynamicResource Brush.Line}"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   IsReadOnly="{Binding DataContext.IsGridReadOnly, ElementName=CircuitosGrid}"
                                                   PreviewKeyDown="PisosPopupInput_PreviewKeyDown"
                                                   GotFocus="PisosPopupInput_GotFocus" Tag="0" />
                                                                                    <TextBox x:Name="PvcBox" Grid.Column="2" Margin="4,1,0,1"
                                                   Text="{Binding PvcText, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="{StaticResource Font.Size.sm}" Padding="6,5" TextAlignment="Right" BorderThickness="1"
                                                   Background="{DynamicResource Brush.Surface2}"
                                                   BorderBrush="{DynamicResource Brush.Line}"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   IsReadOnly="{Binding DataContext.IsGridReadOnly, ElementName=CircuitosGrid}"
                                                   PreviewKeyDown="PisosPopupInput_PreviewKeyDown"
                                                   GotFocus="PisosPopupInput_GotFocus" Tag="1" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>

                                                            <!-- Footer -->
                                                            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="0,0,10,10"
                                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                                                                <DockPanel LastChildFill="False">
                                                                    <TextBlock DockPanel.Dock="Left" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}">
                                    <Run Text="Total " /><Run Text="{Binding ZonaPisosTotal, Mode=OneWay}" FontWeight="Bold"
                                                              Foreground="{DynamicResource Brush.Blue}" /><Run Text=" m" />
                                                                    </TextBlock>
                                                                    <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.Muted}">
                                    <Run Text="Esc" FontWeight="Bold" /><Run Text=" cierra" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="UbicCellRoot" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PisosBtn" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding TienePisos}" Value="True">
                                                    <Setter TargetName="PisosBtn" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Ubicacion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DataGrid.CellEditTextBox}"
                                                     FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}"
                                                     HorizontalContentAlignment="Left"
                                                     Padding="4,0,16,0"
                                                     Loaded="UbicacionEditor_Loaded"
                                                     LostFocus="UbicacionEditor_LostFocus"
                                                     PreviewKeyDown="UbicacionEditor_PreviewKeyDown">
                                                <TextBox.IsReadOnly>
                                                    <MultiBinding Converter="{StaticResource BoolOr}">
                                                        <Binding Path="TienePisos" />
                                                        <Binding Path="DataContext.IsGridReadOnly"
                                                                 RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                    </MultiBinding>
                                                </TextBox.IsReadOnly>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- L. Band (M) — color rosa -->
                                <DataGridTextColumn x:Name="ColLBand" Header="L. BAND"
                                    Binding="{Binding LargoBandeja, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                    Width="50*" MinWidth="48" CanUserResize="False"
                                    Visibility="{Binding DataContext.ShowColLBand, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Pink}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,4,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- L. PVC (M) — color verde -->
                                <DataGridTextColumn x:Name="ColLPvc" Header="L.PVC"
                                    Binding="{Binding LargoTuberia, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                    Width="50*" MinWidth="48" CanUserResize="False"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessBright}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,4,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Conductor Bandeja: lista desplegable con filtro (catálogo TiposConductor) -->
                                <DataGridTemplateColumn x:Name="ColCondBand" Header="CONDUCTOR" Width="80*" MinWidth="76" CanUserResize="False"
                                        ClipboardContentBinding="{Binding ConductorDistribucion}"
                                        Visibility="{Binding DataContext.ShowColBandejaAdvanced, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ConductorDistribucion}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                     <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="ConductorDistribucion"
                                ItemsSource="{Binding DataContext.TiposConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding ConductorDistribucion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                FontSize="{StaticResource Font.Size.xs}"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="ConductorBandEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Sección Bandeja: catálogo SeccionesConductor -->
                                <DataGridTemplateColumn x:Name="ColSeccBand" Header="SECCIÓN" Width="70*" MinWidth="66" CanUserResize="False"
                                        ClipboardContentBinding="{Binding SeccionDistribucion}"
                                        Visibility="{Binding DataContext.ShowColBandejaAdvanced, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeccionDistribucion}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="SeccionDistribucion"
                                ItemsSource="{Binding DataContext.SeccionesConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding SeccionDistribucion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                FontSize="{StaticResource Font.Size.xs}"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="SeccionBandEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Band (M) — calculado rosa -->
                                <DataGridTextColumn x:Name="ColTotBand" Header="TOTAL (M)"
                                    Binding="{Binding LargoDistribucion, StringFormat=N0}"
                                    Width="58*" MinWidth="56" CanUserResize="False" IsReadOnly="True"
                                    Visibility="{Binding DataContext.ShowColBandeja, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Pink}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,4,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tipo tubería / canalización: catálogo TiposTuberia -->
                                <DataGridTemplateColumn x:Name="ColTipoPvc" Header="TIPO" Width="60*" MinWidth="56" CanUserResize="False"
                                        Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}"
                                        ClipboardContentBinding="{Binding TipoTuberia}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TipoTuberia}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="TipoTuberia"
                                ItemsSource="{Binding DataContext.TiposTuberia, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding TipoTuberia, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                FontSize="{StaticResource Font.Size.xs}"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="TipoTuberiaEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ducto Ø: lista desplegable con filtro (catálogo DiametrosTuberia) -->
                                <DataGridTemplateColumn x:Name="ColDuctoPvc" Header="DIAM  Ø" Width="54*" MinWidth="52" CanUserResize="False"
                                        ClipboardContentBinding="{Binding SeccionTuberia}"
                                        Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeccionTuberia}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="SeccionTuberia"
                                ItemsSource="{Binding DataContext.DiametrosTuberia, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding SeccionTuberia, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                FontSize="{StaticResource Font.Size.xs}"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="SeccionTuberiaEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Conductor PVC: catálogo TiposConductor -->
                                <DataGridTemplateColumn x:Name="ColCondPvc" Header="CONDUCTOR" Width="78*" MinWidth="72" CanUserResize="False"
                                        ClipboardContentBinding="{Binding ConductorDerivacion}"
                                        Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ConductorDerivacion}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="ConductorDerivacion"
                                ItemsSource="{Binding DataContext.TiposConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding ConductorDerivacion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                FontSize="{StaticResource Font.Size.xs}"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="ConductorPvcEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Sección PVC: catálogo SeccionesConductor -->
                                <DataGridTemplateColumn x:Name="ColSeccPvc" Header="SECCION" Width="66*" MinWidth="60" CanUserResize="False"
                                        ClipboardContentBinding="{Binding SeccionDerivacion}"
                                        Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeccionDerivacion}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="SeccionDerivacion"
                                ItemsSource="{Binding DataContext.SeccionesConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding SeccionDerivacion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                FontSize="{StaticResource Font.Size.xs}"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="SeccionPvcEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total PVC (M) — calculado verde -->
                                <DataGridTextColumn x:Name="ColTotPvc" Header="TOTAL (M)"
                                    Binding="{Binding LargoDerivacion, StringFormat=N0}"
                                    Width="58*" MinWidth="56" CanUserResize="False" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessBright}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,4,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montaje -->
                                <DataGridTextColumn x:Name="ColLuminaria" Header="LUMIN."
                                    Binding="{Binding MontajesAlumbrado, UpdateSourceTrigger=LostFocus}"
                                    Width="54*" MinWidth="52" CanUserResize="False"
                                    Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="Luminaria / Montaje" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Caja 5/8" -->
                                <DataGridTextColumn x:Name="ColCaja58" Header='5/8"'
                                    Binding="{Binding Cajas58, UpdateSourceTrigger=LostFocus}"
                                    Width="42*" MinWidth="40" CanUserResize="False"
                                    Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="Caja octogonal 5/8&quot;" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Caja A11 (100×100) -->
                                <DataGridTextColumn x:Name="ColCaja100" Header="A11"
                                    Binding="{Binding Cajas100x100, UpdateSourceTrigger=LostFocus}"
                                    Width="42*" MinWidth="40" CanUserResize="False"
                                    Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="Caja de distribución A11 (100×100)" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Caja A01 (100×65) -->
                                <DataGridTextColumn x:Name="ColCaja65" Header="A01"
                                    Binding="{Binding Cajas100x65, UpdateSourceTrigger=LostFocus}"
                                    Width="42*" MinWidth="40" CanUserResize="False"
                                    Visibility="{Binding DataContext.IsAdvancedMode, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="Cantidad de cajas A01 (100×65). En departamentos se edita; un circuito nuevo parte en 0." />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- TMF Cant. — dorado, solo lectura, calculado automáticamente -->
                                <DataGridTextColumn x:Name="ColTmfCant" Header="CANT"
                                    Binding="{Binding TmfCantidad}"
                                    Width="40*" MinWidth="38" CanUserResize="False" IsReadOnly="True"
                                    Visibility="{Binding DataContext.ShowColTmf, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- TMF Medida — dorado, solo lectura, calculado automáticamente -->
                                <DataGridTextColumn x:Name="ColTmfMed" Header="DIAM  Ø"
                                    Binding="{Binding TmfMedida}"
                                    Width="50*" MinWidth="48" CanUserResize="False" IsReadOnly="True"
                                    Visibility="{Binding DataContext.ShowColTmf, ElementName=CircuitosGrid, Converter={StaticResource BoolToVisibility}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- ARTEFACTOS: botón que abre el diálogo de agregado rápido por zona -->
                                <DataGridTemplateColumn x:Name="ColArtefactos" Header="ARTEFACTOS" Width="105*" MinWidth="88" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.Secondary}"
                              Margin="2,1" Padding="4,1" FontSize="{StaticResource Font.Size.2xs}"
                              HorizontalAlignment="Stretch"
                              Content="{Binding ArtefactosResumen}"
                              Command="{Binding DataContext.OpenArtefactosCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}"
                              IsHitTestVisible="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <ctrl:DataGridSearchOverlay x:Name="CircuitosSearchOverlay"
                                                    TargetGrid="{Binding ElementName=CircuitosGrid}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,8,18,0"
                                                    Panel.ZIndex="100" />
                        </Grid>

                    </DockPanel>
                    </Grid>
                </Border>

            </Grid>
        </DockPanel>

        <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando cubicación de circuitos…"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>

