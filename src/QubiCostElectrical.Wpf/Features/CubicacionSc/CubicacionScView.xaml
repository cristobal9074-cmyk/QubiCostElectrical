                        <!-- Popup flotante moderno de catalogo (Estilo Google Sheets / Excel / Notion) -->
                        <Popup x:Name="CatalogPopup"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border MinWidth="120" MaxWidth="280" MaxHeight="220"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    Margin="0,2,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" Opacity="0.16" BlurRadius="12" ShadowDepth="4" Direction="270" />
                                </Border.Effect>
                                <ListBox x:Name="CatalogListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Focusable="False"
                                         SelectionMode="Single"
                                         PreviewMouseLeftButtonDown="CatalogListBox_PreviewMouseLeftButtonDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,5" />
                                            <Setter Property="Margin" Value="1,1" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="Transparent"
                                                                CornerRadius="5"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>


