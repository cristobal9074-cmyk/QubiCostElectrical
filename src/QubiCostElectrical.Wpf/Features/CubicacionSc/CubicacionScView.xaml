<UserControl x:Class="QubiCostElectrical.Wpf.Features.CubicacionSc.CubicacionScView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <!-- Chip de estado de circuito (verde=activo, ámbar=reserva) -->
        <Style x:Key="EstadoChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Activo">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva">
                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva equipada">
                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EstadoChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Activo">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Reserva equipada">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Chip de sistema (tipo de uso del circuito) con colores del HTML -->
        <Style x:Key="SistemaChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tipo}" Value="A">
                    <Setter Property="Background" Value="#2A1E14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="E">
                    <Setter Property="Background" Value="#172237" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="CL">
                    <Setter Property="Background" Value="#231B3D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="C">
                    <Setter Property="Background" Value="#112F35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="F">
                    <Setter Property="Background" Value="#2F2412" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SistemaChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tipo}" Value="A">
                    <Setter Property="Foreground" Value="#FFAE42" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="E">
                    <Setter Property="Foreground" Value="#3B82F6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="CL">
                    <Setter Property="Foreground" Value="#8B5CF6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="C">
                    <Setter Property="Foreground" Value="#06B6D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tipo}" Value="F">
                    <Setter Property="Foreground" Value="#F59E0B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chip de Fase/Alimentación con colores del HTML -->
        <Style x:Key="FaseChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fase}" Value="M">
                    <Setter Property="Background" Value="#132D24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="T">
                    <Setter Property="Background" Value="#381A1A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="EM">
                    <Setter Property="Background" Value="#4B1212" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FaseChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Fase}" Value="M">
                    <Setter Property="Foreground" Value="#10B981" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="T">
                    <Setter Property="Foreground" Value="#F87171" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Fase}" Value="EM">
                    <Setter Property="Foreground" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonoRightCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Estado vacío cuando no hay proyecto abierto.
             En el diseñador se oculta (d:Visibility) para poder editar el layout sin solapes. -->
        <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            d:Visibility="Collapsed"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para editar tableros y circuitos de servicios comunes (C.SC).">
            <ctrl:EmptyStateControl.Actions>
                <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
            </ctrl:EmptyStateControl.Actions>
        </ctrl:EmptyStateControl>

        <!-- Contenido principal cuando hay proyecto -->
        <DockPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                   d:Visibility="Visible"
                   Margin="20,14,20,14">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Cubicación de Servicios Comunes (C.SC)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="Cálculo de canalizaciones, bandejas portaconductores, cajas de derivación y terminales de servicios comunes por circuitos."
                     Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding ExportPdfCommand}" VerticalAlignment="Center" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄 " />
                        <TextBlock Text="Exportar PDF" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- HUD Cards Row -->

            <!-- Control Panel / Actions Toolbar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card.Surface}" Padding="12,8" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <!-- Right side: Actions -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Toolbar}" Content="📚 Catálogo" Command="{Binding OpenCatalogoCommand}" />
                        <Button Style="{StaticResource Button.Toolbar}" Content="📊 Resumen" Command="{Binding OpenResumenCommand}" />
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Agregar tablero" Command="{Binding AddCuadroCommand}" />
                        <Button Style="{StaticResource Button.Toolbar}" Content="+ Agregar circuito" Command="{Binding AddCircuitoCommand}" />
                        <Button Style="{StaticResource Button.Toolbar}" Content="Duplicar" Command="{Binding DuplicateCircuitoCommand}" />
                        <Button Style="{StaticResource Button.Toolbar}" Content="Quitar" Command="{Binding RemoveCircuitoCommand}" Foreground="{DynamicResource Brush.Danger}" />

                        <!-- More dropdown button -->
                        <Button x:Name="MoreActionsButton" Style="{StaticResource Button.Ghost}" Content="⋯" Padding="12,4" VerticalAlignment="Center" Click="OnMoreActionsClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copiar circuito" Command="{Binding CopyCircuitoCommand}" />
                                    <MenuItem Header="Pegar circuito" Command="{Binding PasteCircuitoCommand}" />
                                    <Separator />
                                    <MenuItem Header="Eliminar tablero activo" Command="{Binding RemoveCuadroCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- Left side: Filter by Piso -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ── Barra de estado inferior ──────────────────────────────── -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                 Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />

            <!-- ── Cuerpo: sidebar + planilla ────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── 1 · Tableros SC (Sidebar) ──────────────────────────── -->
                <Border Grid.Column="0"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                       Text="1 · TABLEROS SC"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Muted}"
                       Margin="0,0,0,5" />
                        <ListBox ItemsSource="{Binding Cuadros}"
                     SelectedItem="{Binding SelectedCuadro, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="9,8" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <!-- Doble clic sobre un tablero permite renombrarlo inline. -->
                                    <EventSetter Event="MouseDoubleClick" Handler="TableroItem_DoubleClick" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0A1120" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Nombre en modo lectura -->
                                            <TextBlock Grid.Column="0" Text="{Binding Nombre}"
                                 FontSize="12" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Ink}"
                                 ToolTip="Doble clic para renombrar"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            <!-- Nombre en modo edición -->
                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Nombre, UpdateSourceTrigger=LostFocus}"
                               FontSize="12" FontWeight="SemiBold" Padding="2,0" MaxLength="60"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                               IsVisibleChanged="TableroNombre_VisibleChanged"
                               LostFocus="TableroNombre_LostFocus"
                               KeyDown="TableroNombre_KeyDown" />
                                            <!-- Botón lápiz: renombra sin doble clic -->
                                            <Button Grid.Column="1" Content="✎" FontSize="11" Padding="4,0" Margin="4,0,0,0"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              Foreground="{DynamicResource Brush.Muted}"
                              ToolTip="Renombrar tablero"
                              Click="TableroEdit_Click"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                        </Grid>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0">
                      <Run Text="{Binding CircuitosActivos, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding CircuitosProyectados, Mode=OneWay}" /><Run Text=" circuitos" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ── 2 · Planilla de Circuitos ──────────────────────────── -->
                <Border Grid.Column="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel>

                        <!-- Cabecera de la planilla -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                         FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Accent}">
                <Run Text="2 · PLANILLA DE CIRCUITOS (" /><Run Text="{Binding SelectedCuadro.Nombre, FallbackValue='—'}" /><Run Text=")" />
                            </TextBlock>
                        </DockPanel>

                        <!-- Banda de categorías sobre la cabecera de columnas: agrupa visualmente los
                 tramos de canalización (Medidas entrada / Tramo bandeja / Tramo PVC / Cajas /
                 Terminal flexible) para ubicarse más rápido en una tabla con muchas columnas.
                 Mismo fondo/borde que DataGridColumnHeader.Prototype (Brush.Surface2 /
                 Brush.Line) para leerse como una sola cabecera de dos filas, con un subrayado
                 fino de color por categoría en vez de bloques sólidos saturados. Los anchos de
                 cada celda deben calzar con la suma de Width de las DataGridColumn que agrupan
                 (ver comentario junto a cada columna más abajo); si se cambia el ancho de una
                 columna, actualizar también aquí. -->
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35" />
                                <!-- N° -->
                                <ColumnDefinition Width="50" />
                                <!-- Sist. -->
                                <ColumnDefinition Width="50" />
                                <!-- Alim. -->
                                <ColumnDefinition Width="80" />
                                <!-- Ubicación / Pisos -->
                                <ColumnDefinition Width="110" />
                                <!-- Medidas entrada: L.Band 55 + L.PVC 55 -->
                                <ColumnDefinition Width="200" />
                                <!-- Tramo bandeja: Conductor 75 + Sección 70 + Total 55 -->
                                <ColumnDefinition Width="300" />
                                <!-- Tramo PVC: Tipo 55 + Ducto 45 + Conductor 75 + Sección 70 + Total 55 -->
                                <ColumnDefinition Width="52" />
                                <!-- Montaje -->
                                <ColumnDefinition Width="156" />
                                <!-- Cajas: 5/8" 52 + 100x100 52 + 100x65 52 -->
                                <ColumnDefinition Width="105" />
                                <!-- Terminal flexible: Cant. 50 + Medida 55 -->
                                <ColumnDefinition Width="165" />
                                <!-- Artefactos × zona: botón 165 -->
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style x:Key="GroupBandCell" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                    <Setter Property="BorderThickness" Value="0,1,1,0" />
                                </Style>
                                <Style x:Key="GroupBandLabel" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="9.5" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="4,6,4,4" />
                                </Style>
                            </Grid.Resources>

                            <!-- Columnas sin categoría (N°, Sist., Alim., Ubicación, Montaje): mismo fondo/
                   borde para que la franja se vea continua, sin etiqueta. -->
                            <Border Grid.Column="0" Style="{StaticResource GroupBandCell}" />
                            <Border Grid.Column="1" Style="{StaticResource GroupBandCell}" />
                            <Border Grid.Column="2" Style="{StaticResource GroupBandCell}" />
                            <Border Grid.Column="3" Style="{StaticResource GroupBandCell}" />
                            <Border Grid.Column="7" Style="{StaticResource GroupBandCell}" />

                            <Border Grid.Column="4" Style="{StaticResource GroupBandCell}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Bottom" Height="3" Fill="{DynamicResource Brush.Blue}" />
                                    <TextBlock Text="MEDIDAS ENTRADA (M)" Style="{StaticResource GroupBandLabel}" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource GroupBandCell}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="#EC4899" />
                                    <TextBlock Text="TRAMO BANDEJA" Style="{StaticResource GroupBandLabel}" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource GroupBandCell}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Success}" />
                                    <TextBlock Text="TRAMO PVC (CONDUIT)" Style="{StaticResource GroupBandLabel}" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="8" Style="{StaticResource GroupBandCell}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="#06B6D4" />
                                    <TextBlock Text="CAJAS" Style="{StaticResource GroupBandLabel}" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource GroupBandCell}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Amber}" />
                                    <TextBlock Text="TERMINAL FLEXIBLE" Style="{StaticResource GroupBandLabel}" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="10" Style="{StaticResource GroupBandCell}">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Bottom" Height="2" Fill="{DynamicResource Brush.Blue}" />
                                    <TextBlock Text="ARTEFACTOS × ZONA" Style="{StaticResource GroupBandLabel}" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- DataGrid de circuitos — SelectionUnit=Cell (estilo Excel): solo se marcan las
                 celdas elegidas, no la fila entera al escribir. SelectedCircuito se sincroniza
                 desde CurrentCell (code-behind), sin SelectedItem: ese binding + CellOrRowHeader
                 pintaba toda la fila de azul al editar REC/conductor. Clic en N° selecciona la
                 fila completa para Ctrl+C de circuito. -->
                        <DataGrid x:Name="CircuitosGrid"
                      ItemsSource="{Binding CircuitosFiltrados}"
                      Style="{StaticResource DataGrid.Workspace.Excel}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="{Binding IsGridReadOnly}"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      FontSize="11"
                      CurrentCellChanged="CircuitosGrid_CurrentCellChanged"
                      PreviewMouseLeftButtonDown="CircuitosGrid_PreviewMouseLeftButtonDown"
                      PreviewKeyDown="CircuitosGrid_PreviewKeyDown"
                      PreviewTextInput="CircuitosGrid_PreviewTextInput"
                      EnableRowVirtualization="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <!-- N°: clic = seleccionar todo el circuito (para Ctrl+C de fila completa) -->
                                <DataGridTextColumn x:Name="NumeroColumn" Header="N°" Binding="{Binding Numero}" Width="35" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="Clic: seleccionar circuito · Ctrl+C copia todo" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- SIST. (Chip coloreado). Edición por texto libre (no ComboBox): escribir
                     "e" + Tab lo normaliza a "E" (Enchufe) en CircuitoScRowVm.Tipo — un combo
                     obliga a abrir el menú o usar flechas, mucho más lento para cargar varios
                     circuitos seguidos a pura tecla. Binding OneWay + commit explícito en
                     LostFocus (code-behind): un DataGridTemplateColumn no confirma de forma
                     confiable un binding TwoWay con UpdateSourceTrigger=LostFocus al cerrar la
                     celda vía Tab/Enter (limitación conocida de WPF) — con TwoWay el valor
                     tecleado simplemente no llegaba nunca al ViewModel. -->
                                <DataGridTemplateColumn Header="SIST." Width="50" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SistemaChipBorder}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Tipo}" Style="{StaticResource SistemaChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Tipo, Mode=OneWay}"
                               Style="{StaticResource DataGrid.CellEditTextBox}"
                               FontSize="11" HorizontalContentAlignment="Center"
                               LostFocus="TipoEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ALIM. / Fase (Chip coloreado). Mismo criterio: texto libre, "t" + Tab
                     normaliza a "T" (Trifásico) en CircuitoScRowVm.Fase. -->
                                <DataGridTemplateColumn Header="ALIM." Width="50" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FaseChipBorder}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Fase}" Style="{StaticResource FaseChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Fase, Mode=OneWay}"
                               Style="{StaticResource DataGrid.CellEditTextBox}"
                               FontSize="11" HorizontalContentAlignment="Center"
                               LostFocus="FaseEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ubicación / Pisos: la celda ES un campo de texto libre (un solo piso, ej. "1",
                     "-2", "Azotea") — se escribe directo, sin abrir nada. El icono 🏢 de la
                     esquina (solo visible al pasar el mouse o enfocar la celda) abre un flyout
                     anclado, estilo panel ejecutivo, con las zonas del proyecto (Cubicación) para
                     cuando el circuito pasa por varios pisos; cada zona lleva su propio L.Band/
                     L.PVC y se activa sola al escribirle un largo (sin checkbox). Navegación 100%
                     teclado dentro del flyout: ↑↓ cambia de zona, ←→ cambia de columna (Band/PVC),
                     Tab recorre todo en orden, Esc cierra y confirma (ver
                     PisosPopupInput_PreviewKeyDown en el code-behind). Mientras el circuito tenga
                     zonas activas, el texto queda de solo lectura mostrando el resumen (Ubicacion
                     en modo TienePisos, ver CircuitoScRowVm). -->
                                <DataGridTemplateColumn Header="UBICACION" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="UbicCellRoot">
                                                <Border x:Name="UbicHost" Background="Transparent" CornerRadius="5" Margin="1">
                                                    <TextBox Text="{Binding Ubicacion, UpdateSourceTrigger=LostFocus}"
                                   IsReadOnly="{Binding TienePisos}"
                                   BorderThickness="0" Background="Transparent"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}"
                                   TextAlignment="Left" VerticalContentAlignment="Center"
                                   Padding="6,0,18,0" />
                                                </Border>
                                                <Button x:Name="PisosBtn" Padding="0"
                                Width="16" Height="16"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource Brush.Muted}"
                                ToolTip="Varios pisos (zonas del proyecto)"
                                Click="PisosBtn_Click" Opacity="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid>
                                                                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                                                                            <TextBlock Text="🏢" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <Ellipse x:Name="Dot" Width="5" Height="5" Fill="{DynamicResource Brush.Amber}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                                               Visibility="Collapsed" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding TienePisos}" Value="True">
                                                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Popup x:Name="PisosPopup" PlacementTarget="{Binding ElementName=PisosBtn}"
                               Placement="Bottom" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True"
                               PopupAnimation="None"
                               IsOpen="{Binding PisosPopupOpen, Mode=TwoWay}"
                               Opened="PisosPopup_Opened" Closed="PisosPopup_Closed">
                                                    <Border Width="288" Background="{DynamicResource Brush.Surface}"
                                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                  CornerRadius="10" Padding="0"
                                  LostKeyboardFocus="PisosFlyout_LostKeyboardFocus">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#1A2338" Opacity="0.16" BlurRadius="20" ShadowDepth="6" Direction="270" />
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <!-- Header: icono + circuito + hint de atajos -->
                                                            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="10,10,0,0"
                                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="12,10,12,9">
                                                                <StackPanel>
                                                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                                        <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="5"
                                            Background="{DynamicResource Brush.BlueSoft}" Margin="0,0,7,0">
                                                                            <TextBlock Text="🏢" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock DockPanel.Dock="Left" Text="Varios pisos" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                                               VerticalAlignment="Center" />
                                                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{DynamicResource Brush.Muted}">
                                      <Run Text="circuito " /><Run Text="{Binding Numero, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </DockPanel>
                                                                    <TextBlock FontSize="9.5" Foreground="{DynamicResource Brush.Muted}"
                                             TextWrapping="Wrap" Margin="27,0,0,0" LineHeight="14">
                                    <Run Text="↑ ↓" FontWeight="Bold" /><Run Text=" cambia de zona · " />
                                    <Run Text="← →" FontWeight="Bold" /><Run Text=" cambia de columna · " />
                                    <Run Text="Tab" FontWeight="Bold" /><Run Text=" recorre todo" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Encabezado de columnas -->
                                                            <Grid Margin="16,8,16,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="62" />
                                                                    <ColumnDefinition Width="62" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="ZONA" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}" />
                                                                <TextBlock Grid.Column="1" Text="L. BAND" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
                                                                <TextBlock Grid.Column="2" Text="L. PVC" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="6,0,0,0" />
                                                            </Grid>

                                                            <!-- Lista de zonas -->
                                                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="8,2,8,8">
                                                                <ItemsControl ItemsSource="{Binding ZonaPisos}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border CornerRadius="7" Padding="4,3" Margin="0,1">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="Transparent" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                                                <Setter Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="62" />
                                                                                        <ColumnDefinition Width="62" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <DockPanel Grid.Column="0" LastChildFill="True">
                                                                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="2,0,7,0" VerticalAlignment="Center">
                                                                                            <Ellipse.Style>
                                                                                                <Style TargetType="Ellipse">
                                                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Line}" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Blue}" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Ellipse.Style>
                                                                                        </Ellipse>
                                                                                        <TextBlock Text="{Binding Nombre}" FontSize="11.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </DockPanel>

                                                                                    <TextBox x:Name="BandBox" Grid.Column="1" Margin="4,1,0,1"
                                                   Text="{Binding BandText, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="11.5" Padding="6,5" TextAlignment="Right" BorderThickness="1"
                                                   Background="{DynamicResource Brush.Surface2}"
                                                   BorderBrush="{DynamicResource Brush.Line}"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   PreviewKeyDown="PisosPopupInput_PreviewKeyDown"
                                                   GotFocus="PisosPopupInput_GotFocus" Tag="0" />
                                                                                    <TextBox x:Name="PvcBox" Grid.Column="2" Margin="4,1,0,1"
                                                   Text="{Binding PvcText, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="11.5" Padding="6,5" TextAlignment="Right" BorderThickness="1"
                                                   Background="{DynamicResource Brush.Surface2}"
                                                   BorderBrush="{DynamicResource Brush.Line}"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   PreviewKeyDown="PisosPopupInput_PreviewKeyDown"
                                                   GotFocus="PisosPopupInput_GotFocus" Tag="1" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>

                                                            <!-- Footer -->
                                                            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="0,0,10,10"
                                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                                                                <DockPanel LastChildFill="False">
                                                                    <TextBlock DockPanel.Dock="Left" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}">
                                    <Run Text="Total " /><Run Text="{Binding ZonaPisosTotal, Mode=OneWay}" FontWeight="Bold"
                                                              Foreground="{DynamicResource Brush.Blue}" /><Run Text=" m" />
                                                                    </TextBlock>
                                                                    <TextBlock DockPanel.Dock="Right" FontSize="9.5" Foreground="{DynamicResource Brush.Muted}">
                                    <Run Text="Esc" FontWeight="Bold" /><Run Text=" cierra" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="UbicCellRoot" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PisosBtn" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding TienePisos}" Value="True">
                                                    <Setter TargetName="PisosBtn" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- L. Band (M) — color rosa -->
                                <DataGridTextColumn Header="REC. B"
                                    Binding="{Binding LargoBandeja, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                    Width="55" CanUserResize="False"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#EC4899" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- L. PVC (M) — color verde -->
                                <DataGridTextColumn Header="REC. D"
                                    Binding="{Binding LargoTuberia, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                    Width="55" CanUserResize="False"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#10B981" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Conductor Bandeja: lista desplegable con filtro (catálogo TiposConductor) —
                     escribir filtra las opciones que contienen lo tecleado, elegir de la lista
                     o seguir escribiendo un valor libre. Mismo commit manual en LostFocus que
                     Sist./Alim./Ducto Ø (ver comentario ahí: un binding TwoWay no confirma de
                     forma confiable en un DataGridTemplateColumn). -->
                                <DataGridTemplateColumn Header="COND&#x0a;BAND." Width="75"
                                        ClipboardContentBinding="{Binding ConductorDistribucion}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ConductorDistribucion}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="ConductorDistribucion"
                                ItemsSource="{Binding DataContext.TiposConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding ConductorDistribucion, Mode=OneWay}"
                                FontSize="11"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="ConductorBandEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Sección Bandeja: catálogo SeccionesConductor -->
                                <DataGridTemplateColumn Header="SEC POR&#x0a;BAND." Width="70"
                                        ClipboardContentBinding="{Binding SeccionDistribucion}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeccionDistribucion}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="SeccionDistribucion"
                                ItemsSource="{Binding DataContext.SeccionesConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding SeccionDistribucion, Mode=OneWay}"
                                FontSize="11"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="SeccionBandEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Band (M) — calculado rosa -->
                                <DataGridTextColumn Header="TOTAL&#x0a;BAND."
                                    Binding="{Binding LargoDistribucion, StringFormat=N0}"
                                    Width="55" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#EC4899" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tipo tubería / canalización: catálogo TiposTuberia (PVC, EMT, CAÑERIA, PVCLH…).
                     Antes el tipo existía en el modelo pero no se podía elegir desde la grilla —
                     quedaba fijo en el valor por defecto. Ahora es editable con la misma lista
                     filtrada y commit manual en LostFocus que el resto del tramo. -->
                                <DataGridTemplateColumn Header="TIPO&#x0a;DUCTO" Width="55"
                                        ClipboardContentBinding="{Binding TipoTuberia}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TipoTuberia}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="TipoTuberia"
                                ItemsSource="{Binding DataContext.TiposTuberia, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding TipoTuberia, Mode=OneWay}"
                                FontSize="11"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="TipoTuberiaEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Ducto Ø: lista desplegable con filtro (catálogo DiametrosTuberia). Escribir
                     "32" filtra a "32mm" en la lista; Tab/Enter normaliza igual que antes
                     (CircuitoScRowVm.SeccionTuberia agrega "mm" si falta). -->
                                <DataGridTemplateColumn Header="DUCTO Ø" Width="45"
                                        ClipboardContentBinding="{Binding SeccionTuberia}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeccionTuberia}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="SeccionTuberia"
                                ItemsSource="{Binding DataContext.DiametrosTuberia, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding SeccionTuberia, Mode=OneWay}"
                                FontSize="11"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="SeccionTuberiaEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Conductor PVC: catálogo TiposConductor -->
                                <DataGridTemplateColumn Header="COND&#x0a;DUCTO" Width="75"
                                        ClipboardContentBinding="{Binding ConductorDerivacion}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ConductorDerivacion}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="ConductorDerivacion"
                                ItemsSource="{Binding DataContext.TiposConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding ConductorDerivacion, Mode=OneWay}"
                                FontSize="11"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="ConductorPvcEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Sección PVC: catálogo SeccionesConductor -->
                                <DataGridTemplateColumn Header="SEC&#x0a;DUCTO" Width="70"
                                        ClipboardContentBinding="{Binding SeccionDerivacion}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SeccionDerivacion}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource DataGrid.CellEditCombo}"
                                Tag="SeccionDerivacion"
                                ItemsSource="{Binding DataContext.SeccionesConductor, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Text="{Binding SeccionDerivacion, Mode=OneWay}"
                                FontSize="11"
                                Loaded="FilterableCombo_Loaded"
                                TextBoxBase.TextChanged="FilterableCombo_TextChanged"
                                LostFocus="SeccionPvcEditor_LostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total PVC (M) — calculado verde -->
                                <DataGridTextColumn Header="TOTAL M&#x0a;DUCTO"
                                    Binding="{Binding LargoDerivacion, StringFormat=N0}"
                                    Width="55" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#10B981" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Montaje -->
                                <DataGridTextColumn Header="MONT&#x0a;LUM"
                                    Binding="{Binding MontajesAlumbrado, UpdateSourceTrigger=LostFocus}"
                                    Width="52"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Caja 5/8" -->
                                <DataGridTextColumn Header='CAJA&#x0a;5/8"'
                                    Binding="{Binding Cajas58, UpdateSourceTrigger=LostFocus}"
                                    Width="52"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Caja 100x100 -->
                                <DataGridTextColumn Header="CAJA&#x0a;A11"
                                    Binding="{Binding Cajas100x100, UpdateSourceTrigger=LostFocus}"
                                    Width="52"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Caja 100x65 -->
                                <DataGridTextColumn Header="CAJA&#x0a;A01"
                                    Binding="{Binding Cajas100x65, UpdateSourceTrigger=LostFocus}"
                                    Width="52"
                                    EditingElementStyle="{StaticResource DataGrid.CellEditTextBox}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- TMF Cant. — dorado, solo lectura, calculado automáticamente -->
                                <DataGridTextColumn Header="TMF&#x0a;CANT."
                                    Binding="{Binding TmfCantidad}"
                                    Width="50" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- TMF Medida — dorado, solo lectura, calculado automáticamente -->
                                <DataGridTextColumn Header="TMF&#x0a;MEDIDA"
                                    Binding="{Binding TmfMedida}"
                                    Width="55" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- ARTEFACTOS × ZONA: botón que abre el diálogo de agregado rápido por zona.
                     El texto (ArtefactosResumen) muestra unidades totales y en cuántas zonas
                     del proyecto están, para el control de costo por piso. -->
                                <DataGridTemplateColumn Header="ARTEFACTOS&#x0a;× ZONA" Width="165" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.Secondary}"
                              Margin="4,2" Padding="6,3" FontSize="11"
                              HorizontalAlignment="Stretch"
                              Content="{Binding ArtefactosResumen}"
                              Command="{Binding DataContext.OpenArtefactosCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                    </DockPanel>
                </Border>

            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

