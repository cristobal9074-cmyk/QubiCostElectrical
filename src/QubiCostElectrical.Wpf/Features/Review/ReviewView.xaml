<UserControl x:Class="QubiCostElectrical.Wpf.Features.Review.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Review"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls">
  <UserControl.Resources>
    <local:ConfidenceToStrokeDashArrayConverter x:Key="ConfidenceConverter" />
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Canvas}">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ejecutar la revisión final, detectar bloqueos y validar la oferta antes de exportar.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando revisión…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <Grid MinWidth="1020">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="260" MaxWidth="360" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="2*" MinWidth="460" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="1.1*" MinWidth="280" MaxWidth="400" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Cierre de calidad" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4" />
              <TextBlock Text="Detecta bloqueos, faltantes e inconsistencias antes de exportar la oferta."
                         Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card.Section}" Padding="10" Margin="0,12,0,10">
          <StackPanel>
            <TextBox Style="{StaticResource Form.SearchBox}" Tag="Buscar por categoría, ítem o descripción…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Margin="0,8,0,0"
                      Style="{StaticResource Form.ComboBox}"
                      ItemsSource="{Binding SeverityOptions}"
                      SelectedItem="{Binding SelectedSeverity}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card.Section}" Padding="12">
          <StackPanel>
            <TextBlock Text="Alertas priorizadas" Style="{StaticResource Text.SectionLabel}" />
            <ItemsControl ItemsSource="{Binding Checklist}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="{StaticResource Radius.Sm}" Padding="0" Margin="0,0,0,6">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Fail">
                            <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Text="{Binding Icon}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontSize="13" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDark}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Status}" Value="Warning">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="Fail">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" FontSize="11" Margin="0,7,0,7">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Status}" Value="Fail">
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                  Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibility}}">
                        <Border Margin="0,0,6,0" Padding="6,2" CornerRadius="4">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource Brush.SuccessDark}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                  <Setter Property="Background" Value="{DynamicResource Brush.Amber}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Fail">
                                  <Setter Property="Background" Value="{DynamicResource Brush.DangerDark}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding IssueCount}" Foreground="{DynamicResource Brush.White}"
                                     FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Border>
                        <Button Content="Revisar"
                                Command="{Binding NavigateCommand}"
                                Style="{StaticResource Button.Ghost}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Mostrar todo" Command="{Binding ResetFilterCommand}"
                    Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource Button.Link}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Text.ViewTitle}" />
              <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource Button.Secondary}" Content="Ir a corregir" Command="{Binding GoToIssueCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Actualizar" Command="{Binding RefreshCommand}" />
            </StackPanel>
          </DockPanel>

          <!-- Cola de corrección -->
          <Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber2}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="12" Margin="0,12,0,0"
                  Visibility="{Binding IsWarRoomMode, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding WarRoomProgressText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.Amber}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Ir" Command="{Binding GoToIssueCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Anterior" Command="{Binding PreviousWarRoomIssueCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Siguiente" Command="{Binding NextWarRoomIssueCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Button.Primary}" Content="Marcar resuelto" Command="{Binding MarkResolvedLocalCommand}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Cola de corrección" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding FocusIssueSummary}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Barra de completitud del presupuesto -->
          <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Sm}" Padding="12,10" Margin="0,12,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="Completitud del presupuesto" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ReadinessOk}" Value="False">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <Run Text="{Binding ConfidencePct, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text="%" />
                </TextBlock>
              </DockPanel>
              <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100"
                           Value="{Binding ConfidencePct, Mode=OneWay}"
                           BorderThickness="0">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar">
                    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
                    <Setter Property="Foreground">
                      <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="{DynamicResource Color.Blue}" Offset="0" />
                          <GradientStop Color="{DynamicResource Color.Success}" Offset="1" />
                        </LinearGradientBrush>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
            </Grid>
          </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Width="110" Height="78" Padding="6" Margin="0,0,10,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Confianza" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                <Grid Grid.Row="1" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse Stroke="{DynamicResource Brush.Line2}" StrokeThickness="5" />
                  <Ellipse Stroke="{DynamicResource Brush.Blue}" StrokeThickness="5"
                           StrokeDashArray="{Binding ConfidencePct, Converter={StaticResource ConfidenceConverter}}"
                           StrokeDashCap="Round"
                           RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <TextBlock Text="{Binding ConfidencePct, StringFormat={}{0:N0}%}"
                             FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Bloqueantes" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding Blockers.Count}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Críticos" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding Criticals.Count}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Advertencias operativas" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding Warnings.Count}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Listo para exportar" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ExportStateText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="5" Text="La lista prioriza problemas que afectan precio, trazabilidad y entrega al cliente."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card.Section}" Padding="0">
          <DataGrid ItemsSource="{Binding FilteredIssues}"
                    SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource DataGrid.Workspace}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Severidad" Binding="{Binding SeverityText}" Width="96">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryText}" Width="160">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding CategoryText}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Ítem" Binding="{Binding ItemId}" Width="88">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding ItemId}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Partida" Binding="{Binding Item}" Width="*" MinWidth="220">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Item}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Codigo}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Problema" Binding="{Binding Problem}" Width="220">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Problem}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Recomendación" Binding="{Binding Recommendation}" Width="260">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Recommendation}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- CTA final del flujo de revisión -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Style="{StaticResource Button.Secondary}" Content="Volver al presupuesto" Command="{Binding GoToBudgetCommand}" Margin="0,0,10,0" />
          <Button Style="{StaticResource Button.Primary}" Content="Generar oferta y exportar →" Command="{Binding GoToExportCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="4" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14">
      <StackPanel>
        <StackPanel.Resources>
          <DataTemplate x:Key="SummaryIssueItemTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4" />
          </DataTemplate>
        </StackPanel.Resources>

        <TextBlock Text="Resumen ejecutivo" Style="{StaticResource Text.SectionLabel}" />
        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,6,0,12" />

        <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Bloqueantes" Style="{StaticResource Text.Caption}" />
            <ItemsControl ItemsSource="{Binding Blockers}" ItemTemplate="{StaticResource SummaryIssueItemTemplate}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Section}" CornerRadius="{StaticResource Radius.Sm}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Críticos" Style="{StaticResource Text.Caption}" />
            <ItemsControl ItemsSource="{Binding Criticals}" ItemTemplate="{StaticResource SummaryIssueItemTemplate}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Section}" CornerRadius="{StaticResource Radius.Sm}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Advertencias" Style="{StaticResource Text.Caption}" />
            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource SummaryIssueItemTemplate}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Section}" CornerRadius="{StaticResource Radius.Sm}">
          <StackPanel>
            <TextBlock Text="Info" Style="{StaticResource Text.Caption}" />
            <ItemsControl ItemsSource="{Binding Infos}" ItemTemplate="{StaticResource SummaryIssueItemTemplate}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>

