<UserControl x:Class="QubiCostElectrical.Wpf.Features.Review.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Review"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             KeyDown="OnUserControlKeyDown">
  <UserControl.Resources>
    <local:ConfidenceToStrokeDashArrayConverter x:Key="ConfidenceConverter" />
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </UserControl.InputBindings>
  <Grid Background="{DynamicResource Brush.Canvas}">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M9 12l2 2 4-4 M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ejecutar la revisión final, detectar bloqueos y validar la oferta antes de exportar.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando revisión…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}"
                Padding="16"
                Margin="0,0,0,12">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Text.ViewTitle}" />
              <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Bloqueantes" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding BlockerCount, StringFormat={}{0:N0} pendientes}" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasBlockers}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Confianza" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding ConfidenceLabel}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card.StatPill}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Visibles" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding VisibleIssuesLabel}" FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card.StatPill}">
                <StackPanel>
                  <TextBlock Text="Estado" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding ExportStateText}" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasBlockers}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="250" MaxWidth="340" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="320" MinWidth="280" MaxWidth="380" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Lg}"
                  Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="Filtros" Style="{StaticResource Text.SectionLabel}" />
                <Grid Margin="0,10,0,8">
                  <TextBox x:Name="SearchBox"
                           Style="{StaticResource Form.SearchBox}"
                           Tag="Buscar categoría, ítem o problema… (Ctrl+F)"
                           Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                           Padding="26,4,24,4" />
                  <TextBlock Text="🔍"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.Muted}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Margin="8,0,0,0"
                             IsHitTestVisible="False" />
                  <Button Style="{StaticResource Button.Ghost}"
                          Content="✕"
                          Padding="0"
                          Width="18" Height="18"
                          FontSize="10"
                          FontWeight="Bold"
                          Foreground="{DynamicResource Brush.Muted}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          Command="{Binding ClearSearchCommand}"
                          Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Limpiar búsqueda (Esc)" />
                </Grid>
                <ComboBox Style="{StaticResource Form.ComboBox}"
                          ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SelectedSeverity}"
                          ToolTip="Filtrar por nivel de severidad" />
                <Button Margin="0,10,0,0"
                        Content="Quitar filtros (Esc)"
                        Command="{Binding ResetFilterCommand}"
                        Style="{StaticResource Button.Link}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
                <Border Margin="0,12,0,0"
                        Background="{DynamicResource Brush.Surface2}"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Padding="10">
                  <StackPanel>
                    <TextBlock Text="Filtro activo" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding FilterLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!-- Checklist de Control de Calidad -->
                <Separator Margin="0,14,0,10" Background="{DynamicResource Brush.Line}" />
                <TextBlock Text="Control de calidad" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Checklist}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6"
                              Padding="8,6"
                              Background="{DynamicResource Brush.Surface2}"
                              BorderBrush="{DynamicResource Brush.Line}"
                              BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Sm}">
                        <DockPanel LastChildFill="True">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontWeight="Bold" FontSize="11" Margin="0,0,8,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDark}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ChecklistStatus.Fail}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Static local:ChecklistStatus.Warning}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <Button DockPanel.Dock="Right"
                                  Style="{StaticResource Button.Link}"
                                  Content="Filtrar"
                                  FontSize="10"
                                  Command="{Binding NavigateCommand}"
                                  Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibility}}"
                                  VerticalAlignment="Center"
                                  Margin="6,0,0,0" />
                          <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Caption}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.Column="2"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Lg}"
                  Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left">
                  <TextBlock Text="Problemas priorizados" Style="{StaticResource Text.SectionLabel}" />
                  <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource Button.Secondary}"
                          Content="Corregir clasificación de equipos"
                          Command="{Binding FixEquipmentClassificationCommand}"
                          Margin="0,0,8,0"
                          ToolTip="Marca como EQUIPO las líneas de familia Tableros/Equipos que siguen como material." />
                  <Button Style="{StaticResource Button.Secondary}"
                          Content="Actualizar (F5)"
                          Command="{Binding RefreshCommand}"
                          Margin="0,0,8,0"
                          ToolTip="Reanalizar y auditar presupuesto completo (F5)" />
                  <Button Style="{StaticResource Button.Secondary}"
                          Content="Ir a corregir (Enter)"
                          Command="{Binding GoToIssueCommand}"
                          ToolTip="Navegar a la partida o sección a corregir (Doble clic o Enter)" />
                </StackPanel>
              </DockPanel>

              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding FilteredIssues}"
                        SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource DataGrid.Workspace}">
                <DataGrid.InputBindings>
                  <MouseBinding Gesture="LeftDoubleClick" Command="{Binding GoToIssueCommand}" />
                  <KeyBinding Key="Return" Command="{Binding GoToIssueCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Severidad" Width="108" MinWidth="108" SortMemberPath="Severity" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border CornerRadius="{StaticResource Radius.Chip}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                              <Setter Property="BorderThickness" Value="1" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocker}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsBlocker}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryText, Mode=OneWay}" Width="130" MinWidth="110" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding CategoryText}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Ítem" Binding="{Binding ItemId, Mode=OneWay}" Width="72" MinWidth="64" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding ItemId}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Partida" Binding="{Binding Item, Mode=OneWay}" Width="*" MinWidth="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Item}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Código" Binding="{Binding Codigo, Mode=OneWay}" Width="88" MinWidth="72" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Codigo}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Problema" Binding="{Binding Problem, Mode=OneWay}" Width="1.6*" MinWidth="180" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Problem}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Recomendación" Binding="{Binding Recommendation, Mode=OneWay}" Width="1.6*" MinWidth="180" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Recommendation}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>

              <Border Grid.Row="1"
                      Background="{DynamicResource Brush.Surface}"
                      Visibility="{Binding HasZeroIssues, Converter={StaticResource BoolToVisibility}}"
                      Padding="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource Brush.SuccessDark}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                  <TextBlock Text="Presupuesto verificado con éxito" Style="{StaticResource Text.SectionLabel}" HorizontalAlignment="Center" />
                  <TextBlock Text="No se detectaron inconsistencias técnicas ni comerciales. El presupuesto cumple todas las reglas de auditoría y está listo para exportar."
                             Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" Margin="0,6,0,16" />
                  <Button Style="{StaticResource Button.Primary}" Content="Generar oferta y exportar →" Command="{Binding GoToExportCommand}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="4"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Lg}"
                  Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="Siguiente paso" Style="{StaticResource Text.SectionLabel}" />
              <TextBlock Text="{Binding ReadinessMessage}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,6,0,12" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource Button.Primary}" Content="Ir a exportar" Command="{Binding GoToExportCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Presupuesto" Command="{Binding GoToBudgetCommand}" />
              </StackPanel>

              <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="Bloqueantes" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding Blockers.Count, StringFormat={}{0:N0} pendientes}" FontWeight="SemiBold" Margin="0,4,0,6" />
                  <ItemsControl ItemsSource="{Binding Blockers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card.Section}" CornerRadius="{StaticResource Radius.Sm}" Padding="12">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Nivel de confianza" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                  <Grid Width="110" Height="110" HorizontalAlignment="Center" Margin="0,10">
                    <Ellipse Width="100" Height="100" Stroke="{DynamicResource Brush.Surface2}" StrokeThickness="8" />
                    <Ellipse Width="100" Height="100" Stroke="{DynamicResource Brush.Blue}" StrokeThickness="8"
                             StrokeDashArray="{Binding ConfidencePct, Converter={StaticResource ConfidenceConverter}}"
                             RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding ConfidencePct, StringFormat={}{0:N0}%}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding ConfidenceLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding ExportStateText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Style="{StaticResource Button.Secondary}" Content="Volver al presupuesto" Command="{Binding GoToBudgetCommand}" Margin="0,0,10,0" />
          <Button Style="{StaticResource Button.Primary}" Content="Generar oferta y exportar →" Command="{Binding GoToExportCommand}" />
        </StackPanel>
    </Grid>
  </Grid>
</UserControl>


