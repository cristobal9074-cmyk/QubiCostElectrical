<UserControl x:Class="QubiCostElectrical.Wpf.Features.Contracts.ContractVersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="{DynamicResource Brush.Canvas}">

  <ctrl:WorkspacePageChrome ShowEmptyState="{Binding ShowEmptyState}"
                            IsLoading="{Binding IsLoading}"
                            EmptyTitle="Sin proyecto abierto"
                            EmptyDescription="Abra un proyecto para consultar el historial de versiones del contrato."
                            LoadingMessage="Cargando versiones…">
    <ctrl:WorkspacePageChrome.Body>
      <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <TextBlock Text="Versiones del contrato" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
          <TextBlock Text="Historial de versiones y verificación de integridad."
                     Style="{StaticResource Text.Body}" Margin="0,0,0,12" />

          <StackPanel Orientation="Horizontal">
            <Button Content="Volver" Command="{Binding BackCommand}"
                    Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
            <Button Content="Verificar integridad" Command="{Binding VerifyIntegrityCommand}"
                    Style="{StaticResource Button.Primary}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="{Binding IntegrityMessage}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Helper}"
                     Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Style="{StaticResource Card.Section}" Padding="0">
          <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}"
                    AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    Style="{StaticResource DataGrid.Workspace}"
                    infra:DataGridExcelNavigation.Enable="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                    BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Versión" Binding="{Binding VersionNumber}" Width="80" />
              <DataGridTextColumn Header="Creado" Binding="{Binding CreatedUtc, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" Width="150" />
              <DataGridTextColumn Header="Por" Binding="{Binding CreatedBy}" Width="150" />
              <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

      </DockPanel>
    </ctrl:WorkspacePageChrome.Body>
  </ctrl:WorkspacePageChrome>
</UserControl>
