<UserControl x:Class="QubiCostElectrical.Wpf.Features.Contracts.ContractWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="{DynamicResource Brush.Canvas}">

  <ctrl:WorkspacePageChrome ShowEmptyState="{Binding ShowEmptyState}"
                            IsLoading="{Binding IsLoading}"
                            EmptyTitle="Sin proyecto abierto"
                            EmptyDescription="Abra un proyecto para gestionar el ciclo de vida de contratos."
                            LoadingMessage="Cargando contratos…">
    <ctrl:WorkspacePageChrome.Body>
      <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <TextBlock Text="Contratos" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4" />
          <TextBlock Text="Ciclo de vida de contratos: creación, aprobación, versiones y auditoría."
                     Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Form.TextBox}" Width="320" HorizontalAlignment="Left"
                     Tag="Buscar contrato..." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Actualizar" Command="{Binding RefreshCommand}"
                      Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
              <Button Content="+ Nuevo contrato" Command="{Binding CreateCommand}"
                      Style="{StaticResource Button.Primary}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Helper}" />
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Helper}"
                     Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Style="{StaticResource Card.Section}" Padding="0">
          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                    AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    Style="{StaticResource DataGrid.Workspace}"
                    infra:DataGridExcelNavigation.Enable="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                    BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id.Value}" Width="140" />
              <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
              <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110" />
              <DataGridTemplateColumn Header="" Width="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Editar" Margin="0,0,6,0" Style="{StaticResource Button.Ghost}" Padding="8,4"
                              Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <Button Content="Versiones" Style="{StaticResource Button.Ghost}" Padding="8,4"
                              Command="{Binding DataContext.VersionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

      </DockPanel>
    </ctrl:WorkspacePageChrome.Body>
  </ctrl:WorkspacePageChrome>
</UserControl>
