<UserControl x:Class="QubiCostElectrical.Wpf.Features.MaterialControl.MaterialControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.MaterialControl"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             Background="{DynamicResource Brush.Canvas}">
  <UserControl.Resources>
    <local:PercentToProgressBrushConverter x:Key="PercentToProgressBrushConverter" />
    <local:StatusToBadgeBgConverter x:Key="StatusToBadgeBgConverter" />
    <local:StatusToBadgeBorderConverter x:Key="StatusToBadgeBorderConverter" />
    <local:StatusToBadgeFgConverter x:Key="StatusToBadgeFgConverter" />
    <local:CategoryToIconConverter x:Key="CategoryToIconConverter" />
  </UserControl.Resources>

  <Grid Margin="16,14">
    <!-- Estado Vacío -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96 12 12.01l8.73-5.05 M12 22.08V12"
                            Title="Sin materiales para control"
                            Description="Abra un proyecto con recursos cubicados o cree solicitudes de materiales en faena para iniciar el seguimiento.">
      <ctrl:EmptyStateControl.Actions>
        <WrapPanel HorizontalAlignment="Center">
          <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" Margin="4"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
          <Button Style="{StaticResource Button.Primary}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="4" MinWidth="140"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <!-- Contenido Principal con Proyecto Abierto -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="600" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="360" MinWidth="320" MaxWidth="440" />
      </Grid.ColumnDefinitions>

      <!-- Panel Izquierdo: Resumen Ejecutivo, Filtros de Pisos y Grilla Principal -->
      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}"
              Padding="18,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Fila 0: Encabezado Ejecutivo y Botones de Acción -->
          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Tolerancia Pill -->
              <Border Background="{DynamicResource Brush.Surface2}"
                      BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10,5"
                      Margin="0,0,8,0"
                      ToolTip="Margen de tolerancia técnica de cubicación para evitar falsos sobrepedidos.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="⚙️ Tol: " FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="{Binding ToleranciaPct, StringFormat={}{0:N0}%}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                </StackPanel>
              </Border>

              <Button Style="{StaticResource Button.Secondary}"
                      Content="↻ Actualizar"
                      Command="{Binding RefreshCommand}"
                      Margin="0,0,8,0"
                      Height="34" />
              <Button Style="{StaticResource Button.Primary}"
                      Content="📊 Exportar Reporte (.xlsx)"
                      Command="{Binding ExportExcelCommand}"
                      Height="34"
                      FontWeight="Bold" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Control de Materiales" Style="{StaticResource Text.ViewTitle}" />
                <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Cubicación vs Terreno" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Descuento automático de pedidos en faena para controlar el stock presupuestado, evitar sobre-pedidos y auditar por pisos."
                         Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>

          <!-- Fila 1: 4 Tarjetas KPI Corporativas -->
          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Total Cubicado -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="📐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="TOTAL CUBICADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="{Binding TotalCubicado, StringFormat={}{0:N1}}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
                  <TextBlock Text="Presupuesto + tol." FontSize="9.5" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- KPI 2: Solicitado en Faena -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.BlueSoft}"
                    BorderBrush="{DynamicResource Brush.Line2}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="SOLICITADO EN FAENA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                  <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding TotalSolicitado, StringFormat={}{0:N1}}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                    <TextBlock Text="{Binding PorcentajeGlobal, StringFormat={} ({0:N1}%)}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Bottom" Margin="4,0,0,1" />
                  </StackPanel>
                  <TextBlock Text="Acumulado pedidos" FontSize="9.5" Foreground="{DynamicResource Brush.Blue}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- KPI 3: Saldo por Pedir -->
            <Border Grid.Column="4"
                    Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="SALDO POR PEDIR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="{Binding TotalPendiente, StringFormat={}{0:N1}}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
                  <TextBlock Text="Saldo para terminar" FontSize="9.5" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- KPI 4: Alertas de Sobreconsumo -->
            <Border Grid.Column="6"
                    CornerRadius="10"
                    Padding="14,10"
                    BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#ECFDF5" />
                  <Setter Property="BorderBrush" Value="#A7F3D0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#D1FAE5" />
                      <Setter Property="BorderBrush" Value="#6EE7B7" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Amber2}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="✓" />
                        <Setter Property="Foreground" Value="#059669" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                            <Setter Property="Text" Value="⚠️" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="SOBRECONSUMO EN FAENA" FontSize="10" FontWeight="Bold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#059669" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding CantidadSobrepedidos}" FontSize="17" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#059669" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text=" alertas activas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="4,0,0,1">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#059669" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Text="{Binding TotalExceso, StringFormat={}+ {0:N1} sobreconsumo}" FontSize="9.5">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#059669" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Fila 2: Barra de Filtros, Control de Pisos y Búsqueda -->
          <Border Grid.Row="2"
                  Background="{DynamicResource Brush.Surface2}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Buscador de Texto -->
              <Grid Grid.Column="0">
                <TextBox Style="{StaticResource Form.SearchBox}"
                         Tag="Buscar por código, descripción, categoría o piso…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="26,5,22,5"
                         FontSize="11.5" />
                <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                <Button Style="{StaticResource Button.Ghost}" Content="✕" Width="16" Height="16" FontSize="9" FontWeight="Bold"
                        Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}" />
              </Grid>

              <!-- Selector de Control de Pisos / Sectores -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏢" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                <ComboBox Style="{StaticResource Form.ComboBox}"
                          ItemsSource="{Binding PisosOptions}"
                          SelectedItem="{Binding SelectedPiso, Mode=TwoWay}"
                          ToolTip="Filtrar materiales por piso o área de instalación"
                          MinWidth="170"
                          Height="30"
                          FontSize="11.5" />
              </StackPanel>

              <!-- Botones de Filtro de Estado -->
              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="Todos"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="⚠️ Sobreconsumo"
                             IsChecked="{Binding IsFilterAlert, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="alert" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="⏳ Pendientes"
                             IsChecked="{Binding IsFilterPending, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="pending" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="✓ Completados"
                             IsChecked="{Binding IsFilterCompleted, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="completed" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Fila 3: DataGrid Didáctico de Control -->
          <DataGrid Grid.Row="3"
                    ItemsSource="{Binding FilteredRows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    Style="{StaticResource DataGrid.Workspace}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    RowHeight="36"
                    EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                  <!-- Alerta visual ámbar en filas donde Consumo > Cubicado (detección inmediata de sobreconsumo en faena) -->
                  <DataTrigger Binding="{Binding TieneSobreconsumo}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="ToolTip" Value="⚠️ Alerta de Sobreconsumo: El consumo en faena supera la cantidad cubicada." />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding TieneSobreconsumo}" Value="True" />
                      <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                      <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Amber2}" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding TieneSobreconsumo}" Value="True" />
                      <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Amber2}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <!-- Código con Indicador Ámbar en Sobreconsumo -->
              <DataGridTemplateColumn Header="Código" Width="140" MinWidth="110" SortMemberPath="Codigo" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,6,0"
                              Background="{DynamicResource Brush.AmberRisk}"
                              Visibility="{Binding TieneSobreconsumo, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="⚠️ Alerta de Sobreconsumo: Consumo > Cubicado" />
                      <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Codigo}" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Categoría con Icono -->
              <DataGridTemplateColumn Header="Categoría" Width="110" MinWidth="95" SortMemberPath="Categoria" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Categoria, Converter={StaticResource CategoryToIconConverter}}" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Categoria}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Descripción del Material -->
              <DataGridTextColumn Header="Descripción del Material" Binding="{Binding Descripcion}" Width="*" MinWidth="180">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Descripcion}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Pisos / Sectores -->
              <DataGridTemplateColumn Header="Pisos / Sectores" Width="120" MinWidth="100" SortMemberPath="PisosResumen" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="#F1F5F9" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding PisosResumen}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍 " FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PisosResumen}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Ud. -->
              <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="50" HeaderStyle="{StaticResource DataGridColumnHeader.Center}" ElementStyle="{StaticResource Text.Center}" />

              <!-- Cubicado -->
              <DataGridTextColumn Header="Cubicado" Binding="{Binding CantidadCubicada, StringFormat={}{0:N0}}" Width="80"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />

              <!-- Consumo en Faena (Solicitado) -->
              <DataGridTextColumn Header="Consumo" Binding="{Binding CantidadSolicitada, StringFormat={}{0:N0}}" Width="85"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="ToolTip" Value="Material consumido / solicitado en faena" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TieneSobreconsumo}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="ToolTip" Value="⚠️ Alerta: El consumo supera la cantidad cubicada (sobreconsumo en faena)" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Falta Pedir -->
              <DataGridTextColumn Header="Falta Pedir" Binding="{Binding CantidadPendiente, StringFormat={}{0:N0}}" Width="80"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />

              <!-- % Avance con Barra Visual Didáctica -->
              <DataGridTemplateColumn Header="Avance" Width="115" MinWidth="100" SortMemberPath="PorcentajeAvance" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Center" Margin="4,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                      </Grid.ColumnDefinitions>

                      <!-- Barra de Progreso de Fondo -->
                      <Border Grid.Column="0" Height="6" Background="#E2E8F0" CornerRadius="3" VerticalAlignment="Center">
                        <!-- Barra de Progreso Llena -->
                        <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{Binding PorcentajeAvance, Converter={StaticResource PercentToProgressBrushConverter}}"
                                Width="{Binding ProgressWidthPct}" />
                      </Border>

                      <!-- Texto de Porcentaje -->
                      <TextBlock Grid.Column="1" Text="{Binding PorcentajeAvance, StringFormat={}{0:N0}%}" FontSize="10.5" FontWeight="Bold"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding TieneSobreconsumo}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Estado / Alerta con Badge -->
              <DataGridTemplateColumn Header="Estado / Alerta" Width="170" MinWidth="150" SortMemberPath="EstadoControl" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{Binding EstadoControl, Converter={StaticResource StatusToBadgeBgConverter}}"
                            BorderBrush="{Binding EstadoControl, Converter={StaticResource StatusToBadgeBorderConverter}}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding EstadoControl}"
                                 FontSize="10.5"
                                 FontWeight="Bold"
                                 Foreground="{Binding EstadoControl, Converter={StaticResource StatusToBadgeFgConverter}}"
                                 TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Fila 4: Pie de tabla con información de conteo y filtros -->
          <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding SummaryCountText}" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
              <Button Content="Limpiar filtros" Command="{Binding ResetFiltersCommand}" Style="{StaticResource Button.Link}" Margin="12,0,0,0"
                      Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Right" Text="💡 Haga clic en cualquier material para ver a la derecha su desglose por pisos y solicitudes."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
      </Border>

      <!-- Panel Derecho: Ficha de Trazabilidad, Desglose por Pisos y Solicitudes -->
      <Border Grid.Column="2"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}"
              Padding="14,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Encabezado de la Ficha -->
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="FICHA DE TRAZABILIDAD" Style="{StaticResource Text.SectionLabel}" FontSize="11" />
              <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                      Background="{Binding SelectedBadgeStatus, Converter={StaticResource StatusToBadgeBgConverter}}"
                      BorderBrush="{Binding SelectedBadgeStatus, Converter={StaticResource StatusToBadgeBorderConverter}}"
                      BorderThickness="1">
                <TextBlock Text="{Binding SelectedBadgeStatus}" FontSize="9.5" FontWeight="Bold"
                           Foreground="{Binding SelectedBadgeStatus, Converter={StaticResource StatusToBadgeFgConverter}}" />
              </Border>
            </DockPanel>

            <!-- Código y Categoría -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
              <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                <TextBlock Text="{Binding SelectedCodigo}" FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
              </Border>
              <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2">
                <TextBlock Text="{Binding SelectedCategoria}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
              </Border>
            </StackPanel>

            <!-- Descripción -->
            <TextBlock Text="{Binding SelectedDescripcion}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
          </StackPanel>

          <!-- Resumen de Balance del Material Seleccionado -->
          <Border Grid.Row="1"
                  Background="{DynamicResource Brush.Surface2}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,10"
                  Margin="0,0,0,12"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="CUBICADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="{Binding SelectedCubicado, StringFormat={}{0:N1}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock Text="{Binding SelectedUnidad}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="SOLICITADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                  <TextBlock Text="{Binding SelectedSolicitado, StringFormat={}{0:N1}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Blue}" />
                  <TextBlock Text="{Binding SelectedUnidad}" FontSize="9" Foreground="{DynamicResource Brush.Blue}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding SelectedSaldoLabel}" FontSize="9.5" FontWeight="Bold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedTieneSobreconsumo}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding SelectedSaldo, StringFormat={}{0:N1}}" FontWeight="Bold" FontSize="13">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedTieneSobreconsumo}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding SelectedUnidad}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
              </Grid>

              <!-- Barra de Progreso Didáctica -->
              <Border Height="6" Background="#CBD5E1" CornerRadius="3">
                <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                        Background="{Binding SelectedBarWidthPct, Converter={StaticResource PercentToProgressBrushConverter}}"
                        Width="{Binding SelectedBarWidthPct}" />
              </Border>

              <DockPanel LastChildFill="True" Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Avance Obra:" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedPctText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Ink}" />
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Fila 2: Pestañas / Secciones de Pisos y Solicitudes -->
          <Grid Grid.Row="2">
            <!-- Estado sin selección -->
            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="8" Padding="14"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔍" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Seleccione un material" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                <TextBlock Text="Haga clic en una fila para ver el desglose por pisos y los pedidos de faena."
                           Style="{StaticResource Text.Caption}" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Secciones con Selección -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <!-- SECCIÓN A: Desglose por Pisos / Sectores -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                  <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="🏢" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Desglose por Piso / Sector" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCantidadPisos, StringFormat={}{0} áreas}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Lista de Pisos -->
                    <ItemsControl ItemsSource="{Binding SelectedDesglosePisos}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>

                              <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,3">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding PisoNombre}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                  <TextBlock Text="{Binding Cantidad, StringFormat={}{0:N1}}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                                  <TextBlock Text="{Binding Unidad, StringFormat={} {0}}" FontSize="9.5" Foreground="{DynamicResource Brush.Muted}" Margin="2,0,0,0" />
                                  <TextBlock Text="{Binding Porcentaje, StringFormat={} ({0:N0}%)}" FontSize="9.5" Foreground="{DynamicResource Brush.Muted}" Margin="4,0,0,0" />
                                </StackPanel>
                              </DockPanel>

                              <!-- Mini Barra de % de Piso -->
                              <Border Grid.Row="1" Height="3" Background="#E2E8F0" CornerRadius="1.5">
                                <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Background="#2563EB" Width="{Binding Porcentaje}" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Sin desglose específico de pisos registrado." FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                               Visibility="{Binding HasDesglosePisos, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <!-- SECCIÓN B: Solicitudes de Faena -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                  <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="📋" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Historial de Pedidos en Faena" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSolicitudesCountText}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding SelectedSolicitudes}"
                              Style="{StaticResource DataGrid.Workspace}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MaxHeight="180">
                      <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ProvocoExceso}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
                              <Setter Property="BorderThickness" Value="0,0,0,1" />
                              <Setter Property="ToolTip" Value="⚠️ Esta solicitud superó la cubicación presupuestada (sobreconsumo en faena)." />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Doc." Binding="{Binding SolicitudCodigo}" Width="52" FontWeight="Bold" />
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="60" />
                        <DataGridTextColumn Header="Solicitado Por" Binding="{Binding SolicitadoPor}" Width="*" MinWidth="65">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                              <Setter Property="ToolTip" Value="{Binding SolicitadoPor}" />
                              <Setter Property="FontSize" Value="10.5" />
                              <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat={}{0:N1}}" Width="52"
                                            HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}">
                          <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
                              <Setter Property="FontSize" Value="10.5" />
                              <Setter Property="VerticalAlignment" Value="Center" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ProvocoExceso}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                                  <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Fila 3: Botón de Navegación a Solicitudes -->
          <Button Grid.Row="3"
                  Style="{StaticResource Button.Primary}"
                  Content="Ir a Solicitudes faena →"
                  Command="{Binding GoToSolicitudesCommand}"
                  Margin="0,10,0,0"
                  Height="34"
                  FontSize="11.5"
                  FontWeight="Bold"
                  HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>
