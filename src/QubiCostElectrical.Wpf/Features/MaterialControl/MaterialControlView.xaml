<UserControl x:Class="QubiCostElectrical.Wpf.Features.MaterialControl.MaterialControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             Background="{DynamicResource Brush.Canvas}">
  <Grid HorizontalAlignment="Stretch">
    <!-- Estado Vacío -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin materiales para control"
                            Description="Abra un proyecto con recursos cubicados o cree solicitudes de materiales en faena para iniciar el seguimiento.">
      <ctrl:EmptyStateControl.Actions>
        <WrapPanel HorizontalAlignment="Center">
          <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" Margin="4"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
          <Button Style="{StaticResource Button.Primary}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="4" MinWidth="140"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <!-- Contenido Principal -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="550" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="270" MinWidth="250" MaxWidth="310" />
      </Grid.ColumnDefinitions>

      <!-- Panel Izquierdo: Resumen, Filtros y Grilla de Control -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Fila 0: Título y Acciones -->
          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Control de Materiales" Style="{StaticResource Text.ViewTitle}" />
                <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Cubicación vs Solicitudes de Faena" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                </Border>
              </StackPanel>
              <TextBlock Text="Descuento automático de lo pedido en faena para controlar el stock presupuestado y frenar sobre-pedidos."
                         Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource Button.Secondary}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Primary}" Content="Exportar Reporte (.xlsx)" Command="{Binding ExportExcelCommand}" />
            </StackPanel>
          </DockPanel>

          <!-- Fila 1: Tarjetas KPI -->
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Total Cubicado -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="TOTAL CUBICADO" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Text="{Binding TotalCubicado, StringFormat={}{0:N1}}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Presupuesto + tol." Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <!-- KPI 2: Solicitado en Faena -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="SOLICITADO EN FAENA" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <TextBlock Text="{Binding TotalSolicitado, StringFormat={}{0:N1}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                  <TextBlock Text="{Binding PorcentajeGlobal, StringFormat={} ({0:N1}%)}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>
                <TextBlock Text="Acumulado pedidos" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Blue}" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <!-- KPI 3: Saldo por Pedir -->
            <Border Grid.Column="4" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="FALTA POR PEDIR" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Text="{Binding TotalPendiente, StringFormat={}{0:N1}}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Saldo para terminar" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <!-- KPI 4: Alertas de Sobrepedido -->
            <Border Grid.Column="6" CornerRadius="{StaticResource Radius.Md}" Padding="10,8" BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#1AF59E0B" />
                  <Setter Property="BorderBrush" Value="#66F59E0B" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TieneAlertas}" Value="True">
                      <Setter Property="Background" Value="#26EF4444" />
                      <Setter Property="BorderBrush" Value="#80EF4444" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚠️ SOBRE-PEDIDOS" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="#EF4444" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <TextBlock Text="{Binding CantidadSobrepedidos}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" />
                  <TextBlock Text=" alertas activas" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>
                <TextBlock Text="{Binding TotalExceso, StringFormat={}+ {0:N1} unidades en exceso}" Style="{StaticResource Text.Caption}" Foreground="#EF4444" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Fila 2: Filtros rápidos y Búsqueda -->
          <Border Grid.Row="2" Style="{StaticResource Card.Section}" Padding="8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBox Grid.Column="0" Style="{StaticResource Form.SearchBox}" Tag="Buscar por código, descripción o categoría…"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

              <!-- Botones de filtro de estado -->
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="Todos"
                             IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="all" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="⚠️ Sobrepedidos"
                             IsChecked="{Binding IsFilterAlert, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="alert" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="Pendientes"
                             IsChecked="{Binding IsFilterPending, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="pending" Margin="0,0,4,0" />
                <RadioButton Style="{StaticResource FilterChip.Base}" Content="Completados"
                             IsChecked="{Binding IsFilterCompleted, Mode=OneWay}"
                             Command="{Binding SetFilterCommand}" CommandParameter="completed" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Fila 3: Tabla de Control -->
          <DataGrid Grid.Row="3"
                    ItemsSource="{Binding FilteredRows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    Style="{StaticResource DataGrid.Workspace}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TieneSobrepedido}" Value="True">
                    <Setter Property="Background" Value="#15EF4444" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="95" FontWeight="SemiBold" />
              <DataGridTextColumn Header="Descripción del Material" Binding="{Binding Descripcion}" Width="*" MinWidth="180" />
              <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="45" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
              <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="85" />
              <DataGridTextColumn Header="Cubicado" Binding="{Binding CantidadCubicada, StringFormat={}{0:N0}}" Width="80"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
              <DataGridTextColumn Header="Solicitado" Binding="{Binding CantidadSolicitada, StringFormat={}{0:N0}}" Width="80"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TieneSobrepedido}" Value="True">
                        <Setter Property="Foreground" Value="#EF4444" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Falta Pedir" Binding="{Binding CantidadPendiente, StringFormat={}{0:N0}}" Width="80"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
              <DataGridTextColumn Header="% Avance" Binding="{Binding PorcentajeAvance, StringFormat={}{0:N1}%}" Width="70"
                                  HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TieneSobrepedido}" Value="True">
                        <Setter Property="Foreground" Value="#EF4444" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Estado / Alerta" Binding="{Binding EstadoControl}" Width="125">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TieneSobrepedido}" Value="True">
                        <Setter Property="Foreground" Value="#EF4444" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding EstaCompleto}" Value="True">
                        <Setter Property="Foreground" Value="#10B981" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Fila 4: Pie de tabla -->
          <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="{Binding SummaryCountText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock DockPanel.Dock="Right" Text="Haga clic en un material para ver a la derecha en qué solicitudes se pidió."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
          </DockPanel>
        </Grid>
      </Border>

      <!-- Panel Derecho: Detalle del Material y Solicitudes en Faena -->
      <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}" Padding="12,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Encabezado de la Ficha -->
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="Trazabilidad" Style="{StaticResource Text.SectionLabel}" FontSize="12" />
              <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedEsSobrepedido}" Value="True">
                        <Setter Property="Background" Value="#33EF4444" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding SelectedBadgeStatus}" FontSize="10" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedEsSobrepedido}" Value="True">
                          <Setter Property="Foreground" Value="#EF4444" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding SelectedCodigo}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" />
            <TextBlock Text="{Binding SelectedDescripcion}" Style="{StaticResource Text.Body}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
          </StackPanel>

          <!-- Resumen de Balance del Material Seleccionado -->
          <Border Grid.Row="1" Background="{DynamicResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Md}" Padding="8,7" Margin="0,0,0,8"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Cubicado" Style="{StaticResource Text.Caption}" FontSize="10" />
                  <TextBlock Text="{Binding SelectedCubicado, StringFormat={}{0:N1}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock Text="{Binding SelectedUnidad}" Style="{StaticResource Text.Caption}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Solicitado" Style="{StaticResource Text.Caption}" FontSize="10" Foreground="{DynamicResource Brush.Blue}" />
                  <TextBlock Text="{Binding SelectedSolicitado, StringFormat={}{0:N1}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Blue}" />
                  <TextBlock Text="{Binding SelectedUnidad}" Style="{StaticResource Text.Caption}" FontSize="9" Foreground="{DynamicResource Brush.Blue}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding SelectedSaldoLabel}" FontSize="10">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedEsSobrepedido}" Value="True">
                            <Setter Property="Foreground" Value="#EF4444" />
                            <Setter Property="FontWeight" Value="Bold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding SelectedSaldo, StringFormat={}{0:N1}}" FontWeight="Bold" FontSize="12">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedEsSobrepedido}" Value="True">
                            <Setter Property="Foreground" Value="#EF4444" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding SelectedUnidad}" Style="{StaticResource Text.Caption}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
              </Grid>

              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Avance:" Style="{StaticResource Text.Caption}" FontSize="10" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedPctText}" Style="{StaticResource Text.Caption}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Fila 2: Lista de Solicitudes de Faena -->
          <Grid Grid.Row="2">
            <!-- Estado sin selección -->
            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="{StaticResource Radius.Sm}" Padding="10"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Seleccione un material" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                <TextBlock Text="Haga clic en una fila para ver pedidos de faena."
                           Style="{StaticResource Text.Caption}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Lista de Solicitudes Registradas -->
            <DockPanel LastChildFill="True" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="Solicitudes de Faena" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedSolicitudesCountText}" Style="{StaticResource Text.Caption}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
              </DockPanel>

              <DataGrid ItemsSource="{Binding SelectedSolicitudes}"
                        Style="{StaticResource DataGrid.Workspace}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ProvocoExceso}" Value="True">
                        <Setter Property="Background" Value="#20EF4444" />
                        <Setter Property="ToolTip" Value="⚠️ Esta solicitud superó el total presupuestado del proyecto." />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Doc." Binding="{Binding SolicitudCodigo}" Width="48" FontWeight="Bold" />
                  <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="58" />
                  <DataGridTextColumn Header="Solicitado Por" Binding="{Binding SolicitadoPor}" Width="*" MinWidth="60">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding SolicitadoPor}" />
                        <Setter Property="FontSize" Value="11" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat={}{0:N1}}" Width="48"
                                      HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
                        <Setter Property="FontSize" Value="11" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ProvocoExceso}" Value="True">
                            <Setter Property="Foreground" Value="#EF4444" />
                            <Setter Property="FontWeight" Value="Bold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>

          <!-- Fila 3: Botón de Navegación a Solicitudes -->
          <Button Grid.Row="3" Style="{StaticResource Button.Primary}" Content="Ir a Solicitudes faena →"
                  Command="{Binding GoToSolicitudesCommand}" Margin="0,8,0,0" Padding="8,5" FontSize="11" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>
