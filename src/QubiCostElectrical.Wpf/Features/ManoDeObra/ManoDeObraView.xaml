<UserControl x:Class="QubiCostElectrical.Wpf.Features.ManoDeObra.ManoDeObraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mo="clr-namespace:QubiCostElectrical.Wpf.Features.ManoDeObra">

  <UserControl.Resources>
    <Style x:Key="Mo.SegBtn" TargetType="Button">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Mo.SalaryInput" TargetType="TextBox">
      <Setter Property="Width" Value="110" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <StackPanel Margin="0,0,24,24">

        <!-- Header -->
        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,12" Background="{DynamicResource Brush.Surface}">
          <DockPanel LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Mano de obra" Style="{StaticResource Text.PageTitle}" FontSize="18" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Padding="10,4" CornerRadius="12" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Duración " FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ChipMeses}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Padding="10,4" CornerRadius="12" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="UF " FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ChipUf}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Padding="2" CornerRadius="7" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Button Content="CLP" Command="{Binding SetCurrencyClpCommand}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Mo.SegBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsClp}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Content="UF" Command="{Binding SetCurrencyUfCommand}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Mo.SegBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUf}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Config bar -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="10" Padding="8,8" Margin="20,14,20,0">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="6,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="DURACIÓN" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding TotalMeses, UpdateSourceTrigger=LostFocus}" Width="56" Height="30" Margin="8,0,4,0"
                         TextAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalContentAlignment="Center"
                         ToolTip="Pulsa Enter o sal del campo para aplicar (ej. 12, 15, 20)"
                         KeyDown="OnParamKeyDown" />
                <TextBlock Text="meses" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="VALOR UF" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChipUf}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Blue}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="LEYES SOCIALES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding LeyesSocialesPct, UpdateSourceTrigger=LostFocus}" Width="48" Height="30" Margin="8,0,4,0"
                         TextAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalContentAlignment="Center"
                         KeyDown="OnParamKeyDown" />
                <TextBlock Text="%" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="CURVA" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="200" Height="30" SelectedValue="{Binding CurvePreset}" SelectedValuePath="Tag">
                  <ComboBoxItem Tag="bell" Content="Campana (ramp → peak → close)" IsSelected="True" />
                  <ComboBoxItem Tag="flat" Content="Plana (dotación fija)" />
                </ComboBox>
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="PICO DIRECTA" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding PeakHeadcount, UpdateSourceTrigger=LostFocus}" Width="52" Height="30" Margin="8,0,4,0"
                         TextAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalContentAlignment="Center"
                         ToolTip="Pulsa Enter o sal del campo para aplicar. 0 = sin dotación (proyecto limpio)"
                         KeyDown="OnParamKeyDown" />
                <TextBlock Text="pers." FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <Border Padding="10,4" CornerRadius="12" Background="{DynamicResource Brush.GreenSoft}" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Green}" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PeakLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Green}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0">
              <Button Name="ProjectionButton" Content="Proyección" Style="{StaticResource Button.Secondary}" Click="OnOpenProjection" Margin="0,0,8,0" MinWidth="100" />
              <Button Content="Restablecer" Style="{StaticResource Button.Secondary}" Command="{Binding ResetParamsCommand}" Margin="0,0,8,0" MinWidth="100" />
              <Button Content="Aplicar" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}" MinWidth="90" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- KPIs -->
        <UniformGrid Columns="5" Margin="20,14,20,0">
          <Border Style="{StaticResource Card.Kpi}" Margin="0,0,8,0" Background="{DynamicResource Brush.Navy}" Padding="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="COSTO TOTAL MO" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
              <TextBlock Text="{Binding KpiTotalMo}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#FFFFFF" Margin="0,4,0,0" />
              <TextBlock Text="{Binding KpiTotalMoSub}" FontSize="9" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,2,0,6" />
              <Border CornerRadius="12" Padding="8,3" Background="#3347B882" HorizontalAlignment="Left">
                <TextBlock Text="{Binding TotalBarUf}" FontSize="8" FontWeight="SemiBold" Foreground="#93C5FD" />
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Kpi}" Margin="0,0,8,0" Padding="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="SUELDOS BASE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding KpiBase}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,0" />
              <TextBlock Text="{Binding KpiBasePct}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,6" />
              <Border CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.BlueSoft}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding KpiBaseTrend}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Kpi}" Margin="0,0,8,0" Padding="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="LEYES SOCIALES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding KpiLeyes}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#6B4FA8" Margin="0,4,0,0" />
              <TextBlock Text="{Binding KpiLeyesPct}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,6" />
              <Border CornerRadius="12" Padding="8,3" Background="#EFEAFA" HorizontalAlignment="Left">
                <TextBlock Text="{Binding KpiLeyesTrend}" FontSize="8" FontWeight="SemiBold" Foreground="#6B4FA8" />
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Kpi}" Margin="0,0,8,0" Padding="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MO DIRECTA" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding KpiDirecta}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" Margin="0,4,0,0" />
              <TextBlock Text="{Binding KpiDirectaSub}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,6" />
              <Border CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.GreenSoft}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding KpiDirectaPct}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" />
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Kpi}" Padding="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MO INDIRECTA" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding KpiIndirecta}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" Margin="0,4,0,0" />
              <TextBlock Text="{Binding KpiIndirectaSub}" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,6" />
              <Border CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.AmberSoft}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding KpiIndirectaPct}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}" />
              </Border>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Chart + insights -->
        <Grid Margin="20,14,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card.Section}" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <TextBlock Text="Curva de dotación" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                      <Border Width="8" Height="8" Background="#3B82F6" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBlock Text="Directa" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="8" Height="8" Background="#D97706" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBlock Text="Indirecta" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,10">
                <ItemsControl ItemsSource="{Binding ChartBars}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Width="28" Margin="1,0" ToolTip="{Binding Tip}">
                        <Border Height="120" VerticalAlignment="Bottom">
                          <DockPanel LastChildFill="False" VerticalAlignment="Bottom">
                            <Border DockPanel.Dock="Bottom" Height="{Binding DirPct}" MinHeight="1"
                                    Background="#3B82F6" CornerRadius="2,2,0,0" Opacity="0.9" />
                            <Border DockPanel.Dock="Bottom" Height="{Binding IndPct}" MinHeight="0"
                                    Background="#D97706" CornerRadius="2,2,0,0" Opacity="0.85" Margin="0,0,0,0" />
                          </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="8" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <StackPanel Grid.Column="2">
            <Border CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="#C6E9D4" Background="#F4FBF7" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="MO Directa" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" LineHeight="16">
                  Trabajadores que ejecutan la obra. Su cantidad <Run FontWeight="SemiBold">varía según la etapa</Run>:
                  pocos al inicio, máximo en el pico y baja al cierre.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="PICO" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExDirPico}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="SUELDO BASE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExDirSueldoProm}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="+ LEYES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExDirLeyVal}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="#EED9A8" Background="#FDF8EE">
              <StackPanel>
                <TextBlock Text="MO Indirecta" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" LineHeight="16">
                  Supervisores y profesionales que <Run FontWeight="SemiBold">gestionan</Run> la obra.
                  Están <Run FontWeight="SemiBold">todos los meses</Run>. Dotación fija.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="DURACIÓN" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExIndDur}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="ROLES" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExIndRoles}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="SUELDO BASE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExIndSueldoProm}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Salary editors -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="20,14,20,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface2}">
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="Sueldos base por cargo" FontSize="13" FontWeight="Bold" />
                  <TextBlock Text="Edita por categoría y rol · se recalcula al instante" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Restablecer sueldos" Style="{StaticResource Button.Secondary}"
                        Command="{Binding ResetSueldosCommand}" HorizontalAlignment="Right" MinWidth="140" />
              </DockPanel>
            </Border>
            <UniformGrid Columns="2" Margin="0">
              <!-- Directa -->
              <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="#C6E9D4" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="MO Directa" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                      <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource Brush.GreenSoft}" VerticalAlignment="Center">
                        <TextBlock Text="VARIABLE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                    <DockPanel>
                      <TextBlock Text="Promedio base · c/leyes" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FootDir}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding DirectaEditors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type mo:MoCargoEditorVm}">
                        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="14,10"
                                Background="{DynamicResource Brush.Surface}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="4,2" Background="{DynamicResource Brush.GreenSoft}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                              <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                              <TextBlock Text="$" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                                         VerticalAlignment="Center" Margin="0,0,4,0" />
                              <TextBox Style="{StaticResource Mo.SalaryInput}"
                                       Text="{Binding SueldoEditText, UpdateSourceTrigger=LostFocus}"
                                       LostFocus="OnSalaryLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                              <TextBlock Text="c/ leyes" FontSize="9" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding ConLeyesLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>

              <!-- Indirecta -->
              <Border>
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="#EED9A8" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="MO Indirecta" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                      <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource Brush.AmberSoft}" VerticalAlignment="Center">
                        <TextBlock Text="FIJA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                    <DockPanel>
                      <TextBlock Text="Promedio base · c/leyes" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FootInd}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding IndirectaEditors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type mo:MoCargoEditorVm}">
                        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="14,10"
                                Background="{DynamicResource Brush.Surface}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="4,2" Background="{DynamicResource Brush.AmberSoft}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Amber}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                              <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                              <TextBlock Text="$" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                                         VerticalAlignment="Center" Margin="0,0,4,0" />
                              <TextBox Style="{StaticResource Mo.SalaryInput}"
                                       Text="{Binding SueldoEditText, UpdateSourceTrigger=LostFocus}"
                                       LostFocus="OnSalaryLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                              <TextBlock Text="c/ leyes" FontSize="9" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding ConLeyesLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>
            </UniformGrid>
          </DockPanel>
        </Border>

        <!-- Dotación table -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="20,14,20,0">
          <StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12" Background="{DynamicResource Brush.Surface2}">
              <DockPanel>
                <TextBlock Text="Dotación mensual por cargo" Style="{StaticResource Text.PageTitle}" FontSize="13" />
                <TextBlock DockPanel.Dock="Right" Text="Celdas con color = carga relativa al pico · clic para editar"
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ScrollViewer x:Name="CargoTableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
              <Grid x:Name="CargoTableGrid" />
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Cost table -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="20,14,20,0">
          <StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12" Background="{DynamicResource Brush.Surface2}">
              <DockPanel>
                <TextBlock Text="Costo mensual · Sueldo base + Leyes sociales" Style="{StaticResource Text.PageTitle}" FontSize="13" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CostHint}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ScrollViewer x:Name="CostTableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
              <Grid x:Name="CostTableGrid" />
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Total bar -->
        <Border Background="{DynamicResource Brush.Navy}" Padding="18,16" Margin="20,10,20,0" CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalBarLabel}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
              <TextBlock Text="{Binding TotalBarSub}" FontSize="11" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
              <TextBlock Text="{Binding TotalBarValue}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#FFFFFF" TextAlignment="Right" />
              <TextBlock Text="{Binding TotalBarUf}" FontSize="12" FontFamily="{StaticResource Font.Mono}" Foreground="#93C5FD" TextAlignment="Right" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Summary bar -->
        <Border Background="{DynamicResource Brush.Navy2}" Padding="14,12" Margin="20,10,20,0" CornerRadius="10">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Sueldos Base" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumBase}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#FFFFFF" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="#33FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Leyes Sociales" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumLeyes}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#93C5FD" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="#33FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="MO Directa" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumDirecta}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#86EFAC" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="#33FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="MO Indirecta" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumIndirecta}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#FCD34D" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="#33FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="Costo / mes prom." FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumPromMes}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="#FFFFFF" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SumRight}" FontSize="11" FontFamily="{StaticResource Font.Mono}"
                       Foreground="#93C5FD" VerticalAlignment="Center" Margin="20,0,0,0" />
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Empty state -->
    <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
            Background="{DynamicResource Brush.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="40" CornerRadius="16" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Sin proyecto abierto" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" />
        <TextBlock Text="Abra un proyecto para ver la proyección de mano de obra" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,16" HorizontalAlignment="Center" />
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto..." Command="{Binding OpenProjectCommand}" MinWidth="180" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Popup Name="ProjectionPopup" PlacementTarget="{Binding ElementName=ProjectionButton}" Placement="Bottom" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="10" Padding="16" MaxWidth="900" MaxHeight="520">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="Black" />
        </Border.Effect>
        <DockPanel LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
            <TextBlock Text="Proyección de mano de obra" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="+ Agregar tarea" Style="{StaticResource Button.Secondary}" Click="OnAddProjectionTask" Margin="0,0,8,0" />
              <Button Content="Cerrar" Style="{StaticResource Button.Secondary}" Click="OnCloseProjection" />
            </StackPanel>
          </DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Name="ProjectionTableGrid" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
