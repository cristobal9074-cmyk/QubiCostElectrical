<UserControl x:Class="QubiCostElectrical.Wpf.Features.ManoDeObra.ManoDeObraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mo="clr-namespace:QubiCostElectrical.Wpf.Features.ManoDeObra"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls">

  <UserControl.Resources>
    <Style x:Key="Mo.SegBtn" TargetType="Button">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Mo.SalaryInput" TargetType="TextBox">
      <Setter Property="Width" Value="110" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.base}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    </Style>

    <Style x:Key="Mo.FraccionInput" TargetType="TextBox">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.base}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <StackPanel Margin="0,0,24,24">

        <!-- Header -->
        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,12" Background="{DynamicResource Brush.Surface}">
          <DockPanel LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Mano de obra" Style="{StaticResource Text.PageTitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Padding="10,4" CornerRadius="12" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Duración " Style="{StaticResource Text.Helper}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ChipMeses}" Style="{StaticResource Text.KpiInline}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Padding="10,4" CornerRadius="12" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="UF " FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ChipUf}" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Padding="2" CornerRadius="7" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Button Content="CLP" Command="{Binding SetCurrencyClpCommand}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Mo.SegBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsClp}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Content="UF" Command="{Binding SetCurrencyUfCommand}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Mo.SegBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUf}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Config bar -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="10" Padding="8,8" Margin="20,14,20,0">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"
                        IsEnabled="{Binding CanEdit}">
              <StackPanel Orientation="Horizontal" Margin="6,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="DURACIÓN" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding TotalMeses, UpdateSourceTrigger=LostFocus}" Width="56" Height="30" Margin="8,0,4,0"
                         TextAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.kpi}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalContentAlignment="Center"
                         ToolTip="Pulsa Enter o sal del campo para aplicar (ej. 12, 15, 20)"
                         KeyDown="OnParamKeyDown" />
                <TextBlock Text="meses" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="VALOR UF" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChipUf}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.kpi}" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Blue}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="LEYES SOCIALES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding LeyesSocialesPct, UpdateSourceTrigger=LostFocus}" Width="48" Height="30" Margin="8,0,4,0"
                         TextAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.kpi}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalContentAlignment="Center"
                         KeyDown="OnParamKeyDown" />
                <TextBlock Text="%" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="CURVA" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="200" Height="30" SelectedValue="{Binding CurvePreset}" SelectedValuePath="Tag">
                  <ComboBoxItem Tag="bell" Content="Campana (subida → pico → cierre)" IsSelected="True" />
                  <ComboBoxItem Tag="flat" Content="Plana (dotación fija)" />
                </ComboBox>
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="PICO DIRECTA" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                <TextBox Text="{Binding PeakHeadcount, UpdateSourceTrigger=LostFocus}" Width="52" Height="30" Margin="8,0,4,0"
                         TextAlignment="Center" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.kpi}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" VerticalContentAlignment="Center"
                         ToolTip="Pulsa Enter o sal del campo para aplicar. 0 = sin dotación (proyecto limpio)"
                         KeyDown="OnParamKeyDown" />
                <TextBlock Text="pers." FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.Line}" Margin="4,0" />
              <Border Padding="10,4" CornerRadius="12" Background="{DynamicResource Brush.GreenSoft}" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Green}" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PeakLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Green}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0">
              <Button Content="Restablecer" Style="{StaticResource Button.Secondary}" Command="{Binding ResetParamsCommand}" Margin="0,0,8,0" MinWidth="100" />
              <Button Content="Aplicar" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}" MinWidth="90" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Resumen compacto -->
        <Border Style="{StaticResource Card.Summary}" Margin="20,10,20,0" Padding="12,6">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="Total MO" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KpiTotalMo}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="Sueldos" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KpiBase}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="Leyes" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KpiLeyes}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Purple}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="MO dir." FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KpiDirecta}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="MO ind." FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KpiIndirecta}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Chart + insights -->
        <Grid Margin="20,14,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card.Section}" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <TextBlock Text="Curva de dotación" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" VerticalAlignment="Center" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                      <Border Width="8" Height="8" Background="{DynamicResource Brush.Blue2}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBlock Text="Directa" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="8" Height="8" Background="{DynamicResource Brush.AmberRisk}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0" />
                      <TextBlock Text="Indirecta" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,10">
                <Border x:Name="ChartWheelZone" Background="Transparent">
                  <ItemsControl ItemsSource="{Binding ChartBars}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Width="28" Margin="1,0" ToolTip="{Binding Tip}">
                          <Border Height="120" VerticalAlignment="Bottom">
                            <DockPanel LastChildFill="False" VerticalAlignment="Bottom">
                              <Border DockPanel.Dock="Bottom" Height="{Binding DirPct}" MinHeight="1"
                                      Background="{DynamicResource Brush.Blue2}" CornerRadius="2,2,0,0" Opacity="0.9" />
                              <Border DockPanel.Dock="Bottom" Height="{Binding IndPct}" MinHeight="0"
                                      Background="{DynamicResource Brush.AmberRisk}" CornerRadius="2,2,0,0" Opacity="0.85" Margin="0,0,0,0" />
                            </DockPanel>
                          </Border>
                          <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Size.micro}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <StackPanel Grid.Column="2">
            <Border CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource Brush.SuccessBorder}" Background="{DynamicResource Brush.GreenSoft}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="MO Directa" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink2}" LineHeight="16">
                  Trabajadores que ejecutan la obra. Su cantidad <Run FontWeight="SemiBold">varía según la etapa</Run>:
                  pocos al inicio, máximo en el pico y baja al cierre.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="PICO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExDirPico}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="SUELDO BASE" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExDirSueldoProm}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="+ LEYES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExDirLeyVal}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Green}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource Brush.Amber2}" Background="{DynamicResource Brush.AmberSoft}">
              <StackPanel>
                <TextBlock Text="MO Indirecta" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink2}" LineHeight="16">
                  Supervisores y profesionales que <Run FontWeight="SemiBold">gestionan</Run> la obra.
                  Están <Run FontWeight="SemiBold">todos los meses</Run>. Dotación fija.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="DURACIÓN" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExIndDur}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="ROLES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExIndRoles}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="SUELDO BASE" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ExIndSueldoProm}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Salary editors -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="20,14,20,0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface2}">
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="Sueldos base por cargo" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" />
                  <TextBlock Text="Edita por categoría y rol · se recalcula al instante" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Restablecer sueldos" Style="{StaticResource Button.Secondary}"
                        Command="{Binding ResetSueldosCommand}" HorizontalAlignment="Right" MinWidth="140" />
              </DockPanel>
            </Border>
            <UniformGrid Columns="2" Margin="0" IsEnabled="{Binding CanEdit}">
              <!-- Directa -->
              <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.SuccessBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="MO Directa" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" VerticalAlignment="Center" />
                      <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource Brush.GreenSoft}" VerticalAlignment="Center">
                        <TextBlock Text="VARIABLE" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                    <DockPanel>
                      <TextBlock Text="Promedio base · c/leyes" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FootDir}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding DirectaEditors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type mo:MoCargoEditorVm}">
                        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="14,10"
                                Background="{DynamicResource Brush.Surface}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="4,2" Background="{DynamicResource Brush.GreenSoft}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Green}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                              <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Hint}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                              <TextBlock Text="$" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Muted}"
                                         VerticalAlignment="Center" Margin="0,0,4,0" />
                              <TextBox Style="{StaticResource Mo.SalaryInput}"
                                       Text="{Binding SueldoEditText, UpdateSourceTrigger=LostFocus}"
                                       LostFocus="OnSalaryLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                              <TextBlock Text="c/ leyes" FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding ConLeyesLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>

              <!-- Indirecta -->
              <Border>
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Amber2}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="MO Indirecta" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" VerticalAlignment="Center" />
                      <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource Brush.AmberSoft}" VerticalAlignment="Center">
                        <TextBlock Text="FIJA" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="14,10" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                    <DockPanel>
                      <TextBlock Text="Promedio base · c/leyes" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FootInd}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding IndirectaEditors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type mo:MoCargoEditorVm}">
                        <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="14,10"
                                Background="{DynamicResource Brush.Surface}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="4,2" Background="{DynamicResource Brush.AmberSoft}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Amber}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                              <TextBlock Text="{Binding Nombre}" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Hint}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                              <TextBlock Text="$" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Muted}"
                                         VerticalAlignment="Center" Margin="0,0,4,0" />
                              <TextBox Style="{StaticResource Mo.SalaryInput}"
                                       Text="{Binding SueldoEditText, UpdateSourceTrigger=LostFocus}"
                                       LostFocus="OnSalaryLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                        ToolTip="Fracción del sueldo cobrada en esta obra (0 a 1). Ej.: 0,30 = 30% del sueldo">
                              <StackPanel Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="FRACCIÓN" FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock Text="obra" FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.Muted}" />
                              </StackPanel>
                              <TextBox Style="{StaticResource Mo.FraccionInput}"
                                       Text="{Binding FraccionEditText, UpdateSourceTrigger=LostFocus}"
                                       LostFocus="OnSalaryLostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                              <TextBlock Text="c/ leyes" FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding ConLeyesLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>
            </UniformGrid>
          </DockPanel>
        </Border>

        <!-- Dotación table -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="20,14,20,0">
          <StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12" Background="{DynamicResource Brush.Surface2}">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Celdas con color = carga relativa al pico · flechas/Tab mueven · vacío vuelve a la curva"
                             FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}"
                             VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Content="Tomar proyección MO" Style="{StaticResource Button.Secondary}"
                          Command="{Binding TakeProjectionCommand}" MinWidth="150" Margin="0,0,8,0"
                          ToolTip="Aplica los totales mensuales de la Proyección MO a la dotación directa de la tabla (reparto por dotación pico) y recalcula costos" />
                  <Button Name="ProjectionButton" Content="Proyección MO" Style="{StaticResource Button.Secondary}"
                          Click="OnOpenProjection" MinWidth="120" />
                </StackPanel>
                <TextBlock Text="Dotación mensual por cargo" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ScrollViewer x:Name="CargoTableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
              <Border x:Name="CargoWheelZone" Background="Transparent">
                <Grid x:Name="CargoTableGrid" />
              </Border>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Cost table -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="20,14,20,0">
          <StackPanel>
            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12" Background="{DynamicResource Brush.Surface2}">
              <DockPanel>
                <TextBlock Text="Costo mensual · Sueldo base + Leyes sociales" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CostHint}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <ScrollViewer x:Name="CostTableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
              <Border x:Name="CostWheelZone" Background="Transparent">
                <Grid x:Name="CostTableGrid" />
              </Border>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Total bar -->
        <Border Background="{DynamicResource Brush.Navy}" Padding="18,16" Margin="20,10,20,0" CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalBarLabel}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
              <TextBlock Text="{Binding TotalBarSub}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
              <TextBlock Text="{Binding TotalBarValue}" FontSize="{StaticResource Font.Size.2xl}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}" TextAlignment="Right" />
              <TextBlock Text="{Binding TotalBarUf}" FontSize="{StaticResource Font.Size.md}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.BrandStroke}" TextAlignment="Right" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Summary bar -->
        <Border Background="{DynamicResource Brush.Navy2}" Padding="14,12" Margin="20,10,20,0" CornerRadius="10">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Sueldos Base" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumBase}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.White25}" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Leyes Sociales" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumLeyes}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.BrandStroke}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.White25}" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="MO Directa" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumDirecta}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.SuccessBright}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.White25}" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="MO Indirecta" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumIndirecta}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Amber2}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{DynamicResource Brush.White25}" Margin="0,0,20,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="Costo / mes prom." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding SumPromMes}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding SumRight}" FontSize="{StaticResource Font.Size.sm}" FontFamily="{StaticResource Font.Mono}"
                       Foreground="{DynamicResource Brush.BrandStroke}" VerticalAlignment="Center" Margin="20,0,0,0" />
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Empty state -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver la proyección de mano de obra.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando mano de obra…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
