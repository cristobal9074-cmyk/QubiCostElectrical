<Window x:Class="QubiCostElectrical.Wpf.Features.ManoDeObra.ProyeccionMoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proyección MO"
        Width="1180" Height="800"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}"
        FontFamily="{DynamicResource Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <LinearGradientBrush x:Key="Proj.HeaderBg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
      <GradientStop Color="{StaticResource Color.NavyEnd}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Proj.BadgeBg" Color="#2E3B82F6" />
    <SolidColorBrush x:Key="Proj.BadgeLine" Color="#527DABFF" />
    <SolidColorBrush x:Key="Proj.BadgeInk" Color="#8FB8FF" />
    <SolidColorBrush x:Key="Proj.MicroInk" Color="#72859A" />
    <SolidColorBrush x:Key="Proj.KbdInk" Color="#A9BDD4" />
    <SolidColorBrush x:Key="Proj.OkLine" Color="#57BE8C" />
    <SolidColorBrush x:Key="Proj.OkBg" Color="#1A40C77D" />
    <SolidColorBrush x:Key="Proj.OkEdge" Color="#4740C77D" />
    <SolidColorBrush x:Key="Proj.OkInk" Color="#9FD9B8" />
    <SolidColorBrush x:Key="Proj.OkDot" Color="#40C77D" />
    <SolidColorBrush x:Key="Proj.BusyBg" Color="#1AFFCE76" />
    <SolidColorBrush x:Key="Proj.BusyEdge" Color="#47FFCE76" />
    <SolidColorBrush x:Key="Proj.BusyInk" Color="#F5D79A" />
    <SolidColorBrush x:Key="Proj.BusyDot" Color="#FFCE76" />
    <LinearGradientBrush x:Key="Proj.ChipFocus" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="{StaticResource Color.Blue2}" Offset="0" />
      <GradientStop Color="{StaticResource Color.Blue}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Proj.TotalBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#CFE0FB" Offset="0" />
      <GradientStop Color="#A9C6FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Proj.SparkBar" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#5B91FF" Offset="0" />
      <GradientStop Color="{StaticResource Color.Blue}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Proj.SparkPeak" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#34D399" Offset="0" />
      <GradientStop Color="{StaticResource Color.Green}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Proj.ToastBg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#17324F" Offset="0" />
      <GradientStop Color="#12263E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Proj.ToastEdge" Color="#6640C77D" />

    <Style x:Key="Proj.BtnGhost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.NavyBorder}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
          <Setter Property="Background" Value="#12FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Proj.Kbd" TargetType="Border">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#24FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="Proj.QtyChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="19" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueIconBg2}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Proj.HeaderRemove" TargetType="Button">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Proj.AddBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#143B82F6" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="56" Padding="16,0" Background="{StaticResource Proj.HeaderBg}">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="9"
                  Background="{StaticResource Proj.BadgeBg}"
                  BorderBrush="{StaticResource Proj.BadgeLine}" BorderThickness="1">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Data="M3,5 h18 v16 h-18 z M3,10 h18 M8,2.5 v4 M16,2.5 v4 M7.5,14 h3.5 M13,14 h3.5 M7.5,17.5 h3.5 M13,17.5 h3.5"
                  Stroke="{StaticResource Proj.BadgeInk}" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Proyección MO" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.White}" />
            <TextBlock Text="Dotación directa por mes · perfil del proyecto" FontSize="10.5"
                       Foreground="{DynamicResource Brush.HeaderMuted}" Margin="0,1,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ApplyButton" Style="{StaticResource Button.Primary}" FontSize="11.5"
                  Padding="13,0" Click="OnApply">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Aplicar a dotación" />
              <Path Data="M5 12h14M13 6l6 6-6 6" Width="11" Height="11" Stretch="Uniform"
                    Margin="7,0,0,0" VerticalAlignment="Center"
                    Stroke="{DynamicResource Brush.White}" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </StackPanel>
          </Button>
          <Button Content="Cerrar" Style="{StaticResource Proj.BtnGhost}" FontSize="11.5"
                  Padding="13,0" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Height="66" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="18,0">
          <TextBlock Text="PROMEDIO MENSUAL" FontSize="9" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.Ink4}" />
          <TextBlock x:Name="AverageText" Text="0" FontFamily="{DynamicResource Font.Mono}"
                     FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                     Margin="0,1,0,0" />
          <TextBlock Text="trabajadores por mes" FontSize="10"
                     Foreground="{DynamicResource Brush.Ink4}" />
        </StackPanel>
        <Border Grid.Column="1" Margin="18,0" VerticalAlignment="Stretch"
                Padding="18,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Line2}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TOTAL PROYECTO" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink4}" />
            <TextBlock x:Name="TotalSumText" Text="0" FontFamily="{DynamicResource Font.Mono}"
                       FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                       Margin="0,1,0,0" />
            <TextBlock Text="hombre-mes" FontSize="10"
                       Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="18,0" VerticalAlignment="Stretch"
                Padding="18,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Line2}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MÁXIMO MENSUAL" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink4}" />
            <TextBlock x:Name="MaxValueText" Text="0" FontFamily="{DynamicResource Font.Mono}"
                       FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}"
                       Margin="0,1,0,0" />
            <TextBlock x:Name="MaxMonthsText" Text="—" FontSize="10"
                       Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Margin="18,0" VerticalAlignment="Stretch"
                Padding="18,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Line2}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ALCANCE" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink4}" />
            <TextBlock x:Name="ScopeText" Text="0 × 0" FontFamily="{DynamicResource Font.Mono}"
                       FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                       Margin="0,1,0,0" />
            <TextBlock Text="partidas × meses" FontSize="10"
                       Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Padding="0,0,16,0"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Line2}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PERFIL MENSUAL" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" />
            <StackPanel x:Name="SparkPanel" Orientation="Horizontal" Margin="0,5,0,0"
                        HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="34" Padding="14,0"
            Background="{DynamicResource Brush.Navy2}"
            BorderBrush="{DynamicResource Brush.NavyBorder}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Proj.Kbd}">
            <TextBlock Text="←↑↓→" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                       Foreground="{StaticResource Proj.KbdInk}" />
          </Border>
          <Border Style="{StaticResource Proj.Kbd}">
            <TextBlock Text="Enter" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                       Foreground="{StaticResource Proj.KbdInk}" />
          </Border>
          <Border Style="{StaticResource Proj.Kbd}">
            <TextBlock Text="Tab" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                       Foreground="{StaticResource Proj.KbdInk}" />
          </Border>
          <Border Style="{StaticResource Proj.Kbd}">
            <TextBlock Text="Esc" FontFamily="{DynamicResource Font.Mono}" FontSize="9"
                       Foreground="{StaticResource Proj.KbdInk}" />
          </Border>
          <TextBlock Text="navegan y editan · el primer número reemplaza el valor"
                     FontSize="10" Foreground="{StaticResource Proj.MicroInk}"
                     VerticalAlignment="Center" Margin="7,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M5 12h14M13 6l6 6-6 6" Width="10" Height="10" Stretch="Uniform"
                VerticalAlignment="Center" Stroke="{StaticResource Proj.MicroInk}"
                StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round" />
          <TextBlock Text="el total de cada mes entra a la dotación directa" FontSize="10"
                     Foreground="{StaticResource Proj.MicroInk}" VerticalAlignment="Center"
                     Margin="6,0,0,0" />
          <Border x:Name="SavedPill" Margin="14,0,0,0" Height="20" CornerRadius="10"
                  Padding="9,0" Background="{StaticResource Proj.OkBg}"
                  BorderBrush="{StaticResource Proj.OkEdge}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="SavedDot" Width="6" Height="6" Fill="{StaticResource Proj.OkDot}" />
              <TextBlock x:Name="SavedText" Text="guardado" FontSize="9.5" Margin="6,0,0,0"
                         Foreground="{StaticResource Proj.OkInk}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Margin="12" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="9" ClipToBounds="True">
      <Grid>
        <ScrollViewer x:Name="SheetScroll" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0">
          <Grid x:Name="Sheet" />
        </ScrollViewer>
        <Border x:Name="ToastBorder" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Height="34" CornerRadius="17" Padding="16,0"
                Background="{StaticResource Proj.ToastBg}"
                BorderBrush="{StaticResource Proj.ToastEdge}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M20 6 L9 17 L4 12" Width="13" Height="13" Stretch="Uniform"
                  VerticalAlignment="Center" Stroke="{StaticResource Proj.OkDot}"
                  StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <TextBlock Text="Proyección aplicada a la dotación directa" FontSize="11.5"
                       FontWeight="SemiBold" Foreground="#EAF7EF" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </DockPanel>
</Window>
