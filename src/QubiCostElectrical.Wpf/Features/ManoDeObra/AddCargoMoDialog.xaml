<Window x:Class="QubiCostElectrical.Wpf.Features.ManoDeObra.AddCargoMoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Agregar Puesto Laboral"
        Width="460" SizeToContent="Height" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded"
        KeyDown="OnWindowKeyDown">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Encabezado -->
      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock x:Name="HeaderTitleText" Text="Nuevo Puesto Laboral" Style="{StaticResource Dialog.HeaderTitle}" />
        <TextBlock x:Name="HeaderSubtitleText" Text="Ingrese la información del nuevo cargo para incorporarlo al proyecto."
                   Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Formulario -->
      <StackPanel Grid.Row="1" Margin="0,0,0,16">
        <!-- Nombre del cargo -->
        <TextBlock Text="Nombre del puesto *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="NombreBox" Style="{StaticResource Form.TextBox}"
                 TextChanged="OnNombreTextChanged" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Código / Tag -->
          <StackPanel Grid.Column="0">
            <TextBlock Text="Tag / Sigla *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <TextBox x:Name="TagBox" Style="{StaticResource Form.TextBox}" MaxLength="6"
                     FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                     TextChanged="OnTagTextChanged" />
          </StackPanel>

          <!-- Sueldo Base Mensual -->
          <StackPanel Grid.Column="2">
            <TextBlock Text="Sueldo base mensual (CLP) *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <TextBox x:Name="SueldoBox" Style="{StaticResource Form.TextBox}"
                     FontFamily="{StaticResource Font.Mono}" Text="750.000"
                     GotFocus="OnSueldoGotFocus" LostFocus="OnSueldoLostFocus" />
          </StackPanel>
        </Grid>

        <!-- Campos específicos de Mano de Obra Indirecta -->
        <Grid x:Name="IndirectaFieldsGrid" Visibility="Collapsed" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Dotación mensual fija *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <TextBox x:Name="DotacionBox" Style="{StaticResource Form.TextBox}"
                     FontFamily="{StaticResource Font.Mono}" Text="1" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Fracción de obra (0 a 1) *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <TextBox x:Name="FraccionBox" Style="{StaticResource Form.TextBox}"
                     FontFamily="{StaticResource Font.Mono}" Text="1,00"
                     ToolTip="1,00 = 100% cobrado en esta obra. Ej: 0,50 para media jornada o 50%" />
          </StackPanel>
        </Grid>

        <!-- Nota informativa -->
        <Border x:Name="InfoBorder" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12,8">
          <TextBlock x:Name="InfoText" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <!-- Botones de acción -->
      <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Guardar puesto"
                MinWidth="130" IsDefault="True" Click="OnAcceptClick" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
                MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
