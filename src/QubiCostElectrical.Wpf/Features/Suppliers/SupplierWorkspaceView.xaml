<UserControl x:Class="QubiCostElectrical.Wpf.Features.Suppliers.SupplierWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Proveedores" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
      <TextBlock Text="Maestro de proveedores, contactos y condiciones habituales." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,0" Padding="10,6"/>
        <Button Content="Crear" Command="{Binding CreateCommand}" Margin="0,0,6,0" Padding="10,6" Background="#2563EB" Foreground="White"/>
        <Button Content="Guardar" Command="{Binding SaveCommand}" Margin="0,0,6,0" Padding="10,6"/>
        <Button Content="Desactivar" Command="{Binding DisableCommand}" Margin="0,0,6,0" Padding="10,6"/>
        <Button Content="Exportar CSV" Command="{Binding ExportCommand}" Padding="10,6"/>
      </StackPanel>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="*"/>
          <DataGridTextColumn Header="Razón social" Binding="{Binding LegalName}" Width="2*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Ciudad" Binding="{Binding City}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Editor" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Código"/><TextBox Text="{Binding EditCode}" Margin="0,0,0,6"/>
            <TextBlock Text="Razón social"/><TextBox Text="{Binding EditLegalName}" Margin="0,0,0,6"/>
            <TextBlock Text="Nombre comercial"/><TextBox Text="{Binding EditTradeName}" Margin="0,0,0,6"/>
            <TextBlock Text="Correo"/><TextBox Text="{Binding EditEmail}" Margin="0,0,0,6"/>
            <TextBlock Text="Teléfono"/><TextBox Text="{Binding EditPhone}" Margin="0,0,0,6"/>
            <TextBlock Text="Ciudad"/><TextBox Text="{Binding EditCity}" Margin="0,0,0,12"/>
            <TextBlock Text="Contactos" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid ItemsSource="{Binding Contacts}" AutoGenerateColumns="False" IsReadOnly="True" Height="120" Margin="0,0,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBox Text="{Binding ContactName}" Tag="Nombre" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ContactEmail}" Margin="0,0,0,4"/>
            <Button Content="Agregar contacto" Command="{Binding AddContactCommand}" Padding="8,4"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#374151"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
