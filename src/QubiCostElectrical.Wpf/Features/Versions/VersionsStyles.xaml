<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/DesignSystem/Theme.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Pill.Base" TargetType="Border">
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="Pill.Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Pill.Draft" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
  </Style>
  <Style x:Key="Pill.Review" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
  </Style>
  <Style x:Key="Pill.Approved" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
  </Style>
  <Style x:Key="Pill.Rejected" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
  </Style>
  <Style x:Key="Pill.Obsolete" TargetType="Border" BasedOn="{StaticResource Pill.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style x:Key="RevBadge" TargetType="Border">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}" />
  </Style>
  <Style x:Key="RevBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card.Kpi}">
    <Setter Property="Padding" Value="14,13" />
  </Style>
  <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.TotalsLabel}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style x:Key="KpiValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style x:Key="KpiSub" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <Style x:Key="StatusBarRow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="40" />
  </Style>

  <Style x:Key="TimelineDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Blue}" />
    <Setter Property="Margin" Value="12,5,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
</ResourceDictionary>
