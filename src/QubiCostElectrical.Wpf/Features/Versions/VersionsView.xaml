<UserControl x:Class="QubiCostElectrical.Wpf.Features.Versions.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QubiCostElectrical.Wpf.Features.Versions"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1400">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="VersionsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="700" />
      <ColumnDefinition Width="1*" MinWidth="360" MaxWidth="440" />
    </Grid.ColumnDefinitions>

    <!-- ═══════════════ MAIN COLUMN ═══════════════ -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                  Padding="0,0,12,0">
      <StackPanel Margin="0,0,0,12">

        <!-- ── Toolbar ── -->
        <Border Style="{StaticResource Card.Surface}" Padding="14,10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="14" Padding="10,4,12,4" Height="26">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Blue}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueDark}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource Brush.GreenSoft}" CornerRadius="14" Padding="10,4,12,4" Height="26" Margin="8,0,0,0">
              <TextBlock Text="{Binding SummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Green}" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource Button.Primary}" Content="+ Nueva versión" Command="{Binding NewCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Activar" Command="{Binding ActivateCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Renombrar" Command="{Binding RenameCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Eliminar" Command="{Binding DeleteCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── Status bar ── -->
        <Border Style="{StaticResource StatusBarRow}" Margin="0,0,0,10">
          <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Resumen" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" Margin="6,0,14,0" VerticalAlignment="Center" />
              </StackPanel>
              <Separator Style="{StaticResource VerticalSeparator}" Margin="0,0,14,0" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Activa" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveVersionText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" Margin="6,0,14,0" VerticalAlignment="Center" />
              </StackPanel>
              <Separator Style="{StaticResource VerticalSeparator}" Margin="0,0,14,0" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Última modificación" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedVersion.FechaModificacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Center"
                       Text="La lista permite congelar hitos de presupuesto, activar una versión y mantener trazabilidad del monto de venta." />
          </DockPanel>
        </Border>

        <!-- ── KPI row ── -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,5,0">
            <StackPanel>
              <TextBlock Text="VARIACIÓN VS ANTERIOR" Style="{StaticResource KpiLabel}" />
              <TextBlock Text="{Binding ComparisonDeltaText}" Style="{StaticResource KpiValue}" />
              <TextBlock Text="{Binding ComparisonDeltaPctText}" Style="{StaticResource KpiSub}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="5,0,5,0">
            <StackPanel>
              <TextBlock Text="PARTIDAS COMPARADAS" Style="{StaticResource KpiLabel}" />
              <TextBlock Text="{Binding ComparisonSummaryText}" Style="{StaticResource KpiValue}" />
              <TextBlock Text="{Binding ComparisonChangedText}" Style="{StaticResource KpiSub}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="5,0,0,0">
            <StackPanel>
              <TextBlock Text="VERSIÓN ACTIVA" Style="{StaticResource KpiLabel}" />
              <TextBlock Text="{Binding ActiveVersionText}" Style="{StaticResource KpiValue}" FontSize="12" />
              <TextBlock Text="{Binding SummaryText}" Style="{StaticResource KpiSub}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- ── Versions DataGrid ── -->
        <Border Style="{StaticResource Card.Section}" Padding="0" Margin="0,0,0,10"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <DockPanel>
                <TextBlock Text="Versiones del presupuesto" Style="{StaticResource Text.SectionLabel}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Ordenado por fecha · descendente" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredVersions}"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                      IsReadOnly="True" Style="{StaticResource DataGrid.Workspace}" MaxHeight="480">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.ActiveRowBg}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Activa" Width="48">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="★" FontSize="14" HorizontalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Line}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="#FACC15" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Rev." Width="56">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border>
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource RevBadge}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RevBadge}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RevBadgeText}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="180" />
                <DataGridTemplateColumn Header="Estado" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border>
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Pill.Draft}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Estado}" Value="Pendiente de revisión">
                                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Estado}" Value="En revisión">
                                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Estado}" Value="Aprobada">
                                <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Estado}" Value="Rechazada">
                                <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Estado}" Value="Obsoleta">
                                <Setter Property="Opacity" Value="0.65" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Estado}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Estado}" Value="Aprobada">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="Rechazada">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="En revisión">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="Pendiente de revisión">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Venta UF" Binding="{Binding MontoVentaUf, StringFormat={}{0:N3}}" Width="110">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="TextAlignment" Value="Right" />
                      <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Delta UF" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DeltaText}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                 HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DeltaKind}" Value="Aumenta">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DeltaKind}" Value="Reduce">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Creada" Binding="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140" />
                <DataGridTextColumn Header="Por" Binding="{Binding CreadoPor}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <!-- ── Comparison section ── -->
        <Border Style="{StaticResource Card.Section}" Padding="0"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <DockPanel>
                <TextBlock Text="Comparación de versiones" Style="{StaticResource Text.SectionLabel}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource Button.Toolbar}" Content="Ir a partida" Command="{Binding GoToItemCommand}" />
                  <Button Style="{StaticResource Button.Toolbar}" Content="Exportar informe" Command="{Binding ExportComparisonCommand}" Margin="6,0,0,0" />
                  <Button Style="{StaticResource Button.Toolbar}" Content="Actualizar" Command="{Binding RefreshComparisonCommand}" Margin="6,0,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="16,10,16,0">
              <CheckBox Content="Comparar versión seleccionada con el estado actual del proyecto"
                        IsChecked="{Binding CompareAgainstCurrent, Mode=TwoWay}"
                        Foreground="{DynamicResource Brush.Ink3}" FontSize="11.5" />
              <TextBlock Text="{Binding ComparisonModeHint}" Visibility="Collapsed" />
              <Grid Margin="0,6,0,0"
                    Visibility="{Binding ShowComparisonVersionSelector, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Versión B" Style="{StaticResource Text.TotalsLabel}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" Style="{StaticResource Form.ComboBox}"
                          ItemsSource="{Binding ComparisonVersionOptions}"
                          SelectedItem="{Binding SelectedComparisonVersion, Mode=TwoWay}"
                          DisplayMemberPath="Nombre" MinWidth="200" Height="30" />
              </Grid>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="8" Padding="12,10" Margin="16,10,16,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                  <TextBlock Text="Versión A" Style="{StaticResource Text.Caption}" FontSize="9" />
                  <TextBlock Text="{Binding SelectedVersion.Codigo, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="11.5" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                  <TextBlock Text="Versión B" Style="{StaticResource Text.Caption}" FontSize="9" />
                  <TextBlock Text="Estado actual del proyecto" FontWeight="SemiBold" FontSize="11.5" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,18,0">
                  <TextBlock Text="Delta total" Style="{StaticResource Text.Caption}" FontSize="9" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding ComparisonDeltaText}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Variación" Style="{StaticResource Text.Caption}" FontSize="9" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding ComparisonDeltaPctText}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
            <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredComparisonRows}"
                      SelectedItem="{Binding SelectedComparisonRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                      IsReadOnly="True" Style="{StaticResource DataGrid.Workspace}" Margin="16,10,16,14" MaxHeight="220">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EsTitulo}" Value="True">
                      <Setter Property="FontWeight" Value="Bold" />
                      <Setter Property="Background" Value="{DynamicResource Brush.ChapterRowBg}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EsTitulo}" Value="False" />
                        <Condition Binding="{Binding Estado}" Value="Nuevo" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EsTitulo}" Value="False" />
                        <Condition Binding="{Binding Estado}" Value="Eliminado" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EsTitulo}" Value="False" />
                        <Condition Binding="{Binding Estado}" Value="Modificado" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Ítem WBS" Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Item}" Margin="{Binding IndentMargin}" VerticalAlignment="Center" FontSize="11" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Partida / Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="Base $" Binding="{Binding BaselineUf, StringFormat={}{0:N3}}" Width="90" ElementStyle="{StaticResource Text.Numeric}" />
                <DataGridTextColumn Header="Actual $" Binding="{Binding CurrentUf, StringFormat={}{0:N3}}" Width="90" ElementStyle="{StaticResource Text.Numeric}" />
                <DataGridTextColumn Header="Delta $" Binding="{Binding DeltaUf, StringFormat={}{0:N3}}" Width="90" ElementStyle="{StaticResource Text.Numeric}" />
                <DataGridTextColumn Header="Delta %" Binding="{Binding DeltaPct, StringFormat={}{0:N2}%}" Width="80" ElementStyle="{StaticResource Text.Numeric}" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" />
                <DataGridTextColumn Header="Cambios" Binding="{Binding DetalleCambios}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <!-- ── Empty state ── -->
        <Border Style="{StaticResource Card.Section}" Padding="32,28" Margin="0,0,0,10"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16" MaxWidth="480" />
            <Button Style="{StaticResource Button.Primary}" Content="Nueva versión" Command="{Binding NewCommand}"
                    HorizontalAlignment="Center" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <vm:VersionsSidebarView Grid.Column="1" DataContext="{Binding}" />
  </Grid>
</UserControl>
