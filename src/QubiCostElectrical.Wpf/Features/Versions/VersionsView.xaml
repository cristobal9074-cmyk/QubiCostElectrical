<UserControl x:Class="QubiCostElectrical.Wpf.Features.Versions.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{DynamicResource Brush.Canvas}"
        HorizontalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="660" />
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="280" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource Button.Primary}" Content="Nueva" Command="{Binding NewCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Secondary}" Content="Activar" Command="{Binding ActivateCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Secondary}" Content="Renombrar" Command="{Binding RenameCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Secondary}" Content="Eliminar" Command="{Binding DeleteCommand}" />
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="10" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Resumen" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Activa" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ActiveVersionText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Actualizado" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding SelectedVersion.FechaModificacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="3" Text="La lista permite congelar hitos de presupuesto, activar una versión y mantener trazabilidad del monto de venta."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <!-- KPI delta cards between versions list and comparison area -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
          <Border Style="{StaticResource Card.Kpi}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="VARIACIÓN VS ANTERIOR" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ComparisonDeltaText}" Style="{StaticResource Text.KpiValue}" />
              <TextBlock Text="{Binding ComparisonDeltaPctText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Kpi}" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="PARTIDAS COMPARADAS" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ComparisonSummaryText}" Style="{StaticResource Text.KpiValue}" />
              <TextBlock Text="{Binding ComparisonChangedText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card.Kpi}">
            <StackPanel>
              <TextBlock Text="VERSIÓN ACTIVA" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ActiveVersionText}" Style="{StaticResource Text.KpiValue}" FontSize="11" />
              <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card.Section}" Padding="0" Margin="0,0,0,12"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
          <DataGrid ItemsSource="{Binding FilteredVersions}"
                    SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    IsReadOnly="True"
                    Style="{StaticResource DataGrid.Workspace}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Activa" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="★" HorizontalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Rev." Width="70" SortMemberPath="Codigo">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- Badge cuadrado de revisión; acento cuando es la versión activa -->
                    <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding RevBadge}" FontSize="11" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" />
              <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="220" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130" />
              <DataGridTextColumn Header="Venta UF" Binding="{Binding MontoVentaUf, StringFormat={}{0:N3}}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Delta UF" Binding="{Binding DeltaText}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="TextAlignment" Value="Right" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink5}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DeltaKind}" Value="Aumenta">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DeltaKind}" Value="Reduce">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Creada" Binding="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150" />
              <DataGridTextColumn Header="Por" Binding="{Binding CreadoPor}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Sm}" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Comparación de versión" Style="{StaticResource Text.SectionLabel}" />
                <TextBlock Text="{Binding ComparisonStatusText}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Secondary}" Content="Ir a partida"
                        Command="{Binding GoToItemCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Actualizar comparación"
                        Command="{Binding RefreshComparisonCommand}" />
              </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <CheckBox Grid.Row="0"
                        Content="Comparar versión seleccionada con el estado actual del proyecto"
                        IsChecked="{Binding CompareAgainstCurrent, Mode=TwoWay}"
                        Margin="0,0,0,6" />
              <TextBlock Grid.Row="1"
                         Text="{Binding ComparisonModeHint}"
                         FontSize="9"
                         Foreground="{DynamicResource Brush.Muted}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,8"
                  Visibility="{Binding ShowComparisonVersionSelector, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Versión B"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Ink2}"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />
              <ComboBox Grid.Column="1"
                        Style="{StaticResource Form.ComboBox}"
                        ItemsSource="{Binding ComparisonVersionOptions}"
                        SelectedItem="{Binding SelectedComparisonVersion, Mode=TwoWay}"
                        DisplayMemberPath="Nombre"
                        MinWidth="220" />
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Resumen" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding ComparisonSummaryText}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Altas" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding ComparisonAddedText}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Cambios / bajas" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding ComparisonChangedText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ComparisonRemovedText}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding ComparisonTotalsText}"
                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Card.Section}" Padding="0">
              <DataGrid ItemsSource="{Binding FilteredComparisonRows}"
                        SelectedItem="{Binding SelectedComparisonRow, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        IsReadOnly="True"
                        Style="{StaticResource DataGrid.Workspace}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Ítem" Binding="{Binding ItemId}" Width="92" />
                  <DataGridTextColumn Header="Partida" Binding="{Binding Item}" Width="*" MinWidth="220" />
                  <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*" MinWidth="220" />
                  <DataGridTextColumn Header="Base UF" Binding="{Binding BaselineUf, StringFormat={}{0:N3}}" Width="96" />
                  <DataGridTextColumn Header="Actual UF" Binding="{Binding CurrentUf, StringFormat={}{0:N3}}" Width="96" />
                  <DataGridTextColumn Header="Delta UF" Binding="{Binding DeltaUf, StringFormat={}{0:N3}}" Width="96" />
                  <DataGridTextColumn Header="Delta %" Binding="{Binding DeltaPct, StringFormat={}{0:N2}%}" Width="96" />
                  <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </Grid>
        </Border>
        <Border Grid.Row="5" Style="{StaticResource Card.Section}" Padding="32,28"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,0,0,16" MaxWidth="480" />
            <Button Style="{StaticResource Button.Primary}" Content="Nueva versión"
                    Command="{Binding NewCommand}" HorizontalAlignment="Center"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>

      </Grid>
    </Border>

    <Border Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14">
      <StackPanel>
        <TextBlock Text="Detalle de la versión" Style="{StaticResource Text.SectionLabel}" />
        <TextBlock Text="{Binding SelectedVersion.Codigo, StringFormat=Código: {0}}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding SelectedVersion.Nombre, StringFormat=Nombre: {0}}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SelectedVersion.Estado, StringFormat=Estado: {0}}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding SelectedVersion.MontoVentaUf, StringFormat=Venta UF: {0:N3}}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding SelectedVersion.DeltaText, StringFormat=Delta UF: {0}}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding SelectedVersion.CreadoPor, StringFormat=Creada por: {0}}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding SelectedVersion.FechaCreacion, StringFormat=Creada: {0:dd/MM/yyyy HH:mm}}" Margin="0,6,0,0" />
        <TextBlock Text="{Binding SelectedVersion.FechaModificacion, StringFormat=Modificada: {0:dd/MM/yyyy HH:mm}}" Margin="0,6,0,12" />

        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Sm}" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Acciones" Style="{StaticResource Text.Caption}" />
            <Button Style="{StaticResource Button.Primary}" Content="Activar versión" Command="{Binding ActivateCommand}" Margin="0,8,0,6" />
            <Button Style="{StaticResource Button.Secondary}" Content="Renombrar" Command="{Binding RenameCommand}" Margin="0,0,0,6" />
            <Button Style="{StaticResource Button.Secondary}" Content="Ir a partida comparada" Command="{Binding GoToItemCommand}" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="12">
          <StackPanel>
            <TextBlock Text="Qué hace esta pantalla" Style="{StaticResource Text.Caption}" />
            <TextBlock Text="Registra hitos de presupuesto, conserva el snapshot asociado y permite volver a un estado activo sin perder trazabilidad."
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
