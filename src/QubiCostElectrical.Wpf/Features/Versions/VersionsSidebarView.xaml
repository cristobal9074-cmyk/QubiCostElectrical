<UserControl x:Class="QubiCostElectrical.Wpf.Features.Versions.VersionsSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="VersionsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0">
    <StackPanel>

      <!-- ── Version state ── -->
      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="14,12" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="ESTADO DE LA VERSIÓN" Style="{StaticResource Text.Caption}" FontSize="9" />
            <TextBlock Text="{Binding SelectedVersion.Estado}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,3,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Brush.SuccessBg}" CornerRadius="6" Padding="8,5" VerticalAlignment="Center" Height="26">
            <StackPanel Orientation="Horizontal">
              <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4"
                    Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="SHA-256 válida" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ── Details & comments ── -->
      <Border Style="{StaticResource Card.Surface}" Padding="0" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card.Header}">
            <TextBlock Text="Detalles y comentarios" Style="{StaticResource Text.SectionLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" />
          </Border>
          <StackPanel Grid.Row="1" Margin="14,8,14,14">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Creador:" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.CreadoPor}" FontSize="12" Foreground="{DynamicResource Brush.Ink}" Margin="8,0,0,0" />
            </Grid>
            <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                    Visibility="{Binding SelectedVersion.Source.FechaEnvio, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Enviado por:" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.Source.EnviadoPor}" FontSize="11" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding SelectedVersion.Source.ComentarioEnvio}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding SelectedVersion.Source.VersionBaseComparada, StringFormat=Comparado con: {0}}" Style="{StaticResource Text.Caption}" FontSize="9" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.Source.ImpactoEconomicoUf, StringFormat=Impacto: {0:N3} UF}" Style="{StaticResource Text.Caption}" FontSize="9" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                    Visibility="{Binding SelectedVersion.Source.FechaAprobacion, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Aprobado por:" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.Source.AprobadoPor}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding SelectedVersion.Source.ComentarioAprobacion}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.RedSoft}" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                    Visibility="{Binding SelectedVersion.Source.FechaRechazo, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Rechazado por:" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" />
                  <TextBlock Grid.Column="1" Text="{Binding SelectedVersion.Source.RechazadoPor}" FontSize="11" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding SelectedVersion.Source.MotivoRechazo}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Transition actions ── -->
      <Border Style="{StaticResource Card.Surface}" Padding="0" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card.Header}">
            <TextBlock Text="Acciones de transición" Style="{StaticResource Text.SectionLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" />
          </Border>
          <StackPanel Grid.Row="1" Margin="14,10,14,14">
            <Button Style="{StaticResource Button.Secondary}" Content="Enviar a revisión"
                    Command="{Binding EnviarARevisionCommand}" Margin="0,0,0,6"
                    Height="32"
                    Visibility="{Binding SelectedVersion.IsDraft, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Secondary}" Content="Iniciar revisión formal"
                    Command="{Binding IniciarRevisionCommand}" Margin="0,0,0,6"
                    Height="32"
                    Visibility="{Binding SelectedVersion.IsPendingReview, Converter={StaticResource BoolToVisibility}}" />
            <Grid Visibility="{Binding SelectedVersion.IsInReview, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Style="{StaticResource Button.Primary}" Content="Aprobar"
                      Command="{Binding AprobarVersionCommand}" Margin="0,0,4,6" Height="32" />
              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Rechazar"
                      Command="{Binding RechazarVersionCommand}" Margin="4,0,0,6" Height="32" />
            </Grid>
            <Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber2}"
                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                    Visibility="{Binding ShowApprovalBlockWarning, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource Brush.AmberRisk}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ApprovalBlockReason}" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" FontSize="10.5" VerticalAlignment="Center" MaxWidth="260" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource Button.Secondary}" Content="Rechazar (desde Pendiente)"
                    Command="{Binding RechazarVersionCommand}" Margin="0,0,0,6" Height="32"
                    Visibility="{Binding SelectedVersion.IsPendingReview, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6,0,0"
                    Visibility="{Binding SelectedVersion.IsApproved, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4"
                      Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" StrokeLineJoin="Round"
                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="No hay acciones disponibles. Versión aprobada — solo lectura."
                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Brush.ChipBg}" CornerRadius="8" Padding="12,10" Margin="0,6,0,0"
                    Visibility="{Binding SelectedVersion.IsObsolete, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="No hay acciones disponibles para este estado."
                         FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── Audit history ── -->
      <Border Style="{StaticResource Card.Surface}" Padding="0" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card.Header}">
            <DockPanel>
              <TextBlock Text="Historial de estados (auditoría)" Style="{StaticResource Text.SectionLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="Inmutable" Style="{StaticResource Text.Caption}" FontSize="9" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <StackPanel Grid.Row="1" Margin="0,4,0,8">
            <ItemsControl ItemsSource="{Binding SelectedVersionHistory}" Margin="0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" HorizontalAlignment="Center">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Blue}" Margin="0,6,0,0" VerticalAlignment="Top" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,4,14,8">
                      <TextBlock Text="{Binding EstadoNuevo}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                      <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock Text="{Binding Fecha, StringFormat={}{0:dd/MM HH:mm}}" Style="{StaticResource Text.Caption}" FontSize="9.5" />
                        <TextBlock Text="{Binding Usuario, StringFormat=' · {0}'}" Style="{StaticResource Text.Caption}" FontSize="9.5" Margin="6,0,0,0" />
                      </StackPanel>
                      <TextBlock Text="{Binding Comentario}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Visibility="{Binding Comentario, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
