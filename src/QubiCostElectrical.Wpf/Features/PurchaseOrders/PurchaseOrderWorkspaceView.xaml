<UserControl x:Class="QubiCostElectrical.Wpf.Features.PurchaseOrders.PurchaseOrderWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Órdenes de compra" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Generar desde adjudicación, aprobar, emitir, confirmar proveedor y cerrar. Sin recepción de materiales." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Generar desde adjudicación" Command="{Binding GenerateCommand}" Margin="0,0,6,6" Padding="10,6" Background="#2563EB" Foreground="White"/>
      <Button Content="Enviar" Command="{Binding SubmitCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Aprobar" Command="{Binding ApproveCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Emitir" Command="{Binding IssueCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Confirmar proveedor" Command="{Binding ConfirmCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Cerrar" Command="{Binding CloseCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Exportar CSV" Command="{Binding ExportCommand}" Margin="0,0,6,6" Padding="10,6"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Awards}" SelectedItem="{Binding SelectedAward}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Adjudicación" Binding="{Binding Id.Value}" Width="*"/>
          <DataGridTextColumn Header="Impacto" Binding="{Binding BudgetImpactBase}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Column="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Moneda" Binding="{Binding CurrencyCode}" Width="Auto"/>
          <DataGridTextColumn Header="Comprometido" Binding="{Binding CommittedCostBase}" Width="*"/>
          <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="Auto"/>
          <DataGridTextColumn Header="Entrega" Binding="{Binding CommittedDeliveryDate}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
      <TextBox Text="{Binding ExportPreview, Mode=OneWay}" Height="60" AcceptsReturn="True" IsReadOnly="True" Margin="0,6,0,0" FontFamily="Consolas" FontSize="11"/>
    </StackPanel>
  </Grid>
</UserControl>
