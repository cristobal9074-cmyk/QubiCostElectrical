<UserControl x:Class="QubiCostElectrical.Wpf.Features.ProcurementDashboard.ProcurementDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Dashboard de compras" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Presupuesto, solicitado, cotizado, adjudicado, comprometido, recibido, saldo, forecast y alertas." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="Presupuesto base:" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <TextBox Text="{Binding BudgetAmount}" Width="120" Margin="0,0,12,6"/>
      <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Guardar snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,6,6" Padding="10,6" Background="#2563EB" Foreground="White"/>
    </WrapPanel>
    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
      <Border Background="White" Padding="12" Margin="0,0,8,8" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Presupuesto" Foreground="#6B7280"/>
          <TextBlock Text="{Binding Summary.BudgetAmount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Background="White" Padding="12" Margin="0,0,8,8" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Comprometido" Foreground="#6B7280"/>
          <TextBlock Text="{Binding Summary.CommittedAmount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Background="White" Padding="12" Margin="0,0,8,8" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Recibido" Foreground="#6B7280"/>
          <TextBlock Text="{Binding Summary.ReceivedAmount, StringFormat=N0}" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Background="White" Padding="12" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Saldo / Forecast" Foreground="#6B7280"/>
          <TextBlock FontSize="18" FontWeight="SemiBold">
            <Run Text="{Binding Summary.BalanceAmount, StringFormat=N0}"/>
            <Run Text=" / "/>
            <Run Text="{Binding Summary.ForecastAmount, StringFormat=N0}"/>
          </TextBlock>
        </StackPanel>
      </Border>
    </UniformGrid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Severidad" Binding="{Binding Severity}" Width="Auto"/>
          <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="Auto"/>
          <DataGridTextColumn Header="Mensaje" Binding="{Binding Message}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Column="1" ItemsSource="{Binding Suppliers}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierId.Value}" Width="*"/>
          <DataGridTextColumn Header="Comprometido" Binding="{Binding CommittedBase}" Width="*"/>
          <DataGridTextColumn Header="Atrasos" Binding="{Binding LateDeliveries}" Width="Auto"/>
          <DataGridTextColumn Header="Score" Binding="{Binding PerformanceScore}" Width="Auto"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
