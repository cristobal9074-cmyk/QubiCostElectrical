<UserControl x:Class="QubiCostElectrical.Wpf.Features.Purchases.PurchaseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             KeyDown="OnUserControlKeyDown">
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportExcelCommand}" />
  </UserControl.InputBindings>
  <Grid Background="{DynamicResource Brush.Canvas}"
        HorizontalAlignment="Stretch">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z M3 6h18 M16 10a4 4 0 0 1-8 0"
                            Title="{Binding EmptyStateTitle}"
                            Description="{Binding EmptyStateDescription}">
      <ctrl:EmptyStateControl.Actions>
        <WrapPanel HorizontalAlignment="Center">
          <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" Margin="4"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
          <Button Style="{StaticResource Button.Primary}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="4" MinWidth="140"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource Button.Secondary}" Content="Exportar Excel" Command="{Binding ExportExcelCommand}" Margin="4" MinWidth="140"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="540" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="360" MinWidth="300" MaxWidth="480" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Lista de compra" Style="{StaticResource Text.ViewTitle}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource Button.Secondary}" Content="Agrupar por proveedor"
                    Command="{Binding GroupByProviderCommand}" Margin="0,0,6,0"
                    ToolTip="Agrupa por proveedor; si no hay proveedor, usa categoría." />
            <Button Style="{StaticResource Button.Secondary}" Content="Actualizar (F5)" Command="{Binding RefreshCommand}" Margin="0,0,6,0"
                    ToolTip="Recargar y consolidar lista de compras viva desde la cubicación (F5)" />
            <Button Style="{StaticResource Button.Secondary}" Content="Solicitud RFQ (.xlsx)" Command="{Binding ExportRfqCommand}" Margin="0,0,6,0"
                    ToolTip="Exportar planilla de cotización para enviar por email a distribuidores (sin costos internos)." />
            <Button Style="{StaticResource Button.Primary}" Content="Exportar Excel (Ctrl+E)" Command="{Binding ExportExcelCommand}"
                    ToolTip="Exportar lista de compras consolidada a Excel (Ctrl+E)" />
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card.Section}" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
              <TextBox x:Name="SearchBox"
                       Style="{StaticResource Form.SearchBox}"
                       Tag="Buscar material, código o categoría… (Ctrl+F)"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Padding="26,4,24,4" />
              <TextBlock Text="🔍"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.Muted}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Margin="8,0,0,0"
                         IsHitTestVisible="False" />
              <Button Style="{StaticResource Button.Ghost}"
                      Content="✕"
                      Padding="0"
                      Width="18" Height="18"
                      FontSize="10"
                      FontWeight="Bold"
                      Foreground="{DynamicResource Brush.Muted}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0"
                      Command="{Binding ClearSearchCommand}"
                      Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Limpiar búsqueda (Esc)" />
            </Grid>

            <ComboBox Grid.Column="1" Style="{StaticResource Form.ComboBox}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,8,0"
                      ToolTip="Filtrar por categoría" />

            <StackPanel Grid.Column="2" Margin="0,0,8,0">
              <TextBlock Text="Tolerancia compra" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
              <Slider Minimum="0" Maximum="50" Value="{Binding ToleranciaPct}" TickFrequency="5" IsSnapToTickEnabled="False" />
            </StackPanel>

            <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}"
                    ToolTip="Restablecer búsqueda y categoría (Esc)" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Proyecto" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ProjectSummary}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Lista" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Tolerancia" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ToleranciaPct, StringFormat={}{0:N1}%}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Estado" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Grid.Column="4" Text="La lista consolida compras desde la cubicación viva. Seleccione un material para ver sus partidas de origen."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True">
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,6,4,2"
                             Foreground="{DynamicResource Brush.Ink2}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110" />
            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="220" />
            <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="50" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120" />
            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="120" />
            <DataGridTextColumn Header="Cant. neta" Binding="{Binding CantidadNeta, StringFormat={}{0:N0}}" Width="85"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn Header="Tol. %" Binding="{Binding ToleranciaPct, StringFormat={}{0:N1}}" Width="70"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn Header="Cant. compra" Binding="{Binding CantidadCompra, StringFormat={}{0:N0}}" Width="95"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn x:Name="PrecioUfColumn" Header="Precio UF" Binding="{Binding MatUfUnitario, StringFormat={}{0:N4}}" Width="85"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn Header="P. Unit CLP" Binding="{Binding MatClpUnitario, StringFormat={}$ {0:N0}}" Width="90"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn x:Name="NetoUfColumn" Header="Neto UF" Binding="{Binding TotalNetoUf, StringFormat={}{0:N3}}" Width="90"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn x:Name="CompraUfColumn" Header="Compra UF" Binding="{Binding TotalCompraUf, StringFormat={}{0:N3}}" Width="90"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn Header="Total CLP" Binding="{Binding TotalCompraClp, StringFormat={}$ {0:N0}}" Width="95"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
            <DataGridTextColumn Header="Líneas" Binding="{Binding Lineas}" Width="60"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource Text.Numeric.Right}" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Haga clic en un material para ver su trazabilidad exacta en las partidas del presupuesto a la derecha."
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" />
      </Grid>
    </Border>

    <!-- Panel Lateral: Trazabilidad viva ("¿Dónde se usa este material?") -->
    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Text="Trazabilidad en obra" Style="{StaticResource Text.SectionLabel}" />
          <TextBlock Text="¿Dónde se usa este material?" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding SelectedMaterialHeader}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedMaterialTotalText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" Margin="0,2,0,0"
                     Visibility="{Binding HasSelectedUsage, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Estado sin selección -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Md}" Padding="20"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                Visibility="{Binding HasSelectedUsage, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.BlueSoft}"
                    BorderBrush="{DynamicResource Brush.BlueFocus}" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,10">
              <Path Data="{StaticResource Geo.Search}" Stroke="{DynamicResource Brush.Blue}"
                    Style="{StaticResource Icon.Vector}" Width="16" Height="16" />
            </Border>
            <TextBlock Text="Seleccione un material" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Haga clic en cualquier fila de la lista para ver el desglose de partidas y áreas donde se utiliza."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Lista de usos en partidas -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding MaterialUsages}"
                  SelectedItem="{Binding SelectedUsage, Mode=TwoWay}"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Visibility="{Binding HasSelectedUsage, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.InputBindings>
            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding GoToUsageCommand}" />
          </DataGrid.InputBindings>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Ítem" Binding="{Binding ItemNumber}" Width="55" />
            <DataGridTextColumn Header="Partida" Binding="{Binding PartidaDescripcion}" Width="*" MinWidth="130">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding PartidaDescripcion}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding Area}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat={}{0:N1}}" Width="60" />
            <DataGridTextColumn Header="% Total" Binding="{Binding PorcentajeDelTotal, StringFormat={}{0:N1}%}" Width="65" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Acción de navegación directa -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True"
                   Visibility="{Binding HasSelectedUsage, Converter={StaticResource BoolToVisibility}}">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Ir a cubicación →"
                  Command="{Binding GoToUsageCommand}" />
          <TextBlock Text="Doble clic para editar partida" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
        </DockPanel>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
