<UserControl x:Class="QubiCostElectrical.Wpf.Features.Purchases.PurchaseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls">
  <Grid Background="{DynamicResource Brush.Canvas}"
        HorizontalAlignment="Stretch">
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="{Binding EmptyStateTitle}"
                            Description="{Binding EmptyStateDescription}">
      <ctrl:EmptyStateControl.Actions>
        <WrapPanel HorizontalAlignment="Center">
          <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" Margin="4"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
          <Button Style="{StaticResource Button.Primary}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="4" MinWidth="140"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource Button.Secondary}" Content="Exportar Excel" Command="{Binding ExportExcelCommand}" Margin="4" MinWidth="140"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="640" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Lista de compra" Style="{StaticResource Text.ViewTitle}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource Button.Secondary}" Content="Agrupar por proveedor"
                    Command="{Binding GroupByProviderCommand}" Margin="0,0,6,0"
                    ToolTip="Agrupa por proveedor; si no hay proveedor, usa categoría." />
            <Button Style="{StaticResource Button.Secondary}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
            <Button Style="{StaticResource Button.Primary}" Content="Exportar Excel" Command="{Binding ExportExcelCommand}" />
          </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card.Section}" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Form.SearchBox}" Tag="Buscar material, código o categoría…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />

            <ComboBox Grid.Column="1" Style="{StaticResource Form.ComboBox}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,8,0" />

            <StackPanel Grid.Column="2" Margin="0,0,8,0">
              <TextBlock Text="Tolerancia compra" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
              <Slider Minimum="0" Maximum="50" Value="{Binding ToleranciaPct}" TickFrequency="5" IsSnapToTickEnabled="False" />
            </StackPanel>

            <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Proyecto" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ProjectSummary}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Lista" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Tolerancia" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding ToleranciaPct, StringFormat={}{0:N1}%}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card.StatPill}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="Estado" Style="{StaticResource Text.Caption}" />
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Grid.Column="4" Text="La lista excluye mano de obra, equipos y herramientas. Se consolida por código/material y se actualiza desde la cubicación."
                       Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding FilteredRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ScrollViewer.CanContentScroll="True">
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,6,4,2"
                             Foreground="{DynamicResource Brush.Ink2}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="260" />
            <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="60" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="140" />
            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="140" />
            <DataGridTextColumn Header="Cant. neta" Binding="{Binding CantidadNeta, StringFormat={}{0:N2}}" Width="95" />
            <DataGridTextColumn Header="Tol. %" Binding="{Binding ToleranciaPct, StringFormat={}{0:N1}}" Width="80" />
            <DataGridTextColumn Header="Cant. compra" Binding="{Binding CantidadCompra, StringFormat={}{0:N2}}" Width="100" />
            <DataGridTextColumn Header="Precio UF" Binding="{Binding MatUfUnitario, StringFormat={}{0:N4}}" Width="95" />
            <DataGridTextColumn Header="P. Unit CLP" Binding="{Binding MatClpUnitario, StringFormat={}$ {0:N0}}" Width="95" />
            <DataGridTextColumn Header="Neto UF" Binding="{Binding TotalNetoUf, StringFormat={}{0:N3}}" Width="100" />
            <DataGridTextColumn Header="Compra UF" Binding="{Binding TotalCompraUf, StringFormat={}{0:N3}}" Width="100" />
            <DataGridTextColumn Header="Total CLP" Binding="{Binding TotalCompraClp, StringFormat={}$ {0:N0}}" Width="105" />
            <DataGridTextColumn Header="Líneas" Binding="{Binding Lineas}" Width="70" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Use esta pantalla para consolidar recursos comprables y exportar la lista final sin abandonar el shell principal."
                   Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" />
      </Grid>
    </Border>
    </Grid>
  </Grid>
</UserControl>
