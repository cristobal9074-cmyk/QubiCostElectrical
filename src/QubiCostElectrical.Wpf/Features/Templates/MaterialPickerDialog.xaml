<Window x:Class="QubiCostElectrical.Wpf.Features.Templates.MaterialPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Seleccionar Material del Banco de Precios"
        Width="750" Height="480" MinWidth="600" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Resources>
    <!-- Estilo de alineación derecha para el precio en el DataGrid -->
    <Style x:Key="RightAlignText" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header del Diálogo -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
      <Border Style="{StaticResource Dialog.HeaderIconContainer}" DockPanel.Dock="Left">
        <Path Data="M 21 8 a 2 2 0 0 0 -1 -1.73 l -7 -4 a 2 2 0 0 0 -2 0 l -7 4 A 2 2 0 0 0 3 8 v 8 a 2 2 0 0 0 1 1.73 l 7 4 a 2 2 0 0 0 2 0 l 7 -4 A 2 2 0 0 0 21 16 Z M 3.27 6.96 L 12 12.01 l 8.73 -5.05 M 12 22.08 V 12"
              Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Seleccionar Material del Banco de Precios" Style="{StaticResource Dialog.HeaderTitle}"/>
        <TextBlock Text="Busca y selecciona uno o más materiales para agregarlos al catálogo activo." Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0"/>
      </StackPanel>
    </DockPanel>

    <!-- Área de Trabajo -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Cuadro de Búsqueda -->
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <TextBox x:Name="SearchBox"
                 Style="{StaticResource Form.TextBox}"
                 Padding="34,8,12,8" FontSize="{StaticResource Font.Size.md}"
                 TextChanged="SearchBox_TextChanged"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
        <Path Data="M 21 21 l -4.35 -4.35 M 19 11 A 8 8 0 1 1 3 11 a 8 8 0 0 1 16 0 Z"
              Stroke="{DynamicResource Brush.Ink4}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Width="14" Height="14" Stretch="Uniform"
              VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left"
              IsHitTestVisible="False" />
        
        <!-- Hint visible cuando está vacío -->
        <TextBlock Text="Buscar por código o descripción en el catálogo..." 
                   VerticalAlignment="Center" Margin="34,0,0,0" FontSize="{StaticResource Font.Size.md}" 
                   Foreground="{DynamicResource Brush.Ink4}" Opacity="0.6" 
                   HorizontalAlignment="Left" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- DataGrid de Materiales con Estilo del Sistema de Diseño -->
      <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}">
        <DataGrid x:Name="MaterialsGrid"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserResizeRows="False"
                  MouseDoubleClick="MaterialsGrid_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="130" HeaderStyle="{StaticResource DataGridColumnHeader.Base}"/>
            <DataGridTextColumn Header="Descripción del Material" Binding="{Binding Descripcion}" Width="*" HeaderStyle="{StaticResource DataGridColumnHeader.Base}"/>
            <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="60" HeaderStyle="{StaticResource DataGridColumnHeader.Center}"/>
            <DataGridTextColumn Header="Precio $" Binding="{Binding MatClp, StringFormat=N0}" Width="110" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" ElementStyle="{StaticResource RightAlignText}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <!-- Footer con Botones Estilizados: Primario a la derecha, Secundario a su izquierda -->
    <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}">
      <Button x:Name="BtnSeleccionar" Content="Agregar Seleccionados"
              Style="{StaticResource Button.Primary}"
              MinWidth="160" Height="34" DockPanel.Dock="Right"
              IsDefault="True"
              Click="BtnSeleccionar_Click"/>
      <Button Content="Cancelar"
              Style="{StaticResource Button.Secondary}"
              MinWidth="100" Height="34" DockPanel.Dock="Right" Margin="0,0,10,0"
              IsCancel="True"/>
    </DockPanel>
  </Grid>
  </Border>
</Window>
