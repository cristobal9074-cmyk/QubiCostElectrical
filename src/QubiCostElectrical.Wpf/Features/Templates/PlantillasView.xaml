<UserControl x:Class="QubiCostElectrical.Wpf.Features.Templates.PlantillasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Templates"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateConjuntoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteRecursoCommand}" CommandParameter="{Binding SelectedItem, ElementName=ResourcesGrid}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <infra:MaestroRecursoIdConverter x:Key="MaestroRecursoIdConverter"/>
        <Style x:Key="GlassHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card.Kpi}">
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        </Style>
        <Style x:Key="SidebarCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.06" Color="#000000" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="BadgeAmber" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>
        <Style x:Key="BadgeBlue" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>
        <Style x:Key="BlueColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
            Background="{DynamicResource Brush.Surface}"
            CornerRadius="12" Margin="30"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="400" Padding="40">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Carga un proyecto para empezar"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Ink}"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Las plantillas de materiales para cubicación se guardan y gestionan dentro de cada proyecto eléctrico (.qce)."
                   FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource GlassHeader}" Margin="16,16,16,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="PLANTILLAS DE MATERIALES" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Diseña y organiza conjuntos de materiales listos para cargar en tu hoja de cubicación." Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"
                                   FontSize="11" Foreground="{DynamicResource Brush.Ink3}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="＋ Nueva Plantilla"
                                Command="{Binding CreateConjuntoCommand}"
                                Style="{DynamicResource Button.Primary}"
                                Height="34" Padding="16,0" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Height="0"/>

            <TabControl Style="{StaticResource Form.TabControl}" Margin="16,0,16,16" Grid.Row="2">
                <TabItem Header="Plantillas">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="240"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SidebarCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card.LeftPanelHeader}">
                                    <TextBlock Text="LISTA DE PLANTILLAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"/>
                                </Border>

                                <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBox x:Name="SearchBox"
                                                 Text="{Binding ConjuntoFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="28,6,24,6" FontSize="12"
                                                 Background="{DynamicResource Brush.Surface2}"
                                                 BorderBrush="{DynamicResource Brush.Line}"
                                                 BorderThickness="1">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Resources>
                                                        <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Buscar plantilla..." Foreground="{DynamicResource Brush.Muted}" FontSize="12" Margin="28,0,0,0" Opacity="0.7"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Style.Resources>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                        <Button Command="{Binding ClearFilterCommand}"
                                                Content="✕" FontSize="10" FontWeight="Bold"
                                                Width="18" Height="18" Padding="0"
                                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource Brush.Muted}"
                                                Cursor="Hand" ToolTip="Limpiar filtro"
                                                Visibility="{Binding ConjuntoFilter, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding Conjuntos}"
                                         SelectedItem="{Binding SelectedConjunto}"
                                         ItemContainerStyle="{StaticResource ListItem}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         Padding="0,4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Codigo}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Ink}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding RecursoCount, StringFormat={}{0} materiales}"
                                                               FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                                                    <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                                                    <TextBlock Text="{Binding Unidad, StringFormat=Unidad: {0}}"
                                                               FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <Grid Grid.Column="2">
                            <Border Visibility="{Binding SelectedConjunto, Converter={StaticResource NullToVisibility}}"
                                    Style="{StaticResource DetailCard}" Padding="40">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                                    <TextBlock Text="Selecciona una plantilla de la lista"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Ink}"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="O haz clic en '+ Nueva Plantilla' para crear una lista de materiales en blanco y personalizarla."
                                               FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <Border Visibility="{Binding SelectedConjunto, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}"
                                    Style="{StaticResource DetailCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 4: DataGrid (star) -->

                                    <Border Grid.Row="0" Style="{StaticResource Card.Header}" Padding="16,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBox Text="{Binding SelectedConjunto.Codigo, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="11" FontWeight="Bold"
                                                          Foreground="{DynamicResource Brush.Blue}"
                                                          Background="{DynamicResource Brush.BlueSoft}"
                                                          BorderBrush="{DynamicResource Brush.BlueFaint}"
                                                           BorderThickness="1"
                                                           Padding="6,4" Width="90" Margin="0,0,12,0" VerticalAlignment="Center"
                                                           ToolTip="Código de la plantilla"/>
                                                <TextBox Text="{Binding SelectedConjunto.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="16" FontWeight="ExtraBold"
                                                          Foreground="{DynamicResource Brush.Ink}"
                                                          Background="Transparent" BorderThickness="0"
                                                          Padding="0,4" MinWidth="200" VerticalAlignment="Center"
                                                          ToolTip="Nombre de la plantilla"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Duplicar" Command="{Binding DuplicateConjuntoCommand}"
                                                        CommandParameter="{Binding SelectedConjunto}"
                                                        Style="{DynamicResource Button.Ghost}"
                                                        Height="28" Padding="10,0" Margin="0,0,6,0" FontSize="11"/>
                                                <Button Content="Eliminar" Command="{Binding DeleteConjuntoCommand}"
                                                        CommandParameter="{Binding SelectedConjunto}"
                                                        Style="{DynamicResource Button.Ghost}"
                                                        Height="28" Padding="10,0" FontSize="11"
                                                        Foreground="{DynamicResource Brush.Muted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource Brush.BlueSoft}"
                                            BorderBrush="{DynamicResource Brush.BlueFaint}" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap">
                                                <Run FontWeight="Bold">Factor</Run>
                                                <Run>= Base x Factor &#x2003;&#x2502;&#x2003;</Run>
                                                <Run FontWeight="Bold">Cada N m</Run>
                                                <Run>= Ceil(Base / Paso) &#x2003;&#x2502;&#x2003;</Run>
                                                <Run FontWeight="Bold">F&#xF3;rmula</Run>
                                                <Run>= expresi&#xF3;n con MAESTRO &#x2003;&#x2502;&#x2003;</Run>
                                                <Run FontWeight="Bold">&#x2B50; Maestro</Run>
                                                <Run>= recurso base; los esclavos lo siguen</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.AmberSoft}"
                                            BorderBrush="{DynamicResource Brush.AmberLight}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#x2B50; MAESTROS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center"/>
                                                <TextBlock Text=" — Los maestros definen el orden. Los esclavos calculan su cantidad en base al maestro."
                                                           FontSize="10" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <WrapPanel Orientation="Horizontal">
                                                <ItemsControl ItemsSource="{Binding MaestroRecursoList}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Amber}"
                                                                    BorderThickness="2" CornerRadius="20" Padding="8,4,10,4" Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#x2B50;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Codigo}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Descripcion}" FontSize="10" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="＋ Agregar Maestro" Command="{Binding AddAnotherMaestroCommand}"
                                                        Style="{DynamicResource Button.Ghost}"
                                                        Height="26" Padding="10,0" Margin="0,0,0,6"
                                                        FontSize="10" BorderBrush="{DynamicResource Brush.Amber}"
                                                        Foreground="{DynamicResource Brush.Amber}"
                                                        HorizontalAlignment="Left" BorderThickness="1.5"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3" Padding="14,6" Background="{DynamicResource Brush.RedSoft}"
                                            BorderBrush="{DynamicResource Brush.Red}" BorderThickness="0,0,0,1"
                                            Visibility="{Binding HasOrphanedSlaves, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding OrphanedWarning}" FontSize="11" Foreground="{DynamicResource Brush.Red}" FontWeight="SemiBold"/>
                                    </Border>

                                    <Grid Grid.Row="4" Margin="0">
                                        <DataGrid x:Name="ResourcesGrid"
                                                  ItemsSource="{Binding ConjuntoRecursos}"
                                                  AutoGenerateColumns="False" IsReadOnly="False"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column"
                                                  CanUserResizeRows="False" CanUserAddRows="False"
                                                  SelectionMode="Single"
                                                  FontSize="12" BorderThickness="0" Background="Transparent"
                                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Standard"
                                                  ScrollViewer.CanContentScroll="False"
                                                  Style="{StaticResource DataGrid.Workspace}">
                                            <DataGrid.Columns>
                                                <DataGridComboBoxColumn Header="Tipo" Width="60"
                                                                        SelectedItemBinding="{Binding Tipo}">
                                                    <DataGridComboBoxColumn.ElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:PlantillasView.ApuTiposRecurso}}"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.ElementStyle>
                                                    <DataGridComboBoxColumn.EditingElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:PlantillasView.ApuTiposRecurso}}"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.EditingElementStyle>
                                                </DataGridComboBoxColumn>

                                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" Width="85"/>

                                                <DataGridTextColumn Header="Descripción del Material" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" Width="*"/>

                                                <DataGridTextColumn Header="Ud." Binding="{Binding Unidad, UpdateSourceTrigger=LostFocus}" Width="40"/>

                                                <DataGridCheckBoxColumn Header="&#x2B50; Maestro" Width="80"
                                                                        Binding="{Binding EsMaestro, UpdateSourceTrigger=PropertyChanged}">
                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                </DataGridCheckBoxColumn>

                                                <DataGridTemplateColumn Header="Sigue a Maestro" Width="140">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <ComboBox x:Name="Selector"
                                                                          ItemsSource="{Binding DataContext.MaestroRecursoList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                          SelectedValue="{Binding MaestroRecursoId, Mode=OneWay}"
                                                                          SelectedValuePath="Id"
                                                                          DisplayMemberPath="MaestroDisplayName"
                                                                          BorderThickness="0" Background="Transparent"
                                                                          FontSize="11" IsEditable="False"
                                                                          IsHitTestVisible="False" Focusable="False"/>
                                                                <TextBlock x:Name="MasterLabel" Text="&#x2B50; Recurso Maestro"
                                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}"
                                                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                                                    <Setter TargetName="Selector" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="MasterLabel" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.MaestroRecursoList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                      SelectedValue="{Binding MaestroRecursoId, Mode=TwoWay, Converter={StaticResource MaestroRecursoIdConverter}}"
                                                                      SelectedValuePath="Id"
                                                                      DisplayMemberPath="MaestroDisplayName"
                                                                      BorderThickness="0" FontSize="11" IsEditable="False"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTemplateColumn Header="Lógica" Width="70" HeaderStyle="{StaticResource BlueColumnHeader}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding FormulaOperator}" FontFamily="Consolas"
                                                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Ink}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding Source={x:Static local:ConjuntoRecursoVm.LogicaOptions}}"
                                                                      Text="{Binding FormulaOperator, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEditable="True" IsTextSearchEnabled="False"
                                                                      FontFamily="Consolas" FontSize="11" BorderThickness="0"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Factor" Width="70" HeaderStyle="{StaticResource BlueColumnHeader}"
                                                                   Binding="{Binding Factor, UpdateSourceTrigger=LostFocus, StringFormat=N2}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="Consolas"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                            <Setter Property="Margin" Value="0,0,4,0"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Header="F&#xF3;rmula" Width="160" HeaderStyle="{StaticResource BlueColumnHeader}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4"
                                                                    Background="{DynamicResource Brush.BlueSoft}"
                                                                    Padding="6,2" Margin="2,0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding FormulaAuto}" FontFamily="Consolas"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.Blue}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMaster}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}"/>
                                                            <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                            <Setter Property="ToolTip" Value="Recurso Maestro — los esclavos siguen su cantidad"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSlave}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}"/>
                                                            <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                            <Setter Property="ToolTip" Value="Recurso Esclavo — su cantidad se calcula desde el Maestro"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}"/>
                                                            <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                            <Setter Property="ToolTip" Value="{Binding ValidationErrors}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                        </DataGrid>
                                    </Grid>

                                    <Border Grid.Row="6" Padding="12,8"
                                            Background="{DynamicResource Brush.Surface2}"
                                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Total:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"/>
                                                <TextBlock Text="{Binding SelectedConjunto.RecursoCount, StringFormat={}{0} materiales}"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="6,0,16,0"/>
                                                <Border Style="{StaticResource BadgeAmber}" Margin="0,0,8,0">
                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}">
                                                        <Run Text="&#x2B50; Maestros:"/><Run Text="{Binding MaestroCount, Mode=OneWay, StringFormat={} {0}}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource BadgeBlue}" Margin="0,0,16,0">
                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}">
                                                        <Run Text="Esclavos:"/><Run Text="{Binding SlaveCount, Mode=OneWay, StringFormat={} {0}}"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="Unidad:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0"/>
                                                <TextBox Text="{Binding SelectedConjunto.Unidad, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                                                          Background="Transparent" BorderThickness="0" Padding="2,0" Width="36"/>
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="⬆" Command="{Binding MoveRecursoUpCommand}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=ResourcesGrid}"
                                                        Style="{DynamicResource Button.Ghost}"
                                                        Height="26" Width="26" Padding="0" Margin="0,0,3,0" FontSize="11"/>
                                                <Button Content="⬇" Command="{Binding MoveRecursoDownCommand}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=ResourcesGrid}"
                                                        Style="{DynamicResource Button.Ghost}"
                                                        Height="26" Width="26" Padding="0" Margin="0,0,8,0" FontSize="11"/>
                                                <Button Content="＋ Agregar Material" Command="{Binding AddRecursoCommand}"
                                                        Style="{DynamicResource Button.Ghost}" Height="26"
                                                        Padding="10,0" Margin="0,0,6,0" FontSize="11"
                                                        Foreground="{DynamicResource Brush.Blue}" FontWeight="Bold"/>
                                                <Button Content="✕ Eliminar" Command="{Binding DeleteRecursoCommand}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=ResourcesGrid}"
                                                        Style="{DynamicResource Button.Ghost}" Height="26"
                                                        Padding="10,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
