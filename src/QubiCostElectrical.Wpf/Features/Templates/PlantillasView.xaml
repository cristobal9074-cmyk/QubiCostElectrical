<UserControl x:Class="QubiCostElectrical.Wpf.Features.Templates.PlantillasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Templates"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- Custom styling tokens -->
        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- Custom ListBoxItem Style for a glassmorphic sidebar item -->
        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="Indicator" Text="➔" Grid.Column="1" Foreground="{DynamicResource Brush.Blue}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="Indicator" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat boxes styles -->
        <Style x:Key="StatTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
        </Style>

        <!-- Right-aligned style for DataGrid -->
        <Style x:Key="RightAlignText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <!-- Empty state when no project or store is loaded -->
        <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
            Background="{DynamicResource Brush.Surface}"
            CornerRadius="12" Margin="30"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="400" Padding="40">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Carga un proyecto para empezar"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Ink}"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Las plantillas de materiales para cubicación se guardan y gestionan dentro de cada proyecto eléctrico (.qce)."
                   FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="95.56"/>
                <RowDefinition Height="Auto" MinHeight="16"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- View header (App style of 20 Billion USD) -->

            <!-- Stats Cards (Glassmorphism look) -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="16,0,16,16">
                <!-- Card 1: Total plantillas -->

                <!-- Card 2: Total recursos -->

                <!-- Card 3: Estado de edición -->
            </UniformGrid>

            <!-- Main Layout Splitter wrapped in Form.TabControl -->
            <TabControl Style="{StaticResource Form.TabControl}" Margin="16,65,16,16" Grid.RowSpan="3">
                <TabItem Header="Plantillas ">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="240"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel izquierdo: Listado de plantillas -->
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112*"/>
                                    <ColumnDefinition Width="37*"/>
                                    <ColumnDefinition Width="129*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource PanelHeader}" Margin="0,-23,0,0" Grid.ColumnSpan="3">
                                    <TextBlock Text="MIS LISTAS DE PLANTILLAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"/>
                                </Border>

                                <!-- Buscador premium -->
                                <Border Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Grid.ColumnSpan="3">
                                    <Grid>
                                        <TextBox Text="{Binding ConjuntoFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="28,6,8,6" FontSize="12"
                             Background="{DynamicResource Brush.Surface2}"
                             BorderBrush="{DynamicResource Brush.Line}"
                             BorderThickness="1">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Resources>
                                                        <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Buscar plantilla..." Foreground="{DynamicResource Brush.Muted}" FontSize="12" Margin="28,0,0,0" Opacity="0.7"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Style.Resources>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <!-- Icono de búsqueda -->
                                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                                <!-- Listbox de plantillas -->
                                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Conjuntos}"
                         SelectedItem="{Binding SelectedConjunto}"
                         ItemContainerStyle="{StaticResource ListItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Padding="0,6" Grid.ColumnSpan="3">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Codigo}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Nombre}"
                                     FontSize="12" FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.Ink}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding RecursoCount, StringFormat={}{0} materiales}"
                                     FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                                                    <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                                                    <TextBlock Text="{Binding Unidad, StringFormat=Unidad: {0}}"
                                     FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Grid Splitter -->
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Panel derecho: Diseñador / Detalle -->
                        <Grid Grid.Column="2">
                            <!-- Vista sin selección -->
                            <Border Visibility="{Binding SelectedConjunto, Converter={StaticResource NullToVisibility}}"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      CornerRadius="10" Padding="40">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                                    <TextBlock Text="Selecciona una plantilla de la lista"
                             FontSize="16" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Ink}"
                             HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="O haz clic en '+ Nueva Plantilla' para crear una lista de materiales en blanco y personalizarla."
                             FontSize="12" Foreground="{DynamicResource Brush.Muted}"
                             TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                                </StackPanel>
                            </Border>

                            <!-- Detalle de la plantilla seleccionada -->
                            <Border Visibility="{Binding SelectedConjunto, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}"
                      Background="{DynamicResource Brush.Surface}"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Encabezado de Detalle -->
                                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}" Margin="0,-24,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Título y Código editables -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBox Text="{Binding SelectedConjunto.Codigo, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Blue}"
                                 Background="{DynamicResource Brush.Surface2}"
                                 BorderBrush="{DynamicResource Brush.Line}"
                                 Padding="6,4" Width="691" Margin="0,0,12,0" VerticalAlignment="Center"
                                 ToolTip="Código de la plantilla (editable)"/>

                                                <TextBox Text="{Binding SelectedConjunto.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" FontWeight="ExtraBold"
                                 Foreground="{DynamicResource Brush.Ink}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,4" MinWidth="250" MaxWidth="500" VerticalAlignment="Center"
                                 ToolTip="Nombre de la plantilla (editable)"/>
                                            </StackPanel>

                                            <!-- Botones de Acción de la Plantilla -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Duplicar"
                                Command="{Binding DuplicateConjuntoCommand}"
                                CommandParameter="{Binding SelectedConjunto}"
                                Style="{DynamicResource Button.Secondary}"
                                Height="28" Padding="12,0" Margin="0,0,8,0"/>
                                                <Button Content="Eliminar"
                                Command="{Binding DeleteConjuntoCommand}"
                                CommandParameter="{Binding SelectedConjunto}"
                                Style="{DynamicResource Button.Secondary}"
                                Height="28" Padding="12,0" Foreground="{DynamicResource Brush.Muted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Parámetros Globales de la Plantilla (Merma, Imprevistos, etc.) -->

                                    <!-- Banner explicativo de reglas parametricas -->
                                    <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource Brush.BlueSoft}"
                          BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x26A1;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap">
                        <Run FontWeight="Bold">Tipo C&#xE1;lculo:</Run>
                        <Run>Factor = Cantidad&#xD7;Factor&#x2003;&#x2502;&#x2003;Cada N m = &#x2308;Cantidad&#xF7;Paso&#x2309;&#x2003;(ej. soporte cada 1.5 m &#x2192; 1000 m / 1.5 = 667 UN)</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tabla Principal de Materiales -->
                                    <Grid Grid.Row="3">
                                        <DataGrid x:Name="ResourcesGrid"
                              ItemsSource="{Binding ConjuntoRecursos}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              FontSize="12"
                              BorderThickness="0"
                              Background="Transparent"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Style="{StaticResource DataGrid.Workspace}">
                                            <DataGrid.Columns>
                                                <!-- Tipo de Recurso -->
                                                <DataGridComboBoxColumn Header="Tipo" Width="70" 
                                                SelectedItemBinding="{Binding Tipo}">
                                                    <DataGridComboBoxColumn.ElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:PlantillasView.ApuTiposRecurso}}"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.ElementStyle>
                                                    <DataGridComboBoxColumn.EditingElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:PlantillasView.ApuTiposRecurso}}"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.EditingElementStyle>
                                                </DataGridComboBoxColumn>

                                                <!-- Código -->
                                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>

                                                <!-- Descripción -->
                                                <DataGridTextColumn Header="Descripción del Material" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                                                <!-- Unidad -->
                                                <DataGridTextColumn Header="Ud." Binding="{Binding Unidad, UpdateSourceTrigger=PropertyChanged}" Width="50"/>

                                                <!-- Tipo de Calculo Parametrico -->
                                                <DataGridComboBoxColumn Header="Tipo C&#xE1;lculo" Width="130"
                                                SelectedItemBinding="{Binding TipoCalculo}">
                                                    <DataGridComboBoxColumn.ElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:PlantillasView.TiposCalculo}}"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="ToolTip" Value="Factor: Cant = Base x Factor | Cada N m: Cant = Ceil(Base / Paso)"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.ElementStyle>
                                                    <DataGridComboBoxColumn.EditingElementStyle>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="ItemsSource" Value="{Binding Source={x:Static local:PlantillasView.TiposCalculo}}"/>
                                                        </Style>
                                                    </DataGridComboBoxColumn.EditingElementStyle>
                                                </DataGridComboBoxColumn>

                                                <!-- Paso (m) / Factor -->
                                                <DataGridTextColumn Header="Paso (m) / Factor"
                                            Binding="{Binding Espaciamiento, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            Width="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Padding" Value="0,0,8,0"/>
                                                            <Setter Property="ToolTip" Value="Factor: multiplicador sobre la cantidad base.&#x0a;Cada N metros: metros entre unidades (ej. 1.5 = soporte cada 1.5 m)."/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>

                                    <!-- Footer de la tabla con acciones rápidas -->
                                    <Border Grid.Row="4" Padding="14,10"
                          Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}"
                          BorderThickness="0,1,0,0">
                                        <DockPanel LastChildFill="False">
                                            <!-- Métricas rápidas a la izquierda -->
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Total:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"/>
                                                <TextBlock Text="{Binding SelectedConjunto.RecursoCount, StringFormat={}{0} materiales}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="6,0,16,0"/>

                                                <TextBlock Text="Unidad de salida:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"/>
                                                <TextBox Text="{Binding SelectedConjunto.Unidad, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                                 Background="Transparent" BorderThickness="0" Padding="2,0" Margin="6,0,0,0" Width="40"
                                 ToolTip="Unidad del conjunto completo (editable)"/>
                                            </StackPanel>

                                            <!-- Acciones de edición de tabla a la derecha -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="＋ Agregar Material"
                                Command="{Binding AddRecursoCommand}"
                                Style="{DynamicResource Button.Secondary}"
                                Height="28" Padding="12,0" Margin="0,0,8,0"
                                Background="{DynamicResource Brush.BlueSoft}"
                                BorderBrush="{DynamicResource Brush.Blue}"
                                Foreground="{DynamicResource Brush.Blue}"/>

                                                <Button Content="✕ Eliminar Seleccionado"
                                Command="{Binding DeleteRecursoCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=ResourcesGrid}"
                                Style="{DynamicResource Button.Secondary}"
                                Height="28" Padding="12,0"
                                Foreground="{DynamicResource Brush.Muted}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Margin="0,0,0,118" Height="60">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="PLANTILLAS DE MATERIALES" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.Ink}" RenderTransformOrigin="0.497,-0.213" Height="13" Margin="0,10,0,10"/>
                        <TextBlock Text="Diseña y organiza conjuntos de materiales listos para cargar en tu hoja de cubicación."
                       FontSize="12" Foreground="{DynamicResource Brush.Muted}" RenderTransformOrigin="0.888,0.025" Height="35" Padding="2,6,0,0" Width="488" Margin="0,-5,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource Button.Primary}" Content="＋ Nueva Plantilla" Command="{Binding CreateConjuntoCommand}" Padding="16,8" Height="36" FontWeight="Bold" Background="{DynamicResource Brush.Blue}" RenderTransformOrigin="-0.401,0.542" Margin="10,10,20,10"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
