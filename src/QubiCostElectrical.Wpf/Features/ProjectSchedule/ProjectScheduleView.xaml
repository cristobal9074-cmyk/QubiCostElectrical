<UserControl x:Class="QubiCostElectrical.Wpf.Features.ProjectSchedule.ProjectScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.ProjectSchedule">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Cabecera de la vista -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}" Padding="14" Margin="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Orientation="Horizontal" Grid.Column="0">
          <TextBlock Text="Planificación y Cronogramas" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
          <Button Command="{Binding RefreshCommand}" Content="⟳ Actualizar" Style="{StaticResource Button.Secondary}" Margin="16,0,0,0" />
          <Button Command="{Binding NewScheduleCommand}" Content="+ Nuevo Cronograma" Style="{StaticResource Button.Primary}" Margin="8,0,0,0" />
          <Button Command="{Binding RecalculateCpmCommand}" Content="⚡ Recalcular CPM" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
        </StackPanel>
        
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
      </Grid>
    </Border>

    <!-- Contenido principal con pestañas -->
    <TabControl Grid.Row="1" Margin="12,0,12,12" Background="Transparent" BorderThickness="0">
      
      <!-- Pestaña 1: Cronogramas (Lista y Edición) -->
      <TabItem Header="Cronogramas" Style="{StaticResource TabItem.Default}">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <DataGrid Grid.Column="0" ItemsSource="{Binding Summaries}" SelectedItem="{Binding SelectedSummary}"
                    AutoGenerateColumns="False" Background="{DynamicResource Brush.Surface}"
                    AlternatingRowBackground="{DynamicResource Brush.AltRow}" IsReadOnly="True"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" />
              <DataGridTextColumn Header="Inicio" Binding="{Binding ProjectStartDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" />
              <DataGridTextColumn Header="Término" Binding="{Binding TargetEndDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>

          <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        Background="{DynamicResource Brush.Line}" Margin="4,0" />

          <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Lg}" Padding="14" IsEnabled="{Binding IsEditing}">
            <StackPanel>
              <TextBlock Text="Editor de Cronograma" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,12" />

              <TextBlock Text="Nombre" Style="{StaticResource Text.Body}" />
              <TextBox Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

              <TextBlock Text="Zona Horaria" Style="{StaticResource Text.Body}" />
              <TextBox Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

              <TextBlock Text="Inicio Proyectado" Style="{StaticResource Text.Body}" />
              <DatePicker SelectedDate="{Binding ProjectStartDate}" Margin="0,2,0,8" />

              <TextBlock Text="Término Objetivo" Style="{StaticResource Text.Body}" />
              <DatePicker SelectedDate="{Binding TargetEndDate}" Margin="0,2,0,8" />

              <TextBlock Text="Estado" Style="{StaticResource Text.Body}" />
              <ComboBox SelectedItem="{Binding Status}" ItemsSource="{Binding Source={x:Static local:ProjectScheduleViewModel.StatusValues}}" Margin="0,2,0,12" />

              <Button Command="{Binding SaveCommand}" Content="Guardar Cronograma" Style="{StaticResource Button.Primary}"
                      HorizontalAlignment="Stretch" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Pestaña 2: Camino Crítico -->
      <TabItem Header="Camino Crítico" Style="{StaticResource TabItem.Default}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="12" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <TextBlock Text="Actividades en la Ruta Crítica (Holgura Total ≤ 0)" Style="{StaticResource Text.Body}" FontWeight="Bold" Foreground="Red" />
          </Border>

          <DataGrid Grid.Row="1" ItemsSource="{Binding CriticalPathActivities}" AutoGenerateColumns="False" 
                    Background="{DynamicResource Brush.Surface}" IsReadOnly="True"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100" />
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Duración" Binding="{Binding PlannedDuration.Value}" Width="100" />
              <DataGridTextColumn Header="Inicio Temprano" Binding="{Binding EarlyStart, StringFormat=\{0:dd/MM/yyyy\}}" Width="130" />
              <DataGridTextColumn Header="Fin Temprano" Binding="{Binding EarlyFinish, StringFormat=\{0:dd/MM/yyyy\}}" Width="130" />
              <DataGridTextColumn Header="Fin Tardío" Binding="{Binding LateFinish, StringFormat=\{0:dd/MM/yyyy\}}" Width="130" />
              <DataGridTextColumn Header="Holgura Total" Binding="{Binding TotalFloat}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Pestaña 3: Diagrama de Gantt / Cronograma -->
      <TabItem Header="Diagrama de Gantt" Style="{StaticResource TabItem.Default}">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Títulos de Actividades -->
          <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderThickness="1,1,0,1" BorderBrush="{DynamicResource Brush.Line}">
            <ListBox ItemsSource="{Binding Activities}" BorderThickness="0" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Height="32">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Padding="6,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Timeline Grid -->
          <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ListBox ItemsSource="{Binding Activities}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Canvas Height="32" Width="1000" VerticalAlignment="Center">
                      <!-- Activity Bar -->
                      <Border Height="18" Canvas.Top="7" Canvas.Left="{Binding GanttLeftOffset}" Width="{Binding GanttWidth}" CornerRadius="3">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                <Setter Property="Background" Value="Red" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsCritical}" Value="False">
                                <Setter Property="Background" Value="DeepSkyBlue" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Code}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <!-- Float Bar (Holgura) -->
                      <Border Height="6" Canvas.Top="13" Canvas.Left="{Binding GanttLeftOffset}" Width="{Binding GanttFloatWidth}" Background="LightPink" Opacity="0.4" CornerRadius="1">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Canvas.Left" Value="{Binding GanttLeftOffset}" />
                            <!-- Reposition float bar to start after the activity bar -->
                            <Setter Property="RenderTransform">
                              <Setter.Value>
                                <TranslateTransform X="{Binding GanttWidth}" />
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </Border.Style>
                      </Border>
                    </Canvas>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
