<UserControl x:Class="QubiCostElectrical.Wpf.Features.EstadosPago.EstadosPagoView"
             x:Name="EstadosPagoRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.EstadosPago"
             Background="{DynamicResource Brush.Canvas}">

  <UserControl.Resources>
    <!-- Celda de mes del calendario compacta -->
    <Style x:Key="MesCellBtn" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="Height" Value="Auto" />
      <Setter Property="Padding" Value="2,3" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MesMonto" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsGenerated}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MesEstadoPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="pago">
          <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="revision">
          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="borrador">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MesEstadoText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="8.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="pago">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="revision">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="borrador">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Badges por estado (detalle + resumen) -->
    <Style x:Key="EstadoBadgeBox" TargetType="Border" BasedOn="{StaticResource Badge.Status}">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Ok">
          <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Warn">
          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Info">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ResumenBadgeBox" TargetType="Border" BasedOn="{StaticResource Badge.Status}">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResumenBadgeKind}" Value="Ok">
          <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ResumenBadgeKind}" Value="Warn">
          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ResumenBadgeKind}" Value="Info">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Fila clave/valor del lateral y de totales compacta -->
    <Style x:Key="KvRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="KvLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KvValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Encabezado de columna de la tabla -->
    <Style x:Key="ThText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Celdas de la tabla -->
    <Style x:Key="CellCod" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Blue2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CellName" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CellNum" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CellNumStrong" TargetType="TextBlock" BasedOn="{StaticResource CellNum}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>

        <Style x:Key="AvanceCellBox" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="IsUndoEnabled" Value="False" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnAvanceCellGotKeyboardFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnAvanceCellLostFocus" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnAvanceCellPreviewMouseLeftButtonDown" />
      <EventSetter Event="PreviewKeyDown" Handler="OnAvanceCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnAvanceCellPreviewTextInput" />
    </Style>

    <!-- Fila de capítulo -->
    <Style x:Key="CapituloRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,3,0,1" />
    </Style>

    <!-- Filas de totales -->
    <Style x:Key="TotLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TotValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- ═══ Contenido con proyecto abierto ═══ -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Cabecera compacta -->
      <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,8">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Estados de pago" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            <Border Width="1" Height="13" Background="{DynamicResource Brush.Line}" Margin="10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PageSubtitle}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- KPIs compactos -->
      <UniformGrid Grid.Row="1" Columns="6" Margin="16,6,16,0">
        <Border Style="{StaticResource Card.Kpi}" Padding="8,5" Margin="0,0,6,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding KpiContratadoText}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Total contratado" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Padding="8,5" Margin="0,0,6,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding KpiPagadosLabel}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Blue}" />
            <TextBlock Text="Estados pagados" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Padding="8,5" Margin="0,0,6,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding KpiAcumText}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Success}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Acumulado aprobado" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Padding="8,5" Margin="0,0,6,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding KpiSaldoText}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Saldo por ejecutar" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Padding="8,5" Margin="0,0,6,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding KpiRetencionText}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Amber}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Retención retenida" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Padding="8,5">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding KpiAvancePct, StringFormat={}{0:N1} %}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Avance físico acumulado" FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Tabs principales -->
      <TabControl Grid.Row="2" Style="{StaticResource Form.TabControl}"
                  SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                  Margin="16,6,16,10">

        <!-- ═════════ PESTAÑA 1: CRONOGRAMA Y ESTADOS ═════════ -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="📅 Cronograma y detalle mensual" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>

          <ScrollViewer x:Name="PagoScroll" VerticalScrollBarVisibility="Auto" Padding="0,6,0,8"
                        ScrollChanged="OnPagoScrollChanged">
            <StackPanel>

              <!-- Calendario compacto -->
              <Border Style="{StaticResource Card.Section}" Padding="10,7">
                <StackPanel>
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CalendarTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                      <TextBlock Text="· Selecciona un mes para ver o editar"
                                 FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Content="⚙ Configurar obra" Style="{StaticResource Button.Toolbar}"
                              Command="{Binding IrAConfiguracionCommand}" Margin="0,0,6,0" Height="24" Padding="6,0"
                              ToolTip="Abrir pestaña de configuración de plazos y condiciones contractuales" />
                      <Border Style="{StaticResource Context.Chip}" Margin="0,0,6,0" Padding="8,1">
                        <TextBlock Text="{Binding ConfigAnio, StringFormat=Año {0}}"
                                   Style="{StaticResource Meta.Tag.Text}" VerticalAlignment="Center" FontSize="10" />
                      </Border>
                      <Button Content="＋ Generar mes" Style="{StaticResource Button.ToolbarPrimary}"
                              Command="{Binding GenerarMesCommand}" Height="24" Padding="8,0" />
                    </StackPanel>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Meses}" Margin="0,5,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource MesCellBtn}"
                                Command="{Binding DataContext.SelectMesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <StackPanel>
                            <TextBlock Text="{Binding HeaderLabel}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding MontoLabel}" Style="{StaticResource MesMonto}" />
                            <Border Style="{StaticResource MesEstadoPill}">
                              <TextBlock Text="{Binding EstadoLabel}" Style="{StaticResource MesEstadoText}" />
                            </Border>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Columnas: detalle + lateral -->
              <Grid x:Name="PagoColumns" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ── Detalle del mes ── -->
            <StackPanel Grid.Column="0">

              <!-- Mes sin estado -->
              <ctrl:EmptyStateControl
                                      Visibility="{Binding MesEmptyVisible, Converter={StaticResource BoolToVisibility}}"
                                      IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                                      Title="{Binding MesEmptyTitle}"
                                      Description="{Binding MesEmptyDesc}">
                <ctrl:EmptyStateControl.Actions>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding MesEmptyGenerarLabel}"
                            Command="{Binding GenerarEstadoMesCommand}" MinWidth="210" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Duplicar estado anterior"
                            Command="{Binding DuplicarAnteriorCommand}" MinWidth="180" />
                  </StackPanel>
                </ctrl:EmptyStateControl.Actions>
              </ctrl:EmptyStateControl>

              <!-- Mes con estado -->
              <Border Style="{StaticResource Card.Section}" Padding="0"
                      Visibility="{Binding DetailVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <!-- Cabecera del estado -->
                  <Border Style="{StaticResource Card.Header}">
                    <Grid>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetalleTitulo}" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="{Binding DetalleSub}" Style="{StaticResource Text.Helper}" Margin="0,2,0,0" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource EstadoBadgeBox}" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding BadgeLabel}" Style="{StaticResource Text.Badge}" />
                        </Border>
                        <Button Content="Aprobar" Style="{StaticResource Button.ToolbarPrimary}"
                                Command="{Binding AprobarCommand}" />
                        <Button Content="Registrar pago" Style="{StaticResource Button.ToolbarPrimary}"
                                Command="{Binding RegistrarPagoCommand}" />
                        <Button Content="Reabrir" Style="{StaticResource Button.Toolbar}"
                                Command="{Binding ReabrirCommand}" Margin="0" />
                        <Button Content="Excel" Style="{StaticResource Button.Toolbar}"
                                Command="{Binding ExportarExcelCommand}" Margin="8,0,4,0"
                                ToolTip="Exportar el estado del mes a Excel (.xlsx)" />
                        <Button Content="PDF" Style="{StaticResource Button.Toolbar}"
                                Command="{Binding ExportarPdfCommand}" Margin="0"
                                ToolTip="Exportar el estado del mes a PDF" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Encabezado de columnas -->
                  <!-- Encabezado de columnas (Fisico y Financiero) -->
                  <Border Background="{DynamicResource Brush.Surface2}" Padding="8,6"
                          BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Código" Style="{StaticResource ThText}" />
                      <TextBlock Grid.Column="1" Text="Partida (Itemizado)" Style="{StaticResource ThText}" Margin="8,0,8,0" />
                      <TextBlock Grid.Column="2" Text="Unidad" Style="{StaticResource ThText}" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="Cant. Base" Style="{StaticResource ThText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="Monto Base" Style="{StaticResource ThText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="Cant. Ant." Style="{StaticResource ThText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="6" Text="Cant. Mes" Style="{StaticResource ThText}" HorizontalAlignment="Right" ToolTip="Cantidad ejecutada en el mes" />
                      <TextBlock Grid.Column="7" Text="% Mes" Style="{StaticResource ThText}" HorizontalAlignment="Right" ToolTip="Porcentaje de avance del mes" />
                      <TextBlock Grid.Column="8" Text="Monto Mes" Style="{StaticResource ThText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="9" Text="Acumulado" Style="{StaticResource ThText}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="10" Text="Saldo" Style="{StaticResource ThText}" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>

                  <!-- Filas por capítulo -->
                  <ItemsControl ItemsSource="{Binding Secciones}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:EstadoPagoSeccionVm}">
                        <StackPanel>
                          <Border Style="{StaticResource CapituloRow}"
                                  Visibility="{Binding Capitulo, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <TextBlock Text="{Binding Capitulo}" Style="{StaticResource Text.SectionLabel}" />
                          </Border>
                          <ItemsControl ItemsSource="{Binding Partidas}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type local:EstadoPagoPartidaVm}">
                                <Grid Margin="8,4">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="90" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding Item}" Style="{StaticResource CellCod}" />
                                  <TextBlock Grid.Column="1" Text="{Binding Descripcion}" Style="{StaticResource CellName}" Margin="8,0,8,0" />
                                  <TextBlock Grid.Column="2" Text="{Binding Unidad}" Style="{StaticResource CellNum}" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                                  <TextBlock Grid.Column="3" Text="{Binding Cantidad, StringFormat={}{0:N2}}" Style="{StaticResource CellNum}" Margin="0,0,4,0" />
                                  <TextBlock Grid.Column="4" Text="{Binding MontoLabel}" Style="{StaticResource CellNum}" Margin="0,0,4,0" />
                                  <TextBlock Grid.Column="5" Text="{Binding CantidadAnterior, StringFormat={}{0:N2}}" Style="{StaticResource CellNum}" Margin="0,0,4,0" Foreground="{DynamicResource Brush.Muted}" />
                                  <TextBox Grid.Column="6"
                                           Style="{StaticResource AvanceCellBox}" Margin="0,0,4,0"
                                           IsEnabled="{Binding IsEditable}"
                                           Text="{Binding CantidadMes, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                           ToolTip="Ingrese cantidad ejecutada este mes" />
                                  <TextBox Grid.Column="7"
                                           Style="{StaticResource AvanceCellBox}" Margin="0,0,4,0"
                                           IsEnabled="{Binding IsEditable}"
                                           Text="{Binding AvanceMes, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                           ToolTip="Ingrese % ejecutado este mes" />
                                  <TextBlock Grid.Column="8" Text="{Binding MontoMesLabel}" Style="{StaticResource CellNumStrong}" Margin="0,0,4,0" />
                                  <Grid Grid.Column="9" Margin="0,0,4,0">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Height="6" Maximum="100" BorderThickness="0"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Focusable="False" IsTabStop="False"
                                                 Background="{DynamicResource Brush.Surface2}"
                                                 Foreground="{DynamicResource Brush.Blue}"
                                                 Value="{Binding AcumPct, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AcumPct, StringFormat={}{0:N1}%}"
                                               Style="{StaticResource CellNum}" />
                                  </Grid>
                                  <TextBlock Grid.Column="10" Text="{Binding SaldoMontoLabel}" Style="{StaticResource CellNum}" Margin="0,0,4,0" Foreground="{DynamicResource Brush.Muted}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Nota de tabla -->
                  <Border Background="{DynamicResource Brush.BlueSoft}" Padding="12,8" Margin="0,6,0,0">
                    <TextBlock Text="{Binding TableNoteText}" Style="{StaticResource Text.Helper}"
                               TextWrapping="Wrap" />
                  </Border>

                  <!-- Totales -->
                  <Border Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel HorizontalAlignment="Right" Width="360">
                      <Grid Style="{StaticResource KvRow}">
                        <TextBlock Text="Trabajo del mes" Style="{StaticResource TotLabel}" />
                        <TextBlock Text="{Binding TotTrabajoMesText}" Style="{StaticResource TotValue}" />
                      </Grid>
                      <Grid Style="{StaticResource KvRow}">
                        <TextBlock Text="Trabajo acumulado a la fecha" Style="{StaticResource TotLabel}" />
                        <TextBlock Text="{Binding TotAcumText}" Style="{StaticResource TotValue}" />
                      </Grid>
                      <Grid Style="{StaticResource KvRow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="−" Style="{StaticResource TotLabel}" Margin="0,0,4,0" FontWeight="Bold" />
                          <TextBlock Text="{Binding TotRecuperoLabel}" Style="{StaticResource TotLabel}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotRecuperoText}" Style="{StaticResource TotValue}" />
                      </Grid>
                      <Grid Style="{StaticResource KvRow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="−" Style="{StaticResource TotLabel}" Margin="0,0,4,0" FontWeight="Bold" />
                          <TextBlock Text="{Binding TotRetencionLabel}" Style="{StaticResource TotLabel}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotRetencionText}" Style="{StaticResource TotValue}" />
                      </Grid>
                      <Grid Style="{StaticResource KvRow}">
                        <TextBlock Text="Neto antes de IVA" Style="{StaticResource TotLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotNetoText}" Style="{StaticResource TotValue}" />
                      </Grid>
                      <Grid Style="{StaticResource KvRow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="+" Style="{StaticResource TotLabel}" Margin="0,0,4,0" FontWeight="Bold" />
                          <TextBlock Text="{Binding TotIvaLabel}" Style="{StaticResource TotLabel}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotIvaText}" Style="{StaticResource TotValue}" />
                      </Grid>
                      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                        <Grid>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="$" Style="{StaticResource TotLabel}" Margin="0,0,4,0" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotMesLabel}" Style="{StaticResource TotLabel}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                          </StackPanel>
                          <TextBlock Text="{Binding TotTotalText}" Style="{StaticResource TotValue}" FontSize="15" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ── Lateral compacto ── -->
            <StackPanel x:Name="PagoAside" Grid.Column="2">

              <!-- Resumen del mes -->
              <Border Style="{StaticResource Card.Section}" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                  <Grid>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Resumen del mes" Style="{StaticResource Text.SectionTitle}" FontSize="13" />
                      <TextBlock Text="{Binding ResumenSub}" Style="{StaticResource Text.Helper}" FontSize="10.5" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource ResumenBadgeBox}" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ResumenBadgeLabel}" Style="{StaticResource Text.Badge}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="Total a pagar" Style="{StaticResource Text.SectionLabel}" Margin="0,8,0,1" FontSize="11" />
                  <TextBlock Text="{Binding ResTotalText}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                  <TextBlock Text="{Binding ResClpText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                  <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,8,0,6" />
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="Trabajo del mes" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding ResMesText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="Trabajo acumulado" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding ResAcumText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="% avance acumulado" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding ResPctText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="Retención del mes" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding ResReteMesText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="Retención acumulada" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding ResReteAcumText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Margin="0,0,0,2">
                    <TextBlock Text="Anticipo saldo por recuperar" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding ResAntSaldoText}" Style="{StaticResource KvValue}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Avance del proyecto -->
              <Border Style="{StaticResource Card.Section}" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Avance del proyecto" Style="{StaticResource Text.SectionTitle}" FontSize="13" />
                  <TextBlock Text="Físico ponderado por monto" Style="{StaticResource Text.Helper}" FontSize="10.5" Margin="0,1,0,0" />
                  <TextBlock Text="{Binding AvPctText}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                             Margin="0,8,0,4" />
                  <ProgressBar Height="6" Maximum="100" BorderThickness="0"
                               Focusable="False" IsTabStop="False"
                               Background="{DynamicResource Brush.Surface2}"
                               Foreground="{DynamicResource Brush.Blue}"
                               Value="{Binding AvFillPct, Mode=OneWay}" />
                  <Grid Margin="0,4,0,0">
                    <TextBlock Text="{Binding AvLeftText}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding AvRightText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,8,0,6" />
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="Ejecutado" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding AvEjecText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Style="{StaticResource KvRow}">
                    <TextBlock Text="Saldo por ejecutar" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding AvSaldoText}" Style="{StaticResource KvValue}" />
                  </Grid>
                  <Grid Margin="0,0,0,2">
                    <TextBlock Text="Meses pagados" Style="{StaticResource KvLabel}" />
                    <TextBlock Text="{Binding AvMesesLabel}" Style="{StaticResource KvValue}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ═════════ PESTAÑA 2: CONFIGURACIÓN (COMPACTA) ═════════ -->
    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="⚙ Configuración de obra" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </TabItem.Header>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,10">
        <StackPanel Margin="0,2,0,0">
          <Border Style="{StaticResource Card.Section}" Padding="18,14">
            <StackPanel>
              <!-- Barra superior de la tarjeta -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Parámetros Contractuales y Cronograma" Style="{StaticResource Text.SectionTitle}" FontSize="14" />
                  <TextBlock Text="Configuración base para el cronograma mensual y el cálculo de cobros del proyecto."
                             Style="{StaticResource Text.Helper}" Margin="0,1,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Context.Chip}" VerticalAlignment="Center" Margin="10,0" Padding="10,3">
                  <TextBlock Text="{Binding ConfigPeriodoObraTexto}" FontFamily="{StaticResource Font.Mono}"
                             FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" />
                </Border>
                <Button Grid.Column="2" Style="{StaticResource Button.ToolbarPrimary}" Content="← Volver al cronograma"
                        Command="{Binding VolverAEstadosCommand}" VerticalAlignment="Center" Height="28" Padding="10,0" />
              </Grid>

              <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,0,0,12" />

              <!-- 2 Columnas compactas: Plazos (izq) + Condiciones Financieras (der) -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna 1: Cronograma y Plazos -->
                <StackPanel Grid.Column="0">
                  <TextBlock Text="📅 Cronograma y Plazos de Obra" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,8" />
                  <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Mes de inicio -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mes de inicio" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,3" />
                    <ComboBox Grid.Row="1" Grid.Column="0" Height="28" Style="{StaticResource Form.ComboBox}"
                              ItemsSource="{Binding OpcionesMesesInicio}"
                              SelectedValue="{Binding ConfigMesInicio, Mode=TwoWay}"
                              SelectedValuePath="Numero" DisplayMemberPath="Nombre" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Primer estado" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />

                    <!-- Año de inicio -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Año de inicio" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,3" />
                    <TextBox Grid.Row="1" Grid.Column="2" Height="28" Style="{StaticResource Form.TextBox}"
                             Text="{Binding ConfigAnio, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Año base (ej. 2026)" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />

                    <!-- Plazo total -->
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Plazo (meses)" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,3" />
                    <TextBox Grid.Row="1" Grid.Column="4" Height="28" Style="{StaticResource Form.TextBox}"
                             Text="{Binding ConfigCantMeses, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="1 a 48 meses" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                  </Grid>

                  <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock Text="ℹ️ Soporte multi-año continuo: si el plazo cruza al año siguiente, el cronograma y acumulados no se cortan."
                               FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <!-- Columna 2: Condiciones Contractuales -->
                <StackPanel Grid.Column="2">
                  <TextBlock Text="💰 Condiciones Financieras y Deducciones" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,8" />
                  <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Anticipo -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Anticipo %" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,3" />
                    <Grid Grid.Row="1" Grid.Column="0">
                      <TextBox Height="28" Style="{StaticResource Form.TextBox}" Padding="6,0,18,0"
                               Text="{Binding ConfigAnticipoPct, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                      <TextBlock Text="%" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Amortizado por avance" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />

                    <!-- Retención -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Retención %" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,3" />
                    <Grid Grid.Row="1" Grid.Column="2">
                      <TextBox Height="28" Style="{StaticResource Form.TextBox}" Padding="6,0,18,0"
                               Text="{Binding ConfigRetencionPct, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                      <TextBlock Text="%" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Garantía fiel cumpl." Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />

                    <!-- IVA -->
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="IVA %" Style="{StaticResource Text.KpiLabel}" Margin="0,0,0,3" />
                    <Grid Grid.Row="1" Grid.Column="4">
                      <TextBox Height="28" Style="{StaticResource Form.TextBox}" Padding="6,0,18,0"
                               Text="{Binding ConfigIvaPct, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                      <TextBlock Text="%" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Sobre neto a pagar" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                  </Grid>

                  <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock Text="💡 El anticipo y la retención se recalculan automáticamente en cada mes según el avance acumulado."
                               FontSize="10.5" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,12,0,10" />

              <!-- Pie informativo compacto -->
              <Grid>
                <TextBlock Text="💾 Persistencia automática en el archivo .qce · Los totales, saldos y retenciones se recalculan en tiempo real."
                           Style="{StaticResource Text.Helper}" FontSize="10.5" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
      </TabControl>
    </Grid>

    <!-- ═══ Estado vacío: sin proyecto ═══ -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver los estados de pago de la obra.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando estados de pago…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
