<UserControl x:Class="QubiCostElectrical.Wpf.Features.PurchaseRequisitions.PurchaseRequisitionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Requerimientos de compra" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Crear, consolidar, aprobar y generar desde presupuesto o planificación." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Crear" Command="{Binding CreateCommand}" Margin="0,0,6,6" Padding="10,6" Background="#2563EB" Foreground="White"/>
      <Button Content="Agregar ítem" Command="{Binding AddItemCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Enviar" Command="{Binding SubmitCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Aprobar" Command="{Binding ApproveCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Rechazar" Command="{Binding RejectCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Consolidar" Command="{Binding ConsolidateCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Desde presupuesto" Command="{Binding ImportBudgetCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Desde planificación" Command="{Binding ImportScheduleCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Exportar" Command="{Binding ExportCommand}" Margin="0,0,6,6" Padding="10,6"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Prioridad" Binding="{Binding Priority}" Width="*"/>
          <DataGridTextColumn Header="Solicitante" Binding="{Binding RequestedBy}" Width="*"/>
          <DataGridTextColumn Header="Fecha req." Binding="{Binding RequiredDate, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="Ítem rápido" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox Text="{Binding ItemCode}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding ItemDescription}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding ItemQty}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding SelectedItemCount, StringFormat=Ítems: {0}}"/>
          <TextBlock Text="{Binding SelectedBudgetCost, StringFormat=Costo presupuestado: {0:N0}}"/>
          <TextBlock Text="Motivo rechazo" Margin="0,12,0,4"/>
          <TextBox Text="{Binding RejectReason}"/>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
