<UserControl x:Class="QubiCostElectrical.Wpf.Features.Currency.CurrencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="780" Margin="20,14,24,24">

      <TextBlock Text="Monedas e indicadores" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,16" />

      <!-- ─── Aviso caché obsoleta ──────────────────────────────────────── -->
      <Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber2}" BorderThickness="1" CornerRadius="10"
              Padding="14,10" Margin="0,0,0,16"
              Visibility="{Binding CacheStale, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="⚠ Los indicadores en caché tienen más de 24 horas. Actualiza los valores manualmente si es necesario."
                   FontSize="10" Foreground="{DynamicResource Brush.Amber}" TextWrapping="Wrap"/>
      </Border>

      <!-- ─── Estado actual (tasas vigentes) ─────────────────────────────── -->
      <UniformGrid Columns="3" Margin="0,0,0,16">
        <Border Style="{StaticResource Card.Kpi}" Padding="14,12" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="MONEDA BASE DEL PROYECTO" Style="{StaticResource Text.SectionLabel}" FontSize="10" Margin="0,0,0,6" />
            <TextBlock Text="{Binding MonedaBase}" Style="{StaticResource Text.KpiValue}" />
            <TextBlock Text="Definida en Datos del proyecto" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Kpi}" Padding="14,12" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="VALOR UF EN CLP" Style="{StaticResource Text.SectionLabel}" FontSize="10" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ValorUfClp, StringFormat='$ {0:N0}'}" Style="{StaticResource Text.KpiValue}" />
            <TextBlock Text="{Binding FechaVigenciaDisplay, StringFormat='Vigente al {0}'}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Success}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Kpi}" Padding="14,12">
          <StackPanel>
            <TextBlock Text="DÓLAR OBSERVADO (USD → CLP)" Style="{StaticResource Text.SectionLabel}" FontSize="10" Margin="0,0,0,6" />
            <TextBlock Text="{Binding TipoCambioUsdClp, StringFormat='$ {0:N0}'}" Style="{StaticResource Text.KpiValue}" />
            <TextBlock Text="{Binding ResumenUsd}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AmberRisk}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ─── Editar tasas ───────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.Section}" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Actualizar tasas" Style="{StaticResource Text.PageTitle}" FontSize="13" Margin="0,0,0,14"/>

          <!-- Selector de moneda del proyecto -->
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="MONEDA DEL PROYECTO" Style="{StaticResource Form.Label}"/>
              <ComboBox Style="{StaticResource Form.ComboBox}"
                        ItemsSource="{Binding MonedasDisponibles}"
                        SelectedItem="{Binding MonedaSeleccionada}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="16,20,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Text="UF mantiene base histórica. CLP requiere tasa UF. USD requiere tasa UF y dólar observado."/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="VALOR UF ($ CLP)" Style="{StaticResource Form.Label}"/>
              <TextBox Text="{Binding EditUfClp, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource Form.TextBox}" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="DÓLAR OBSERVADO ($ CLP)" Style="{StaticResource Form.Label}"/>
              <TextBox Text="{Binding EditUsdClp, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource Form.TextBox}" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
              <TextBlock Text="FECHA DE VIGENCIA" Style="{StaticResource Form.Label}"/>
              <TextBox Text="{Binding EditFecha, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource Form.TextBox}" Height="36" ToolTip="Formato: dd/MM/yyyy"/>
            </StackPanel>
          </Grid>

          <!-- Error de validación -->
          <Border Background="{DynamicResource Brush.DangerBg}" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="8"
                  Padding="12,8" Margin="0,12,0,0"
                  Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
            <TextBlock Text="{Binding ValidationError}" FontSize="10" Foreground="{DynamicResource Brush.Danger}"/>
          </Border>

          <!-- Botones -->
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource Button.Primary}" Content="Aplicar tasas"
                    IsEnabled="{Binding HasPendingChanges}" Click="OnApplyClick"/>
            <Button Style="{StaticResource Button.Secondary}" Content="Descartar" Margin="8,0,0,0"
                    IsEnabled="{Binding HasPendingChanges}" Click="OnDiscardClick"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ─── Historial ──────────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card.Section}" Padding="20">
        <StackPanel>
          <TextBlock Text="Historial de tasas" Style="{StaticResource Text.PageTitle}" FontSize="13" Margin="0,0,0,14"/>

          <TextBlock Text="No hay historial de tasas registrado."
                     Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,16"
                     Visibility="{Binding Historial.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Empty}"/>

          <DataGrid ItemsSource="{Binding Historial}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    Style="{StaticResource DataGrid.Workspace}"
                    RowHeight="34"
                    Visibility="{Binding Historial.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=NonEmpty}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding FechaDisplay}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="UF" Binding="{Binding UfDisplay}" Width="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="USD" Binding="{Binding UsdDisplay}" Width="130">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Estado" Binding="{Binding EstadoDisplay}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
