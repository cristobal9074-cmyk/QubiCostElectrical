<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuTotalsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource ProjectCard}">
    <StackPanel>
      <TextBlock Text="RESUMEN DE COSTOS" Style="{StaticResource ProjectCardTitle}" />
      <UniformGrid Columns="3">
        <StackPanel>
          <TextBlock Text="Materiales" />
          <TextBlock Text="{Binding CostoMat, StringFormat=N4}" Style="{StaticResource SummaryCardValue}" />
          <TextBlock Text="Mano de obra" />
          <TextBlock Text="{Binding CostoMo, StringFormat=N4}" Style="{StaticResource SummaryCardValue}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Equipos" />
          <TextBlock Text="{Binding CostoEquipo, StringFormat=N4}" Style="{StaticResource SummaryCardValue}" />
          <TextBlock Text="Suministros" />
          <TextBlock Text="{Binding CostoSc, StringFormat=N4}" Style="{StaticResource SummaryCardValue}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Costo directo" />
          <TextBlock Text="{Binding CostoDirecto, StringFormat=N4}" Style="{StaticResource SummaryCardValue}" />
          <TextBlock Text="Precio unitario" />
          <TextBlock Text="{Binding PrecioUnitDisplay}" Style="{StaticResource SummaryCardValue}" />
        </StackPanel>
      </UniformGrid>

      <Separator Style="{StaticResource Separator.Section}" />

      <WrapPanel>
        <TextBlock Text="Venta: " FontWeight="Bold" />
        <TextBlock Text="{Binding VentaUnit, StringFormat=N4}" Margin="0,0,18,0" />
        <TextBlock Text="Total partida: " FontWeight="Bold" />
        <TextBlock Text="{Binding TotalPartidaDisplay}" Margin="0,0,18,0" />
        <TextBlock Text="Equivalente: " FontWeight="Bold" />
        <TextBlock Text="{Binding TotalPartidaEquivalentDisplay}" />
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
