<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Apu"
             xmlns:domain="clr-namespace:QubiCostElectrical;assembly=QubiCostElectrical.Domain"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls">

  <UserControl.Resources>
    <x:Array x:Key="TipoRecursoValues" Type="{x:Type domain:ApuTipoRecurso}">
      <domain:ApuTipoRecurso>MAT</domain:ApuTipoRecurso>
      <domain:ApuTipoRecurso>MO</domain:ApuTipoRecurso>
      <domain:ApuTipoRecurso>EQ</domain:ApuTipoRecurso>
      <domain:ApuTipoRecurso>SC</domain:ApuTipoRecurso>
      <domain:ApuTipoRecurso>HH</domain:ApuTipoRecurso>
      <domain:ApuTipoRecurso>HERR</domain:ApuTipoRecurso>
      <domain:ApuTipoRecurso>TR</domain:ApuTipoRecurso>
    </x:Array>

    <Style x:Key="SummaryCardLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SummaryCardValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
    </Style>

  </UserControl.Resources>

  <!-- Root: Left list + Right detail -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="220"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── Panel izquierdo: lista de partidas ─────────────────────────── -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" Background="{DynamicResource Brush.Surface}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado izquierdo -->
        <Border Grid.Row="0" Style="{StaticResource Card.LeftPanelHeader}">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="⚙️ Coeficientes" Padding="6,2" FontSize="11"
                    Command="{Binding ToggleCoefficientsCommand}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="PARTIDAS" Style="{StaticResource Text.PartidaPanelTitle}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="8,6" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
          <TextBox Text="{Binding PartidaFilter, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource Form.SearchBox}"
                   Tag="Buscar partida…" />
        </Border>

        <!-- Lista de partidas -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Partidas}"
                 SelectedItem="{Binding SelectedPartida}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Partida}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding EsTitulo}" Value="True">
                  <Setter Property="IsEnabled" Value="False"/>
                  <Setter Property="Padding" Value="8,7,8,4"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:ApuPartidaVm}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Text="{Binding DisplayLabel}"
                           FontSize="11" Foreground="{DynamicResource Brush.Ink}"
                           TextTrimming="CharacterEllipsis"
                           FontWeight="{Binding EsTitulo, Converter={StaticResource BoolToFontWeight}}"/>

                <!-- Badge de estado (solo para partidas, no títulos) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0"
                            Visibility="{Binding EsTitulo, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                  <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Ellipse.Fill>
                      <SolidColorBrush Color="{Binding EstadoColor}"/>
                    </Ellipse.Fill>
                  </Ellipse>
                  <TextBlock Text="{Binding Estado}" FontSize="9"
                             Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </Grid>
    </Border>

    <!-- Splitter -->
    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                  Background="{DynamicResource Brush.Line}" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Panel derecho: detalle del APU ────────────────────────────── -->
    <Grid Grid.Column="2">

      <!-- Estado vacío: sin proyecto -->
      <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                              Title="Sin proyecto abierto"
                              Description="Cubique al menos una partida para poder generar su APU.">
        <ctrl:EmptyStateControl.Actions>
          <Button Content="Ir a cubicación" Style="{StaticResource Button.Primary}" MinWidth="180"
                  Command="{Binding GoToCubicacionCommand}"/>
        </ctrl:EmptyStateControl.Actions>
      </ctrl:EmptyStateControl>

      <!-- Contenido del APU -->
      <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
        
        <!-- APU Details Grid (Visible when NOT showing coefficients) -->
        <Grid Visibility="{Binding IsShowCoefficients, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Encabezado de la partida activa -->
          <Border Grid.Row="0" Style="{StaticResource Card.Header}" Background="{DynamicResource Brush.Surface}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="{Binding ActiveItemCode}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Blue}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ActiveDescripcion}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Unidad:" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ActiveUnidad}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Cantidad:" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ActiveCantidad, StringFormat=N2}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Estado:" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ActiveEstado}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Ink2}"/>
              </StackPanel>
            </StackPanel>

            <!-- Precio unitario destacado -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
              <TextBlock Text="Precio unitario" FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                         HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding PrecioUnit, StringFormat='{}{0:N4} UF'}" FontSize="17" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding TotalPartida, StringFormat='Total: {0:N2} UF'}" FontSize="11"
                         Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Barra de acciones: mismo patrón "Bar.Formula" que usa Cubicación para su
             barra adosada al panel de trabajo (ver DesignSystem/Cards.xaml). -->
        <Border Grid.Row="1" Style="{StaticResource Bar.Formula}">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Button.Toolbar}" Content="⋯" ToolTip="Plantillas, conjuntos y más">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Desde plantilla" Command="{Binding AplicarPlantillaCommand}" />
                    <MenuItem Header="Guardar plantilla" Command="{Binding GuardarComoPlantillaCommand}" />
                    <MenuItem Header="Crear conjunto" Command="{Binding CrearConjuntoCommand}" />
                    <Separator />
                    <MenuItem Header="Generar APU desde cubicación" Command="{Binding GenerarApuCommand}" />
                    <MenuItem Header="Actualizar precios" Command="{Binding RefrescarPreciosCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Button.Toolbar}" Content="Duplicar"
                      Command="{Binding DuplicateRecursoCommand}"
                      CommandParameter="{Binding SelectedRecurso}"/>
              <Button Style="{StaticResource Button.Toolbar}" Content="Quitar"
                      Command="{Binding DeleteRecursoCommand}"
                      CommandParameter="{Binding SelectedRecurso}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Alertas -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.AmberSoft}"
                BorderBrush="{DynamicResource Brush.Amber}" BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding AlertText}" FontSize="11"
                     Foreground="{DynamicResource Brush.Amber}" TextWrapping="Wrap"/>
        </Border>

        <!-- Estado sin APU -->
        <Grid Grid.Row="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding TieneApu, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="16,12,16,16">

              <!-- 1. EQUIPOS -->
              <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                <StackPanel>
                  <Border Background="{DynamicResource Brush.Surface2}" Padding="12,8" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="3,0,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUBTOTAL: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CostoEquipo, StringFormat='{}{0:N4} UF'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Agregar equipo" Height="24" Padding="8,0" FontSize="11"
                                Command="{Binding AddRecursoCommand}" CommandParameter="EQ"/>
                      </StackPanel>
                      <TextBlock Text="1. EQUIPO" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <DataGrid Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding RecursosEquipo}" SelectedItem="{Binding SelectedRecurso, Mode=TwoWay}"
                            RowEditEnding="OnRowEditEnding"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32" FontSize="12" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Código" Binding="{Binding CodigoMaterial}" Width="90" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Ud" Binding="{Binding Unidad}" Width="45" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Rend." Binding="{Binding Rendimiento, StringFormat=N4}" Width="70" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Precio UF" Binding="{Binding PrecioUf, StringFormat=N4}" Width="80" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Costo UF" Binding="{Binding CostoUnitUf, StringFormat=N4, Mode=OneWay}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

              <!-- 2. MATERIALES -->
              <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                <StackPanel>
                  <Border Background="{DynamicResource Brush.Surface2}" Padding="12,8" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="3,0,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUBTOTAL: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CostoMat, StringFormat='{}{0:N4} UF'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Agregar material" Height="24" Padding="8,0" FontSize="11"
                                Command="{Binding AddRecursoCommand}" CommandParameter="MAT"/>
                      </StackPanel>
                      <TextBlock Text="2. MATERIALES" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <DataGrid Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding RecursosMat}" SelectedItem="{Binding SelectedRecurso, Mode=TwoWay}"
                            RowEditEnding="OnRowEditEnding"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32" FontSize="12" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Código" Binding="{Binding CodigoMaterial}" Width="90" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Ud" Binding="{Binding Unidad}" Width="45" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Rend." Binding="{Binding Rendimiento, StringFormat=N4}" Width="70" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Precio UF" Binding="{Binding PrecioUf, StringFormat=N4}" Width="80" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Merma%" Binding="{Binding MermaPct, StringFormat=N1}" Width="60" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Imprev.%" Binding="{Binding ImprevistosPct, StringFormat=N1}" Width="65" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Costo UF" Binding="{Binding CostoUnitUf, StringFormat=N4, Mode=OneWay}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

              <!-- 3. TRANSPORTES -->
              <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                <StackPanel>
                  <Border Background="{DynamicResource Brush.Surface2}" Padding="12,8" BorderBrush="{DynamicResource Brush.Purple}" BorderThickness="3,0,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUBTOTAL: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CostoTransporteTotal, StringFormat='{}{0:N4} UF'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Agregar transporte" Height="24" Padding="8,0" FontSize="11"
                                Command="{Binding AddRecursoCommand}" CommandParameter="TR"/>
                      </StackPanel>
                      <TextBlock Text="3. TRANSPORTES" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <DataGrid Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding RecursosOtros}" SelectedItem="{Binding SelectedRecurso, Mode=TwoWay}"
                            RowEditEnding="OnRowEditEnding"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32" FontSize="12" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Código" Binding="{Binding CodigoMaterial}" Width="90" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Ud" Binding="{Binding Unidad}" Width="45" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Rend." Binding="{Binding Rendimiento, StringFormat=N4}" Width="70" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Precio UF" Binding="{Binding PrecioUf, StringFormat=N4}" Width="80" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Costo UF" Binding="{Binding CostoUnitUf, StringFormat=N4, Mode=OneWay}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

              <!-- 4. MANO DE OBRA -->
              <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                <StackPanel>
                  <Border Background="{DynamicResource Brush.Surface2}" Padding="12,8" BorderBrush="{DynamicResource Brush.Amber}" BorderThickness="3,0,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUBTOTAL: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CostoMoTotal, StringFormat='{}{0:N4} UF'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Agregar M.O." Height="24" Padding="8,0" FontSize="11"
                                Command="{Binding AddRecursoCommand}" CommandParameter="MO"/>
                      </StackPanel>
                      <TextBlock Text="4. MANO DE OBRA" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <DataGrid Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding RecursosMo}" SelectedItem="{Binding SelectedRecurso, Mode=TwoWay}"
                            RowEditEnding="OnRowEditEnding"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32" FontSize="12" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Código" Binding="{Binding CodigoMaterial}" Width="90" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Ud" Binding="{Binding Unidad}" Width="45" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Rend." Binding="{Binding Rendimiento, StringFormat=N4}" Width="70" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Precio UF" Binding="{Binding PrecioUf, StringFormat=N4}" Width="80" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Costo UF" Binding="{Binding CostoUnitUf, StringFormat=N4, Mode=OneWay}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

              <!-- 5. SUBCONTRATOS -->
              <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                  <Border Background="{DynamicResource Brush.Surface2}" Padding="12,8" BorderBrush="{DynamicResource Brush.Info}" BorderThickness="3,0,0,0">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SUBTOTAL: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CostoSc, StringFormat='{}{0:N4} UF'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Button.ToolbarPrimary}" Content="+ Agregar subcontrato" Height="24" Padding="8,0" FontSize="11"
                                Command="{Binding AddRecursoCommand}" CommandParameter="SC"/>
                      </StackPanel>
                      <TextBlock Text="5. SUBCONTRATOS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <DataGrid Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding RecursosSc}" SelectedItem="{Binding SelectedRecurso, Mode=TwoWay}"
                            RowEditEnding="OnRowEditEnding"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="32" FontSize="12" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Código" Binding="{Binding CodigoMaterial}" Width="90" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Ud" Binding="{Binding Unidad}" Width="45" IsReadOnly="False"/>
                      <DataGridTextColumn Header="Rend." Binding="{Binding Rendimiento, StringFormat=N4}" Width="70" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Precio UF" Binding="{Binding PrecioUf, StringFormat=N4}" Width="80" IsReadOnly="False">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Costo UF" Binding="{Binding CostoUnitUf, StringFormat=N4, Mode=OneWay}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <!-- Estado cuando la partida aún no tiene APU -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding TieneApu, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <TextBlock Text="Esta partida todavía no tiene APU" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center"/>
            <TextBlock Text="Genere el APU desde la cubicación valorizada para revisar materiales, mano de obra y precio final." FontSize="12"
                       Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
            <Button Style="{StaticResource Button.Primary}" Content="Generar APU desde cubicación"
                    Command="{Binding GenerarApuCommand}" Padding="16,8" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- Totales strip -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,8">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="{DynamicResource Color.Surface}" Offset="0" />
              <GradientStop Color="{DynamicResource Color.Surface2}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="PRECIO VENTA" Style="{StaticResource Text.TotalsLabel}"/>
                <TextBlock Text="{Binding VentaUnit, StringFormat=N4}" Style="{StaticResource Text.TotalsValue}"
                           Foreground="{DynamicResource Brush.Green}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="TOTAL PARTIDA" Style="{StaticResource Text.TotalsLabel}"/>
                <TextBlock Text="{Binding TotalPartida, StringFormat=N2}" Style="{StaticResource Text.TotalsValue}"
                           FontSize="16" Foreground="{DynamicResource Brush.Blue}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="COSTO DIRECTO" Style="{StaticResource Text.TotalsLabel}"/>
                <TextBlock Text="{Binding CostoDirecto, StringFormat=N4}" Style="{StaticResource Text.TotalsValue}"/>
              </StackPanel>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="HERRAMIENTAS" Style="{StaticResource Text.TotalsLabel}"/>
                <TextBlock Text="{Binding CostoHerr, StringFormat=N4}" Style="{StaticResource Text.TotalsValue}"/>
              </StackPanel>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="IMPREVISTOS" Style="{StaticResource Text.TotalsLabel}"/>
                <TextBlock Text="{Binding Imprevistos, StringFormat=N4}" Style="{StaticResource Text.TotalsValue}"/>
              </StackPanel>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="P. UNITARIO" Style="{StaticResource Text.TotalsLabel}"/>
                <TextBlock Text="{Binding PrecioUnit, StringFormat=N4}" Style="{StaticResource Text.TotalsValue}"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

      </Grid>

      <!-- Coefficients (Markups) Panel -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsShowCoefficients, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="24,20,24,24">
          
          <Border Style="{StaticResource Card.Section}" Padding="20,18" Margin="0,0,0,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Resetear a 1.00x" Command="{Binding ResetMarkupsCommand}" />
                <TextBlock Text="Coeficientes de Sobreventa (Markups)" Style="{StaticResource Text.SectionLabel}" FontSize="12.5" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="Multiplicadores aplicados sobre el costo neto de materiales en los análisis de precios unitarios (APU)."
                         Style="{StaticResource Text.Caption}" Margin="0,0,0,16" TextWrapping="Wrap" />

              <UniformGrid Columns="3">
                <!-- Conductores -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Conductores" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupConductoresText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Canalización -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0,3,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Canalización" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupCanalizacionText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Tableros -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Tableros" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupTablerosText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Protecciones -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Protecciones" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupProteccionesText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Iluminación -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0,3,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Iluminación" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupIluminacionText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Equipos -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Equipos" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupEquiposText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Enchufes -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Enchufes y T." FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupEnchufesText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Puesta a Tierra -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0,3,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Puesta a T." FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupPuestaTierraText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Accesorios -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Accesorios" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupAccesoriosText, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>
              </UniformGrid>
              
            </StackPanel>
          </Border>
          
        </StackPanel>
      </ScrollViewer>

      </Grid>
    </Grid>
  </Grid>

</UserControl>
