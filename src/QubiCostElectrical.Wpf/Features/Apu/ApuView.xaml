                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupIluminacionText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="{StaticResource Font.Size.lg}" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Equipos -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="6,0,0,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Equipos" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupEquiposText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="{StaticResource Font.Size.lg}" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Enchufes -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Enchufes y T." FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="x" DockPanel.Dock="Right" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="2,0,0,0" />
                      <TextBox Text="{Binding MarkupEnchufesText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="{StaticResource Font.Size.lg}" FontWeight="Bold" Padding="0" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <!-- Puesta a Tierra -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0,3,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Puesta a T." FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
