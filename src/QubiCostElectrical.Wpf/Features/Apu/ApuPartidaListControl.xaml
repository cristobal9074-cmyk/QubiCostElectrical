<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuPartidaListControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="PARTIDAS" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}"/><TextBox Text="{Binding PartidaFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.TextBox}" ToolTip="Filtrar partidas" Margin="0,8,0,12"/><WrapPanel Margin="0,0,0,10"><TextBlock Text="APU: " FontSize="11"/><TextBlock Text="{Binding KpiApuGenerados}" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="OK: " FontSize="11"/><TextBlock Text="{Binding KpiPrecioOk}" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="Revisar: " FontSize="11"/><TextBlock Text="{Binding KpiRequierenRevision}" FontWeight="Bold"/></WrapPanel></StackPanel><ListBox ItemsSource="{Binding Partidas}" SelectedItem="{Binding SelectedPartida, Mode=TwoWay}" DisplayMemberPath="Descripcion" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border></UserControl>
