<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuMarkupPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Style="{StaticResource ProjectCard}"><StackPanel><DockPanel><TextBlock Text="FACTORES Y MARKUPS" Style="{StaticResource ProjectCardTitle}"/><Button DockPanel.Dock="Right" AutomationProperties.Name="Resetear markups" Content="Resetear a 1.00x" Command="{Binding ResetMarkupsCommand}" Style="{StaticResource Button.Secondary}"/></DockPanel><Button AutomationProperties.Name="Mostrar coeficientes" Content="Mostrar coeficientes" Command="{Binding ToggleCoefficientsCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"/><WrapPanel Visibility="{Binding IsShowCoefficients, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="Conductores"/><TextBox Text="{Binding MarkupConductoresText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Width="90"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Canalización"/><TextBox Text="{Binding MarkupCanalizacionText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Width="90"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Tableros"/><TextBox Text="{Binding MarkupTablerosText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Width="90"/></StackPanel><StackPanel><TextBlock Text="Protecciones"/><TextBox Text="{Binding MarkupProteccionesText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Form.TextBox}" Width="90"/></StackPanel></WrapPanel></StackPanel></Border></UserControl>
