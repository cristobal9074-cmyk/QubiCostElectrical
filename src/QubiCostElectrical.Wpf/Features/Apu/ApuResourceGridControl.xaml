<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuResourceGridControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Style="{StaticResource ProjectCard}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="RECURSOS DEL APU" Style="{StaticResource ProjectCardTitle}"/><Button AutomationProperties.Name="Agregar material" Content="+ Material" Command="{Binding AddRecursoCommand}" CommandParameter="MAT" Style="{StaticResource Button.Secondary}" Margin="12,0,4,0"/><Button AutomationProperties.Name="Agregar mano de obra" Content="+ Mano de obra" Command="{Binding AddRecursoCommand}" CommandParameter="MO" Style="{StaticResource Button.Secondary}" Margin="0,0,4,0"/><Button AutomationProperties.Name="Agregar equipo" Content="+ Equipo" Command="{Binding AddRecursoCommand}" CommandParameter="EQ" Style="{StaticResource Button.Secondary}" Margin="0,0,4,0"/><Button AutomationProperties.Name="Agregar transporte" Content="+ Transporte" Command="{Binding AddRecursoCommand}" CommandParameter="TR" Style="{StaticResource Button.Secondary}" Margin="0,0,4,0"/><Button AutomationProperties.Name="Agregar suministro" Content="+ Suministro" Command="{Binding AddRecursoCommand}" CommandParameter="SC" Style="{StaticResource Button.Secondary}"/><Button AutomationProperties.Name="Duplicar recurso" Content="Duplicar" Command="{Binding DuplicateRecursoCommand}" CommandParameter="{Binding SelectedRecurso}" Style="{StaticResource Button.Secondary}" Margin="12,0,4,0"/><Button AutomationProperties.Name="Eliminar recurso" Content="Eliminar" Command="{Binding DeleteRecursoCommand}" CommandParameter="{Binding SelectedRecurso}" Style="{StaticResource Button.Secondary}"/></StackPanel><DataGrid Style="{StaticResource DataGrid.Workspace}" ItemsSource="{Binding Recursos}" SelectedItem="{Binding SelectedRecurso, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="60" IsReadOnly="True" HeaderStyle="{StaticResource DataGridColumnHeader.Center}"/><DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoMaterial, UpdateSourceTrigger=LostFocus}" Width="100"/><DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" Width="*"/><DataGridTextColumn Header="UD" Binding="{Binding Unidad, UpdateSourceTrigger=LostFocus}" Width="55" HeaderStyle="{StaticResource DataGridColumnHeader.Center}"/><DataGridTextColumn Header="REND." Binding="{Binding Rendimiento, StringFormat=N4, UpdateSourceTrigger=LostFocus}" Width="80" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"/><DataGridTextColumn Header="PRECIO $" Binding="{Binding PrecioUf, StringFormat=N0, UpdateSourceTrigger=LostFocus}" Width="100" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"/><DataGridTextColumn Header="COSTO $ fx" Binding="{Binding CostoUnitUf, StringFormat=N0}" Width="100" IsReadOnly="True" HeaderStyle="{StaticResource DataGridColumnHeader.Formula}"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="85" IsReadOnly="True" HeaderStyle="{StaticResource DataGridColumnHeader.Center}"/></DataGrid.Columns></DataGrid><StackPanel Visibility="Collapsed"><ItemsControl ItemsSource="{Binding RecursosMat}"/><ItemsControl ItemsSource="{Binding RecursosMo}"/><ItemsControl ItemsSource="{Binding RecursosEquipo}"/><ItemsControl ItemsSource="{Binding RecursosSc}"/><ItemsControl ItemsSource="{Binding RecursosOtros}"/></StackPanel></DockPanel></Border></UserControl>
