<Window x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Aplicar plantilla APU"
        Width="720" Height="480"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16" LastChildFill="True">
      <Border Style="{StaticResource Dialog.HeaderIconContainer}" DockPanel.Dock="Left">
        <Path Data="M 14 2 H 6 a 2 2 0 0 0 -2 2 v 16 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 V 8 Z M 14 2 v 6 h 6 M 16 13 H 8 M 16 17 H 8 M 10 9 H 8"
              Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Aplicar Plantilla APU" Style="{StaticResource Dialog.HeaderTitle}" />
        <TextBlock Text="Elija una plantilla y decida si reemplaza o agrega recursos al APU actual."
                   Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0" />
      </StackPanel>
    </DockPanel>

    <!-- Filtro -->
    <TextBox Grid.Row="1" Grid.Column="0"
             x:Name="FilterBox"
             Style="{StaticResource Form.SearchBox}"
             Tag="Filtrar plantillas…"
             Margin="0,0,0,6"
             TextChanged="FilterBox_TextChanged"/>

    <!-- Lista de plantillas -->
    <ListBox Grid.Row="2" Grid.Column="0"
             x:Name="TemplateList"
             BorderThickness="1" FontSize="{StaticResource Font.Size.md}"
             SelectionChanged="TemplateList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Categoria}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"/>
              <TextBlock Text=" · " FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"/>
              <TextBlock Text="{Binding RecursoCount, StringFormat={}{0} rec.}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Preview de recursos -->
    <TextBlock Grid.Row="1" Grid.Column="2"
               Text="Recursos de la plantilla" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.md}"
               Margin="0,0,0,6" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="1" Grid.Column="2"
               x:Name="PreviewWarningTextBlock"
               Margin="0,24,0,0"
               FontSize="{StaticResource Font.Size.xs}"
               Foreground="{DynamicResource Brush.Amber}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <DataGrid Grid.Row="2" Grid.Column="2"
              x:Name="PreviewGrid"
              Style="{StaticResource DataGrid.Workspace}"
              infra:DataGridExcelNavigation.Enable="True"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              BorderThickness="1"
              CanUserResizeRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="45" HeaderStyle="{StaticResource DataGridColumnHeader.Center}"/>
        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoMaterial}" Width="75"/>
        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
        <DataGridTextColumn Header="UD" Binding="{Binding Unidad}" Width="40" HeaderStyle="{StaticResource DataGridColumnHeader.Center}"/>
        <DataGridTextColumn Header="REND." Binding="{Binding Rendimiento, StringFormat=N3}" Width="60" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"/>
        <DataGridTextColumn Header="PRECIO $" Binding="{Binding PrecioUf, StringFormat=N0}" Width="90" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Opciones de aplicación -->
    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" Margin="0,8,0,8">
      <TextBlock Text="Modo:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{StaticResource Font.Size.md}"/>
      <RadioButton x:Name="RbReemplazar" Content="Reemplazar recursos existentes"
                   IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="{StaticResource Font.Size.md}"/>
      <RadioButton x:Name="RbFusionar" Content="Fusionar (agregar al final)"
                   VerticalAlignment="Center" FontSize="{StaticResource Font.Size.md}"/>
    </StackPanel>

    <!-- Botones -->
    <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
               Style="{StaticResource Dialog.Footer}">
      <Button DockPanel.Dock="Right" x:Name="BtnAplicar" Content="Aplicar plantilla"
              Style="{StaticResource Button.Primary}" MinWidth="130" Height="34"
              IsDefault="True" IsEnabled="False"
              Click="BtnAplicar_Click"/>
      <Button DockPanel.Dock="Right" Content="Cancelar"
              Style="{StaticResource Button.Secondary}" MinWidth="90" Height="34" Margin="0,0,10,0"
              IsCancel="True"/>
    </DockPanel>
  </Grid>
  </Border>
</Window>
