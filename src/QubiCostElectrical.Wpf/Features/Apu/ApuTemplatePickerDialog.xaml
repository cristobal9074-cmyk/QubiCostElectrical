<Window x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplicar plantilla APU"
        Width="720" Height="480"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Filtro -->
    <TextBox Grid.Row="0" Grid.Column="0"
             x:Name="FilterBox"
             Padding="6,4" Margin="0,0,0,6"
             FontSize="12"
             TextChanged="FilterBox_TextChanged"/>

    <!-- Lista de plantillas -->
    <ListBox Grid.Row="1" Grid.Column="0"
             x:Name="TemplateList"
             BorderThickness="1" FontSize="12"
             SelectionChanged="TemplateList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Categoria}" FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
              <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
              <TextBlock Text="{Binding RecursoCount, StringFormat={}{0} rec.}" FontSize="10" Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Preview de recursos -->
    <TextBlock Grid.Row="0" Grid.Column="2"
               Text="Recursos de la plantilla" FontWeight="SemiBold" FontSize="12"
               Margin="0,0,0,6" VerticalAlignment="Center"/>
    <TextBlock Grid.Row="0" Grid.Column="2"
               x:Name="PreviewWarningTextBlock"
               Margin="0,24,0,0"
               FontSize="10"
               Foreground="{DynamicResource Brush.Amber}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <DataGrid Grid.Row="1" Grid.Column="2"
              x:Name="PreviewGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              BorderThickness="1"
              FontSize="11"
              CanUserResizeRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="45"/>
        <DataGridTextColumn Header="Código" Binding="{Binding CodigoMaterial}" Width="75"/>
        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
        <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="40"/>
        <DataGridTextColumn Header="Rend." Binding="{Binding Rendimiento, StringFormat=N3}" Width="60"/>
        <DataGridTextColumn Header="P.UF" Binding="{Binding PrecioUf, StringFormat=N4}" Width="70"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Opciones de aplicación -->
    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" Margin="0,8,0,8">
      <TextBlock Text="Modo:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
      <RadioButton x:Name="RbReemplazar" Content="Reemplazar recursos existentes"
                   IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12"/>
      <RadioButton x:Name="RbFusionar" Content="Fusionar (agregar al final)"
                   VerticalAlignment="Center" FontSize="12"/>
    </StackPanel>

    <!-- Botones -->
    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="BtnAplicar" Content="Aplicar"
              Width="90" Height="30" Margin="0,0,8,0"
              IsDefault="True" IsEnabled="False"
              Click="BtnAplicar_Click"/>
      <Button Content="Cancelar" Width="90" Height="30"
              IsCancel="True"/>
    </StackPanel>
  </Grid>

</Window>
