<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuWorkspaceHeaderControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="18,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button AutomationProperties.Name="Ir a Cubicación" Content="Cubicación" Command="{Binding GoToCubicacionCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0"/><Button AutomationProperties.Name="Ir al banco de precios" Content="Banco de precios" Command="{Binding GoToPriceBankCommand}" Style="{StaticResource Button.Secondary}"/></StackPanel><StackPanel><TextBlock Text="Análisis de Precio Unitario" FontSize="{StaticResource Font.Size.xl}" FontWeight="Bold"/><TextBlock Text="{Binding ActiveItemCode, Mode=OneWay}" Foreground="{DynamicResource Brush.Blue}" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveDescripcion, Mode=OneWay}" Foreground="{DynamicResource Brush.Ink3}"/></StackPanel></DockPanel></Border></UserControl>
