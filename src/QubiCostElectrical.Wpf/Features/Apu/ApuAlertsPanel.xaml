<UserControl x:Class="QubiCostElectrical.Wpf.Features.Apu.ApuAlertsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber}" BorderThickness="1" CornerRadius="10" Padding="12" Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="REVISAR APU" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}"/><TextBlock Text="{Binding AlertText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></UserControl>
