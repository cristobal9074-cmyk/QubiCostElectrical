<UserControl x:Class="QubiCostElectrical.Wpf.Features.Epp.EppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1920"
             d:DesignHeight="900"
             Background="{DynamicResource Brush.Canvas}">

  <UserControl.Resources>
    <Style x:Key="EppCellBox" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style x:Key="EppConceptBox" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <StackPanel>

        <!-- Header -->
        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                Padding="22,18,22,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="COSTOS" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,6" />
              <TextBlock Text="EPP" FontSize="{StaticResource Font.Size.xl}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" />
              <TextBlock Text="Indumentaria y EPP por ítem; sincronizado con la dotación de mano de obra."
                         FontSize="{StaticResource Font.Size.base}" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap"
                         MaxWidth="640" Margin="0,4,0,0" />
              <WrapPanel Margin="0,12,0,0">
                <Border CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,8,6" Background="{DynamicResource Brush.BlueSoft}">
                  <TextBlock FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}">
                    <Run Text="{Binding ItemsCountLabel, Mode=OneWay}" />
                    <Run Text=" ítems" />
                  </TextBlock>
                </Border>
                <Border CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,8,6" Background="{DynamicResource Brush.SuccessBg}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding MoSyncLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                  </StackPanel>
                </Border>
                <Border CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,8,6" Background="{DynamicResource Brush.AmberSoft}">
                  <TextBlock FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}">
                    <Run Text="Obra " /><Run Text="{Binding MesesObra, Mode=OneWay}" /><Run Text=" m · ciclos " />
                    <Run Text="{Binding MesesDirecta, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding MesesIndirecta, Mode=OneWay}" /><Run Text=" m" />
                  </TextBlock>
                </Border>
                <Border CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,8,6" Background="{DynamicResource Brush.PurpleSoft}">
                  <TextBlock Text="Opcionales · costo fijo" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Purple}" />
                </Border>
                <Border CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,0,6" Background="{DynamicResource Brush.AmberSoft}"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Amber}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Cambios sin guardar" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}" />
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource Button.Secondary}" Content="M. de obra" Command="{Binding GoToManoDeObraCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Desglose" Command="{Binding GoToCostoCommand}" Margin="0,0,6,0" />
              <Button x:Name="CatalogButton" Style="{StaticResource Button.Secondary}" Content="+ Catálogo"
                      Margin="0,0,6,0" Click="OnCatalogClick" IsEnabled="{Binding CanEdit}" />
              <Button Style="{StaticResource Button.Secondary}" Content="↻ Sync MO" Command="{Binding SyncFromMoCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Primary}" Content="Guardar EPP" Command="{Binding SaveCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Resumen compacto -->
        <Border Style="{StaticResource Card.Summary}" Margin="20,10,20,0" Padding="12,6">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock Text="Total EPP" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GranTotalDualLabel}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center">
                <Run Text="MO dir. (" /><Run Text="{Binding MesesDirecta, Mode=OneWay}" /><Run Text=" m)" />
              </TextBlock>
              <TextBlock Text="{Binding TotalMoDirectaLabel}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center">
                <Run Text="MO ind. (" /><Run Text="{Binding MesesIndirecta, Mode=OneWay}" /><Run Text=" m)" />
              </TextBlock>
              <TextBlock Text="{Binding TotalMoIndirectaLabel}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Acc. opc." FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TotalAccOpcionalesLabel}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>

        <StackPanel Margin="20,14,20,24">

          <!-- Indumentaria -->
          <Border Style="{StaticResource Card.Section}" Padding="0" Margin="0,0,0,14">
            <StackPanel>
              <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="M.O. Directa e Indirecta — Indumentaria" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" />
                    <TextBlock Text="{Binding IndumentariaTotalLabel}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Restablecer plantilla"
                          Command="{Binding ResetSeedCommand}" FontSize="{StaticResource Font.Size.md}" />
                </Grid>
              </Border>

              <!-- Params -->
              <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <StackPanel>
                <UniformGrid Columns="5">
                  <StackPanel Margin="0,0,12,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="MESES DE OBRA" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource EppCellBox}" Text="{Binding MesesObra, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="CICLO DIRECTA" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource EppCellBox}" Text="{Binding MesesDirecta, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="CICLO INDIRECTA" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource EppCellBox}" Text="{Binding MesesIndirecta, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="PROMEDIO DIRECTO" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource EppCellBox}" Text="{Binding DotacionDirecta, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="DOTACIÓN INDIRECTA" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,5" />
                    <TextBox Style="{StaticResource EppCellBox}" Text="{Binding DotacionIndirecta, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Margin="0,8,0,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink4}" TextWrapping="Wrap"
                           Text="Cantidad = meses de obra ÷ ciclo × dotación. Directa usa el promedio mensual de trabajadores. Indirecta usa su dotación. Los accesorios opcionales siguen la hoja EPP: fono, mascarilla y filtros cada 6 meses; cubrenuca cada 3; arnés y cabo de vida, 2 por trabajador; bloqueador solar, meses ÷ 2." />
                </StackPanel>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Directa -->
                <StackPanel Grid.Column="0">
                  <Border Background="{DynamicResource Brush.BlueSoft}" Padding="10,6" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                    <Grid>
                      <TextBlock Text="M.O. Directa" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                      <TextBlock Text="{Binding TotalMoDirectaLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="Bold"
                                 FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource Brush.Line2}" Padding="10,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="28" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="CONCEPTO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Grid.Column="1" Text="CANT." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="P. UNIT." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="TOTAL" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding MoDirectaSecciones}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,4">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="+ Ítem"
                                      Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}" FontSize="{StaticResource Font.Size.sm}" Padding="6,2"
                                      IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                              <TextBlock Text="{Binding Titulo}" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                            </DockPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="6,3">
                                  <Grid IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="65" />
                                      <ColumnDefinition Width="80" />
                                      <ColumnDefinition Width="85" />
                                      <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource EppConceptBox}"
                                             Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource EppCellBox}" TextAlignment="Right"
                                             Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource EppCellBox}" TextAlignment="Right"
                                             Text="{Binding PrecioUnitario, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.xs}"
                                               FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Blue}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource Button.Ghost}" Content="×" FontSize="{StaticResource Font.Size.lg}"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="0" Width="24" Height="24"
                                            ToolTip="Quitar" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border Background="{DynamicResource Brush.Surface}" Padding="10,5" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                            <Grid>
                              <TextBlock Text="Total" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding SubtotalLabel}" FontSize="{StaticResource Font.Size.sm}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Right" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource Brush.Line}" />

                <!-- Indirecta -->
                <StackPanel Grid.Column="2">
                  <Border Background="{DynamicResource Brush.AmberSoft}" Padding="10,6" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                    <Grid>
                      <TextBlock Text="M.O. Indirecta" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.AmberRisk}" />
                      <TextBlock Text="{Binding TotalMoIndirectaLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="Bold"
                                 FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.AmberRisk}" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource Brush.Line2}" Padding="10,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="28" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="CONCEPTO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Grid.Column="1" Text="CANT." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="P. UNIT." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="TOTAL" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding MoIndirectaSecciones}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="10,4">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="+ Ítem"
                                      Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}" FontSize="{StaticResource Font.Size.sm}" Padding="6,2"
                                      IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                              <TextBlock Text="{Binding Titulo}" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AmberRisk}" VerticalAlignment="Center" />
                            </DockPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="6,3">
                                  <Grid IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="65" />
                                      <ColumnDefinition Width="80" />
                                      <ColumnDefinition Width="85" />
                                      <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource EppConceptBox}"
                                             Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource EppCellBox}" TextAlignment="Right"
                                             Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource EppCellBox}" TextAlignment="Right"
                                             Text="{Binding PrecioUnitario, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.xs}"
                                               FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.AmberRisk}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource Button.Ghost}" Content="×" FontSize="{StaticResource Font.Size.lg}"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="0" Width="24" Height="24" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border Background="{DynamicResource Brush.Surface}" Padding="10,5" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                            <Grid>
                              <TextBlock Text="Total" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding SubtotalLabel}" FontSize="{StaticResource Font.Size.sm}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.AmberRisk}" HorizontalAlignment="Right" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <Border Background="{DynamicResource Brush.Navy}" Padding="14,8">
                <Grid>
                  <TextBlock Text="Valor Indumentaria" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderLabel}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TotalMoDirectaLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding TotalMoIndirectaLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- Opcionales -->
          <Border Style="{StaticResource Card.Section}" Padding="0" Margin="0,0,0,14">
            <StackPanel>
              <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Accesorios Opcionales" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold" />
                    <TextBlock Text="Costo Fijo — Proyecto" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Incluir en total" IsChecked="{Binding OpcionalesIncluidos}"
                              FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsEnabled="{Binding CanEdit}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="+ Ítem"
                            Command="{Binding AddOpcionalItemCommand}"
                            IsEnabled="{Binding CanEdit}" FontSize="{StaticResource Font.Size.md}" Padding="10,5" />
                  </StackPanel>
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding AccOpcionalesSecciones}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border Background="{DynamicResource Brush.PurpleSoft}" Padding="10,4" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Titulo}" FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Violet}" />
                      </Border>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="6,3">
                              <Grid IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="65" />
                                  <ColumnDefinition Width="80" />
                                  <ColumnDefinition Width="85" />
                                  <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource EppConceptBox}"
                                         Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="1" Style="{StaticResource EppCellBox}" TextAlignment="Right"
                                         Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="2" Style="{StaticResource EppCellBox}" TextAlignment="Right"
                                         Text="{Binding PrecioUnitario, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="3" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.xs}"
                                           FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Violet}" TextAlignment="Right" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Style="{StaticResource Button.Ghost}" Content="×" FontSize="{StaticResource Font.Size.lg}"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="0" Width="24" Height="24" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Background="{DynamicResource Brush.PinkSoft}" Padding="10,5">
                        <Grid>
                          <TextBlock Text="Costo Fijo — Proyecto" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.VioletDark}" />
                          <TextBlock Text="{Binding SubtotalLabel}" FontSize="{StaticResource Font.Size.md}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.Violet}" HorizontalAlignment="Right" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Gran total -->
          <Border Background="{DynamicResource Brush.Navy}" Padding="14,10" CornerRadius="8" Margin="0,0,0,14">
            <Grid>
              <TextBlock Text="GRAN TOTAL EPP (Indumentaria + Accesorios Opcionales)" FontSize="{StaticResource Font.Size.sm}" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding GranTotalLabel}" FontSize="{StaticResource Font.Size.h3}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                         Foreground="{DynamicResource Brush.White}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Footer -->
          <Border Background="{DynamicResource Brush.Navy}" Padding="20,12" CornerRadius="8">
            <DockPanel LastChildFill="False">
              <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="RESUMEN EPP" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding FooterText}" FontSize="{StaticResource Font.Size.2xs}" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,1,0,0" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Size.xs}" Margin="0,4,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderLabel}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Primary}" Content="Guardar EPP" Command="{Binding SaveCommand}" Margin="0,0,16,0" />
                <TextBlock Text="{Binding GranTotalLabel}" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            IconData="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para gestionar los elementos de protección personal.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando EPP…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
