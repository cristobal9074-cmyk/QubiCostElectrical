<UserControl x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.CubicacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Cubicacion"
             xmlns:domain="clr-namespace:QubiCostElectrical;assembly=QubiCostElectrical.Domain"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             KeyDown="OnKeyDown">

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding OpenQuickJumpCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Estilo compacto de encabezado para las columnas normales en Casillas -->
        <Style x:Key="DataGridColumnHeader.CasillasGeneral" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
        </Style>

        <!-- Estilo cebra ultra-sutil para encabezados de zonas impares -->
        <Style x:Key="DataGridColumnHeader.CasillasZebra" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.CasillasGeneral}">
            <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
        </Style>

        <!-- Encabezado distintivo de CANT fx con separador vertical de Freeze Pane -->
        <Style x:Key="DataGridColumnHeader.FormulaFrozen" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Formula}">
            <Setter Property="BorderThickness" Value="0,0,1.5,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
        </Style>

        <!-- Estilo de encabezado integrado para UD y CANT en modo Casillas -->
        <Style x:Key="DataGridColumnHeader.PartidaHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Header editable para UD en modo Casillas: título limpio "UD" + caja de edición integrada compacta -->
        <DataTemplate x:Key="HeaderTemplate.PartidaUnidad">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="UD" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,0,0,1" />
                <Border Grid.Row="1" CornerRadius="2" Height="15" VerticalAlignment="Center" ToolTip="Unidad de la partida, la misma del itemizado. No cambia la unidad de ningún material.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPartidaUnidadMissing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Tag="PartidaUnidad"
                             Text="{Binding DataContext.PartidaUnidadText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}"
                             FontFamily="{StaticResource Font.Ui}" FontSize="10" FontWeight="Bold"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Ink}"
                             Loaded="OnUnidadHeaderBoxLoaded" GotFocus="OnUnidadHeaderBoxGotFocus" LostFocus="OnUnidadHeaderBoxLostFocus"
                             PreviewKeyDown="OnUnidadHeaderBoxPreviewKeyDown" TextChanged="OnUnidadHeaderBoxTextChanged"
                             PreviewMouseLeftButtonDown="OnHeaderTextBoxPreviewMouseLeftButtonDown" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Header editable para CANT en modo Casillas: título limpio "CANT" + caja de edición con badge verde de fórmula compacto -->
        <DataTemplate x:Key="HeaderTemplate.PartidaCantidad">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CANT" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" Margin="0,0,0,1" />
                <Border Grid.Row="1" CornerRadius="2" Height="15" VerticalAlignment="Center" ToolTip="{Binding DataContext.PartidaCantidadToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsPartidaCantidadMissing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Tag="PartidaCant"
                             Text="{Binding DataContext.PartidaCantidadText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}"
                             FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Success}"
                             Loaded="OnCantHeaderBoxLoaded" GotFocus="OnCantHeaderBoxGotFocus" LostFocus="OnCantHeaderBoxLostFocus"
                             PreviewKeyDown="OnCantHeaderBoxPreviewKeyDown" PreviewTextInput="OnCantHeaderBoxPreviewTextInput"
                             PreviewMouseLeftButtonDown="OnHeaderTextBoxPreviewMouseLeftButtonDown" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Layout principal tres zonas -->
    <Grid>
        <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                                Title="Sin proyecto abierto"
                                Description="Abra un proyecto para cubicar materiales, mano de obra y recursos por partida.">
            <ctrl:EmptyStateControl.Actions>
                <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
            </ctrl:EmptyStateControl.Actions>
        </ctrl:EmptyStateControl>

        <Grid Background="{DynamicResource Brush.Canvas}"
              Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <Grid.ColumnDefinitions>
                <!-- Panel izquierdo -->
                <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="160" MaxWidth="360" />
                <ColumnDefinition Width="18" />
                <!-- Centro -->
                <ColumnDefinition MinWidth="400" />
                <!-- Inspector lateral SC / Hoja de Cubicacion -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════
             PANEL IZQUIERDO — Lista de partidas
             ══════════════════════════════════════════════ -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0"
                    PreviewKeyDown="OnPartidasPanelPreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado izquierdo -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="12,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="PARTIDAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredPartidas.Count, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Muted}" />
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- GRUPO 1: Vistas y Modos (Matriz/Detalle y Libre/Zonas) -->
                                <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="26" Height="24" Command="{Binding ShowSectorMatrixCommand}" ToolTip="Vista Cubicación por Matriz (Alt+A)&#x0a;Planilla de casillas y sectores (S1, S2, TA-P2...)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSectorMatrixMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.Grid}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>
                                        <Button Width="26" Height="24" Command="{Binding ShowResourceDetailCommand}" ToolTip="Vista Detalle de Recursos (Alt+D)&#x0a;Desglose completo con precios unitarios y subtotales">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSectorMatrixMode}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.List}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="26" Height="24" Command="{Binding SetZonaLibreModeCommand}" ToolTip="Modo Zona Libre&#x0a;Cubicación directa continua sin desglose por pisos">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsZonaLibreMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.Globe}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>
                                        <Button Width="26" Height="24" Command="{Binding SetPorZonasModeCommand}" ToolTip="Modo Por Zonas&#x0a;Matriz desglosada por pisos, subterráneos y sectores">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPorZonasMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.Building}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- GRUPO 2: Operaciones de Material / Fila (Excel) -->
                                <!-- + Material -->
                                <Button Style="{StaticResource Button.ToolbarPrimary}" Height="28" Padding="9,0" Margin="0,0,4,0"
                                        Command="{Binding AddRowCommand}" ToolTip="Agregar nuevo material a la partida (Ins)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="＋" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Material" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Duplicar -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,4,0"
                                        Command="{Binding DuplicateRowCommand}" ToolTip="Duplicar la fila seleccionada (Ctrl+D)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Duplicar" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Eliminar -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,5,0"
                                        Command="{Binding DeleteRowCommand}" ToolTip="Eliminar la fila de material seleccionada (Supr)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Eliminar" FontSize="11" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- GRUPO 3: Herramientas de Cálculo -->
                                <!-- Hoja Cubicación -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,4,0"
                                        Command="{Binding OpenHojaCubicacionCommand}" ToolTip="Hoja de Cubicación (Alt+T)&#x0a;Herramienta de apoyo para cubicar: agregue ítems y sume mediciones">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📐" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Hoja Cub." FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Tomar SC -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,4,0"
                                        Command="{Binding OpenScTomarCommand}" ToolTip="Tomar de Cubicación SC (Alt+L)&#x0a;Importar alimentadores, circuitos y tableros calculados">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Tomar SC" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- APU -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,4,0"
                                        Command="{Binding NavigateToApuCommand}" ToolTip="Análisis de Precio Unitario (APU)&#x0a;Abrir herramienta auxiliar de APU para esta partida">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="APU" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Tipologías -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,5,0"
                                        Command="{Binding ManageTipologiasCommand}" ToolTip="Tipologías de Departamentos&#x0a;Cubicación paramétrica masiva por tipologías y pisos del edificio">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🏢" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Tipologías" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- GRUPO 4: Automatización y Edición Avanzada (Dropdowns tipo Excel) -->
                                <!-- Reemplazar ▾ -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,4,0"
                                        ToolTip="Operaciones de reemplazo masivo de materiales y familias" Click="OnMoreActionsClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Reemplazar" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.7" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Buscar y Reemplazar Material..." InputGestureText="Ctrl+H" Command="{Binding OpenBatchReplaceCommand}" ToolTip="Reemplazar un material en todas las partidas manteniendo intactas las mediciones y fórmulas">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Cambio de Línea o Familia Masivo..." InputGestureText="Ctrl+Shift+H" Command="{Binding OpenFamilyBatchReplaceCommand}" ToolTip="Ingeniería de valor: reemplazar familias completas de materiales con auto-mapeo del banco de precios">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Autocompletar ▾ -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,4,0"
                                        ToolTip="Autocompletar unidad y cantidad según el primer material cubicado" Click="OnMoreActionsClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Autocompletar" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.7" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Autocompletar unidad y cantidad (esta partida)" Command="{Binding AutocompletarUnidadYCantidadCommand}" ToolTip="Asignar a esta partida la unidad y cantidad del primer material cubicado">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Aplicar cantidad a la partida" Command="{Binding AplicarCantidadALaPartidaCommand}" ToolTip="Copia la cantidad global al recurso maestro cuando la partida tiene componentes">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🎯" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Autocompletar unidad y cantidad en todo el proyecto..." Command="{Binding AutocompletarUnidadYCantidadTodasCommand}" ToolTip="Asignar la unidad y cantidad del primer material a todas las partidas sin valorización global">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🌐" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Plantillas ▾ -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="7,0" Margin="0,0,5,0"
                                        ToolTip="Gestionar plantillas de materiales y zonas de cubicación" Click="OnMoreActionsClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Plantillas" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.7" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Cargar Plantilla..." Command="{Binding AplicarConjuntoCommand}" ToolTip="Cargar una plantilla creada en la pestaña Plantillas sobre la partida seleccionada">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📥" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Guardar como Plantilla..." Command="{Binding CrearConjuntoDesdePartidaCommand}" ToolTip="Crear una plantilla reutilizable a partir de los materiales y fórmulas de esta partida">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Zonas del Proyecto..." Command="{Binding ManageZonasCommand}" ToolTip="Definir las zonas del proyecto (nombres, orden y estado de los sectores)">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🗺️" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- Buscar en tabla -->
                                <Button Style="{StaticResource Button.ToolbarIcon}" Click="OnOpenSearchClick" ToolTip="Buscar en tabla (Ctrl+F)&#x0a;Filtrar y resaltar coincidencias en la partida activa">
                                    <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Icon.Vector.Md}" />
                                </Button></StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Buscador y Filtro Rápido de Estado -->
                    <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Surface2}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="9"
                                           Foreground="{DynamicResource Brush.Muted}" Text="Ctrl++ / Ctrl+-"
                                           ToolTip="Ctrl++ agregar partida bajo la selección · Ctrl+- eliminar la partida activa" />
                                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="6,2" Height="28" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource Icon.Vector.Sm}" Data="{StaticResource Geo.Search}" Stroke="{DynamicResource Brush.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Buscar partida…" FontSize="11" Foreground="{DynamicResource Brush.Muted}" IsHitTestVisible="False" VerticalAlignment="Center"
                                                       Visibility="{Binding HasPartidaFilter, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            <TextBox BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Ink}"
                                                     Text="{Binding PartidaFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtrar partidas por número de ítem o descripción" />
                                        </Grid>
                                        <Button Grid.Column="2" Content="✕" Command="{Binding ClearPartidaFilterCommand}"
                                                Visibility="{Binding HasPartidaFilter, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource Button.Ghost}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"
                                                Padding="2,0" Margin="3,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Limpiar filtro de partidas (Esc)" />
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- Chips de Estado -->
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="7" Padding="2">
                                <UniformGrid Columns="3">
                                    <RadioButton Content="{Binding TotalFilterLabel}" IsChecked="{Binding IsPartidaFilterTodos, Mode=TwoWay}"
                                                 GroupName="CubicacionStatusFilter" ToolTip="Mostrar todas las partidas" Style="{StaticResource FilterChip.Base}" />
                                    <RadioButton Content="{Binding ListasFilterLabel}" IsChecked="{Binding IsPartidaFilterListas, Mode=TwoWay}"
                                                 GroupName="CubicacionStatusFilter" ToolTip="Filtrar partidas completas (con cubicación lista)" Style="{StaticResource FilterChip.Success}" />
                                    <RadioButton Content="{Binding PendientesFilterLabel}" IsChecked="{Binding IsPartidaFilterPendientes, Mode=TwoWay}"
                                                 GroupName="CubicacionStatusFilter" ToolTip="Filtrar partidas pendientes (sin cubicación o incompletas)" Style="{StaticResource FilterChip.Warning}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de partidas -->
                    <ListBox Grid.Row="2" x:Name="PartidasList"
                             ItemsSource="{Binding FilteredPartidas}" SelectedItem="{Binding SelectedPartida}"
                             SelectionChanged="OnPartidaSelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="15,15" VirtualizingPanel.CacheLengthUnit="Item"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Partida}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsPartida}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Padding" Value="4,6,4,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PartidaListItemVm}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding DisplayLabel}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExclusionTooltip}" Foreground="{DynamicResource Brush.Ink}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsPartida}" Value="False">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                        <Setter Property="FontSize" Value="10" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExcluidoCubicacion}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsPartida}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneCubicacion}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SinValorizacionGlobal}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="9" Foreground="{DynamicResource Brush.Muted}" Text="{Binding StatusBadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- GridSplitter izquierdo (Focusable=False para evitar salto de foco involuntario) -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Focusable="False"
                          Background="{DynamicResource Brush.Line}" Cursor="SizeWE" Margin="7,0,7,0" />

            <!-- ══════════════════════════════════════════════
             PANEL CENTRAL
             ══════════════════════════════════════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition x:Name="TotalsRow" Height="Auto" />
                    <RowDefinition x:Name="StatusRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barra de navegación de sectores y cabecera de partida activa -->
                <Border Grid.Row="0" Style="{StaticResource Bar.Formula}" Padding="14,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBox x:Name="PartidaCodigoBox" Text="{Binding PartidaCodigo, UpdateSourceTrigger=LostFocus}"
                                         FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}"
                                         Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1"
                                         Padding="6,3" Margin="0,0,8,0" MinWidth="55" MaxWidth="120"
                                         ToolTip="Editar número de ítem de la partida (ej. 1.1) · Enter para guardar"
                                         PreviewKeyDown="OnPartidaHeaderBoxPreviewKeyDown" />
                                <TextBox x:Name="PartidaDescripcionBox" Text="{Binding PartidaDescripcion, UpdateSourceTrigger=LostFocus}"
                                         FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                                         Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                         Padding="8,3" MinWidth="180" MaxWidth="380"
                                         ToolTip="Editar nombre/descripción de la partida · Enter para guardar"
                                         PreviewKeyDown="OnPartidaHeaderBoxPreviewKeyDown" />
                                <!-- Badge sutil integrado: Alerta de partida sin cantidad o sin unidad global -->
                                <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="12" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                        VerticalAlignment="Center" ToolTip="{Binding AlertaSinValorizacionGlobalMensaje}"
                                        Visibility="{Binding HasAlertaSinValorizacionGlobal, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AlertaSinValorizacionGlobalBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- GRUPO 1: Selector principal de Vista [ Cubicacion (Matriz) | Detalle de Recursos ] -->
                                <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Cubicacion (Matriz) -->
                                        <Button Width="28" Height="24" Command="{Binding ShowSectorMatrixCommand}" ToolTip="Vista Cubicaci&#243;n por Matriz (Alt+A)&#x0a;Planilla de casillas y sectores (S1, S2, TA-P2...)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSectorMatrixMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.Grid}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>

                                        <!-- Detalle -->
                                        <Button Width="28" Height="24" Command="{Binding ShowResourceDetailCommand}" ToolTip="Vista Detalle de Recursos (Alt+D)&#x0a;Desglose completo con precios unitarios y subtotales">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSectorMatrixMode}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.List}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- GRUPO 2: Modo de Cubicacion [ Zona Libre | Por Zonas ] -->
                                <Border Background="{DynamicResource Brush.ChipBg}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Zona Libre -->
                                        <Button Width="28" Height="24" Command="{Binding SetZonaLibreModeCommand}" ToolTip="Modo Zona Libre&#x0a;Cubicaci&#243;n directa continua sin desglose por pisos">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsZonaLibreMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.Globe}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>

                                        <!-- Por Zonas -->
                                        <Button Width="28" Height="24" Command="{Binding SetPorZonasModeCommand}" ToolTip="Modo Por Zonas&#x0a;Matriz desglosada por pisos, subterr&#225;neos y sectores">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPorZonasMode}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Geo.Building}" Style="{StaticResource Icon.Vector.Md}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- GRUPO 3: Herramientas Principales -->
                                <!-- Tomar SC -->
                                <Button Style="{StaticResource Button.ToolbarIcon}" Command="{Binding OpenScTomarCommand}" ToolTip="Tomar de Cubicaci&#243;n SC (Alt+L)&#x0a;Importar alimentadores, circuitos y tableros calculados">
                                    <Path Data="{StaticResource Geo.Bolt}" Style="{StaticResource Icon.Vector.Md}" Stroke="{DynamicResource Brush.SuccessBright}" />
                                </Button>

                                <!-- Ver / Generar APU -->
                                <Button Style="{StaticResource Button.ToolbarIcon}" Command="{Binding NavigateToApuCommand}" ToolTip="An&#225;lisis de Precio Unitario (APU)&#x0a;Abrir herramienta auxiliar de APU para esta partida">
                                    <Path Data="{StaticResource Geo.Cube}" Style="{StaticResource Icon.Vector.Md}" Stroke="{DynamicResource Brush.Warning}" />
                                </Button>

                                <!-- Hoja Cubicacion -->
                                <Button Style="{StaticResource Button.ToolbarIcon}" Command="{Binding OpenHojaCubicacionCommand}" ToolTip="Hoja de Cubicaci&#243;n (Alt+T)&#x0a;Herramienta de apoyo para cubicar: agregue &#237;tems y sume sus mediciones antes de trasladarlas a la partida">
                                    <Path Data="{StaticResource Geo.FileText}" Style="{StaticResource Icon.Vector.Md}" Stroke="{DynamicResource Brush.Blue}" />
                                </Button>

                                <!-- Tipologías de Edificio -->
                                <Button Style="{StaticResource Button.ToolbarIcon}" Command="{Binding ManageTipologiasCommand}" ToolTip="Tipologías de Departamentos&#x0a;Cubicación paramétrica masiva por tipologías y pisos del edificio">
                                    <TextBlock Text="🏢" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>

                                <!-- Separador CAD -->
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Line}" Margin="2,0,5,0" VerticalAlignment="Center" />

                                <!-- GRUPO 4: Buscar &amp; Opciones -->
                                <!-- Buscar -->
                                <Button Style="{StaticResource Button.ToolbarIcon}" Click="OnOpenSearchClick" ToolTip="Buscar en tabla (Ctrl+F)&#x0a;Filtrar y resaltar coincidencias en la partida activa">
                                    <Path Data="{StaticResource Geo.Search}" Style="{StaticResource Icon.Vector.Md}" />
                                </Button>

                                <!-- Menú Acciones ▾ (Estilo Excel) -->
                                <Button Style="{StaticResource Button.Toolbar}" Height="28" Padding="9,0" Margin="0"
                                        ToolTip="Operaciones avanzadas de partida: duplicar, reemplazar, autocompletar, plantillas y zonas"
                                        Click="OnMoreActionsClick">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Acciones" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="▾" FontSize="9.5" VerticalAlignment="Center" Opacity="0.7" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Duplicar fila" InputGestureText="Ctrl+D" Command="{Binding DuplicateRowCommand}" ToolTip="Duplicar la fila seleccionada con todas sus mediciones y fórmulas">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Eliminar fila" InputGestureText="Supr" Command="{Binding DeleteRowCommand}" ToolTip="Eliminar la fila de material seleccionada" Foreground="{DynamicResource Brush.Danger}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🗑️" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Buscar y Reemplazar Material..." InputGestureText="Ctrl+H" Command="{Binding OpenBatchReplaceCommand}" ToolTip="Reemplazar un material en todas las partidas manteniendo intactas las mediciones y fórmulas">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Cambio de Línea o Familia Masivo..." InputGestureText="Ctrl+Shift+H" Command="{Binding OpenFamilyBatchReplaceCommand}" ToolTip="Ingeniería de valor: reemplazar familias completas de materiales con auto-mapeo del banco de precios">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Autocompletar unidad y cantidad" Command="{Binding AutocompletarUnidadYCantidadCommand}" ToolTip="Asignar a esta partida la unidad y cantidad del primer material cubicado">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Aplicar cantidad a la partida" Command="{Binding AplicarCantidadALaPartidaCommand}" ToolTip="Copia la cantidad global al recurso maestro cuando la partida tiene componentes">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🎯" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Autocompletar unidad y cantidad en todo el proyecto..." Command="{Binding AutocompletarUnidadYCantidadTodasCommand}" ToolTip="Asignar la unidad y cantidad del primer material a todas las partidas del proyecto que no tengan valorización global">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🌐" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Hoja de Cubicación" InputGestureText="Alt+T" Command="{Binding OpenHojaCubicacionCommand}" ToolTip="Herramienta de apoyo para cubicar: agregue ítems y sume sus mediciones antes de trasladarlas a la partida">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📐" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Generar / Ver APU de esta partida" Command="{Binding NavigateToApuCommand}" ToolTip="Abrir herramienta auxiliar de análisis de precios unitarios para la partida activa">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Tipologías de Departamentos..." Command="{Binding ManageTipologiasCommand}" ToolTip="Configurar departamentos tipo y matriz de distribución en el edificio (reemplaza matrices masivas)">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🏢" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Zonas del Proyecto..." Command="{Binding ManageZonasCommand}" ToolTip="Definir las zonas del proyecto (nombres, orden y estado de los sectores)">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🗺️" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Cargar Plantilla..." Command="{Binding AplicarConjuntoCommand}" ToolTip="Cargar una plantilla creada en la pestaña Plantillas sobre la partida seleccionada">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📥" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Guardar como Plantilla..." Command="{Binding CrearConjuntoDesdePartidaCommand}" ToolTip="Crear una plantilla reutilizable en tu biblioteca global a partir de los materiales y fórmulas de esta partida">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="💾" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Observación colapsable (cerrada por defecto) -->
                        <Expander Margin="0,8,0,0" IsExpanded="False" Visibility="{Binding HasPartida, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <TextBlock Text="Observación" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                            </Expander.Header>
                            <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                                <StackPanel Orientation="Vertical">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="Justificación:" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Ink}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="✕" FontSize="11" Padding="6,2" Margin="4,0,0,0"
                                                Click="OnClearObservationClick" Visibility="{Binding HasPartidaNote, Converter={StaticResource BoolToVisibility}}" ToolTip="Eliminar observación de la partida" />
                                        <Button x:Name="RecentObservationsBtn" DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Memoria ▼" FontSize="10.5" Padding="6,2" Margin="4,0,0,0"
                                                Click="OnRecentObservationsClick" ToolTip="Ver historial de observaciones y justificaciones guardadas" />
                                        <TextBox x:Name="MotivoNoCubicarBox" Text="{Binding MotivoNoCubicarText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" Padding="6,3" FontSize="11.5" MinHeight="26"
                                                 BorderThickness="1" BorderBrush="{DynamicResource Brush.InputBorder}" Background="{DynamicResource Brush.Surface}"
                                                 ToolTip="Observación o justificación formal de la partida · Enter para guardar · Ctrl+Shift+E para enfocar rápido" />
                                    </DockPanel>

                                    <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Rápido:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Cía. Eléctrica" FontSize="10" Padding="5,1" Margin="0,0,4,2" Click="OnChipClick" Tag="Por compañía eléctrica" ToolTip="Asignar 'Por compañía eléctrica'" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Incluido en ítem..." FontSize="10" Padding="5,1" Margin="0,0,4,2" Click="OnChipClick" Tag="Se incluye en ítem" ToolTip="Asignar 'Se incluye en ítem'" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Por Mandante" FontSize="10" Padding="5,1" Margin="0,0,4,2" Click="OnChipClick" Tag="Suministrado por Mandante" ToolTip="Asignar 'Suministrado por Mandante'" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Valor Proforma" FontSize="10" Padding="5,1" Margin="0,0,4,2" Click="OnChipClick" Tag="Valor proforma" ToolTip="Asignar 'Valor proforma'" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="No Considerado" FontSize="10" Padding="5,1" Margin="0,0,4,2" Click="OnChipClick" Tag="No considerado en bases técnicas" ToolTip="Asignar 'No considerado en bases técnicas'" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="Opcional" FontSize="10" Padding="5,1" Margin="0,0,4,2" Click="OnChipClick" Tag="Alternativa / Opcional" ToolTip="Asignar 'Alternativa / Opcional'" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Fila de la partida (modo Detalle) -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.ActiveRowBg}" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="0,0,0,2"
                        ClipToBounds="True" Visibility="{Binding IsDetailHeaderVisible, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel LastChildFill="True" Height="30">
                        <!-- Celdas fijas / congeladas de la partida (alineadas con FrozenColumnCount=5) -->
                        <DockPanel DockPanel.Dock="Left">
                            <!-- Codigo de la partida (ej. 2.1) -->
                            <Border x:Name="ItemRowCodigoCell" DockPanel.Dock="Left" Padding="8,0" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding PartidaCodigo}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                            </Border>
                            <!-- Descripcion / nombre de la partida (ej. Circuitos) -->
                            <Border x:Name="ItemRowDescCell" DockPanel.Dock="Left" Padding="8,0" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding PartidaDescripcion}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <!-- Unidad de la partida  editable -->
                            <Border x:Name="ItemRowUiCell" DockPanel.Dock="Left" Padding="1,2" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPartidaUnidadMissing}" Value="True">
                                                <Setter Property="Background" Value="#FEF3C7" /><Setter Property="BorderBrush" Value="#F59E0B" /><Setter Property="BorderThickness" Value="1,1,1,1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox x:Name="UnidadHeaderBox" Text="{Binding PartidaUnidadText, UpdateSourceTrigger=LostFocus}"
                                         IsReadOnly="{Binding IsReadOnly}" FontFamily="{StaticResource Font.Ui}" FontSize="11" FontWeight="Bold"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Ink}"
                                         GotFocus="OnUnidadHeaderBoxGotFocus" LostFocus="OnUnidadHeaderBoxLostFocus" PreviewKeyDown="OnUnidadHeaderBoxPreviewKeyDown" TextChanged="OnUnidadHeaderBoxTextChanged"
                                         ToolTip="Unidad de la partida, la misma del itemizado. No cambia la unidad de ning&#243;n material." />
                            </Border>
                            <!-- Cantidad oficial de la partida con l&#243;nea de division Freeze Pane -->
                            <Border x:Name="ItemRowCantCell" DockPanel.Dock="Left" Padding="1,2" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="0,0,1.5,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPartidaCantidadMissing}" Value="True">
                                                <Setter Property="Background" Value="#FEF3C7" /><Setter Property="BorderBrush" Value="#F59E0B" /><Setter Property="BorderThickness" Value="1,1,1,1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox x:Name="CantHeaderBox" Text="{Binding PartidaCantidadText, UpdateSourceTrigger=LostFocus}"
                                         IsReadOnly="{Binding IsReadOnly}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Success}"
                                         GotFocus="OnCantHeaderBoxGotFocus" LostFocus="OnCantHeaderBoxLostFocus" PreviewKeyDown="OnCantHeaderBoxPreviewKeyDown" PreviewTextInput="OnCantHeaderBoxPreviewTextInput"
                                         ToolTip="{Binding PartidaCantidadToolTip}" />
                            </Border>
                        </DockPanel>

                        <!-- Celdas desplazables con scroll horizontal (sincronizadas con columnas desplazables de ResourceGrid) -->
                        <DockPanel x:Name="ItemRowHost" LastChildFill="True">
                            <DockPanel.RenderTransform>
                                <TranslateTransform X="0" />
                            </DockPanel.RenderTransform>
                            <!-- Etiquetas de columna (Detalle) -->
                            <Border x:Name="ItemRowMatCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0" ToolTip="Precio unitario de material en CLP (lista de precios)">
                                <TextBlock Text="MAT $" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ItemRowMoCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0" ToolTip="Precio unitario de mano de obra en CLP (lista de precios)">
                                <TextBlock Text="MO $" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ItemRowTotalCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0" ToolTip="MAT $ + MO $ (precio unitario total en CLP)">
                                <TextBlock Text="$ UNIT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ItemRowSubtotalCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0" ToolTip="$ UNIT &#243;- cantidad del recurso (CLP)">
                                <TextBlock Text="SUBTOTAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ItemRowGgUtCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0">
                                <TextBlock Text="GG+UT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ItemRowUfUnitCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0">
                                <TextBlock Text="UF UNIT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="ItemRowSubtotalUfCell" DockPanel.Dock="Left" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,1,0">
                                <TextBlock Text="SUBTOTAL UF" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <!-- Observacion de la partida -->
                            <Border Background="{DynamicResource Brush.AmberSoft}" Padding="4,2">
                                <TextBox x:Name="ObservacionHeaderBox" Text="{Binding PartidaObservacionesText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}" FontFamily="{StaticResource Font.Ui}" FontSize="11" FontWeight="SemiBold"
                                         VerticalContentAlignment="Center" Padding="4,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Ink}"
                                         GotFocus="OnPartidaFieldGotFocus" PreviewKeyDown="OnPartidaFieldPreviewKeyDown"
                                         ToolTip="Observacion de la partida para el Resumen/oferta. Ctrl+/ para moverse entre Unidad, Cantidad y Observaciones." />
                            </Border>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- DataGrid de recursos -->
                <Grid Grid.Row="2">
                    <!-- Empty state contextual cuando no hay partida seleccionada -->
                    <ctrl:EmptyStateControl Visibility="{Binding HasPartida, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Title="Sin partida seleccionada"
                                            Description="Seleccione una partida en el panel lateral para ver sus mediciones y recursos, o cree una nueva partida.">
                        <ctrl:EmptyStateControl.Actions>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Style="{StaticResource Button.Primary}" Content="Ir a Itemizado" Command="{Binding NavigateToItemizadoCommand}" Margin="4" />
                                <Button Style="{StaticResource Button.Secondary}" Content="+ Crear Partida" Command="{Binding AddPartidaCommand}" Margin="4" />
                            </WrapPanel>
                        </ctrl:EmptyStateControl.Actions>
                    </ctrl:EmptyStateControl>

                    <DataGrid x:Name="ResourceGrid"
                              Visibility="{Binding HasPartida, Converter={StaticResource BoolToVisibility}}"
                              Style="{StaticResource DataGrid.Workspace.Excel}"
                              infra:DataGridExcelNavigation.Enable="True" infra:DataGridExcelNavigation.HandlePasteByHost="True"
                              ItemsSource="{Binding Rows}" IsReadOnly="{Binding IsReadOnly}"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                              AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsContainerVirtualizable="True"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="10,10" VirtualizingPanel.CacheLengthUnit="Item"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              RowHeight="28" ColumnHeaderHeight="32" ColumnHeaderStyle="{StaticResource DataGridColumnHeader.CasillasGeneral}"
                              FrozenColumnCount="5"
                              BeginningEdit="OnGridBeginningEdit" PreparingCellForEdit="OnGridPreparingCellForEdit" CellEditEnding="OnGridCellEditEnding"
                              PreviewKeyDown="OnGridPreviewKeyDown" PreviewTextInput="OnResourceGridPreviewTextInput"
                              PreviewMouseLeftButtonDown="OnResourceGridPreviewMouseLeftButtonDown" ContextMenuOpening="OnResourceGridContextMenuOpening"
                              SelectionChanged="OnGridSelectionChanged" CurrentCellChanged="OnGridCurrentCellChanged">
                        <DataGrid.Columns>
                            <!-- # / indicador error -->
                            <DataGridTemplateColumn x:Name="IndexColumn" Header="#" Width="44" IsReadOnly="True" CanUserResize="False" CanUserSort="False" HeaderStyle="{StaticResource DataGridColumnHeader.Center}">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}">
                                        <Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,4,0" Text="{Binding RowNumberDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Red}"
                                                       ToolTip="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Código -->
                            <DataGridTextColumn x:Name="CodigoColumn" Header="CÓDIGO" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsDetailMode, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                <Setter Property="Foreground" Value="Transparent" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CodigoCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" /><Setter Property="ToolTip" Value="{Binding CodigoCellError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellEditTransparent}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CodigoCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="ToolTip" Value="{Binding CodigoCellError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Descripción -->
                            <DataGridTextColumn x:Name="DescripcionColumn" Header="DESCRIPCIÓN" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" Width="260" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DescripcionCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" /><Setter Property="ToolTip" Value="{Binding DescripcionCellError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellEditTransparent}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DescripcionCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Tag" Value="error" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="ToolTip" Value="{Binding DescripcionCellError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Unidad del recurso -->
                            <DataGridTextColumn x:Name="UnidadColumn" Header="UD" Binding="{Binding Unidad, UpdateSourceTrigger=LostFocus}" Width="48" MinWidth="42" IsReadOnly="True">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFormulaPickTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" /><Setter Property="ToolTip" Value="{Binding UnidadCellError}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFormulaPickTarget}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellErrorTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Tag" Value="error" /><Setter Property="ToolTip" Value="{Binding UnidadCellError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Cantidad -->
                            <DataGridTextColumn x:Name="CantidadColumn" Header="CANT fx" Binding="{Binding CantidadDisplay}" Width="74" MinWidth="66" IsReadOnly="True" HeaderStyle="{StaticResource DataGridColumnHeader.FormulaFrozen}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}">
                                        <Setter Property="BorderThickness" Value="0,0,1.5,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCantPickTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="Foreground" Value="{DynamicResource Brush.CellFormulaInk}" /><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="ToolTip" Value="Cantidad calculada desde la matriz de sectores o fórmula de medición" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFormula}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" /><Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CantidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" /><Setter Property="ToolTip" Value="{Binding CantidadCellError}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCantPickTarget}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Precios y Subtotales (Detalle) -->
                            <DataGridTextColumn x:Name="MaterialPriceColumn" Header="MAT $" Binding="{Binding MatClp, UpdateSourceTrigger=LostFocus, StringFormat=N0}" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Editable}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" /><Setter Property="ToolTip" Value="Precio unitario de material (editable)" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="LaborPriceColumn" Header="MO $" Binding="{Binding MoClp, UpdateSourceTrigger=LostFocus, StringFormat=N0}" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Editable}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" /><Setter Property="ToolTip" Value="Precio unitario de mano de obra (editable)" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="TotalPriceColumn" Header="$ UNIT fx" Binding="{Binding PrecioUnitClpDisplay}" HeaderStyle="{StaticResource DataGridColumnHeader.Formula}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Formula}">
                                        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" /><Setter Property="ToolTip" Value="$ UNIT = MAT $ + MO $ (calculado)" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="SubtotalColumn" Header="SUBTOTAL $ fx" Binding="{Binding SubtotalClpDisplay}" HeaderStyle="{StaticResource DataGridColumnHeader.Formula}" Width="96" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Formula}">
                                        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" /><Setter Property="ToolTip" Value="Subtotal CLP = $ UNIT × Cantidad (calculado)" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="GgUtColumn" Header="GG+UT fx" Binding="{Binding GgUtFactor, StringFormat=N2}" HeaderStyle="{StaticResource DataGridColumnHeader.Formula}" Width="64" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Formula}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.CellFormulaInk}" /><Setter Property="ToolTip" Value="Factor de Gastos Generales y Utilidad aplicado" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="UfUnitColumn" Header="UF UNIT fx" Binding="{Binding UfUnitCalculadoDisplay}" HeaderStyle="{StaticResource DataGridColumnHeader.Formula}" Width="82" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Formula}">
                                        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" /><Setter Property="ToolTip" Value="UF UNIT = ($ UNIT × GG+UT) / Valor UF (calculado)" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="SubtotalUfColumn" Header="SUBTOTAL UF fx" Binding="{Binding UfSubtotalCalculadoDisplay}" HeaderStyle="{StaticResource DataGridColumnHeader.Formula}" Width="96" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell.Formula}">
                                        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" /><Setter Property="ToolTip" Value="Subtotal UF = UF UNIT × Cantidad (calculado)" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Observaciones (nota interna del recurso) -->
                            <ctrl:DisplayBindingTextColumn x:Name="ObservacionesColumn" Header="OBSERVACIONES"
                                                          Binding="{Binding NotaInterna, UpdateSourceTrigger=LostFocus}"
                                                          DisplayBinding="{Binding NotaInterna, Converter={StaticResource EmptyToPlaceholder}, ConverterParameter='Nota interna (no sale en la oferta)'}"
                                                          Width="*" MinWidth="160">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /><Setter Property="FontStyle" Value="Italic" /><Setter Property="FontSize" Value="10.5" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="6,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotaInterna, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" /><Setter Property="FontStyle" Value="Normal" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </ctrl:DisplayBindingTextColumn>
                        </DataGrid.Columns>

                        <!-- Row style con error -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Excel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" /><Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Skeleton Overlay -->
                    <ctrl:SkeletonOverlayControl Panel.ZIndex="10" Message="Cargando partida…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Buscador Flotante In-Grid (Ctrl+F / F3) -->
                    <ctrl:DataGridSearchOverlay x:Name="ResourceSearchOverlay" TargetGrid="{Binding ElementName=ResourceGrid}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0" Panel.ZIndex="100" />
                </Grid>

                <!-- Totales extraídos a componente dedicado -->
                <local:CubicacionTotalsBarControl x:Name="TotalsBar" Grid.Row="3"
                                                  Visibility="{Binding HasPartida, Converter={StaticResource BoolToVisibility}}" />

                <!-- Barra de estado extraída a componente dedicado -->
                <local:CubicacionStatusBarControl x:Name="StatusBar" Grid.Row="4"
                                                  Visibility="{Binding HasPartida, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Inspector lateral SC (Alt+L) -->

            <Grid Grid.Column="3"
                  Visibility="{Binding IsScInspectorOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <local:CubicacionScInspectorControl x:Name="ScInspectorPanel" DataContext="{Binding ScInspector}" Width="480" />
            </Grid>

            <!-- Popup autocompletado -->
            <Popup x:Name="AutocompletePopup" StaysOpen="True" IsOpen="{Binding AutocompleteVisible}" Placement="Bottom" AllowsTransparency="True">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" MaxHeight="320" MinWidth="480" Width="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="AutocompleteList" Grid.Row="0" ItemsSource="{Binding AutocompleteResults}"
                                 BorderThickness="0" Background="Transparent"
                                 PreviewMouseLeftButtonDown="OnAutocompleteMouseLeftButtonDown" PreviewMouseMove="OnAutocompleteMouseMove"
                                 KeyDown="OnAutocompleteKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="3,2" />
                                    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="SnapsToDevicePixels" Value="True" /><Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AutocompleteSuggestionVm}">
                                    <Grid Margin="0" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="220" />
                                            <ColumnDefinition Width="128" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Sector identificación: código + material -->
                                        <Border Grid.Column="0" Padding="10,6,12,6" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" Background="Transparent">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unidad}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Codigo}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Descripcion}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Sector precios: MAT $ / MO $ alineados -->
                                        <Border Grid.Column="1" Padding="10,6,10,6" Background="{DynamicResource Brush.Surface2}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0" Grid.Row="0" Text="MAT $" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding MatClpDisplay, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Mono}" />
                                                <TextBlock Grid.Column="0" Grid.Row="1" Text="MO $" FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding MoClpDisplay, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Mono}" Margin="0,3,0,0" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="6,4">
                            <Button x:Name="CreateMaterialButton" HorizontalAlignment="Stretch" Content="Crear material nuevo..."
                                    Height="32" Cursor="Hand"
                                    Click="OnCreateMaterialClick"
                                    MouseEnter="OnCreateMaterialMouseEnter"
                                    MouseLeave="OnCreateMaterialMouseLeave"
                                    IsEnabled="{Binding CanCreateMaterial}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="Selected">
                                                <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                                <Setter Property="BorderThickness" Value="1.5" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Popup>

            <!-- Popup autocompletado de unidades de partida (UD) -->
            <Popup x:Name="UnidadSuggestionsPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="2" MaxHeight="220" MinWidth="140" SnapsToDevicePixels="True">
                    <ListBox x:Name="UnidadSuggestionsList" BorderThickness="0" Background="Transparent" PreviewMouseLeftButtonDown="OnUnidadSuggestionClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="6,3" /><Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11" Width="42" Foreground="{DynamicResource Brush.Blue}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
