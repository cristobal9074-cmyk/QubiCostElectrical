<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.ZonasProyectoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Cubicacion"
        Style="{StaticResource Dialog.Window}"
        Title="Zonas del Proyecto y Niveles de Cubicación"
        Width="820" Height="650" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ZonasGrid}"
        PreviewKeyDown="OnWindowPreviewKeyDown">

  <Window.Resources>
    <!-- Atajos estilo Kbd Badge -->
    <Style x:Key="KbdBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    </Style>

    <!-- Botón micro de fila -->
    <Style x:Key="RowActionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── CABECERA COCKPIT EJECUTIVA ($200T Tier) ─────────────────────── -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
        <!-- Métricas KPI a la derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Total Zonas -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="TOTAL ZONAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding TotalZonasCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <!-- Activas -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="ACTIVAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                <TextBlock Text="●" Foreground="#10B981" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActivasCount}" FontSize="13" FontWeight="Bold" Foreground="#059669" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Inactivas -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="INACTIVAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                <TextBlock Text="○" Foreground="#94A3B8" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding InactivasCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Título y descripción a la izquierda -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Dialog.HeaderIconContainer}" Margin="0,0,12,0">
            <Path Data="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z M6 12H4a2 2 0 0 0-2 2v8 M18 9h2a2 2 0 0 1 2 2v11 M10 6h4 M10 10h4 M10 14h4 M10 18h4"
                  Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="16" Height="16"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Zonas del Proyecto y Niveles de Cubicación" Style="{StaticResource Dialog.HeaderTitle}" FontSize="16" />
              <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SECTORIZACIÓN" FontFamily="Consolas, Segoe UI Mono, monospace" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Estructura vertical y sectorización del edificio. Cada zona activa mapea directamente a una columna de cubicación."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- ── BARRA DE COMANDOS Y SPOTLIGHT ───────────────────────────────── -->
      <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="8" Padding="8" Margin="0,0,0,12">
        <DockPanel LastChildFill="True">
          <!-- Botones de Acción a la Derecha -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <!-- Agregar Zona -->
            <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,0" Click="OnAgregarClick" ToolTip="Agregar nueva zona al final (Ins)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="➕" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Nueva Zona" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Presets de Industria (Hub Multi-Sector) -->
            <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,0" Click="OnPresetsIndustriaClick" ToolTip="Catálogo de presets para Minería, Solar, Industria y Hospitales (Alt+P)"
                    BorderBrush="{DynamicResource Brush.BlueFocus}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="✨" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Presets de Industria…" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Brush.BlueDark}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Asistente de Edificio -->
            <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,0" Click="OnAsistenteClick" ToolTip="Generar estructura paramétrica de torres y pisos (Alt+A)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏢" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="Asistente Edificio…" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Guardar como Preset -->
            <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,8,0" Click="OnGuardarComoPresetClick" ToolTip="Guardar la estructura actual como preset personalizado en la app (Ctrl+S)">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Geo.Save}" Style="{StaticResource Icon.Vector}" Margin="0,0,5,0" />
                <TextBlock Text="Guardar Preset" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Separator Style="{StaticResource Separator.Vertical}" Height="20" Margin="0,0,8,0" />

            <!-- Subir -->
            <Button Style="{StaticResource Button.Secondary}" Padding="8,5" Margin="0,0,4,0" Click="OnSubirClick" IsEnabled="{Binding CanMoveUp}" ToolTip="Mover zona hacia arriba (Alt+↑)">
              <TextBlock Text="▲ Subir" FontSize="11" FontWeight="SemiBold" />
            </Button>

            <!-- Bajar -->
            <Button Style="{StaticResource Button.Secondary}" Padding="8,5" Margin="0,0,8,0" Click="OnBajarClick" IsEnabled="{Binding CanMoveDown}" ToolTip="Mover zona hacia abajo (Alt+↓)">
              <TextBlock Text="▼ Bajar" FontSize="11" FontWeight="SemiBold" />
            </Button>

            <Separator Style="{StaticResource Separator.Vertical}" Height="20" Margin="0,0,8,0" />

            <!-- Quitar -->
            <Button Style="{StaticResource Button.Secondary}" Padding="8,5" Margin="0,0,8,0" Click="OnQuitarClick" IsEnabled="{Binding CanDelete}" ToolTip="Eliminar zona seleccionada (Supr)">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Geo.Trash}" Style="{StaticResource Icon.Vector}" Margin="0,0,4,0" />
                <TextBlock Text="Quitar" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Activar / Desactivar Masivo -->
            <Menu Background="Transparent">
              <MenuItem Header="⚙ Opciones" Padding="8,5" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}">
                <MenuItem Header="✓ Activar todas las zonas" Click="OnActivarTodasClick" />
                <MenuItem Header="○ Desactivar todas las zonas" Click="OnDesactivarTodasClick" />
              </MenuItem>
            </Menu>
          </StackPanel>

          <!-- Spotlight Search Box a la Izquierda -->
          <DockPanel LastChildFill="True" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="4,0,8,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
              <Border Style="{StaticResource KbdBadge}">
                <TextBlock Style="{StaticResource KbdText}" Text="Ctrl+B" />
              </Border>
              <Border Style="{StaticResource KbdBadge}">
                <TextBlock Style="{StaticResource KbdText}" Text="ESC" />
              </Border>
            </StackPanel>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="12" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                     Foreground="{DynamicResource Brush.Ink}" MinWidth="180" />
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- ── GRILLA PRINCIPAL DE ZONAS ────────────────────────────────────── -->
      <Grid Grid.Row="2">
        <DataGrid x:Name="ZonasGrid"
                  Style="{StaticResource DataGrid.Workspace}"
                  ItemsSource="{Binding FilteredRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  infra:DataGridExcelNavigation.Enable="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="36"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1">
          <DataGrid.Columns>
            <!-- Columna N° (Badge Monoespaciado) -->
            <DataGridTemplateColumn Header="N°" Width="56" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          CornerRadius="10" Width="30" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NumeroDisplay}" FontFamily="Consolas, Segoe UI Mono, monospace" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Nombre de la Zona -->
            <DataGridTemplateColumn Header="Nombre de la Zona" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Nombre, UpdateSourceTrigger=LostFocus}" FontSize="13" FontWeight="SemiBold"
                           Padding="6,4" VerticalContentAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Tipo / Nivel (Inferencia Visual) -->
            <DataGridTemplateColumn Header="Tipo Nivel" Width="115" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding TipoBadgeBg}" BorderBrush="{Binding TipoBadgeBorder}" BorderThickness="1"
                          CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TipoDisplay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding TipoBadgeFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Estado (Pill interactiva Activa/Inactiva) -->
            <DataGridTemplateColumn Header="Estado" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Click="OnToggleActivaClick" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{Binding EstadoBadgeBg}" BorderBrush="{Binding EstadoBadgeBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{Binding EstadoBadgeFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Acciones Rápidas por fila -->
            <DataGridTemplateColumn Header="Acciones" Width="95">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource RowActionButton}" Click="OnRowSubirClick" ToolTip="Subir este nivel">
                      <TextBlock Text="▲" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Click="OnRowBajarClick" ToolTip="Bajar este nivel">
                      <TextBlock Text="▼" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Click="OnRowQuitarClick" ToolTip="Eliminar esta zona">
                      <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource Brush.Danger}" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Empty State amigable si no hay zonas -->
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="8" Margin="40" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding HasNoZonas, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" MaxWidth="360">
            <Border Width="56" Height="56" CornerRadius="14" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
              <TextBlock Text="🏢" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Sin zonas configuradas en el proyecto" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="Actualmente se usan sectores genéricos. Genere la estructura de pisos con el asistente en un clic o cree zonas manualmente."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,6,0,14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Style="{StaticResource Button.Primary}" Padding="14,6" Click="OnAsistenteClick" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✨" Margin="0,0,6,0" />
                  <TextBlock Text="Abrir Asistente de Edificio" FontWeight="SemiBold" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Secondary}" Padding="12,6" Click="OnAgregarClick">
                <TextBlock Text="+ Nueva Zona" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── FOOTER RAYCAST / LINEAR TIER ─────────────────────────────────── -->
      <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
        <!-- Botones de Acción Principal a la Derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" MinWidth="100" Height="34" Margin="0,0,10,0" IsCancel="True" />
          <Button Style="{StaticResource Button.Primary}" MinWidth="140" Height="34" IsDefault="True" Click="OnAcceptClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Guardar Zonas" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Leyenda de Atajos de Teclado a la Izquierda -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource KbdBadge}">
            <TextBlock Style="{StaticResource KbdText}" Text="Ins" />
          </Border>
          <TextBlock Text="Nueva" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />

          <Border Style="{StaticResource KbdBadge}">
            <TextBlock Style="{StaticResource KbdText}" Text="F2" />
          </Border>
          <TextBlock Text="Editar" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />

          <Border Style="{StaticResource KbdBadge}">
            <TextBlock Style="{StaticResource KbdText}" Text="Alt+↑↓" />
          </Border>
          <TextBlock Text="Mover" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />

          <Border Style="{StaticResource KbdBadge}">
            <TextBlock Style="{StaticResource KbdText}" Text="Supr" />
          </Border>
          <TextBlock Text="Quitar" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />

          <Border Style="{StaticResource KbdBadge}">
            <TextBlock Style="{StaticResource KbdText}" Text="Ctrl+B" />
          </Border>
          <TextBlock Text="Buscar" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
