<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.ZonasProyectoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Zonas del proyecto"
        Width="560" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Zonas del proyecto" Style="{StaticResource Text.ViewTitle}" />
      <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                 Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="Defina las zonas del edificio (p. ej. Subterráneo, Piso 1, Azotea). Sus nombres reemplazan a los sectores genéricos en la grilla de cubicación, en el orden indicado. Las zonas inactivas no se muestran como encabezado." />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Content="Agregar"
              MinWidth="80" Click="OnAgregarClick" />
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Content="Quitar"
              MinWidth="80" Margin="6,0,0,0" Click="OnQuitarClick" />
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Content="Asistente Edificio…"
              MinWidth="130" Margin="6,0,0,0" Click="OnAsistenteClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Bajar ▾"
              MinWidth="80" Margin="6,0,0,0" Click="OnBajarClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Subir ▴"
              MinWidth="80" Click="OnSubirClick" />
    </DockPanel>

    <DataGrid x:Name="ZonasGrid" Grid.Row="2"
              Style="{StaticResource DataGrid.Workspace}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              SelectionMode="Single"
              RowHeight="30">
      <DataGrid.Columns>
        <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="44" IsReadOnly="True">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Nombre de la zona"
                            Binding="{Binding Nombre, UpdateSourceTrigger=LostFocus}"
                            Width="*" />
        <DataGridCheckBoxColumn Header="Activa"
                                Binding="{Binding Activa, UpdateSourceTrigger=PropertyChanged}"
                                Width="70" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Guardar zonas"
              MinWidth="130" IsDefault="True" Click="OnAcceptClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
              MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
      <TextBlock DockPanel.Dock="Left" x:Name="ResumenText" VerticalAlignment="Center"
                 Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Muted}" />
    </DockPanel>
  </Grid>
</Window>
