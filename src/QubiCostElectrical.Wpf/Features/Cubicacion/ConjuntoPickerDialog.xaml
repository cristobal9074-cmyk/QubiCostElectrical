<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.ConjuntoPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Title="Cargar plantilla de materiales"
        Width="780" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource Dialog.Window}">

  <Window.Resources>
    <!-- Custom styling tokens -->
    <Style x:Key="PremiumCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="PanelHeader" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- Custom ListBoxItem Style for a glassmorphic item -->
    <Style x:Key="ListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <TextBlock x:Name="Indicator" Text="➔" Grid.Column="1" Foreground="{DynamicResource Brush.Blue}" FontSize="{StaticResource Font.Size.md}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                <Setter TargetName="Indicator" Property="Opacity" Value="0.5"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                <Setter TargetName="Indicator" Property="FontWeight" Value="Bold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Right-aligned style for DataGrid -->
    <Style x:Key="RightAlignText" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <!-- Dialog Header -->
      <RowDefinition Height="Auto"/>
      <!-- Main Content -->
      <RowDefinition Height="*"/>
      <!-- Footer / Actions -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Dialog Header Banner -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Dialog.HeaderIconContainer}" Margin="0,0,12,0">
          <Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8"
                Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="16" Height="16"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Cargar Plantilla de Materiales" Style="{StaticResource Dialog.HeaderTitle}"/>
          <TextBlock Text="Selecciona una plantilla para cargar sus materiales en la partida seleccionada de tu cubicación."
                     Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Main Workspace Grid -->
    <Grid Grid.Row="1" Margin="16,16,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="200"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Column: Templates list -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Search Box -->
          <Border Grid.Row="0" Padding="10,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
            <Grid>
              <TextBox x:Name="FilterBox"
                       Padding="26,6,8,6" FontSize="{StaticResource Font.Size.md}"
                       Background="{DynamicResource Brush.Surface2}"
                       BorderBrush="{DynamicResource Brush.Line}"
                       BorderThickness="1"
                       TextChanged="FilterBox_TextChanged">
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Style.Resources>
                      <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                        <VisualBrush.Visual>
                          <TextBlock Text="Buscar plantilla..." Foreground="{DynamicResource Brush.Muted}" FontSize="{StaticResource Font.Size.md}" Margin="26,0,0,0" Opacity="0.7"/>
                        </VisualBrush.Visual>
                      </VisualBrush>
                    </Style.Resources>
                    <Style.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <Path Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"
                    Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.5"
                    VerticalAlignment="Center" Margin="8,0,0,0" Width="13" Height="13" Stretch="Uniform"
                    HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>
          </Border>

          <!-- Templates ListBox -->
          <ListBox Grid.Row="1"
                   x:Name="ConjuntoList"
                   ItemContainerStyle="{StaticResource ListItem}"
                   BorderThickness="0"
                   Background="Transparent"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   SelectionChanged="ConjuntoList_SelectionChanged"
                   Padding="0,6">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2">
                  <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Codigo}" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}"/>
                    </Border>
                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Recursos.Count, StringFormat={}{0} materiales}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"/>
                    <TextBlock Text=" · " FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"/>
                    <TextBlock Text="{Binding Unidad, StringFormat=Unidad: {0}}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Splitter spacer -->
      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" IsEnabled="False"/>

      <!-- Right Column: Details & Preview -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview Title -->
        <TextBlock Grid.Row="0" Text="Vista previa de materiales de la plantilla" FontSize="{StaticResource Font.Size.sm}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8"/>

        <!-- Preview Grid -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10">
          <DataGrid x:Name="PreviewGrid"
                    Style="{StaticResource DataGrid.Workspace}"
                    infra:DataGridExcelNavigation.Enable="True"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    Background="Transparent"
                    CanUserResizeRows="False"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="50"/>
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
              <DataGridTextColumn Header="Descripción del Material" Binding="{Binding Descripcion}" Width="*"/>
              <DataGridTextColumn Header="Ud." Binding="{Binding Unidad}" Width="45"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Warning label if template is empty -->
        <TextBlock Grid.Row="2" x:Name="WarnText"
                   Text="" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Amber}"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      </Grid>
    </Grid>

    <!-- Footer Bar: Options and Actions -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Mode choices -->
        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Modo de aplicación:" FontWeight="Bold" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbReemplazar" Content="Reemplazar materiales existentes"
                         IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink}"/>
            <RadioButton x:Name="RbAgregar" Content="Agregar al final"
                         VerticalAlignment="Center" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ChkUsarCantidadPartida" Content="Calcular desde la cantidad oficial de la partida (arriba)"
                      IsChecked="False" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink}"
                      ToolTip="Si está marcado, el material maestro toma la cantidad oficial del encabezado y calcula sus esclavos automáticamente (ideal para alimentadores). Si está desmarcado, carga en cero para cubicar por casillas (lo de la foto)."/>
          </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Cancelar" 
                  Style="{DynamicResource Button.Secondary}"
                  Width="90" Height="34" Margin="0,0,10,0"
                  IsCancel="True"/>
          <Button x:Name="BtnAplicar" Content="Cargar Materiales"
                  Style="{DynamicResource Button.Primary}"
                  Width="140" Height="34"
                  IsDefault="True" IsEnabled="False"
                  Click="BtnAplicar_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
