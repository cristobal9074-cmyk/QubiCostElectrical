<UserControl x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.CubicacionScInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Cubicacion"
             xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
             Background="{DynamicResource Brush.Surface}"
             BorderBrush="{DynamicResource Brush.Line}"
             BorderThickness="1,0,0,0"
             Focusable="True"
             PreviewKeyDown="OnInspectorPreviewKeyDown">

    <UserControl.Resources>
        <!-- Estilo de botón píldora para los sistemas de circuitos -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para la flecha de colapso de grupo -->
        <Style x:Key="ArrowTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="▼" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter Property="Text" Value="▶" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de botón discreto para inyectar -->
        <Style x:Key="InjectButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (Título, badge, cerrar) -->
            <RowDefinition Height="Auto" />
            <!-- Fila destino info -->
            <RowDefinition Height="Auto" />
            <!-- Selector de Sistemas/Circuitos -->
            <RowDefinition Height="Auto" />
            <!-- Barra de búsqueda y acción masiva -->
            <RowDefinition Height="Auto" />
            <!-- Lista jerárquica de materiales agrupados -->
            <RowDefinition Height="*" />
            <!-- Footer con atajos de teclado -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
             HEADER DEL INSPECTOR
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource Button.Ghost}"
                        Content="✕"
                        Command="{Binding CloseInspectorCommand}"
                        ToolTip="Cerrar panel (Esc)"
                        FontSize="12"
                        FontWeight="Bold"
                        Padding="6,2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Cubicación SC" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                    <Border Margin="8,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#E0E7FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Alt+L" FontSize="9.5" FontWeight="Bold" Foreground="#3730A3" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             BARRA DE INFORMACIÓN DE FILA DESTINO
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎯 Destino: " FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding TargetRowText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetRowText}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════
             FILTROS POR SISTEMA / CIRCUITO DINÁMICOS
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,4">
            <StackPanel>
                <TextBlock Text="FILTRAR POR CIRCUITO / USO"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Muted}"
                           Margin="0,0,0,6" />

                <ItemsControl ItemsSource="{Binding AvailableSystems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ScInspectorSystemVm}">
                            <Button Style="{StaticResource PillButtonStyle}"
                                    Command="{Binding DataContext.SelectSystemCommand, RelativeSource={RelativeSource AncestorType=local:CubicacionScInspectorControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Margin="5,0,0,0" Padding="4,0" CornerRadius="8" Background="#10000000" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="9.5" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             BUSCADOR Y ACCIÓN MASIVA
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Caja de búsqueda -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Surface2}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,2"
                        Height="28"
                        Margin="0,0,8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Ink}"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="✕"
                                Visibility="{Binding FilterSearchText, Converter={StaticResource StringNotEmptyToVisibility}}"
                                Click="OnClearSearchClick"
                                Style="{StaticResource Button.Ghost}"
                                FontSize="9"
                                Padding="2,0"
                                Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Inyectar todo en el sistema seleccionado -->
                <Button Grid.Column="1"
                        Style="{StaticResource Button.Toolbar}"
                        Command="{Binding TransferAllInSystemCommand}"
                        ToolTip="Inyectar todos los materiales del filtro actual a partir de la fila activa"
                        Height="28">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Inyectar todo" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════
             LISTA DE GRUPOS Y MATERIALES (SCROLLABLE)
             ══════════════════════════════════════════════ -->
        <ScrollViewer x:Name="MaterialsScrollViewer" Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl ItemsSource="{Binding MaterialGroups}" Margin="10,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ScInspectorGroupVm}">
                        <Border Margin="0,0,0,10"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding HasVisibleItems, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- Cabecera del grupo -->
                                <Border Background="{DynamicResource Brush.Surface2}"
                                        Padding="10,7"
                                        CornerRadius="5,5,0,0"
                                        BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="0,0,0,1"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                                    </Border.InputBindings>
                                    <DockPanel LastChildFill="True">
                                        <!-- Botón Inyectar Grupo -->
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource InjectButtonStyle}"
                                                Command="{Binding DataContext.TransferGroupCommand, RelativeSource={RelativeSource AncestorType=local:CubicacionScInspectorControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Inyectar todos los materiales de este grupo a partir de la fila activa">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" Margin="0,0,3,0" FontWeight="Bold" />
                                                <TextBlock Text="Grupo" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Flecha + Título de Grupo -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource ArrowTextStyle}" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Ink}"
                                                       VerticalAlignment="Center" />
                                            <Border Margin="6,0,0,0" Padding="5,0.5" CornerRadius="10" Background="{DynamicResource Brush.ChipBg}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VisibleCount}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Items del grupo -->
                                <ItemsControl ItemsSource="{Binding Items}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                              Padding="8,6,8,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ScInspectorMaterialVm}">
                                            <Border Margin="0,0,0,6"
                                                    Padding="8,6"
                                                    CornerRadius="5"
                                                    Cursor="Hand"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectMaterialCommand, RelativeSource={RelativeSource AncestorType=local:CubicacionScInspectorControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="Background" Value="#EFF6FF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTransferred}" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4" />
                                                                <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    <Condition Binding="{Binding IsTransferred}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                                <Setter Property="Background" Value="#DCFCE7" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Fila 1: Código + Badge de Sistema + Cantidad destacada -->
                                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CantidadDisplay}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource Brush.Ink}"
                                                                       FontFamily="{StaticResource Font.Mono}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text=" " VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Unidad}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Muted}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Margin="0,0,6,0"
                                                                    Padding="4,1"
                                                                    CornerRadius="3"
                                                                    Background="#2563EB"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="â†µ Enter" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Codigo}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="#2563EB"
                                                                       FontFamily="{StaticResource Font.Mono}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Margin="6,0,0,0"
                                                                    Padding="4,1"
                                                                    CornerRadius="3"
                                                                    Background="#EFF6FF"
                                                                    BorderBrush="#BFDBFE"
                                                                    BorderThickness="1"
                                                                    Visibility="{Binding SystemBadge, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SystemBadge}" FontSize="9" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Fila 2: Descripción -->
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Descripcion}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.Ink2}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Descripcion}"
                                                               Margin="0,3,0,4" />

                                                    <!-- Fila 3: Acciones e indicador de transferencia -->
                                                    <DockPanel Grid.Row="2" LastChildFill="False">
                                                        <!-- Indicador de zonas -->
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="🗺️ Con desglose por zonas"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Estado inyectado o Botón Inyectar -->
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Visibility="{Binding IsTransferred, Converter={StaticResource BoolToVisibility}}"
                                                                    Background="#DCFCE7"
                                                                    BorderBrush="#86EFAC"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="5,1.5"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="✓ En presupuesto" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                                            </Border>

                                                            <Button Style="{StaticResource InjectButtonStyle}"
                                                                    Command="{Binding DataContext.TransferItemCommand, RelativeSource={RelativeSource AncestorType=local:CubicacionScInspectorControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Inyectar en la fila activa y avanzar a la siguiente (Enter)">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="↵ Inyectar" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════
             FOOTER: ATAJOS DE TECLADO Y GUÍA RÁPIDA
             ══════════════════════════════════════════════ -->
        <Border Grid.Row="5"
                Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[ ↑ / ↓ ] Navegar   [ ↵ ] Inyectar y avanzar   [ Esc ] Cerrar"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
