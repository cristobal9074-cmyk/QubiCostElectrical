<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.PrecioListaResumenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Precio lista del proyecto"
        Width="980" Height="640" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Lista de precios del proyecto" Style="{StaticResource Dialog.HeaderTitle}" />
      <TextBlock Text="Edite precios de materiales usados en cubicación. Los cambios se sincronizan al banco y a la sesión."
                 Style="{StaticResource Dialog.HeaderSubtitle}" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="Agregar…" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
              Click="OnAgregarClick" />
      <TextBox Style="{StaticResource Form.SearchBox}"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrar por código, descripción o proveedor…" />
    </DockPanel>

    <Border Grid.Row="2" Style="{StaticResource Card.Surface}" Padding="0">
      <DataGrid x:Name="MainGrid"
                Style="{StaticResource DataGrid.Workspace.Excel}"
                infra:DataGridExcelNavigation.Enable="True"
                ItemsSource="{Binding Items}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                PreparingCellForEdit="OnGridPreparingCellForEdit"
                CellEditEnding="OnCellEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" Width="110" />
          <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="220" />
          <DataGridTextColumn Header="UD" Binding="{Binding Unidad}" Width="44" IsReadOnly="True" />
          <DataGridTextColumn Header="MAT $ CLP" Binding="{Binding MatClp, UpdateSourceTrigger=LostFocus}" Width="110" />
          <DataGridTextColumn Header="MO $ CLP" Binding="{Binding MoClp, UpdateSourceTrigger=LostFocus}" Width="110" />
          <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="120" IsReadOnly="True" />
          <DataGridTemplateColumn Header="" Width="72">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Quitar" Tag="{Binding}" Click="OnEliminarClick" Padding="6,2" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Popup x:Name="AutocompletePopup"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           IsOpen="{Binding AutocompleteVisible, Mode=TwoWay}">
      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
              CornerRadius="8" Padding="4" MaxHeight="220">
        <ListBox x:Name="AutocompleteList"
                 ItemsSource="{Binding AutocompleteResults}"
                 DisplayMemberPath="DisplayText"
                 PreviewMouseLeftButtonDown="OnAutocompleteMouseDown" />
      </Border>
    </Popup>

    <DockPanel Grid.Row="3" Style="{StaticResource Dialog.Footer}" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"
                 Text="{Binding FilteredCount, StringFormat='{}{0} materiales visibles'}" />
      <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource Button.Primary}" MinWidth="100" IsDefault="True" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
