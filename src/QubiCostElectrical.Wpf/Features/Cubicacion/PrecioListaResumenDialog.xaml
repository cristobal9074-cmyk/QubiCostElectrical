<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.PrecioListaResumenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Lista de Precios del Proyecto (Alt+V)"
        Width="1020" Height="680" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=MainGrid}"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">

  <Window.Resources>
    <Style x:Key="KbdBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    </Style>
  </Window.Resources>

  <Border Style="{StaticResource Dialog.Chrome}" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── CABECERA EJECUTIVA COCKPIT ──────────────────────────────────── -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
        <!-- Métricas ejecutivas a la derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Tarjeta 1: Total Materiales -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="MATERIALES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <TextBlock Text="{Binding TotalCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,1,0,0" />
            </StackPanel>
          </Border>

          <!-- Tarjeta 2: Con Precio -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="CON PRECIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" />
                <TextBlock Text="{Binding ConPrecioCount}" FontSize="13" FontWeight="Bold" Foreground="#047857" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Tarjeta 3: Sin Precio -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="12,6">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="SIN PRECIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,5,0" />
                <TextBlock Text="{Binding SinPrecioCount}" FontSize="13" FontWeight="Bold" Foreground="#B45309" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Título y subtítulo con icono a la izquierda -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Dialog.HeaderIconContainer}" Margin="0,0,12,0">
            <Path Data="M12 2H2v10l9.29 9.29a2 2 0 0 0 2.83 0l6.59-6.59a2 2 0 0 0 0-2.83L12 2Z M7 7h.01"
                  Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="16" Height="16"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Lista de Precios del Proyecto" Style="{StaticResource Dialog.HeaderTitle}" FontSize="16" />
              <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Alt + V" FontFamily="Consolas, Segoe UI Mono, monospace" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Precios base de materiales y mano de obra sincronizados con la cubicación. Lo que crees aquí queda solo en este proyecto."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- ── BUSCADOR SPOTLIGHT, BOTÓN AGREGAR Y FILTROS ────────────────── -->
      <StackPanel Grid.Row="1" Margin="0,0,0,12">
        <DockPanel LastChildFill="True" Margin="0,0,0,10">
          <!-- Botón Agregar Material a la derecha -->
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" Padding="14,7"
                  Click="OnAgregarClick"
                  ToolTip="Formulario completo: código, proveedor y fecha.">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Agregar material" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Alta rápida (Ctrl++): familia + precio + M.O. por fórmula, sin escribir código -->
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Padding="14,7"
                  Click="OnAltaRapidaClick"
                  ToolTip="Alta rápida de material (Ctrl++): familia, precio y M.O. automática (Material × % × FA). El código se genera solo.">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Alta rápida" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Ctrl++" FontFamily="Consolas, Segoe UI Mono, monospace" FontSize="9.5"
                           FontWeight="Bold" Foreground="#BFDBFE" />
              </Border>
            </StackPanel>
          </Button>

          <!-- Input de búsqueda moderno tipo Command Palette -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="10,6">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                  <TextBlock Text="Ctrl+B buscar" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueDark}" />
                </Border>
                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="5,2">
                  <TextBlock Text="ESC limpiar" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                </Border>
              </StackPanel>
              <TextBox x:Name="SearchBox"
                       BorderThickness="0"
                       Background="Transparent"
                       FontSize="12.5"
                       Foreground="{DynamicResource Brush.Ink}"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Tag="Buscar por código, descripción o proveedor… (Ctrl+B)"
                       PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
            </DockPanel>
          </Border>
        </DockPanel>

        <!-- Chips de Filtro Estilo Segmented Control -->
        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,8,0" Padding="12,5" CornerRadius="14" Cursor="Hand"
                      MouseLeftButtonDown="OnFilterChipClick">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="BorderBrush" Value="#0F172A" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Nombre}" FontSize="11" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border CornerRadius="8" Padding="5,1" Margin="6,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#334155" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Count}" FontSize="9.5" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Foreground" Value="#E2E8F0" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- ── GRILLA DE PRECIOS ULTRA-MODERNA ────────────────────────────── -->
      <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="8" Padding="0">
        <DataGrid x:Name="MainGrid"
                  Style="{StaticResource DataGrid.Workspace.Excel}"
                  infra:DataGridExcelNavigation.Enable="True"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  MinRowHeight="34"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F1F5F9"
                  PreparingCellForEdit="OnGridPreparingCellForEdit"
                  CellEditEnding="OnCellEditEnding">
          <DataGrid.Columns>
            <!-- Columna Código -->
            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" Width="120">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="Margin" Value="10,0,4,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Descripción -->
            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="220">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontSize" Value="12" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="Margin" Value="6,0,6,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Unidad -->
            <DataGridTextColumn Header="UD" Binding="{Binding Unidad}" Width="55" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Mat CLP -->
            <DataGridTextColumn Header="MAT $ CLP" Binding="{Binding MatClp, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="115">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="Margin" Value="0,0,10,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna MO CLP -->
            <DataGridTextColumn Header="MO $ CLP" Binding="{Binding MoClp, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="115">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="FontFamily" Value="Consolas, Segoe UI Mono, monospace" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                  <Setter Property="Margin" Value="0,0,10,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Estado / Vigencia con Badges Redondeados -->
            <DataGridTemplateColumn Header="ESTADO" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Padding="8,2" BorderThickness="1"
                          Background="{Binding EstadoBadgeBackground}"
                          BorderBrush="{Binding EstadoBadgeBorder}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="{Binding EstadoDotBrush}" Margin="0,0,5,0" />
                      <TextBlock Text="{Binding EstadoDisplay}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{Binding EstadoBadgeForeground}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- Columna Proveedor -->
            <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Proveedor}" Width="120" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="Margin" Value="6,0,6,0" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <!-- Columna Acciones -->
            <DataGridTemplateColumn Header="" Width="76">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Button.Ghost}" Content="Quitar" Tag="{Binding}"
                          Click="OnEliminarClick" Padding="6,2" FontSize="10.5"
                          Foreground="{DynamicResource Brush.Danger}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Popup Autocomplete IntelliSense -->
      <Popup x:Name="AutocompletePopup"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             IsOpen="{Binding AutocompleteVisible, Mode=TwoWay}">
        <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                CornerRadius="8" Padding="4" MaxHeight="220">
          <ListBox x:Name="AutocompleteList"
                   ItemsSource="{Binding AutocompleteResults}"
                   DisplayMemberPath="DisplayText"
                   PreviewMouseLeftButtonDown="OnAutocompleteMouseDown" />
        </Border>
      </Popup>

      <!-- ── FOOTER RAYCAST / LINEAR COMMAND BAR ───────────────────────── -->
      <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
        <!-- Atajos de teclado en badges KBD -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl++" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Alta rápida" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Ctrl+B" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Buscar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↑" Style="{StaticResource KbdText}" /></Border>
          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="↓" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Navegar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="F2" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Editar celda" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />

          <Border Style="{StaticResource KbdBadge}"><TextBlock Text="Esc" Style="{StaticResource KbdText}" /></Border>
          <TextBlock Text="Cerrar" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />

          <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" FontSize="11"
                     Text="{Binding FilteredCount, StringFormat='{}{0} materiales visibles'}" />
        </StackPanel>

        <!-- Botón de cierre a la derecha -->
        <Button DockPanel.Dock="Right" Content="Cerrar (Esc)" Style="{StaticResource Button.Secondary}"
                MinWidth="110" Height="34" IsCancel="True" Click="OnCerrarClick" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
