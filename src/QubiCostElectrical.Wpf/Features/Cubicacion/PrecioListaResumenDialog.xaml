<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.PrecioListaResumenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Cubicacion"
        Style="{StaticResource Dialog.Window}"
        Title="Lista de Precios"
        Width="1100" Height="680" MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
  <Grid Margin="16,16,16,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Lista de Precios" Style="{StaticResource Text.ViewTitle}" FontSize="22" />
      <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                 Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11"
                 Text="Escriba en CÓDIGO o DESCRIPCIÓN para buscar sugerencias · Esc cierra." />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
      <TextBox DockPanel.Dock="Left" Width="280"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource Form.SearchBox}"
               Tag="Buscar por código, descripción o proveedor…" Height="28" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource Button.Primary}" Content="+ Agregar" Height="28"
                Padding="12,0" FontSize="12" Click="OnAgregarClick" Margin="0,0,6,0" />
        <Button Style="{StaticResource Button.Secondary}" Content="Cerrar" Height="28"
                Padding="12,0" FontSize="12" IsCancel="True" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <DataGrid x:Name="MainGrid" ItemsSource="{Binding Items}"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserSortColumns="True" CanUserReorderColumns="False"
                Style="{StaticResource DataGrid.Workspace}"
                RowHeight="26"
                PreparingCellForEdit="OnGridPreparingCellForEdit"
                CellEditEnding="OnCellEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="CÓDIGO" Width="100"
                              IsReadOnly="False">
            <DataGridTextColumn.Binding>
              <Binding Path="Codigo" ValidatesOnDataErrors="False" UpdateSourceTrigger="LostFocus" />
            </DataGridTextColumn.Binding>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue2}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
              <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="Margin" Value="0" />
              </Style>
            </DataGridTextColumn.EditingElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="DESCRIPCIÓN" Width="*"
                              IsReadOnly="False">
            <DataGridTextColumn.Binding>
              <Binding Path="Descripcion" ValidatesOnDataErrors="False" UpdateSourceTrigger="LostFocus" />
            </DataGridTextColumn.Binding>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="{Binding Descripcion}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
              <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0" />
              </Style>
            </DataGridTextColumn.EditingElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="UD" Binding="{Binding Unidad}" Width="45" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="MAT $ CLP" Width="110"
                              IsReadOnly="False">
            <DataGridTextColumn.Binding>
              <Binding Path="MatClp" StringFormat="N0" ValidatesOnDataErrors="False" UpdateSourceTrigger="LostFocus" />
            </DataGridTextColumn.Binding>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                <Setter Property="Padding" Value="4,2" />
              </Style>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
              <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
              </Style>
            </DataGridTextColumn.EditingElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="MO $ CLP" Width="100"
                              IsReadOnly="False">
            <DataGridTextColumn.Binding>
              <Binding Path="MoClp" StringFormat="N0" ValidatesOnDataErrors="False" UpdateSourceTrigger="LostFocus" />
            </DataGridTextColumn.Binding>
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                <Setter Property="Padding" Value="4,2" />
              </Style>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
              <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
              </Style>
            </DataGridTextColumn.EditingElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Proveedor}" Width="110" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="{Binding Proveedor}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="FECHA" Binding="{Binding FechaPrecio, StringFormat=dd/MM/yyyy}" Width="80" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="VIGENCIA" Width="70" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="6" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VigenciaColor}" Value="Amber">
                          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VigenciaColor}" Value="Danger">
                          <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding VigenciaLabel}" FontSize="9" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding VigenciaColor}" Value="Amber">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding VigenciaColor}" Value="Danger">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header=" " Width="36" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="×" Style="{StaticResource Button.Ghost}" FontSize="11" Padding="1,0"
                        Foreground="{DynamicResource Brush.Danger}" Click="OnEliminarClick" Tag="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <Popup x:Name="AutocompletePopup" StaysOpen="False" Placement="Bottom"
             AllowsTransparency="True" PopupAnimation="Slide"
             IsOpen="{Binding AutocompleteVisible}"
             Width="520" MaxHeight="320">
        <Border CornerRadius="6" Padding="4"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                >
          <ListBox x:Name="AutocompleteList" ItemsSource="{Binding AutocompleteResults}"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   PreviewMouseLeftButtonDown="OnAutocompleteMouseDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,4" CornerRadius="4">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Codigo}" FontFamily="{StaticResource Font.Mono}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue2}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Descripcion}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Unidad}" FontSize="10"
                               Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                               Margin="8,0,12,0" />
                    <TextBlock Grid.Column="3" Text="{Binding MatClpDisplay, StringFormat='MAT ${0}'}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="4" Text="{Binding MoClpDisplay, StringFormat='MO ${0}'}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,8,0,12" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Muted}" FontSize="10"
                 Text="{Binding FilteredCount, StringFormat='{}{0} materiales'}" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
              Content="Cerrar" MinWidth="80" Height="26" FontSize="11" IsCancel="True" />
    </DockPanel>
  </Grid>
</Window>
