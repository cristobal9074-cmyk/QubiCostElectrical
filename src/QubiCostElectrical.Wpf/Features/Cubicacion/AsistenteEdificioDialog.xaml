<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.AsistenteEdificioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Cubicacion"
        Style="{StaticResource Dialog.Window}"
        Title="Asistente de Estructura de Edificio (Modelado BIM 3D)"
        Width="940" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

  <Border Style="{StaticResource Dialog.Chrome}" Margin="16" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ── CABECERA COCKPIT ─────────────────────────────────────────────── -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="10" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="🏢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Asistente de Estructura de Edificio" Style="{StaticResource Dialog.HeaderTitle}" FontSize="16" />
              <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MODELADO 3D BIM" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Brush.BlueDark}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Configure torres, pisos y subterráneos con visualización isométrica en tiempo real para generar los sectores de cubicación."
                       FontSize="11.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- ── CUERPO PRINCIPAL (PARAMÉTRICO + VIEWPORT 3D) ─────────────────── -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" MinWidth="340" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: CONFIGURACIÓN PARAMÉTRICA -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1" CornerRadius="8" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <!-- 1. Cantidad de Torres -->
              <TextBlock Text="CANTIDAD DE TORRES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,6" />
              <DockPanel Margin="0,0,0,14" LastChildFill="True">
                <ComboBox x:Name="ComboTorres" Height="32" SelectedIndex="0" SelectionChanged="OnComboTorresSelectionChanged">
                  <ComboBoxItem Content="1 Torre (Edificio Principal)" Tag="1" />
                  <ComboBoxItem Content="2 Torres Independientes" Tag="2" />
                  <ComboBoxItem Content="3 Torres Independientes" Tag="3" />
                  <ComboBoxItem Content="4 Torres Independientes" Tag="4" />
                </ComboBox>
              </DockPanel>

              <!-- Opciones avanzadas de Torres (Solo si torres > 1) -->
              <StackPanel x:Name="PanelTorresMultiples" Visibility="Collapsed" Margin="0,0,0,10">
                <!-- Nomenclatura -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Nomenclatura" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" x:Name="ComboPrefijo" Height="28" SelectedIndex="0" SelectionChanged="OnComboPrefijoSelectionChanged">
                    <ComboBoxItem Content="Letras (TA, TB)" Tag="LETRAS" />
                    <ComboBoxItem Content="Números (T1, T2)" Tag="NUMEROS" />
                  </ComboBox>
                </Grid>

                <!-- Subterráneo Común Checkbox -->
                <CheckBox x:Name="ChkSubComun" Content="Subterráneo Común Compartido" IsChecked="True" Checked="OnSubComunChanged" Unchecked="OnSubComunChanged" Margin="0,2,0,6" />

                <!-- Torres Compartidas en Todos los Pisos -->
                <CheckBox x:Name="ChkCompartirTodosPisos" Content="Compartir todos los pisos (Torres 100% conectadas)"
                          Checked="OnCompartirTodosPisosChanged" Unchecked="OnCompartirTodosPisosChanged" Margin="0,0,0,8" />

                <!-- Pisos Comunes Stepper -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Pisos Comunes (Podio)" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="Nivel de acceso / placa comercial" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="-" Width="28" Height="28" Click="OnPisosComunesMinusClick" />
                    <TextBox x:Name="TxtPisosComunes" Text="1" Width="42" Height="28" Margin="3,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="OnPisosComunesTextChanged" />
                    <Button Style="{StaticResource Button.Secondary}" Content="+" Width="28" Height="28" Click="OnPisosComunesPlusClick" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Separator Background="{DynamicResource Brush.Line}" Margin="0,4,0,12" />

              <!-- 2. Subterráneos Stepper -->
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Subterráneos" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="Niveles bajo cota de terreno" FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource Button.Secondary}" Content="-" Width="28" Height="28" Click="OnSubterraneosMinusClick" />
                  <TextBox x:Name="TxtSubterraneos" Text="2" Width="42" Height="28" Margin="3,0" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="OnSubterraneosTextChanged" />
                  <Button Style="{StaticResource Button.Secondary}" Content="+" Width="28" Height="28" Click="OnSubterraneosPlusClick" />
                </StackPanel>
              </Grid>

              <Separator Background="{DynamicResource Brush.Line}" Margin="0,4,0,12" />

              <!-- 3. Configuración por Torre (Pisos y Cubiertas) -->
              <TextBlock Text="NIVELES POR CUERPO / TORRE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8" />

              <ItemsControl x:Name="ItemsTorres">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nombre de la Torre -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                          <TextBlock Text="🏢" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Controles de Pisos y Cubiertas -->
                        <Grid Grid.Row="1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <!-- Pisos Totales -->
                          <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Pisos Totales" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Pisos, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                          </StackPanel>

                          <!-- Cubiertas -->
                          <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Cubiertas" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Cubiertas, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- PANEL DERECHO: VIEWPORT 3D BIM ISOMÉTRICO -->
        <local:Building3DViewport x:Name="Viewport3D" Grid.Column="2" />
      </Grid>

      <!-- ── FOOTER ───────────────────────────────────────────────────────── -->
      <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
          <Button Style="{StaticResource Button.Primary}" MinWidth="150" IsDefault="True" Click="OnGenerarClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚡" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Generar Zonas" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Ayuda contextual -->
        <TextBlock Text="El modelo axonométrico representa volumétricamente la altura, subterráneos y torres en tiempo real."
                   FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
