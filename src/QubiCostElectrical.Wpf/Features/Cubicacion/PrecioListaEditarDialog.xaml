<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.PrecioListaEditarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Material"
        Width="520" Height="480" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="TitleBlock" Text="Agregar Material" Style="{StaticResource Text.ViewTitle}" />
      <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                 Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="Complete los datos del material. Los precios se ingresan en CLP." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Código:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CodigoBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Descripción:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DescripcionBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Unidad:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="UnidadCombo" SelectedIndex="0" Margin="0,0,6,8">
          <ComboBoxItem>m</ComboBoxItem>
          <ComboBoxItem>un</ComboBoxItem>
          <ComboBoxItem>kg</ComboBoxItem>
          <ComboBoxItem>m²</ComboBoxItem>
          <ComboBoxItem>m³</ComboBoxItem>
          <ComboBoxItem>lt</ComboBoxItem>
          <ComboBoxItem>gl</ComboBoxItem>
          <ComboBoxItem>pqt</ComboBoxItem>
          <ComboBoxItem>rollo</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Categoría:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="2" Grid.Column="3" x:Name="CategoriaBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Precio MAT $:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MatClpBox" Style="{StaticResource Form.TextBox}" Margin="0,0,6,8" Text="0" />

        <TextBlock Grid.Row="3" Grid.Column="2" Text="MO $:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="3" Grid.Column="3" x:Name="MoClpBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,8" Text="0" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Proveedor:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ProveedorBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Fecha precio:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <DatePicker Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="FechaPicker" Margin="0,0,0,8" />
      </Grid>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Guardar" MinWidth="100" IsDefault="True" Click="OnGuardarClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar" MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
    </DockPanel>
  </Grid>
</Window>
