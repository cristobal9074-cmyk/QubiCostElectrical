<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.PrecioListaEditarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Agregar material a lista"
        Width="480" Height="520" MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock x:Name="TitleBlock" Text="Agregar material"
                   Style="{StaticResource Dialog.HeaderTitle}" />
        <TextBlock Style="{StaticResource Dialog.HeaderSubtitle}"
                   Text="El material se agrega al banco del proyecto y a la lista de precios." />
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Código" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="CodigoBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" />

          <TextBlock Text="Descripción" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="DescripcionBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" />

          <TextBlock Text="Unidad" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <ComboBox x:Name="UnidadCombo" Style="{StaticResource Form.ComboBox}" Margin="0,0,0,10"
                    SelectedIndex="0">
            <ComboBoxItem Content="un" />
            <ComboBoxItem Content="m" />
            <ComboBoxItem Content="m2" />
            <ComboBoxItem Content="m3" />
            <ComboBoxItem Content="kg" />
            <ComboBoxItem Content="gl" />
          </ComboBox>

          <TextBlock Text="Categoría" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="CategoriaBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" />

          <TextBlock Text="Material CLP" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="MatClpBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" Text="0" />

          <TextBlock Text="Mano de obra CLP" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="MoClpBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" Text="0" />

          <TextBlock Text="Proveedor" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="ProveedorBox" Style="{StaticResource Form.TextBox}" Margin="0,0,0,10" />

          <TextBlock Text="Fecha" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
          <DatePicker x:Name="FechaPicker" Margin="0,0,0,4" />
        </StackPanel>
      </ScrollViewer>

      <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Guardar"
                MinWidth="100" IsDefault="True" Click="OnGuardarClick" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
                MinWidth="100" IsCancel="True" Margin="0,0,8,0" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
