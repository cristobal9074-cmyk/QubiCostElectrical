<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.HojaCubicacionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Hoja de Cubicación"
        Width="980" Height="620" MinWidth="740" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Closed="OnDialogClosed"
        KeyDown="OnWindowKeyDown">
  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <!-- Header Ultra-Limpio -->
      <RowDefinition Height="Auto" />
      <!-- Banner Selección (opcional) -->
      <RowDefinition Height="Auto" />
      <!-- Contenido / Partidas -->
      <RowDefinition Height="*" />
      <!-- Footer Delgado -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header Minimalista y Profesional ("Menos es más") -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Dialog.HeaderIconContainer}" Margin="0,0,10,0">
          <Path Data="M3 3h18v18H3z M3 9h18 M3 15h18 M9 3v18 M15 3v18"
                Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="15" Height="15"/>
        </Border>
        <TextBlock Text="Hoja de Cubicación" Style="{StaticResource Dialog.HeaderTitle}" VerticalAlignment="Center" Margin="0,0,10,0" />

        <!-- Botón discreto de atajos -->
        <Button x:Name="BtnToggleHelp" Style="{StaticResource Button.Ghost}" Height="24" Padding="6,0"
                Click="OnToggleHelpClick" ToolTip="Ver guía de atajos de teclado y funciones">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⌨ Atajos" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Popup con la chuleta de funciones y teclado -->
        <Popup x:Name="HelpPopup" StaysOpen="False"
               PlacementTarget="{Binding ElementName=BtnToggleHelp}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  CornerRadius="8" Padding="14" Width="440" Margin="0,4,0,0">
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Direction="270" />
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="Atajos de Teclado y Fórmulas Tipo Excel" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,8" />
              
              <TextBlock Text="NAVEGACIÓN Y EDICIÓN RÁPIDA:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Flechas / Point Mode:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Señalar celdas para fórmulas (=C1*H2)" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Enter / Tab:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Confirmar y bajar fila o avanzar columna" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="F2 / Escribir directo:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Editar celda in-situ al instante" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Delete / Backspace:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Limpiar celdas seleccionadas" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+C / Ctrl+V:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Copiar y pegar rangos con Excel" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
              </Grid>

              <Separator Style="{StaticResource Separator.Subtle}" />

              <TextBlock Text="FÓRMULAS SOPORTADAS:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Green}" Margin="0,0,0,4" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="=C1-H2  o  C1*H2:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Operaciones cruzadas directas" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="=SUMA(C:E):" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Suma de rango continuo" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="=PROMEDIO(C:E):" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Promedio de celdas" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="=REDONDEAR(C; 2):" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Redondeo numérico con decimales" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="=C * 15%:" FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Operador de porcentaje directo" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
              </Grid>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>

      <!-- Controles de cabecera a la derecha -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Botones Expandir / Colapsar discretos -->
        <Button Style="{StaticResource Button.Ghost}" Width="24" Height="24" Padding="0" Margin="0,0,2,0"
                Click="OnExpandAllClick" ToolTip="Expandir todas las partidas" Content="▾" FontSize="13" />
        <Button Style="{StaticResource Button.Ghost}" Width="24" Height="24" Padding="0" Margin="0,0,8,0"
                Click="OnCollapseAllClick" ToolTip="Colapsar todas las partidas" Content="▸" FontSize="13" />

        <!-- Botón + Agregar Partida -->
        <Button Style="{StaticResource Button.Primary}" Height="28" Padding="12,0"
                Content="+ Partida" Click="OnAddItemClick" FontSize="12" />
      </StackPanel>
    </DockPanel>

    <!-- Banner Modo Selección (solo visible cuando se abre para elegir valor) -->
    <Border Grid.Row="1" x:Name="PickModeBanner" Visibility="Collapsed" Background="{DynamicResource Brush.GreenSoft}"
            BorderBrush="{DynamicResource Brush.Green}" BorderThickness="1" CornerRadius="6"
            Padding="8,5" Margin="0,0,0,8">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Desmarcar todo" Style="{StaticResource Button.Ghost}"
                Height="22" Padding="6,0" FontSize="11" Click="OnClearAllPickedClick"
                ToolTip="Quita la marca de 'tomado' de todas las filas y partidas" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🎯" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Green}" FontWeight="Bold" VerticalAlignment="Center"
                     Text="Modo selección: Clic en la columna Suma para transferir cantidad (se marcará en verde claro). Clic derecho en cualquier fila para desmarcarla." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Lista de Partidas de Cubicación -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ItemsHost">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
              <StackPanel>
                <!-- Encabezado de la partida (Compacto y Elegante) -->
                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,0,0,1" Padding="8,5" CornerRadius="6,6,0,0">
                  <DockPanel LastChildFill="True">
                    <!-- Flecha colapsar sutil -->
                    <Button DockPanel.Dock="Left" Content="{Binding CollapseIcon}"
                            Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                            Style="{StaticResource Button.Ghost}" Padding="0" FontSize="11"
                            Click="OnToggleCollapseClick" Tag="{Binding}"
                            ToolTip="Colapsar / expandir partida" />

                    <!-- Código Partida -->
                    <TextBox DockPanel.Dock="Left" Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                             Width="60" Height="22" Margin="0,0,6,0" VerticalAlignment="Center"
                             FontSize="11" FontFamily="{StaticResource Font.Mono}"
                             ToolTip="Código de partida" />
                    <!-- Título de partida (ocupa todo el espacio central) -->
                    <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" Height="22" FontWeight="SemiBold" FontSize="12"
                             ToolTip="Descripción de la partida" />
                  </DockPanel>
                </Border>

                <!-- Cuerpo de la partida: Toolbar + Barra fx + Planilla de cálculo -->
                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                  
                  <!-- Barra Única Integrada: Acciones + Barra de fórmulas estilo Excel 365 -->
                  <Border Margin="8,5,8,5" Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="4,2">
                    <DockPanel LastChildFill="True">
                      <!-- Botones compactos + Fila y + Columna -->
                      <Button DockPanel.Dock="Left" Content="+ Fila" Style="{StaticResource Button.Secondary}"
                              Height="22" Padding="6,0" FontSize="11" Click="OnAddRowClick" Tag="{Binding}"
                              ToolTip="Agregar fila a esta partida (Ctrl+Plus)" />
                      <Button DockPanel.Dock="Left" Content="+ Col" Style="{StaticResource Button.Secondary}"
                              Height="22" Padding="6,0" Margin="4,0,6,0" FontSize="11" Click="OnAddColumnClick" Tag="{Binding}"
                              ToolTip="Agregar columna a esta partida" />

                      <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource Brush.Line}" Margin="0,2,6,2" />

                      <!-- Celda Activa (ej: C1) -->
                      <Border DockPanel.Dock="Left" Background="{DynamicResource Brush.Surface}"
                              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="3"
                              Padding="4,0" MinWidth="40" Height="22" Margin="0,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FormulaBarRef" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <!-- Botón fx -->
                      <Button DockPanel.Dock="Left" x:Name="BtnFx" Style="{StaticResource Button.Ghost}"
                              Content="fx" FontStyle="Italic" FontWeight="Bold" FontSize="11" Width="24" Height="22"
                              Margin="0,0,4,0" Padding="0" Click="OnFxButtonClick"
                              ToolTip="Insertar función (=SUMA, =PROMEDIO, =MIN, =MAX, =REDONDEAR...)" />

                      <!-- Preview en tiempo real del cálculo -->

                      <!-- Input de la fórmula -->
                      <TextBox x:Name="FormulaBarInput" VerticalAlignment="Center" Height="22"
                               FontFamily="{StaticResource Font.Mono}" FontSize="11" IsEnabled="False"
                               BorderThickness="0" Background="Transparent"
                               KeyDown="OnFormulaBarKeyDown" PreviewKeyDown="OnFormulaBarPreviewKeyDown"
                               LostFocus="OnFormulaBarLostFocus" TextChanged="OnFormulaBarTextChanged"
                               ToolTip="Valor o fórmula tipo Excel (ej. =SUMA(C:E), =C1*H2, C1-H2). Enter para confirmar." />
                    </DockPanel>
                  </Border>

                  <!-- Grilla de Cubicación Estilo Excel Compacto y Rápido -->
                  <DataGrid ItemsSource="{Binding Filas}"
                            Style="{StaticResource DataGrid.Workspace.Excel}"
                            infra:DataGridExcelNavigation.Enable="True"
                            infra:DataGridExcelNavigation.HandleCellEditorByHost="True"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="False"
                            CanUserReorderColumns="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            FrozenColumnCount="2"
                            RowHeight="26" MaxHeight="260"
                            Margin="8,0,8,8"
                            Loaded="OnItemGridLoaded">
                    <DataGrid.RowStyle>
                      <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Excel}">
                        <Style.Triggers>
                          <!-- Fila de nombres de columna (etiquetas de sectores): azul suave moderno -->
                          <DataTrigger Binding="{Binding IsLabelRow}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                          <!-- Fila tomada / transferida: fondo verde claro suave para toda la fila -->
                          <DataTrigger Binding="{Binding IsPicked}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsPicked}" Value="True" />
                              <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.RowStyle>
                  </DataGrid>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Footer Sobrio y Limpio -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Listo"
              MinWidth="100" Height="34" FontSize="12" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
