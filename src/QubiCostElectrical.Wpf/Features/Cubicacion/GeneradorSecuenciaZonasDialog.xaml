<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.GeneradorSecuenciaZonasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Generar secuencia de zonas"
        Width="520" Height="500" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Generar secuencia de zonas" Style="{StaticResource Text.ViewTitle}" />
      <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Muted}"
                 Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="Elija un patrón predefinido o configure una secuencia personalizada. Las zonas generadas se agregarán al final de la lista actual." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource Card.Surface}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Patrón:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,10" />
          <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PresetCombo"
                    SelectedIndex="0" SelectionChanged="OnPresetChanged"
                    Margin="0,0,0,10">
            <ComboBoxItem Content="Personalizado" Tag="custom" />
            <ComboBoxItem Content="Sectores genéricos (S1, S2, S3…)" Tag="sectores" />
            <ComboBoxItem Content="Pisos (P1, P2, P3…)" Tag="pisos" />
            <ComboBoxItem Content="Zonas (Zona 1, Zona 2…)" Tag="zonas" />
            <ComboBoxItem Content="Niveles (Nivel 1, Nivel 2…)" Tag="niveles" />
            <ComboBoxItem Content="Locales (Local A, Local B…)" Tag="locales" />
            <ComboBoxItem Content="Áreas (Área 1, Área 2…)" Tag="areas" />
            <ComboBoxItem Content="Torre + Piso (TA-P1, TA-P2…)" Tag="torre-piso" />
          </ComboBox>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Prefijo:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,8" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="PrefixBox" Text="S"
                   Margin="0,0,6,8" />

          <TextBlock Grid.Row="1" Grid.Column="2" Text="Separador:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,8" />
          <ComboBox Grid.Row="1" Grid.Column="3" x:Name="SeparatorCombo" SelectedIndex="0" Margin="0,0,0,8">
            <ComboBoxItem Content="(ninguno)" Tag="" />
            <ComboBoxItem Content="-" Tag="-" />
            <ComboBoxItem Content="/" Tag="/" />
            <ComboBoxItem Content=" " Tag=" " />
          </ComboBox>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Número inicial:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,8" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="StartBox" Text="1"
                   Margin="0,0,6,8" TextChanged="OnFieldChanged" />

          <TextBlock Grid.Row="2" Grid.Column="2" Text="Número final:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,8" />
          <TextBox Grid.Row="2" Grid.Column="3" x:Name="EndBox" Text="30"
                   Margin="0,0,0,8" TextChanged="OnFieldChanged" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Paso:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,8" />
          <TextBox Grid.Row="3" Grid.Column="1" x:Name="StepBox" Text="1"
                   Margin="0,0,6,8" TextChanged="OnFieldChanged" />

          <TextBlock Grid.Row="3" Grid.Column="2" Text="Sufijo:" Style="{StaticResource Form.Label}"
                     VerticalAlignment="Center" Margin="0,0,8,8" />
          <TextBox Grid.Row="3" Grid.Column="3" x:Name="SuffixBox" Text=""
                   Margin="0,0,0,8" TextChanged="OnFieldChanged" />

          <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="TwoLevelCheck"
                    Content="Dos niveles (torre + piso)" IsChecked="False"
                    Checked="OnTwoLevelChanged" Unchecked="OnTwoLevelChanged"
                    Margin="0,0,0,8" FontWeight="SemiBold" />

          <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" x:Name="TwoLevelPanel"
                  Visibility="Collapsed" Style="{StaticResource Card.Surface}" Padding="10" Margin="0,0,0,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Nivel 1 (torre):" VerticalAlignment="Center"
                         FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,6,6" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="Level1Prefix" Text="T"
                       Margin="0,0,6,6" TextChanged="OnFieldChanged" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="a" VerticalAlignment="Center"
                         FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,6,6" />
              <TextBox Grid.Row="0" Grid.Column="3" x:Name="Level1End" Text="3"
                       Margin="0,0,0,6" ToolTip="Cantidad de torres" TextChanged="OnFieldChanged" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Nivel 2 (piso):" VerticalAlignment="Center"
                         FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,6,0" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="Level2Prefix" Text="P"
                       Margin="0,0,6,0" TextChanged="OnFieldChanged" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="del 1 al" VerticalAlignment="Center"
                         FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,6,0" />
              <TextBox Grid.Row="1" Grid.Column="3" x:Name="Level2End" Text="10"
                       Margin="0,0,0,0" ToolTip="Cantidad de pisos" TextChanged="OnFieldChanged" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Top">
            <TextBlock Text="Vista previa:" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,0,4" />
            <Border Style="{StaticResource Card.Surface}" Background="{DynamicResource Brush.Surface2}" Padding="8" MinHeight="60">
              <ListBox x:Name="PreviewList" BorderThickness="0" Background="Transparent"
                       MaxHeight="100">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="11"
                               FontFamily="{StaticResource Font.Mono}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Agregar zonas"
              MinWidth="120" IsDefault="True" Click="OnAcceptClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Cancelar"
              MinWidth="100" Margin="0,0,8,0" IsCancel="True" />
    </DockPanel>
  </Grid>
</Window>