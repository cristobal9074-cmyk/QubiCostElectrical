<UserControl x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.CubicacionStatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource Brush.WorkspaceBar}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
            Padding="16,4" MinHeight="28">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource Shell.StatusBarText}"
                           Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Shell.StatusBarText}">
                        <Run Text="{Binding Rows.Count, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" recursos" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                        Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource Shell.StatusBarText}">
                        <Run Text="MO unit " /><Run Text="{Binding SelectedRow.MoClpDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · MO fila " /><Run Text="{Binding SelectedRow.MoSubtotalClpDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                    <TextBlock Text="Tab" Style="{StaticResource Text.Kbd}" Background="Transparent" Padding="0" />
                </Border>
                <TextBlock Style="{StaticResource Shell.StatusBarText}" Text="navegar · " />
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                    <TextBlock Text="Ctrl+V" Style="{StaticResource Text.Kbd}" Background="Transparent" Padding="0" />
                </Border>
                <TextBlock Style="{StaticResource Shell.StatusBarText}" Text="pegar · Alt+↑↓ mover filas" />
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSectorMatrixMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFormulaStatus}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                        <TextBlock Text="fx" Style="{StaticResource Text.Kbd}" FontStyle="Italic" Background="Transparent" Padding="0" />
                    </Border>
                    <TextBlock ToolTip="{Binding FormulaDialectText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Shell.StatusBarText}">
                                <Setter Property="Text" Value="las casillas admiten fórmulas (2+3, 10/2, R1, U1) · escriba un operador y use ↑↓ para referenciar otra fila" />
                                <Setter Property="ToolTip" Value="{Binding FormulaDialectText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFormulaStatus}" Value="True">
                                        <Setter Property="Text" Value="{Binding FormulaStatusText}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
