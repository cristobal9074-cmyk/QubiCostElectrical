<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.FamilyBatchReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambio de Línea o Familia Masivo — Ingeniería de Valor"
        Width="1080" Height="720"
        MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource Dialog.Window}">
    <Border Style="{StaticResource Dialog.Chrome}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0. Header -->
                <RowDefinition Height="Auto" /> <!-- 1. Presets & Rule Bar -->
                <RowDefinition Height="*" />    <!-- 2. Interactive DataGrid -->
                <RowDefinition Height="Auto" /> <!-- 3. Selected Row Customizer Bar -->
                <RowDefinition Height="Auto" /> <!-- 4. Cockpit Financiero -->
                <RowDefinition Height="Auto" /> <!-- 5. Actions Footer -->
            </Grid.RowDefinitions>

            <!-- 0. Encabezado Ejecutivo -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Cambio de Línea o Familia de Materiales (Ingeniería de Valor)" Style="{StaticResource Dialog.HeaderTitle}" />
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Chip}" Padding="8,3">
                        <TextBlock Text="⚡ Mantiene intactos metrajes, casillas y fórmulas" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                    </Border>
                </DockPanel>
                <TextBlock Text="Sustituya familias completas de materiales en todo el presupuesto (ej. Bticino Magic a Sinthesi o PVC a Libre Halógenos), con auto-resolución en el Banco de Precios e impacto financiero en vivo."
                           Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- 1. Perfiles Guardados y Barra de Regla de Mapeo -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Fila Superior: Perfiles Guardados -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <TextBlock Text="Perfil de Conversión:" FontWeight="Bold" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="SavePresetBtn" Content="Guardar Perfil Actual…" Style="{StaticResource Button.Secondary}" Height="28" Padding="10,2" Margin="0,0,6,0" Click="OnSavePresetClick" ToolTip="Guarda esta regla de conversión para usarla en otros proyectos" />
                            <Button x:Name="DeletePresetBtn" Content="Eliminar Perfil" Style="{StaticResource Button.Ghost}" Height="28" Padding="8,2" Click="OnDeletePresetClick" ToolTip="Elimina el perfil personalizado seleccionado" />
                        </StackPanel>
                        <ComboBox x:Name="PresetComboBox" Height="28" SelectionChanged="OnPresetSelectionChanged" DisplayMemberPath="Name" ToolTip="Seleccione una regla preconfigurada o guardada" />
                    </DockPanel>

                    <!-- Fila Inferior: Filtro y Regla Rápida -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Filtro de materiales usados -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1. FILTRAR MATERIALES EN USO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,3" />
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource Button.Secondary}" Height="28" Padding="8,2" Margin="4,0,0,0" Click="OnFilterClick" />
                                <TextBox x:Name="FilterBox" Height="28" VerticalContentAlignment="Center" Padding="6,2" Tag="Prefijo o texto (ej: magic, PVC)" KeyDown="OnFilterKeyDown" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Separador vertical -->
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" Margin="7,2" />

                        <!-- Regla de Conversión Automática -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="2. REGLA RÁPIDA DE CONVERSIÓN DE CÓDIGO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Cambiar prefijo [" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.sm}" Margin="0,0,4,0" />
                                <TextBox x:Name="SourcePrefixBox" Width="100" Height="28" VerticalContentAlignment="Center" Padding="6,2" ToolTip="Prefijo a buscar en el código origen (ej. magic)" />
                                <TextBlock Text="] por [" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.sm}" Margin="4,0,4,0" />
                                <TextBox x:Name="TargetPrefixBox" Width="100" Height="28" VerticalContentAlignment="Center" Padding="6,2" ToolTip="Nuevo prefijo a colocar (ej. s179/)" />
                                <TextBlock Text="]" VerticalAlignment="Center" FontSize="{StaticResource Font.Size.sm}" Margin="4,0,10,0" />
                                <Button x:Name="AutoMapBtn" Content="⚡ Auto-Mapear con Banco de Precios" Style="{StaticResource Button.Primary}" Height="28" Padding="12,2" FontWeight="SemiBold" Click="OnAutoMapClick" ToolTip="Calcula los nuevos códigos y busca sus precios y fichas en el Banco de Precios" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Selección Todo / Nada -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="Todos" Style="{StaticResource Button.Ghost}" Height="26" Padding="6,2" Click="OnSelectAllClick" Margin="0,0,4,0" />
                            <Button Content="Ninguno" Style="{StaticResource Button.Ghost}" Height="26" Padding="6,2" Click="OnDeselectAllClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Matriz de Reemplazo (DataGrid) -->
            <GroupBox Grid.Row="2" Header="MATRIZ DE CONVERSIÓN Y MATERIALES AFECTADOS" FontSize="{StaticResource Font.Size.sm}" FontWeight="Bold" Margin="0,0,0,6">
                <DataGrid x:Name="MappingGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionChanged="OnMappingGridSelectionChanged"
                          Style="{StaticResource DataGrid.Workspace}">
                    <DataGrid.Columns>
                        <!-- Seleccionar -->
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <EventSetter Event="Click" Handler="OnGridCellCheckChanged" />
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- Origen: Código -->
                        <DataGridTemplateColumn Header="Código Actual" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceCodigo}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Padding="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Origen: Descripción -->
                        <DataGridTextColumn Header="Descripción Actual" Binding="{Binding SourceDescripcion}" Width="190" IsReadOnly="True" />

                        <!-- Metraje Total -->
                        <DataGridTextColumn Header="Cant. Total" Binding="{Binding CantidadTotal, StringFormat={}{0:N0}}" Width="75" IsReadOnly="True" />

                        <!-- P.U. Actual -->
                        <DataGridTextColumn Header="P.U. Actual" Binding="{Binding PrecioActualClp, StringFormat={}$ {0:N0}}" Width="85" IsReadOnly="True" />

                        <!-- Flecha -->
                        <DataGridTemplateColumn Header="" Width="24">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="➔" Foreground="{DynamicResource Brush.Blue}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Destino: Código Nuevo (Editable) -->
                        <DataGridTemplateColumn Header="Código Reemplazo" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetCodigo}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Padding="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding TargetCodigo, UpdateSourceTrigger=LostFocus}" LostFocus="OnTargetCodeCellLostFocus" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Destino: Descripción Nueva -->
                        <DataGridTextColumn Header="Nueva Descripción" Binding="{Binding TargetDescripcion}" Width="190" IsReadOnly="True" />

                        <!-- Nuevo P.U. -->
                        <DataGridTextColumn Header="Nuevo P.U." Binding="{Binding NuevoPrecioClp, StringFormat={}$ {0:N0}}" Width="85" IsReadOnly="True" />

                        <!-- Delta Unitario -->
                        <DataGridTextColumn Header="Δ P.U." Binding="{Binding DeltaUnitarioClp, StringFormat={}$ {0:N0}}" Width="75" IsReadOnly="True" />

                        <!-- Delta Total -->
                        <DataGridTextColumn Header="Δ Costo Total" Binding="{Binding DeltaClp, StringFormat={}$ {0:N0}}" Width="95" IsReadOnly="True" />

                        <!-- Estado / Badge -->
                        <DataGridTemplateColumn Header="Estado" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="InCubicacion">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="InBank">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Manual">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="NotFound">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="InCubicacion">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InBank">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Manual">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NotFound">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- 3. Asistente de Búsqueda para Fila Seleccionada -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="10,6" Margin="0,0,0,8">
                <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Asignar reemplazo manual:" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="SelectedRowInfoText" Text="(Seleccione una fila)" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox x:Name="IncludePriceBankCheck" DockPanel.Dock="Right" Content="Buscar también en Banco de Precios" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Click="OnIncludePriceBankCheckChanged" ToolTip="Por defecto solo busca materiales presentes en la Cubicación del proyecto" />
                    <TextBox x:Name="RowSearchBox" Height="26" VerticalContentAlignment="Center" Padding="6,2" TextChanged="OnRowSearchTextChanged" PreviewKeyDown="OnRowSearchPreviewKeyDown" Tag="Buscar código o descripción en Cubicación (ej: s17, 9/12)…" />
                </DockPanel>
                <TextBlock x:Name="RowSearchStatus" Text="" FontSize="11" Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- Popup de sugerencias para fila seleccionada -->
            <Popup x:Name="RowSearchPopup" PlacementTarget="{Binding ElementName=RowSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MinWidth="480" MaxHeight="240">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Padding="4">
                    <ListBox x:Name="RowSearchSuggestionsList" SelectionChanged="OnRowSuggestionSelected" MaxHeight="220" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,3" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Codigo}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" Width="110" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding PrecioDisplay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- 4. Cockpit de Impacto Financiero en Vivo -->
            <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Métricas Financieras Agregadas -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock x:Name="CockpitPartidasText" Text="0 Partidas afectadas" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" FontSize="{StaticResource Font.Size.sm}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock x:Name="CockpitUnidadesText" Text="0 Elementos totales" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" FontSize="{StaticResource Font.Size.sm}" />
                        </Border>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,14,0">
                            <TextBlock x:Name="CockpitCostosText" Text="Costo Anterior: $ 0 ➔ Nuevo: $ 0" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" />
                            <TextBlock x:Name="CockpitDeltaText" Text="Variación Costo Directo: $ 0 CLP (0.0%)" FontWeight="Bold" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Checkboxes de Alcance -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Aplicar en:" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="ReplaceCubicacionCheck" Content="Cubicación" IsChecked="True" Margin="0,0,10,0" Checked="OnScopeOptionChanged" Unchecked="OnScopeOptionChanged" />
                        <CheckBox x:Name="ReplaceApuCheck" Content="APUs" IsChecked="True" Checked="OnScopeOptionChanged" Unchecked="OnScopeOptionChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Barra de Acciones / Footer -->
            <DockPanel Grid.Row="5" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Cancelar (Esc)" Style="{StaticResource Button.Ghost}"
                        Padding="14,6" Click="OnCancelClick" IsCancel="True" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CreateVariantButton"
                            Content="Crear como Oferta Variante"
                            Style="{StaticResource Button.Secondary}"
                            Padding="14,7" Margin="0,0,10,0"
                            ToolTip="Clona el presupuesto actual como una nueva versión alternativa con esta familia aplicada"
                            Click="OnCreateVariantClick" />

                    <Button x:Name="ExecuteButton"
                            Content="Aplicar en Presupuesto Actual"
                            Style="{StaticResource Button.Primary}"
                            Padding="20,7" FontWeight="Bold"
                            ToolTip="Aplica las sustituciones en las partidas seleccionadas (Permite deshacer con Ctrl+Z)"
                            Click="OnExecuteClick" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
