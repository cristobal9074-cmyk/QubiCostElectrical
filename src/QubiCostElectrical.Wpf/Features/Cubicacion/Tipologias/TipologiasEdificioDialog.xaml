<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.Tipologias.TipologiasEdificioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="🏢 Tipologías Habitacionales y Cubicación Masiva de Edificio"
        Width="1050" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <!-- Cabecera -->
      <RowDefinition Height="Auto" />
      <!-- Tabs y contenido -->
      <RowDefinition Height="*" />
      <!-- Barra inferior -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── CABECERA ──────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Cubicación Paramétrica de Departamentos y Recintos Tipo"
                     FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Text="Define la dotación unitaria por tipo de depto y distribúyelos en los pisos del edificio. Reemplaza matrices manuales masivas."
                     FontSize="11" Foreground="{DynamicResource Brush.Ink3}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- KPI Pill Bar -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="TIPOLOGÍAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
              <TextBlock Text="{Binding TotalTipologiasCount}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="TOTAL DEPTOS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
              <TextBlock Text="{Binding TotalDepartamentos}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,4">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="TOTAL VENTA EST." FontSize="9" FontWeight="Bold" Foreground="#15803D" />
              <TextBlock Text="{Binding TotalCostoUf, StringFormat='{}{0:N1} UF'}" FontSize="13" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── TABS PRINCIPALES ──────────────────────────────── -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Style="{StaticResource Form.TabControl}">

      <!-- TAB 1: DEFINICIÓN DE TIPOLOGÍAS -->
      <TabItem Header="1. Departamentos Tipo y Puntos Unitarios">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <!-- Panel izquierdo: Tipologías -->
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <!-- Panel derecho: Recursos unitarios -->
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Lista de Tipologías -->
          <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Tipologías Configuradas" FontWeight="Bold" FontSize="12"
                         Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,8" />

              <ListBox Grid.Row="1" ItemsSource="{Binding Tipologias}" SelectedItem="{Binding SelectedTipologia}"
                       BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="6,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Codigo}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.BlueDark}" />
                          <TextBlock Text="{Binding Nombre}" FontSize="11" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SuperficieM2, StringFormat='{}{0:N0} m²'}" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TotalItems, StringFormat='{}{0} pts'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Primary}" Content="+ Nueva Tipología" Command="{Binding AgregarTipologiaCommand}" Padding="8,4" Margin="0,0,6,0" />
                <Button Style="{StaticResource Button.Secondary}" Content="Eliminar" Command="{Binding EliminarTipologiaCommand}" Padding="8,4" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Detalle de la Tipología Seleccionada -->
          <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Cabecera de la tipología -->
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Código" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                  <TextBox Text="{Binding SelectedTipologia.Codigo, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Nombre del Recinto / Departamento" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                  <TextBox Text="{Binding SelectedTipologia.Nombre, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                  <TextBlock Text="Superficie (m²)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                  <TextBox Text="{Binding SelectedTipologia.SuperficieM2, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>

              <!-- Separador -->
              <TextBlock Grid.Row="1" Text="Recursos y Puntos Eléctricos por Cada Unidad" FontWeight="Bold" FontSize="11"
                         Foreground="{DynamicResource Brush.Ink2}" Margin="0,4,0,6" />

              <!-- DataGrid de Puntos Unitarios -->
              <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedTipologia.Items}" SelectedItem="{Binding SelectedItem}"
                        AutoGenerateColumns="False" CanUserAddRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        RowHeight="26" BorderBrush="{DynamicResource Brush.Line}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                  <DataGridTextColumn Header="Descripción del Punto / Material" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                  <DataGridTextColumn Header="Un" Binding="{Binding Unidad, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                  <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                  <DataGridTextColumn Header="Cant/Depto" Binding="{Binding CantidadPorDepto, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N1}'}" Width="80" />
                  <DataGridTextColumn Header="Mat CLP" Binding="{Binding MatClp, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Width="80" />
                  <DataGridTextColumn Header="MO CLP" Binding="{Binding MoClp, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" Width="80" />
                  <DataGridTextColumn Header="Partida Dest." Binding="{Binding PartidaCodigo, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- Barra de acciones de insumos -->
              <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Button.Secondary}" Content="+ Agregar Insumo" Command="{Binding AgregarInsumoCommand}" Padding="10,4" Margin="0,0,6,0" />
                <Button Style="{StaticResource Button.Ghost}" Content="Eliminar Insumo" Command="{Binding EliminarInsumoCommand}" Padding="8,4" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 2: DISTRIBUCIÓN POR PISOS -->
      <TabItem Header="2. Matriz de Distribución por Pisos">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Herramienta de generación rápida -->
          <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Asignación de Unidades Habitacionales por Nivel" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Especifique cuántos departamentos de cada tipología existen en cada piso o zona." FontSize="11" Foreground="{DynamicResource Brush.Ink3}" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="⚡ Generar Edificio Típico (Pisos 1 a 15)" Command="{Binding GenerarPisosCommand}" Padding="12,5" />
            </Grid>
          </Border>

          <!-- Grilla de distribución -->
          <DataGrid Grid.Row="1" ItemsSource="{Binding Distribucion}" AutoGenerateColumns="False" CanUserAddRows="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Piso / Zona" Binding="{Binding ZonaNombre, UpdateSourceTrigger=PropertyChanged}" Width="160" />
              <DataGridTextColumn Header="Tipología Asignada" Binding="{Binding TipologiaNombre}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Cantidad Deptos" Binding="{Binding CantidadDeptos, UpdateSourceTrigger=PropertyChanged}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- TAB 3: CONSOLIDADO Y CUBICACIÓN -->
      <TabItem Header="3. Consolidado y Cubicación de Obra">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Banner Informativo -->
          <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Lista Consolidada de Materiales de Departamentos" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" />
                <TextBlock Text="Multiplicación paramétrica automática para todas las unidades del edificio." FontSize="11" Foreground="#3B82F6" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="🔄 Recalcular Consolidado" Command="{Binding RecalcularCommand}" Padding="10,4" />
            </Grid>
          </Border>

          <!-- Grilla de Materiales Consolidados -->
          <DataGrid Grid.Row="1" ItemsSource="{Binding Consolidados}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90" />
              <DataGridTextColumn Header="Descripción Material / Recurso" Binding="{Binding Descripcion}" Width="*" />
              <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120" />
              <DataGridTextColumn Header="Un" Binding="{Binding Unidad}" Width="45" />
              <DataGridTextColumn Header="Cantidad Total" Binding="{Binding CantidadTotal, StringFormat='{}{0:N1}'}" Width="110" />
              <DataGridTextColumn Header="P.U. Mat CLP" Binding="{Binding MatClp, StringFormat='{}{0:N0}'}" Width="100" />
              <DataGridTextColumn Header="Total Mat CLP" Binding="{Binding TotalMatClp, StringFormat='{}{0:N0}'}" Width="110" />
              <DataGridTextColumn Header="Partida Mapeada" Binding="{Binding PartidaCodigo}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- Resumen de Costos -->
          <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total Materiales: " FontSize="12" Foreground="{DynamicResource Brush.Ink3}" />
                <TextBlock Text="{Binding TotalMaterialesClp, StringFormat='${0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,16,0" />

                <TextBlock Text="Total M.O.: " FontSize="12" Foreground="{DynamicResource Brush.Ink3}" />
                <TextBlock Text="{Binding TotalManoObraClp, StringFormat='${0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,16,0" />

                <TextBlock Text="Total Directo: " FontSize="12" Foreground="{DynamicResource Brush.Ink3}" />
                <TextBlock Text="{Binding TotalCostoClp, StringFormat='${0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.BlueDark}" />
              </StackPanel>

              <TextBlock Grid.Column="1" Text="{Binding TotalCostoUf, StringFormat='{}{0:N2} UF'}" FontSize="16" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- ── BARRA INFERIOR DE ACCIONES ────────────────────── -->
    <Border Grid.Row="2" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource Button.Ghost}" Content="Cancelar" Click="OnCancelClick" HorizontalAlignment="Left" MinWidth="100" Height="32" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Primary}" Content="✓ Guardar y Volcar a Cubicación de Obra" Click="OnSaveAndApplyClick" MinWidth="220" Height="34" Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Secondary}" Content="Guardar Tipologías" Click="OnSaveOnlyClick" MinWidth="130" Height="34" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
