<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.ExcelPastePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Previsualizar pegado"
        Width="720" Height="500" MinWidth="640" MinHeight="420">
  <Border Style="{StaticResource Dialog.Chrome}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
      <Border Style="{StaticResource Dialog.HeaderIconContainer}" DockPanel.Dock="Left">
        <Path Data="M 16 4 h 2 a 2 2 0 0 1 2 2 v 14 a 2 2 0 0 1 -2 2 H 6 a 2 2 0 0 1 -2 -2 V 6 a 2 2 0 0 1 2 -2 h 2 M 9 2 h 6 a 1 1 0 0 1 1 1 v 2 a 1 1 0 0 1 -1 1 H 9 a 1 1 0 0 1 -1 -1 V 3 a 1 1 0 0 1 1 -1 Z"
              Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Previsualizar Pegado de Excel" Style="{StaticResource Dialog.HeaderTitle}" />
        <TextBlock x:Name="HeaderText" Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0" />
        <ItemsControl x:Name="WarningsList" Margin="0,4,0,0"
                      Visibility="{Binding HasWarnings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Amber}"
                         FontSize="{StaticResource Font.Size.sm}" Margin="0,1,0,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>

    <!-- Tabla de previsualización -->
    <Border Grid.Row="1" Style="{StaticResource Card.Section}" Padding="0">
      <DataGrid x:Name="PreviewGrid"
                Style="{StaticResource DataGrid.Workspace}"
                infra:DataGridExcelNavigation.Enable="True"
                CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="32" HeaderStyle="{StaticResource DataGridColumnHeader.Center}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusIcon}" FontSize="{StaticResource Font.Size.lg}"
                           Foreground="{Binding StatusColor}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100" HeaderStyle="{StaticResource DataGridColumnHeader.Base}" />
          <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" HeaderStyle="{StaticResource DataGridColumnHeader.Base}" />
          <DataGridTextColumn Header="UNI" Binding="{Binding Unidad}" Width="50" HeaderStyle="{StaticResource DataGridColumnHeader.Center}" />
          <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadRaw}" Width="90" HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" />
          <DataGridTextColumn Header="NOTA" Binding="{Binding RejectionReason}" Width="160" HeaderStyle="{StaticResource DataGridColumnHeader.Base}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Dialog.Banner.Warning}"
            Visibility="{Binding HasRejected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
      <TextBlock x:Name="RejectedText" Style="{StaticResource Dialog.Banner.Text}"
                 Foreground="{DynamicResource Brush.Amber}" />
    </Border>

    <DockPanel Grid.Row="3" Style="{StaticResource Dialog.Footer}">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
              x:Name="ImportButton" Content="Importar" MinWidth="120" Height="34"
              Click="OnImportClick" IsDefault="True" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
              Content="Cancelar" MinWidth="90" Height="34" Margin="0,0,10,0"
              Click="OnCancelClick" IsCancel="True" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
