<Window x:Class="QubiCostElectrical.Wpf.Features.Cubicacion.ExcelPastePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Previsualizar pegado"
        Width="720" Height="500" MinWidth="640" MinHeight="420">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Previsualizar pegado" Style="{StaticResource Dialog.HeaderTitle}" />
      <TextBlock x:Name="HeaderText" Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0,0,0,0" />
      <ItemsControl x:Name="WarningsList" Margin="0,6,0,0"
                    Visibility="{Binding HasWarnings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Amber}"
                       FontSize="{StaticResource Font.Size.md}" Margin="0,1,0,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Tabla de previsualización -->
    <Border Grid.Row="1" Style="{StaticResource Card.Section}" Padding="0">
      <DataGrid x:Name="PreviewGrid"
                Style="{StaticResource DataGrid.Workspace}"
                infra:DataGridExcelNavigation.Enable="True"
                CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" AutoGenerateColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="32">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusIcon}" FontSize="{StaticResource Font.Size.lg}"
                           Foreground="{Binding StatusColor}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100" />
          <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" />
          <DataGridTextColumn Header="UNI" Binding="{Binding Unidad}" Width="50" />
          <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadRaw}" Width="90" />
          <DataGridTextColumn Header="NOTA" Binding="{Binding RejectionReason}" Width="160" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Dialog.Banner.Warning}"
            Visibility="{Binding HasRejected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
      <TextBlock x:Name="RejectedText" Style="{StaticResource Dialog.Banner.Text}"
                 Foreground="{DynamicResource Brush.Amber}" />
    </Border>

    <DockPanel Grid.Row="3" Style="{StaticResource Dialog.Footer}" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
              x:Name="ImportButton" Content="Importar" MinWidth="120"
              Click="OnImportClick" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
              Content="Cancelar" MinWidth="90" Margin="0,0,8,0"
              Click="OnCancelClick" />
    </DockPanel>
  </Grid>
  </Border>
</Window>
