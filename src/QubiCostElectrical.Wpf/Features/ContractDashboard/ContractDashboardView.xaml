<UserControl x:Class="QubiCostElectrical.Wpf.Features.ContractDashboard.ContractDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Grid.Row="0" Background="#0B2442" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Dashboard contractual" FontSize="20" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="{Binding Header}" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Summary}" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock Margin="0,6,0,0" Foreground="#FCD34D">
            <Run Text="Calidad de datos: "/><Run Text="{Binding Quality, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Toolbar -->
      <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="Snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="Comparar" Command="{Binding CompareCommand}" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="Exportar" Command="{Binding ExportCommand}" Padding="12,6" Background="#1D4ED8" Foreground="White"/>
        </StackPanel>
      </Border>

      <!-- KPIs -->
      <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
        <DataGrid ItemsSource="{Binding Kpis}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="30"/>
            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="100"/>
            <DataGridTextColumn Header="KPI" Binding="{Binding Title}" Width="140"/>
            <DataGridTextColumn Header="Valor" Binding="{Binding DisplayValue}" Width="120"/>
            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/>
            <DataGridTextColumn Header="Tendencia" Binding="{Binding Trend}" Width="80"/>
            <DataGridTextColumn Header="Interpretación" Binding="{Binding Interpretation}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Alerts + Snapshots side by side -->
      <Grid Grid.Row="3" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="8" BorderBrush="#E5E7EB" BorderThickness="1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="Alertas" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button Content="Acusar" Command="{Binding AcknowledgeCommand}" Margin="0,0,6,0" Padding="8,4"/>
              <Button Content="Resolver" Command="{Binding ResolveCommand}" Padding="8,4"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" MaxHeight="200">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="50"/>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="8" BorderBrush="#E5E7EB" BorderThickness="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Snapshots" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid ItemsSource="{Binding Snapshots}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" MaxHeight="200">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="60"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding StatusDate}" Width="100"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="90"/>
                <DataGridTextColumn Header="Comentario" Binding="{Binding Comment}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Comparison -->
      <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Comparación de snapshots" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SnapshotA}" DisplayMemberPath="Version" Width="100" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SnapshotB}" DisplayMemberPath="Version" Width="100" Margin="0,0,8,0"/>
            <Button Content="Comparar" Command="{Binding CompareCommand}" Padding="8,4"/>
          </StackPanel>
          <TextBlock Text="{Binding ComparisonText}" Foreground="#312E81" Margin="0,0,0,6"/>
          <DataGrid ItemsSource="{Binding ComparisonResults}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" MaxHeight="120">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Alcance" Binding="{Binding Scope}" Width="80"/>
              <DataGridTextColumn Header="Etiqueta A" Binding="{Binding LabelA}" Width="100"/>
              <DataGridTextColumn Header="Etiqueta B" Binding="{Binding LabelB}" Width="100"/>
              <DataGridTextColumn Header="Δ Monto" Binding="{Binding AmountChange}" Width="100"/>
              <DataGridTextColumn Header="Δ Días" Binding="{Binding DaysChange}" Width="60"/>
              <DataGridTextColumn Header="Hallazgos" Binding="{Binding Findings}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Status -->
      <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="#374151" Margin="0,0,0,8"/>
    </Grid>
  </ScrollViewer>
</UserControl>
