<UserControl x:Class="QubiCostElectrical.Wpf.Features.Quotations.QuotationWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Ofertas de cotización" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Recepción detallada, evaluación técnica y comercial." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Registrar oferta" Command="{Binding RegisterCommand}" Margin="0,0,6,6" Padding="10,6" Background="#2563EB" Foreground="White"/>
      <Button Content="Enviar" Command="{Binding SubmitCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Eval. técnica" Command="{Binding EvaluateTechCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Eval. comercial" Command="{Binding EvaluateCommercialCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <TextBox Text="{Binding Currency}" Width="60" Margin="8,0,6,6" VerticalAlignment="Center"/>
      <TextBox Text="{Binding UnitPrice}" Width="80" Margin="0,0,6,6" VerticalAlignment="Center"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Rfqs}" SelectedItem="{Binding SelectedRfq}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Column="1" ItemsSource="{Binding Offers}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="Auto"/>
          <DataGridTextColumn Header="Moneda" Binding="{Binding CurrencyCode}" Width="Auto"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Plazo" Binding="{Binding DeliveryLeadDays}" Width="Auto"/>
          <DataGridTextColumn Header="Impuesto %" Binding="{Binding TaxPercent}" Width="Auto"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
