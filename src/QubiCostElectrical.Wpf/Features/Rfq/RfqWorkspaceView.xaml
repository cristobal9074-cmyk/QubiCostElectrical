<UserControl x:Class="QubiCostElectrical.Wpf.Features.Rfq.RfqWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Solicitudes de cotización (RFQ)" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Crear desde requerimientos, invitar proveedores, emitir y registrar respuestas." FontSize="12" Foreground="#6B7280" Margin="0,4,0,8"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Crear desde PR" Command="{Binding CreateCommand}" Margin="0,0,6,6" Padding="10,6" Background="#2563EB" Foreground="White"/>
      <Button Content="Invitar" Command="{Binding InviteCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Aprobar" Command="{Binding ApproveCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Emitir" Command="{Binding IssueCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Registrar respuesta" Command="{Binding RegisterResponseCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,6,6" Padding="10,6"/>
      <Button Content="Exportar" Command="{Binding ExportCommand}" Margin="0,0,6,6" Padding="10,6"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="*"/>
          <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*"/>
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
          <DataGridTextColumn Header="Límite" Binding="{Binding DeadlineUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="Título RFQ" FontWeight="SemiBold"/>
          <TextBox Text="{Binding Title}" Margin="0,0,0,8"/>
          <TextBlock Text="Proveedor invitado"/>
          <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding InviteSupplier}" DisplayMemberPath="LegalName" Margin="0,0,0,8"/>
          <TextBlock Text="Comentario respuesta"/>
          <TextBox Text="{Binding ResponseComment}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusMessage}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
    </StackPanel>
  </Grid>
</UserControl>
