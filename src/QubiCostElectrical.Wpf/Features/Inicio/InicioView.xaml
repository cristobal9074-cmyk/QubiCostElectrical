<UserControl x:Class="QubiCostElectrical.Wpf.Features.Inicio.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LandingSidebarActionButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.White8}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.White18}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White16}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White25}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LandingPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource LandingSidebarActionButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LandingResourceButton" TargetType="Button" BasedOn="{StaticResource LandingSidebarActionButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Brush.White8}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.White16}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderInk}" />
        </Style>

        <Style x:Key="LandingMetricCard" TargetType="Border" BasedOn="{StaticResource Card.Section}">
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="RecentProjectContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
            Background="{DynamicResource Brush.NavyDeep}"
            BorderBrush="{DynamicResource Brush.NavyDeep2}"
            BorderThickness="0,0,1,0">
            <Grid Margin="24,24,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Brush.PrimaryButton}" Margin="0,0,0,18">
                        <Viewbox Width="36" Height="36">
                            <Canvas Width="28" Height="28">
                                <Polygon Points="14,1 27,7.5 27,20.5 14,27 1,20.5 1,7.5"
                         Fill="{DynamicResource Brush.BrandDark}"
                         Stroke="{DynamicResource Brush.Blue3}"
                         StrokeThickness="1.3" />
                                <Polygon Points="14,1 27,7.5 14,14 1,7.5"
                         Fill="{DynamicResource Brush.BrandMid}"
                         Stroke="{DynamicResource Brush.BrandStroke}"
                         StrokeThickness="1" />
                                <Path Data="M16 5 L11 14 L14 14 L12 23 L19 12 L16 12 Z"
                      Fill="White"
                      Stroke="{DynamicResource Brush.BrandStroke3}"
                      StrokeThickness="0.5" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="QUBI" Style="{StaticResource Text.HeaderBrand}" FontSize="{StaticResource Font.Size.hero}" />
                    <TextBlock Text="COST ELECTRICAL" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueFaint}" Margin="0,2,0,0" />
                    <TextBlock Text="Presupuestos eléctricos" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="220" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock Text="ACCIONES" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="2,0,0,10" />

                    <Button Style="{StaticResource LandingPrimaryActionButton}"
                  Command="{Binding NewProjectCommand}"
                  AutomationProperties.Name="Nuevo proyecto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.White25}" VerticalAlignment="Center">
                                <Grid>
                                    <Rectangle Width="12" Height="2" Fill="{DynamicResource Brush.White}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Width="2" Height="12" Fill="{DynamicResource Brush.White}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Nuevo proyecto" FontSize="{StaticResource Font.Size.kpi}" FontWeight="SemiBold" />
                                <TextBlock Text="Crear un presupuesto desde cero" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.BlueFaint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource LandingSidebarActionButton}"
                  Command="{Binding OpenProjectCommand}"
                  AutomationProperties.Name="Abrir proyecto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.White12}" VerticalAlignment="Center">
                                <Grid>
                                    <Rectangle Width="14" Height="10" Stroke="{DynamicResource Brush.White}" StrokeThickness="1.4" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Width="9" Height="4" Fill="{DynamicResource Brush.White}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Abrir proyecto…" FontSize="{StaticResource Font.Size.kpi}" FontWeight="SemiBold" />
                                <TextBlock Text="Continuar un archivo existente" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.HeaderMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Text="RECURSOS" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="2,18,0,10" />

                    <Button Style="{StaticResource LandingResourceButton}"
                  Command="{Binding GoToPriceBankCommand}"
                  AutomationProperties.Name="Banco de precios">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.White8}" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse Width="13" Height="13" Stroke="{DynamicResource Brush.White}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Width="11" Height="2" Fill="{DynamicResource Brush.White}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Banco de precios" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" />
                                <TextBlock Text="Buscar y mantener materiales" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.HeaderMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource LandingResourceButton}"
                  Command="{Binding GoToTemplatesCommand}"
                  AutomationProperties.Name="Plantillas APU">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.White8}" VerticalAlignment="Center">
                                <Grid>
                                    <Rectangle Width="12" Height="14" Stroke="{DynamicResource Brush.White}" StrokeThickness="1.3" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Line X1="8" Y1="11" X2="19" Y2="11" Stroke="{DynamicResource Brush.White}" StrokeThickness="1" />
                                    <Line X1="8" Y1="14" X2="17" Y2="14" Stroke="{DynamicResource Brush.White}" StrokeThickness="1" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Plantillas APU" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" />
                                <TextBlock Text="Cargar bases y modelos" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.HeaderMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource LandingResourceButton}"
                  Command="{Binding GoToPreferencesCommand}"
                  AutomationProperties.Name="Preferencias">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.White8}" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse Width="13" Height="13" Stroke="{DynamicResource Brush.White}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.White}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Preferencias" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" />
                                <TextBlock Text="Personalizar la aplicación" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.HeaderMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource LandingResourceButton}"
                  Command="{Binding ExitApplicationCommand}"
                  AutomationProperties.Name="Salir">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.White8}" VerticalAlignment="Center">
                                <Grid>
                                    <Rectangle Width="10" Height="12" Stroke="{DynamicResource Brush.HeaderMuted}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Polygon Points="12,8 17,10 12,12" Fill="{DynamicResource Brush.HeaderMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Salir" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                                <TextBlock Text="Cerrar la aplicación" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.HeaderDim}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Brush.White18}" Margin="0,14,0,14" />
                    <TextBlock Text="{Binding VersionLabel}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink5}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Proyectos" Style="{StaticResource Text.ViewTitle}" FontSize="{StaticResource Font.Size.3xl}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Abre uno reciente o crea un presupuesto nuevo."
                     Style="{StaticResource Text.Body}"
                     FontSize="{StaticResource Font.Size.lg}"
                     Foreground="{DynamicResource Brush.Ink3}"
                     Margin="0,6,0,0" />
                    <Border Margin="0,18,0,0"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource Brush.BlueFaint}"
                  BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="14,10"
                  Visibility="{Binding HasOpenProject, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Proyecto activo" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                            <TextBlock Text="{Binding ActiveProjectLabel, Mode=OneWay}"
                          FontSize="{StaticResource Font.Size.h3}"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource Brush.Ink}"
                          TextTrimming="CharacterEllipsis"
                          MaxWidth="420"
                          Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Cifras de contexto del equipo: resumen de los proyectos listados -->
                    <StackPanel Margin="0,22,0,0"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="ESTADO DE LOS PROYECTOS DE ESTE EQUIPO" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderLabel}" />
                            <TextBlock Text="Clasificación por etapa del presupuesto" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Right" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding QuickSummaryCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LandingMetricCard}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,6,0,2">
                                                <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,4,9,4" />
                                                <TextBlock Text="{Binding Value}" FontSize="{StaticResource Font.Size.2xl}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Caption}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Galería de Plantillas Rápidas SEC / RIC -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="PLANTILLAS RÁPIDAS NORMATIVA SEC / RIC" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderLabel}" />
                        <TextBlock Text="Inicia un presupuesto en 1 clic con estructura normada" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding QuickTemplates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding UseTemplateCommand}"
                                        Margin="0,0,8,0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Line}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="14"
                                                    MinHeight="130">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Icon & Badge Header -->
                                                    <DockPanel Grid.Row="0">
                                                        <Border Width="34" Height="34" CornerRadius="10" Background="{Binding AccentSoftBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border HorizontalAlignment="Right" Background="{Binding AccentSoftBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NormaSec}" FontSize="10" FontWeight="Bold" Foreground="{Binding AccentBrush}" />
                                                        </Border>
                                                    </DockPanel>

                                                    <!-- Title & Subtitle -->
                                                    <StackPanel Grid.Row="1" Margin="0,10,0,4">
                                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" Margin="0,1,0,0" />
                                                    </StackPanel>

                                                    <!-- Description -->
                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" TextWrapping="Wrap" LineHeight="15" Margin="0,2,0,8" />

                                                    <!-- CTA -->
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                        <TextBlock Text="Usar plantilla" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text=" →" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueIconBg2}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card.Section}" Margin="0,20,0,20"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="Proyectos recientes" Style="{StaticResource Text.PageTitle}" FontSize="{StaticResource Font.Size.xl}" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="14" Padding="28" HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                                        <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource Brush.BlueSoft}" HorizontalAlignment="Center">
                                            <Grid>
                                                <Rectangle Width="22" Height="16" Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Rectangle Width="12" Height="4" Fill="{DynamicResource Brush.Blue}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,19,0,0" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Todavía no tienes proyectos recientes"
                               FontSize="{StaticResource Font.Size.h2}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}"
                               TextAlignment="Center"
                               Margin="0,18,0,6" />
                                        <TextBlock Text="Crea un proyecto nuevo o abre uno existente para comenzar."
                               FontSize="{StaticResource Font.Size.md}"
                                Foreground="{DynamicResource Brush.Ink3}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Margin="0,0,0,18" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource Button.Primary}" Content="Nuevo proyecto" Command="{Binding NewProjectCommand}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource Button.Secondary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ListBox x:Name="RecentProjectsList"
                       ItemsSource="{Binding RecentProjects}"
                       Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}}"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource RecentProjectContainer}"
                       SelectionMode="Single"
                       SelectionChanged="OnRecentProjectsSelectionChanged"
                       MouseDoubleClick="OnRecentProjectsMouseDoubleClick"
                       PreviewKeyDown="OnRecentProjectsPreviewKeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <!-- Menú contextual al hacer clic derecho en cualquier parte de la tarjeta -->
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Abrir proyecto" Command="{Binding OpenCommand}" FontWeight="SemiBold">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Fijar al inicio (Pin)" Command="{Binding TogglePinCommand}"
                                                              Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Desanclar de recientes" Command="{Binding TogglePinCommand}"
                                                              Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE77A;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Abrir ubicación en el Explorador" Command="{Binding OpenFolderCommand}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copiar ruta completa" Command="{Binding CopyPathCommand}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Quitar de la lista de recientes" Command="{Binding RemoveRecentCommand}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Ícono de proyecto -->
                                            <Border Width="48" Height="48" CornerRadius="14" Background="{Binding AccentSoftBrush}" VerticalAlignment="Center">
                                                <Grid>
                                                    <Rectangle Width="20" Height="20" RadiusX="4" RadiusY="4" Stroke="{Binding AccentBrush}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Rectangle Width="8" Height="8" Fill="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Nombre y Ruta -->
                                            <StackPanel Grid.Column="1" Margin="4,2,16,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Size.h3}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                                    <Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber2}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Amber}" />
                                                            <TextBlock Text="Fijado" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayPath}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink3}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,3,0,0" MaxWidth="620" />
                                                <TextBlock Text="{Binding StatusCaption}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Estado, Fecha y Botón de Opciones (···) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Border Background="{Binding AccentSoftBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayDate}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                                </StackPanel>

                                                <!-- Botón 3 puntos -->
                                                <Button Click="OnProjectOptionsButtonClick"
                                                        ToolTip="Opciones del proyecto"
                                                        Width="30" Height="30"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="4">
                                                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
