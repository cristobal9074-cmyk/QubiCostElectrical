<UserControl x:Class="QubiCostElectrical.Wpf.Features.Inicio.ResumenProyectoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <TextBlock Text="Resumen" Style="{StaticResource Text.ViewTitle}" VerticalAlignment="Center" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,12">

                <!-- CTA dominante -->
                <Border Background="{DynamicResource Brush.BlueSoft}" BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" MinWidth="180" Height="40"
                                Content="{Binding PrimaryCtaLabel}" Command="{Binding PrimaryCtaCommand}"
                                FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding NextStepTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NextStepDetail}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- KPI Cards -->
                <ItemsControl ItemsSource="{Binding KpiCards}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,8" Foreground="{DynamicResource Brush.Ink3}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.KpiValue}" Foreground="{DynamicResource Brush.Ink}" FontFamily="Consolas" FontWeight="Bold" FontSize="20" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Caption}" Foreground="{Binding AccentBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Una alerta prioritaria -->
                <Border Margin="0,0,0,12" Padding="12,10" CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.Amber}"
                        Visibility="{Binding HasTopAlert, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Revisar"
                                Command="{Binding GoToReviewCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding TopAlertTitle}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TopAlertDetail}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Detalle colapsable -->
                <Expander Header="Detalle · distribución, partidas, flujo y auditoría"
                          IsExpanded="{Binding IsDetailExpanded, Mode=TwoWay}"
                          Margin="0,0,0,8">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Cost Distribution and Top Items -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">

                        <!-- Cost Distribution and Margin Simulator -->
                        <Border Style="{StaticResource Card.Section}" Margin="0,0,0,14" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Distribución del Costo Directo" Style="{StaticResource Text.SectionLabel}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CostDirect}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" FontWeight="Bold" />
                                </DockPanel>

                                <!-- Polish Cost Distribution Progress Bar -->
                                <Grid Height="12" Margin="0,2,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding MaterialShareWidth}" />
                                        <ColumnDefinition Width="{Binding LaborShareWidth}" />
                                        <ColumnDefinition Width="{Binding OtherShareWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Brush.Blue}" CornerRadius="6,0,0,6" ToolTip="Materiales" />
                                    <Border Grid.Column="1" Background="{DynamicResource Brush.Success}" ToolTip="Mano de Obra" />
                                    <Border Grid.Column="2" Background="{DynamicResource Brush.Amber}" CornerRadius="0,6,6,0" ToolTip="Otros Directos" />
                                </Grid>

                                <!-- Interactive Legend Pills -->
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <!-- Legend 1: Materiales -->
                                    <Button Command="{Binding ToggleFilterCommand}" CommandParameter="Materiales" Margin="0,0,4,0" Padding="6" BorderThickness="1">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilteringMateriales}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Blue}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Materiales" FontWeight="Bold" FontSize="10.5" />
                                                <TextBlock Text="{Binding CostMaterials}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" FontFamily="Consolas" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- Legend 2: Mano de Obra -->
                                    <Button Command="{Binding ToggleFilterCommand}" CommandParameter="Mano de Obra" Margin="2,0,2,0" Padding="6" BorderThickness="1">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilteringLabor}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Mano de obra" FontWeight="Bold" FontSize="10.5" />
                                                <TextBlock Text="{Binding CostLabor}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" FontFamily="Consolas" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- Legend 3: Otros Directos -->
                                    <Button Command="{Binding ToggleFilterCommand}" CommandParameter="Otros" Margin="4,0,0,0" Padding="6" BorderThickness="1">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilteringOtros}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Amber}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Otros directos" FontWeight="Bold" FontSize="10.5" />
                                                <TextBlock Text="{Binding CostOtherDirect}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" FontFamily="Consolas" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- Real-Time Simulator Sliders Box -->
                                <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,2,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Simulador Comercial en Tiempo Real" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,0,8" />

                                        <!-- Slider Gastos Generales -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gastos Generales (GG)" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GastosGeneralesSimulatedPct, StringFormat={}{0:F1}%}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" FontFamily="Consolas" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="30" SmallChange="0.5" LargeChange="2" Value="{Binding GastosGeneralesSimulatedPct}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,0" />
                                        </Grid>

                                        <!-- Slider Utilidad -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Margen de Utilidad" FontSize="10" Foreground="{DynamicResource Brush.Ink3}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UtilidadSimulatedPct, StringFormat={}{0:F1}%}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" FontFamily="Consolas" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="25" SmallChange="0.5" LargeChange="2" Value="{Binding UtilidadSimulatedPct}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Partidas Principales Table -->
                        <Border Style="{StaticResource Card.Section}" Padding="14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Partidas Principales" Style="{StaticResource Text.SectionLabel}" FontSize="11" FontWeight="Bold" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Ver itemizado completo →" Command="{Binding GoToItemizadoCommand}" Padding="0" />
                                </DockPanel>

                                <!-- Filter Info Banner -->
                                <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="6" Padding="6,4" Margin="0,0,0,8" Visibility="{Binding IsAnyFilterActive, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <TextBlock Text="Filtro de categoría activo" FontSize="10" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.BlueDark}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Limpiar filtro" Command="{Binding ToggleFilterCommand}" CommandParameter="{Binding SelectedCategoryFilter}" VerticalAlignment="Center" FontSize="10" />
                                    </DockPanel>
                                </Border>

                                <!-- DataGrid with View Source Binding for filtering -->
                                <DataGrid ItemsSource="{Binding FilteredTopPartidas}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Style="{StaticResource DataGrid.Workspace}" CanUserAddRows="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ítem" Binding="{Binding Item}" Width="65">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="FontSize" Value="10.5" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Partida" Binding="{Binding Partida}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Avance" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Width="56" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding FillWidth}" />
                                                            <ColumnDefinition Width="{Binding RemainderWidth}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource Brush.Blue}" CornerRadius="2" />
                                                        <Border Grid.Column="1" Background="{DynamicResource Brush.Line2}" CornerRadius="2" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Costo directo" Binding="{Binding TotalLabel}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="%" Binding="{Binding PercentLabel}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Diagnostics, Timelines, Audit logs -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">

                        <!-- Timeline/Workflow steps -->
                        <Border Style="{StaticResource Card.Section}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Avance del flujo" Style="{StaticResource Text.SectionLabel}" FontSize="11" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding WorkflowSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding NavigateCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,4"
                              Cursor="Hand" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                                <DockPanel LastChildFill="True">
                                                    <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Rectangle Width="2" Fill="{DynamicResource Brush.Line}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,11,0,-18" SnapsToDevicePixels="True">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Brush.Surface2}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                                                                            <Setter Property="BorderThickness" Value="2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="·" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                                <Setter Property="Text" Value="✓" />
                                                                                <Setter Property="Foreground" Value="White" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Text" Value="▶" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink5}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostics & Revision Alerts (Smart Scan) -->
                        <Border Style="{StaticResource Card.Section}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="Análisis y Salud del Proyecto" Style="{StaticResource Text.SectionLabel}" FontSize="11" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Alerts.Count, StringFormat={}{0} hallazgos}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Alerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SeverityLabel}" Value="Bloqueante">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SeverityLabel}" Value="Crítico">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SeverityLabel}" Value="Bloqueante">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SeverityLabel}" Value="Crítico">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.Amber}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="10.5" Foreground="White" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink}" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource Button.Link}" Content="Ir" Command="{Binding NavigateCommand}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Style="{StaticResource Button.Secondary}" Content="Ir a Revisión Final" Command="{Binding GoToReviewCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- SQLite Audit Logs (New Card) -->
                        <Border Style="{StaticResource Card.Section}" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Actividad Reciente y Auditoría (SQLite)" Style="{StaticResource Text.SectionLabel}" FontSize="11" Margin="0,0,0,8" />

                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding RecentAuditEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,4" Padding="6,6" CornerRadius="6" Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Mini Avatar -->
                                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.Blue}" VerticalAlignment="Center">
                                                            <TextBlock Text="U" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Brush.Ink}" />
                                                            <TextBlock Text="{Binding Action}" FontSize="9" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource Brush.Ink3}" TextWrapping="Wrap" MaxWidth="160" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{Binding OccurredAtLabel}" FontSize="9" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" FontFamily="Consolas" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
