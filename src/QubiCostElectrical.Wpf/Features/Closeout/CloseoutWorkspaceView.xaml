<UserControl x:Class="QubiCostElectrical.Wpf.Features.Closeout.CloseoutWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
  <UserControl.Resources>
    <Style x:Key="Tab.Sidebar" TargetType="RadioButton">
      <Setter Property="Height" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="12,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2" x:Name="ActiveIndicator" Width="3" Height="18"
                        CornerRadius="2" Background="{DynamicResource Brush.Blue}"
                        Visibility="Collapsed" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ════════════════════════════════════════════════════════
         HEADER — barra superior con gradiente
         ════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
            Padding="20,14" Margin="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="10"
                  Background="{DynamicResource Brush.BlueSoft}"
                  BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1">
            <TextBlock Text="⏻" FontSize="17" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Blue}" />
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Preparación de cierre" Style="{DynamicResource Text.SectionTitle}"
                         VerticalAlignment="Center" />
              <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4"
                      Background="{DynamicResource Brush.BlueSoft}"
                      BorderBrush="{DynamicResource Brush.Blue}" BorderThickness="1">
                <TextBlock Text="{Binding CloseoutStatus, TargetNullValue='Sin iniciar'}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Blue}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Brush.Danger}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Padding="12,6" CornerRadius="8"
                  Background="{DynamicResource Brush.Surface2}"
                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                  Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.SaveDot}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{Binding CloseoutCode, TargetNullValue='Sin proyecto'}"
                         Style="{StaticResource Text.Caption}" FontSize="11" />
            </StackPanel>
          </Border>
          <Button Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}"
                  Width="34" Height="34" Padding="0">
            <TextBlock Text="⟳" FontSize="16" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ════════════════════════════════════════════════════════
         TAB CONTROL — navegación vertical con indicador
         ════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1" Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ── Sidebar de tabs ── -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,12,8,12">
          <TextBlock Text="SECCIONES" Style="{StaticResource Text.SectionLabel}"
                     Margin="12,0,0,10" FontSize="9" />

          <RadioButton GroupName="CloseoutTab" IsChecked="{Binding IsGeneralTab, Mode=OneWay}"
                       Style="{StaticResource Tab.Sidebar}" Content="General"
                       Command="{Binding NavigateTabCommand}" CommandParameter="0">
            <RadioButton.Tag>
              <Border Width="6" Height="6" CornerRadius="3"
                      Background="{DynamicResource Brush.Blue}" />
            </RadioButton.Tag>
          </RadioButton>

          <RadioButton GroupName="CloseoutTab" IsChecked="{Binding IsChecklistTab, Mode=OneWay}"
                       Style="{StaticResource Tab.Sidebar}" Content="Check-list"
                       Command="{Binding NavigateTabCommand}" CommandParameter="1">
            <RadioButton.Tag>
              <Border Width="6" Height="6" CornerRadius="3"
                      Background="{DynamicResource Brush.Amber}" />
            </RadioButton.Tag>
          </RadioButton>

          <RadioButton GroupName="CloseoutTab" IsChecked="{Binding IsPunchTab, Mode=OneWay}"
                       Style="{StaticResource Tab.Sidebar}" Content="Punch list"
                       Command="{Binding NavigateTabCommand}" CommandParameter="2">
            <RadioButton.Tag>
              <Border Width="6" Height="6" CornerRadius="3"
                      Background="{DynamicResource Brush.Red}" />
            </RadioButton.Tag>
          </RadioButton>

          <RadioButton GroupName="CloseoutTab" IsChecked="{Binding IsReconciliationTab, Mode=OneWay}"
                       Style="{StaticResource Tab.Sidebar}" Content="Conciliación"
                       Command="{Binding NavigateTabCommand}" CommandParameter="3">
            <RadioButton.Tag>
              <Border Width="6" Height="6" CornerRadius="3"
                      Background="{DynamicResource Brush.Purple}" />
            </RadioButton.Tag>
          </RadioButton>

          <RadioButton GroupName="CloseoutTab" IsChecked="{Binding IsReadinessTab, Mode=OneWay}"
                       Style="{StaticResource Tab.Sidebar}" Content="Readiness"
                       Command="{Binding NavigateTabCommand}" CommandParameter="4">
            <RadioButton.Tag>
              <Border Width="6" Height="6" CornerRadius="3"
                      Background="{DynamicResource Brush.Blue}" />
            </RadioButton.Tag>
          </RadioButton>
        </StackPanel>
      </Border>

      <!-- ── Contenido del tab activo ── -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{DynamicResource Brush.Canvas}">
        <StackPanel Margin="20,16,20,20">

          <!-- =========================================================
               TAB: GENERAL
               ========================================================= -->
          <StackPanel Visibility="{Binding IsGeneralTab, Converter={StaticResource BoolToVisibility}}">

            <!-- KPI row -->
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card.Kpi}" Margin="0,0,6,6">
                <StackPanel>
                  <TextBlock Text="Código" Style="{StaticResource Text.TotalsLabel}" />
                  <TextBlock Text="{Binding CloseoutCode, TargetNullValue='—'}"
                             Style="{StaticResource Text.KpiValue}" FontSize="18" />
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card.Kpi}" Margin="6,0,6,6">
                <StackPanel>
                  <TextBlock Text="Estado" Style="{StaticResource Text.TotalsLabel}" />
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Amber}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CloseoutStatus, TargetNullValue='Pendiente'}"
                               Style="{StaticResource Text.KpiValue}" FontSize="18" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card.Kpi}" Margin="6,0,6,6">
                <StackPanel>
                  <TextBlock Text="Proyecto" Style="{StaticResource Text.TotalsLabel}" />
                  <TextBlock Text="{Binding CloseoutProject, TargetNullValue='—'}"
                             Style="{StaticResource Text.KpiValue}" FontSize="18" />
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource Card.Kpi}" Margin="6,0,0,6">
                <StackPanel>
                  <TextBlock Text="Nombre" Style="{StaticResource Text.TotalsLabel}" />
                  <TextBlock Text="{Binding CloseoutName, TargetNullValue='—'}"
                             Style="{StaticResource Text.KpiValue}" FontSize="18" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Timeline / workflow stepper -->
            <Border Style="{StaticResource Card.Section}" Margin="0,0,0,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Workflow de cierre" Style="{DynamicResource Text.SectionTitle}" />
                </StackPanel>
                <Grid Margin="0,16,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- Fila de círculos -->
                  <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                          Background="{DynamicResource Brush.Blue}" HorizontalAlignment="Center">
                    <TextBlock Text="1" FontWeight="Bold" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" Width="36" Height="36" CornerRadius="18"
                          Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1.5"
                          HorizontalAlignment="Center">
                    <TextBlock Text="2" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource Brush.Ink3}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Grid.Row="0" Grid.Column="2" Width="36" Height="36" CornerRadius="18"
                          Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1.5"
                          HorizontalAlignment="Center">
                    <TextBlock Text="3" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource Brush.Ink3}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Grid.Row="0" Grid.Column="3" Width="36" Height="36" CornerRadius="18"
                          Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1.5"
                          HorizontalAlignment="Center">
                    <TextBlock Text="4" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource Brush.Ink3}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Grid.Row="0" Grid.Column="4" Width="36" Height="36" CornerRadius="18"
                          Background="{DynamicResource Brush.Surface2}"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1.5"
                          HorizontalAlignment="Center">
                    <TextBlock Text="5" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource Brush.Ink3}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <!-- Fila de etiquetas -->
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Draft" Style="{StaticResource Text.Caption}"
                             HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="Revisión" Style="{StaticResource Text.Caption}"
                             HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="Readiness" Style="{StaticResource Text.Caption}"
                             HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" />
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="Recepción" Style="{StaticResource Text.Caption}"
                             HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" />
                  <TextBlock Grid.Row="1" Grid.Column="4" Text="Final" Style="{StaticResource Text.Caption}"
                             HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Acciones principales -->
            <Border Style="{StaticResource Card.Section}">
              <StackPanel>
                <TextBlock Text="Acciones" Style="{DynamicResource Text.SectionTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Command="{Binding CreateCloseoutCommand}" Style="{StaticResource Button.Primary}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" />
                      <TextBlock Text="Iniciar cierre" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding SubmitCloseoutCommand}" Style="{StaticResource Button.Secondary}"
                          Padding="16,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📤" FontSize="14" Margin="0,0,8,0" />
                      <TextBlock Text="Enviar a revisión" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding ApproveReadinessCommand}" Style="{StaticResource Button.Secondary}"
                          Padding="16,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" />
                      <TextBlock Text="Aprobar readiness" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- =========================================================
               TAB: CHECK-LIST
               ========================================================= -->
          <StackPanel Visibility="{Binding IsChecklistTab, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card.Section}" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Check-list de cierre"
                           Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Command="{Binding ApplyTemplateCommand}" Style="{StaticResource Button.Primary}"
                          Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" />
                      <TextBlock Text="Aplicar plantilla" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding VerifyItemCommand}" Style="{StaticResource Button.Secondary}"
                          Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" />
                      <TextBlock Text="Verificar ítem" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding ChecklistItems}"
                      SelectedItem="{Binding SelectedChecklistItem}"
                      Style="{StaticResource DataGrid.Workspace}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Height="400">
              <DataGrid.Resources>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
                  <Setter Property="Height" Value="40" />
                </Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Estado" Width="60">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Width="22" Height="22" CornerRadius="11" Margin="16,0,0,0"
                              Background="{DynamicResource Brush.Surface2}"
                              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="○" FontSize="11" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Ink3}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ítem" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="130" />
                <DataGridTextColumn Header="Comentario" Binding="{Binding Comment}" Width="160" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>

          <!-- =========================================================
               TAB: PUNCH LIST
               ========================================================= -->
          <StackPanel Visibility="{Binding IsPunchTab, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card.Section}" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Punch list"
                           Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Command="{Binding CreatePunchItemCommand}" Style="{StaticResource Button.Primary}"
                          Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,6,0" />
                      <TextBlock Text="Nuevo ítem" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding ClosePunchItemCommand}" Style="{StaticResource Button.Secondary}"
                          Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" />
                      <TextBlock Text="Cerrar" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding ReopenPunchItemCommand}" Style="{StaticResource Button.Secondary}"
                          Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="↩" FontSize="13" Margin="0,0,6,0" />
                      <TextBlock Text="Reabrir" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding PunchItems}"
                      SelectedItem="{Binding SelectedPunchItem}"
                      Style="{StaticResource DataGrid.Workspace}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Height="400">
              <DataGrid.Resources>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
                  <Setter Property="Height" Value="40" />
                </Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Prioridad" Width="70">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Width="8" Height="8" CornerRadius="4" Margin="24,0,0,0"
                              Background="{DynamicResource Brush.Red}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="130" />
                <DataGridTextColumn Header="Creado" Binding="{Binding CreatedAt, StringFormat=\{0:d\}}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>

          <!-- =========================================================
               TAB: CONCILIACIÓN
               ========================================================= -->
          <StackPanel Visibility="{Binding IsReconciliationTab, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card.Section}" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Conciliación económica"
                           Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding RunReconciliationCommand}"
                        Style="{StaticResource Button.Primary}" Padding="12,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Ejecutar conciliación" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card.Section}">
              <StackPanel>
                <Border Background="{DynamicResource Brush.SuccessBg}"
                        BorderBrush="{DynamicResource Brush.SuccessBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource Brush.Success}" Margin="0,0,12,0">
                      <TextBlock Text="✓" FontSize="15" FontWeight="Bold"
                                 Foreground="White" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding ReconciliationSummary}"
                                 Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.SuccessDark}" />
                      <TextBlock Text="Última ejecución: hoy"
                                 Style="{StaticResource Text.Caption}" FontSize="10"
                                 Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- =========================================================
               TAB: READINESS
               ========================================================= -->
          <StackPanel Visibility="{Binding IsReadinessTab, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card.Section}" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Readiness &amp; Snapshots"
                           Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Command="{Binding CalculateReadinessCommand}" Style="{StaticResource Button.Primary}"
                          Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" />
                      <TextBlock Text="Calcular readiness" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding CreateSnapshotCommand}" Style="{StaticResource Button.Secondary}"
                          Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📸" FontSize="12" Margin="0,0,6,0" />
                      <TextBlock Text="Crear snapshot" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Readiness gauge -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card.Kpi}" Margin="0,0,6,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Global" Style="{StaticResource Text.TotalsLabel}"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding ReadinessGlobalPct, StringFormat={}{0:F0}%}"
                             Style="{StaticResource Text.KpiValue}" FontSize="28"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Success}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card.Kpi}" Margin="6,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Documental" Style="{StaticResource Text.TotalsLabel}"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding ReadinessDocPct, StringFormat={}{0:F0}%}"
                             Style="{StaticResource Text.KpiValue}" FontSize="28"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Blue}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card.Kpi}" Margin="6,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Técnico" Style="{StaticResource Text.TotalsLabel}"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding ReadinessTechPct, StringFormat={}{0:F0}%}"
                             Style="{StaticResource Text.KpiValue}" FontSize="28"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Amber}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Style="{StaticResource Card.Kpi}" Margin="6,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="Económico" Style="{StaticResource Text.TotalsLabel}"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding ReadinessEcoPct, StringFormat={}{0:F0}%}"
                             Style="{StaticResource Text.KpiValue}" FontSize="28"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource Brush.Purple}" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Snapshots table -->
            <DataGrid ItemsSource="{Binding Snapshots}"
                      Style="{StaticResource DataGrid.Workspace}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Height="250">
              <DataGrid.Resources>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
                  <Setter Property="Height" Value="40" />
                </Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Snapshot" Binding="{Binding Id}" Width="*" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp, StringFormat=\{0:d\}}" Width="110" />
                <DataGridTextColumn Header="Comentario" Binding="{Binding Comment}" Width="180" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ════════════════════════════════════════════════════════
         STATUS BAR
         ════════════════════════════════════════════════════════ -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
            Padding="14,6">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.SaveDot}"
                 VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding StatusMessage, TargetNullValue='Listo'}"
                   Style="{StaticResource Text.Caption}" FontSize="10" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
