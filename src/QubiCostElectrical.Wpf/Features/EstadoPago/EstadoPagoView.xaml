<UserControl x:Class="QubiCostElectrical.Wpf.Features.EstadoPago.EstadoPagoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls">
  <UserControl.Resources>
    <Style x:Key="StatusBadgeBase" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProgressBarStyle" TargetType="Border">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    </Style>
    <Style x:Key="NumericColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ═══ HEADER ═══ -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" Padding="16,12" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Estado de Pagos" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Text="Certificados mensuales de avance · Conectado al Itemizado contractual" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Brush.GreenSoft}" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
            <TextBlock Text="{Binding ContractAmountLabel, StringFormat={}Contrato: {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
          </Border>
          <Button Style="{StaticResource Button.Secondary}" Command="{Binding SaveCommand}" Padding="12,5" Height="32">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" />
              <TextBlock Text="Guardar" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ MONTH TIMELINE ═══ -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" Padding="12,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="PERÍODOS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Months}" Margin="0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                        Padding="0" Margin="2,0" Cursor="Hand" Height="36">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Padding="10,6" x:Name="Bd"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                              </DataTrigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="approved">
                              <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="draft">
                              <Setter Property="Background" Value="{DynamicResource Brush.Amber}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="pending">
                              <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="locked">
                              <Setter Property="Background" Value="{DynamicResource Brush.Ink4}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding AmountLabel}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" FontFamily="{StaticResource Font.Mono}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding CreateNewCommand}" Padding="12,5" Height="32" Margin="8,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Margin="0,0,5,0" />
            <TextBlock Text="Nuevo" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ CERTIFICATE INFO BAR ═══ -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" Padding="14,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="CERTIFICADO:" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Text="{Binding CertNumber}" FontSize="12" Foreground="{DynamicResource Brush.Ink2}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="PERÍODO:" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Text="{Binding PeriodLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="MONEDA:" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Text="UF" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
          <TextBlock Text="PREVIO ACUM:" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" FontWeight="SemiBold" Margin="0,0,4,0" />
          <TextBlock Text="{Binding AccumulatedLabel}" FontSize="11" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" />
        </StackPanel>
        <Border Grid.Column="4" CornerRadius="10" Padding="8,2" Margin="0,0,4,0" HorizontalAlignment="Center"
                Background="{DynamicResource Brush.AmberSoft}">
          <TextBlock FontSize="9" FontWeight="Bold">BORRADOR</TextBlock>
        </Border>
      </Grid>
    </Border>

    <!-- ═══ TOOLBAR ═══ -->
    <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" Padding="12,6" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Secondary}" Command="{Binding RecalcAllCommand}" Padding="10,4" Height="28" Margin="4,0">
            <TextBlock Text="Recalcular" FontSize="11" />
          </Button>
          <Button Style="{StaticResource Button.Secondary}" Padding="10,4" Height="28" Margin="4,0">
            <TextBlock Text="Exportar PDF" FontSize="11" />
          </Button>
        </StackPanel>
        <Grid Width="240" Height="28">
          <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1" CornerRadius="6" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="2,0" Background="Transparent" BorderThickness="0"
                    Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVisibility}}">
              <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
            </Button>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                     FontSize="11" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" Margin="6,0,0,0" />
          </DockPanel>
          <TextBlock Text="Buscar partida…" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Ink5}" FontSize="11" VerticalAlignment="Center" Margin="8,0,30,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SearchText, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Brush.Ink4}" />
      </DockPanel>
    </Border>

    <!-- ═══ TABLE ═══ -->
    <Border Grid.Row="4" Style="{StaticResource Card.Section}" Padding="1" Margin="12,8,12,4">
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" Background="{DynamicResource Brush.Surface}"
                  AlternatingRowBackground="{DynamicResource Brush.AltRow}"
                  Style="{StaticResource DataGrid.Workspace}" MinHeight="200"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserSortColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding EsTitulo}" Value="True">
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Background" Value="{DynamicResource Brush.ChapterRowBg}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
                  <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="ÍTEM" Binding="{Binding Item}" Width="70" HeaderStyle="{StaticResource CenteredColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                  <Setter Property="TextAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" MinWidth="180" />
            <DataGridTextColumn Header="UD" Binding="{Binding Unidad}" Width="50" HeaderStyle="{StaticResource CenteredColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextAlignment" Value="Center" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="CANT. CONTRATO" Binding="{Binding CantidadContractualLabel}" Width="90" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="P.U. CONTRATO" Binding="{Binding PrecioUnitarioLabel}" Width="90" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="TOTAL CONTRATO" Binding="{Binding TotalContractualLabel}" Width="100" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="CANT. ANTERIOR" Binding="{Binding CantidadAnteriorLabel}" Width="85" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="CANT. PERÍODO" Width="85" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding CantidadPeriodoText, UpdateSourceTrigger=PropertyChanged}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Background="{DynamicResource Brush.Surface2}"
                           BorderBrush="{DynamicResource Brush.InputBorder}"
                           BorderThickness="1" Margin="2,0" Padding="2" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="CANT. ACUM." Binding="{Binding CantidadAcumuladaLabel}" Width="85" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="MONTO PERÍODO" Binding="{Binding MontoPeriodoLabel}" Width="100" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="MONTO ACUM." Binding="{Binding MontoAcumuladoLabel}" Width="100" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn Header="% AVANCE" Width="75" HeaderStyle="{StaticResource CenteredColumnHeader}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvancePctLabel}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Success}" />
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Line}" Margin="4,2">
                      <Border CornerRadius="2" Background="{DynamicResource Brush.Success}" HorizontalAlignment="Left" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="SALDO" Binding="{Binding SaldoLabel}" Width="90" HeaderStyle="{StaticResource NumericColumnHeader}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                  <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
    </Border>

    <!-- ═══ KPI BAR ═══ -->
    <Border Grid.Row="5" Background="{DynamicResource Brush.Surface}" Padding="14,10" Margin="12,0,12,8" CornerRadius="10"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="8" Padding="12,8" Margin="2">
          <StackPanel>
            <TextBlock Text="AVANCE PERÍODO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
            <TextBlock Text="{Binding PeriodAmountLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ActiveRowCount, StringFormat={}{0} partidas ejecutadas}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="8" Padding="12,8" Margin="2">
          <StackPanel>
            <TextBlock Text="AVANCE ACUMULADO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
            <TextBlock Text="{Binding AccumulatedLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ProgressPctLabel, StringFormat={}{0} del contrato}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource Brush.AmberSoft}" CornerRadius="8" Padding="12,8" Margin="2">
          <StackPanel>
            <TextBlock Text="SALDO POR EJECUTAR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" />
            <TextBlock Text="{Binding BalanceLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            <TextBlock Text="Pendiente de valorizar" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Background="{DynamicResource Brush.PurpleSoft}" CornerRadius="8" Padding="12,8" Margin="2">
          <StackPanel>
            <TextBlock Text="CONTRATO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Purple}" />
            <TextBlock Text="{Binding ContractAmountLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            <TextBlock Text="Valor total del contrato" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="8" Padding="12,8" Margin="2">
          <StackPanel>
            <TextBlock Text="PARTIDAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
            <TextBlock Text="{Binding TotalRowCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            <TextBlock Text="Partidas en itemizado" FontSize="10" Foreground="{DynamicResource Brush.Ink4}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ═══ STATUS MESSAGE ═══ -->
    <Border Grid.Row="6" Background="{DynamicResource Brush.Surface}" Padding="10,6" Margin="12,0,12,8" CornerRadius="6"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Ink4}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
