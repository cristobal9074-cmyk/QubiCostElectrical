<UserControl x:Class="QubiCostElectrical.Wpf.Features.ChangeOrders.ChangeOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="ChipCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SlateLight}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="ChipNum" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/>
    </Style>
    <Style x:Key="ChipLbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Slate}"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ─── Título ────────────────────────────────────────────────────────── -->
    <TextBlock Grid.Row="0" Text="Órdenes de cambio"
               FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}"
               Margin="0,0,0,12"/>

    <!-- ─── Estado vacío — sin proyecto ────────────────────────────────────── -->
    <Border Grid.Row="1" Grid.RowSpan="4"
            Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}}"
            VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Sin proyecto abierto" FontSize="14" Foreground="{DynamicResource Brush.Slate2}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Abre o crea un proyecto para gestionar órdenes de cambio."
                   FontSize="11" Foreground="{DynamicResource Brush.Slate3}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- ─── Panel resumen ────────────────────────────────────────────────── -->
    <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,12"
                 Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Border Style="{StaticResource ChipCard}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="{Binding TotalOrdenes}" Style="{StaticResource ChipNum}"/>
          <TextBlock Text="Total" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ChipCard}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="{Binding TotalBorrador}" Style="{StaticResource ChipNum}"/>
          <TextBlock Text="Borrador" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ChipCard}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="{Binding TotalEnRevision}" Style="{StaticResource ChipNum}"/>
          <TextBlock Text="En revisión" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ChipCard}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="{Binding TotalAprobado}" Style="{StaticResource ChipNum}" Foreground="{DynamicResource Brush.Success}"/>
          <TextBlock Text="Aprobado" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ChipCard}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="{Binding TotalRechazado}" Style="{StaticResource ChipNum}" Foreground="{DynamicResource Brush.Danger}"/>
          <TextBlock Text="Rechazado" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ChipCard}" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="{Binding MontoAprobado, StringFormat={}{0:N3} UF}"
                     Style="{StaticResource ChipNum}" Foreground="{DynamicResource Brush.Success}" FontSize="13"/>
          <TextBlock Text="Monto aprobado" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource ChipCard}" Margin="0">
        <StackPanel>
          <TextBlock Text="{Binding MontoPendiente, StringFormat={}{0:N3} UF}"
                     Style="{StaticResource ChipNum}" FontSize="13"/>
          <TextBlock Text="Monto pendiente" Style="{StaticResource ChipLbl}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- ─── Barra de acciones ──────────────────────────────────────────────── -->
    <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False"
                Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <Button Style="{StaticResource Button.Primary}" Content="+ Nueva OC"
              Click="OnAddClick" Padding="14,0" Height="30"/>
      <Button Style="{StaticResource Button.Secondary}" Content="Editar" Margin="6,0,0,0"
              IsEnabled="{Binding CanEdit}" Click="OnEditClick" Padding="12,0" Height="30"/>
      <Button Content="Eliminar" Margin="6,0,0,0" Padding="12,0" Height="30"
              IsEnabled="{Binding CanDelete}" Click="OnDeleteClick"
              Foreground="{DynamicResource Brush.Danger}" Background="Transparent" BorderBrush="{DynamicResource Brush.DangerBorder}" BorderThickness="1"/>
      <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4"/>
      <Button Style="{StaticResource Button.Secondary}" Content="→ En revisión" Margin="0,0,6,0"
              IsEnabled="{Binding CanEnviarRevision}" Click="OnEnviarRevisionClick" Padding="10,0" Height="30"/>
      <Button Style="{StaticResource Button.Secondary}" Content="✓ Aprobar" Margin="0,0,6,0"
              IsEnabled="{Binding CanAprobar}" Click="OnAprobarClick" Padding="10,0" Height="30"
              Foreground="{DynamicResource Brush.Success}"/>
      <Button Style="{StaticResource Button.Secondary}" Content="✗ Rechazar" Margin="0,0,6,0"
              IsEnabled="{Binding CanRechazar}" Click="OnRechazarClick" Padding="10,0" Height="30"
              Foreground="{DynamicResource Brush.Danger}"/>
      <Button Style="{StaticResource Button.Secondary}" Content="↩ Reabrir" Margin="0,0,0,0"
              IsEnabled="{Binding CanReabrir}" Click="OnReabrirClick" Padding="10,0" Height="30"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
      <TextBlock Text="Impacto neto acumulado: " FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding ImpactoNetoDisplay}" FontSize="11" FontWeight="Bold"
                 FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
    </StackPanel>
    </DockPanel>

    <!-- ─── Búsqueda y filtros ────────────────────────────────────────────── -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10"
                Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Border BorderBrush="{DynamicResource Brush.SlateLight}" BorderThickness="1" CornerRadius="4" Padding="6,0" Width="220">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 BorderThickness="0" FontSize="11" VerticalAlignment="Center" Height="26"
                 AutomationProperties.Name="Buscar órdenes">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Background">
                    <Setter.Value>
                      <VisualBrush Stretch="None" AlignmentX="Left">
                        <VisualBrush.Visual>
                          <TextBlock Text="Buscar…" Foreground="{DynamicResource Brush.Slate2}" FontSize="11"
                                     Padding="0,4,0,0"/>
                        </VisualBrush.Visual>
                      </VisualBrush>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
      </Border>
      <ComboBox x:Name="EstadoFilterBox" Margin="8,0,0,0" Width="160" Style="{StaticResource Form.ComboBox}"
                AutomationProperties.Name="Filtrar por estado"
                SelectionChanged="OnFilterEstadoChanged">
        <ComboBoxItem Content="Todos los estados" Tag=""/>
        <ComboBoxItem Content="Borrador" Tag="Borrador"/>
        <ComboBoxItem Content="En revisión" Tag="En revisión"/>
        <ComboBoxItem Content="Aprobado" Tag="Aprobado"/>
        <ComboBoxItem Content="Rechazado" Tag="Rechazado"/>
      </ComboBox>
      <Button Content="Limpiar filtros" Margin="8,0,0,0" FontSize="11" Padding="8,0" Height="28"
              Background="Transparent" BorderBrush="{DynamicResource Brush.SlateLight}" BorderThickness="1"
              Click="OnClearFiltersClick"/>
    </StackPanel>

    <!-- ─── Tabla ─────────────────────────────────────────────────────────── -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10"
            Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <DataGrid ItemsSource="{Binding Items}"
                SelectedItem="{Binding Selected, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                RowHeight="36" FontSize="11"
                SelectionMode="Single" SelectionUnit="FullRow"
                Style="{StaticResource DataGrid.Workspace}"
                BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
                MouseDoubleClick="OnRowDoubleClick"
                AutomationProperties.Name="Lista de órdenes de cambio">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#"           Binding="{Binding Seq}"            Width="36"/>
          <DataGridTextColumn Header="Número"      Binding="{Binding Numero}"         Width="90"/>
          <DataGridTextColumn Header="Título"      Binding="{Binding Titulo}"         Width="*"/>
          <DataGridTemplateColumn Header="Estado" Width="120" SortMemberPath="Estado">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="{StaticResource Radius.Chip}" Padding="9,3" Margin="4,2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="Aprobado">
                          <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="Rechazado">
                          <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="En revisión">
                          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Estado}" FontSize="10" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Estado}" Value="Aprobado">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Estado}" Value="Rechazado">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Estado}" Value="En revisión">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Fecha"       Binding="{Binding FechaDisplay}"   Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Creada por"  Binding="{Binding CreadoPor}"      Width="110"/>
          <DataGridTextColumn Header="Impacto" Binding="{Binding DeltaDisplay}" Width="100">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}"/>
                <Style.Triggers>
                  <!-- Rojo aumenta / verde reduce, como el prototipo -->
                  <DataTrigger Binding="{Binding DeltaKind}" Value="Aumenta">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding DeltaKind}" Value="Reduce">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Nota"        Binding="{Binding Nota}"           Width="140"/>
        </DataGrid.Columns>

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding EstadoDisplay}"/>
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
