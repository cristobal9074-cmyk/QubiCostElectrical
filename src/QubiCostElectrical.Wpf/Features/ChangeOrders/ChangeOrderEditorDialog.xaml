<Window x:Class="QubiCostElectrical.Wpf.Features.ChangeOrders.ChangeOrderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:QubiCostElectrical.Wpf.Infrastructure"
        Style="{StaticResource Dialog.Window}"
        Title="Espacio de Trabajo — Adicional de Obra &amp; Cubicación"
        Width="1280" Height="820"
        MinWidth="1050" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Ui}">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="240"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ── 1. Cabecera y Datos del Adicional ── -->
      <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Fila Superior: Título y Botones Principales -->
          <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
              <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.BlueFocus}"
                      BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                <TextBlock x:Name="NumeroBadge" Text="{Binding Numero}" FontWeight="Bold"
                           FontFamily="{StaticResource Font.Mono}" FontSize="13"
                           Foreground="{DynamicResource Brush.Accent}"/>
              </Border>
              <TextBlock x:Name="TitleBlock" Text="Adicional de Obra &amp; Cubicación"
                         Style="{StaticResource Dialog.HeaderTitle}" FontSize="15" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource Brush.AmberSoft}" BorderBrush="{DynamicResource Brush.AmberBorder}"
                      BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="🔒 Precios Contractuales Congelados" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Amber}"/>
              </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
              <Button Content="🔒 + Partida de Contrato" Style="{StaticResource Button.Primary}"
                      Height="30" Padding="14,0" Margin="0,0,8,0" FontSize="11"
                      ToolTip="Seleccionar partida del contrato original con P.U. congelado"
                      Click="OnAddContractPartidaClick"/>
              <Button Content="✨ + Partida Extraordinaria" Style="{StaticResource Button.Secondary}"
                      Height="30" Padding="14,0" Margin="0,0,8,0" FontSize="11"
                      ToolTip="Crear nueva partida no contemplada en contrato"
                      Click="OnAddExtraPartidaClick"/>
              <Button Content="📦 Lista Consolidada" Style="{StaticResource Button.Secondary}"
                      Height="30" Padding="12,0" FontSize="11"
                      ToolTip="Ver resumen acumulado de todos los materiales a comprar para este adicional"
                      Click="OnVerResumenMaterialesClick"/>
            </StackPanel>
          </DockPanel>

          <!-- Fila Inferior: Inputs de Número, Título y Responsable -->
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- N° Orden -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
              <TextBlock Text="N° Adicional:" Style="{StaticResource Form.Label}" FontSize="10"/>
              <TextBox x:Name="NumeroBox" Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" Height="26" FontSize="11"/>
            </StackPanel>

            <!-- Título / Justificación -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
              <TextBlock Text="Título del adicional / Justificación técnica:" Style="{StaticResource Form.Label}" FontSize="10"/>
              <TextBox x:Name="TituloBox" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                       FontWeight="SemiBold" Height="26" FontSize="11"/>
            </StackPanel>

            <!-- Creado Por -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,0">
              <TextBlock Text="Estimador / Responsable:" Style="{StaticResource Form.Label}" FontSize="10"/>
              <TextBox Text="{Binding CreadoPor, UpdateSourceTrigger=PropertyChanged}" Height="26" FontSize="11"/>
            </StackPanel>

            <!-- Total Venta Adicional -->
            <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="10,4">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TOTAL VENTA ADICIONAL:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"/>
                <TextBlock Text="{Binding TotalAdicionalDisplay}" FontSize="15" FontWeight="Bold"
                           FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Success}"/>
              </StackPanel>
            </Border>

            <!-- Nota / Observaciones -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,8,0">
              <TextBlock Text="📝 Nota / Observaciones:" Style="{StaticResource Form.Label}" FontSize="10"/>
              <TextBox x:Name="NotaBox"
                       Text="{Binding Nota, UpdateSourceTrigger=PropertyChanged}"
                       Height="26" FontSize="11"
                       ToolTip="Observaciones internas del adicional (no se exportan a la oferta)"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- ── 2. Panel Superior: Partidas del Adicional (Master) ── -->
      <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Cabecera de la sección de partidas -->
          <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="📋 PARTIDAS DEL ADICIONAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"/>
                <TextBlock Text=" (Seleccione una partida para ver y cubicar sus zonas abajo)"
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding Lineas.Count, StringFormat={}{0} partidas en adicional}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Tabla de Partidas -->
          <DataGrid Grid.Row="1" x:Name="LineasGrid"
                    ItemsSource="{Binding Lineas}"
                    SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="{DynamicResource Brush.Line}"
                    RowHeight="32" FontSize="11"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    Style="{StaticResource DataGrid.Workspace}"
                    BorderThickness="0">
            <DataGrid.Columns>
              <!-- Tipo -->
              <DataGridTemplateColumn Header="Tipo" Width="105">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="5,2" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EsContractual}" Value="False">
                              <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding TipoEtiqueta}" FontSize="10" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsContractual}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Ítem -->
              <DataGridTextColumn Header="Ítem" Binding="{Binding Item}" Width="65" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Descripción -->
              <DataGridTemplateColumn Header="Descripción de la partida" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0">
                      <TextBlock Text="{Binding DescripcionPartida}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding MaterialesBadgeText}" FontSize="10" Foreground="{DynamicResource Brush.Accent}"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Unidad -->
              <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="55" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Cant. Contrato Base -->
              <DataGridTextColumn Header="Cant. Base" Binding="{Binding CantidadBase, StringFormat={}{0:N0}}" Width="75" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                    <Setter Property="Padding" Value="0,0,4,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Δ Cantidad Adicional (Cubipada) -->
              <DataGridTemplateColumn Header="Δ Cant. Adicional" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.BlueFaint}" CornerRadius="4" Padding="6,2" Margin="2">
                      <TextBlock Text="{Binding CantidadAdicionalText}" FontWeight="Bold"
                                 FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding CantidadAdicionalText, UpdateSourceTrigger=LostFocus}"
                             FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                             TextAlignment="Right" VerticalContentAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>

              <!-- P.U. Venta (Contractual 🔒 o Extraordinaria ✨) -->
              <DataGridTemplateColumn Header="P.U. Venta" Width="115">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="6,2" Margin="2" HorizontalAlignment="Right">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EsContractual}" Value="False">
                              <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒 " FontSize="9" VerticalAlignment="Center"
                                   Visibility="{Binding EsContractual, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding PrecioUnitarioText}" FontWeight="SemiBold"
                                   FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding EsContractual}" Value="False">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding PrecioUnitarioText, UpdateSourceTrigger=LostFocus}"
                             FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                             TextAlignment="Right" VerticalContentAlignment="Center"
                             IsEnabled="{Binding EsContractual, Converter={StaticResource InverseBool}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>

              <!-- Subtotal Venta -->
              <DataGridTextColumn Header="Subtotal Venta" Binding="{Binding SubtotalDisplay}" Width="120" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                    <Setter Property="Padding" Value="0,0,6,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Quitar botón -->
              <DataGridTemplateColumn Width="45">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="✕" ToolTip="Quitar partida del adicional"
                            Click="OnRemoveLineClick"
                            Foreground="{DynamicResource Brush.Danger}" Background="Transparent"
                            BorderThickness="0" FontWeight="Bold" FontSize="12"
                            Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Separador Divisor -->
      <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Line}"/>

      <!-- ── 3. Panel Inferior: EL CUBICADOR DE ZONAS (Detail - Idéntico a la Foto) ── -->
      <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,4,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Cabecera de la Partida en Cubicación (Estilo QubiCost) -->
          <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <!-- Tag Box Ítem (ej 1.2.-) -->
                <Border Background="{DynamicResource Brush.BlueFaint}" BorderBrush="{DynamicResource Brush.BlueFocus}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                  <TextBlock Text="{Binding SelectedLineItemText}" FontWeight="Bold" FontSize="12"
                             Foreground="{DynamicResource Brush.Accent}"/>
                </Border>
                <!-- Nombre de Partida -->
                <TextBlock Text="{Binding SelectedLineDescText}" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,12,0"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="(v) Observación" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- UD (Unidad de la partida) -->
                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="4" Background="White"
                        Height="26" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Unidad de la partida">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="UD: " FontSize="10" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedLine.Unidad, FallbackValue='gl'}" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>

                <!-- CANT (Badge Verde Idéntico a Cubicación - Editable) -->
                <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                        BorderThickness="1" CornerRadius="4" Height="26" Padding="6,1" VerticalAlignment="Center"
                        ToolTip="Cantidad adicional total para esta partida. Puede editarla aquí o cubicarla en las casillas abajo.">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CANT: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="PartidaCantBox"
                             Text="{Binding SelectedLine.CantidadAdicionalText, UpdateSourceTrigger=LostFocus}"
                             FontWeight="Bold" FontSize="12" FontFamily="{StaticResource Font.Mono}"
                             Foreground="{DynamicResource Brush.Success}" Background="Transparent"
                             BorderThickness="0" VerticalAlignment="Center" MinWidth="55" TextAlignment="Right"
                             PreviewKeyDown="OnPartidaCantBoxPreviewKeyDown"
                             LostFocus="OnPartidaCantBoxLostFocus"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Herramientas del Cubicador -->
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="+ Agregar Fila" Style="{StaticResource Button.Primary}"
                        Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                        Click="OnAddMaterialClick"/>
                <Button Content="📋 Precargar del Contrato" Style="{StaticResource Button.Secondary}"
                        Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                        ToolTip="Copia los materiales originales de esta partida y los escala a la cantidad adicional"
                        Click="OnPrecargarBaseClick"/>
                <Button Content="🔍 Banco de Precios" Style="{StaticResource Button.Secondary}"
                        Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                        ToolTip="Consultar precios en catálogo general"
                        Click="OnBuscarEnBancoClick"/>
                <!-- Selector de Modo: Casillas / Detalle (Idéntico a Cubicación) -->
                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="2" Margin="0,0,6,0">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="CasillasBtn" Content="Casillas" Height="24" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                            Click="OnCasillasViewClick" ToolTip="Modo Casillas de cubicación (matriz continua de sectores)">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                          <Setter Property="Background" Value="White"/>
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}"/>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button x:Name="DetalleBtn" Content="Detalle" Height="24" Padding="10,0" FontSize="11" FontWeight="SemiBold"
                            Click="OnDetalleViewClick" ToolTip="Modo Detalle de precios unitarios y subtotales">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Planilla Matricial de Zonas estilo Excel (Idéntico a Cubicación) -->
          <DataGrid Grid.Row="1" x:Name="ActiveMaterialesGrid"
                    ItemsSource="{Binding ActiveMateriales}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="All"
                    HorizontalGridLinesBrush="#E2E8F0"
                    VerticalGridLinesBrush="#E2E8F0"
                    Background="White"
                    RowBackground="White"
                    AlternatingRowBackground="#F8FAFC"
                    RowHeight="28" FontSize="11"
                    SelectionMode="Single" SelectionUnit="Cell"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.CanContentScroll="True"
                    FrozenColumnCount="5"
                    Style="{StaticResource DataGrid.Workspace.Excel}"
                    infra:DataGridExcelNavigation.Enable="True"
                    infra:DataGridExcelNavigation.HandlePasteByHost="True"
                    PreparingCellForEdit="OnGridPreparingCellForEdit"
                    CellEditEnding="OnGridCellEditEnding"
                    BorderThickness="0">
            <DataGrid.Columns>
              <!-- # (Número de Fila) -->
              <DataGridTemplateColumn Header="#" Width="38" CanUserResize="False" CanUserSort="False">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- CÓDIGO -->
              <DataGridTextColumn x:Name="CodigoColumn" Header="CÓDIGO" Binding="{Binding Codigo, UpdateSourceTrigger=LostFocus}" Width="115">
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}" />
                </DataGridTextColumn.CellStyle>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Padding" Value="4,0" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.EditingElementStyle>
                  <Style TargetType="TextBox">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="2,0" />
                  </Style>
                </DataGridTextColumn.EditingElementStyle>
              </DataGridTextColumn>

              <!-- DESCRIPCIÓN -->
              <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="180">
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}" />
                </DataGridTextColumn.CellStyle>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- UD (Unidad) -->
              <DataGridTextColumn Header="UD" Binding="{Binding Unidad, UpdateSourceTrigger=LostFocus}" Width="46" MinWidth="40">
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}" />
                </DataGridTextColumn.CellStyle>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- CANT (Badge Verde Idéntico a la Foto) -->
              <DataGridTemplateColumn Header="CANT" Width="85" MinWidth="75">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}" />
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                            BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="2,1">
                      <TextBlock Text="{Binding CantidadDisplay}" FontWeight="Bold"
                                 FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Columnas de Zonas se inyectan dinámicamente aquí según las configuradas en el proyecto -->

              <!-- P.U. Material ($) - Visible en Modo Detalle -->
              <DataGridTextColumn x:Name="MatPriceColumn" Header="P. Mat ($)" Binding="{Binding MatClpText, UpdateSourceTrigger=LostFocus}" Width="85" Visibility="Collapsed">
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}" />
                </DataGridTextColumn.CellStyle>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="Padding" Value="0,0,4,0" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.EditingElementStyle>
                  <Style TargetType="TextBox">
                    <Setter Property="TextAlignment" Value="Right" />
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                  </Style>
                </DataGridTextColumn.EditingElementStyle>
              </DataGridTextColumn>

              <!-- Subtotal Fila ($ / UF) - Visible en Modo Detalle -->
              <DataGridTextColumn x:Name="SubtotalMatColumn" Header="Subtotal" Binding="{Binding SubtotalDisplay}" Width="95" IsReadOnly="True" Visibility="Collapsed">
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}" />
                </DataGridTextColumn.CellStyle>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                    <Setter Property="Padding" Value="0,0,6,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Quitar Material -->
              <DataGridTemplateColumn Width="34">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCell.Excel}">
                    <Setter Property="Focusable" Value="False" />
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="✕" ToolTip="Quitar material"
                            Click="OnRemoveMaterialClick"
                            Foreground="{DynamicResource Brush.Danger}" Background="Transparent"
                            BorderThickness="0" FontWeight="Bold" FontSize="11"
                            Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Popup autocompletado de Banco de Precios -->
          <Popup x:Name="AutocompletePopup" StaysOpen="False"
                 Placement="Bottom" AllowsTransparency="True"
                 Focusable="False">
            <Border Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="6" MaxHeight="260" MinWidth="440" Width="500">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.18" ShadowDepth="3" />
              </Border.Effect>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="AutocompleteList" Grid.Row="0"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnAutocompleteMouseLeftButtonDown"
                         KeyDown="OnAutocompleteKeyDown">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="40"/>
                          <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Unidad}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding MatClpConFallback, StringFormat={}$ {0:N0}}" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,1,0,0" Padding="8,4">
                  <TextBlock Text="↑↓ para navegar · Enter o Clic para seleccionar · Esc para cerrar" FontSize="10"
                             Foreground="{DynamicResource Brush.Muted}"/>
                </Border>
              </Grid>
            </Border>
          </Popup>

          <!-- Pie del Cubicador: Totales de la Partida Activa -->
          <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel LastChildFill="False">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Medición Total Cubipada de la Partida: " FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                <Border Background="{DynamicResource Brush.SuccessBg}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="4,0,8,0">
                  <TextBlock Text="{Binding SelectedLineCantTotalDisplay}" FontWeight="Bold"
                             FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Success}"/>
                </Border>
                <TextBlock Text="➔ Vinculada directamente a Δ Cantidad de la partida" FontSize="10"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedLinePuLabel}" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                <TextBlock Text="{Binding SelectedLinePuDisplay}" FontWeight="Bold"
                           FontFamily="{StaticResource Font.Mono}" Margin="0,0,16,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedLine.EsContractual}" Value="False">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Subtotal Venta Partida: " FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
                <TextBlock Text="{Binding SelectedLineSubtotalDisplay}" FontWeight="Bold"
                           FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Success}"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ── 4. Botones Footer ── -->
      <DockPanel Grid.Row="4" Style="{StaticResource Dialog.Footer}" LastChildFill="False" Margin="0,4,0,0">
        <Button DockPanel.Dock="Left" Content="Cancelar" IsCancel="True"
                Style="{StaticResource Button.Secondary}" MinWidth="90"/>
        <Button DockPanel.Dock="Right" Content="✓ Guardar Adicional" IsDefault="True"
                Style="{StaticResource Button.Primary}" MinWidth="150" Click="OnSave"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
