<Window x:Class="QubiCostElectrical.Wpf.Features.ChangeOrders.ChangeOrderPartidaPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Seleccionar Partida del Contrato (P.U. Fijo 🔒)"
        Width="780" Height="520"
        MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Ui}">
  <Border Style="{StaticResource Dialog.Chrome}" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <DockPanel Grid.Row="0" Margin="0,0,0,10">
        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.AmberSoft}"
                BorderBrush="{DynamicResource Brush.AmberBorder}" BorderThickness="1"
                CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="🔒" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="P.U. Contractual Congelado" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Partidas del Presupuesto Contratado" Style="{StaticResource Dialog.HeaderTitle}"/>
          <TextBlock Text="Seleccione la partida para ingresar la cantidad adicional. Su precio unitario se mantendrá inalterable."
                     FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
        </StackPanel>
      </DockPanel>

      <!-- Buscador -->
      <Border Grid.Row="1" Margin="0,0,0,10" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Brush.Surface}">
        <Grid Margin="8,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                   FontSize="12" VerticalAlignment="Center"
                   TextChanged="OnSearchTextChanged"
                   PreviewKeyDown="OnSearchPreviewKeyDown"/>
          <TextBlock x:Name="SearchWatermark" Grid.Column="1" Text="Buscar por ítem (ej. 1.2), código o descripción de la partida…"
                     FontSize="12" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center"
                     IsHitTestVisible="False"/>
          <TextBlock x:Name="CountLabel" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Tabla de Partidas -->
      <Border Grid.Row="2" Style="{StaticResource Card.Surface}" Padding="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
        <DataGrid x:Name="PartidasGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="34" FontSize="11"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  Style="{StaticResource DataGrid.Workspace}"
                  BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
                  MouseDoubleClick="OnGridDoubleClick"
                  SelectionChanged="OnGridSelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Ítem" Binding="{Binding Item}" Width="75">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="Padding" Value="6,0"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Descripción de la partida contractual" Binding="{Binding Descripcion}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="Padding" Value="4,0"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="65">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="Cant. Contrato" Binding="{Binding CantidadDisplay}" Width="110">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                  <Setter Property="Padding" Value="0,0,8,0"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTemplateColumn Header="P.U. Contrato 🔒" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Brush.AmberSoft}" CornerRadius="4" Padding="6,2" Margin="2" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="🔒 " FontSize="9" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding PrecioUnitarioDisplay}" FontWeight="SemiBold"
                                 FontFamily="{StaticResource Font.Mono}"
                                 Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Footer -->
      <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Left" Content="Cancelar" IsCancel="True"
                Style="{StaticResource Button.Secondary}" MinWidth="90"/>
        <Button DockPanel.Dock="Right" x:Name="SelectBtn" Content="✓ Seleccionar para Adicional" IsDefault="True"
                Style="{StaticResource Button.Primary}" MinWidth="180" Click="OnSelectClick" IsEnabled="False"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
