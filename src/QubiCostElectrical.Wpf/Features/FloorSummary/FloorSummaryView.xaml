<UserControl x:Class="QubiCostElectrical.Wpf.Features.FloorSummary.FloorSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.FloorSummary">

  <UserControl.Resources>
    <!-- Template para la lista de materiales dentro de una categoría -->
    <DataTemplate x:Key="MaterialItemTemplate">
      <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{Binding Codigo}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue2}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Descripcion}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
          <TextBlock Grid.Column="2" Text="{Binding Unidad}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
          <TextBlock Grid.Column="3" Text="{Binding Cantidad, StringFormat={}{0:#,##0.##}}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="4" Text="{Binding PrecioUnitClp, StringFormat={}{0:C0}}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="5" Text="{Binding SubtotalClp, StringFormat={}{0:C0}}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,10,0" />

          <!-- Fuente Badge -->
          <Border Grid.Column="6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Fuente}" Value="Cub. SC">
                    <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding Fuente}" FontSize="9" FontWeight="Bold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Fuente}" Value="Cub. SC">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- Estado vacío -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver el resumen consolidado de materiales por piso.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <!-- Contenido principal -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Cabecera de Página -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,14" Background="{DynamicResource Brush.Surface}">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Resumen por piso" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Barra de herramientas -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="20,10" Background="{DynamicResource Brush.Surface2}">
        <DockPanel LastChildFill="True">
          <!-- Búsqueda -->
          <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Form.SearchBox}" Tag="Buscar material por código o descripción..." Height="30" />
          
          <!-- Filtros de origen -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0">
            <RadioButton Content="Todos" Command="{Binding FilterSourceCommand}" CommandParameter="Todos" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" Margin="0,0,6,0" />
            <RadioButton Content="Solo cubicación" Command="{Binding FilterSourceCommand}" CommandParameter="Cubicación" Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" Margin="0,0,6,0" />
            <RadioButton Content="Solo Cub. SC" Command="{Binding FilterSourceCommand}" CommandParameter="Cub. SC" Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" />
          </StackPanel>

          <!-- Consolidación de Servicios Comunes -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Consolidar SC:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding ConsolidacionModeOptions}" SelectedItem="{Binding SelectedConsolidacionMode}" Style="{StaticResource Form.ComboBox}" Width="220" Height="28" />
          </StackPanel>

          <!-- Acciones derechas -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Secondary}" Content="Actualizar" Command="{Binding RefreshCommand}" Height="30" Width="100" Margin="0,0,8,0" />
            <Button Style="{StaticResource Button.Primary}" Content="Exportar Excel" Command="{Binding ExportExcelCommand}" Height="30" Width="120" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Franja de KPIs -->
      <UniformGrid Grid.Row="2" Columns="4" Margin="20,14" Height="70">
        <Border Style="{StaticResource Card.Kpi}" Padding="14,12" Margin="0,0,10,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Zonas / Pisos" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding TotalFloors}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Kpi}" Padding="14,12" Margin="0,0,10,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Materiales Únicos" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding UniqueMaterialsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Kpi}" Padding="14,12" Margin="0,0,10,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Costo Total Materiales" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding GrandTotalCost, StringFormat={}{0:C0}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Amber}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card.Kpi}" Padding="14,12">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Líneas Consolidadas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding TakeoffLinesCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Acordeón de pisos -->
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="20,0,20,14">
        <ItemsControl ItemsSource="{Binding FloorCards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:FloorCardVm}">
              <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Brush.Surface}" Margin="0,0,0,10">
                <StackPanel>
                  <!-- Cabecera de Tarjeta -->
                  <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="14,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Piso" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Ink3}" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding ZonaNombre}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" />
                          <TextBlock Text="{Binding MetaText}" FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CostoTotalClp, StringFormat={}{0:C0}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,14,0" />
                        <TextBlock Text="▶" FontSize="10" Foreground="{DynamicResource Brush.Muted}">
                          <TextBlock.LayoutTransform>
                            <RotateTransform Angle="0" />
                          </TextBlock.LayoutTransform>
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                  <Setter Property="Text" Value="▼" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </ToggleButton>

                  <!-- Cuerpo de Tarjeta (Materiales Agrupados) -->
                  <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Background="{DynamicResource Brush.Surface2}">
                      <ItemsControl ItemsSource="{Binding Materiales}" ItemTemplate="{StaticResource MaterialItemTemplate}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Barra de Total General inferior -->
      <Border Grid.Row="4" Background="{DynamicResource Brush.Navy}" Padding="20,12">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="TOTAL GENERAL ACUMULADO — MATERIALES DEL PROYECTO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderMuted}" />
            <TextBlock Text="Consolidado final de todas las zonas/pisos y Servicios Comunes" FontSize="9" Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,1,0,0" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotalCost, StringFormat={}{0:C0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
