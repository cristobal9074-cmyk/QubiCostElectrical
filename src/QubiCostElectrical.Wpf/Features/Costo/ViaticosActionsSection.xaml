<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.ViaticosActionsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Grid.Row="2" Background="{DynamicResource Brush.WorkspaceBar}" BorderBrush="{DynamicResource Brush.SlateLight}" BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel LastChildFill="False">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Total a aplicar en Gastos Operacionales · 3.3" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Ink3}" />
          <TextBlock Text="{Binding FootTotalLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button AutomationProperties.Name="Cancelar" Content="Cancelar" Click="OnCancel" Style="{StaticResource Button.Secondary}" Padding="14,9" Margin="0,0,8,0" />
          <Button AutomationProperties.Name="Aplicar a GO 3.3" Content="Aplicar a GO 3.3" Click="OnApply" Style="{StaticResource Button.Primary}" Padding="16,9" FontWeight="SemiBold" />
        </StackPanel>
      </DockPanel>
    </Border>
</UserControl>

