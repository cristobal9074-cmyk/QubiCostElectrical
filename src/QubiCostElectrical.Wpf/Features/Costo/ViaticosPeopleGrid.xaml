<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.ViaticosPeopleGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="ViaticosProfesionalDialog.Resources.xaml" /></UserControl.Resources>
  <Border Background="{DynamicResource Brush.PanelHeader}" Padding="20" BorderBrush="{DynamicResource Brush.SlateLight}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Resumen para GO 3.3" Style="{StaticResource Text.SectionTitle}" /><TextBlock Text="Líneas que se cargarán al gasto operacional." Style="{StaticResource Text.Helper}" Margin="0,4,0,14" /></StackPanel>
      <DataGrid Grid.Row="1" Style="{StaticResource DataGrid.Workspace}" AutomationProperties.Name="Líneas de viáticos" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="180">
        <DataGrid.Columns><DataGridTextColumn Header="CONCEPTO" Binding="{Binding Concepto}" Width="*" /><DataGridTextColumn Header="GRUPO" Binding="{Binding GrupoLabel}" Width="90" /><DataGridTextColumn Header="UNIDAD" Binding="{Binding Unidad}" Width="70" /><DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadLabel}" Width="90" /><DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioLabel}" Width="110" /><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalLabel}" Width="110" /><DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoLabel}" Width="90" /></DataGrid.Columns>
      </DataGrid>
      <Border Grid.Row="2" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Sm}" Padding="14" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TOTAL GENERAL" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding FootTotalLabel}" FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="EQUIVALENCIA UF" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding FootUfLabel}" Style="{StaticResource Text.KpiInline}" /></StackPanel></Grid></Border>
    </Grid>
  </Border>
</UserControl>
