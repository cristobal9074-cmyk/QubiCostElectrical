<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.ViaticosNavigationSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sections="clr-namespace:QubiCostElectrical.Wpf.Features.Costo"><Grid Margin="16,14,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="{DynamicResource Brush.SlateLight}" BorderThickness="1" CornerRadius="{StaticResource Radius.Dropdown}" Padding="4" Margin="0,0,0,14"><UniformGrid Columns="4"><Button AutomationProperties.Name="1 · Pasajes" Content="1 · Pasajes" Command="{Binding SelectTabCommand}" CommandParameter="pasajes" Style="{StaticResource VTabBtn}"/><Button AutomationProperties.Name="2 · Alimentación" Content="2 · Alimentación" Command="{Binding SelectTabCommand}" CommandParameter="alim" Style="{StaticResource VTabBtn}"/><Button AutomationProperties.Name="3 · Arriendo" Content="3 · Arriendo" Command="{Binding SelectTabCommand}" CommandParameter="arriendo" Style="{StaticResource VTabBtn}"/><Button AutomationProperties.Name="4 · Resumen GO" Content="4 · Resumen GO" Command="{Binding SelectTabCommand}" CommandParameter="resumen" Style="{StaticResource VTabBtn}"/></UniformGrid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><sections:ViaticosPasajesSection Visibility="{Binding IsTabPasajes, Converter={StaticResource BoolToVisibility}}"/><sections:ViaticosAlimentacionSection Visibility="{Binding IsTabAlim, Converter={StaticResource BoolToVisibility}}"/><sections:ViaticosArriendoSection Visibility="{Binding IsTabArriendo, Converter={StaticResource BoolToVisibility}}"/><sections:ViaticosPeopleGrid Visibility="{Binding IsTabResumen, Converter={StaticResource BoolToVisibility}}"/></Grid></ScrollViewer></Grid></UserControl>
