<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.CostoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             Background="{DynamicResource Brush.Canvas}">

  <UserControl.Resources>
    <Style x:Key="GoCellBox" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.md}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GoCellMono" TargetType="TextBox" BasedOn="{StaticResource GoCellBox}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GoIconBtn" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.lg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GoViaticosBtn" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Content" Value="Calcular viáticos" />
      <Setter Property="ToolTip" Value="Abrir calculadora profesional de viáticos" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <StackPanel>

        <!-- Cabecera -->
        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
          <DockPanel LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Desglose de costos" Style="{StaticResource Text.PageTitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Button.Secondary}" Content="Cubicación" Command="{Binding GoToTakeoffCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Itemizado" Command="{Binding GoToItemizedCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="M. de obra" Command="{Binding GoToManoDeObraCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="EPP" Command="{Binding GoToEppCommand}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Button.Secondary}" Content="Revisión" Command="{Binding GoToReviewCommand}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Resumen compacto -->
        <Border Style="{StaticResource Card.Summary}" Margin="20,10,20,0" Padding="12,6">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock Text="Costo directo" Style="{StaticResource Text.Helper}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CostoDirectoLabel}" Style="{StaticResource Text.KpiInline}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock Text="Total venta" Style="{StaticResource Text.Helper}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TotalVentaLabel}" Style="{StaticResource Text.KpiInline}" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock Text="Margen" Style="{StaticResource Text.Helper}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding MargenLabel}" Style="{StaticResource Text.KpiInline}" Foreground="{DynamicResource Brush.Green}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="UF / m²" Style="{StaticResource Text.Helper}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding UfM2Label}" Style="{StaticResource Text.KpiInline}" Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>

        <StackPanel Margin="20,14,20,24">

          <!-- Familias -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14"
                  Visibility="{Binding ShowFamilias, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Costos por familia de materiales" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Familias}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="200" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Familia}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalLabel}" TextAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.base}" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalMonedaLabel}" TextAlignment="Right"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.xs}"
                                   Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="3" Text="{Binding CountLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- ═══ Mano de Obra (estructura actual) ═══ -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14"
                  Visibility="{Binding ShowMoSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mano de Obra" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding TotalMoLabel}"
                           Style="{StaticResource Text.KpiInline}"
                           Foreground="{DynamicResource Brush.Green}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>

              <TextBlock Text="MO Directa" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Blue}" Margin="0,4,0,2" />
              <ItemsControl ItemsSource="{Binding MoDirectaRows}" Margin="0,0,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Cargo}" FontSize="{StaticResource Font.Size.sm}"
                                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DotacionLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding SueldoLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   FontFamily="{StaticResource Font.Mono}" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.sm}"
                                   FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="{Binding PctLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource Brush.Surface}" Padding="8,4"
                      BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="50" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Total MO directa" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding TotalMoDirectaDotacionLabel}" FontSize="{StaticResource Font.Size.xs}"
                             Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="3" Text="{Binding TotalMoDirectaLabel}" FontSize="{StaticResource Font.Size.sm}"
                             FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                             TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
              </Border>

              <TextBlock Text="MO Indirecta" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Amber}" Margin="0,10,0,2" />
              <ItemsControl ItemsSource="{Binding MoIndirectaRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Cargo}" FontSize="{StaticResource Font.Size.sm}"
                                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DotacionLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding SueldoLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   FontFamily="{StaticResource Font.Mono}" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.sm}"
                                   FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="{Binding PctLabel}" FontSize="{StaticResource Font.Size.xs}"
                                   Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource Brush.Surface}" Padding="8,4"
                      BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="50" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Total MO indirecta" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding TotalMoIndirectaLabel}" FontSize="{StaticResource Font.Size.sm}"
                             FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                             TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
              </Border>

              <Border Background="{DynamicResource Brush.Navy}" Padding="10,6" Margin="0,8,0,0" CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="TOTAL MANO DE OBRA" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.White}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding TotalMoLabel}" FontSize="{StaticResource Font.Size.lg}" FontWeight="Bold"
                             FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}"
                             TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="2" Text="{Binding TotalMoSubLabel}" FontSize="{StaticResource Font.Size.2xs}"
                             Foreground="{DynamicResource Brush.HeaderLabel}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- ═══ Gastos Operacionales · rediseño 20B ═══ -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14"
                  Visibility="{Binding ShowGoSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Gastos Operacionales" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />

              <!-- Hero -->
              <Border CornerRadius="12" Padding="18,16" Margin="0,0,0,12" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
                    <GradientStop Color="{StaticResource Color.Navy2}" Offset="0.55" />
                    <GradientStop Color="{StaticResource Color.BrandDark}" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="TOTAL GASTOS OPERACIONALES" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.HeaderMuted}" />
                      <TextBlock Text="{Binding TotalGoLabel}" FontSize="{StaticResource Font.Size.3xl}" FontWeight="SemiBold"
                                 FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}"
                                 Margin="0,6,0,0" />
                      <TextBlock Text="{Binding TotalGoUfSubLabel}" FontSize="{StaticResource Font.Size.md}"
                                 FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.HeaderMuted}"
                                 Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                      <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White9}" BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Chip}" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock Text="{Binding GoCategoriaCountLabel}" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderInk}" />
                      </Border>
                      <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White9}" BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Chip}" Padding="10,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Ítems " FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderInk}" />
                          <TextBlock Text="{Binding GoItemCountLabel}" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                                     FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.BrandStroke2}" />
                        </StackPanel>
                      </Border>
                      <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White9}" BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Chip}" Padding="10,6">
                        <TextBlock Text="Editable" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.HeaderInk}" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <DockPanel Margin="0,16,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="COMPOSICIÓN DEL GO" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.HeaderDim}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding GoComposeHint}" FontSize="{StaticResource Font.Size.xs}"
                               Foreground="{DynamicResource Brush.HeaderDim}" />
                  </DockPanel>

                  <Border Height="10" CornerRadius="5" Background="{DynamicResource Brush.White12}" ClipToBounds="True">
                    <Viewbox Stretch="Fill" Height="10" HorizontalAlignment="Stretch">
                      <ItemsControl ItemsSource="{Binding GoComposeSegments}" Height="10">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="{Binding WidthUnits}" Height="10" Background="{Binding Fill}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Viewbox>
                  </Border>

                  <ItemsControl ItemsSource="{Binding GoComposeLegend}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                          <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Fill}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding Codigo}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.HeaderControl}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding PctLabel}" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold"
                                     FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}"
                                     VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Toolbar -->
              <DockPanel Margin="0,0,0,10" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Helper}"
                           VerticalAlignment="Center">
                  <Run Text="Clic en categoría · " />
                  <Run Text="Tab" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.xs}" />
                  <Run Text=" entre celdas · totales al salir" />
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Restablecer" Style="{StaticResource Button.Ghost}"
                          Command="{Binding ResetGoPlantillaCommand}" FontSize="{StaticResource Font.Size.md}" Margin="0,0,6,0"
                          IsEnabled="{Binding CanEdit}" ToolTip="Plantilla en 0" />
                  <Button Content="+ Categoría" Style="{StaticResource Button.Secondary}"
                          Command="{Binding AddGoCategoriaCommand}" FontSize="{StaticResource Font.Size.md}"
                          IsEnabled="{Binding CanEdit}" />
                </StackPanel>
              </DockPanel>

              <!-- Acordeón categorías -->
              <ItemsControl ItemsSource="{Binding GastosOperacionales}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Line}" Background="{DynamicResource Brush.Surface2}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandStroke3}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <!-- Header clickable -->
                        <Border Padding="12,11" Cursor="Hand" Background="Transparent">
                          <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.ToggleGoCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" />
                          </Border.InputBindings>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueSoft}" />
                                  <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" MinWidth="120" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="72" />
                              <ColumnDefinition Width="110" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="6" VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="Transparent" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding Chevron}" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Brush.Muted}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="6"
                                    Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Codigo}" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                                         FontFamily="{StaticResource Font.Mono}"
                                         Foreground="{DynamicResource Brush.Blue}" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Concepto}" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding ItemsCountLabel}" FontSize="{StaticResource Font.Size.sm}"
                                         Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource GoViaticosBtn}"
                                    Visibility="{Binding IsViaticosCategory, Converter={StaticResource BoolToVisibility}}"
                                    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Command="{Binding DataContext.OpenViaticosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Grid.Column="4" Text="{Binding UfLabel}" FontSize="{StaticResource Font.Size.sm}"
                                       FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink3}"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="5" Text="{Binding MontoLabel}" FontSize="{StaticResource Font.Size.base}" FontWeight="SemiBold"
                                       FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Grid.Column="6" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="{StaticResource Radius.Chip}"
                                    Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0">
                              <TextBlock Text="{Binding PctLabel}" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                                         Foreground="{DynamicResource Brush.Blue}" />
                            </Border>
                            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"
                                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                              <Button Style="{StaticResource GoIconBtn}" Content="+" ToolTip="Agregar ítem"
                                      Command="{Binding DataContext.AddGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}" />
