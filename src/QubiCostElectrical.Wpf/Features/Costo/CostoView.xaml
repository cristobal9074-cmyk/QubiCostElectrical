<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.CostoView"
             x:Name="CostoRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Costo"
             xmlns:ds="clr-namespace:QubiCostElectrical.Wpf.DesignSystem"
             Background="{DynamicResource Brush.Canvas}">

  <UserControl.Resources>

    <local:FamiliaShareWidthConverter x:Key="ShareWidth" />

    <!-- ─── Barra segmentada de pestañas ─────────────────────────────────── -->
    <Style x:Key="CostoTabChip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="8" Padding="12,6" Margin="2,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ─── Tipografía del hero de KPIs ──────────────────────────────────── -->
    <Style x:Key="CostoKpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.KpiLabel}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CostoKpiValue" TargetType="TextBlock" BasedOn="{StaticResource Text.KpiValue}">
      <Setter Property="FontSize" Value="{StaticResource Font.Size.xl}" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CostoKpiHint" TargetType="TextBlock" BasedOn="{StaticResource Text.KpiHint}">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CostoSubTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>

    <Style x:Key="CostoMicro" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
    </Style>

    <Style x:Key="CostoLine" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Chip de origen: mismo color por código en toda la pantalla. -->
    <Style x:Key="CostoOriginChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CostoOriginChipText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ─── Badge de ayuda técnica (?) ──────────────────────────────────── -->
    <Style x:Key="CostoHelpBadge" TargetType="Border">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Help" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="50" />
      <Setter Property="ToolTipService.ShowDuration" Value="35000" />
    </Style>

    <Style x:Key="CostoHelpBadgeText" TargetType="TextBlock">
      <Setter Property="Text" Value="?" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,-1,0,0" />
    </Style>

    <!-- ─── Celdas de la planilla de gastos operacionales ────────────────── -->
    <Style x:Key="GoCellBox" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GoCellMono" TargetType="TextBox" BasedOn="{StaticResource GoCellBox}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="GoSheetBox" TargetType="TextBox" BasedOn="{StaticResource GoCellBox}">
      <EventSetter Event="PreviewKeyDown" Handler="OnGoCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnGoCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGoCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnGoCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnGoCellLostFocus" />
    </Style>

    <Style x:Key="GoSheetMono" TargetType="TextBox" BasedOn="{StaticResource GoCellMono}">
      <EventSetter Event="PreviewKeyDown" Handler="OnGoCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnGoCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGoCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnGoCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnGoCellLostFocus" />
    </Style>

    <!-- ─── Celdas de la tabla de familias ───────────────────────────────── -->
    <Style x:Key="CoefCell" TargetType="TextBox" BasedOn="{StaticResource GoCellMono}">
      <Setter Property="Width" Value="58" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <EventSetter Event="PreviewKeyDown" Handler="OnCoefCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnCoefCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnCoefCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnCoefCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnCoefCellLostFocus" />
    </Style>

    <Style x:Key="PrecioFamiliaChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,1,4,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="Arrastra a la fila del material" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPrecioFamiliaMouseDown" />
      <EventSetter Event="PreviewMouseMove" Handler="OnPrecioFamiliaMouseMove" />
    </Style>

    <!-- ─── Rotulación y campos numéricos de cierre ──────────────────────── -->
    <Style x:Key="CierreSec" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="CierreHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CierreLab" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="CierreNum" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

  </UserControl.Resources>

  <Grid>

    <!-- ══════════════════════════════════════════════════════════════════
         Pantalla (oculta si no hay proyecto abierto)
         ══════════════════════════════════════════════════════════════════ -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ─── Cabecera ─────────────────────────────────────────────────── -->
      <Grid Grid.Row="0" Margin="18,12,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Desglose de costos" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Meta.Tag}" Margin="12,0,0,0">
            <TextBlock Text="{Binding Currency}" Style="{StaticResource Meta.Tag.Text}" />
          </Border>
          <TextBlock Text="Pestañas: composición, márgenes, familias, mano de obra y gastos operacionales."
                     FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                  BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,8,0"
                  Visibility="{Binding ShowCurrencyColumn, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="UF" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{Binding ValorUfDiaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Content="Restaurar" Command="{Binding RestoreCostosPresetCommand}" Style="{StaticResource Button.Secondary}"
                  Height="26" Padding="9,0" Margin="0,0,6,0" FontSize="11"
                  ToolTip="{Binding CostosPresetHint}" />
          <Button Content="Guardar preset" Command="{Binding SaveCostosPresetCommand}" Style="{StaticResource Button.Secondary}"
                  Height="26" Padding="9,0" Margin="0,0,6,0" FontSize="11" ToolTip="{Binding CostosPresetHint}" />
          <Button Content="Aplicar al presupuesto" Command="{Binding ApplyCoeficientesCommand}" Style="{StaticResource Button.Primary}"
                  Height="26" Padding="12,0" FontSize="11" />
        </StackPanel>
      </Grid>

      <!-- ─── Hero: 6 KPIs ─────────────────────────────────────────────── -->
      <Border Grid.Row="1" Style="{StaticResource Card.Surface}" Margin="18,10,18,0" Padding="0" ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1.05*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="14,13,12,13">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="COSTO DE EJECUCIÓN" Style="{StaticResource CostoKpiLabel}" />
              <Border Style="{StaticResource CostoHelpBadge}">
                <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                <Border.ToolTip>
                  <ToolTip MaxWidth="380">
                    <StackPanel Margin="3">
                      <TextBlock Text="COSTO DE EJECUCIÓN (COSTO DIRECTO)" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
                      <TextBlock Text="Inversión física directa requerida para materializar las obras según cubicación y especificaciones técnicas. Representa el costo de faena sin recargos comerciales ni gastos de administración central." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,6" />
                      <TextBlock Text="COMPOSICIÓN TÉCNICA:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                      <TextBlock Text="• Materiales netos valorizados de cubicación y APU&#x0a;• Estimación de ferretería menor e insumos de montaje (3%)&#x0a;• Mano de obra total de faena (Directa + Indirecta con leyes)&#x0a;• Gastos operacionales directos de faena (GO)" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="CRITERIO PROFESIONAL:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                      <TextBlock Text="Constituye el piso financiero mínimo irreductible. Cualquier adjudicación por debajo de este monto genera pérdida líquida directa sobre la operación de la empresa." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink2}" />
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding CostoDirectoSubLabel}" Style="{StaticResource CostoKpiValue}" />
            <TextBlock Text="{Binding CostoDirectoLabel}" Style="{StaticResource CostoKpiHint}" />
          </StackPanel>

          <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1,0,0,0">
            <StackPanel Margin="14,13,12,13">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="COSTO TOTAL PROYECTO" Style="{StaticResource CostoKpiLabel}" />
                <Border Style="{StaticResource CostoHelpBadge}">
                  <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                  <Border.ToolTip>
                    <ToolTip MaxWidth="380">
                      <StackPanel Margin="3">
                        <TextBlock Text="COSTO TOTAL PROYECTO (COSTO TÉCNICO)" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
                        <TextBlock Text="Costo técnico integral que incorpora la absorción de costos fijos de oficina central corporativa y la rentabilidad mínima exigida al proyecto." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,6" />
                        <TextBlock Text="FÓRMULA / COMPOSICIÓN:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Costo Ejecución + Gastos Generales (GG %) + Utilidad Aditiva (UT %) + Valor Agregado s/ Equipos (VA %) + Imprevistos/Riesgo." FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="CRITERIO PROFESIONAL:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Equivale al precio de equilibrio en licitaciones por costo más margen (Cost-Plus Markup). Cubre la administración corporativa y la ganancia base presupuestada." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink2}" />
                      </StackPanel>
                    </ToolTip>
                  </Border.ToolTip>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Tabs.CostoProyectoLabel}" Style="{StaticResource CostoKpiValue}" />
              <TextBlock Text="{Binding Tabs.CostoProyectoSub}" Style="{StaticResource CostoKpiHint}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1,0,0,0">
            <StackPanel Margin="14,13,12,13">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DIFERENCIA CON PROYECTO" Style="{StaticResource CostoKpiLabel}" />
                <Border Style="{StaticResource CostoHelpBadge}">
                  <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                  <Border.ToolTip>
                    <ToolTip MaxWidth="380">
                      <StackPanel Margin="3">
                        <TextBlock Text="DIFERENCIA CON EL COSTO DEL PROYECTO" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
                        <TextBlock Text="Delta o margen incremental generado por la aplicación de Factores de Presentación por Familia comercial (multiplicadores de catálogo como 1,70 en canalizaciones o 1,50 en tableros)." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,6" />
                        <TextBlock Text="FÓRMULA DE CUADRATURA:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Diferencia = Venta Neta por Factores − Costo Total Proyecto" FontSize="10" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,6" />
                        <TextBlock Text="INTERPRETACIÓN COMERCIAL:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="• Positiva (+): La estrategia comercial genera una sobreganancia por encima de la utilidad presupuestada.&#x0a;• Negativa (−): Alerta de insuficiencia: los factores no cubren los gastos generales y la utilidad base requerida." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink2}" />
                      </StackPanel>
                    </ToolTip>
                  </Border.ToolTip>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Tabs.DiferenciaFactoresLabel}" Style="{StaticResource CostoKpiValue}" />
              <TextBlock Text="{Binding Tabs.DiferenciaFactoresSub}" Style="{StaticResource CostoKpiHint}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1,0,0,0">
            <StackPanel Margin="14,13,12,13">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MARGEN REAL" Style="{StaticResource CostoKpiLabel}" />
                <Border Style="{StaticResource CostoHelpBadge}">
                  <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                  <Border.ToolTip>
                    <ToolTip MaxWidth="380">
                      <StackPanel Margin="3">
                        <TextBlock Text="MARGEN REAL COMERCIAL" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
                        <TextBlock Text="Porcentaje y monto de rentabilidad efectiva global que aporta el contrato a la empresa sobre el valor neto ofertado al mandante." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,6" />
                        <TextBlock Text="FÓRMULA DE CÁLCULO:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Margen % = ((Venta Neta − Costo Ejecución) ÷ Venta Neta) × 100&#x0a;Monto Margen = Venta Neta − Costo Ejecución" FontSize="10" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,6" />
                        <TextBlock Text="CRITERIO PROFESIONAL:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Representa la contribución marginal neta del proyecto. Con este margen la empresa financia sus costos fijos anuales, contingencias y genera la utilidad neta final." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink2}" />
                      </StackPanel>
                    </ToolTip>
                  </Border.ToolTip>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding MargenLabel}" Style="{StaticResource CostoKpiValue}" />
              <TextBlock Text="{Binding MargenSubLabel}" Style="{StaticResource CostoKpiHint}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="4" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1,0,0,0">
            <StackPanel Margin="14,13,12,13">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="VENTA NETA" Style="{StaticResource CostoKpiLabel}" />
                <Border Style="{StaticResource CostoHelpBadge}">
                  <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                  <Border.ToolTip>
                    <ToolTip MaxWidth="380">
                      <StackPanel Margin="3">
                        <TextBlock Text="VENTA NETA CONTRACTUAL (TOTAL PPTO)" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
                        <TextBlock Text="Precio total ofertado al mandante por la totalidad de las partidas y obras contratadas, antes de impuestos (IVA 19%)." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,6" />
                        <TextBlock Text="COMPOSICIÓN:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Suma de precios de venta unitarios de cubicación × cantidades + Gastos Operacionales (GO) − Descuentos comerciales acordados." FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="CRITERIO PROFESIONAL:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Monto contractual vinculante que se presentará en la Carta Oferta, Estados de Pago y Facturación neta del proyecto." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink2}" />
                      </StackPanel>
                    </ToolTip>
                  </Border.ToolTip>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Tabs.VentaNetaLabel}" Style="{StaticResource CostoKpiValue}" />
              <TextBlock Text="{Binding Tabs.VentaNetaSub}" Style="{StaticResource CostoKpiHint}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="5" BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1,0,0,0">
            <StackPanel Margin="14,13,12,13">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="VENTA UNITARIA" Style="{StaticResource CostoKpiLabel}" />
                <Border Style="{StaticResource CostoHelpBadge}">
                  <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                  <Border.ToolTip>
                    <ToolTip MaxWidth="380">
                      <StackPanel Margin="3">
                        <TextBlock Text="VENTA PARAMÉTRICA UNITARIA" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,4" />
                        <TextBlock Text="Ratio de venta normalizado por metro cuadrado de superficie construida o útil del proyecto." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,2,0,6" />
                        <TextBlock Text="FÓRMULA:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Venta Neta ÷ Superficie en Metros Cuadrados (m²)" FontSize="10" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,6" />
                        <TextBlock Text="BENCHMARKING TÉCNICO:" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,2" />
                        <TextBlock Text="Permite contrastar rápidamente la competitividad de la propuesta contra métricas estándar de mercado para obras de similares características." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink2}" />
                      </StackPanel>
                    </ToolTip>
                  </Border.ToolTip>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding UfM2Label}" Style="{StaticResource CostoKpiValue}" />
              <TextBlock Text="{Binding UfM2SubLabel}" Style="{StaticResource CostoKpiHint}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ─── Barra de pestañas ────────────────────────────────────────── -->
      <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="10" Padding="4" Margin="18,10,18,0">
        <ItemsControl ItemsSource="{Binding Tabs.Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource CostoTabChip}"
                           GroupName="CostoTabs"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Opacity="0.85" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <Border Background="{DynamicResource Brush.ChipBg}" CornerRadius="4" Padding="5,1"
                          Margin="8,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding CountLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="9.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink4}" />
                  </Border>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 1 · COMPOSICIÓN
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsComposicion, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="430" />
          <ColumnDefinition Width="374" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Costo directo en cuatro sub-familias -->
        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="COSTO DIRECTO · 4 SUB-FAMILIAS" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Mano de obra, materiales, equipos y complementarios agrupados por naturaleza."
                             Style="{StaticResource CierreHint}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding Tabs.OrigenesLegend}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource CostoOriginChip}" Background="{Binding Background}"
                                ToolTip="{Binding Hint}">
                          <TextBlock Text="{Binding Code}" Style="{StaticResource CostoOriginChipText}"
                                     Foreground="{Binding Foreground}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,6,14,0">
              <ItemsControl ItemsSource="{Binding Tabs.SubFamilies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="0,2">
                      <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                      FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch">
                          <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                              <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,6">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </ToggleButton.Template>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="128" />
                              <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Chevron}" FontSize="11" Width="14"
                                         Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                              <Border Style="{StaticResource CostoOriginChip}" Background="{Binding OrigenBackground}"
                                      ToolTip="{Binding OrigenHint}" Margin="2,0,8,0">
                                <TextBlock Text="{Binding OrigenCode}" Style="{StaticResource CostoOriginChipText}"
                                           Foreground="{Binding OrigenForeground}" />
                              </Border>
                              <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding DetalleLabel}" FontSize="9.5" Margin="8,0,0,0"
                                         Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <TextBlock Text="{Binding TotalLabel}" FontFamily="{StaticResource Font.Mono}"
                                         FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                         Foreground="{DynamicResource Brush.Ink}" />
                              <TextBlock Text="{Binding TotalSecundario}" FontFamily="{StaticResource Font.Mono}"
                                         FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right"
                                         Visibility="{Binding HasTotalSecundario, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding PctLabel}" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </ToggleButton>

                        <StackPanel Margin="22,2,0,8"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                          <ItemsControl ItemsSource="{Binding Lineas}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,3,0,3" ToolTip="{Binding Explicacion}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="66" />
                                  </Grid.ColumnDefinitions>
                                  <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource CostoOriginChip}" Background="{Binding OrigenBackground}"
                                            ToolTip="{Binding OrigenHint}" Margin="0,0,8,0">
                                      <TextBlock Text="{Binding OrigenCode}" Style="{StaticResource CostoOriginChipText}"
                                                 Foreground="{Binding OrigenForeground}" />
                                    </Border>
                                    <TextBlock Text="{Binding Concepto}" VerticalAlignment="Center">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CostoLine}">
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsZero}" Value="True">
                                              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ImporteLabel}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12" Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding ImporteSecundario}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right"
                                               Visibility="{Binding HasSecundario, Converter={StaticResource BoolToVisibility}}" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding PctLabel}" FontFamily="{StaticResource Font.Mono}"
                                             FontSize="11" Foreground="{DynamicResource Brush.Ink4}"
                                             TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="128" />
                  <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="= COSTO DE EJECUCIÓN" Style="{StaticResource CostoMicro}" />
                  <TextBlock Text="{Binding Tabs.SubFamiliaTotalSub}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0"
                             Visibility="{Binding ShowCurrencyColumn, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Tabs.SubFamiliaTotalLabel}" FontFamily="{StaticResource Font.Mono}"
                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Tabs.SubFamiliaTotalPct}" FontFamily="{StaticResource Font.Mono}"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}"
                           TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Cascada de precio + concentración -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource Card.Header}">
                <StackPanel>
                  <TextBlock Text="CASCADA DE PRECIO" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Del costo de ejecución al precio de venta con IVA." Style="{StaticResource CierreHint}"
                             Margin="0,3,0,0" />
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="14,8,14,12">
                <ItemsControl ItemsSource="{Binding CostRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,4" ToolTip="{Binding Explicacion}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsCierre}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsQuiet}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsEnInforme}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Explicacion}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Border Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2"
                                  Background="{DynamicResource Brush.Blue2}" Opacity="0.45" IsHitTestVisible="False">
                            <Border.Width>
                              <MultiBinding Converter="{StaticResource ShareWidth}">
                                <Binding Path="Share" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Border.Width>
                          </Border>
                          <Grid Margin="0,1,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="124" />
                              <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Concepto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="FontSize" Value="12" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontSize" Value="13" />
                                      <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding CurrencyFigure}" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Ink}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding ParticipacionLabel}" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Ink4}" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="CONCENTRACIÓN DE MATERIALES" Style="{StaticResource CierreSec}" Margin="0" />
              <TextBlock Text="Top 3 familias sobre el material valorizado." Style="{StaticResource CierreHint}"
                         Margin="0,3,0,8" />
              <ItemsControl ItemsSource="{Binding Tabs.Concentracion}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="56" />
                      </Grid.ColumnDefinitions>
                      <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.BlueSoft}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Puesto}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Familia}" Style="{StaticResource CostoLine}"
                                 VerticalAlignment="Center" Margin="6,0,8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding ImporteLabel}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding ShareLabel}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11" Foreground="{DynamicResource Brush.Ink3}"
                                 TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Separator Style="{StaticResource Separator.Subtle}" Margin="0,8,0,0" />
              <TextBlock Text="El riesgo de compra se concentra en estas familias: conviene negociar por volumen."
                         Style="{StaticResource CierreHint}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 2 · MÁRGENES Y CIERRE
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsCierre, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="290" />
          <ColumnDefinition Width="*" MinWidth="290" />
          <ColumnDefinition Width="*" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Palancas -->
        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <StackPanel>
                <TextBlock Text="PALANCAS" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="Recargos y márgenes aplicados sobre el costo de ejecución." Style="{StaticResource CierreHint}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,4,14,12">
              <StackPanel>
                <Grid Margin="0,0,0,4" IsEnabled="{Binding IsGastosGeneralesEditable}">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGastosGeneralesEditable}" Value="False">
                          <Setter Property="Opacity" Value="0.42" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="74" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Gastos generales" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource CostoHelpBadge}">
                      <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                      <Border.ToolTip>
                        <ToolTip MaxWidth="320">
                          <StackPanel Margin="2">
                            <TextBlock Text="GASTOS GENERALES (GG %)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                            <TextBlock Text="Porcentaje asignado para financiar los costos indirectos de administración central corporativa: sueldos directivos, oficina matriz, licitaciones, seguros y costos fijos no imputables directamente a la obra." FontSize="10.5" TextWrapping="Wrap" />
                          </StackPanel>
                        </ToolTip>
                      </Border.ToolTip>
                    </Border>
                  </StackPanel>
                  <TextBox Grid.Column="1" Style="{StaticResource CierreNum}" Text="{Binding GastosGeneralesText, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Grid.ColumnSpan="2" Text="{Binding GastosGeneralesPolicyHint}" Style="{StaticResource CierreHint}" Margin="0,32,0,0" />
                </Grid>

                <Grid Margin="0,0,0,4" IsEnabled="{Binding IsUtilidadEditable}">
                  <Grid.Style>
                    <Style TargetType="Grid">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUtilidadEditable}" Value="False">
                          <Setter Property="Opacity" Value="0.42" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="74" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UtilidadPolicyLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource CostoHelpBadge}">
                      <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                      <Border.ToolTip>
                        <ToolTip MaxWidth="320">
                          <StackPanel Margin="2">
                            <TextBlock Text="UTILIDAD BASE PREVISTA (UT %)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                            <TextBlock Text="Retorno económico sobre el capital de trabajo y compensación por el riesgo técnico y financiero que asume la empresa en la ejecución del contrato." FontSize="10.5" TextWrapping="Wrap" />
                          </StackPanel>
                        </ToolTip>
                      </Border.ToolTip>
                    </Border>
                  </StackPanel>
                  <TextBox Grid.Column="1" Style="{StaticResource CierreNum}" Text="{Binding UtilidadText, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock Grid.ColumnSpan="2" Text="{Binding UtilidadPolicyHint}" Style="{StaticResource CierreHint}" Margin="0,32,0,0" />
                </Grid>

                <Grid Margin="0,0,0,8" IsEnabled="{Binding CanEdit}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="74" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Valor agregado (equipos)" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource CostoHelpBadge}">
                      <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                      <Border.ToolTip>
                        <ToolTip MaxWidth="320">
                          <StackPanel Margin="2">
                            <TextBlock Text="VALOR AGREGADO SOBRE EQUIPOS (VA %)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                            <TextBlock Text="Recargo comercial diferenciado para partidas de equipamiento mayor (transformadores, celdas de MT, grupos electrógenos, etc.) para cubrir logística de compras, pruebas FAT/SAT y garantías sin inflar el costo de instalación." FontSize="10.5" TextWrapping="Wrap" />
                          </StackPanel>
                        </ToolTip>
                      </Border.ToolTip>
                    </Border>
                  </StackPanel>
                  <TextBox Grid.Column="1" Style="{StaticResource CierreNum}" Text="{Binding ValorAgregadoEquiposText, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,4,0,10" />

                <Grid Margin="0,4,0,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FerreteriaPlus" Command="{Binding ToggleFerreteriaDetalleCommand}"
                            ToolTip="Ferretería por familia" Margin="0,0,6,0" VerticalAlignment="Center"
                            Cursor="Hand" FocusVisualStyle="{x:Null}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1"
                                  BorderBrush="{DynamicResource Brush.Line}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                          </Border>
                        </ControlTemplate>
                      </Button.Template>
                      <TextBlock Text="{Binding FerreteriaDetalleMarca}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Ink3}" />
                    </Button>
                    <Popup IsOpen="{Binding FerreteriaDetalleAbierto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FerreteriaPlus}"
                           Placement="Right" HorizontalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                              BorderThickness="1" CornerRadius="8" Padding="10,8,10,8" Width="420" MaxHeight="320">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.16" />
                        </Border.Effect>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Top" Text="{Binding FerreteriaPopupTitulo}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,2" />
                          <TextBlock DockPanel.Dock="Top" Text="{Binding FerreteriaPopupNota}" FontSize="10.5" TextWrapping="Wrap"
                                     Foreground="{DynamicResource Brush.Ink4}" Margin="0,0,0,8" />
                          <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="108" />
                              <ColumnDefinition Width="108" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FAMILIA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                            <TextBlock Grid.Column="1" Text="MATERIALES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="FERRETERÍA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                          </Grid>
                          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="230">
                            <ItemsControl ItemsSource="{Binding FerreteriaFamilias}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <Grid.Style>
                                      <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="0,3" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                            <Setter Property="Margin" Value="0,6,0,0" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="108" />
                                      <ColumnDefinition Width="108" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Familia}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="FontSize" Value="11.5" />
                                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                              <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                      <TextBlock Text="{Binding MaterialesLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Ink}" TextAlignment="Right" />
                                      <TextBlock Text="{Binding MaterialesUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                      <TextBlock Text="{Binding FerreteriaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextAlignment="Right" />
                                      <TextBlock Text="{Binding FerreteriaUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                                    </StackPanel>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </DockPanel>
                      </Border>
                    </Popup>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <CheckBox IsChecked="{Binding FerreteriaActiva}" IsEnabled="{Binding CanEdit}"
                                Content="Estimar ferretería" FontSize="11.5"
                                Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                      <Border Style="{StaticResource CostoHelpBadge}">
                        <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                        <Border.ToolTip>
                          <ToolTip MaxWidth="320">
                            <StackPanel Margin="2">
                              <TextBlock Text="PROVISIÓN DE FERRETERÍA MENOR (3%)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                              <TextBlock Text="Estimación porcentual sobre materiales para absorber elementos de fijación, tornillería, pernos, rieles, sellos y consumibles de montaje que no se cubican ítem por ítem en planos." FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                          </ToolTip>
                        </Border.ToolTip>
                      </Border>
                    </StackPanel>
                    <TextBox Grid.Column="2" Text="{Binding FerreteriaPctText, UpdateSourceTrigger=LostFocus}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CierreNum}">
                          <Setter Property="IsEnabled" Value="False" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanEdit}" Value="True" />
                                <Condition Binding="{Binding FerreteriaActiva}" Value="True" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                  </Grid>
                </Grid>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,6,0,6" />

                <StackPanel DataContext="{Binding NegotiationSimulator}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Descuento comercial" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                      <Border Style="{StaticResource CostoHelpBadge}">
                        <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                        <Border.ToolTip>
                          <ToolTip MaxWidth="320">
                            <StackPanel Margin="2">
                              <TextBlock Text="DESCUENTO COMERCIAL / NEGOCIACIÓN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                              <TextBlock Text="Ajuste fino pactado en mesa de negociación final con el mandante sin degradar los precios unitarios técnicos del presupuesto ni alterar los rendimientos de obra." FontSize="10.5" TextWrapping="Wrap" />
                            </StackPanel>
                          </ToolTip>
                        </Border.ToolTip>
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DiscountPct, StringFormat={}{0:0.0} %}" FontFamily="{StaticResource Font.Mono}"
                               FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding NegotiatedPriceClpText}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                             Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                  <Slider Minimum="0" Maximum="25" SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True"
                          Value="{Binding DiscountPct, Mode=TwoWay}" Margin="0,6,0,2" />
                  <UniformGrid Columns="5" Margin="0,4,0,4">
                    <Button Content="0" Command="{Binding SetDiscountPresetCommand}" CommandParameter="0" Style="{StaticResource Button.Ghost}" Height="24" FontSize="10.5" Margin="0,0,4,0" />
                    <Button Content="3" Command="{Binding SetDiscountPresetCommand}" CommandParameter="3" Style="{StaticResource Button.Ghost}" Height="24" FontSize="10.5" Margin="0,0,4,0" />
                    <Button Content="5" Command="{Binding SetDiscountPresetCommand}" CommandParameter="5" Style="{StaticResource Button.Ghost}" Height="24" FontSize="10.5" Margin="0,0,4,0" />
                    <Button Content="7" Command="{Binding SetDiscountPresetCommand}" CommandParameter="7" Style="{StaticResource Button.Ghost}" Height="24" FontSize="10.5" Margin="0,0,4,0" />
                    <Button Content="10" Command="{Binding SetDiscountPresetCommand}" CommandParameter="10" Style="{StaticResource Button.Ghost}" Height="24" FontSize="10.5" />
                  </UniformGrid>
                  <TextBlock Text="{Binding RiskExplanationText}" Style="{StaticResource CierreHint}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Política de cierre + M.O. de instalación -->
        <Border Grid.Column="1" Style="{StaticResource Card.Surface}" Padding="0" Margin="12,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <StackPanel>
                <TextBlock Text="POLÍTICA DE CIERRE" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="Modelo contractual con el que se cierra la oferta." Style="{StaticResource CierreHint}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,4,14,12">
              <StackPanel>
                <StackPanel DataContext="{Binding ClosingPolicySection}">
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="DisplayName"
                            Style="{StaticResource Form.ComboBox}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <TextBlock Text="{Binding Explicacion}" Style="{StaticResource CierreHint}" Margin="0,8,0,0" />

                  <TextBlock Text="PRECIO OBJETIVO (CLP)" Style="{StaticResource CierreLab}" Margin="0,9,0,4"
                             Visibility="{Binding ShowTargetPrice, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding TargetPriceClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                           ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                           Visibility="{Binding ShowTargetPrice, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                  <TextBlock Text="CONTINGENCIA MÍN. %" Style="{StaticResource CierreLab}" Margin="0,9,0,4"
                             Visibility="{Binding ShowLumpSum, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding LumpSumMinRiskPctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                           ds:FieldAdornment.Suffix="%"
                           Visibility="{Binding ShowLumpSum, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                  <Grid Visibility="{Binding ShowCostPlusFee, Converter={StaticResource BoolToVisibility}}" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="FEE %" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding FeePctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Suffix="%"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="FEE FIJO (CLP)" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding FeeClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="El fee fijo tiene prioridad; si es 0 se usa el %." Style="{StaticResource CierreHint}" Margin="0,6,0,0"
                             Visibility="{Binding ShowCostPlusFee, Converter={StaticResource BoolToVisibility}}" />

                  <Grid Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="COSTO OBJETIVO" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding TargetCostClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="% COMPARTIDO" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding GainsharePctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Suffix="%"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="TOPE DE GANANCIA (CLP)" Style="{StaticResource CierreLab}" Margin="0,9,0,4"
                             Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding GainshareCapClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                           ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                           Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <TextBlock Text="{Binding GainshareSimulacionText}" Style="{StaticResource CierreHint}" Margin="0,8,0,0"
                             Visibility="{Binding HasGainshareSimulacion, Converter={StaticResource BoolToVisibility}}" />

                  <Border Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Amber}" BorderThickness="1"
                          CornerRadius="8" Padding="8,7" Margin="0,8,0,0"
                          Visibility="{Binding HasPolicyWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding PolicyWarning}" FontSize="10.5" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Text="{Binding StampNote}" Style="{StaticResource CierreHint}" Margin="0,8,0,0"
                             Visibility="{Binding HasStampNote, Converter={StaticResource BoolToVisibility}}" />
                  <ItemsControl ItemsSource="{Binding Advertencias}" Margin="0,8,0,0"
                                Visibility="{Binding HasAdvertencias, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource CierreHint}" Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,7" VerticalAlignment="Center">
                  <TextBlock Text="M.O. INSTALACIÓN" Style="{StaticResource CierreSec}" Margin="0" />
                  <Border Style="{StaticResource CostoHelpBadge}">
                    <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                    <Border.ToolTip>
                      <ToolTip MaxWidth="320">
                        <StackPanel Margin="2">
                          <TextBlock Text="MANO DE OBRA DE INSTALACIÓN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                          <TextBlock Text="Define el modelo de cálculo de la mano de obra del itemizado: por rendimiento unitario (Días-Hombre) o calibración por Factor de Ajuste (FA) contra el plan de obra." FontSize="10.5" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </Border.ToolTip>
                  </Border>
                </StackPanel>
                <CheckBox IsChecked="{Binding MoInstalacion.ModoMoRendimiento}" Margin="0,0,0,7" FontSize="11" Foreground="{DynamicResource Brush.Ink2}">
                  <TextBlock Text="M.O. por rendimiento (Tarifa D/H ÷ rendimiento del material)" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                  <TextBlock Text="Tarifa D/H" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Text="{Binding MoInstalacion.TarifaDhClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}" Width="145"
                           ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Derivar del plan MO" Command="{Binding MoInstalacion.DerivarTarifaDhCommand}" Style="{StaticResource Button.Secondary}"
                          Height="24" Padding="8,0" Margin="8,0,0,0" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox IsChecked="{Binding MoInstalacion.TarifaDhConLeyes}" Margin="0,0,0,7" FontSize="11" Foreground="{DynamicResource Brush.Ink2}">
                  <TextBlock Text="Incluir leyes sociales al derivar la tarifa" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>
                <TextBlock Style="{StaticResource CierreHint}" TextWrapping="Wrap" Margin="0,0,0,2">
                  <Run Text="El índice FA del proyecto se calibra en la pestaña " />
                  <Run Text="Familias → FACTORES" FontWeight="SemiBold" />
                  <Run Text=", junto a la comparación con el costo real de mano de obra." />
                </TextBlock>
                <TextBlock Text="{Binding MoInstalacion.MoInstalacionHint}" Style="{StaticResource CierreHint}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Estado de palancas + ajustes + descuento puntual -->
        <Border Grid.Column="2" Style="{StaticResource Card.Surface}" Padding="0" Margin="12,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <StackPanel>
                <TextBlock Text="ESTADO DE PALANCAS" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="Resumen de los recargos vigentes y ajustes finos del cierre." Style="{StaticResource CierreHint}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,4,14,12">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Gastos generales" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding GastosGeneralesText}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding UtilidadPolicyLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding UtilidadText}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Valor agregado (equipos)" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ValorAgregadoEquiposText}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Ferretería" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding FerreteriaPctText}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                </Grid>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,4,0,10" />

                <CheckBox IsChecked="{Binding PoliticaCostosExcel}" Margin="0,0,0,7"
                          IsEnabled="{Binding IsFactoresFamiliaEditable}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}">
                  <TextBlock Text="GG y utilidad sobre Mat + MO + GO (paridad estándar)" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>
                <CheckBox IsChecked="{Binding UsarFactoresPresentacionFamilia}"
                          IsEnabled="{Binding IsFactoresFamiliaEditable}" FontSize="11" Foreground="{DynamicResource Brush.Ink2}">
                  <TextBlock Text="Venta por familia (factores de presentación)" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>

                <Separator Style="{StaticResource Separator.Subtle}" Margin="0,12,0,8" />
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="DESCUENTO PUNTUAL" Style="{StaticResource CierreSec}" Margin="0" VerticalAlignment="Center" />
                  <Button Content="+ Agregar" Command="{Binding AddNegotiatedDiscountCommand}" Style="{StaticResource Button.Secondary}"
                          Height="24" Padding="8,0" FontSize="10.5" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding NegotiatedDiscounts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                              CornerRadius="7" Padding="6,4" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                          <TextBox Width="72" Style="{StaticResource CierreNum}" Height="24" FontSize="10.5" Margin="0,0,6,0"
                                   Text="{Binding Codigo, UpdateSourceTrigger=LostFocus}" ToolTip="Código" />
                          <TextBox Width="120" Style="{StaticResource Form.TextBox}" Height="24" FontSize="10.5" Padding="6,2" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                   Text="{Binding Descripcion, UpdateSourceTrigger=LostFocus}" ToolTip="Descripción" />
                          <TextBox Width="54" Style="{StaticResource CierreNum}" Height="24" FontSize="10.5" Margin="0,0,4,0"
                                   ds:FieldAdornment.Suffix="%"
                                   Text="{Binding DescuentoPct, UpdateSourceTrigger=LostFocus}" ToolTip="Descuento %" />
                          <Button Content="×" Style="{StaticResource Button.Ghost}" Width="20" Height="20" Padding="0" FontSize="13" Foreground="{DynamicResource Brush.Ink4}"
                                  Command="{Binding DataContext.RemoveNegotiatedDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Descuentos específicos negociados por equipo o material, aplicados al cierre."
                           Style="{StaticResource CierreHint}" Margin="0,2,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 3 · FAMILIAS
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsFamilias, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="430" />
          <ColumnDefinition Width="360" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <!-- FACTORES: paridad con el bloque COSTOS!D191:I192 del Excel (M/O + FA contra el costo real). -->
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,0,0,1" Padding="14,10,14,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="FACTORES" Style="{StaticResource CierreSec}" Margin="0" />
                    <TextBlock Text="Compara EN PPTO con COSTO. Usa 'Calcular FA' cuando desees calibrar la M.O. con el plan de obra."
                               Style="{StaticResource CierreHint}" Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Calcular FA" Command="{Binding MoInstalacion.CalcularFaCommand}" Style="{StaticResource Button.Primary}"
                            Height="24" Padding="10,0" FontSize="10.5"
                            IsEnabled="{Binding CanEdit}"
                            ToolTip="FA = (M.O. real del proyecto − M.O. ya cubierta por el catálogo) ÷ Σ (Material × %). Calibra la M.O. de instalación al costo real del plan de obra." />
                  </StackPanel>
                </Grid>

                <!-- Encabezado del bloque: mismas columnas que el Excel (FACTOR · EN PPTO · COSTO · TOTAL DD/HH). -->
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="72" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="FACTOR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                  <TextBlock Grid.Column="1" Text="EN PPTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="COSTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="TOTAL DD/HH" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="Δ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                </Grid>

                <!-- Fila única M/O: el FA editable multiplica la base de materiales para que la M.O.
                     del itemizado cuadre con el costo real del plan de mano de obra. -->
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="72" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="M/O" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Style="{StaticResource CoefCell}" Tag="m" Width="72" HorizontalAlignment="Left"
                             Text="{Binding MoInstalacion.IndiceMoFaText, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding CanEdit}"
                             ToolTip="FA del proyecto (Excel: COSTOS!E192). 0 = sin calibrar: la M.O. por % del itemizado no suma hasta derivar el índice. Editable a mano; escribir un valor recalibra la M.O. del catálogo, del banco de precios y del itemizado." />
                    <TextBlock Text="{Binding MoInstalacion.MoTarifaLabel}" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding MoInstalacion.MoEnPptoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                             Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right"
                             ToolTip="Mano de obra que queda en el itemizado con el FA vigente (Excel: COSTOS!F192)." />
                  <TextBlock Grid.Column="2" Text="{Binding MoInstalacion.MoCostoRealLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                             Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right"
                             ToolTip="Costo real de mano de obra del proyecto (Excel: MANO DE OBRA!T23)." />
                  <TextBlock Grid.Column="3" Text="{Binding MoInstalacion.MoDiasHombreLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                             Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right"
                             ToolTip="Días-hombre del plan de mano de obra (Excel: MANO DE OBRA!U23)." />
                  <TextBlock Grid.Column="4" Text="{Binding MoInstalacion.MoDeltaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center" TextAlignment="Right">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MoInstalacion.MoDeltaEsAviso}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>

                <TextBlock Text="{Binding MoInstalacion.FaDerivadoTexto}" FontSize="10.5" Foreground="{DynamicResource Brush.BlueDark}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding MoInstalacion.FaDerivadoVisible, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding MoInstalacion.FaAviso}" Style="{StaticResource CierreHint}" Foreground="{DynamicResource Brush.Warning}"
                           TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding MoInstalacion.FaAvisoVisible, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding MoInstalacion.FaResultado}" Style="{StaticResource CierreHint}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="PRESENTACIÓN · FAMILIAS" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Factor de presentación y descuento por familia. El factor efectivo manda la venta."
                             Style="{StaticResource CierreHint}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Gestionar familias" Command="{Binding AbrirGestionFamiliasCommand}" Style="{StaticResource Button.Secondary}" Height="24" Padding="8,0" Margin="0,0,5,0" FontSize="10.5" ToolTip="Ver, crear, renombrar y dar de baja familias del catálogo eléctrico" />
                  <Button Content="Estándar" Command="{Binding LoadCoeficientesEstandarCommand}" Style="{StaticResource Button.Secondary}" Height="24" Padding="8,0" Margin="0,0,5,0" FontSize="10.5" />
                  <Button Content="Típicos" Command="{Binding LoadTipicosCoeficientesCommand}" Style="{StaticResource Button.Secondary}" Height="24" Padding="8,0" Margin="0,0,5,0" FontSize="10.5" />
                  <Button Content="Reset 1,00×" Command="{Binding ResetCoeficientesCommand}" Style="{StaticResource Button.Ghost}" Height="24" Padding="8,0" FontSize="10.5" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,8,14,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="114" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="FAMILIA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
              <TextBlock Grid.Column="1" Text="{Binding CoefCostoHeader}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="2" Text="FACTOR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="3" Text="DCTO %" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="4" Text="EFECTIVO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="5" Text="{Binding CoefVentaHeader}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,0">
              <ItemsControl x:Name="CoefFactorsList" ItemsSource="{Binding CoefFactors}" PreviewKeyDown="OnCoefTablePreviewKeyDown">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="2,3,2,5" BorderThickness="0,0,0,1" AllowDrop="True"
                            DragOver="OnCoefRowDragOver" Drop="OnCoefRowDrop">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" MinWidth="150" />
                          <ColumnDefinition Width="104" />
                          <ColumnDefinition Width="62" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="66" />
                          <ColumnDefinition Width="114" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                          <StackPanel Orientation="Horizontal">
                            <Button x:Name="FamiliaPlus" Width="16" Height="16" Margin="0,1,6,0" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="Familias de materiales"
                                    IsEnabled="{Binding DataContext.IsFactoresFamiliaEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Command="{Binding DataContext.AbrirCatalogoFamiliasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1"
                                          BorderBrush="{DynamicResource Brush.Line}" Background="Transparent">
                                    <TextBlock Text="+" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Ink3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                  </Border>
                                </ControlTemplate>
                              </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding FamiliasResumen}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}"
                                     TextTrimming="CharacterEllipsis" Margin="22,1,0,0" ToolTip="{Binding FamiliasResumen}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding FamiliasResumen}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <Popup IsOpen="{Binding CatalogoAbierto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FamiliaPlus}"
                                 Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="8,8,4,8" Width="260" MaxHeight="300">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Familias de materiales" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="2,0,8,6" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                  <ItemsControl ItemsSource="{Binding Catalogo}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Button Margin="0,0,4,1" Padding="4,3" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                IsEnabled="{Binding PuedeElegir}"
                                                Command="{Binding DataContext.ElegirFamiliaPrecioCommand, Source={x:Reference CostoRoot}}"
                                                CommandParameter="{Binding}">
                                          <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                              <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                              </Border>
                                              <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                  <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                                </Trigger>
                                              </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                          </Button.Template>
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="16" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Marca}" FontSize="11" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="11.5" Foreground="{DynamicResource Brush.Ink}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Nota}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                          </Grid>
                                        </Button>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </ScrollViewer>
                              </DockPanel>
                            </Border>
                          </Popup>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CostoUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBox Grid.Column="2" Style="{StaticResource CoefCell}" Tag="m" Width="54" HorizontalAlignment="Right"
                                 Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding DataContext.IsFactoresFamiliaEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="3" Style="{StaticResource CoefCell}" Tag="d" Width="48" HorizontalAlignment="Right"
                                 Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding DataContext.IsFactoresFamiliaEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Grid.Column="4" Text="{Binding EffectiveLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{Binding VentaUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" TextAlignment="Right" />
                        <Border Grid.ColumnSpan="6" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{DynamicResource Brush.Blue2}" Opacity="0.55" IsHitTestVisible="False">
                          <Border.Width>
                            <MultiBinding Converter="{StaticResource ShareWidth}">
                              <Binding Path="Share" />
                              <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                            </MultiBinding>
                          </Border.Width>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0" Padding="14,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center">
                    <Run Text="Total familias · " />
                    <Run Text="{Binding FamCostoLabel, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                  </TextBlock>
                  <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" Margin="12,0">
                    <Run Text="Venta presentación " />
                    <Run Text="{Binding FamVentaLabel, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                  </TextBlock>
                  <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center">
                    <Run Text="Δ " />
                    <Run Text="{Binding FamDeltaLabel, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                  </TextBlock>
                </Grid>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource CierreHint}">
                  <Run Text="{Binding CoefFactorMedioLabel, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding CoefActivasLabel, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </Border>
            </Grid>
          </Grid>
        </Border>

        <!-- Pareto de familias -->
        <Border Grid.Column="1" Style="{StaticResource Card.Surface}" Padding="0" Margin="12,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <StackPanel>
                <TextBlock Text="PARETO DE MATERIALES" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="Participación de cada familia sobre el material valorizado." Style="{StaticResource CierreHint}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,8,14,12">
              <ItemsControl ItemsSource="{Binding Familias}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Familia}" Style="{StaticResource CostoLine}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ShareLabel}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.TrackSoft}" HorizontalAlignment="Stretch" />
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Blue2}"
                                HorizontalAlignment="Left" Opacity="0.85">
                          <Border.Width>
                            <MultiBinding Converter="{StaticResource ShareWidth}">
                              <Binding Path="Share" />
                              <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                            </MultiBinding>
                          </Border.Width>
                        </Border>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 4 · MANO DE OBRA Y VIÁTICOS
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsMoViaticos, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="360" />
          <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="MANO DE OBRA DIRECTA" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Dotación y costo anual de los contratos en obra." Style="{StaticResource CierreHint}"
                             Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TotalMoDirectaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="13"
                             FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding TotalMoDirectaDotacionLabel}" FontSize="9.5"
                             Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="14,8,14,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="52" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="CARGO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
              <TextBlock Grid.Column="1" Text="DOTACIÓN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="2" Text="SUELDO MENS." FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="3" Text="TOTAL ANUAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="4" Text="%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,0,14,10">
              <ItemsControl ItemsSource="{Binding MoDirectaRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3" ToolTip="{Binding Cargo}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Cargo}" Style="{StaticResource CostoLine}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DotacionLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                 Foreground="{DynamicResource Brush.Ink3}" TextAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding SueldoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                 Foreground="{DynamicResource Brush.Ink2}" TextAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding TotalLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                 FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding PctLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                 Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource Card.Header}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="MANO DE OBRA INDIRECTA" Style="{StaticResource CierreSec}" Margin="0" />
                    <TextBlock Text="Roles de gestión y su prorrateo a la obra." Style="{StaticResource CierreHint}"
                               Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding TotalMoIndirectaLabel}" FontFamily="{StaticResource Font.Mono}"
                             FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" Margin="14,8,14,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="66" />
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CARGO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" />
                <TextBlock Grid.Column="1" Text="DOTACIÓN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="SUELDO MENS." FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="FRACCIÓN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="TOTAL ANUAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="%" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              </Grid>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="14,0,14,10">
                <ItemsControl ItemsSource="{Binding MoIndirectaRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3" ToolTip="{Binding Cargo}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="66" />
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Cargo}" Style="{StaticResource CostoLine}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DotacionLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Ink3}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SueldoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Ink2}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding FraccionLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Ink3}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding TotalLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding PctLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" Padding="14,12" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="GO 3.3 · VIÁTICOS, TRASLADOS Y PER-DIEM" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="{Binding TotalMoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                           FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding TotalMoSubLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.Ink4}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding GoComposeHint}" Style="{StaticResource CierreHint}" Margin="0,6,0,0" />
                <TextBlock Text="La planilla de viáticos alimenta la categoría 3.3 de gastos operacionales."
                           Style="{StaticResource CierreHint}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Calcular viáticos" Command="{Binding OpenViaticosBarCommand}" Style="{StaticResource Button.Primary}"
                        Height="28" Padding="12,0" FontSize="11" Margin="0,0,0,6"
                        ToolTip="Abrir calculadora profesional de viáticos" />
                <Button Content="Ver plan de M.O." Command="{Binding GoToManoDeObraCommand}" Style="{StaticResource Button.Secondary}"
                        Height="28" Padding="12,0" FontSize="11" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 5 · GASTOS OPERACIONALES
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsGastosOperacionales, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="430" />
          <ColumnDefinition Width="330" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="GASTOS OPERACIONALES" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Categorías 3.1 a 3.6: instalación de faenas, oficina técnica, movilización, EPP y más."
                             Style="{StaticResource CierreHint}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Restablecer" Command="{Binding ResetGoPlantillaCommand}" Style="{StaticResource Button.Ghost}" Height="24" Padding="8,0" Margin="0,0,5,0" FontSize="10.5" />
                  <Button Content="+ Categoría" Command="{Binding AddGoCategoriaCommand}" Style="{StaticResource Button.Secondary}" Height="24" Padding="8,0" FontSize="10.5" />
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,8,14,12">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding GastosOperacionales}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="1" CornerRadius="9" Margin="0,0,0,7" ClipToBounds="True">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Eliminar"
                                      Command="{Binding DataContext.RemoveGoCategoriaCommand, Source={x:Reference CostoRoot}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <Button Command="{Binding DataContext.ToggleGoCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="9,8"
                                  HorizontalContentAlignment="Stretch" Cursor="Hand">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Chevron}" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                              <Border Grid.Column="1" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="4,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Codigo}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                              </Border>
                              <StackPanel Grid.Column="2" Margin="7,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Concepto}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ItemsCountLabel}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
                              </StackPanel>
                              <TextBlock Grid.Column="3" Text="{Binding MontoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,7,0" />
                              <Border Grid.Column="4" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="5" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PctLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                              </Border>
                            </Grid>
                          </Button>
                          <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" Margin="9,0,9,9">
                            <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,0,0,7" />
                            <Grid Margin="0,0,0,5">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="22" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="CONCEPTO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="UN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Center" Margin="0,0,4,0" />
                              <TextBlock Grid.Column="2" Text="CANT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" Margin="0,0,6,0" />
                              <TextBlock Grid.Column="3" Text="P.U." FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" Margin="0,0,6,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" MinWidth="120" />
                                      <ColumnDefinition Width="62" />
                                      <ColumnDefinition Width="64" />
                                      <ColumnDefinition Width="108" />
                                      <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource GoSheetBox}" Tag="gc" Margin="0,0,6,0" TextWrapping="Wrap"
                                             Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource GoSheetBox}" Tag="gu" Margin="0,0,4,0" Padding="2,2"
                                             TextAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                             Text="{Binding Unidad, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource GoSheetMono}" Tag="gn" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Text="{Binding CantidadTexto, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource GoSheetMono}" Tag="gp" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Text="{Binding PrecioTexto, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="4" Content="×" Style="{StaticResource Button.Ghost}" Padding="0" FontSize="14" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Agregar ítem" Margin="0,2,0,0" Height="28" Cursor="Hand"
                                    Command="{Binding DataContext.AddGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                  <Setter Property="BorderThickness" Value="1" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                  <Setter Property="FontSize" Value="11" />
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Clic en una categoría para editar sus ítems." Style="{StaticResource CierreHint}" Margin="0,4,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card.Surface}" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="TOTAL GASTOS OPERACIONALES" Style="{StaticResource CostoMicro}" />
                <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}">
                  <Run Text="{Binding GoCategoriaCountLabel, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding GoItemCountLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding GoFooterSubLabel}" Style="{StaticResource CierreHint}" Margin="0,6,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalGoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding TotalGoUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="ATAJOS" Style="{StaticResource CierreSec}" Margin="0" />
              <TextBlock Text="La planilla de gastos operacionales se cierra contra el costo de ejecución y alimenta la oferta."
                         Style="{StaticResource CierreHint}" Margin="0,4,0,10" />
              <Button Content="Editar mano de obra" Command="{Binding GoToManoDeObraCommand}" Style="{StaticResource Button.Secondary}"
                      Height="28" FontSize="11" Margin="0,0,0,8" />
              <Button Content="Calcular viáticos" Command="{Binding OpenViaticosBarCommand}" Style="{StaticResource Button.Primary}"
                      Height="28" FontSize="11" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- Empty state -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver el desglose de costos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando costos…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
