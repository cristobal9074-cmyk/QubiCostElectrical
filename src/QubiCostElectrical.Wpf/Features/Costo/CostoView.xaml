                <UniformGrid Columns="3">
                  <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Background="{DynamicResource Brush.BlueFaint}">
                    <StackPanel>
                      <TextBlock Text="GASTOS GENERALES" FontSize="9" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBox Text="{Binding GastosGeneralesText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="14" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Background="{DynamicResource Brush.BlueFaint}">
                    <StackPanel>
                      <TextBlock Text="{Binding UtilidadPolicyLabel}" FontSize="9" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBox Text="{Binding UtilidadText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="14" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}" />
                      </DockPanel>
                    </StackPanel>
