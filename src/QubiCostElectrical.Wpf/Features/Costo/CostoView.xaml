                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="12" />
