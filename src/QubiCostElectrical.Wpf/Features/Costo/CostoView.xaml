  <UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.CostoView"
             x:Name="CostoRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Costo"
             Background="{DynamicResource Brush.Canvas}">

  <UserControl.Resources>
    <Style x:Key="GoCellBox" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GoCellMono" TargetType="TextBox" BasedOn="{StaticResource GoCellBox}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GoSheetBox" TargetType="TextBox" BasedOn="{StaticResource GoCellBox}">
      <EventSetter Event="PreviewKeyDown" Handler="OnGoCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnGoCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGoCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnGoCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnGoCellLostFocus" />
    </Style>
    <Style x:Key="GoSheetMono" TargetType="TextBox" BasedOn="{StaticResource GoCellMono}">
      <EventSetter Event="PreviewKeyDown" Handler="OnGoCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnGoCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGoCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnGoCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnGoCellLostFocus" />
    </Style>
    <Style x:Key="CoefCell" TargetType="TextBox" BasedOn="{StaticResource GoCellMono}">
      <Setter Property="Width" Value="58" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <EventSetter Event="PreviewKeyDown" Handler="OnCoefCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnCoefCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnCoefCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnCoefCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnCoefCellLostFocus" />
    </Style>
    <Style x:Key="CoefDropRow" TargetType="Border">
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="10,1" />
      <EventSetter Event="DragOver" Handler="OnCoefRowDragOver" />
      <EventSetter Event="Drop" Handler="OnCoefRowDrop" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <local:FamiliaShareWidthConverter x:Key="FamiliaShareWidth" />
    <Style x:Key="CoefTile" TargetType="Border" BasedOn="{StaticResource Card.Section}">
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <EventSetter Event="DragOver" Handler="OnCoefRowDragOver" />
      <EventSetter Event="Drop" Handler="OnCoefRowDrop" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrecioFamiliaChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,1,4,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="Arrastra a la fila del material" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPrecioFamiliaMouseDown" />
      <EventSetter Event="PreviewMouseMove" Handler="OnPrecioFamiliaMouseMove" />
    </Style>
    <Style x:Key="GoIconBtn" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.lg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="GoViaticosBtn" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Content" Value="Calcular viáticos" />
      <Setter Property="ToolTip" Value="Abrir calculadora profesional de viáticos" />
    </Style>
    <Style x:Key="CierreSec" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style x:Key="CierreHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CierreLab" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="CierreNum" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- Contenedor Principal (oculto si sin proyecto) -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Grid.RowSpan="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,10,16,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Desglose de costos" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="UF" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ValorUfDiaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Button Content="Restaurar" Command="{Binding RestoreCostosPresetCommand}" Style="{StaticResource Button.Secondary}" Height="26" Padding="9,0" Margin="0,0,6,0" FontSize="11" />
                <Button Content="Guardar preset" Command="{Binding SaveCostosPresetCommand}" Style="{StaticResource Button.Secondary}" Height="26" Padding="9,0" Margin="0,0,6,0" FontSize="11" ToolTip="{Binding CostosPresetHint}" />
                <Button Content="Aplicar al presupuesto" Command="{Binding ApplyCoeficientesCommand}" Style="{StaticResource Button.Primary}" Height="26" Padding="12,0" FontSize="11" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,8">
              <StackPanel>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel Width="168" VerticalAlignment="Center">
                    <TextBlock Text="Costo de ejecución" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" />
                    <TextBlock Text="{Binding CostoDirectoSubLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding CostoDirectoLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" Margin="0,1,0,0" />
                  </StackPanel>
                  <Border Width="1" Height="36" Background="{DynamicResource Brush.Line}" Margin="0,0,22,0" VerticalAlignment="Center" />
                  <StackPanel Width="96" VerticalAlignment="Center">
                    <TextBlock Text="Margen" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" />
                    <TextBlock Text="{Binding MargenLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" />
                  </StackPanel>
                  <Border Width="1" Height="36" Background="{DynamicResource Brush.Line}" Margin="0,0,22,0" VerticalAlignment="Center" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Venta unitaria" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" />
                    <TextBlock Text="{Binding UfM2Label}" FontFamily="{StaticResource Font.Mono}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding UfM2SubLabel}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" Margin="0,1,0,0" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,2,0">
                  <TextBlock Text="Total venta" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding TotalVentaSubLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding TotalVentaLabel}" FontSize="12" Foreground="{DynamicResource Brush.Ink3}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                </StackPanel>
              </Grid>
              <Button Command="{Binding ToggleAnalisisCommand}" Cursor="Hand" Focusable="True"
                      HorizontalAlignment="Stretch" Margin="0,12,0,0">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                      <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AnalisisChevron}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" />
                    <TextBlock Text="Análisis financiero" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="De dónde sale cada valor" FontSize="11" Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Margin="0,12,0,0"
                            Visibility="{Binding AnalisisAbierto, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="76" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Concepto" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" />
                      <TextBlock Grid.Column="1" Text="UF" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="CLP" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="% venta" FontSize="10.5" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding CostRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Visible" />
                              <Setter Property="Padding" Value="0,5" />
                              <Setter Property="BorderThickness" Value="0" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                              <Setter Property="ToolTip" Value="{Binding Explicacion}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuiet}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnInforme}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSection}" Value="True">
                                  <Setter Property="Padding" Value="0,16,0,4" />
                                  <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Explicacion}" Value="">
                                  <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                  <Setter Property="BorderThickness" Value="0,1,0,0" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                  <Setter Property="Padding" Value="0,8,0,6" />
                                  <Setter Property="Margin" Value="0,4,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                  <Setter Property="Padding" Value="0,10,0,8" />
                                  <Setter Property="Margin" Value="0,6,0,0" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="112" />
                              <ColumnDefinition Width="132" />
                              <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Command="{Binding DataContext.ToggleFerreteriaDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="De dónde sale la ferretería" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button.Style>
                                  <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                      <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                          <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1"
                                                  BorderBrush="{DynamicResource Brush.Line}" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                          </Border>
                                        </ControlTemplate>
                                      </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding TieneOrigen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding DataContext.FerreteriaDetalleMarca, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                              </Button>
                            <TextBlock Text="{Binding Concepto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="FontSize" Value="12.5" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                  <Setter Property="Margin" Value="12,0,16,0" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneOrigen}" Value="True">
                                      <Setter Property="Margin" Value="4,0,16,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSection}" Value="True">
                                      <Setter Property="FontSize" Value="11" />
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                      <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                      <Setter Property="Margin" Value="0,0,16,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontSize" Value="13.5" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding UfFigura}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink}" TextAlignment="Right" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSection}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontSize" Value="13.5" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding ValorMonedaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink2}" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSection}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                      <Setter Property="FontSize" Value="13.5" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="{Binding ParticipacionLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Ink3}" TextAlignment="Right" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSection}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                      <Setter Property="FontSize" Value="13.5" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="248" />
                  <ColumnDefinition Width="*" MinWidth="280" />
                  <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="12,8,12,10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Text="CIERRE" Style="{StaticResource CierreSec}" Margin="0" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,2" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ClosingPolicySection.ViabilidadIsWarning}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ClosingPolicySection.ViabilidadIsDanger}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding ClosingPolicySection.ViabilidadText}" FontSize="10.5" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ClosingPolicySection.ViabilidadIsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding ClosingPolicySection.ViabilidadIsDanger}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                  <StackPanel>
                  <TextBlock Text="PALANCAS" Style="{StaticResource CierreSec}" Margin="0,0,0,7" />
                  <Grid Margin="0,0,0,4" IsEnabled="{Binding IsGastosGeneralesEditable}">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsGastosGeneralesEditable}" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gastos generales" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource CierreNum}" Text="{Binding GastosGeneralesText, UpdateSourceTrigger=LostFocus}" />
