            <StackPanel>
              <Border CornerRadius="12,12,0,0" Padding="16,14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101C30" Offset="0" />
                    <GradientStop Color="#14263C" Offset="0.55" />
                    <GradientStop Color="#1A3A58" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
