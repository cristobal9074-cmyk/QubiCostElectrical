                          <TextBlock Text="{Binding EffectiveLabel}" FontSize="10" FontWeight="SemiBold"
                                     Foreground="#2563B0" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="POLÍTICA GG · UTILIDAD ADITIVA · VA EQUIPOS" FontSize="10" FontWeight="Bold"
