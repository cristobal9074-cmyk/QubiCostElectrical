                          <Run Text="Familias activas " /><Run Text="{Binding CoefActivasLabel, Mode=OneWay}" Foreground="#93C5FD" />
                        </TextBlock>
                      </Border>
                      <Border Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
