                        <!-- Body -->
                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                          <Grid Margin="46,8,12,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="52" />
                              <ColumnDefinition Width="80" />
                              <ColumnDefinition Width="100" />
                              <ColumnDefinition Width="100" />
                              <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONCEPTO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                            <TextBlock Grid.Column="1" Text="UN." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="CANT." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="P. UNIT." FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="TOTAL" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="46,2,12,2">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="32" />
                                  </Grid.ColumnDefinitions>
                                  <TextBox Grid.Column="0" Style="{StaticResource GoCellBox}" Margin="0,0,4,0"
                                           Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" />
                                  <TextBox Grid.Column="1" Style="{StaticResource GoCellBox}" Margin="0,0,4,0"
                                           TextAlignment="Center" Text="{Binding Unidad, UpdateSourceTrigger=LostFocus}" />
                                  <TextBox Grid.Column="2" Style="{StaticResource GoCellMono}" Margin="0,0,4,0"
                                           Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}" />
                                  <TextBox Grid.Column="3" Style="{StaticResource GoCellMono}" Margin="0,0,4,0"
                                           Text="{Binding PrecioUnitarioClp, UpdateSourceTrigger=LostFocus}" />
                                  <TextBlock Grid.Column="4" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                             FontFamily="{StaticResource Font.Mono}" TextAlignment="Right"
                                             VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsZeroTotal}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <Button Grid.Column="5" Style="{StaticResource GoIconBtn}" Content="×" ToolTip="Quitar ítem"
                                          Command="{Binding DataContext.RemoveGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Content="+ Agregar ítem" HorizontalAlignment="Left"
                                  Margin="46,6,12,10" Padding="11,6" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                                  Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                                  BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Cursor="Hand"
                                  Command="{Binding DataContext.AddGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Footer total -->
              <Border CornerRadius="10" Padding="14,12" Margin="0,4,0,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
                    <GradientStop Color="{StaticResource Color.Navy3}" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL GO" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                    <TextBlock Text="{Binding GoFooterSubLabel}" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.White}" Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding TotalGoLabel}" FontSize="{StaticResource Font.Size.xl}" FontWeight="SemiBold"
                             FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.White}"
                             VerticalAlignment="Center" Margin="16,0" />
                  <TextBlock Grid.Column="2" Text="{Binding TotalGoUfLabel}" FontSize="{StaticResource Font.Size.md}"
                             FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Slate2}"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- ═══ Coeficientes de sobreventa ═══ -->
          <Border Margin="0,0,0,14" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.BlueSoft}"
                  Background="{DynamicResource Brush.Surface}">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CoefAppliedFlash}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                    <Setter Property="BorderThickness" Value="2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <Border CornerRadius="12,12,0,0" Padding="16,14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
                    <GradientStop Color="{StaticResource Color.Navy2}" Offset="0.55" />
                    <GradientStop Color="{StaticResource Color.BrandDark}" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <DockPanel LastChildFill="False">
                  <StackPanel DockPanel.Dock="Left" MaxWidth="520">
                    <TextBlock Text="POLÍTICA COMERCIAL · EXCEL -=COSTOS=-"
                               FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderMuted}" />
                    <TextBlock Text="Coeficientes de sobreventa" FontSize="{StaticResource Font.Size.h3}" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.White}" Margin="0,4,0,0" />
                    <TextBlock Text="Factores × por familia (misma fuente que APU) + GG / utilidad / VA equipos. Al aplicar, recalcula el puente a venta."
                               FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.HeaderControl}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                      <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White9}" BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.White}">
                          <Run Text="Factor medio " /><Run Text="{Binding CoefFactorMedioLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.BrandStroke2}" />
                        </TextBlock>
                      </Border>
                      <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White9}" BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Chip}" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.White}">
                          <Run Text="Familias activas " /><Run Text="{Binding CoefActivasLabel, Mode=OneWay}" Foreground="{DynamicResource Brush.BrandStroke2}" />
                        </TextBlock>
                      </Border>
                      <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White9}" BorderThickness="1"
                              CornerRadius="{StaticResource Radius.Chip}" Padding="10,5">
                        <TextBlock Text="Sincronizado con APU ✓" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.White}" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Cargar PEL029" Command="{Binding LoadPelCoeficientesCommand}"
                            ToolTip="Factores del Excel PEL029A2026 (1,57× Mat/PVC · 1,30× resto · GG 5% · UT 8% · VA 3%)"
                            Margin="0,0,6,0" Padding="11,7" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.White}" Cursor="Hand" IsEnabled="{Binding CanEdit}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White25}" BorderThickness="1"
                                  CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.White25}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                    <Button Content="Típicos" Command="{Binding LoadTipicosCoeficientesCommand}"
                            ToolTip="Promedio histórico genérico (1,50 / 1,44 / 1,10…)"
                            Margin="0,0,6,0" Padding="11,7" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.White}" Cursor="Hand" IsEnabled="{Binding CanEdit}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White25}" BorderThickness="1"
                                  CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.White25}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                    <Button Content="Reset 1,00×" Command="{Binding ResetCoeficientesCommand}"
                            Margin="0,0,6,0" Padding="11,7" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.White}" Cursor="Hand" IsEnabled="{Binding CanEdit}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White25}" BorderThickness="1"
                                  CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.White25}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                    <Button Content="Aplicar" Command="{Binding ApplyCoeficientesCommand}"
                            Padding="11,7" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            Cursor="Hand" IsEnabled="{Binding CanEdit}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="{DynamicResource Brush.Surface}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{DynamicResource Brush.Ink}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </StackPanel>
                </DockPanel>
              </Border>

              <StackPanel Margin="16,14,16,16">
                <TextBlock Text="FACTORES DE PRESENTACIÓN (×)" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                <TextBlock Text="Descuento % por familia (estilo Excel): el factor efectivo en cubicación es × × (1 − dscto)."
                           Style="{StaticResource Text.Helper}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding CoefFactors}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,8,8" Padding="11,10" CornerRadius="10"
                              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                              Background="{DynamicResource Brush.WorkspaceBar}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Size.sm}" FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.Ink2}" />
                          <TextBlock Text="{Binding Map}" FontSize="{StaticResource Font.Size.xs}"
                                     Foreground="{DynamicResource Brush.Muted}" Margin="0,1,0,0" />
                          <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="×" FontSize="{StaticResource Font.Size.md}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBox Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.h2}" FontWeight="SemiBold" />
                          </DockPanel>
                          <TextBlock Text="{Binding ExcelRef}" FontSize="{StaticResource Font.Size.xs}" Margin="0,4,0,0"
                                     FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Muted}" />
                          <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="%" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Text="Dscto " FontSize="{StaticResource Font.Size.2xs}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.md}" />
                          </DockPanel>
                          <TextBlock Text="{Binding EffectiveLabel}" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Blue}" Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="POLÍTICA GG · UTILIDAD ADITIVA · VA EQUIPOS" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,8" />
                <DockPanel Margin="0,0,0,10">
                  <CheckBox IsChecked="{Binding PoliticaCostosExcel}"
                            Content="Paridad Excel -=COSTOS=- (GG/UT sobre Mat+MO+GO, utilidad aditiva, diferencia por factores)"
                            FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            IsEnabled="{Binding CanEdit}"
                            VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,0,10">
                  <CheckBox IsChecked="{Binding UsarFactoresPresentacionFamilia}"
                            Content="Armar venta por factores de presentación por familia (markup × familia línea a línea; la paridad Excel ya lo implica)"
                            FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            IsEnabled="{Binding CanEdit}"
                            VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid Columns="3">
                  <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Background="{DynamicResource Brush.BlueFaint}">
                    <StackPanel>
                      <TextBlock Text="GASTOS GENERALES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBox Text="{Binding GastosGeneralesText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Background="{DynamicResource Brush.BlueFaint}">
                    <StackPanel>
                      <TextBlock Text="{Binding UtilidadPolicyLabel}" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBox Text="{Binding UtilidadText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <Border Padding="11,10" CornerRadius="10"
                          BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                          Background="{DynamicResource Brush.AmberSoft}">
                    <StackPanel>
                      <TextBlock Text="VA SOBRE EQUIPOS" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.Ink2}" />
                        <TextBox Text="{Binding ValorAgregadoEquiposText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <DockPanel Margin="0,12,0,0">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Guardar preset" Command="{Binding SaveCostosPresetCommand}"
                            Margin="0,0,6,0" Padding="10,6" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            IsEnabled="{Binding CanEdit}" Cursor="Hand" />
                    <Button Content="Restaurar preset" Command="{Binding RestoreCostosPresetCommand}"
                            Padding="10,6" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                            IsEnabled="{Binding CanEdit}" Cursor="Hand" />
                  </StackPanel>
                  <TextBlock Text="{Binding CostosPresetHint}" Style="{StaticResource Text.Helper}"
                             VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Tabla de desglose -->
          <Border Style="{StaticResource Card.Section}" Padding="0" Margin="0,0,0,14">
            <DataGrid ItemsSource="{Binding CostRows}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource DataGrid.Workspace}" RowHeight="34"
                      BorderThickness="0" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="total">
                      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="subtotal">
                      <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="coef">
                      <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="grand">
                      <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="280">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Padding" Value="12,0,0,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="grand">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Valor UF" Binding="{Binding ValorUfLabel}" Width="120">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                      <Setter Property="TextAlignment" Value="Right" />
                      <Setter Property="Padding" Value="0,0,12,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="grand">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="140">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{Binding DataContext.CurrencyColumnHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                  </DataGridTextColumn.Header>
                  <DataGridTextColumn.Binding>
                    <Binding Path="ValorMonedaLabel" />
                  </DataGridTextColumn.Binding>
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
                      <Setter Property="TextAlignment" Value="Right" />
                      <Setter Property="Padding" Value="0,0,12,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="grand">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Explicación" Binding="{Binding Explicacion}" Width="*" MinWidth="180">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Padding" Value="0,0,12,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="grand">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Slate2}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <!-- Descuentos negociados por equipo/material específico -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Descuentos negociados" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" />
              <TextBlock Text="Descuento puntual por código de equipo/material (celdas, transformador, generador...), independiente del factor de presentación por categoría."
                         Style="{StaticResource Text.Helper}" TextWrapping="Wrap" Margin="0,0,0,10" />

              <Grid Margin="8,0,46,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CÓDIGO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Column="1" Text="DESCRIPCIÓN" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" />
                <TextBlock Grid.Column="2" Text="DESCUENTO %" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding NegotiatedDiscounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="20" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Codigo, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontSize="{StaticResource Font.Size.sm}" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="1" Text="{Binding Descripcion, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontSize="{StaticResource Font.Size.sm}" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="2" Text="{Binding DescuentoPct, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.sm}" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Grid.Column="3" Text="⚠" FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"
                                   ToolTip="{Binding ValidationHint}"
                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
                        <Button Grid.Column="4" Style="{StaticResource GoIconBtn}" Content="×" ToolTip="Quitar descuento"
                                Command="{Binding DataContext.RemoveNegotiatedDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ Agregar descuento" HorizontalAlignment="Left"
                      Margin="8,10,0,0" Padding="11,6" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                      Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Cursor="Hand"
                      Command="{Binding AddNegotiatedDiscountCommand}" />
            </StackPanel>
          </Border>

          <!-- Dotación indirecta por rol -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dotación indirecta" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding TotalStaffingPlanLabel}"
                           Style="{StaticResource Text.KpiInline}"
                           Foreground="{DynamicResource Brush.Green}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <TextBlock FontSize="{StaticResource Font.Size.xs}" TextWrapping="Wrap" Margin="0,0,0,10">
                <Run Foreground="{DynamicResource Brush.Muted}"
                     Text="Administrador, Supervisor, Capataz... por cargo, tarifa mensual, % de dedicación y meses. Se suma automáticamente a Gastos Operacionales." />
                <Run Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold"
                     Text=" No cargues el mismo rol también como ítem manual en Gastos Operacionales — se contaría dos veces." />
              </TextBlock>

              <Grid Margin="8,0,46,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CARGO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Column="1" Text="TARIFA MENSUAL" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="DEDIC. %" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="MESES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="TOTAL" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding StaffingPlan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="130" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="60" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Cargo, UpdateSourceTrigger=LostFocus}"
                                 FontSize="{StaticResource Font.Size.sm}" Margin="0,0,8,0" ToolTip="{Binding ValidationHint}"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                          <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="1" Text="{Binding TarifaMensualClp, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.sm}" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="2" Text="{Binding DedicacionPct, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.sm}" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="3" Text="{Binding Meses, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.sm}" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Grid.Column="4" Text="{Binding TotalLabel}" FontSize="{StaticResource Font.Size.sm}"
                                   FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="5" Style="{StaticResource GoIconBtn}" Content="×" ToolTip="Quitar cargo"
                                Command="{Binding DataContext.RemoveStaffingRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ Agregar cargo" HorizontalAlignment="Left"
                      Margin="8,10,0,0" Padding="11,6" FontSize="{StaticResource Font.Size.md}" FontWeight="SemiBold"
                      Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                      BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Cursor="Hand"
                      Command="{Binding AddStaffingRoleCommand}" />
            </StackPanel>
          </Border>

          <!-- Simulador de Negociación Comercial y Margen -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14"
                  DataContext="{Binding NegotiationSimulator}">
            <StackPanel>
              <DockPanel LastChildFill="True" Margin="0,0,0,6">
                <Border DockPanel.Dock="Right" Padding="8,3" CornerRadius="6"
                        Background="{Binding RiskBackgroundBrush}" BorderBrush="{Binding RiskBrush}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding RiskBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RiskBadgeText}" FontWeight="Bold" FontSize="11"
                               Foreground="{Binding RiskBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <StackPanel>
                  <TextBlock Text="SIMULADOR DE NEGOCIACIÓN COMERCIAL" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="Explore descuentos rápidos o un precio pactado en reunión con el mandante para verificar la rentabilidad líquida y no sobrepasar el piso crítico de costo."
                             Style="{StaticResource Text.Helper}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>

              <!-- Grid de control: Slider y Presets -->
              <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                      CornerRadius="8" Padding="14,10" Margin="0,8,0,10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Slider -->
                  <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding DiscountPct, StringFormat={}{0:0.0} %}"
                                 FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Blue}" />
                      <TextBlock Text="Descuento comercial global" FontWeight="SemiBold" FontSize="12"
                                 Foreground="{DynamicResource Brush.Ink}" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="25" Value="{Binding DiscountPct, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="False" SmallChange="0.5" LargeChange="1.0"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>

                  <!-- Botones de preset rápido -->
                  <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Atajos rápidos:" FontSize="10" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4" />
                    <WrapPanel>
                      <Button Content="0%" Command="{Binding SetDiscountPresetCommand}" CommandParameter="0"
                              Style="{StaticResource Button.Ghost}" Padding="6,2" Margin="0,0,4,0" FontSize="11" />
                      <Button Content="3%" Command="{Binding SetDiscountPresetCommand}" CommandParameter="3"
                              Style="{StaticResource Button.Ghost}" Padding="6,2" Margin="0,0,4,0" FontSize="11" />
                      <Button Content="5%" Command="{Binding SetDiscountPresetCommand}" CommandParameter="5"
                              Style="{StaticResource Button.Ghost}" Padding="6,2" Margin="0,0,4,0" FontSize="11" />
                      <Button Content="7%" Command="{Binding SetDiscountPresetCommand}" CommandParameter="7"
                              Style="{StaticResource Button.Ghost}" Padding="6,2" Margin="0,0,4,0" FontSize="11" />
                      <Button Content="10%" Command="{Binding SetDiscountPresetCommand}" CommandParameter="10"
                              Style="{StaticResource Button.Ghost}" Padding="6,2" FontSize="11" />
                    </WrapPanel>
                  </StackPanel>

                  <!-- Explicación semáforo -->
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RiskExplanationText}"
                             FontSize="11" Foreground="{Binding RiskBrush}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
              </Border>

              <!-- Panel comparativo de resultados -->
              <UniformGrid Columns="4" Margin="0,0,0,10">
                <!-- Precio Ofertado Negociado -->
                <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Navy}">
                  <StackPanel>
                    <TextBlock Text="PRECIO NEGOCIADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate2}" />
                    <TextBlock Text="{Binding NegotiatedPriceClp, StringFormat={}$ {0:N0}}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding NegotiatedPriceUf, StringFormat={}{0:N2} UF}" FontSize="11" Foreground="{DynamicResource Brush.Slate3}" />
                  </StackPanel>
                </Border>

                <!-- Descuento Otorgado -->
                <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="DESCUENTO OTORGADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding DiscountAmountClp, StringFormat={}$ {0:N0}}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding DiscountAmountUf, StringFormat={}{0:N2} UF}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                  </StackPanel>
                </Border>

                <!-- Utilidad Líquida -->
                <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="UTILIDAD ESTIMADA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock Text="{Binding ResultingProfitClp, StringFormat={}$ {0:N0}}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Green}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ResultingProfitUf, StringFormat={}{0:N2} UF}" FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                  </StackPanel>
                </Border>

                <!-- Margen Resultante -->
                <Border Padding="12,10" CornerRadius="8" Background="{Binding RiskBackgroundBrush}" BorderBrush="{Binding RiskBrush}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="MARGEN RESULTANTE" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskBrush}" />
                    <TextBlock Text="{Binding ResultingMarginPct, StringFormat={}{0:N1} %}" FontSize="16" FontWeight="Bold" Foreground="{Binding RiskBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding RiskBadgeText}" FontSize="11" Foreground="{Binding RiskBrush}" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Botón de acción: Aplicar como Precio Objetivo -->
              <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Aplicar como Precio Objetivo al presupuesto"
                        Style="{StaticResource Button.Primary}" Padding="14,7"
                        Command="{Binding ApplyTargetPriceCommand}"
                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ToolTip="Fija este precio en la política de cierre como Precio Objetivo y recalcula los factores comerciales." />
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Política de cierre comercial -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel DataContext="{Binding ClosingPolicySection}">
              <TextBlock Text="POLÍTICA DE CIERRE COMERCIAL" FontSize="{StaticResource Font.Size.xs}" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8" />

              <ComboBox ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedOption}"
                        DisplayMemberPath="DisplayName"
                        Style="{StaticResource Form.ComboBox}"
                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Left" MinWidth="220"
                        Margin="0,0,0,12" />

              <Border Margin="0,0,0,10" Padding="10,8" CornerRadius="8"
                      Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
                      Visibility="{Binding HasPolicyWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PolicyWarning}" FontSize="{StaticResource Font.Size.xs}"
                           Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" />
              </Border>

              <Border Margin="0,0,0,10" Padding="10,8" CornerRadius="8"
                      Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
                      Visibility="{Binding HasStampNote, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StampNote}" FontSize="{StaticResource Font.Size.xs}"
                           Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap" />
              </Border>

              <!-- Precio Objetivo -->
              <Border Margin="0,0,0,10" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}"
                      Visibility="{Binding ShowTargetPrice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="PRECIO OBJETIVO (CLP)" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                  <TextBox Text="{Binding TargetPriceClpText, UpdateSourceTrigger=LostFocus}"
                           Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
              </Border>

              <!-- Suma Alzada / EPC -->
              <Border Margin="0,0,0,10" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}"
                      Visibility="{Binding ShowLumpSum, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="CONTINGENCIA MÍNIMA (%)" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                  <TextBox Text="{Binding LumpSumMinRiskPctText, UpdateSourceTrigger=LostFocus}"
                           Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
              </Border>

              <!-- Costo + Fee -->
              <UniformGrid Columns="2" Margin="0,0,0,10"
                           Visibility="{Binding ShowCostPlusFee, Converter={StaticResource BoolToVisibility}}">
                <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="FEE FIJO (CLP)" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding FeeClpText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
                <Border Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="FEE % (si no hay fee fijo)" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding FeePctText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Gainshare / Painshare -->
              <UniformGrid Columns="3" Margin="0,0,0,10"
                           Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}">
                <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="COSTO OBJETIVO (CLP)" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding TargetCostClpText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="% COMPARTIDO" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding GainsharePctText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
                <Border Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="TOPE (CLP, 0 = sin tope)" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding GainshareCapClpText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.lg}" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Resultado -->
              <Border Margin="0,2,0,0" Padding="12,10" CornerRadius="10" Background="{DynamicResource Brush.Navy}">
                <StackPanel>
                  <UniformGrid Columns="2">
                    <StackPanel>
                      <TextBlock Text="VENTA FINAL" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate2}" />
                      <TextBlock Text="{Binding VentaFinalLabel}" FontSize="{StaticResource Font.Size.h3}" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                      <TextBlock Text="{Binding VentaFinalSubLabel}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Slate2}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="MARGEN" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.Slate2}" />
                      <TextBlock Text="{Binding MargenLabel}" FontSize="{StaticResource Font.Size.h3}" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" />
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock Text="{Binding Explicacion}" FontSize="{StaticResource Font.Size.sm}" Foreground="{DynamicResource Brush.Slate3}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding Advertencias}" Margin="0,8,0,0"
                            Visibility="{Binding HasAdvertencias, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="{StaticResource Font.Size.xs}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Orígenes -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14"
                  Visibility="{Binding ShowOrigenes, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Desglose por origen" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />
              <ItemsControl ItemsSource="{Binding Origenes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4"
                                Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Origen}" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.Blue}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Descripcion}"
                                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MaterialesUf, StringFormat={}{0:N2} UF}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.sm}"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="3" Text="{Binding TotalUf, StringFormat={}{0:N2} UF}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Resumen footer -->
          <Border Background="{DynamicResource Brush.Navy}" Padding="20,12" CornerRadius="8">
            <DockPanel LastChildFill="False">
              <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="RESUMEN DE COSTOS" FontSize="{StaticResource Font.Size.xs}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding ResumenFooterText}" FontSize="{StaticResource Font.Size.2xs}"
                           Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,1,0,0" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding TotalVentaLabel}"
                         FontSize="{StaticResource Font.Size.h2}" FontWeight="Bold" Foreground="{DynamicResource Brush.White}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Empty state -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver el desglose de costos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando costos…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
