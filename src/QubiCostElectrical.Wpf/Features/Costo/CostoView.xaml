                        <Border Width="15" Height="15" Margin="6,0,0,0" CornerRadius="8"
                                BorderBrush="{DynamicResource Brush.Ink4}" BorderThickness="1"
                                Background="Transparent" VerticalAlignment="Center" Cursor="Help"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
