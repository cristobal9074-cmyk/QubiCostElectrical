                              <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                    <Button Content="Aplicar" Command="{Binding ApplyCoeficientesCommand}"
                            Padding="11,7" FontSize="11" FontWeight="SemiBold"
                            Cursor="Hand" IsEnabled="{Binding CanEdit}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="White" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="#101A26" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
