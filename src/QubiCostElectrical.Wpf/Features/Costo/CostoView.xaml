<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.CostoView"
             x:Name="CostoRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:QubiCostElectrical.Wpf.Controls"
             xmlns:local="clr-namespace:QubiCostElectrical.Wpf.Features.Costo"
             xmlns:ds="clr-namespace:QubiCostElectrical.Wpf.DesignSystem"
             Background="{DynamicResource Brush.Canvas}">

  <UserControl.Resources>

    <local:FamiliaShareWidthConverter x:Key="ShareWidth" />

    <!-- ─── Celdas de la planilla de gastos operacionales (con eventos en code-behind) ─── -->
    <Style x:Key="GoSheetBox" TargetType="TextBox" BasedOn="{StaticResource GoCellBox}">
      <EventSetter Event="PreviewKeyDown" Handler="OnGoCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnGoCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGoCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnGoCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnGoCellLostFocus" />
    </Style>

    <Style x:Key="GoSheetMono" TargetType="TextBox" BasedOn="{StaticResource GoCellMono}">
      <EventSetter Event="PreviewKeyDown" Handler="OnGoCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnGoCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGoCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnGoCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnGoCellLostFocus" />
    </Style>

    <!-- ─── Celdas de la tabla de familias ───────────────────────────────── -->
    <Style x:Key="CoefCell" TargetType="TextBox" BasedOn="{StaticResource GoCellMono}">
      <Setter Property="Width" Value="58" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
      <EventSetter Event="PreviewKeyDown" Handler="OnCoefCellPreviewKeyDown" />
      <EventSetter Event="PreviewTextInput" Handler="OnCoefCellPreviewTextInput" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnCoefCellPreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnCoefCellGotFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnCoefCellLostFocus" />
    </Style>

    <Style x:Key="PrecioFamiliaChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,1,4,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="Arrastra a la fila del material" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnPrecioFamiliaMouseDown" />
      <EventSetter Event="PreviewMouseMove" Handler="OnPrecioFamiliaMouseMove" />
    </Style>

  </UserControl.Resources>

  <Grid>

    <!-- ══════════════════════════════════════════════════════════════════
         Pantalla (oculta si no hay proyecto abierto)
         ══════════════════════════════════════════════════════════════════ -->
    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ─── Cabecera + Hero: 6 KPIs ─────────────────────────────────── -->
      <local:CostoHeroControl Grid.Row="0" Grid.RowSpan="2" />

      <!-- ─── Barra de pestañas ────────────────────────────────────────── -->
      <Border Grid.Row="2" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
              BorderThickness="1" CornerRadius="10" Padding="4" Margin="18,10,18,0">
        <ItemsControl ItemsSource="{Binding Tabs.Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource CostoTabChip}"
                           GroupName="CostoTabs"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Opacity="0.85" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <Border Background="{DynamicResource Brush.ChipBg}" CornerRadius="4" Padding="5,1"
                          Margin="8,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding CountLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="9.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink4}" />
                  </Border>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 1 · COMPOSICIÓN
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsComposicion, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="430" />
          <ColumnDefinition Width="374" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Costo directo en cuatro sub-familias -->
        <local:CostoSubFamiliasSection Grid.Column="0" />

        <!-- Cascada de precio + concentración -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource Card.Header}">
                <StackPanel>
                  <TextBlock Text="CASCADA DE PRECIO" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Del costo de ejecución al precio de venta con IVA." Style="{StaticResource CierreHint}"
                             Margin="0,3,0,0" />
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="14,8,14,12">
                <ItemsControl ItemsSource="{Binding CostRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,4" ToolTip="{Binding Explicacion}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding EsCierre}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsQuiet}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsEnInforme}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Explicacion}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Border Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2"
                                  Background="{DynamicResource Brush.Blue2}" Opacity="0.45" IsHitTestVisible="False">
                            <Border.Width>
                              <MultiBinding Converter="{StaticResource ShareWidth}">
                                <Binding Path="Share" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Border.Width>
                          </Border>
                          <Grid Margin="0,1,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="124" />
                              <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Concepto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="FontSize" Value="12" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontSize" Value="13" />
                                      <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding CurrencyFigure}" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Ink}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGrand}" Value="True">
                                      <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding ParticipacionLabel}" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Ink4}" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="CONCENTRACIÓN DE MATERIALES" Style="{StaticResource CierreSec}" Margin="0" />
              <TextBlock Text="Top 3 familias sobre el material valorizado." Style="{StaticResource CierreHint}"
                         Margin="0,3,0,8" />
              <ItemsControl ItemsSource="{Binding Tabs.Concentracion}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="56" />
                      </Grid.ColumnDefinitions>
                      <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.BlueSoft}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Puesto}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Blue}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Familia}" Style="{StaticResource CostoLine}"
                                 VerticalAlignment="Center" Margin="6,0,8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding ImporteLabel}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding ShareLabel}" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11" Foreground="{DynamicResource Brush.Ink3}"
                                 TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Separator Style="{StaticResource Separator.Subtle}" Margin="0,8,0,0" />
              <TextBlock Text="El riesgo de compra se concentra en estas familias: conviene negociar por volumen."
                         Style="{StaticResource CierreHint}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 2 · MÁRGENES Y CIERRE
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsCierre, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="290" />
          <ColumnDefinition Width="*" MinWidth="290" />
          <ColumnDefinition Width="*" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Palancas -->
        <local:CostoPalancasSection Grid.Column="0" />

        <!-- Política de cierre + M.O. de instalación -->
        <Border Grid.Column="1" Style="{StaticResource Card.Surface}" Padding="0" Margin="12,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <StackPanel>
                <TextBlock Text="POLÍTICA DE CIERRE" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="Modelo contractual con el que se cierra la oferta." Style="{StaticResource CierreHint}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,4,14,12">
              <StackPanel>
                <StackPanel DataContext="{Binding ClosingPolicySection}">
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="DisplayName"
                            Style="{StaticResource Form.ComboBox}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <TextBlock Text="{Binding Explicacion}" Style="{StaticResource CierreHint}" Margin="0,8,0,0" />

                  <TextBlock Text="PRECIO OBJETIVO (CLP)" Style="{StaticResource CierreLab}" Margin="0,9,0,4"
                             Visibility="{Binding ShowTargetPrice, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding TargetPriceClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                           ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                           Visibility="{Binding ShowTargetPrice, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                  <TextBlock Text="CONTINGENCIA MÍN. %" Style="{StaticResource CierreLab}" Margin="0,9,0,4"
                             Visibility="{Binding ShowLumpSum, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding LumpSumMinRiskPctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                           ds:FieldAdornment.Suffix="%"
                           Visibility="{Binding ShowLumpSum, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                  <Grid Visibility="{Binding ShowCostPlusFee, Converter={StaticResource BoolToVisibility}}" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="FEE %" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding FeePctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Suffix="%"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="FEE FIJO (CLP)" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding FeeClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="El fee fijo tiene prioridad; si es 0 se usa el %." Style="{StaticResource CierreHint}" Margin="0,6,0,0"
                             Visibility="{Binding ShowCostPlusFee, Converter={StaticResource BoolToVisibility}}" />

                  <Grid Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="COSTO OBJETIVO" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding TargetCostClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="% COMPARTIDO" Style="{StaticResource CierreLab}" />
                      <TextBox Text="{Binding GainsharePctText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                               ds:FieldAdornment.Suffix="%"
                               IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="TOPE DE GANANCIA (CLP)" Style="{StaticResource CierreLab}" Margin="0,9,0,4"
                             Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}" />
                  <TextBox Text="{Binding GainshareCapClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}"
                           ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                           Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <TextBlock Text="{Binding GainshareSimulacionText}" Style="{StaticResource CierreHint}" Margin="0,8,0,0"
                             Visibility="{Binding HasGainshareSimulacion, Converter={StaticResource BoolToVisibility}}" />

                  <Border Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Amber}" BorderThickness="1"
                          CornerRadius="8" Padding="8,7" Margin="0,8,0,0"
                          Visibility="{Binding HasPolicyWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding PolicyWarning}" FontSize="10.5" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Text="{Binding StampNote}" Style="{StaticResource CierreHint}" Margin="0,8,0,0"
                             Visibility="{Binding HasStampNote, Converter={StaticResource BoolToVisibility}}" />
                  <ItemsControl ItemsSource="{Binding Advertencias}" Margin="0,8,0,0"
                                Visibility="{Binding HasAdvertencias, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource CierreHint}" Foreground="{DynamicResource Brush.Warning}" Margin="0,2,0,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,7" VerticalAlignment="Center">
                  <TextBlock Text="M.O. INSTALACIÓN" Style="{StaticResource CierreSec}" Margin="0" />
                  <Border Style="{StaticResource CostoHelpBadge}">
                    <TextBlock Style="{StaticResource CostoHelpBadgeText}" />
                    <Border.ToolTip>
                      <ToolTip MaxWidth="320">
                        <StackPanel Margin="2">
                          <TextBlock Text="MANO DE OBRA DE INSTALACIÓN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Blue}" Margin="0,0,0,3" />
                          <TextBlock Text="Define el modelo de cálculo de la mano de obra del itemizado: por rendimiento unitario (Días-Hombre) o calibración por Factor de Ajuste (FA) contra el plan de obra." FontSize="10.5" TextWrapping="Wrap" />
                        </StackPanel>
                      </ToolTip>
                    </Border.ToolTip>
                  </Border>
                </StackPanel>
                <CheckBox IsChecked="{Binding MoInstalacion.ModoMoRendimiento}" Margin="0,0,0,7" FontSize="11" Foreground="{DynamicResource Brush.Ink2}">
                  <TextBlock Text="M.O. por rendimiento (Tarifa D/H ÷ rendimiento del material)" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                  <TextBlock Text="Tarifa D/H" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Text="{Binding MoInstalacion.TarifaDhClpText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource CierreNum}" Width="145"
                           ds:FieldAdornment.Prefix="$" ds:FieldAdornment.Suffix="CLP"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Button Content="Derivar del plan MO" Command="{Binding MoInstalacion.DerivarTarifaDhCommand}" Style="{StaticResource Button.Secondary}"
                          Height="24" Padding="8,0" Margin="8,0,0,0" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox IsChecked="{Binding MoInstalacion.TarifaDhConLeyes}" Margin="0,0,0,7" FontSize="11" Foreground="{DynamicResource Brush.Ink2}">
                  <TextBlock Text="Incluir leyes sociales al derivar la tarifa" TextWrapping="Wrap" FontSize="11" />
                </CheckBox>
                <TextBlock Style="{StaticResource CierreHint}" TextWrapping="Wrap" Margin="0,0,0,2">
                  <Run Text="El índice FA del proyecto se calibra en la pestaña " />
                  <Run Text="Familias → FACTORES" FontWeight="SemiBold" />
                  <Run Text=", junto a la comparación con el costo real de mano de obra." />
                </TextBlock>
                <TextBlock Text="{Binding MoInstalacion.MoInstalacionHint}" Style="{StaticResource CierreHint}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Estado de palancas + ajustes + descuento puntual -->
        <local:CostoDescuentosSection Grid.Column="2" />
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 3 · FAMILIAS
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsFamilias, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="430" />
          <ColumnDefinition Width="360" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,0,0,1" Padding="12,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="FACTORES DE PRESENTACIÓN" FontSize="11" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Muted}" />
                  <TextBlock Text="Mismos nombres que la hoja COSTOS del Excel. El efectivo es factor × (1 − descuento)."
                             FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,1,12,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Calcular FA" Command="{Binding MoInstalacion.CalcularFaCommand}" Style="{StaticResource Button.Primary}"
                          Height="22" Padding="8,0" FontSize="11" Margin="0,0,4,0"
                          IsEnabled="{Binding CanEdit}"
                          ToolTip="FA = (M.O. real del proyecto − M.O. ya cubierta por el catálogo) ÷ Σ (Material × %). Calibra la M.O. de instalación al costo real del plan de obra." />
                  <Button Content="Gestionar familias" Command="{Binding AbrirGestionFamiliasCommand}" Style="{StaticResource Button.Secondary}" Height="22" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Ver, crear, renombrar y dar de baja familias del catálogo eléctrico" />
                  <Button Content="+ Agregar familia" Command="{Binding AgregarFamiliaPresentacionCommand}" Style="{StaticResource Button.Secondary}" Height="22" Padding="8,0" Margin="0,0,4,0" FontSize="11" IsEnabled="{Binding CanEdit}" ToolTip="Agregar una nueva familia de presentación personalizada" />
                  <Button Content="Estándar" Command="{Binding LoadCoeficientesEstandarCommand}" Style="{StaticResource Button.Secondary}" Height="22" Padding="8,0" Margin="0,0,4,0" FontSize="11" />
                  <Button Content="Típicos" Command="{Binding LoadTipicosCoeficientesCommand}" Style="{StaticResource Button.Secondary}" Height="22" Padding="8,0" Margin="0,0,4,0" FontSize="11" />
                  <Button Content="Reset 1,00×" Command="{Binding ResetCoeficientesCommand}" Style="{StaticResource Button.Ghost}" Height="22" Padding="8,0" FontSize="11" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,0,0,1" Padding="12,4" MinHeight="34">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="118" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="118" />
                  <ColumnDefinition Width="118" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="M/O" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Style="{StaticResource CoefCell}" Tag="m" Width="72" HorizontalAlignment="Left"
                         Text="{Binding MoInstalacion.IndiceMoFaText, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding CanEdit}"
                         ToolTip="FA del proyecto (Excel: COSTOS!E192). 0 = sin calibrar: la M.O. por % del itemizado no suma hasta derivar el índice." />
                <TextBlock Grid.Column="2" Text="{Binding MoInstalacion.FaDerivadoTexto}" FontSize="11"
                           Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" Margin="8,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding MoInstalacion.FaDerivadoTexto}" />
                <TextBlock Grid.Column="3" Text="{Binding MoInstalacion.MoEnPptoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                           Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right"
                           ToolTip="Mano de obra del itemizado con el FA vigente." />
                <TextBlock Grid.Column="4" Text="{Binding MoInstalacion.MoCostoRealLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                           Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right"
                           ToolTip="Costo real de mano de obra del proyecto." />
                <TextBlock Grid.Column="5" Text="{Binding MoInstalacion.MoDiasHombreLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                           Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right"
                           ToolTip="Días-hombre del plan de mano de obra." />
                <TextBlock Grid.Column="6" Text="{Binding MoInstalacion.MoDeltaLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextAlignment="Right">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding MoInstalacion.MoDeltaEsAviso}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="12,4,12,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="114" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="FACTOR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding CoefCostoHeader}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="2" Text="FACTOR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="3" Text="DCTO %" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="4" Text="EFECTIVO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
              <TextBlock Grid.Column="5" Text="{Binding CoefVentaHeader}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" />
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0">
              <ItemsControl x:Name="CoefFactorsList" ItemsSource="{Binding CoefFactors}" PreviewKeyDown="OnCoefTablePreviewKeyDown">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12,0,12,0" Height="30" BorderThickness="0,0,0,1" AllowDrop="True"
                            DragOver="OnCoefRowDragOver" Drop="OnCoefRowDrop">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" MinWidth="150" />
                          <ColumnDefinition Width="104" />
                          <ColumnDefinition Width="62" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="66" />
                          <ColumnDefinition Width="114" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Button x:Name="FamiliaPlus" Width="14" Height="14" Margin="0,0,8,0" Cursor="Hand"
                                  VerticalAlignment="Center" ToolTip="Familias de materiales"
                                  IsEnabled="{Binding DataContext.IsFactoresFamiliaEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Command="{Binding DataContext.AbrirCatalogoFamiliasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border Width="14" Height="14" CornerRadius="7" BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Line}" Background="Transparent">
                                  <TextBlock Text="+" FontSize="10" FontWeight="SemiBold"
                                             Foreground="{DynamicResource Brush.Ink3}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="2" Text="{Binding FamiliasResumen}" FontSize="10.5"
                                     Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding FamiliasResumen}" />
                          <Border Grid.Column="3" Margin="8,0,0,0" Padding="6,1,6,1" CornerRadius="3"
                                  VerticalAlignment="Center" ToolTip="{Binding OrigenToolTip}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding TieneAviso}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding OrigenTexto}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Amber}" />
                          </Border>
                          <Popup IsOpen="{Binding CatalogoAbierto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=FamiliaPlus}"
                                 Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="8,8,4,8" Width="260" MaxHeight="300">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Familias de materiales" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink}" Margin="2,0,8,6" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                  <ItemsControl ItemsSource="{Binding Catalogo}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Button Margin="0,0,4,1" Padding="4,3" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                IsEnabled="{Binding PuedeElegir}"
                                                Command="{Binding DataContext.ElegirFamiliaPrecioCommand, Source={x:Reference CostoRoot}}"
                                                CommandParameter="{Binding}">
                                          <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                              <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                              </Border>
                                              <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                  <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                                </Trigger>
                                              </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                          </Button.Template>
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="16" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Marca}" FontSize="11" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontSize="11.5" Foreground="{DynamicResource Brush.Ink}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Nota}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                          </Grid>
                                        </Button>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </ScrollViewer>
                              </DockPanel>
                            </Border>
                          </Popup>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding CostoUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBox Grid.Column="2" Style="{StaticResource CoefCell}" Tag="m" Width="54" HorizontalAlignment="Right"
                                 Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding DataContext.IsFactoresFamiliaEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="3" Style="{StaticResource CoefCell}" Tag="d" Width="48" HorizontalAlignment="Right"
                                 Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding DataContext.IsFactoresFamiliaEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Grid.Column="4" Text="{Binding EffectiveLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{Binding VentaUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" VerticalAlignment="Center" TextAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="4" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="0,1,0,0" Padding="12,7">
              <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center">
                  <Run Text="{Binding CoefFactorMedioLabel, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding CoefActivasLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" Margin="0,0,16,0">
                  <Run Text="Total familias · " />
                  <Run Text="{Binding FamCostoLabel, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" Margin="0,0,16,0">
                  <Run Text="Venta presentación " />
                  <Run Text="{Binding FamVentaLabel, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center">
                  <Run Text="Δ " />
                  <Run Text="{Binding FamDeltaLabel, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Blue}" />
                </TextBlock>
              </DockPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Pareto de familias -->
        <Border Grid.Column="1" Style="{StaticResource Card.Surface}" Padding="0" Margin="12,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <StackPanel>
                <TextBlock Text="PARETO DE MATERIALES" Style="{StaticResource CierreSec}" Margin="0" />
                <TextBlock Text="Participación de cada familia sobre el material valorizado." Style="{StaticResource CierreHint}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,8,14,12">
              <ItemsControl ItemsSource="{Binding Familias}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Familia}" Style="{StaticResource CostoLine}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ShareLabel}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink3}" />
                      </Grid>
                      <Grid Grid.Row="1" Margin="0,3,0,0">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.TrackSoft}" HorizontalAlignment="Stretch" />
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Blue2}"
                                HorizontalAlignment="Left" Opacity="0.85">
                          <Border.Width>
                            <MultiBinding Converter="{StaticResource ShareWidth}">
                              <Binding Path="Share" />
                              <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                            </MultiBinding>
                          </Border.Width>
                        </Border>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 4 · MANO DE OBRA Y VIÁTICOS
           ══════════════════════════════════════════════════════════════════ -->
      <local:CostoMoViaticosSection Grid.Row="3" Margin="18,10,18,14"
                                    Visibility="{Binding Tabs.IsMoViaticos, Converter={StaticResource BoolToVisibility}}" />

      <!-- ══════════════════════════════════════════════════════════════════
           PESTAÑA 5 · GASTOS OPERACIONALES
           ══════════════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="3" Margin="18,10,18,14"
            Visibility="{Binding Tabs.IsGastosOperacionales, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="430" />
          <ColumnDefinition Width="330" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card.Surface}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card.Header}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="GASTOS OPERACIONALES" Style="{StaticResource CierreSec}" Margin="0" />
                  <TextBlock Text="Categorías 3.1 a 3.6: instalación de faenas, oficina técnica, movilización, EPP y más."
                             Style="{StaticResource CierreHint}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Restablecer" Command="{Binding ResetGoPlantillaCommand}" Style="{StaticResource Button.Ghost}" Height="24" Padding="8,0" Margin="0,0,5,0" FontSize="10.5" />
                  <Button Content="+ Categoría" Command="{Binding AddGoCategoriaCommand}" Style="{StaticResource Button.Secondary}" Height="24" Padding="8,0" FontSize="10.5" />
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="14,8,14,12">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding GastosOperacionales}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="1" CornerRadius="9" Margin="0,0,0,7" ClipToBounds="True">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Eliminar"
                                      Command="{Binding DataContext.RemoveGoCategoriaCommand, Source={x:Reference CostoRoot}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                          <Button Command="{Binding DataContext.ToggleGoCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="9,8"
                                  HorizontalContentAlignment="Stretch" Cursor="Hand">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Chevron}" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                              <Border Grid.Column="1" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="5" Padding="4,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Codigo}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" />
                              </Border>
                              <StackPanel Grid.Column="2" Margin="7,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Concepto}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ItemsCountLabel}" FontSize="9.5" Foreground="{DynamicResource Brush.Ink4}" />
                              </StackPanel>
                              <TextBlock Grid.Column="3" Text="{Binding MontoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,7,0" />
                              <Border Grid.Column="4" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="5" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PctLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
                              </Border>
                            </Grid>
                          </Button>
                          <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" Margin="9,0,9,9">
                            <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,0,0,7" />
                            <Grid Margin="0,0,0,5">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="22" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="CONCEPTO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="UN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Center" Margin="0,0,4,0" />
                              <TextBlock Grid.Column="2" Text="CANT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" Margin="0,0,6,0" />
                              <TextBlock Grid.Column="3" Text="P.U." FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink4}" TextAlignment="Right" Margin="0,0,6,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" MinWidth="120" />
                                      <ColumnDefinition Width="62" />
                                      <ColumnDefinition Width="64" />
                                      <ColumnDefinition Width="108" />
                                      <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource GoSheetBox}" Tag="gc" Margin="0,0,6,0" TextWrapping="Wrap"
                                             Text="{Binding Concepto, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource GoSheetBox}" Tag="gu" Margin="0,0,4,0" Padding="2,2"
                                             TextAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                             Text="{Binding Unidad, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource GoSheetMono}" Tag="gn" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Text="{Binding CantidadTexto, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource GoSheetMono}" Tag="gp" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Text="{Binding PrecioTexto, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="4" Content="×" Style="{StaticResource Button.Ghost}" Padding="0" FontSize="14" Foreground="{DynamicResource Brush.Ink4}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Agregar ítem" Margin="0,2,0,0" Height="28" Cursor="Hand"
                                    Command="{Binding DataContext.AddGoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                  <Setter Property="BorderThickness" Value="1" />
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
                                  <Setter Property="FontSize" Value="11" />
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Clic en una categoría para editar sus ítems." Style="{StaticResource CierreHint}" Margin="0,4,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card.Surface}" Padding="14,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="TOTAL GASTOS OPERACIONALES" Style="{StaticResource CostoMicro}" />
                <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{DynamicResource Brush.Ink4}">
                  <Run Text="{Binding GoCategoriaCountLabel, Mode=OneWay}" />
                  <Run Text=" · " />
                  <Run Text="{Binding GoItemCountLabel, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding GoFooterSubLabel}" Style="{StaticResource CierreHint}" Margin="0,6,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalGoLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding TotalGoUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                           Foreground="{DynamicResource Brush.Ink4}" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Card.Surface}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="ATAJOS" Style="{StaticResource CierreSec}" Margin="0" />
              <TextBlock Text="La planilla de gastos operacionales se cierra contra el costo de ejecución y alimenta la oferta."
                         Style="{StaticResource CierreHint}" Margin="0,4,0,10" />
              <Button Content="Editar mano de obra" Command="{Binding GoToManoDeObraCommand}" Style="{StaticResource Button.Secondary}"
                      Height="28" FontSize="11" Margin="0,0,0,8" />
              <Button Content="Calcular viáticos" Command="{Binding OpenViaticosBarCommand}" Style="{StaticResource Button.Primary}"
                      Height="28" FontSize="11" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- Empty state -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver el desglose de costos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>

    <ctrl:SkeletonOverlayControl Panel.ZIndex="20" Message="Cargando costos…"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
