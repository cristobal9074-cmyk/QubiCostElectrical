                      <Setter Property="Padding" Value="0,0,12,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="grand">
                          <Setter Property="Foreground" Value="#FFFFFF" />
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Explicación" Binding="{Binding Explicacion}" Width="*" MinWidth="180">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Padding" Value="0,0,12,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="grand">
                          <Setter Property="Foreground" Value="#94A3B8" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

          <!-- Descuentos negociados por equipo/material específico -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Descuentos negociados" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,4" />
              <TextBlock Text="Descuento puntual por código de equipo/material (celdas, transformador, generador...), independiente del factor de presentación por categoría."
                         FontSize="10" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />

              <Grid Margin="8,0,46,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CÓDIGO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Column="1" Text="DESCRIPCIÓN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" />
                <TextBlock Grid.Column="2" Text="DESCUENTO %" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding NegotiatedDiscounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="20" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Codigo, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontSize="11" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="1" Text="{Binding Descripcion, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontSize="11" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="2" Text="{Binding DescuentoPct, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Grid.Column="3" Text="⚠" FontSize="12" Foreground="#B45309" VerticalAlignment="Center"
                                   ToolTip="{Binding ValidationHint}"
                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
                        <Button Grid.Column="4" Style="{StaticResource GoIconBtn}" Content="×" ToolTip="Quitar descuento"
                                Command="{Binding DataContext.RemoveNegotiatedDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ Agregar descuento" HorizontalAlignment="Left"
                      Margin="8,10,0,0" Padding="11,6" FontSize="12" FontWeight="SemiBold"
                      Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                      BorderBrush="#C9D4E3" BorderThickness="1" Cursor="Hand"
                      Command="{Binding AddNegotiatedDiscountCommand}" />
            </StackPanel>
          </Border>

          <!-- Dotación indirecta por rol -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dotación indirecta" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding TotalStaffingPlanLabel}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Green}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10">
                <Run Foreground="{DynamicResource Brush.Muted}"
                     Text="Administrador, Supervisor, Capataz... por cargo, tarifa mensual, % de dedicación y meses. Se suma automáticamente a Gastos Operacionales." />
                <Run Foreground="#B45309" FontWeight="SemiBold"
                     Text=" No cargues el mismo rol también como ítem manual en Gastos Operacionales — se contaría dos veces." />
              </TextBlock>

              <Grid Margin="8,0,46,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CARGO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
                <TextBlock Grid.Column="1" Text="TARIFA MENSUAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="DEDIC. %" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="MESES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" TextAlignment="Right" />
              </Grid>

              <ItemsControl ItemsSource="{Binding StaffingPlan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="130" />
                          <ColumnDefinition Width="90" />
                          <ColumnDefinition Width="60" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Cargo, UpdateSourceTrigger=LostFocus}"
                                 FontSize="11" Margin="0,0,8,0" ToolTip="{Binding ValidationHint}"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                          <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                  <Setter Property="BorderBrush" Value="#B45309" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="1" Text="{Binding TarifaMensualClp, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="2" Text="{Binding DedicacionPct, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="3" Text="{Binding Meses, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextAlignment="Right" Margin="0,0,8,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Grid.Column="4" Text="{Binding TotalLabel}" FontSize="11"
                                   FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="5" Style="{StaticResource GoIconBtn}" Content="×" ToolTip="Quitar cargo"
                                Command="{Binding DataContext.RemoveStaffingRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ Agregar cargo" HorizontalAlignment="Left"
                      Margin="8,10,0,0" Padding="11,6" FontSize="12" FontWeight="SemiBold"
                      Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                      BorderBrush="#C9D4E3" BorderThickness="1" Cursor="Hand"
                      Command="{Binding AddStaffingRoleCommand}" />
            </StackPanel>
          </Border>

          <!-- Política de cierre comercial -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
            <StackPanel DataContext="{Binding ClosingPolicySection}">
              <TextBlock Text="POLÍTICA DE CIERRE COMERCIAL" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,8" />

              <ComboBox ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedOption}"
                        DisplayMemberPath="DisplayName"
                        Style="{StaticResource Form.ComboBox}"
                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Left" MinWidth="220"
                        Margin="0,0,0,12" />

              <!-- Precio Objetivo -->
              <Border Margin="0,0,0,10" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}"
                      Visibility="{Binding ShowTargetPrice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="PRECIO OBJETIVO (CLP)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                  <TextBox Text="{Binding TargetPriceClpText, UpdateSourceTrigger=LostFocus}"
                           Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
              </Border>

              <!-- Suma Alzada / EPC -->
              <Border Margin="0,0,0,10" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                      BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}"
                      Visibility="{Binding ShowLumpSum, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="CONTINGENCIA MÍNIMA (%)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                  <TextBox Text="{Binding LumpSumMinRiskPctText, UpdateSourceTrigger=LostFocus}"
                           Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                           IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
              </Border>

              <!-- Costo + Fee -->
              <UniformGrid Columns="2" Margin="0,0,0,10"
                           Visibility="{Binding ShowCostPlusFee, Converter={StaticResource BoolToVisibility}}">
                <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="FEE FIJO (CLP)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding FeeClpText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
                <Border Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="FEE % (si no hay fee fijo)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding FeePctText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Gainshare / Painshare -->
              <UniformGrid Columns="3" Margin="0,0,0,10"
                           Visibility="{Binding ShowGainshare, Converter={StaticResource BoolToVisibility}}">
                <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="COSTO OBJETIVO (CLP)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding TargetCostClpText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="% COMPARTIDO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding GainsharePctText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
                <Border Padding="11,10" CornerRadius="10" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" Background="{DynamicResource Brush.BlueFaint}">
                  <StackPanel>
                    <TextBlock Text="TOPE (CLP, 0 = sin tope)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding GainshareCapClpText, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Form.TextBox}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold"
                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <!-- Resultado -->
              <Border Margin="0,2,0,0" Padding="12,10" CornerRadius="10" Background="{DynamicResource Brush.Navy}">
                <StackPanel>
                  <UniformGrid Columns="2">
                    <StackPanel>
                      <TextBlock Text="VENTA FINAL" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                      <TextBlock Text="{Binding VentaFinalLabel}" FontSize="16" FontWeight="Bold" Foreground="White" />
                      <TextBlock Text="{Binding VentaFinalSubLabel}" FontSize="10" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="MARGEN" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                      <TextBlock Text="{Binding MargenLabel}" FontSize="16" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock Text="{Binding Explicacion}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding Advertencias}" Margin="0,8,0,0"
                            Visibility="{Binding HasAdvertencias, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="10" Foreground="#B45309" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Orígenes -->
          <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14"
                  Visibility="{Binding ShowOrigenes, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Desglose por origen" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,12" />
              <ItemsControl ItemsSource="{Binding Origenes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="8,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4"
                                Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Origen}" FontSize="9" FontWeight="Bold"
                                     Foreground="{DynamicResource Brush.Blue}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Descripcion}"
                                   Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MaterialesUf, StringFormat={}{0:N2} UF}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="3" Text="{Binding TotalUf, StringFormat={}{0:N2} UF}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Ink}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Resumen footer -->
          <Border Background="{DynamicResource Brush.Navy}" Padding="20,12" CornerRadius="8">
            <DockPanel LastChildFill="False">
              <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="RESUMEN DE COSTOS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.HeaderMuted}" />
                <TextBlock Text="{Binding ResumenFooterText}" FontSize="9"
                           Foreground="{DynamicResource Brush.HeaderLabel}" Margin="0,1,0,0" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding TotalVentaLabel}"
                         FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Empty state -->
    <ctrl:EmptyStateControl Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            Title="Sin proyecto abierto"
                            Description="Abra un proyecto para ver el desglose de costos.">
      <ctrl:EmptyStateControl.Actions>
        <Button Style="{StaticResource Button.Primary}" Content="Abrir proyecto…" Command="{Binding OpenProjectCommand}" MinWidth="180" />
      </ctrl:EmptyStateControl.Actions>
    </ctrl:EmptyStateControl>
  </Grid>
</UserControl>
