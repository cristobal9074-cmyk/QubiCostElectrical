<Window x:Class="QubiCostElectrical.Wpf.Features.Costo.ViaticosProfesionalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora profesional de viáticos"
        Width="1120" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7"
        FontFamily="{StaticResource Font.Ui}"
        KeyDown="OnWindowKeyDown"
        ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style x:Key="VFieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#7B8798" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="VInput" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style x:Key="VCombo" TargetType="ComboBox" BasedOn="{StaticResource Form.ComboBox}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="VSideH2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#7B8798" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="VTabBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#5C6A7C" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                <Setter Property="Foreground" Value="#101A26" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VChip" TargetType="Button">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#3C4A5C" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="24">
              <Border x:Name="track" Background="#CBD5E1" CornerRadius="12" />
              <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                      Background="White" HorizontalAlignment="Left" Margin="3,0,0,0"
                      VerticalAlignment="Center">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.2" Color="#000" />
                </Border.Effect>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#2563B0" />
                <Setter TargetName="thumb" Property="Margin" Value="23,0,0,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VMealBtn" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#BFDBFE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header navy -->
    <Border Grid.Row="0" Padding="22,18,22,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#101C30" Offset="0" />
          <GradientStop Color="#14263C" Offset="0.55" />
          <GradientStop Color="#1A3A58" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="GASTO OPERACIONAL 3.3 · METODOLOGÍA TIPO PER DIEM"
                       FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" Margin="0,0,0,6" />
            <TextBlock Text="Movilización, alimentación y estadía"
                       FontSize="22" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Desglose profesional: pasajes, colación (con o sin provisión de la empresa) y arriendo/alojamiento. Al aplicar, genera las líneas del GO."
                       FontSize="13" Foreground="#9EFFFFFF" TextWrapping="Wrap" MaxWidth="620" Margin="0,5,0,0" LineHeight="18" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="Sincronizar MO" Command="{Binding SyncFromMoCommand}"
                    Padding="13,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd" Background="#14FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"
                          CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                      <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="White" />
                        </Style>
                      </ContentPresenter.Resources>
                    </ContentPresenter>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#28FFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button Content="Cargar ejemplo obra" Command="{Binding LoadDemoCommand}"
                    Padding="13,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd" Background="White" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                      <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#101A26" />
                        </Style>
                      </ContentPresenter.Resources>
                    </ContentPresenter>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>

        <UniformGrid Columns="5" Margin="0,14,0,0">
          <Border Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="PASAJES" FontSize="9" FontWeight="Bold" Foreground="#7AFFFFFF" />
              <TextBlock Text="{Binding KpiPasajes}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="ALIMENTACIÓN" FontSize="9" FontWeight="Bold" Foreground="#7AFFFFFF" />
              <TextBlock Text="{Binding KpiAlim}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="#86EFAC" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="ARRIENDO / ESTADÍA" FontSize="9" FontWeight="Bold" Foreground="#7AFFFFFF" />
              <TextBlock Text="{Binding KpiArriendo}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="#FCD34D" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="OTROS / INCIDENTALES" FontSize="9" FontWeight="Bold" Foreground="#7AFFFFFF" />
              <TextBlock Text="{Binding KpiOtros}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="11" Padding="12,10">
            <StackPanel>
              <TextBlock Text="TOTAL A GO 3.3" FontSize="9" FontWeight="Bold" Foreground="#7AFFFFFF" />
              <TextBlock Text="{Binding KpiTotal}" FontFamily="{StaticResource Font.Mono}" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Style="{StaticResource VSideH2}" Text="ALCANCE DEL CÁLCULO" />
            <WrapPanel>
              <Button Content="MO Directa" Command="{Binding ToggleChipDirCommand}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource VChip}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding UseDir}" Value="True">
                        <Setter Property="Background" Value="#EAF1FF" />
                        <Setter Property="Foreground" Value="#2563B0" />
                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="MO Indirecta" Command="{Binding ToggleChipIndCommand}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource VChip}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding UseInd}" Value="True">
                        <Setter Property="Background" Value="#FBF1DD" />
                        <Setter Property="Foreground" Value="#9A6A10" />
                        <Setter Property="BorderBrush" Value="#FDE68A" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </WrapPanel>

            <TextBlock Style="{StaticResource VSideH2}" Text="PARÁMETROS DE OBRA" Margin="0,16,0,10" />
            <TextBlock Style="{StaticResource VFieldLabel}" Text="ZONA / TIPO DE FAENA" />
            <ComboBox Style="{StaticResource VCombo}" SelectedValuePath="Tag" SelectedValue="{Binding Zona}" Margin="0,0,0,10">
              <ComboBoxItem Content="Local (misma ciudad / residencial)" Tag="local" />
              <ComboBoxItem Content="Regional (fuera de residencia)" Tag="regional" />
              <ComboBoxItem Content="Remoto / campamento (pernocta)" Tag="remoto" />
            </ComboBox>
            <TextBlock Style="{StaticResource VFieldLabel}" Text="DOTACIÓN DIRECTA (PICO)" />
            <TextBox Style="{StaticResource VInput}" Text="{Binding DotDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource VFieldLabel}" Text="ROLES INDIRECTOS" />
            <TextBox Style="{StaticResource VInput}" Text="{Binding DotInd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource VFieldLabel}" Text="MESES DE OBRA" />
            <TextBox Style="{StaticResource VInput}" Text="{Binding Meses, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource VFieldLabel}" Text="DÍAS HÁBILES / MES" />
            <TextBox Style="{StaticResource VInput}" Text="{Binding DiasMes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource VFieldLabel}" Text="FACTOR PRESENCIA DIRECTA (%)" />
            <TextBox Style="{StaticResource VInput}" Text="{Binding FactorPct, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource VFieldLabel}" Text="VALOR UF (CLP)" />
            <TextBox Style="{StaticResource VInput}" Text="{Binding ValorUf, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

            <TextBlock Style="{StaticResource VSideH2}" Text="REGLA DE DÍAS (TIPO VIÁTICO)" Margin="0,8,0,10" />
            <ComboBox Style="{StaticResource VCombo}" SelectedValuePath="Tag"
                      SelectedValue="{Binding ReglaDiaKey}" Margin="0,0,0,8">
              <ComboBoxItem Content="100% del día" Tag="100" />
              <ComboBoxItem Content="75% primer/último día (estilo GSA)" Tag="75" />
            </ComboBox>
            <TextBlock Text="En Chile el viático cubre alimentación, alojamiento y traslado cuando el trabajador se ausenta de su residencia. Si la empresa provee comida o casa, ese ítem se descuenta."
                       FontSize="11" Foreground="#5C6A7C" TextWrapping="Wrap" LineHeight="15" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Main -->
      <Grid Grid.Column="1" Margin="16,14,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,14">
          <UniformGrid Columns="4">
            <Button Content="1 · Pasajes" Command="{Binding SelectTabCommand}" CommandParameter="pasajes">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource VTabBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabPasajes}" Value="True">
                      <Setter Property="Background" Value="#101C30" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="2 · Alimentación" Command="{Binding SelectTabCommand}" CommandParameter="alim">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource VTabBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabAlim}" Value="True">
                      <Setter Property="Background" Value="#101C30" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="3 · Arriendo" Command="{Binding SelectTabCommand}" CommandParameter="arriendo">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource VTabBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabArriendo}" Value="True">
                      <Setter Property="Background" Value="#101C30" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="4 · Resumen GO" Command="{Binding SelectTabCommand}" CommandParameter="resumen">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource VTabBtn}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTabResumen}" Value="True">
                      <Setter Property="Background" Value="#101C30" />
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </UniformGrid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <!-- Tab Pasajes -->
            <Border Visibility="{Binding IsTabPasajes, Converter={StaticResource BoolToVisibility}}"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="Pasajes y movilización" FontSize="14" FontWeight="Bold" Foreground="#101A26" />
                  <Border DockPanel.Dock="Right" Background="#EAF1FF" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right">
                    <TextBlock Text="Traslado diario / semanal" FontSize="10" FontWeight="Bold" Foreground="#2563B0" />
                  </Border>
                </DockPanel>
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding InclPasDir}" />
                    <StackPanel>
                      <TextBlock Text="Incluir pasajes MO directa" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Transporte ida-vuelta o abono a faena" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding InclPasInd}" />
                    <StackPanel>
                      <TextBlock Text="Incluir movilización MO indirecta" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Visitas a terreno / supervisión" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="TARIFA PASAJE DIRECTA (CLP / DÍA-PERSONA)" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding TarifaPasDir, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="TARIFA MOVILIZACIÓN INDIRECTA (CLP / MES-ROL)" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding TarifaPasInd, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Border Background="#101C30" CornerRadius="11" Padding="14,12" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="FÓRMULA PASAJES" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" />
                    <TextBlock Text="{Binding EqPasajes}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                      <DockPanel>
                        <TextBlock Text="SUBTOTAL PASAJES" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubPasajesLabel}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Tab Alimentación -->
            <Border Visibility="{Binding IsTabAlim, Converter={StaticResource BoolToVisibility}}"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="Alimentación / colación" FontSize="14" FontWeight="Bold" />
                  <Border DockPanel.Dock="Right" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#EAF8EF" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding BadgeAlimIsOff}" Value="True">
                            <Setter Property="Background" Value="#FEF2F2" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding BadgeAlim}" FontSize="10" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#15803D" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding BadgeAlimIsOff}" Value="True">
                              <Setter Property="Foreground" Value="#B91C1C" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DockPanel>
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding EmpresaProveAlim}" />
                    <StackPanel>
                      <TextBlock Text="¿La empresa provee alimentación en obra?" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Si está activo, se descuenta el valor de las comidas marcadas" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="DESAYUNO (CLP/DÍA)" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding VDesayuno, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="ALMUERZO (CLP/DÍA)" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding VAlmuerzo, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="CENA (CLP/DÍA)" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding VCena, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Style="{StaticResource VFieldLabel}" Text="COMIDAS INCLUIDAS EN EL VIÁTICO" Margin="0,6,0,6" />
                <UniformGrid Columns="3">
                  <Button Command="{Binding ToggleMealDesCommand}" Margin="0,0,8,0">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource VMealBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MealDes}" Value="True">
                            <Setter Property="Background" Value="#EDF3FA" />
                            <Setter Property="BorderBrush" Value="#3B82F6" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="Desayuno" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding MealDesLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="#5C6A7C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding ToggleMealAlmCommand}" Margin="0,0,8,0">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource VMealBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MealAlm}" Value="True">
                            <Setter Property="Background" Value="#EDF3FA" />
                            <Setter Property="BorderBrush" Value="#3B82F6" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="Almuerzo" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding MealAlmLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="#5C6A7C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding ToggleMealCenCommand}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource VMealBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MealCen}" Value="True">
                            <Setter Property="Background" Value="#EDF3FA" />
                            <Setter Property="BorderBrush" Value="#3B82F6" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="Cena" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding MealCenLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="#5C6A7C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                  </Button>
                </UniformGrid>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding AlimDir}" />
                      <StackPanel>
                        <TextBlock Text="Aplicar a MO directa" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Días efectivos en faena" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding AlimInd}" />
                      <StackPanel>
                        <TextBlock Text="Aplicar a MO indirecta" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Días de visita estimados" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </Grid>
                <StackPanel Margin="0,10,0,0" MaxWidth="280" HorizontalAlignment="Left">
                  <TextBlock Style="{StaticResource VFieldLabel}" Text="DÍAS VISITA INDIRECTA / MES" />
                  <TextBox Style="{StaticResource VInput}" Text="{Binding DiasVisitaInd, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Border Background="#101C30" CornerRadius="11" Padding="14,12" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="FÓRMULA ALIMENTACIÓN" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" />
                    <TextBlock Text="{Binding EqAlim}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                      <DockPanel>
                        <TextBlock Text="SUBTOTAL ALIMENTACIÓN NETA" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubAlimLabel}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Tab Arriendo -->
            <Border Visibility="{Binding IsTabArriendo, Converter={StaticResource BoolToVisibility}}"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="Arriendo / alojamiento / estadía" FontSize="14" FontWeight="Bold" />
                  <Border DockPanel.Dock="Right" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#F1F5F9" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding BadgeArrIsOn}" Value="True">
                            <Setter Property="Background" Value="#FBF1DD" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding BadgeArr}" FontSize="10" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#5C6A7C" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding BadgeArrIsOn}" Value="True">
                              <Setter Property="Foreground" Value="#9A6A10" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DockPanel>
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding InclArriendo}" />
                    <StackPanel>
                      <TextBlock Text="Incluir arriendo o campamento" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Solo tiene sentido en zona regional/remota o personal fuera de casa" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="MODALIDAD" />
                    <ComboBox Style="{StaticResource VCombo}" SelectedValuePath="Tag" SelectedValue="{Binding ModalidadArriendo}">
                      <ComboBoxItem Content="Arriendo por noche-persona" Tag="noche" />
                      <ComboBoxItem Content="Arriendo mensual (casa / módulo)" Tag="mes" />
                      <ComboBoxItem Content="Aporte campamento (CLP/mes global)" Tag="campamento" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="{Binding HintArriendo, StringFormat=TARIFA ({0})}" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding TarifaArr, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="PERSONAS / CUPOS CON ESTADÍA" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding CuposArr, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource VFieldLabel}" Text="MESES CON ARRIENDO" />
                    <TextBox Style="{StaticResource VInput}" Text="{Binding MesesArr, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource VToggle}" IsChecked="{Binding InclOtros}" />
                    <StackPanel>
                      <TextBlock Text="Incidentales / otros" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="Lavandería, propinas, imprevistos menores (% sobre alim.+arriendo)" FontSize="11" Foreground="#5C6A7C" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <StackPanel Margin="0,10,0,0" MaxWidth="200" HorizontalAlignment="Left">
                  <TextBlock Style="{StaticResource VFieldLabel}" Text="% INCIDENTALES" />
                  <TextBox Style="{StaticResource VInput}" Text="{Binding PctOtros, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Border Background="#101C30" CornerRadius="11" Padding="14,12" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="FÓRMULA ARRIENDO + INCIDENTALES" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" />
                    <TextBlock Text="{Binding EqArr}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                      <DockPanel>
                        <TextBlock Text="SUBTOTAL ARRIENDO + OTROS" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubArrLabel}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Tab Resumen -->
            <StackPanel Visibility="{Binding IsTabResumen, Converter={StaticResource BoolToVisibility}}">
              <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="0" ClipToBounds="True">
                <StackPanel>
                  <DockPanel Margin="16,14,16,8">
                    <TextBlock Text="Líneas que se cargarán en GO 3.3" FontSize="14" FontWeight="Bold" />
                    <Border DockPanel.Dock="Right" Background="#EAF1FF" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right">
                      <TextBlock Text="Listo para aplicar" FontSize="10" FontWeight="Bold" Foreground="#2563B0" />
                    </Border>
                  </DockPanel>
                  <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False"
                            CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                            BorderThickness="0" RowHeaderWidth="0" MinHeight="160"
                            AlternatingRowBackground="#F8FAFC" Background="White"
                            HorizontalGridLinesBrush="#F1F5F9">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="CONCEPTO" Binding="{Binding Concepto}" Width="*" MinWidth="180" />
                      <DataGridTextColumn Header="GRUPO" Binding="{Binding GrupoLabel}" Width="90" />
                      <DataGridTextColumn Header="UN." Binding="{Binding Unidad}" Width="60" />
                      <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadLabel}" Width="90" />
                      <DataGridTextColumn Header="P. UNIT." Binding="{Binding PrecioLabel}" Width="100" />
                      <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalLabel}" Width="100" />
                      <DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoLabel}" Width="80" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <Border Background="#101C30" Padding="16,12">
                    <DockPanel>
                      <TextBlock Text="Total categoría 3.3" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding FootTotalLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding FootUfLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="#93C5FD" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Background="#EAF1FF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="11" Padding="13,11" Margin="0,12,0,0">
                <TextBlock FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" LineHeight="17">
                  <Run FontWeight="Bold" Text="Práctica profesional: " />
                  <Run Text="las apps y estándares de viático separan traslado, alimentación (M&amp;IE) y alojamiento. Si la empresa da comida o casa, ese componente se descuenta. En Chile, movilización/colación/viático son compensatorios cuando cubren gasto real (DT)." />
                </TextBlock>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="#F2F7F9FC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel LastChildFill="False">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Total a aplicar en Gastos Operacionales · 3.3" FontSize="12" Foreground="#5C6A7C" />
          <TextBlock Text="{Binding FootTotalLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="20" FontWeight="SemiBold" Foreground="#101A26" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Click="OnCancel" Style="{StaticResource Button.Secondary}" Padding="14,9" Margin="0,0,8,0" />
          <Button Content="Aplicar a GO 3.3" Click="OnApply" Style="{StaticResource Button.Primary}" Padding="16,9" FontWeight="SemiBold" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
