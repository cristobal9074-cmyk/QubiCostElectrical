<UserControl x:Class="QubiCostElectrical.Wpf.Features.Costo.ViaticosHeroSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Grid.Row="0" Padding="22,18,22,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
          <GradientStop Color="{StaticResource Color.Navy2}" Offset="0.55" />
          <GradientStop Color="{StaticResource Color.CostoHeroNavy3}" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="GASTO OPERACIONAL 3.3 · METODOLOGÍA TIPO PER DIEM"
                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.CostoWhite50}" Margin="0,0,0,6" />
            <TextBlock Text="Movilización, alimentación y estadía"
                       FontSize="22" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Desglose profesional: pasajes, colación (con o sin provisión de la empresa) y arriendo/alojamiento. Al aplicar, genera las líneas del GO."
                       FontSize="{StaticResource Font.Size.md}" Foreground="{DynamicResource Brush.CostoWhite60}" TextWrapping="Wrap" MaxWidth="620" Margin="0,5,0,0" LineHeight="18" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button AutomationProperties.Name="Sincronizar MO" Content="Sincronizar MO" Command="{Binding SyncFromMoCommand}"
                    Padding="13,8" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd" Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.CostoButtonBorder}" BorderThickness="1"
                          CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                      <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="White" />
                        </Style>
                      </ContentPresenter.Resources>
                    </ContentPresenter>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.CostoButtonHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button AutomationProperties.Name="Cargar ejemplo obra" Content="Cargar ejemplo obra" Command="{Binding LoadDemoCommand}"
                    Padding="13,8" FontSize="{StaticResource Font.Size.sm}" FontWeight="SemiBold" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd" Background="White" CornerRadius="{StaticResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                      <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                        </Style>
                      </ContentPresenter.Resources>
                    </ContentPresenter>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.DropdownHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>

        <UniformGrid Columns="5" Margin="0,14,0,0">
          <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White16}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="PASAJES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.CostoWhite50}" />
              <TextBlock Text="{Binding KpiPasajes}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.CostoChipValue}" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White16}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="ALIMENTACIÓN" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.CostoWhite50}" />
              <TextBlock Text="{Binding KpiAlim}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.CostoFlash}" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White16}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="ARRIENDO / ESTADÍA" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.CostoWhite50}" />
              <TextBlock Text="{Binding KpiArriendo}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.CostoHeroAmber}" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White16}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="OTROS / INCIDENTALES" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.CostoWhite50}" />
              <TextBlock Text="{Binding KpiOtros}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.CostoChipValue}" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Brush.White12}" BorderBrush="{DynamicResource Brush.White16}" BorderThickness="1" CornerRadius="11" Padding="12,10">
            <StackPanel>
              <TextBlock Text="TOTAL A GO 3.3" FontSize="{StaticResource Font.Size.2xs}" FontWeight="Bold" Foreground="{DynamicResource Brush.CostoWhite50}" />
              <TextBlock Text="{Binding KpiTotal}" FontFamily="{StaticResource Font.Mono}" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </Border>
</UserControl>

