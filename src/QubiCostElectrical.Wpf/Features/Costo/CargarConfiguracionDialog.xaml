<Window x:Class="QubiCostElectrical.Wpf.Features.Costo.CargarConfiguracionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cargar configuración de otro presupuesto"
        Width="720" Height="480"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource Dialog.Window}">
    <Border Style="{StaticResource Dialog.Chrome}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Cargar configuración de otro presupuesto" Style="{StaticResource Dialog.HeaderTitle}" />
                <TextBlock Text="Se copian los factores de presentación, los descuentos por familia y las asignaciones de familias. Elige el presupuesto de origen."
                           Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0,2,0,0" />
            </StackPanel>

            <ListBox x:Name="ProyectosList" Grid.Row="1" BorderThickness="1"
                     BorderBrush="{DynamicResource Brush.Line}"
                     Background="{DynamicResource Brush.Surface}"
                     DisplayMemberPath="Name"
                     MouseDoubleClick="OnProyectoDobleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="HintText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource Brush.Muted}"
                           Text="Doble clic para cargar, o selecciona y presiona Cargar." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Click="OnCancelar" Style="{StaticResource Button.Ghost}"
                            Height="28" Padding="12,0" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="Cargar" Click="OnCargar" Style="{StaticResource Button.Primary}"
                            Height="28" Padding="14,0" x:Name="CargarButton" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
