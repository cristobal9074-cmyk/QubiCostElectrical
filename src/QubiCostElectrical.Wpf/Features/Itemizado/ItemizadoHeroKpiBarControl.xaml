<UserControl x:Class="QubiCostElectrical.Wpf.Features.Itemizado.ItemizadoHeroKpiBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Line}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="14,9">
    <Grid>
      <Grid.ColumnDefinitions>
        <!-- 0: Costo Directo y Oferta (270px) -->
        <ColumnDefinition Width="270" />
        <!-- Divisor -->
        <ColumnDefinition Width="Auto" />
        <!-- 1: Proporción Materiales vs Mano de Obra (*) -->
        <ColumnDefinition Width="*" />
        <!-- Divisor -->
        <ColumnDefinition Width="Auto" />
        <!-- 2: Salud del Presupuesto y Filtros Rápidos (330px) -->
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <!-- ─── 0. RESUMEN FINANCIERO DIRECTO ─── -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
          <Border Background="{DynamicResource Brush.BlueSoft}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
            <TextBlock Text="COSTO DIRECTO" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Blue}" />
          </Border>
          <TextBlock Text="{Binding HeroKpi.DirectCostText}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Venta:" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,4,0" />
          <TextBlock Text="{Binding HeroKpi.TotalOfferText}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,10,0" />
          <TextBlock Text="Margen:" FontSize="10.5" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,4,0" />
          <TextBlock Text="{Binding HeroKpi.MarginText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
        </StackPanel>
      </StackPanel>

      <!-- Divisor vertical -->
      <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Line}" Margin="0,2,14,2" />

      <!-- ─── 1. PROPORCIÓN MATERIALES VS MANO DE OBRA ─── -->
      <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezados con porcentajes y montos -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" Margin="0,0,4,0" />
            <TextBlock Text="Mano de Obra: " FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding HeroKpi.ManoObraPctText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,4,0" />
            <TextBlock Text="{Binding HeroKpi.ManoObraText, StringFormat='({0})'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink3}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Blue}" Margin="0,0,4,0" />
            <TextBlock Text="Materiales: " FontSize="10" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding HeroKpi.MaterialesPctText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,0,4,0" />
            <TextBlock Text="{Binding HeroKpi.MaterialesText, StringFormat='({0})'}" FontSize="10" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink3}" />
          </StackPanel>
        </DockPanel>

        <!-- Barra de proporción segmentada bicolor -->
        <Border Grid.Row="1" Height="8" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Brush.Surface2}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding HeroKpi.MaterialesGridLength}" />
              <ColumnDefinition Width="{Binding HeroKpi.ManoObraGridLength}" />
              <ColumnDefinition Width="{Binding HeroKpi.OtrosGridLength}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Brush.Blue}" ToolTip="Materiales y Ferretería" />
            <Border Grid.Column="1" Background="{DynamicResource Brush.Success}" ToolTip="Mano de Obra Directa" />
            <Border Grid.Column="2" Background="{DynamicResource Brush.Line2}" ToolTip="Equipos y Subcontratos" />
          </Grid>
        </Border>

        <!-- Subetiqueta explicativa -->
        <TextBlock Grid.Row="2" Text="Distribución del costo directo entre recursos de materiales y brigadas de mano de obra"
                   FontSize="9" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
      </Grid>

      <!-- Divisor vertical -->
      <Border Grid.Column="3" Width="1" Background="{DynamicResource Brush.Line}" Margin="0,2,14,2" />

      <!-- ─── 2. SALUD DEL PRESUPUESTO Y FILTRO RÁPIDO ─── -->
      <Grid Grid.Column="4" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
          <!-- Badge de estado -->
          <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HeroKpi.HealthBadgeKind}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HeroKpi.HealthBadgeKind}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontSize="10" FontWeight="Bold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding HeroKpi.HealthBadgeText}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HeroKpi.HealthBadgeKind}" Value="ok">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HeroKpi.HealthBadgeKind}" Value="warn">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.AmberRisk}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="SALUD DE PARTIDAS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding HeroKpi.CompletionPct, StringFormat='({0}% listo)'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Blue}" />
          </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" LastChildFill="True">
          <!-- Botones de filtro rápido -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Secondary}"
                    Content="Pendientes"
                    Command="{Binding FilterIncompletosCommand}"
                    FontSize="9.5" Height="22" Padding="6,1" Margin="0,0,3,0"
                    ToolTip="Filtrar solo partidas pendientes para completarlas rápido" />
            <Button Style="{StaticResource Button.Secondary}"
                    Content="Todas"
                    Command="{Binding FilterTodosCommand}"
                    FontSize="9.5" Height="22" Padding="6,1"
                    ToolTip="Mostrar todas las partidas" />
          </StackPanel>

          <TextBlock Text="{Binding HeroKpi.HealthDescriptionText}"
                     FontSize="10" Foreground="{DynamicResource Brush.Muted}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
