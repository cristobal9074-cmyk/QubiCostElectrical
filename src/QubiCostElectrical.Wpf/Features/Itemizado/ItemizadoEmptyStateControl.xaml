<UserControl x:Class="QubiCostElectrical.Wpf.Features.Itemizado.ItemizadoEmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Margin="0,0,0,10"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}"
            Padding="16,14"
            MaxWidth="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,6,0,16">
      <StackPanel>
        <TextBlock Text="Comience a estructurar su presupuesto eléctrico"
                   Style="{StaticResource Text.ViewTitle}"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />
        <TextBlock Text="Cargue una plantilla RIC, importe una tabla o cree la primera partida."
                   Style="{StaticResource Text.Body}"
                   Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14" />

        <TextBlock Text="Plantillas RIC"
                   FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Muted}"
                   Margin="0,0,0,8" />
        <UniformGrid Columns="2" Margin="0,0,0,14">
          <Button Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                  Content="Edificio residencial (RIC 01-10)"
                  Command="{Binding LoadStandardTemplateCommand}"
                  CommandParameter="residential_building"
                  ToolTip="Cargar estructura para edificio residencial" />
          <Button Style="{StaticResource Button.Secondary}" Margin="0,0,0,6"
                  Content="Galpón industrial (RIC 02-13)"
                  Command="{Binding LoadStandardTemplateCommand}"
                  CommandParameter="industrial_warehouse"
                  ToolTip="Cargar estructura para galpón industrial" />
          <Button Style="{StaticResource Button.Secondary}" Margin="0,0,6,0"
                  Content="Planta solar / PMGD (RIC 09)"
                  Command="{Binding LoadStandardTemplateCommand}"
                  CommandParameter="solar_pv_plant"
                  ToolTip="Cargar estructura para planta solar" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Local comercial (RIC 01-11)"
                  Command="{Binding LoadStandardTemplateCommand}"
                  CommandParameter="commercial_retail"
                  ToolTip="Cargar estructura para local comercial" />
        </UniformGrid>

        <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Importar"
                  Command="{Binding ImportExcelCommand}"
                  ToolTip="Importar itemizado desde archivo (.xlsx)"
                  Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Pegar"
                  Command="{Binding PasteExcelCommand}"
                  ToolTip="Pegar filas del portapapeles (Ctrl+V)"
                  Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Primary}"
                  Content="Primera partida"
                  Command="{Binding AddPartidaCommand}"
                  ToolTip="Agregar la primera partida del itemizado" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
