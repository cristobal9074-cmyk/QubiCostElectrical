<Window x:Class="QubiCostElectrical.Wpf.Features.Itemizado.SelectExcelSheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog.Window}"
        Title="Seleccionar hoja de Excel"
        Width="780" Height="540" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterScreen">
  <Border Style="{StaticResource Dialog.Chrome}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="180" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Encabezado -->
      <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
        <Border Style="{StaticResource Dialog.HeaderIconContainer}" DockPanel.Dock="Left">
          <Path Data="M 14 2 H 6 a 2 2 0 0 0 -2 2 v 16 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 V 8 z M 14 2 v 6 h 6"
                Stroke="{DynamicResource Brush.Blue}" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Seleccionar hoja a importar" Style="{StaticResource Dialog.HeaderTitle}" />
          <TextBlock x:Name="FileSubtitleText" Style="{StaticResource Dialog.HeaderSubtitle}" Margin="0" />
        </StackPanel>
      </DockPanel>

      <!-- Grilla de Hojas Disponibles -->
      <Border Grid.Row="1" Style="{StaticResource Card.Section}" Padding="0">
        <DataGrid x:Name="SheetsGrid"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  SelectionChanged="SheetsGrid_SelectionChanged"
                  MouseDoubleClick="SheetsGrid_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Sugerencia" Width="140" HeaderStyle="{StaticResource DataGridColumnHeader.Base}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                          Background="{Binding BadgeBackground}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding BadgeForeground}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Nombre de la Hoja" Binding="{Binding Name}" Width="*"
                                FontWeight="SemiBold" HeaderStyle="{StaticResource DataGridColumnHeader.Base}" />

            <DataGridTextColumn Header="Filas" Binding="{Binding RowCountDisplay}" Width="90"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" />

            <DataGridTextColumn Header="Partidas Est." Binding="{Binding EstimatedDisplay}" Width="110"
                                HeaderStyle="{StaticResource DataGridColumnHeader.Numeric}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Título de Vista Previa -->
      <TextBlock Grid.Row="2" Text="Vista previa de las primeras filas de la hoja:"
                 FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Ink2}" Margin="0,12,0,6" />

      <!-- Grilla de Muestra de Filas -->
      <Border Grid.Row="3" Style="{StaticResource Card.Section}" Padding="0">
        <DataGrid x:Name="PreviewSampleGrid"
                  Style="{StaticResource DataGrid.Workspace}"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="None"
                  EnableRowVirtualization="True" />
      </Border>

      <!-- Pie con Botones -->
      <DockPanel Grid.Row="4" Style="{StaticResource Dialog.Footer}">
        <TextBlock DockPanel.Dock="Left" Text="Doble clic en una fila o pulse Continuar para importar."
                   Foreground="{DynamicResource Brush.Muted}" FontSize="12" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}" Content="Cancelar"
                  MinWidth="100" Height="34" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
          <Button x:Name="AcceptButton" Style="{StaticResource Button.Primary}" Content="Continuar con esta hoja"
                  MinWidth="160" Height="34" IsDefault="True" Click="AcceptButton_Click" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
