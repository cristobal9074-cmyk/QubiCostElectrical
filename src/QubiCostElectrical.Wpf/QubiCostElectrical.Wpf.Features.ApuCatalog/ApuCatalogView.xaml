<UserControl x:Class="QubiCostElectrical.Wpf.Features.ApuCatalog.ApuCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Canvas}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="1200" HorizontalAlignment="Left">

      <TextBlock Text="Catálogo de APU" FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.Ink}" Margin="0,0,0,4" />
      <TextBlock Text="Busca, filtra y compara los análisis de precios unitarios registrados en el catálogo."
                 FontSize="12" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

      <!-- Barra de búsqueda / filtros -->
      <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="BUSCAR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource Form.TextBox}" FontSize="13" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="CATEGORÍA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,5" />
            <TextBox Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource Form.TextBox}" FontSize="13" />
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
            <Button Content="Buscar" Command="{Binding SearchCommand}"
                    Padding="16,8" FontWeight="SemiBold" Cursor="Hand"
                    Background="{DynamicResource Brush.Navy}" Foreground="White" BorderThickness="0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Estado / estadísticas -->
      <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="RESULTADOS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="Bold"
                       FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,24,0">
            <TextBlock Text="PÁGINA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}" />
            <TextBlock FontSize="18" FontWeight="Bold" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Ink}">
              <Run Text="{Binding CurrentPage, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="12"
                     Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                     HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="360" />
        </Grid>
      </Border>

      <!-- Resultados -->
      <Border Style="{StaticResource Card.Section}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="APU encontrados" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="‹ Anterior" Command="{Binding PreviousPageCommand}"
                      Padding="11,6" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                      Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                      BorderBrush="#C9D4E3" BorderThickness="1" Cursor="Hand" />
              <Button Content="Siguiente ›" Command="{Binding NextPageCommand}"
                      Padding="11,6" FontSize="12" FontWeight="SemiBold"
                      Foreground="{DynamicResource Brush.Blue}" Background="Transparent"
                      BorderBrush="#C9D4E3" BorderThickness="1" Cursor="Hand" />
            </StackPanel>
          </Grid>

          <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                    AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="90" />
              <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="130" />
              <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="70" />
              <DataGridTextColumn Header="Versiones" Binding="{Binding VersionCount}" Width="80">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="V. activa" Binding="{Binding ActiveVersionNumber}" Width="80">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Estado" Binding="{Binding ActiveVersionStatus}" Width="90" />
              <DataGridTextColumn Header="Último precio" Binding="{Binding LastPrice, StringFormat='{}{0:N0}'}" Width="110">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="TextAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="60" />
              <DataGridTextColumn Header="Responsable" Binding="{Binding Owner}" Width="120" />
              <DataGridTemplateColumn Header="" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Comparar" Padding="8,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                            Background="Transparent" BorderThickness="1" BorderBrush="#C9D4E3"
                            Foreground="{DynamicResource Brush.Blue}"
                            Command="{Binding DataContext.CompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
