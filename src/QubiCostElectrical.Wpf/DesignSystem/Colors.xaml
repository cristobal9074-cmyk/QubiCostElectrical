<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Core navy / brand background ─────────────────────────────────── -->
    <Color x:Key="Color.Navy">#101C30</Color>
    <Color x:Key="Color.NavyEnd">#0C1626</Color>
    <Color x:Key="Color.Navy2">#14263C</Color>
    <Color x:Key="Color.Navy3">#1C324C</Color>

    <!-- ── Header internals (deep navy for search/badge elements) ────────── -->
    <Color x:Key="Color.NavyDeep">#0F1730</Color>
    <Color x:Key="Color.NavyDeep2">#10233B</Color>
    <Color x:Key="Color.NavyBorder">#244A73</Color>
    <Color x:Key="Color.NavyBorder2">#245B86</Color>

    <!-- ── Blue spectrum ─────────────────────────────────────────────────── -->
    <Color x:Key="Color.BlueDark">#1D4ED8</Color>
    <Color x:Key="Color.Blue">#2563B0</Color>
    <Color x:Key="Color.Blue2">#3B82F6</Color>
    <Color x:Key="Color.Blue3">#4B8DF7</Color>
    <Color x:Key="Color.BlueFocus">#77A5F7</Color>
    <Color x:Key="Color.BlueSoft">#EAF1FF</Color>
    <Color x:Key="Color.BlueFaint">#EDF3FA</Color>
    <Color x:Key="Color.BlueHover">#F0F5FF</Color>
    <Color x:Key="Color.BlueSelected">#E8F1FF</Color>
    <Color x:Key="Color.BlueIconBg2">#DCE8FF</Color>

    <!-- ── Brand icon colors (hexagon logo shapes) ──────────────────────── -->
    <Color x:Key="Color.BrandDark">#1A3B6E</Color>
    <Color x:Key="Color.BrandMid">#2D5FAF</Color>
    <Color x:Key="Color.BrandStroke">#60A5FA</Color>
    <Color x:Key="Color.BrandStroke2">#91B7FF</Color>
    <Color x:Key="Color.BrandStroke3">#BFDBFE</Color>
