    <SolidColorBrush x:Key="Brush.Violet"       Color="{StaticResource Color.Violet}" />
    <SolidColorBrush x:Key="Brush.VioletDark"   Color="{StaticResource Color.VioletDark}" />

    <SolidColorBrush x:Key="Brush.HeaderInk"        Color="{StaticResource Color.HeaderInk}" />
    <SolidColorBrush x:Key="Brush.HeaderMuted"       Color="{StaticResource Color.HeaderMuted}" />
    <SolidColorBrush x:Key="Brush.HeaderNav"         Color="{StaticResource Color.HeaderNav}" />
    <SolidColorBrush x:Key="Brush.HeaderNavActive"   Color="{StaticResource Color.HeaderNavActive}" />
    <SolidColorBrush x:Key="Brush.HeaderLabel"       Color="{StaticResource Color.HeaderLabel}" />
    <SolidColorBrush x:Key="Brush.HeaderControl"     Color="{StaticResource Color.HeaderControl}" />
    <SolidColorBrush x:Key="Brush.HeaderStatus"      Color="{StaticResource Color.HeaderStatus}" />
    <SolidColorBrush x:Key="Brush.HeaderDim"         Color="{StaticResource Color.HeaderDim}" />
    <SolidColorBrush x:Key="Brush.HeaderDate"        Color="{StaticResource Color.HeaderDate}" />

    <SolidColorBrush x:Key="Brush.SaveDot"      Color="{StaticResource Color.SaveDot}" />
    <SolidColorBrush x:Key="Brush.AvatarBg"     Color="{StaticResource Color.AvatarBg}" />

    <!-- ── WCAG AAA Financial Ratio Brushes ──────────────────────────────── -->
    <SolidColorBrush x:Key="Brush.Finance.Direct"        Color="{StaticResource Color.Finance.Direct}" />
    <SolidColorBrush x:Key="Brush.Finance.Indirect"      Color="{StaticResource Color.Finance.Indirect}" />
    <SolidColorBrush x:Key="Brush.Finance.Margin"        Color="{StaticResource Color.Finance.Margin}" />
    <SolidColorBrush x:Key="Brush.Finance.DirectSoft"    Color="{StaticResource Color.Finance.DirectSoft}" />
    <SolidColorBrush x:Key="Brush.Finance.IndirectSoft"  Color="{StaticResource Color.Finance.IndirectSoft}" />
    <SolidColorBrush x:Key="Brush.Finance.MarginSoft"    Color="{StaticResource Color.Finance.MarginSoft}" />
    <SolidColorBrush x:Key="Brush.Finance.Track"         Color="{StaticResource Color.Finance.Track}" />
    <SolidColorBrush x:Key="Brush.Finance.TrackBorder"   Color="{StaticResource Color.Finance.TrackBorder}" />

    <!-- Accent / warning aliases used across modules -->
    <SolidColorBrush x:Key="Brush.Accent"       Color="{StaticResource Color.Blue}" />
    <SolidColorBrush x:Key="Brush.Warning"      Color="{StaticResource Color.AmberRisk}" />
    <SolidColorBrush x:Key="Brush.WarningSoft"  Color="{StaticResource Color.AmberSoft}" />
    <SolidColorBrush x:Key="Brush.OnPrimary"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TrackSoft"    Color="{StaticResource Color.Line2}" />
    <SolidColorBrush x:Key="Brush.HighlightSoft" Color="{StaticResource Color.BlueFaint}" />
    <SolidColorBrush x:Key="Brush.HighlightBorder" Color="{StaticResource Color.BlueSoft}" />

    <!-- ── Celdas editables vs fórmulas (Estilo Excel Profesional) ──────────── -->
    <SolidColorBrush x:Key="Brush.CellFormulaBg"       Color="{StaticResource Color.CellFormulaBg}" />
    <SolidColorBrush x:Key="Brush.CellEditableBg"      Color="{StaticResource Color.CellEditableBg}" />
    <SolidColorBrush x:Key="Brush.CellEditableHoverBg" Color="{StaticResource Color.CellEditableHover}" />
    <SolidColorBrush x:Key="Brush.CellFormulaInk"      Color="{StaticResource Color.CellFormulaInk}" />
    <SolidColorBrush x:Key="Brush.FormulaBadge"        Color="{StaticResource Color.FormulaBadge}" />
    <SolidColorBrush x:Key="Brush.FormulaBadgeBg"      Color="{StaticResource Color.FormulaBadgeBg}" />

    <!-- Aliases usados por Cubicación SC, Itemizado y diálogos legacy -->
    <SolidColorBrush x:Key="Brush.SurfaceAlt"  Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Border"      Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.GreenSoft}" />

    <!-- ── Header overlay brushes (semi-transparent whites over dark bg) ── -->
    <SolidColorBrush x:Key="Brush.White8"        Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.White9"        Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.White12"       Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.White14"       Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.White16"       Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.White18"       Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Brush.White25"       Color="#20FFFFFF" />
    <SolidColorBrush x:Key="Brush.HeaderIconBlue" Color="#2B5992FF" />

    <!-- ════════════════════════════════════════════════════════════════════
         BRUSHES — gradients
         ════════════════════════════════════════════════════════════════════ -->

    <LinearGradientBrush x:Key="Brush.HeaderBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
        <GradientStop Color="{StaticResource Color.NavyEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeroPanel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Navy}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Navy2}" Offset="0.55" />
        <GradientStop Color="{StaticResource Color.CostoHeroNavy3}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrimaryButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Blue2}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Blue}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrimaryButtonHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Blue3}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Blue2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrimaryButtonPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Blue}" Offset="0" />
        <GradientStop Color="{StaticResource Color.BlueDark}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.BrandMark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Blue3}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Blue}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
