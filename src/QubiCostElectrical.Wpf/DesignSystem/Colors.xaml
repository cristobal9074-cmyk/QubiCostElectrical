    <!-- ── Semantic colors ───────────────────────────────────────────────── -->
    <Color x:Key="Color.Cyan">#0891B2</Color>
    <Color x:Key="Color.Pink">#EC4899</Color>
    <Color x:Key="Color.PinkSoft">#FCE7F3</Color>
    <Color x:Key="Color.Green">#15803D</Color>
    <Color x:Key="Color.GreenSoft">#EAF8EF</Color>
    <Color x:Key="Color.Success">#1E7A4B</Color>
    <Color x:Key="Color.SuccessBright">#22C55E</Color>
    <Color x:Key="Color.SuccessDark">#166534</Color>
    <Color x:Key="Color.SuccessBg">#E3F3EA</Color>
    <Color x:Key="Color.SuccessBorder">#BBF7D0</Color>
    <Color x:Key="Color.Amber">#9A6A10</Color>
    <Color x:Key="Color.AmberSoft">#FBF1DD</Color>
    <Color x:Key="Color.Amber2">#FFCE76</Color>
    <Color x:Key="Color.AmberRisk">#C98A1B</Color>
    <Color x:Key="Color.Red">#C24141</Color>
    <Color x:Key="Color.RedSoft">#FFF0F0</Color>
    <Color x:Key="Color.Danger">#B23434</Color>
    <Color x:Key="Color.Danger2">#D64545</Color>
    <Color x:Key="Color.DangerDark">#B91C1C</Color>
    <Color x:Key="Color.DangerBg">#FDECEC</Color>
    <Color x:Key="Color.DangerBorder">#FECACA</Color>

    <!-- ── WCAG AAA Financial Ratio Colors (Contrast > 7:1) ───────────────── -->
    <Color x:Key="Color.Finance.Direct">#1E3A8A</Color>
    <Color x:Key="Color.Finance.Indirect">#78350F</Color>
    <Color x:Key="Color.Finance.Margin">#14532D</Color>
    <Color x:Key="Color.Finance.DirectSoft">#DBEAFE</Color>
    <Color x:Key="Color.Finance.IndirectSoft">#FEF3C7</Color>
    <Color x:Key="Color.Finance.MarginSoft">#DCFCE7</Color>
    <Color x:Key="Color.Finance.Track">#E2E8F0</Color>
    <Color x:Key="Color.Finance.TrackBorder">#94A3B8</Color>

    <!-- ── Info / Purple (recurso MO) ──────────────────────────────────────── -->
    <Color x:Key="Color.Info">#2B5AA0</Color>
    <Color x:Key="Color.InfoBg">#E8EFFA</Color>
    <Color x:Key="Color.Purple">#6B4FA8</Color>
    <Color x:Key="Color.PurpleSoft">#EFEAFA</Color>
    <Color x:Key="Color.Violet">#7C3AED</Color>
    <Color x:Key="Color.VioletDark">#5B21B6</Color>

    <!-- ── Ink (text) spectrum: títulos/cuerpo/secundario/muted/deshabilitado ── -->
    <Color x:Key="Color.Ink">#101A26</Color>
    <Color x:Key="Color.Ink2">#3C4A5C</Color>
    <Color x:Key="Color.Ink3">#5C6A7C</Color>
    <Color x:Key="Color.Ink4">#7B8798</Color>
    <Color x:Key="Color.Ink5">#94A1B0</Color>
    <Color x:Key="Color.Ink6">#56708A</Color>
    <Color x:Key="Color.Ink7">#41566D</Color>
    <!-- Brush.Muted referencia Color.Ink4 (nivel "muted" del handoff); Ink3 es "secundario". -->

    <!-- ── Slate (neutral gray-blue) ─────────────────────────────────────── -->
    <Color x:Key="Color.Slate">#64748B</Color>
    <Color x:Key="Color.Slate2">#94A3B8</Color>
    <Color x:Key="Color.Slate3">#CBD5E1</Color>
    <Color x:Key="Color.SlateLight">#E2E8F0</Color>

    <!-- ── Surface / canvas ──────────────────────────────────────────────── -->
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface2">#FAFBFD</Color>
    <Color x:Key="Color.Canvas">#EEF1F5</Color>
    <Color x:Key="Color.WorkspaceBar">#F8FAFC</Color>
    <Color x:Key="Color.PanelHeader">#FAFBFD</Color>
    <Color x:Key="Color.PanelSidebar">#FAFBFD</Color>
    <Color x:Key="Color.InputBorder">#CBD5E1</Color>
    <Color x:Key="Color.DropdownHover">#F1F5FA</Color>
    <Color x:Key="Color.RowHover">#F1F5FB</Color>
    <Color x:Key="Color.ChipBg">#F1F4F8</Color>
    <Color x:Key="Color.ChapterRowBg">#EEF3F8</Color>
    <Color x:Key="Color.ActiveRowBg">#E6EFFD</Color>
    <Color x:Key="Color.ActiveRowHoverBg">#DCE8FC</Color>
    <Color x:Key="Color.CellFormulaBg">#F1F4F9</Color>
    <Color x:Key="Color.CellEditableBg">#FFFFFF</Color>
    <Color x:Key="Color.CellEditableHover">#F0F5FF</Color>
    <Color x:Key="Color.CellFormulaInk">#334155</Color>
    <Color x:Key="Color.FormulaBadge">#64748B</Color>
    <Color x:Key="Color.FormulaBadgeBg">#E9EFF6</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>
    <Color x:Key="Color.InputHoverBorder">#BAC7D5</Color>

    <!-- ── Borders / lines ───────────────────────────────────────────────── -->
    <Color x:Key="Color.Line">#DDE3EA</Color>
    <Color x:Key="Color.Line2">#EEF2F6</Color>

    <!-- ── Header text / icons ───────────────────────────────────────────── -->
    <Color x:Key="Color.HeaderInk">#EEF4FB</Color>
    <Color x:Key="Color.HeaderMuted">#9EB1C8</Color>
    <Color x:Key="Color.HeaderNav">#9DB1C9</Color>
    <Color x:Key="Color.HeaderNavActive">#5B91FF</Color>
    <Color x:Key="Color.HeaderLabel">#91A6BD</Color>
    <Color x:Key="Color.HeaderControl">#BFD0E2</Color>
    <Color x:Key="Color.HeaderStatus">#A7B8CB</Color>
    <Color x:Key="Color.HeaderDim">#72859A</Color>
    <Color x:Key="Color.HeaderDate">#A0B0C0</Color>

    <!-- ── Misc ──────────────────────────────────────────────────────────── -->
    <Color x:Key="Color.SaveDot">#40C77D</Color>
    <Color x:Key="Color.AvatarBg">#2E4468</Color>
    <Color x:Key="Color.Shadow">#30000000</Color>
    <Color x:Key="Color.ShadowDropdown">#38091428</Color>

    <!-- ════════════════════════════════════════════════════════════════════
         BRUSHES — solid colors
         ════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Brush.Navy"          Color="{StaticResource Color.Navy}" />
    <SolidColorBrush x:Key="Brush.Navy2"         Color="{StaticResource Color.Navy2}" />
    <SolidColorBrush x:Key="Brush.Navy3"         Color="{StaticResource Color.Navy3}" />
    <SolidColorBrush x:Key="Brush.NavyDeep"      Color="{StaticResource Color.NavyDeep}" />
    <SolidColorBrush x:Key="Brush.NavyDeep2"     Color="{StaticResource Color.NavyDeep2}" />
    <SolidColorBrush x:Key="Brush.NavyBorder"    Color="{StaticResource Color.NavyBorder}" />
    <SolidColorBrush x:Key="Brush.NavyBorder2"   Color="{StaticResource Color.NavyBorder2}" />

    <SolidColorBrush x:Key="Brush.BlueDark"      Color="{StaticResource Color.BlueDark}" />
    <SolidColorBrush x:Key="Brush.Blue"          Color="{StaticResource Color.Blue}" />
    <SolidColorBrush x:Key="Brush.Blue2"         Color="{StaticResource Color.Blue2}" />
    <SolidColorBrush x:Key="Brush.Blue3"         Color="{StaticResource Color.Blue3}" />
    <SolidColorBrush x:Key="Brush.BlueFocus"     Color="{StaticResource Color.BlueFocus}" />
    <SolidColorBrush x:Key="Brush.BlueSoft"      Color="{StaticResource Color.BlueSoft}" />
    <SolidColorBrush x:Key="Brush.BlueFaint"     Color="{StaticResource Color.BlueFaint}" />
    <SolidColorBrush x:Key="Brush.BlueHover"     Color="{StaticResource Color.BlueHover}" />
    <SolidColorBrush x:Key="Brush.BlueSelected"  Color="{StaticResource Color.BlueSelected}" />
    <SolidColorBrush x:Key="Brush.BlueIconBg2"   Color="{StaticResource Color.BlueIconBg2}" />

    <SolidColorBrush x:Key="Brush.BrandDark"     Color="{StaticResource Color.BrandDark}" />
    <SolidColorBrush x:Key="Brush.BrandMid"      Color="{StaticResource Color.BrandMid}" />
    <SolidColorBrush x:Key="Brush.BrandStroke"   Color="{StaticResource Color.BrandStroke}" />
    <SolidColorBrush x:Key="Brush.BrandStroke2"  Color="{StaticResource Color.BrandStroke2}" />
    <SolidColorBrush x:Key="Brush.BrandStroke3"  Color="{StaticResource Color.BrandStroke3}" />

    <SolidColorBrush x:Key="Brush.Cyan"          Color="{StaticResource Color.Cyan}" />
    <SolidColorBrush x:Key="Brush.Pink"          Color="{StaticResource Color.Pink}" />
    <SolidColorBrush x:Key="Brush.PinkSoft"      Color="{StaticResource Color.PinkSoft}" />
    <SolidColorBrush x:Key="Brush.Green"         Color="{StaticResource Color.Green}" />
    <SolidColorBrush x:Key="Brush.GreenSoft"     Color="{StaticResource Color.GreenSoft}" />
    <SolidColorBrush x:Key="Brush.Success"       Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessBright" Color="{StaticResource Color.SuccessBright}" />
    <SolidColorBrush x:Key="Brush.SuccessDark"   Color="{StaticResource Color.SuccessDark}" />
    <SolidColorBrush x:Key="Brush.SuccessBg"     Color="{StaticResource Color.SuccessBg}" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="{StaticResource Color.SuccessBorder}" />
    <SolidColorBrush x:Key="Brush.Amber"         Color="{StaticResource Color.Amber}" />
    <SolidColorBrush x:Key="Brush.AmberSoft"     Color="{StaticResource Color.AmberSoft}" />
    <SolidColorBrush x:Key="Brush.Amber2"        Color="{StaticResource Color.Amber2}" />
    <SolidColorBrush x:Key="Brush.AmberRisk"     Color="{StaticResource Color.AmberRisk}" />
    <SolidColorBrush x:Key="Brush.Red"           Color="{StaticResource Color.Red}" />
    <SolidColorBrush x:Key="Brush.RedSoft"       Color="{StaticResource Color.RedSoft}" />
    <SolidColorBrush x:Key="Brush.Danger"        Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger2"       Color="{StaticResource Color.Danger2}" />
    <SolidColorBrush x:Key="Brush.DangerDark"    Color="{StaticResource Color.DangerDark}" />
    <SolidColorBrush x:Key="Brush.DangerBg"      Color="{StaticResource Color.DangerBg}" />
    <SolidColorBrush x:Key="Brush.DangerBorder"  Color="{StaticResource Color.DangerBorder}" />

    <SolidColorBrush x:Key="Brush.Ink"          Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.Ink2"         Color="{StaticResource Color.Ink2}" />
    <SolidColorBrush x:Key="Brush.Ink3"         Color="{StaticResource Color.Ink3}" />
    <SolidColorBrush x:Key="Brush.Ink4"         Color="{StaticResource Color.Ink4}" />
    <SolidColorBrush x:Key="Brush.Ink5"         Color="{StaticResource Color.Ink5}" />
    <SolidColorBrush x:Key="Brush.Ink6"         Color="{StaticResource Color.Ink6}" />
    <SolidColorBrush x:Key="Brush.Ink7"         Color="{StaticResource Color.Ink7}" />
    <SolidColorBrush x:Key="Brush.Muted"        Color="{StaticResource Color.Ink4}" />
    <SolidColorBrush x:Key="Brush.Disabled"     Color="{StaticResource Color.Ink5}" />

    <SolidColorBrush x:Key="Brush.Slate"        Color="{StaticResource Color.Slate}" />
    <SolidColorBrush x:Key="Brush.Slate2"       Color="{StaticResource Color.Slate2}" />
    <SolidColorBrush x:Key="Brush.Slate3"       Color="{StaticResource Color.Slate3}" />
    <SolidColorBrush x:Key="Brush.SlateLight"   Color="{StaticResource Color.SlateLight}" />

    <SolidColorBrush x:Key="Brush.Surface"      Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2"     Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Canvas"       Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.WorkspaceBar" Color="{StaticResource Color.WorkspaceBar}" />
    <SolidColorBrush x:Key="Brush.PanelHeader"  Color="{StaticResource Color.PanelHeader}" />
    <SolidColorBrush x:Key="Brush.PanelSidebar" Color="{StaticResource Color.PanelSidebar}" />
    <SolidColorBrush x:Key="Brush.InputBorder"  Color="{StaticResource Color.InputBorder}" />
    <SolidColorBrush x:Key="Brush.InputHoverBorder" Color="{StaticResource Color.InputHoverBorder}" />
    <SolidColorBrush x:Key="Brush.DropdownHover" Color="{StaticResource Color.DropdownHover}" />
    <SolidColorBrush x:Key="Brush.White"        Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Line"         Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Line2"        Color="{StaticResource Color.Line2}" />
    <SolidColorBrush x:Key="Brush.RowHover"     Color="{StaticResource Color.RowHover}" />
    <SolidColorBrush x:Key="Brush.ChipBg"       Color="{StaticResource Color.ChipBg}" />
    <SolidColorBrush x:Key="Brush.ChapterRowBg" Color="{StaticResource Color.ChapterRowBg}" />
    <SolidColorBrush x:Key="Brush.ActiveRowBg"  Color="{StaticResource Color.ActiveRowBg}" />
    <SolidColorBrush x:Key="Brush.ActiveRowHoverBg" Color="{StaticResource Color.ActiveRowHoverBg}" />

    <SolidColorBrush x:Key="Brush.Info"         Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.InfoBg"       Color="{StaticResource Color.InfoBg}" />
    <SolidColorBrush x:Key="Brush.Purple"       Color="{StaticResource Color.Purple}" />
