<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">6</sys:Double>
  <sys:Double x:Key="Space.3">8</sys:Double>
  <sys:Double x:Key="Space.4">10</sys:Double>
  <sys:Double x:Key="Space.5">12</sys:Double>
  <sys:Double x:Key="Space.6">14</sys:Double>
  <sys:Double x:Key="Space.7">16</sys:Double>
  <sys:Double x:Key="Space.8">20</sys:Double>
  <sys:Double x:Key="Space.9">22</sys:Double>

  <sys:Double x:Key="Layout.TopBarHeight">58</sys:Double>
  <sys:Double x:Key="Layout.NavBarHeight">44</sys:Double>
  <sys:Double x:Key="Layout.ContextBarHeight">56</sys:Double>
  <GridLength x:Key="Layout.ContextBarRowHeight">56</GridLength>
  <!-- Nunca más chico que el ancho de arranque (Width=1280 en ShellWindow.xaml): la pantalla
       más ancha (Revisión final, Features/Review/ReviewView.xaml: 300+16+720+16+330=1382 +
       Padding.Page 44 = 1426) igual necesita más que esto, pero esas grillas ya degradan bien
       con elipsis+tooltip y wrap; forzar 1426+ aquí no entra en notebooks de 1366px de ancho,
       comunes en el mercado objetivo (instaladoras 3-8 estimadores). -->
  <sys:Double x:Key="Layout.MinWindowWidth">1280</sys:Double>
  <sys:Double x:Key="Layout.MinWindowHeight">720</sys:Double>

  <CornerRadius x:Key="Radius.Sm">9</CornerRadius>
  <CornerRadius x:Key="Radius.Md">14</CornerRadius>
  <CornerRadius x:Key="Radius.Lg">14</CornerRadius>
  <CornerRadius x:Key="Radius.Brand">10</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">6</CornerRadius>
  <CornerRadius x:Key="Radius.Dropdown">12</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>

  <Thickness x:Key="Padding.Page">22,20,22,40</Thickness>
  <Thickness x:Key="Padding.PageCompact">16,12,16,24</Thickness>
  <Thickness x:Key="Padding.Card">16</Thickness>
  <Thickness x:Key="Padding.ContextBar">22,0</Thickness>
  <Thickness x:Key="Padding.WorkflowStepper">12,2</Thickness>
  <Thickness x:Key="Padding.ReadOnlyBanner">16,6</Thickness>

</ResourceDictionary>
