<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:QubiCostElectrical.Wpf.Shell">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="9"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
  </Style>

  <!-- Variantes compactas para barras de acciones adosadas a un panel/tabla (Bar.Formula).
       Usar SIEMPRE estas en vez de definir alias locales por pantalla (Apu, Cubicación, etc.). -->
  <Style x:Key="Button.Toolbar" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="Button.ToolbarPrimary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
    <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style x:Key="Button.HeaderIcon" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="#0DFFFFFF" />
    <Setter Property="BorderBrush" Value="#1CFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#BFD0E2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="9">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.NavHome" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Layout.NavBarHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderNav}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Grid>
              <TextBlock Text="{TemplateBinding Content}"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         FontWeight="{TemplateBinding FontWeight}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Border x:Name="ActiveLine" Height="2" VerticalAlignment="Bottom" Margin="10,0"
                      Background="{DynamicResource Brush.HeaderNavActive}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White9}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(shell:NavigationVisuals.IsActive), RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White14}" />
              <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.ModeTab" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="active">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
