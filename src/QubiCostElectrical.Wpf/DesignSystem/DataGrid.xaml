<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Navegación Excel: infra:DataGridExcelNavigation.Enable="True" en grillas editables.
       Estilos: DataGrid.Workspace (FullRow) o DataGrid.Workspace.Excel (multi-celda). -->

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="DataGrid.Prototype" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="36" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="VirtualizingPanel.CacheLength" Value="10,10" />
    <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
  </Style>

  <Style x:Key="DataGridColumnHeader.Prototype" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink4}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Style.Triggers>
      <Trigger Property="CanUserSort" Value="True">
        <Setter Property="Cursor" Value="Hand" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGridColumnHeader.Base" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}" />

  <Style x:Key="DataGridColumnHeader.Numeric" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Padding" Value="8,6,12,6" />
  </Style>

  <Style x:Key="DataGridColumnHeader.Center" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,6" />
  </Style>

  <!-- Alias para compatibilidad -->
  <Style x:Key="DataGridColumnHeader.Centered" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Center}" />

  <!-- Encabezado distintivo de fórmulas calculadas (fx) -->
  <Style x:Key="DataGridColumnHeader.Formula" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Numeric}">
    <Setter Property="Background" Value="{DynamicResource Brush.CellFormulaBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.FormulaBadge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="ToolTip" Value="Columna calculada automáticamente mediante fórmulas matemáticas" />
  </Style>

  <!-- Encabezado "delgado": sin texto (Header queda en blanco desde code-behind) y una franja
       mínima en vez del alto normal — usado en Cubicación modo Detalle, donde la fila de
       partida ya hace de encabezado visual y no queremos duplicar los títulos, pero sí
       conservar el tirador nativo del DataGrid para redimensionar columnas con el mouse. -->
  <Style x:Key="DataGridColumnHeader.Thin" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}">
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
  </Style>

  <Style x:Key="DataGridCell.Prototype" TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <!-- Resalte visual de capítulos / títulos WBS para que la celda adopte el fondo del capítulo -->
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ChapterRowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>

      <!-- Hover interactivo en celdas editables si la grilla es editable -->
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsReadOnly" Value="False" />
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsSelected" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.CellEditableHoverBg}" />
      </MultiTrigger>

      <Trigger Property="IsFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="1.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGridRow.Prototype" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ActiveRowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.ActiveRowHoverBg}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGrid.Workspace" TargetType="DataGrid" BasedOn="{StaticResource DataGrid.Prototype}">
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeader.Prototype}" />
    <Setter Property="CellStyle" Value="{StaticResource DataGridCell.Prototype}" />
    <Setter Property="RowStyle" Value="{StaticResource DataGridRow.Prototype}" />
  </Style>

  <!-- Foco por celda estilo Excel (cubicación y grillas de trabajo) -->
  <Style x:Key="DataGridCell.Excel" TargetType="DataGridCell">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Base por tipo de celda: Editable vs Fórmula -->
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.CellFormulaBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.CellFormulaInk}" />
      </Trigger>
      <Trigger Property="IsReadOnly" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.CellEditableBg}" />
      </Trigger>

      <!-- Hover interactivo en celdas editables -->
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsReadOnly" Value="False" />
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsSelected" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.CellEditableHoverBg}" />
      </MultiTrigger>

      <!-- Celda seleccionada (parte de un rango o celda secundaria): fondo azul seleccionado visible -->
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </Trigger>

      <!-- Cursor activo único estilo Excel: solo la celda que tiene el foco real o edición activa lleva el contorno azul de 2px -->
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </Trigger>
      <Trigger Property="IsEditing" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGridRow.Excel" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Prototype}">
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGrid.Workspace.Excel" TargetType="DataGrid" BasedOn="{StaticResource DataGrid.Prototype}">
    <Setter Property="SelectionUnit" Value="Cell" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeader.Prototype}" />
    <Setter Property="CellStyle" Value="{StaticResource DataGridCell.Excel}" />
    <Setter Property="RowStyle" Value="{StaticResource DataGridRow.Excel}" />
  </Style>

  <Style x:Key="DataGrid.CellTextBlock" TargetType="TextBlock">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="error">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGrid.CellErrorTextBlock" TargetType="TextBlock">
    <Style.Triggers>
      <Trigger Property="Tag" Value="error">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataGrid.CellErrorTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="error">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" />
        <Setter Property="BorderThickness" Value="1.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Editor de celda transparente sin borde ni fondo propio para que el marcado de la casilla sea limpio como Excel -->
  <Style x:Key="DataGrid.CellEditTransparent" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.BlueFocus}" />
  </Style>

  <!-- Editor de celda de grilla (DataGridTextColumn.EditingElementStyle o el TextBox de un
       DataGridTemplateColumn) — usado en Cubic. SC (Sist./Alim./Ducto Ø, L.Band/L.PVC,
       Montaje, Cajas). Form.TextBox está pensado para formularios (padding grande, esquinas
       redondeadas) y se ve fuera de lugar dentro de una fila de grilla de ~36px — este estilo
       llena la celda sin sobresalir, con el mismo fondo/tinta/acento azul de foco que el resto
       del design system. -->
  <Style x:Key="DataGrid.CellEditTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.BlueSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Brush.BlueFocus}"
                  BorderThickness="1.5">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Editor de celda de grilla con lista desplegable + filtro al escribir (ej. Conductor/
       Sección/Ducto Ø en Cubic. SC). No re-skinea el chrome completo del ComboBox (flecha,
       popup) — solo fondo/borde/tipografía para que no desentone con el resto de la celda;
       el filtrado en sí lo hace el code-behind (ver CubicacionScView.xaml.cs). -->
  <Style x:Key="DataGrid.CellEditCombo" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="IsEditable" Value="True" />
    <!-- False a propósito: la búsqueda incremental nativa de WPF peleaba con el filtro propio
         del code-behind (FilterableCombo_TextChanged) — reasignar ItemsSource mientras
         IsTextSearchEnabled trataba de auto-seleccionar la mejor coincidencia pisaba lo recién
         tecleado ("escribo H, aparece otra letra"). El filtro propio ya cubre esa función. -->
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="StaysOpenOnEdit" Value="True" />
  </Style>

</ResourceDictionary>
