<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:QubiCostElectrical.Wpf.Shell">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Menu.NavGroupTrigger" TargetType="ToggleButton">
    <Setter Property="Height" Value="{StaticResource Layout.NavBarHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderNav}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Content}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center" />
                <Path Data="M 0 0 L 3.5 3.5 L 7 0"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                      StrokeThickness="1.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      VerticalAlignment="Center"
                      Margin="6,1,0,0" />
              </StackPanel>
              <Border x:Name="ActiveLine" Height="2" VerticalAlignment="Bottom" Margin="10,0"
                      Background="{DynamicResource Brush.HeaderNavActive}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.White8}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(shell:NavigationVisuals.IsActive), RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
              <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Menu.DropdownPanel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Dropdown}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="260" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="40" ShadowDepth="18" Direction="270" Color="{StaticResource Color.ShadowDropdown}" Opacity="1" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Menu.DropdownLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderLabel}" />
    <Setter Property="Margin" Value="8,5,8,6" />
    <Setter Property="Text" Value="SECCIÓN" />
  </Style>

  <Style x:Key="Menu.DropdownItem" TargetType="Button">
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.md}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink7}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"
                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DropdownHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListBoxItem.Partida" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="0,1">
            <Grid>
              <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Background="Transparent" />
              <ContentPresenter Margin="8,5,8,5" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ActiveRowBg}" />
              <Setter TargetName="Accent" Property="Background" Value="{DynamicResource Brush.Blue}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ActiveRowHoverBg}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
