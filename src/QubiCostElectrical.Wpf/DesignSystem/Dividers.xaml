<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ══════════════════════════════════════════════════════════════════════════
       SISTEMA ESTANDARIZADO DE SEPARADORES Y DIVISORES (1PX FLAT HAIRLINE)
       Elimina biseles 3D y bordes grises desiguales de Windows en favor de
       trazos nítidos de 1px perfectamente alineados a la rejilla de píxeles.
       ══════════════════════════════════════════════════════════════════════════ -->

  <!-- Separador horizontal implícito estándar (Brush.Line) -->
  <Style TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="MinHeight" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1"
                  Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Separador tenue (Brush.Line2) para divisiones internas de tarjeta/panel -->
  <Style x:Key="Separator.Subtle" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <!-- Separador de sección principal con mayor respiro vertical -->
  <Style x:Key="Separator.Section" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
    <Setter Property="Margin" Value="0,14" />
  </Style>

  <!-- Separador vertical estándar (Brush.Line) -->
  <Style x:Key="Separator.Vertical" TargetType="Separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Width="1"
                  Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Separador vertical tenue (Brush.Line2) -->
  <Style x:Key="Separator.Vertical.Subtle" TargetType="Separator" BasedOn="{StaticResource Separator.Vertical}">
    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Margin" Value="6,3" />
  </Style>

  <!-- Separador dentro de menús contextuales y menús desplegables -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1"
                  Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Separador dentro de ToolBars -->
  <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Width="1"
                  Height="{TemplateBinding Height}"
                  Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Estilos de conveniencia para Border como divisor directo en Grids -->
  <Style x:Key="Divider.Hairline" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Divider.Hairline.Subtle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Divider.Vertical" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

</ResourceDictionary>
