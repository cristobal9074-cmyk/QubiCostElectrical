<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Dashboard.CompactCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Card base del rediseño "Resumen ejecutivo" -->
  <Style x:Key="Dashboard.Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Dashboard.CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style x:Key="Dashboard.CardSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- ===== Panel "Cifras clave" ============================================= -->
  <Style x:Key="Dashboard.Panel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Dashboard.PanelHead" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,9" />
  </Style>

  <Style x:Key="Dashboard.PanelStatus" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <!-- Celda de cifra: etiqueta en versal, valor en monoespaciada, sin tarjeta propia. -->
  <Style x:Key="Dashboard.FigLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="Dashboard.FigValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Margin" Value="0,9,0,0" />
  </Style>
  <Style x:Key="Dashboard.FigValueCompact" TargetType="TextBlock" BasedOn="{StaticResource Dashboard.FigValue}">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style x:Key="Dashboard.FigDelta" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style x:Key="Dashboard.FigCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="Margin" Value="0,7,0,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Dashboard.FigCell" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Padding" Value="15,14,15,15" />
    <Setter Property="Margin" Value="0,0,1,0" />
  </Style>

  <!-- Barra de avance de 3 px para las cifras con micro-barra. -->
  <Style x:Key="Dashboard.FigBar" TargetType="Border">
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="Margin" Value="0,11,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Icono de la variación de una cifra: flecha, check o alerta según DeltaIcon. -->
  <Style x:Key="Dashboard.FigIcon" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M12,19 V5 M5,12 L12,5 L19,12" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Stretch" Value="Uniform" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding DeltaIcon}" Value="up">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DeltaIcon}" Value="check">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Data" Value="M4,12 L9.5,17.5 L20,7" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DeltaIcon}" Value="alert">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Data" Value="M12,3 L22,20 L2,20 Z M12,10 V14.5 M12,17.5 h0.01" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DeltaKind}" Value="up">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Green}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DeltaKind}" Value="warn">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Amber}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DeltaKind}" Value="neg">
        <Setter Property="Stroke" Value="{DynamicResource Brush.DangerDark}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Medidor de preparación de la fila de estado. -->
  <Style x:Key="Dashboard.StatusMeter" TargetType="Border">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Width" Value="170" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Dashboard.StatusSquare" TargetType="Rectangle">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="RadiusX" Value="2" />
    <Setter Property="RadiusY" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Pills de cabecera -->
  <Style x:Key="Dashboard.Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Chip de KPI (up / warn / danger / mute) -->
  <Style x:Key="Dashboard.Chip" TargetType="Border" BasedOn="{StaticResource Dashboard.Pill}">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ink3}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ChipKind}" Value="up">
        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ChipKind}" Value="warn">
        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ChipKind}" Value="danger">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DangerDark}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Fila de KPI -->
  <Style x:Key="Dashboard.KpiCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Íconos de KPI por IconKind -->
  <Style x:Key="Dashboard.KpiIcon.Total" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="total">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.KpiIcon.Listas" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M4,12 L9.5,17.5 L20,7" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="listas">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.KpiIcon.M2" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M3,9 V3 H9 M15,3 H21 V9 M21,15 V21 H15 M9,21 H3 V15" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="m2">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.KpiIcon.Riesgo" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M12,2 L20,5 V11 C20,16.5 16.5,20.5 12,22 C7.5,20.5 4,16.5 4,11 V5 Z M12,8 V12.5 M12,16 V16.01" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="riesgo">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.KpiIcon.Margen" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M4,20 L20,4 M6.5,6.5 A2.5,2.5 0 1 1 6.49,6.5 M17.5,17.5 A2.5,2.5 0 1 1 17.49,17.5" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="margen">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.KpiIcon.Concentracion" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M3,21 V13 M8.5,21 V8 M14,21 V15.5 M19.5,21 V4" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="concentracion">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Sparklines decorativos por IconKind -->
  <Style x:Key="Dashboard.Spark.Up" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M2,20 L12.3,17.5 L22.6,18.5 L32.9,14.5 L43.1,13.5 L53.4,10 L63.7,7.5 L74,4" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Blue}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="total">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.Spark.Flat" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M2,17 L12.3,16.5 L22.6,16.8 L32.9,15.8 L43.1,15.6 L53.4,15 L63.7,14.4 L74,13.2" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Blue}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="m2">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.Spark.Down" TargetType="Path">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Data" Value="M2,5.5 L12.3,7 L22.6,8.5 L32.9,8.2 L43.1,11.5 L53.4,13.5 L63.7,16.5 L74,19.5" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.DangerDark}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IconKind}" Value="riesgo">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ítem de leyenda de composición -->
  <Style x:Key="Dashboard.CompItem" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="13,10" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <!-- ítem checklist de readiness -->
  <Style x:Key="Dashboard.CheckItem" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,0,0,9" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ítem de alerta con severidad -->
  <Style x:Key="Dashboard.AlertItem" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,0,0,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Bloqueante">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Crítico">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDark}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Mayor">
        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Info">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.AlertSev" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Bloqueante">
        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Crítico">
        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDark}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding SeverityLabel}" Value="Mayor">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ítem de actividad reciente -->
  <Style x:Key="Dashboard.FeedItem" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.FeedIcon" TargetType="Border">
    <Setter Property="Width" Value="31" />
    <Setter Property="Height" Value="31" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Blue}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ActionCategory}" Value="Guardado">
        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ActionCategory}" Value="Ajuste">
        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Badge de readiness -->
  <Style x:Key="Dashboard.ReadinessBadge" TargetType="Border" BasedOn="{StaticResource Dashboard.Pill}">
    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
    <Setter Property="Margin" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsOfferReady}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Badge de bloqueo / colaboración -->
  <Style x:Key="Dashboard.LockBadge" TargetType="Border" BasedOn="{StaticResource Dashboard.Pill}">
    <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
    <Setter Property="Margin" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsProjectReadOnly}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AmberRisk}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Amber}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Etapa del flujo de cierre -->
  <Style x:Key="Dashboard.StepDot" TargetType="Border">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsComplete}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.GreenSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Surface}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Dashboard.StepTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsComplete}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
