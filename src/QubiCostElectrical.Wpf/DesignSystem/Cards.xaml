<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ═══════════════════════════════════════════════════════════════════
       LENGUAJE DE LAYOUT — reglas para toda pantalla de Wpf/Features/*.
       No inventar Border ad-hoc (Background/BorderBrush/CornerRadius sueltos)
       para estos casos: usar siempre uno de estos estilos.

       - Card.Surface / Card.Section : panel flotante con margen y esquinas
         redondeadas (tableros, listas, resúmenes independientes dentro de
         una pantalla). Ej.: columnas de Cubicación SC, tarjetas KPI.
       - Card.Header : encabezado de un bloque de contenido, borde inferior
         solo, sin esquinas ni margen (título + acciones de una sección).
       - Bar.Formula : barra de acciones ADOSADA al borde de un panel o
         tabla (flush, sin radio, sin margen) — para barras de comandos que
         viven pegadas a una grilla/tabla de trabajo (nav de Cubicación,
         barra de acciones de Apu).
       - Card.LeftPanelHeader : encabezado del panel lateral izquierdo
         (lista de partidas) en pantallas con layout de 2-3 columnas.

       Botones de una Bar.Formula: usar Button.Toolbar / Button.ToolbarPrimary
       (Buttons.xaml), no crear alias locales (ActionButton, etc.) por pantalla.
       ═══════════════════════════════════════════════════════════════════ -->

  <Style x:Key="Card.Surface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
  </Style>

  <Style x:Key="Card.Kpi" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
  </Style>

  <Style x:Key="Card.Section" TargetType="Border" BasedOn="{StaticResource Card.Surface}">
    <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
  </Style>

  <Style x:Key="Card.Header" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,14,16,10" />
  </Style>

  <Style x:Key="Badge.Status" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>

  <Style x:Key="Badge.Ok" TargetType="Border" BasedOn="{StaticResource Badge.Status}">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
  </Style>

  <Style x:Key="Badge.Warn" TargetType="Border" BasedOn="{StaticResource Badge.Status}">
    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber2}" />
  </Style>

  <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge.Status}">
    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
  </Style>

  <Style x:Key="Badge.Bad" TargetType="Border" BasedOn="{StaticResource Badge.Status}">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
  </Style>

  <!-- Etiqueta de metadatos (estado/moneda/cliente): rectangular, borde fino, sin píldora. -->
  <Style x:Key="Meta.Tag" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Meta.Tag.Accent" TargetType="Border" BasedOn="{StaticResource Meta.Tag}">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
  </Style>

  <Style x:Key="Meta.Tag.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Badge" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
  </Style>

  <Style x:Key="Context.Chip" TargetType="Border">
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <Style x:Key="Card.LeftPanelHeader" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.PanelHeader}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style x:Key="Card.Summary" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style x:Key="Bar.Formula" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.WorkspaceBar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- Píldora de estadística sin borde (encabezados de Review/Versions/Quotes/Purchases/
       Prices/Export). Reemplaza al Border ad-hoc "Background=Surface CornerRadius=8
       Padding=10,6" repetido idéntico en 6 pantallas. -->
  <Style x:Key="Card.StatPill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Sección de página tipo formulario (paneles apilados de Preferencias: Identidad,
       Membrete, etc.). Radio más grande y padding generoso porque el contenido es
       texto/formularios, no una grilla de trabajo. -->
  <Style x:Key="Card.FormSection" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <!-- Tarjetas estándar de proyecto y resúmenes compartidos -->
  <Style x:Key="ProjectCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <Style x:Key="ProjectCardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <Style x:Key="SummaryCardValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.lg}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

</ResourceDictionary>
