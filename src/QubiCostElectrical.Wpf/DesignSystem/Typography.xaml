<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <FontFamily x:Key="Font.Ui">pack://application:,,,/Fonts/Inter.ttc#Inter, Segoe UI, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">pack://application:,,,/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>

  <sys:Double x:Key="Font.Size.2xs">9</sys:Double>
  <sys:Double x:Key="Font.Size.xs">10</sys:Double>
  <sys:Double x:Key="Font.Size.sm">11</sys:Double>
  <sys:Double x:Key="Font.Size.md">12</sys:Double>
  <sys:Double x:Key="Font.Size.base">13</sys:Double>
  <sys:Double x:Key="Font.Size.kpi">15</sys:Double>
  <sys:Double x:Key="Font.Size.lg">14</sys:Double>
  <sys:Double x:Key="Font.Size.price">17</sys:Double>
  <sys:Double x:Key="Font.Size.h3">16</sys:Double>
  <sys:Double x:Key="Font.Size.h2">18</sys:Double>
  <sys:Double x:Key="Font.Size.xl">20</sys:Double>
  <sys:Double x:Key="Font.Size.hero">22</sys:Double>
  <sys:Double x:Key="Font.Size.2xl">24</sys:Double>
  <sys:Double x:Key="Font.Size.3xl">28</sys:Double>
  <sys:Double x:Key="Font.Size.micro">8</sys:Double>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.md}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
  </Style>

  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.xl}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- Alias histórico: mismo estilo que Text.PageTitle, evita duplicar los 4 Setters. -->
  <Style x:Key="Text.ViewTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}" />

  <Style x:Key="Text.KpiValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.2xl}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
  </Style>

  <Style x:Key="Text.HeaderBrand" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.lg}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
  </Style>

  <Style x:Key="Text.SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
  </Style>

  <Style x:Key="Text.PartidaPanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionLabel}">
    <Setter Property="FontSize" Value="{StaticResource Font.Size.xs}" />
  </Style>

  <Style x:Key="Text.TotalsLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style x:Key="Text.TotalsHint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="Text.Numeric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
  </Style>

  <Style x:Key="Text.Numeric.Right" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Padding" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Cell.Formula" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.CellFormulaInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="ToolTip" Value="Cálculo automático mediante fórmula en tiempo real" />
  </Style>

  <Style x:Key="Text.Cell.Editable" TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric.Right}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style x:Key="Text.Kbd" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.2xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Padding" Value="4,2" />
  </Style>

  <Style x:Key="Text.TotalsValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.lg}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
  </Style>

  <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.base}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <Style x:Key="Text.KpiLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.KpiHint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.KpiInline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.kpi}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
  </Style>

  <Style x:Key="Text.Helper" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
  </Style>

  <!-- Opciones de renderizado de texto cristalino en toda la jerarquía tipográfica -->
  <Style TargetType="TextBlock">
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
  </Style>

  <!-- ToolTip Ejecutivo Global de Alta Gama -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.Navy}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.30" />
            </Border.Effect>
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
