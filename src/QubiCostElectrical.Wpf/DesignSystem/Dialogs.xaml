<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Dialog.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
  </Style>

  <Style x:Key="Dialog.Banner.Error" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>

  <Style x:Key="Dialog.Banner.Warning" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.AmberSoft}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>

  <Style x:Key="Dialog.Banner.Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Dialog.Footer" TargetType="DockPanel">
    <Setter Property="Margin" Value="0,14,0,0" />
  </Style>
</ResourceDictionary>
