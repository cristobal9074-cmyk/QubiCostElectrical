<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Un diccionario fusionado no ve a sus hermanos en Theme.xaml. -->
    <ResourceDictionary Source="DataGrid.xaml" />
    <ResourceDictionary Source="Converters.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ==================================================================== -->
  <!-- ITEMIZADO TEMPLATES & CELL STYLES                                   -->
  <!-- ==================================================================== -->

  <DataTemplate x:Key="StatusBadgeTemplate">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding StatusLabel}">
      <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Brush.Line2}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                <Setter Property="Fill" Value="{DynamicResource Brush.Amber}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="info">
                <Setter Property="Fill" Value="{DynamicResource Brush.Blue}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="bad">
                <Setter Property="Fill" Value="{DynamicResource Brush.Red}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <TextBlock FontSize="11" FontWeight="Medium" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding StatusShortLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="bad">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </DataTemplate>

  <Style x:Key="NumericCellTextBlock" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,0,6,0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="TotalCellTextBlock" TargetType="TextBlock" BasedOn="{StaticResource NumericCellTextBlock}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ItemCellTextBlock" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ItemCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="ToolTip" Value="{Binding ItemCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ItemCellTextBox" TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellErrorTextBox}">
    <Setter Property="TextAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ItemCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Tag" Value="error" />
        <Setter Property="ToolTip" Value="{Binding ItemCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DescripcionCellTextBlock" TargetType="TextBlock">
    <Setter Property="Margin" Value="{Binding IndentMargin}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.base}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DescripcionCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="ToolTip" Value="{Binding DescripcionCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DescripcionCellTextBox" TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellErrorTextBox}">
    <Setter Property="Margin" Value="{Binding IndentMargin}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding DescripcionCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Tag" Value="error" />
        <Setter Property="ToolTip" Value="{Binding DescripcionCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ObservacionesCellTextBox" TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellErrorTextBox}">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="UnidadCellTextBlock" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding UnidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="ToolTip" Value="{Binding UnidadCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="UnidadCellTextBox" TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellErrorTextBox}">
    <Setter Property="TextAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding UnidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Tag" Value="error" />
        <Setter Property="ToolTip" Value="{Binding UnidadCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CantidadCellTextBlock" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding CantidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="ToolTip" Value="{Binding CantidadCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CantidadCellTextBox" TargetType="TextBox" BasedOn="{StaticResource DataGrid.CellErrorTextBox}">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding CantidadCellError, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
        <Setter Property="Tag" Value="error" />
        <Setter Property="ToolTip" Value="{Binding CantidadCellError}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ItemizadoColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Prototype}" />
  <Style x:Key="NumericColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Numeric}" />
  <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeader.Center}" />

  <Style x:Key="ItemizadoDataGridCell" TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsTitleRow}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ChapterRowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsChapterStyle}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ChapterRowBg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.CellFormulaBg}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsSelected" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.CellEditableHoverBg}" />
      </MultiTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      </Trigger>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="BorderThickness" Value="1" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="OnboardingCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="4" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blue}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="OnboardingActionCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}" />
    <Setter Property="Padding" Value="16,14" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PerspectiveToggleRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentedFilterRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MiniRowActionButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.ChipBg}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MiniRowActionButton.Cubicar" TargetType="Button" BasedOn="{StaticResource MiniRowActionButton}">
    <Setter Property="Background" Value="{DynamicResource Brush.BlueSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandStroke3}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Blue}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.BlueSelected}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.BlueFocus}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.BlueDark}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
