    <Color x:Key="Color.Finance.IndirectSoft">#2D2410</Color>
    <Color x:Key="Color.Finance.MarginSoft">#0F291E</Color>
    <Color x:Key="Color.Finance.Track">#1E293B</Color>
    <Color x:Key="Color.Finance.TrackBorder">#334155</Color>

    <!-- ── Info / Purple (recurso MO) ──────────────────────────────────────── -->
    <Color x:Key="Color.Info">#5B91FF</Color>
    <Color x:Key="Color.InfoBg">#182A47</Color>
    <Color x:Key="Color.Purple">#9B82D6</Color>
    <Color x:Key="Color.PurpleSoft">#241C38</Color>
    <Color x:Key="Color.Violet">#A78BFA</Color>
    <Color x:Key="Color.VioletDark">#8B5CF6</Color>

    <!-- ── Ink (text) spectrum ───────────────────────────────────────────── -->
    <Color x:Key="Color.Ink">#E1E4E8</Color>
    <Color x:Key="Color.Ink2">#BCC0C6</Color>
    <Color x:Key="Color.Ink3">#8B8F96</Color>
