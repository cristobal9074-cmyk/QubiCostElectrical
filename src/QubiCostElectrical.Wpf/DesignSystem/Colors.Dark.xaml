    <SolidColorBrush x:Key="Brush.BrandStroke"   Color="{StaticResource Color.BrandStroke}" />
    <SolidColorBrush x:Key="Brush.BrandStroke2"  Color="{StaticResource Color.BrandStroke2}" />
    <SolidColorBrush x:Key="Brush.BrandStroke3"  Color="{StaticResource Color.BrandStroke3}" />

    <SolidColorBrush x:Key="Brush.Cyan"          Color="{StaticResource Color.Cyan}" />
    <SolidColorBrush x:Key="Brush.Pink"          Color="{StaticResource Color.Pink}" />
    <SolidColorBrush x:Key="Brush.PinkSoft"      Color="{StaticResource Color.PinkSoft}" />
    <SolidColorBrush x:Key="Brush.Green"         Color="{StaticResource Color.Green}" />
    <SolidColorBrush x:Key="Brush.GreenSoft"     Color="{StaticResource Color.GreenSoft}" />
    <SolidColorBrush x:Key="Brush.Success"       Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessBright" Color="{StaticResource Color.SuccessBright}" />
    <SolidColorBrush x:Key="Brush.SuccessDark"   Color="{StaticResource Color.SuccessDark}" />
    <SolidColorBrush x:Key="Brush.SuccessBg"     Color="{StaticResource Color.SuccessBg}" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="{StaticResource Color.SuccessBorder}" />
    <SolidColorBrush x:Key="Brush.Amber"         Color="{StaticResource Color.Amber}" />
    <SolidColorBrush x:Key="Brush.AmberSoft"     Color="{StaticResource Color.AmberSoft}" />
    <SolidColorBrush x:Key="Brush.Amber2"        Color="{StaticResource Color.Amber2}" />
    <SolidColorBrush x:Key="Brush.AmberRisk"     Color="{StaticResource Color.AmberRisk}" />
    <SolidColorBrush x:Key="Brush.Red"           Color="{StaticResource Color.Red}" />
    <SolidColorBrush x:Key="Brush.RedSoft"       Color="{StaticResource Color.RedSoft}" />
    <SolidColorBrush x:Key="Brush.Danger"        Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger2"       Color="{StaticResource Color.Danger2}" />
    <SolidColorBrush x:Key="Brush.DangerDark"    Color="{StaticResource Color.DangerDark}" />
    <SolidColorBrush x:Key="Brush.DangerBg"      Color="{StaticResource Color.DangerBg}" />
    <SolidColorBrush x:Key="Brush.DangerBorder"  Color="{StaticResource Color.DangerBorder}" />

    <SolidColorBrush x:Key="Brush.Ink"          Color="{StaticResource Color.Ink}" />
