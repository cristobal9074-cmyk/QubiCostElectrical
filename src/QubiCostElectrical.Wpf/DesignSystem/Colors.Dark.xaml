    <!-- ── Semantic colors ───────────────────────────────────────────────── -->
    <Color x:Key="Color.Cyan">#22D3EE</Color>
    <Color x:Key="Color.Pink">#F472B6</Color>
    <Color x:Key="Color.PinkSoft">#3A1730</Color>
    <Color x:Key="Color.Green">#22C55E</Color>
    <Color x:Key="Color.GreenSoft">#14281A</Color>
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.SuccessBright">#4ADE80</Color>
    <Color x:Key="Color.SuccessDark">#86EFAC</Color>
    <Color x:Key="Color.SuccessBg">#0F1F14</Color>
    <Color x:Key="Color.SuccessBorder">#1A3D24</Color>
