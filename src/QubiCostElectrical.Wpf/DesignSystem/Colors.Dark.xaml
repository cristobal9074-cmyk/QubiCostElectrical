    <Color x:Key="Color.Ink6">#7A7E86</Color>
    <Color x:Key="Color.Ink7">#8B8F96</Color>
    <!-- Color.Muted eliminado: era idéntico a Color.Ink3 (#8B8F96) en claro y oscuro.
         Brush.Muted ahora referencia Color.Ink3 directamente. -->

    <!-- ── Slate ─────────────────────────────────────────────────────────── -->
    <Color x:Key="Color.Slate">#64748B</Color>
    <Color x:Key="Color.Slate2">#475569</Color>
    <Color x:Key="Color.Slate3">#334155</Color>
    <Color x:Key="Color.SlateLight">#1E293B</Color>

    <!-- ── Surface / canvas ──────────────────────────────────────────────── -->
    <Color x:Key="Color.Surface">#1C1F26</Color>
    <Color x:Key="Color.Surface2">#252830</Color>
    <Color x:Key="Color.Canvas">#14161C</Color>
    <Color x:Key="Color.WorkspaceBar">#1A1D24</Color>
    <Color x:Key="Color.PanelHeader">#252830</Color>
    <Color x:Key="Color.PanelSidebar">#1E2128</Color>
    <Color x:Key="Color.InputBorder">#3A3F4A</Color>
    <Color x:Key="Color.DropdownHover">#2A2E38</Color>
    <Color x:Key="Color.RowHover">#22262E</Color>
    <Color x:Key="Color.ChipBg">#20242C</Color>
    <Color x:Key="Color.ChapterRowBg">#22262E</Color>
    <Color x:Key="Color.ActiveRowBg">#1E2D4A</Color>
    <Color x:Key="Color.ActiveRowHoverBg">#253A63</Color>
    <Color x:Key="Color.CellFormulaBg">#171A21</Color>
    <Color x:Key="Color.CellEditableBg">#1C1F26</Color>
    <Color x:Key="Color.CellEditableHover">#222D3E</Color>
    <Color x:Key="Color.CellFormulaInk">#94A3B8</Color>
    <Color x:Key="Color.FormulaBadge">#8494A7</Color>
    <Color x:Key="Color.FormulaBadgeBg">#232832</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>

    <!-- ── Borders / lines ───────────────────────────────────────────────── -->
    <Color x:Key="Color.Line">#2D3038</Color>
    <Color x:Key="Color.Line2">#323844</Color>
    <Color x:Key="Color.InputHoverBorder">#3F5175</Color>

    <!-- ── Header text / icons (keep legible on dark navy) ───────────────── -->
    <Color x:Key="Color.HeaderInk">#EEF4FB</Color>
    <Color x:Key="Color.HeaderMuted">#9EB1C8</Color>
    <Color x:Key="Color.HeaderNav">#AEBED0</Color>
    <Color x:Key="Color.HeaderNavActive">#5B91FF</Color>
    <Color x:Key="Color.HeaderLabel">#91A6BD</Color>
    <Color x:Key="Color.HeaderControl">#BFD0E2</Color>
    <Color x:Key="Color.HeaderStatus">#A7B8CB</Color>
    <Color x:Key="Color.HeaderDim">#72859A</Color>
    <Color x:Key="Color.HeaderDate">#A0B0C0</Color>

    <!-- ── Misc ──────────────────────────────────────────────────────────── -->
    <Color x:Key="Color.SaveDot">#40C77D</Color>
    <Color x:Key="Color.AvatarBg">#2E4468</Color>
    <Color x:Key="Color.Shadow">#80000000</Color>
    <Color x:Key="Color.ShadowDropdown">#60000000</Color>

    <!-- ════════════════════════════════════════════════════════════════════
         BRUSHES — solid colors
         ════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Brush.Navy"          Color="{StaticResource Color.Navy}" />
    <SolidColorBrush x:Key="Brush.Navy2"         Color="{StaticResource Color.Navy2}" />
    <SolidColorBrush x:Key="Brush.Navy3"         Color="{StaticResource Color.Navy3}" />
    <SolidColorBrush x:Key="Brush.NavyDeep"      Color="{StaticResource Color.NavyDeep}" />
    <SolidColorBrush x:Key="Brush.NavyDeep2"     Color="{StaticResource Color.NavyDeep2}" />
    <SolidColorBrush x:Key="Brush.NavyBorder"    Color="{StaticResource Color.NavyBorder}" />
    <SolidColorBrush x:Key="Brush.NavyBorder2"   Color="{StaticResource Color.NavyBorder2}" />

    <SolidColorBrush x:Key="Brush.BlueDark"      Color="{StaticResource Color.BlueDark}" />
    <SolidColorBrush x:Key="Brush.Blue"          Color="{StaticResource Color.Blue}" />
    <SolidColorBrush x:Key="Brush.Blue2"         Color="{StaticResource Color.Blue2}" />
    <SolidColorBrush x:Key="Brush.Blue3"         Color="{StaticResource Color.Blue3}" />
    <SolidColorBrush x:Key="Brush.BlueFocus"     Color="{StaticResource Color.BlueFocus}" />
    <SolidColorBrush x:Key="Brush.BlueSoft"      Color="{StaticResource Color.BlueSoft}" />
    <SolidColorBrush x:Key="Brush.BlueFaint"     Color="{StaticResource Color.BlueFaint}" />
    <SolidColorBrush x:Key="Brush.BlueHover"     Color="{StaticResource Color.BlueHover}" />
    <SolidColorBrush x:Key="Brush.BlueSelected"  Color="{StaticResource Color.BlueSelected}" />
