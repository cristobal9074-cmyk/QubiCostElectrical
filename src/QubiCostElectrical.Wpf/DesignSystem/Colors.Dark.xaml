    <SolidColorBrush x:Key="Brush.InputHoverBorder" Color="{StaticResource Color.InputHoverBorder}" />
    <SolidColorBrush x:Key="Brush.DropdownHover" Color="{StaticResource Color.DropdownHover}" />
    <SolidColorBrush x:Key="Brush.White"        Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Line"         Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Line2"        Color="{StaticResource Color.Line2}" />
    <SolidColorBrush x:Key="Brush.RowHover"     Color="{StaticResource Color.RowHover}" />
    <SolidColorBrush x:Key="Brush.ChipBg"       Color="{StaticResource Color.ChipBg}" />
    <SolidColorBrush x:Key="Brush.ChapterRowBg" Color="{StaticResource Color.ChapterRowBg}" />
    <SolidColorBrush x:Key="Brush.ActiveRowBg"  Color="{StaticResource Color.ActiveRowBg}" />
    <SolidColorBrush x:Key="Brush.ActiveRowHoverBg" Color="{StaticResource Color.ActiveRowHoverBg}" />

    <SolidColorBrush x:Key="Brush.Info"         Color="{StaticResource Color.Info}" />
