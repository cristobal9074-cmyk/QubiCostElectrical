    <Color x:Key="Color.NavyDeep">#080E18</Color>
    <Color x:Key="Color.NavyDeep2">#0C1825</Color>
    <Color x:Key="Color.NavyBorder">#1A3752</Color>
    <Color x:Key="Color.NavyBorder2">#1C4060</Color>

    <!-- ── Blue spectrum ─────────────────────────────────────────────────── -->
    <Color x:Key="Color.BlueDark">#3B82F6</Color>
    <Color x:Key="Color.Blue">#4B8DF7</Color>
    <Color x:Key="Color.Blue2">#60A5FA</Color>
    <Color x:Key="Color.Blue3">#77A5F7</Color>
