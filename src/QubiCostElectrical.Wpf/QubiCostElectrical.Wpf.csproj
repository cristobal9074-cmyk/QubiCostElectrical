<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Sin esto, dotnet build copiaba las variantes nativas de TODOS los RIDs (win, linux,
         mac) de paquetes como SkiaSharp/PDFtoImage al bin/ â€” ~240 MB de .so/.dylib que jamÃ¡s
         se usan en un escritorio Windows. Fijar el RID a win-x64 (sin self-contained, sigue
         dependiendo del runtime de .NET instalado) hace que solo se copien los binarios nativos
         de Windows. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>QubiCostElectrical.Wpf</RootNamespace>
    <AssemblyName>QubiCostElectrical</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QubiCostElectrical.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Title>Qubi Cost Electrical</Title>
    <StartupObject>QubiCostElectrical.Wpf.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>QubiCostElectrical.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\QubiCostElectrical.ico" />
    <Resource Include="Assets\QubiCostProject.ico" />
    <Resource Include="Assets\QubiCostSolicitud.ico" />
    <Resource Include="Assets\brand_logo.png" />
    <Resource Include="Assets\app_logo.png" />
    <Resource Include="Assets\cad_electrical_bim.jpg" />
    <Resource Include="Assets\project_icon.png" />
    <None Include="Assets\QubiCostProject.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\QubiCostSolicitud.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Fonts\Inter.ttc" />
    <Resource Include="Fonts\JetBrainsMono-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="PDFtoImage" Version="5.1.1" />
    <PackageReference Include="Velopack" Version="0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="QubiCostElectrical.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QubiCostElectrical.Composition\QubiCostElectrical.Composition.csproj" />
    <ProjectReference Include="..\QubiCostElectrical.Application\QubiCostElectrical.Application.csproj" />
    <ProjectReference Include="..\QubiCostElectrical.Domain\QubiCostElectrical.Domain.csproj" />
  </ItemGroup>

</Project>

