<Window x:Class="QubiCostElectrical.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:product="clr-namespace:QubiCostElectrical;assembly=QubiCostElectrical.Domain"
        Title="QUBI COST Electrical — Acceso"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/QubiCostElectrical.ico"
        KeyDown="OnWindowKeyDown">
  <Window.Resources>
    <!-- Estilo de Campos de Texto -->
    <Style x:Key="ModernInputField" TargetType="TextBox">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#374151" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="CaretBrush" Value="#38BDF8" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563" />
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7" />
                <Setter TargetName="border" Property="Background" Value="#0F172A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Estilo de Contraseña -->
    <Style x:Key="ModernPasswordField" TargetType="PasswordBox">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#374151" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="CaretBrush" Value="#38BDF8" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563" />
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7" />
                <Setter TargetName="border" Property="Background" Value="#0F172A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botón Principal Gradiente -->
    <Style x:Key="ModernPrimaryButton" TargetType="Button">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0284C7" Offset="0.0" />
            <GradientStop Color="#0369A1" Offset="1.0" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Color="#0284C7" Opacity="0.30" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <!-- Glow de fondo -->
    <Border CornerRadius="26" Background="#0284C7" Opacity="0.12">
      <Border.Effect>
        <BlurEffect Radius="24" />
      </Border.Effect>
    </Border>

    <!-- Tarjeta Principal Moderna (Dark Glass) -->
    <Border Width="430"
            Background="#111827"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            CornerRadius="22"
            Padding="36,40,36,36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Color="#000000" Opacity="0.65" />
      </Border.Effect>
      <StackPanel>

        <!-- Brand Header con Logo Oficial -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
          <Border Width="44" Height="44" CornerRadius="12" Background="#0F172A" BorderBrush="#660284C7" BorderThickness="1" Margin="0,0,12,0">
            <Image Source="pack://application:,,,/Assets/brand_logo.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="6" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QUBI COST" FontSize="17" FontWeight="ExtraBold" Foreground="#F9FAFB" />
            <TextBlock Text="ELECTRICAL" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
          </StackPanel>
        </StackPanel>

        <!-- Título y Descripción -->
        <TextBlock Text="{Binding ViewTitleText}"
                   FontSize="21" FontWeight="Bold" Foreground="#F9FAFB"
                   Margin="0,0,0,6" />
        <TextBlock Text="{Binding ViewDescText}"
                   FontSize="12.5" Foreground="#9CA3AF"
                   TextWrapping="Wrap" LineHeight="18"
                   Margin="0,0,0,22" />

        <!-- Campo Correo Electrónico -->
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="Correo electrónico corporativo" FontSize="11.5" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,6" />
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ModernInputField}" Height="42" />
        </StackPanel>

        <!-- Campo Contraseña con botón Mostrar/Ocultar -->
        <StackPanel Margin="0,0,0,14">
          <Grid Margin="0,0,0,6">
            <TextBlock Text="Contraseña" FontSize="11.5" FontWeight="SemiBold" Foreground="#D1D5DB" />
          </Grid>
          <Grid>
            <PasswordBox x:Name="PinBox"
                         Style="{StaticResource ModernPasswordField}"
                         Height="42"
                         PasswordChanged="OnPinChanged" />
            <TextBox x:Name="VisiblePasswordBox"
                     Style="{StaticResource ModernInputField}"
                     Height="42"
                     Visibility="Collapsed"
                     TextChanged="OnVisiblePasswordChanged" />
            <!-- Botón Ojo -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnTogglePasswordVisibility"
                    ToolTip="Mostrar u ocultar contraseña">
              <TextBlock x:Name="EyeIcon" Text="👁" FontSize="14" Foreground="#9CA3AF" />
            </Button>
          </Grid>
        </StackPanel>

        <!-- Opciones extras: Recordar Sesión / Olvidé contraseña -->
        <Grid Margin="0,2,0,18" x:Name="ExtraOptionsGrid">
          <CheckBox IsChecked="{Binding RememberMe}"
                    x:Name="RememberMeCheck"
                    VerticalAlignment="Center">
            <TextBlock Text="Recordar correo en este equipo" FontSize="11.5" Foreground="#9CA3AF" />
          </CheckBox>
          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
            <Hyperlink Click="OnForgotPasswordClick" Foreground="#38BDF8" TextDecorations="None">
              ¿Problemas de acceso?
            </Hyperlink>
          </TextBlock>
        </Grid>

        <!-- Ayuda de acceso (inline, sin ventanas modales) -->
        <Border x:Name="HelpBanner"
                Background="#140284C7"
                BorderBrush="#660284C7"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,0,0,16"
                Visibility="Collapsed">
          <TextBlock Text="Si olvidaste tu contraseña o necesitas soporte con tu acceso, contacta directamente al administrador del sistema en tu organización o a Qubi Cost Electrical."
                     FontSize="11.5"
                     Foreground="#BAE6FD"
                     TextWrapping="Wrap" />
        </Border>

        <!-- Banner de Error -->
        <Border Background="#1FEF4444"
                BorderBrush="#66EF4444"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,9"
                Margin="0,0,0,16"
                x:Name="ErrorBanner">
          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="11.5" Foreground="#F87171" TextWrapping="Wrap" />
        </Border>

        <!-- Botón de Envío -->
        <Button Command="{Binding LoginCommand}"
                Style="{StaticResource ModernPrimaryButton}"
                Height="46"
                IsEnabled="{Binding CanInteract}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SubmitButtonText}" />
            <TextBlock Text=" →" FontSize="15" Margin="6,0,0,0" />
          </StackPanel>
        </Button>

        <!-- Nota al pie de seguridad empresarial -->
        <TextBlock Text="Licencias gestionadas centralmente. Sesiones locales cifradas con seguridad de nivel empresarial."
                   TextAlignment="Center"
                   FontSize="10"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Margin="0,20,0,0" />
      </StackPanel>
    </Border>

    <!-- Versión del Producto -->
    <TextBlock Text="{x:Static product:ProductVersionInfo.ProductVersionLabel}"
               FontSize="10"
               Foreground="#4B5563"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,24,20"
               FontFamily="Consolas"
               FontWeight="SemiBold" />
  </Grid>
</Window>
