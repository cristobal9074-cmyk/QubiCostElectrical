<Window x:Class="QubiCostElectrical.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:product="clr-namespace:QubiCostElectrical;assembly=QubiCostElectrical.Domain"
        Title="Iniciar sesión — QUBI COST Electrical"
        Width="420"
        Height="560"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        KeyDown="OnWindowKeyDown">
  <Window.Resources>
    <Style x:Key="LoginField" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Brush.Blue2}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Slate3}" />
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LoginPasswordField" TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Slate3}" />
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Blue2}" />
                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.BlueFaint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LoginButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Blue}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="9">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="270" Color="{DynamicResource Color.Blue}" Opacity="0.22" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Blue2}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueDark}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource Brush.Canvas}">

    <!-- Card -->
    <Border Width="420"
            Background="White"
            BorderBrush="{DynamicResource Brush.Line}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="40,48,40,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <Border.Effect>
        <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Color="{DynamicResource Color.Ink}" Opacity="0.10" />
      </Border.Effect>
      <StackPanel>
        <!-- Brand row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Image Width="46" Height="46"
                 Source="pack://application:,,,/Assets/isolate_the_isometric_cube_logo_mark_from_data_image_image_6._remove_the_white.png"
                 Margin="0,0,12,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QUBI COST" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="ELECTRICAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.HeaderNav}" />
          </StackPanel>
        </StackPanel>

        <!-- Title -->
        <TextBlock Text="Iniciar sesión"
                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}"
                   Margin="0,28,0,6" />
        <TextBlock Text="Accede a tu cuenta para gestionar presupuestos, cubicaciones y ofertas eléctricas."
                   FontSize="13" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" LineHeight="20"
                   Margin="0,0,0,28" />

        <!-- First user wizard -->
        <Border Background="{DynamicResource Brush.BlueHover}"
                BorderBrush="{DynamicResource Brush.BrandStroke3}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14,10"
                Margin="0,0,0,16"
                x:Name="FirstUserBanner">
          <StackPanel>
            <TextBlock Text="Configuración inicial"
                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.BlueDark}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Crea la cuenta de administrador para comenzar."
                       FontSize="11" Foreground="{DynamicResource Brush.Blue2}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Display name (first user only) -->
        <StackPanel Margin="0,0,0,16" x:Name="DisplayNamePanel">
          <TextBlock Text="Nombre completo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,0,6" />
          <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource LoginField}" Height="44" />
        </StackPanel>

        <!-- Email -->
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="Correo electrónico" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,0,6" />
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource LoginField}" Height="44" />
        </StackPanel>

        <!-- PIN -->
        <StackPanel Margin="0,0,0,16">
          <TextBlock Text="PIN de acceso" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink2}" Margin="0,0,0,6" />
          <PasswordBox x:Name="PinBox"
                       Style="{StaticResource LoginPasswordField}"
                       Height="44"
                       MaxLength="6"
                       PasswordChanged="OnPinChanged" />
        </StackPanel>

        <!-- Remember -->
        <CheckBox IsChecked="{Binding RememberMe}"
                  x:Name="RememberMeCheck"
                  Margin="0,0,0,24">
          <TextBlock Text="Recordar sesión en este equipo" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
        </CheckBox>

        <!-- Error -->
        <Border Background="{DynamicResource Brush.DangerBg}"
                BorderBrush="{DynamicResource Brush.DangerBorder}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,10"
                Margin="0,0,0,16"
                x:Name="ErrorBanner">
          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="11" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- Submit -->
        <Button Command="{Binding LoginCommand}"
                Style="{StaticResource LoginButtonStyle}"
                Height="46"
                IsEnabled="{Binding CanInteract}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Ingresar al sistema" />
            <TextBlock Text=" →" FontSize="16" Margin="4,0,0,0" />
          </StackPanel>
        </Button>

        <!-- Footer -->
        <TextBlock TextAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.HeaderNav}" Margin="0,18,0,0">
          <Run Text="¿Olvidaste tu PIN?" />
          <Run Text="Contacta a tu administrador." Foreground="{DynamicResource Brush.Blue2}" />
        </TextBlock>
        <TextBlock Text="Colaboración por archivo en carpeta compartida (SMB/UNC): 1 editor + N consultores en solo lectura. No es edición simultánea tipo Google Docs. La actividad queda en el proyecto."
                   TextAlignment="Center"
                   FontSize="10"
                   Foreground="{DynamicResource Brush.HeaderLabel}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Opacity="0.85" />
      </StackPanel>
    </Border>

    <!-- Version -->
    <TextBlock Text="{x:Static product:ProductVersionInfo.ProductVersionLabel}"
               FontSize="10"
               Foreground="{DynamicResource Brush.HeaderNav}"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,22,18"
               FontFamily="Consolas"
               Opacity="0.45" />
  </Grid>
</Window>
